#!/usr/bin/env bash
# Docker credential helper (https://github.com/docker/docker-credential-helpers)
# that answers with a fresh Forgejo Actions ID token for user `oidc`. login.sh
# installs it; clients call it with the registry on stdin.
set -euo pipefail

case ${1:-} in
  get)
    server=$(cat)
    [[ $server =~ ^(https://)?[a-z0-9.-]+(:[0-9]+)?/?$ ]] || exit 1
    here=$(dirname "${BASH_SOURCE[0]}")
    audience=$(cat "$here/audience" 2>/dev/null || echo registry.tilo.so)
    token=$(TILO_REGISTRY_AUDIENCE=$audience "$here/id-token.sh" 2>/dev/null)
    [[ $token =~ ^[A-Za-z0-9_.-]+$ ]] || exit 1
    printf '{"ServerURL":"%s","Username":"oidc","Secret":"%s"}\n' "$server" "$token"
    ;;
  store | erase) cat >/dev/null ;;
  list) printf '{}\n' ;;
  *) exit 1 ;;
esac
