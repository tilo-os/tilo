# Linux image scripts must retain LF when the repository is checked out on
# Windows for ARM64 image preparation. PowerShell also accepts LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Font licenses are content-addressed by the canonical font manifest.
crates/sdk/ui-core/assets/fonts/LICENSES/*.txt -text
crates/sdk/ui-core/assets/fonts/manifest.toml text eol=lf
crates/sdk/font-catalog/manifest.toml text eol=lf

# Media license notices retain the bytes verified by sources.json.
tools/windows/gstreamer-licenses/*.txt -text
tools/windows/gstreamer-licenses/*-COPYING -text
tools/windows/gstreamer-licenses/*-LICENSE -text

# Stored upstream mail patches retain unified-diff context markers.
os/external-assets/bootc/*.patch whitespace=-blank-at-eol,-blank-at-eof
os/external-assets/xwayland-satellite/*.patch whitespace=-blank-at-eol,-blank-at-eof
scripts/browser/cef-source/*.patch whitespace=-blank-at-eol,-blank-at-eof
tools/release/fixtures/nemo_descriptor.patch whitespace=-blank-at-eol,-blank-at-eof
# Pinned seccomp-bpf programs are compared byte for byte by tests.
*.bpf binary

# Cargo checks vendor/git against the checksums `cargo vendor` recorded.
vendor/git/** -text


# Generated files merge by taking main's side where both sides changed them, then their
# generator regenerates them: each one's verifying check declares a `fix`, which the pre-push
# hook runs (.githooks/merge-generated, docs/t.md). `generated-blocks` files are generated only
# between their generator's markers; a conflict elsewhere in them stays a conflict.
# tools/dev/install-git-hooks.py sets the drivers up.
/Cargo.lock merge=generated
/crates/workspace-hack/** merge=generated
/t.toml merge=generated-blocks
/docs/codemap.md merge=generated
/crates/browser/tilo-web-desktop/Cargo.toml merge=generated-blocks
/crates/browser/tilo-web-desktop/apps.json merge=generated
/crates/browser/tilo-web-desktop/src/apps.rs merge=generated
/crates/agent/agent-participant/Cargo.toml merge=generated-blocks
/crates/agent/agent-participant/src/web_apps.rs merge=generated
/crates/session/desktop-search/src/catalog.rs merge=generated
