# Linux image scripts must retain LF when the repository is checked out on
# Windows for ARM64 image preparation. PowerShell also accepts LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Font licenses are content-addressed by the canonical font manifest.
ui/assets/fonts/LICENSES/*.txt -text
ui/assets/fonts/manifest.toml text eol=lf
