# Linux image scripts must retain LF when the repository is checked out on
# Windows for ARM64 image preparation. PowerShell also accepts LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Font licenses are content-addressed by the canonical font manifest.
crates/sdk/ui-core/assets/fonts/LICENSES/*.txt -text
crates/sdk/ui-core/assets/fonts/manifest.toml text eol=lf
crates/sdk/font-catalog/manifest.toml text eol=lf

# Media license notices retain the bytes verified by sources.json.
tools/windows/gstreamer-licenses/*.txt -text
tools/windows/gstreamer-licenses/*-COPYING -text
tools/windows/gstreamer-licenses/*-LICENSE -text

# Stored upstream mail patches retain unified-diff context markers.
os/external-assets/bootc/*.patch whitespace=-blank-at-eol,-blank-at-eof
scripts/browser/cef-source/*.patch whitespace=-blank-at-eol,-blank-at-eof
tools/release/fixtures/nemo_descriptor.patch whitespace=-blank-at-eol,-blank-at-eof
# Pinned seccomp-bpf programs are compared byte for byte by tests.
*.bpf binary

# Cargo checks vendor/git against the checksums `cargo vendor` recorded.
vendor/git/** -text

