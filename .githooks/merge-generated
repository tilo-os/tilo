#!/usr/bin/env bash
# Git's merge driver for generated files (merge-generated.py, which says what it does), run with
# the Python 3.11 or newer the hooks find (python.sh): a rebase runs it on any machine that
# rebases, including one with no system python3.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
. "$here/python.sh"
exec python3 -I "$here/merge-generated.py" "$@"
