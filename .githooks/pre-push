#!/usr/bin/env bash
# Pushes to a remote are plain pushes: main's CI runs on every commit and reports what broke to
# whoever pushed it (docs/t.md, "How changes reach a release").
#
# Landing on the local `integration` branch (`git push . HEAD:integration`) lints what the change
# touches first: clippy with `-D warnings` over every target of the packages it changes and their
# direct dependants (tools/ci/test-changed.sh --stage clippy, against the integration it lands
# on), so integration stays promotable to main. A refused landing is fixed and pushed again.
set -uo pipefail

remote_name=$1
[ "$remote_name" = "." ] || exit 0

root=$(git rev-parse --show-toplevel) || exit 1
head=$(git rev-parse HEAD) || exit 1
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = refs/heads/integration ] || continue
    [ "$local_sha" != "$zero" ] || continue
    # Nothing new on integration: a push of what it already holds lints nothing.
    [ "$local_sha" != "$remote_sha" ] || continue
    if [ "$local_sha" != "$head" ]; then
        echo "pre-push: land on integration from the commit checked out (git push . HEAD:integration)," \
            "so the lint sees what lands" >&2
        status=1
        continue
    fi
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        echo "pre-push: commit or set aside your uncommitted changes before landing on integration," \
            "so the lint sees what lands" >&2
        status=1
        continue
    fi
    base=$remote_sha
    [ "$base" != "$zero" ] || base=origin/main
    echo "pre-push: landing on integration; clippy over what the change touches (against ${base:0:12})" >&2
    if ! "$root/tools/ci/test-changed.sh" --stage clippy --base "$base"; then
        echo "pre-push: clippy refused the landing; fix the findings above and push again" >&2
        status=1
    fi
done
exit "$status"
