#!/usr/bin/env bash
# A push to main runs t's push gate on exactly the commit being pushed (docs/t.md, "How changes
# reach a release"): the checks of what the commit touches, plus the fast whole-tree checks.
# Failures that main has too pass; a failure the change causes refuses the push, and a failure t
# can fix is fixed for you to commit (never amended). Pushes to other branches run nothing.
# Bypass with `git push --no-verify`.
set -euo pipefail
note() { printf 'pre-push: %s\n' "$*" >&2; }

# The fast whole-tree checks that keep main from going red for hours over a slip that takes
# seconds to find: formatting, the lockfile, crates/workspace-hack, t.toml's and the code map's
# generated parts, the SDK policy and the dependency policy. A check whose inputs the change
# doesn't touch returns its cached result at once.
gate=(fmt lockfile hakari t-toml codemap sdk-policy deny)

remote=$1
pushed=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  # Deleting main is not a change to test.
  [[ $local_sha =~ ^0+$ ]] && continue
  # main moved since the last fetch: the push would be refused after the checks anyway.
  if [[ ! $remote_sha =~ ^0+$ ]] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    note "main moved on $remote: git fetch $remote && git rebase $remote/main, then push again"
    exit 1
  fi
  pushed=$local_sha
done
[ -n "$pushed" ] || exit 0

if ! git config --get merge.generated.driver >/dev/null; then
  note "the merge drivers for generated files are not set up: run python3 tools/dev/install-git-hooks.py"
fi
if ! command -v t >/dev/null; then
  note "t is not installed, so the push gate can't run (docs/t.md, Setting up)"
  exit 1
fi
if ! t test --help 2>/dev/null | grep -q -- '--rev'; then
  note "this t can't test a commit by itself (\`t test --rev\`): run \`t self-update\`, then push again"
  exit 1
fi
# t compares the commit with main where it branched off.
git fetch --quiet "$remote" main 2>/dev/null || true

# t takes the commit's files from git's objects (`--rev`): uncommitted changes and untracked
# files never reach the gate, and no checkout of the commit is needed.
top=$(git rev-parse --show-toplevel)
short=$(git rev-parse --short "$pushed")
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
started=$SECONDS

# What the commit touches: the default checks of the packages whose files it changes (clippy,
# tests) and of the command checks whose inputs it changes. t runs nothing it isn't named.
touched=()
if names=$(t scope -C "$top" --rev "$pushed" --names 2>"$out/scope"); then
  read -r -a touched <<<"$names"
else
  note "t can't tell what $short touches, so only the whole-tree checks run:"
  sed 's/^/    /' "$out/scope" >&2
fi

status=0
t test -C "$top" --rev "$pushed" --priority high --json "${gate[@]}" "${touched[@]}" \
  >"$out/run.jsonl" 2>"$out/stderr" || status=$?
took=$((SECONDS - started))
what="${#touched[@]} touched + ${#gate[@]} whole-tree checks"

# The run's id, its fixable failures that may be the change's, t's errors, and what a fix changed.
read_run() {
  python3 -I - "$1" "$2" <<'EOF'
import json, sys
path, want = sys.argv[1], sys.argv[2]
for line in open(path, encoding="utf-8", errors="replace"):
    try:
        event = json.loads(line)
    except ValueError:
        continue
    kind = event.get("type")
    if want == "run" and kind in ("planned", "done") and event.get("run"):
        print(event["run"])
        break
    if want == "fixable" and kind == "result" and event.get("outcome") == "fail" \
            and event.get("fix") and not event.get("fixed") \
            and (event.get("blame") or {}).get("kind") not in ("inherited", "flaky"):
        print(event["check"])
    if want == "error" and kind == "error":
        print(event.get("message", ""))
        if event.get("hint"):
            print(event["hint"])
    if want in ("changed", "skipped") and kind == "fixed":
        for path in event.get(want, []):
            print(path)
EOF
}
run=$(read_run "$out/run.jsonl" run)
show_run() {
  if [ -n "$run" ]; then t show "$run" >&2 || true; else cat "$out/stderr" >&2; fi
}

case $status in
  0) note "t passed $short in ${took}s ($what)"; exit 0 ;;
  3) note "t passed $short in ${took}s ($what): what fails also fails on main (t main)"; exit 0 ;;
  1) ;;
  *)
    note "t could not run the push gate on $short (exit $status):"
    { read_run "$out/run.jsonl" error; tail -n 5 "$out/stderr"; } | sed 's/^/    /' >&2
    note "if t is down, push with --no-verify and run the checks once it is back: t test ${gate[*]} ${touched[*]}"
    exit 1
    ;;
esac

show_run
fixable=()
while read -r check; do fixable+=("$check"); done < <(read_run "$out/run.jsonl" fixable)
if [ "${#fixable[@]}" -eq 0 ]; then
  note "refused: $short fails the checks above (${took}s); fix it, commit, and push again"
  exit 1
fi

# Never amend. Pushing HEAD: t writes the fixes into the working tree (leaving alone any file
# edited since the commit). Pushing another commit: they come as a patch on top of it.
patch=""
if [ "$pushed" = "$(git rev-parse HEAD)" ]; then
  t fix -C "$top" --rev "$pushed" --json "${fixable[@]}" >"$out/fix.jsonl" 2>"$out/fix.err" || true
else
  patch="$(git rev-parse --absolute-git-dir)/t-fix.patch"
  t fix -C "$top" --rev "$pushed" --patch="$patch" --json "${fixable[@]}" >"$out/fix.jsonl" 2>"$out/fix.err" || true
fi
fixed=()
while read -r file; do fixed+=("$file"); done < <(read_run "$out/fix.jsonl" changed)
skipped=()
while read -r file; do skipped+=("$file"); done < <(read_run "$out/fix.jsonl" skipped)
if [ "${#fixed[@]}" -eq 0 ]; then
  cat "$out/fix.err" >&2
  note "refused: $short fails the checks above, and \`t fix ${fixable[*]}\` changed nothing"
  [ "${#skipped[@]}" -eq 0 ] || note "  left alone (edited since the commit, or outside the checks' inputs): ${skipped[*]}"
  exit 1
fi
if [ -z "$patch" ]; then
  note "t fixed ${fixed[*]}: commit them and push again"
else
  note "t fixed ${fixed[*]} in $short, which is not your HEAD; the fix is in"
  note "  $patch: git apply it, commit, and push again"
fi
[ "${#skipped[@]}" -eq 0 ] || note "left alone (edited since the commit, or outside the checks' inputs): ${skipped[*]}"
exit 1
