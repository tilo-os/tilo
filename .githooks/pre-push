#!/usr/bin/env bash
# Lint the packages a push changes before the refs leave, with the
# repository's format check over the changed files and Clippy over the host's
# targets with the features the workspace's whole build gives each package; a
# package the page family names is linted for wasm32 too. The packages that
# build directly on them through a path dependency are compiled, never linted:
# only a compile error there refuses the push. A push to main is
# compared with main's head; one to another branch with the branch's old head,
# or where it forked (from its old head after a force-push, from main when the
# branch is new). What a change reaches through the direct dependants, and
# the packages as they ship, is t's own families (`clippy`, `clippy-{arch}`,
# `clippy-shipped`, `clippy-page`) on every change (`t main` names the one that
# broke it): run here, those rebuilds took minutes and lost the race to main's
# next commit on every retry.
# tools/ci/pre_push_lint.py selects the packages and, where t is installed,
# asks t for its per-package clippy checks of them: t answers a package whose
# build reads nothing a rebase changed from its result cache, so a push retried
# after a rebase onto unrelated commits takes seconds.
#
# It is Git's own hook: this clone runs it through core.hooksPath (see
# CONTRIBUTING.md). There is no environment variable to skip it; the escape is
# Git's `--no-verify`, which contributors are asked never to use.
set -euo pipefail
# The lint reads Cargo metadata through the repository's own tools, which need
# Python 3.11 or newer (tomllib); the same requirement as the pre-commit hook.
. "$(dirname -- "${BASH_SOURCE[0]}")/python.sh"
root="$(git rev-parse --show-toplevel)"
# Git passes the remote's name and URL as arguments and writes the refs it is
# updating on stdin, which the lint reads unchanged.
exec python3 "$root/tools/ci/pre_push_lint.py" "${1:-origin}"
