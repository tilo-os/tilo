#!/usr/bin/env bash
# Lint what a push can break, natively and for the page, before the refs leave.
# This is the fast subset of what CI checks: the repository's format check over
# the changed files, Clippy over the host's targets with the features the
# workspace's whole build gives each package, and Clippy for wasm32 on the
# packages that build for the page, because a crate can compile here and still
# break the page (std's clocks and files are not there). It lints the packages
# the pushed commits change and the packages whose own source names something
# they changed, because a rename or a removed item breaks the crates that use
# it, not the crate that declares it; the runs start together, so a one-crate
# push costs about one build. tools/ci/pre_push_lint.py selects them and runs
# them; a run that passed is not repeated while nothing it reads has changed, so
# a push retried after a rebase onto unrelated commits does not lint again.
#
# It is Git's own hook: this clone runs it through core.hooksPath (see
# CONTRIBUTING.md). There is no environment variable to skip it; the escape is
# Git's `--no-verify`, which contributors are asked never to use.
set -euo pipefail
# The lint reads Cargo metadata through the repository's own tools, which need
# Python 3.11 or newer (tomllib); the same requirement as the pre-commit hook.
if ! python3 -I -c 'import tomllib' 2>/dev/null; then
  echo "git hook: the pre-push lint needs Python 3.11 or newer as python3; install it and put it first on PATH" >&2
  exit 1
fi
root="$(git rev-parse --show-toplevel)"
# Git passes the remote's name and URL as arguments and writes the refs it is
# updating on stdin, which the lint reads unchanged.
exec python3 "$root/tools/ci/pre_push_lint.py" "${1:-origin}"
