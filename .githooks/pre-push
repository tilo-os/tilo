#!/usr/bin/env bash
# Pushes to a remote are plain pushes: main's CI runs on every commit and reports what broke to
# whoever pushed it.
#
# Landing on the local `integration` branch (`git push . HEAD:integration`) first runs what the
# change can break, against the integration it lands on (tools/ci/test-changed.sh --stage
# check,clippy,test): clippy with `-D warnings` over every target of the packages it changes and
# their direct dependants, the tests of the packages it affects, and the portable tilo-ui and
# headless tilo-app builds when the change reaches them. Any failure refuses the landing, so
# integration stays promotable to main; fix it and push again. The headless session e2e is left
# to the batch check on integration.
set -uo pipefail

remote_name=$1
[ "$remote_name" = "." ] || exit 0

root=$(git rev-parse --show-toplevel) || exit 1
head=$(git rev-parse HEAD) || exit 1
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = refs/heads/integration ] || continue
    [ "$local_sha" != "$zero" ] || continue
    # Nothing new on integration: a push of what it already holds checks nothing.
    [ "$local_sha" != "$remote_sha" ] || continue
    if [ "$local_sha" != "$head" ]; then
        echo "pre-push: land on integration from the commit checked out (git push . HEAD:integration)," \
            "so the checks see what lands" >&2
        status=1
        continue
    fi
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        echo "pre-push: commit or set aside your uncommitted changes before landing on integration," \
            "so the checks see what lands" >&2
        status=1
        continue
    fi
    base=$remote_sha
    [ "$base" != "$zero" ] || base=origin/main
    echo "pre-push: landing on integration; checking what the change can break (against ${base:0:12})" >&2
    started=$SECONDS
    if ! "$root/tools/ci/test-changed.sh" --stage check,clippy,test --base "$base" </dev/null; then
        echo "pre-push: the checks refused the landing after $((SECONDS - started)) s; fix the failures above and push again" >&2
        status=1
    else
        echo "pre-push: checks passed in $((SECONDS - started)) s" >&2
    fi
done
exit "$status"
