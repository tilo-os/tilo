#!/usr/bin/env bash
# A push to main runs t's push gate on exactly the commit being pushed (docs/t.md, "How changes
# reach a release"), and it has to be fast: main is where changes integrate, not what ships, and
# CI on main runs everything else on every commit and tells whoever broke it. The gate runs
# (tools/ci/pre_push.py): rustfmt of the changed Rust files, the policy steps, generated-file and
# manifest checks whose inputs the change touches, the diff gates (`changes`), clippy of the
# packages it changes and the aarch64 size check of the apps it changes, when t has the commit's
# shared runtime built. No tests, VM checks, images, suites or dependents. A check red on main
# runs too: t compares its failures with main's where the push branched off, lints and policy
# problems one finding at a time, so what main has too passes and a finding the change adds
# refuses the push; one t can fix is fixed for you to commit (never amended). A change that
# passed and was rebased onto a newer main as the same patch passes again without a run. Pushes
# to other branches run nothing.
set -euo pipefail
note() { printf 'pre-push: %s\n' "$*" >&2; }

remote=$1
pushed=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  # Deleting main is not a change to test.
  [[ $local_sha =~ ^0+$ ]] && continue
  # main moved since the last fetch: the push would be refused after the checks anyway.
  if [[ ! $remote_sha =~ ^0+$ ]] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    note "main moved on $remote: git fetch $remote && git rebase $remote/main, then push again"
    exit 1
  fi
  pushed=$local_sha
  onto=$remote_sha
done
[ -n "$pushed" ] || exit 0

# A gate takes minutes, and main moves meanwhile: the push is refused, and the change, rebased,
# is a new commit. What the gate judges is the change, not main's newer commits (main's CI
# checks those, and the change on top of them, after the push), so a change that passed it
# passes again as long as it is the same patch: `git patch-id` of what it changes on the main
# it goes onto, line numbers aside. A rebase that changed the patch, or its context, runs the
# gate again. Kept per clone, for every worktree of it.
passed="$(git rev-parse --git-common-dir)/t-gate-passed"
change=""
if [[ ! $onto =~ ^0+$ ]]; then
  change=$(git diff --binary "$onto" "$pushed" -- | git patch-id --stable | cut -d' ' -f1)
fi
if [ -n "$change" ] && [ -f "$passed" ] && earlier=$(grep -m1 "^$change " "$passed"); then
  note "this change passed the gate as ${earlier#* } on an older main; the same patch passes again (main checks it after the push)"
  exit 0
fi
gate_passed() {
  [ -n "$change" ] || return 0
  { tail -n 199 "$passed" 2>/dev/null; echo "$change ${pushed:0:10}"; } >"$passed.new" && mv "$passed.new" "$passed"
}

if ! git config --get merge.generated.driver >/dev/null; then
  note "the merge drivers for generated files are not set up: run python3 tools/dev/install-git-hooks.py"
fi
if ! command -v t >/dev/null; then
  note "t is not installed, so the push gate can't run (docs/t.md, Setting up)"
  exit 1
fi
if ! t test --help 2>/dev/null | grep -q -- '--rev'; then
  note "this t can't test a commit by itself (\`t test --rev\`): run \`t self-update\`, then push again"
  exit 1
fi
# t compares the commit with main where it branched off.
git fetch --quiet "$remote" main 2>/dev/null || true

# t takes the commit's files from git's objects (`--rev`): uncommitted changes and untracked
# files never reach the gate, and no checkout of the commit is needed.
top=$(git rev-parse --show-toplevel)
# The policy steps a push runs, from the pushed commit's own tools/policy/steps.toml
# (`pre_push = true`, tools/ci/pre_push.py says why it never marks another): what its policy checks
# will cost, chosen without reading this clone's tree. The hook's Python runs with `-I`, which
# leaves the script's directory off sys.path; the manifest is only a file.
steps=$(git show "$pushed:tools/policy/steps.toml" 2>/dev/null | python3 -I -c 'import sys, tomllib
try:
    manifest = tomllib.loads(sys.stdin.read())
except (tomllib.TOMLDecodeError, KeyError):
    sys.exit(0)
print(" ".join(sorted("policy/tests/" + step["name"] if step.get("tests") else
    step.get("covered_by") or "policy/" + step["name"]
    for step in manifest.get("step", []) if step.get("pre_push") is True)))')
short=$(git rev-parse --short "$pushed")
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
started=$SECONDS

# What the commit touches: the default checks of the packages whose files it changes and of the
# command checks whose inputs it changes.
scoped=1
t scope -C "$top" --rev "$pushed" --json >"$out/scope.json" 2>"$out/scope.err" || scoped=0
if [ "$scoped" = 0 ]; then
  note "t can't tell what $short touches, so only fmt-changed and changes run:"
  sed 's/^/    /' "$out/scope.err" >&2
  : >"$out/scope.json"
fi
base=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1])).get("base", ""))' "$out/scope.json" 2>/dev/null || true)
git diff --name-only "${base:-$pushed^}" "$pushed" -- >"$out/changed" 2>/dev/null || : >"$out/changed"

# Of those, what a push runs (tools/ci/pre_push.py says why): its own cheap checks, chosen
# without waiting for anything that talks to t. A policy step runs when t.toml marks it
# `pre_push = true`; the steps that build or index the whole tree are main's. A check t's
# failure comparison finds red on main runs all the same.
run_cheap() {
  python3 -I "$top/tools/ci/pre_push.py" select --scope "$out/scope.json" --changed "$out/changed" \
    --policy-steps "$steps" >"$out/plan.json"
}
plan_started=$SECONDS
run_cheap
read -r -a gate <<<"$(python3 -I -c 'import json, sys; print(" ".join(json.load(open(sys.argv[1]))["run"]))' "$out/plan.json")"
# The gate runs its cheap checks on their own, at the priority that runs first, and each one is
# minutes of a loaded node: a policy step a push doesn't run, and the size check waiting for t to
# say whether the commit's shared runtime is built, must not be queued in front of it. What each
# leaves out is in `$out/skipped`, which the push says and records.
: >"$out/skipped"
kept=()
size_checks=()
for check in "${gate[@]}"; do
  case $check in
    policy/*)
      printf '%s\n' "$check is not one a push runs (t.toml: pre_push); main runs it" >>"$out/skipped"
      continue
      ;;
    app-size/*) size_checks+=("$check") ;;
  esac
  kept+=("$check")
done
gate=(${kept[@]+"${kept[@]}"})

# The size checks of the apps the commit touches, when they are at most three and t has the
# commit's shared runtime built; a skip is said. Each decision is recorded in the clone, one line
# each, to be counted.
if [ -n "${size_checks[*]:-}" ]; then
  read -r -a sized <<<"$(python3 -I "$top/tools/ci/pre_push.py" sizes --top "$top" --rev "$pushed" \
    --record "$(git rev-parse --git-common-dir)/t-gate-sizes" "${size_checks[@]}")"
  gate+=(${sized[@]+"${sized[@]}"})
fi
plan_took=$((SECONDS - plan_started))

# The opt-in checks the change touches, which a push doesn't run (`t suggest`, of the working
# tree: it has no --rev, so only when the pushed commit is HEAD).
if [ "$pushed" = "$(git rev-parse HEAD)" ]; then
  t suggest -C "$top" --json >"$out/suggest.json" 2>/dev/null &
  suggest=$!
fi

status=0
t test -C "$top" --rev "$pushed" --priority high --json "${gate[@]}" \
  >"$out/run.jsonl" 2>"$out/stderr" || status=$?
took=$((SECONDS - started))
what="${#gate[@]} checks"
# What the push left out, each with why, and how long the gate waited to decide it.
if [ -s "$out/skipped" ]; then
  note "not run before a push (main runs them; t test <check> runs one):"
  sed 's/^/    /' "$out/skipped" >&2
fi
[ "$plan_took" -lt 10 ] || note "choosing the checks took ${plan_took}s: t was slow to say whether the size check's runtime is built"

if [ -n "${suggest:-}" ] && wait "$suggest"; then
  opt_in=$(python3 -I "$top/tools/ci/pre_push.py" opt-in --suggest "$out/suggest.json")
  [ -z "$opt_in" ] || note "$opt_in"
fi

# The run's id, its fixable failures that may be the change's, and what a fix changed.
read_run() {
  python3 -I - "$1" "$2" <<'EOF'
import json, sys
path, want = sys.argv[1], sys.argv[2]
for line in open(path, encoding="utf-8", errors="replace"):
    try:
        event = json.loads(line)
    except ValueError:
        continue
    kind = event.get("type")
    if want == "run" and kind in ("planned", "done") and event.get("run"):
        print(event["run"])
        break
    if want == "fixable" and kind == "result" and event.get("outcome") == "fail" \
            and event.get("fix") and not event.get("fixed") \
            and (event.get("blame") or {}).get("kind") not in ("inherited", "flaky"):
        print(event["check"])
    if want in ("changed", "skipped") and kind == "fixed":
        for path in event.get(want, []):
            print(path)
EOF
}
run=$(read_run "$out/run.jsonl" run)
show_run() {
  if [ -n "$run" ]; then t show "$run" >&2 || true; else cat "$out/stderr" >&2; fi
}

# Every check the run did not pass, and why: a refusal names each one, whatever its outcome, and
# a pass names what fails on main too, and whether it was compared finding by finding.
python3 -I "$top/tools/ci/pre_push.py" unpassed --run "$out/run.jsonl" "${gate[@]}" >"$out/unpassed"
case $status in
  0) gate_passed; note "t passed $short in ${took}s ($what)"; exit 0 ;;
  3)
    gate_passed
    note "t passed $short in ${took}s ($what): what fails, fails on main too (t main):"
    sed 's/^/    /' "$out/unpassed" >&2
    exit 0
    ;;
esac
refused() {
  note "refused: $short in ${took}s ($what${run:+, $run}): $*"
  if [ -s "$out/unpassed" ]; then
    sed 's/^/    /' "$out/unpassed" >&2
  else
    # No check's result says why, so t's own words are all there is.
    tail -n 5 "$out/stderr" | sed 's/^/    /' >&2
  fi
}

if [ "$status" != 1 ]; then
  refused "t could not finish the push gate (exit $status); a failure of t, not of the change:"
  note "push again once t can run them; t status shows the server and its nodes"
  exit 1
fi

show_run
fixable=()
while read -r check; do fixable+=("$check"); done < <(read_run "$out/run.jsonl" fixable)
if [ "${#fixable[@]}" -eq 0 ]; then
  refused "fix these, commit, and push again:"
  exit 1
fi

# Never amend. Pushing HEAD: t writes the fixes into the working tree (leaving alone any file
# edited since the commit). Pushing another commit: they come as a patch on top of it.
patch=""
if [ "$pushed" = "$(git rev-parse HEAD)" ]; then
  t fix -C "$top" --rev "$pushed" --json "${fixable[@]}" >"$out/fix.jsonl" 2>"$out/fix.err" || true
else
  patch="$(git rev-parse --absolute-git-dir)/t-fix.patch"
  t fix -C "$top" --rev "$pushed" --patch="$patch" --json "${fixable[@]}" >"$out/fix.jsonl" 2>"$out/fix.err" || true
fi
fixed=()
while read -r file; do fixed+=("$file"); done < <(read_run "$out/fix.jsonl" changed)
skipped=()
while read -r file; do skipped+=("$file"); done < <(read_run "$out/fix.jsonl" skipped)
if [ "${#fixed[@]}" -eq 0 ]; then
  cat "$out/fix.err" >&2
  note "refused: $short fails the checks above, and \`t fix ${fixable[*]}\` changed nothing"
  [ "${#skipped[@]}" -eq 0 ] || note "  left alone (edited since the commit, or outside the checks' inputs): ${skipped[*]}"
  exit 1
fi
if [ -z "$patch" ]; then
  note "t fixed ${fixed[*]}: commit them and push again"
else
  note "t fixed ${fixed[*]} in $short, which is not your HEAD; the fix is in"
  note "  $patch: git apply it, commit, and push again"
fi
[ "${#skipped[@]}" -eq 0 ] || note "left alone (edited since the commit, or outside the checks' inputs): ${skipped[*]}"
exit 1
