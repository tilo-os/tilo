#!/usr/bin/env bash
# Judges the commit being made, not the repository: every check reads the files
# the commit stages, from the index, so its cost follows the size of the change
# instead of the size of the tree. The checks whose verdict compares files
# across the tree judge it in the policy suite, which CI applies to every
# pushed head, and compilation stays in CI. The one generated file that exists
# only as a compiled answer is the component catalogue, so its step compiles
# the toolkit, and only for a commit that stages a widget source.
set -euo pipefail
# The policy scripts need Python 3.11 or newer (tomllib). On macOS the python3 first on PATH is
# often the system's 3.9, which fails every commit; put a newer interpreter's directory first.
if ! python3 -I -c 'import tomllib' 2>/dev/null; then
  for py in python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    found=$(command -v "$py" 2>/dev/null) || continue
    dir=$(dirname "$found")
    if [ -x "$dir/python3" ] && "$dir/python3" -I -c 'import tomllib' 2>/dev/null; then
      PATH="$dir:$PATH"; export PATH; break
    fi
  done
  if ! python3 -I -c 'import tomllib' 2>/dev/null; then
    echo "git hook: these checks need Python 3.11 or newer as python3; install it and put it first on PATH" >&2
    exit 1
  fi
fi
root="$(git rev-parse --show-toplevel)"
full_index="$(git rev-parse --git-path index)"
fail=0

# Keep the real manifest pairing for lock validation: a combined merge lock
# differs from both parents even when each manifest was taken from one parent.
lock_staged_names=$(git diff --cached --name-only)

# This inventory compares tracked paths with the working tree's baseline.
# Run before the merge-only index hides scripts inherited from main, or
# those baseline entries would incorrectly look like removed scripts.
# Both judge the files this commit stages, read from the real index: what a
# merge inherits, and the exceptions that pin those assets, are part of what it
# commits, so they are judged here, before the filtered copy below puts them
# back at HEAD. A file a commit leaves as HEAD has it was judged by the commit
# that wrote it, and the whole tree is judged by the policy suite and by CI on
# every pushed head. Reading the change rather than the twenty thousand files
# around it is what keeps the hook's cost with the size of the commit.
GIT_INDEX_FILE="$full_index" python3 "$root/tools/policy/check_image_interpreters.py" --staged || fail=1
GIT_INDEX_FILE="$full_index" python3 "$root/tools/policy/check_source_content.py" --staged || fail=1

# Merging main into a branch stages everything main changed since the branch
# point, thousands of files that main's own checks already passed. The checks
# below read the staged change through the index, so they run against a copy
# of it in which every file staged exactly as the merged-in side has it is
# back at HEAD: what is left is what the merge resolution itself changed.
if merge_head=$(git rev-parse -q --verify MERGE_HEAD); then
  merge_index=$(mktemp)
  trap 'rm -f "$merge_index"' EXIT
  cp "$(git rev-parse --git-path index)" "$merge_index"
  differs_from_merged=$(git diff --cached --name-only "$merge_head")
  taken_from_merged=$(git diff --cached --name-only HEAD \
    | grep -vxF -f <(printf '%s\n' "$differs_from_merged") || true)
  # A combined lockfile needs the inherited manifest changes as context too.
  # Otherwise filtering those manifests makes a valid merge look lock-only.
  if grep -qx 'Cargo.lock' <<< "$differs_from_merged"; then
    taken_from_merged=$(grep -vE '(^|/)Cargo\.toml$' <<< "$taken_from_merged" || true)
  fi
  if [ -n "$taken_from_merged" ]; then
    printf '%s\n' "$taken_from_merged" \
      | GIT_INDEX_FILE="$merge_index" git reset -q HEAD --pathspec-from-file=- --
  fi
  export GIT_INDEX_FILE="$merge_index"
fi
python3 "$root/tools/policy/check_public_references.py" --staged || fail=1
note() { printf '  %s\n' "$*" >&2; }

# Every crate on disk must be a workspace member; --staged judges the crate
# manifests this commit stages, and the policy suite and CI judge the tree.
"$root/scripts/check-workspace-complete.sh" --staged
# These judge a file by its own text, so a commit can only introduce a
# violation in a file it stages: `--staged` judges the commit's files, read
# from the index, instead of reading the ten thousand of the tree on every
# commit. That is what keeps the hook to a few seconds. Nothing slips through:
# tools/policy/run.sh and CI run each of these over the whole tree, and this
# hook is the fast answer, not the only one.
python3 "$root/tools/policy/check_app_text_contract.py" --staged
python3 "$root/tools/policy/check_session_copy_contract.py" --staged
python3 "$root/tools/policy/check_app_window_inputs_contract.py" --staged
python3 "$root/tools/policy/check_ui_clock_contract.py" --staged
python3 "$root/tools/policy/check_clock_contract.py" --staged
python3 "$root/tools/policy/check_formats.py" --staged || fail=1
python3 "$root/tools/policy/check_settings_writes.py" --staged || fail=1
python3 "$root/tools/policy/check_swallowed_failures.py" --staged || fail=1
python3 "$root/tools/policy/check_module_reachability.py" --staged || fail=1
python3 "$root/tools/policy/check_too_many_arguments.py" --staged || fail=1
# A commit may not add a name core.md's table rejects. Judged on what the
# commit adds, so names already on main do not block it.
python3 "$root/tools/policy/check_words_that_go.py" --staged || fail=1
# A commit may not add a word its translation lacks: the catalogue a lane edits
# is judged whole, its source key beside every line the commit leaves in each
# translation of the same unit.
python3 "$root/tools/policy/check_catalogue_coverage.py" --staged || fail=1
# A wire enum keeps every variant it had, in its place: bytes already written
# keep meaning what they meant (docs/policies.md). Judged against HEAD, so a
# merge is charged only with what its resolution changed.
python3 "$root/tools/policy/check_wire_enums.py" staged || fail=1
# Checks whose verdict compares files across the tree are not here. App copy
# resolution, the session loop's blocking rules, wire attributes and interface
# versions each read many files to answer, so they judge the whole tree in the
# policy suite, which t applies as its `policy/{step}` checks on every new head
# of main. They are as strict there as they were here; a commit no longer reads
# the tree to learn what it already knows.
# The suite manifest (`tools/ci/suites.py check`) is one of them: it holds every
# test-shaped file and every cross-package reader in the tree against
# tools/ci/suites.toml, so it is applied with them.

# The staged names and diffs, read once. Every check below matches against
# these variables, never against a pipe from git: under pipefail, a `grep -q`
# that stops reading at its first match leaves git writing into a closed pipe,
# and on a large diff the pipeline then reports git's SIGPIPE instead of the
# match.
staged_names=$(git diff --cached --name-only)

# The code map is generated from the crates' manifests and crate docs. A change
# to one, or a merge whose driver took one side of the map
# (.githooks/merge-generated), leaves it stale; regenerating it is not a
# judgement call, so do it here, into the whole index even in a merge. A map
# with unstaged edits is left alone: staging it would stage those too.
if grep -qE '(^|/)(Cargo\.toml|lib\.rs|main\.rs)$|^docs/codemap\.md$' <<< "$lock_staged_names" \
   && ! python3 "$root/tools/docs/codemap.py" --check 2>/dev/null; then
  if GIT_INDEX_FILE="$full_index" git diff --quiet -- docs/codemap.md \
     && python3 "$root/tools/docs/codemap.py" >/dev/null \
     && GIT_INDEX_FILE="$full_index" git add -- docs/codemap.md; then
    note "docs/codemap.md: regenerated and staged"
  else
    note "docs/codemap.md is stale: run python3 tools/docs/codemap.py and stage it"
    fail=1
  fi
fi

# os/Containerfile is os/image/'s pieces in one file (tools/ci/os/pieces.py), so one
# `podman build` makes the whole image. The generator is plain Python, and a change to a piece or
# the layer plan leaves the file stale, so write it here and stage what it wrote. The test that
# holds the same invariant (tools/tests/test_os_pieces.py) is what CI runs; writing it is not a
# judgement call.
if grep -qE '^(os/image/|os/Containerfile$|tools/ci/os/pieces\.py$)' <<< "$lock_staged_names"; then
  if ! GIT_INDEX_FILE="$full_index" git diff --quiet -- os/Containerfile; then
    note "os/Containerfile has unstaged edits: stage the whole file and commit again"
    fail=1
  elif ! python3 "$root/tools/ci/os/pieces.py" write; then
    note "os/Containerfile could not be written; run python3 tools/ci/os/pieces.py write"
    fail=1
  elif ! GIT_INDEX_FILE="$full_index" git diff --quiet -- os/Containerfile; then
    GIT_INDEX_FILE="$full_index" git add -- os/Containerfile
    note "os/Containerfile: written from os/image/ and staged"
  fi
fi

# crates/workspace-hack (cargo-hakari) unifies third-party features across the workspace and
# each member's selectable features; it is generated from the manifests and must name every
# workspace member, so a crate added or a dependency changed without regenerating splits the
# shared build and fails the hakari check. Regenerating is not a judgement call: run cargo
# hakari here and stage what it wrote. It edits member manifests too (manage-deps adds the
# workspace-hack dependency), so those are staged as well; a file that already had unstaged
# edits is left for its author and the commit fails.
if grep -qE '(^|/)Cargo\.toml$|^Cargo\.lock$' <<< "$lock_staged_names"; then
  if command -v cargo >/dev/null 2>&1 && cargo hakari --version >/dev/null 2>&1; then
    hakari_dirty=$(GIT_INDEX_FILE="$full_index" git diff --name-only)
    if cargo hakari generate >/dev/null 2>&1 && cargo hakari manage-deps --yes >/dev/null 2>&1; then
      hakari_wrote=0
      hakari_left=""
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        if grep -qxF "$f" <<< "$hakari_dirty"; then
          hakari_left="$hakari_left$f"$'\n'
        else
          GIT_INDEX_FILE="$full_index" git add -- "$f"
          hakari_wrote=$((hakari_wrote + 1))
        fi
      done < <(GIT_INDEX_FILE="$full_index" git diff --name-only -- '*Cargo.toml' 'Cargo.lock' \
                 'crates/workspace-hack/**')
      if [ "$hakari_wrote" -gt 0 ]; then
        note "crates/workspace-hack: regenerated from the manifests and staged"
      fi
      if [ -n "$hakari_left" ]; then
        note "crates/workspace-hack: these have unstaged edits, stage the whole file and commit again:"
        printf '%s' "$hakari_left" | sed 's/^/  /' >&2
        fail=1
      fi
    else
      note "crates/workspace-hack could not be regenerated: run 'cargo hakari generate && cargo hakari manage-deps --yes' and stage what it wrote"
      fail=1
    fi
  else
    note "a Cargo manifest changed and cargo-hakari is not installed: run 'cargo hakari generate && cargo hakari manage-deps --yes' and stage what it wrote"
    fail=1
  fi
fi

# The SDK's types and the API's description (docs/api/openapi.json) are
# generated from the apps' surfaces and manifests (`tilo sdk gen`), so a
# change to either leaves them stale: they are what an
# agent or a script reads an app's actions from, and nothing else in a commit
# notices. Regenerating them is not a judgement call, so do it here and stage
# what it wrote; a tree that can do neither below is told the one command that
# writes them, rather than left stale.
if grep -qE '^apps/[^/]+/(surface|tilo-app)\.toml$' <<< "$lock_staged_names"; then
  sdk_paths="sdk/python/src/tilo/types sdk/typescript/src/types docs/api"
  sdk_langs="python:sdk/python/src/tilo/types ts:sdk/typescript/src/types openapi:docs/api"
  # Which generated files the person is editing by hand: those are left
  # alone, since staging them would stage their edits too.
  sdk_dirty=$(git diff --name-only -- $sdk_paths)
  # What lay there untracked before anything was written stays the person's own.
  sdk_untracked=$(git ls-files --others --exclude-standard -- $sdk_paths)
  sdk_done=""
  # With a cargo drop-in that runs a command on a build server ($CARGO), the
  # generator is built and run there from this tree's sources, as the builder
  # already holds this worktree's build, and the files it writes come back into
  # the tree: nothing to build or download here. Its own index, so it sees the
  # whole tree.
  cargo_dropin=${CARGO:-cargo}
  if "$cargo_dropin" exec --help >/dev/null 2>&1; then
    sdk_script="set -e"
    for spec in $sdk_langs; do
      sdk_script="$sdk_script; cargo run --locked -q -p tilo-cli -- sdk gen --lang ${spec%%:*} --out ${spec#*:}"
    done
    note "sdk: an app's surface changed; writing the SDK's types on the builder ($cargo_dropin)"
    sdk_log=$(mktemp)
    if (cd "$root" && GIT_INDEX_FILE="$full_index" "$cargo_dropin" exec sh -c "$sdk_script") >"$sdk_log" 2>&1; then
      sdk_done=drop-in
    else
      note "sdk: writing them on the builder failed:"
      tail -n 20 "$sdk_log" | sed 's/^/  /' >&2
    fi
    rm -f "$sdk_log"
  fi
  if [ -z "$sdk_done" ]; then
    # Like the tilolang formatter below: the freshest generator this tree has
    # built into target/, under any profile, answering `--help` so a binary for
    # another platform is skipped rather than run.
    sdk_gen=""
    sdk_found=()
    while IFS= read -r -d '' c; do sdk_found+=("$c"); done < <(
      find "$root/target" -maxdepth 4 -type f -name tilo -perm -u+x -print0 2>/dev/null)
    if [ "${#sdk_found[@]}" -gt 0 ]; then
      while IFS= read -r c; do
        [ -n "$c" ] && [ -x "$c" ] || continue
        case "$("$c" --help 2>&1)" in
          *"sdk"*) sdk_gen=$c; break ;;
        esac
      done < <(ls -td -- "${sdk_found[@]}" 2>/dev/null || true)
    fi
    if [ -n "$sdk_gen" ]; then
      sdk_done=$sdk_gen
      # A generator found in target/ can be older than this tree: built before a
      # rebase, or copied from another worktree. What it knows of the API itself is
      # compiled into it, so its whole output would take out of
      # docs/api/openapi.json whatever main gained since it was built. So only what
      # the surfaces changed is taken from it: it writes the files once from HEAD's
      # surfaces and once from this tree's, and what differs between the two is
      # merged into the files as they stand. A generator as new as the tree, on
      # files that were current, changes them exactly as its whole output would.
      sdk_scratch=$(mktemp -d)
      mkdir -p "$sdk_scratch/head" "$sdk_scratch/was" "$sdk_scratch/now"
      sdk_failed=""
      # All a generator reads from a checkout: each app's surface and manifest.
      sdk_inputs=$(git ls-tree -r --name-only HEAD -- apps 2>/dev/null \
        | grep -E '^apps/[^/]+/(surface|tilo-app)\.toml$' || true)
      if [ -n "$sdk_inputs" ]; then
        # shellcheck disable=SC2086
        git archive HEAD -- $sdk_inputs | tar -x -C "$sdk_scratch/head" || sdk_failed=1
      fi
      for spec in $sdk_langs; do
        sdk_lang=${spec%%:*}
        sdk_out=${spec#*:}
        mkdir -p "$sdk_scratch/was/$sdk_out" "$sdk_scratch/now/$sdk_out"
        if [ -n "$sdk_inputs" ]; then
          (cd "$sdk_scratch/head" \
            && "$sdk_gen" sdk gen --lang "$sdk_lang" --out "$sdk_scratch/was/$sdk_out") \
            >/dev/null 2>&1 || sdk_failed=1
        fi
        (cd "$root" && "$sdk_gen" sdk gen --lang "$sdk_lang" --out "$sdk_scratch/now/$sdk_out") \
          >/dev/null || sdk_failed=1
      done
      if [ -z "$sdk_failed" ]; then
        while IFS= read -r f; do
          [ -n "$f" ] || continue
          if [ ! -e "$sdk_scratch/was/$f" ] || [ ! -e "$root/$f" ]; then
            mkdir -p "$(dirname "$root/$f")"
            cp "$sdk_scratch/now/$f" "$root/$f"
          elif ! cmp -s "$sdk_scratch/was/$f" "$sdk_scratch/now/$f"; then
            if git merge-file -p "$root/$f" "$sdk_scratch/was/$f" "$sdk_scratch/now/$f" \
              >"$sdk_scratch/merged" 2>/dev/null; then
              cat "$sdk_scratch/merged" >"$root/$f"
            else
              note "sdk: $f changed on both sides of this surface change"
              sdk_failed=1
            fi
          fi
        done < <(cd "$sdk_scratch/now" && find . -type f | sed 's|^\./||' | sort)
      fi
      rm -rf "$sdk_scratch"
      if [ -n "$sdk_failed" ]; then
        note "the SDK's types could not be written with $sdk_gen; run 't fix sdk-types'"
        fail=1
      fi
    fi
  fi
  if [ -n "$sdk_done" ]; then
    sdk_wrote=0
    sdk_left=""
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if grep -qxF "$f" <<< "$sdk_dirty"; then
        sdk_left="$sdk_left$f"$'\n'
      else
        GIT_INDEX_FILE="$full_index" git add -- "$f"
        sdk_wrote=$((sdk_wrote + 1))
      fi
    # The files that changed, and the ones a new app's first surface made: git diff names
    # no file it does not track yet, and a commit without them leaves the app's types out.
    done < <(GIT_INDEX_FILE="$full_index" git diff --name-only -- $sdk_paths
             git ls-files --others --exclude-standard -- $sdk_paths \
               | grep -vxF -f <(printf '%s\n' "$sdk_untracked") || true)
    if [ "$sdk_wrote" -gt 0 ]; then
      note "sdk: wrote the types of the apps whose surface changed and staged them"
    fi
    if [ -n "$sdk_left" ]; then
      note "sdk: these have unstaged edits, stage the whole file and commit again:"
      printf '%s' "$sdk_left" | sed 's/^/  /' >&2
      fail=1
    fi
  else
    note "sdk: an app's surface changed and this tree has no generator built; run 't fix sdk-types' and stage sdk/"
    fail=1
  fi
fi

# The component catalogue (`crates/ui/ui-graph/components.json`) is the toolkit's described
# widgets as data: each widget's doc text and props, generated from the widget itself. The
# crates below the toolkit read it at build time (tilo-view builds a builder per component from
# it, tilolang its `ui` package), so it is committed, and a widget whose description changed
# leaves it stale. Regenerating it is not a judgement call: do it here with this tree's own
# generator and stage what it wrote. The toolkit's test holds the same invariant, so a tree
# that cannot build now leaves the file as it is rather than holding up the commit.
# The crates of widgets a window builds by name (tilo-app-window's `components`).
widget_dirs=(crates/ui/ui-core/src crates/ui/tilo-rich-edit/src)
widget_pattern="^($(IFS='|'; echo "${widget_dirs[*]}"))/.*\.rs$"
widget_sources=$(grep -vE '(_tests\.rs|/tests\.rs|/tests/)' <<< "$lock_staged_names" \
  | grep -E "$widget_pattern" || true)
if [ -n "$widget_sources" ]; then
  catalogue=crates/ui/ui-graph/components.json
  # The generator reads the tree, so a widget source with unstaged edits would be generated
  # into this commit: it is left alone, as rustfmt leaves such a file alone. Unstaged means
  # against the whole index: in a merge GIT_INDEX_FILE is the copy with the merged-in side's
  # files put back at HEAD, against which every file the merge took reads as an unstaged edit.
  if ! GIT_INDEX_FILE="$full_index" git diff --quiet -- "${widget_dirs[@]}"; then
    note "component catalogue: ${widget_dirs[*]} has unstaged edits; stage the whole tree \
and commit again, or regenerate it with 'cargo run -p tilo-app-window --example component-catalogue > $catalogue'"
  else
    # The sources and catalogue already generated in an earlier commit need no second build: a
    # fixup, or a rebase replaying a commit, is the same tree and the same answer.
    sources_id=$(GIT_INDEX_FILE="$full_index" git ls-files -s -- "${widget_dirs[@]}" \
      | git hash-object --stdin)
    catalogue_id=$(GIT_INDEX_FILE="$full_index" git rev-parse -q --verify ":$catalogue" || true)
    verified_at="$(git rev-parse --path-format=absolute --git-dir)/component-catalogue-verified"
    if [ "$(cat "$verified_at" 2>/dev/null)" != "$sources_id $catalogue_id" ]; then
      # No binary is built for this: the generator is the window's registry itself, so the one
      # command that writes the catalogue compiles it first.
      cat_run=()
      if command -v cargo >/dev/null 2>&1; then
        cat_run=(cargo run --locked -q -p tilo-app-window --example component-catalogue)
      fi
      cat_generated=""
      if [ "${#cat_run[@]}" -gt 0 ]; then
        # A commit lands work, so its build ranks as a person's, not behind the agents' test
        # backlog: the same per-checkout human: session the push lint uses.
        cat_generated=$(T_SESSION="human:commit.$(hostname).$(basename "$root" | tr -c 'A-Za-z0-9_.-\n' _)" \
          "${cat_run[@]}" 2>/dev/null || true)
      fi
      if [ -n "$cat_generated" ]; then
        if [ "$cat_generated" != "$(cat "$root/$catalogue")" ]; then
          if GIT_INDEX_FILE="$full_index" git diff --quiet -- "$catalogue"; then
            printf '%s\n' "$cat_generated" > "$root/$catalogue"
            GIT_INDEX_FILE="$full_index" git add -- "$catalogue"
            catalogue_id=$(GIT_INDEX_FILE="$full_index" git rev-parse -q --verify ":$catalogue" || true)
            note "$catalogue: regenerated from the staged widget sources and staged"
          else
            note "$catalogue is stale and has unstaged edits: stage the whole file and commit again"
            fail=1
          fi
        fi
        # Only a catalogue that is now the generated one is remembered: the next commit of the
        # same sources builds nothing, a commit that left it stale is checked again.
        if [ "$cat_generated" = "$(cat "$root/$catalogue")" ]; then
          printf '%s %s\n' "$sources_id" "$catalogue_id" > "$verified_at"
        fi
      else
        note "component catalogue: no generator could be run here; run 't fix ui-graph' and stage $catalogue"
      fi
    fi
  fi
fi


# A vendored crate under vendor/ is upstream's code, carried as it ships: the
# added-code policy (ignore reasons, allow placement, dbg!) and rustfmt skip it.
own_rs=('*.rs' ':!vendor/')
own_diff=$(git diff --cached -U0 -- "${own_rs[@]}")

# rustfmt on staged files only, so the hook cost scales with the change. Same
# rule as CI (tools/ci/check-changed-rustfmt.sh): besides vendor/, a generated
# source says so with an `@generated` marker in its first five lines
# (capnpc-rust bindings); it is whatever its generator emits, never
# hand-formatted, so rustfmt skips it. tilo-app's registries are checked:
# tilolang formats them, and `cargo fmt` formats them as ordinary modules.
staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- "${own_rs[@]}")
# One search for the marker, then a file's first lines only for the files that
# could carry it: asking each file separately is two processes per staged file,
# and the staged change can be the whole commit.
generated_rs=""
if [ -n "$staged_rs" ]; then
  generated_rs=$(xargs -d '\n' -r git grep --cached -l -F -e '@generated' -- <<< "$staged_rs" 2>/dev/null || true)
fi
fmt_rs=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case $'\n'"$generated_rs"$'\n' in
    *$'\n'"$f"$'\n'*)
      head5=$(git show ":$f" 2>/dev/null | head -n 5 || true)
      case "$head5" in
        *"@generated by tilolang"*) ;;
        *@generated*) continue ;;
      esac
      ;;
  esac
  fmt_rs="$fmt_rs$f"$'\n'
done <<< "$staged_rs"
# rustfmt lays code out its own way per version: the one this formats with must be the
# toolchain rust-toolchain.toml pins, whose fmt the tree's `fmt` check runs. A missing
# rustfmt or another version fails the commit rather than formatting drift onto main.
if [ -n "$fmt_rs" ]; then
  if ! bash tools/ci/check-rustfmt-pin.sh; then
    fail=1
  elif ! command -v rustfmt >/dev/null 2>&1; then
    # No rustfmt of its own: formatting goes through t (its `fmt` check, the pinned
    # toolchain) at the push.
    note "rustfmt: none on PATH here; formatting is checked through t at the push"
  else
    unformatted=$(printf '%s' "$fmt_rs" | xargs rustfmt --edition 2024 --check -- 2>/dev/null | grep -c '^Diff in' || true)
    if [ "${unformatted:-0}" -gt 0 ]; then
      # Formatting is not a judgement call, so do it rather than ask. A file with
      # unstaged changes is left alone: rewriting it would stage those too.
      dangerous=""
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        if git diff --quiet -- "$f"; then
          rustfmt --edition 2024 -- "$f" && git add -- "$f"
        else
          dangerous="$dangerous$f"$'\n'
        fi
      done <<< "$fmt_rs"
      if [ -n "$dangerous" ]; then
        note "rustfmt: cannot format files with unstaged changes, stage the whole file first:"
        printf '%s' "$dangerous" | sed 's/^/  /' >&2
        fail=1
      else
        note "rustfmt: formatted $unformatted hunk(s) in staged files and staged them"
      fi
    fi
  fi
fi

# tilolang sources are kept in canonical form (`tilolang fmt`), and the compiler's
# tests hold std and the example packages to it; a hand-wrapped .tl file fails
# them on main. Format the staged ones here, as rustfmt above. The formatter
# takes one package at a time (a package is a directory of .tl files): the
# example packages and std are the ones whose canonical form is held, and a
# fixture elsewhere is the text its test parses, wrapping and all.
tl_packages=$(GIT_INDEX_FILE="$full_index" git diff --cached --name-only \
    --diff-filter=ACM -- '*.tl' \
  | while IFS= read -r f; do
      case "$f" in
        (crates/lang/tilolang/std/*.tl) printf '%s\n' crates/lang/tilolang/std ;;
        (apps/tl/*/*.tl) printf '%s\n' "${f%/*}" ;;
      esac
    done | sort -u)
# A package's ids lock (`app.ids`) and source catalogue (`locales/en-US.ftl`) are
# written from its sources, and nothing reads them back until the package is
# compiled: a rename done by replacing text leaves them stale or in another
# order, and every later build then rewrites them, which breaks the build's
# provenance. Writing them is not a judgement call, so do it below with the same
# binary that formats, and stage what it wrote.
tl_locked_packages=$(GIT_INDEX_FILE="$full_index" git diff --cached --name-only \
    --diff-filter=ACMR -- '*.tl' '*/app.ids' '*/locales/*.ftl' \
  | while IFS= read -r f; do
      case "$f" in
        (crates/lang/tilolang/std/*) printf '%s\n' crates/lang/tilolang/std ;;
        (apps/tl/*/locales/*.ftl) printf '%s\n' "${f%/locales/*}" ;;
        (apps/tl/*/*) printf '%s\n' "${f%/*}" ;;
      esac
    done | sort -u)
if [ -n "$tl_packages$tl_locked_packages" ]; then
  # The formatter and the ids generator are this tree's compiler: asking cargo
  # whether the binary it builds is fresh is the only list of inputs that stays
  # right. Cargo knows every file the binary embeds — the component catalogue
  # among them, which a list of source directories never did — so a catalogue
  # change rebuilds it, and a fresh build costs only its fingerprint check.
  tl_fmt=""
  tl_failed=""
  tl_candidates=()
  tl_build_state="$(git rev-parse --path-format=absolute --git-dir)/tilolang-fmt-build"
  if [ -e "$tl_build_state" ]; then
    # A build that fails is not retried by every commit: this worktree remembers
    # it, and why, for an hour. It is this worktree's, never the clone's, so one
    # tree that cannot build now does not silence the others.
    tl_when=$(cut -d' ' -f1 "$tl_build_state")
    case "$tl_when" in '' | *[!0-9]*) tl_when=0 ;; esac
    tl_age=$(( $(date +%s) - tl_when ))
    tl_ago="$((tl_age / 60)) min ago"
    [ "$tl_age" -lt 60 ] && tl_ago="just now"
    if [ "$tl_age" -lt 3600 ]; then
      tl_failed="a build failed $tl_ago: $(cut -d' ' -f2- "$tl_build_state")"
    fi
  fi
  if [ -z "$tl_failed" ] && [ -n "$tl_packages$tl_locked_packages" ]; then
    if ! command -v cargo >/dev/null 2>&1; then
      tl_failed="there is no cargo on PATH to build one with"
    else
      tl_log="$tl_build_state.log"
      tl_fmt=$(
        (cd "$root" && cargo build --locked -p tilolang-cli --bin tilolang --message-format=json) \
          2>"$tl_log" \
        | python3 -c 'import json, sys
for line in sys.stdin:
    try:
        message = json.loads(line)
    except ValueError:
        continue
    if message.get("reason") == "compiler-artifact" and message.get("executable"):
        print(message["executable"])' \
        | tail -n 1
      ) || tl_fmt=""
      # A build that failed, or was cancelled, leaves no formatter: the note below says so and
      # the commit goes on, rather than `set -e` ending the hook with no word of why.
      if [ -z "$tl_fmt" ]; then
        # A front end that answers no artifact messages still names the target
        # directory it builds in; the default profile's binary is the one the
        # build just checked.
        tl_target=$(cd "$root" && cargo metadata --no-deps --format-version 1 2>/dev/null \
          | python3 -c 'import json, sys
try:
    print(json.load(sys.stdin)["target_directory"])
except ValueError:
    pass' 2>/dev/null | tail -n 1) || tl_target=""
        if [ -n "$tl_target" ] && [ -x "$tl_target/debug/tilolang" ]; then
          tl_fmt="$tl_target/debug/tilolang"
        fi
      fi
      if [ -n "$tl_fmt" ] && [ -x "$tl_fmt" ]; then
        rm -f "$tl_build_state"
        tl_candidates=("$tl_fmt")
      else
        tl_why=$(tail -n 1 "$tl_log" | cut -c1-200)
        tl_fmt=""
        tl_why=${tl_why:-"the build left no formatter in target/"}
        printf '%s %s\n' "$(date +%s)" "$tl_why" >"$tl_build_state"
        tl_failed="a build failed: $tl_why"
      fi
      rm -f "$tl_log"
    fi
  fi
  if [ -z "$tl_packages" ]; then
    : # Only locks and catalogues are staged: nothing to format.
  elif [ -z "$tl_fmt" ]; then
    # No binary to format with, so these are left as they are: the compiler's
    # canonical-form tests, which CI runs, hold the invariant either way.
    note "tilolang fmt: no formatter for the staged .tl files: $tl_failed"
  else
    tl_formatted=0
    tl_unformatted=""
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      if GIT_INDEX_FILE="$full_index" git diff --quiet -- "$d"; then
        # Formatting is not a judgement call, so do it rather than ask.
        tl_status=0
        tl_out=$(cd "$root" && "$tl_fmt" fmt "$d" 2>&1) || tl_status=$?
        if [ "$tl_status" -ne 0 ]; then
          # A package that does not parse is the formatter's to report: its
          # message names the file, the line and what it expected.
          printf '%s\n' "$tl_out" | sed 's/^/  /' >&2
          fail=1
          continue
        fi
        if [ -n "$(GIT_INDEX_FILE="$full_index" git diff --name-only -- "$d")" ]; then
          GIT_INDEX_FILE="$full_index" git add -u -- "$d"
          tl_formatted=$((tl_formatted + 1))
        fi
      else
        # A package with unstaged changes is left alone: rewriting it would
        # stage those too. It is named only when it does need formatting.
        tl_status=0
        (cd "$root" && "$tl_fmt" fmt --check "$d") >/dev/null 2>&1 || tl_status=$?
        if [ "$tl_status" -ne 0 ]; then
          tl_unformatted="$tl_unformatted$d"$'\n'
          fail=1
        fi
      fi
    done <<< "$tl_packages"
    if [ "$tl_formatted" -gt 0 ]; then
      note "tilolang fmt: formatted $tl_formatted package(s) and staged them"
    fi
    if [ -n "$tl_unformatted" ]; then
      note "tilolang fmt: cannot format packages with unstaged changes, stage the whole package first:"
      printf '%s' "$tl_unformatted" | sed 's/^/  /' >&2
      fail=1
    fi
  fi

  # The locks and catalogues of the packages above: refreshed with a binary
  # from this tree, as the formatter was. A package whose sources have unstaged
  # edits is left alone, since they would be written into this commit; one whose
  # generator cannot run now keeps what it has, and the compiler's own test,
  # which compares every package under apps/tl with its sources, still holds it
  # on CI. The generated files themselves do not count as edits to guard: they
  # are whatever the sources give.
  if [ -n "$tl_locked_packages" ] && [ "${#tl_candidates[@]}" -eq 0 ]; then
    note "tilolang ids: no generator for the staged packages; run \
'tilolang check --write-ids <dir>' on each and stage its app.ids and locales/en-US.ftl"
  elif [ -n "$tl_locked_packages" ]; then
    tl_lock_wrote=0
    tl_lock_left=""
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      if ! GIT_INDEX_FILE="$full_index" git diff --quiet -- "$d" \
           ":(exclude)$d/app.ids" ":(exclude)$d/locales"; then
        tl_lock_left="$tl_lock_left$d"$'\n'
        continue
      fi
      tl_lock_why=""
      for c in "${tl_candidates[@]}"; do
        if tl_lock_out=$(cd "$root" && "$c" check --write-ids "$d" 2>&1); then
          tl_lock_why=""
          break
        fi
        tl_lock_why=$(printf '%s\n' "$tl_lock_out" | tail -n 1)
      done
      if [ -n "$tl_lock_why" ]; then
        note "tilolang ids: $d: $tl_lock_why"
        continue
      fi
      for f in "$d/app.ids" "$d/locales/en-US.ftl"; do
        [ -f "$root/$f" ] || continue
        if ! GIT_INDEX_FILE="$full_index" git diff --quiet -- "$f"; then
          GIT_INDEX_FILE="$full_index" git add -- "$f"
          tl_lock_wrote=$((tl_lock_wrote + 1))
        fi
      done
    done <<< "$tl_locked_packages"
    if [ "$tl_lock_wrote" -gt 0 ]; then
      note "tilolang ids: wrote $tl_lock_wrote generated file(s) from the staged sources and staged them"
    fi
    if [ -n "$tl_lock_left" ]; then
      note "tilolang ids: cannot write the generated files of packages with unstaged changes, stage the whole package first:"
      printf '%s' "$tl_lock_left" | sed 's/^/  /' >&2
      fail=1
    fi
  fi
fi

# Require a reason for added #[ignore] attributes.
if grep -qE '^\+\s*#\[ignore\]\s*$' <<< "$own_diff"; then
  note "#[ignore] added with no reason string. Use #[ignore = \"why\"]."
  fail=1
fi

# Credentials, merge-conflict markers and dbg! in the lines the change adds.
# CI repeats this exact check on every new commit (check_commit_policy.py).
python3 "$root/tools/policy/added_line_policy.py" --root "$root" --staged || fail=1

# Catch ineffective `#[allow]` attributes before CI.
added=$(grep -E '^\+' <<< "$own_diff" || true)
# A Clippy lint without its prefix is unknown and leaves the violation in place.
bare=$(printf '%s\n' "$added" | grep -oE '#!?\[allow\(\s*(clippy::)?[a-z_]+' \
  | grep -v 'clippy::' \
  | grep -oE '(similar_names|too_many_lines|too_many_arguments|indexing_slicing|unwrap_used|expect_used|missing_errors_doc|missing_panics_doc|significant_drop_tightening|needless_pass_by_value|used_underscore_binding|items_after_statements|cast_possible_truncation|arithmetic_side_effects)$' || true)
if [ -n "$bare" ]; then
  note "#[allow] naming a clippy lint without the clippy:: prefix: $(printf '%s' "$bare" | tr '\n' ' ')"
  fail=1
fi
# An attribute on a macro invocation in statement position is ignored.
allow_context=$(grep -A1 -E '^\+\s*#\[allow\(' <<< "$own_diff" || true)
if grep -qE '^\+\s*(assert|assert_eq|assert_ne|debug_assert|println|eprintln|write|writeln|panic|vec|format)!' <<< "$allow_context"; then
  note "#[allow] directly above a macro invocation is ignored by rustc — put it on the enclosing function"
  fail=1
fi

# A reference cargo re-resolved onto another version the package also allows is
# not a judgement call: the lock's canonical form points at the newest version it
# holds that the package allows, so write that and stage it, as rustfmt and the
# code map are. A lock with unstaged edits is left alone, like those files. This
# runs first, so the admission below judges what a person would commit.
if grep -qx 'Cargo.lock' <<< "$staged_names" && git diff --quiet -- Cargo.lock; then
  normalized=$(python3 "$root/tools/ci/check_lock_update.py" --root "$root" --write 2>&1) || {
    printf '%s\n' "$normalized" | sed 's/^/  /' >&2
    fail=1
  }
  if [ -n "$normalized" ]; then
    GIT_INDEX_FILE="$full_index" git add -- Cargo.lock
    printf '%s\n' "$normalized" | sed 's/^/  Cargo.lock: /' >&2
  fi
fi
# Require a manifest change alongside Cargo.lock changes; see AGENTS.md. The
# lock-only changes admitted are a declared single-crate update,
#   TILO_CARGO_UPDATE='-p <crate> --precise <version>' git commit
# that cargo metadata --locked accepts and that moves nothing else, and a
# relock that moves no version, such as `t fix lockfile` writes after a rebase
# (tools/ci/check_lock_update.py).
if grep -qx 'Cargo.lock' <<< "$staged_names" \
   && ! grep -qE '(^|/)Cargo\.toml$' <<< "$lock_staged_names"; then
  python3 "$root/tools/ci/check_lock_update.py" --root "$root" || fail=1
fi
# A vendored crate's own lock file is a build artifact, not ours; untracking
# one is the fix, so only an added or changed one fails.
if git diff --cached --name-only --diff-filter=d | grep -qE '^vendor/[^/]+/Cargo\.lock$'; then
  note "a vendored crate's Cargo.lock is staged; it is a build artifact"
  fail=1
fi

exit "$fail"
