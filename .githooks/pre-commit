#!/usr/bin/env bash
# Compilation runs in CI to keep the pre-commit hook fast.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
full_index="$(git rev-parse --git-path index)"
fail=0

# Keep the real manifest pairing for lock validation: a combined merge lock
# differs from both parents even when each manifest was taken from one parent.
lock_staged_names=$(git diff --cached --name-only)

# This inventory compares tracked paths with the working tree's baseline.
# Run before the merge-only index hides scripts inherited from main, or
# those baseline entries would incorrectly look like removed scripts.
GIT_INDEX_FILE="$full_index" python3 "$root/tools/policy/check_image_interpreters.py" || fail=1
# Content validation needs the complete index, including inherited exceptions.
GIT_INDEX_FILE="$full_index" python3 "$root/tools/policy/check_source_content.py" --staged || fail=1

# Audit the exact candidate tree, including inherited assets and their pinned
# exceptions. The filtered index below can remove a newly inherited manifest
# or restore obsolete binary assets from HEAD; neither represents the commit.
python3 "$root/tools/policy/check_source_content.py" --staged || fail=1

# Merging main into a branch stages everything main changed since the branch
# point, thousands of files that main's own checks already passed. The checks
# below read the staged change through the index, so they run against a copy
# of it in which every file staged exactly as the merged-in side has it is
# back at HEAD: what is left is what the merge resolution itself changed.
if merge_head=$(git rev-parse -q --verify MERGE_HEAD); then
  merge_index=$(mktemp)
  trap 'rm -f "$merge_index"' EXIT
  cp "$(git rev-parse --git-path index)" "$merge_index"
  differs_from_merged=$(git diff --cached --name-only "$merge_head")
  taken_from_merged=$(git diff --cached --name-only HEAD \
    | grep -vxF -f <(printf '%s\n' "$differs_from_merged") || true)
  # A combined lockfile needs the inherited manifest changes as context too.
  # Otherwise filtering those manifests makes a valid merge look lock-only.
  if grep -qx 'Cargo.lock' <<< "$differs_from_merged"; then
    taken_from_merged=$(grep -vE '(^|/)Cargo\.toml$' <<< "$taken_from_merged" || true)
  fi
  if [ -n "$taken_from_merged" ]; then
    printf '%s\n' "$taken_from_merged" \
      | GIT_INDEX_FILE="$merge_index" git reset -q HEAD --pathspec-from-file=- --
  fi
  export GIT_INDEX_FILE="$merge_index"
fi
python3 "$root/tools/policy/check_public_references.py" --staged || fail=1
note() { printf '  %s\n' "$*" >&2; }

# Every crate on disk must be a workspace member.
"$root/scripts/check-workspace-complete.sh"
python3 "$root/tools/policy/check_app_text_contract.py"
python3 "$root/tools/policy/check_shell_copy_contract.py"
python3 "$root/tools/policy/check_ui_host_inputs_contract.py"
python3 "$root/tools/policy/check_ui_clock_contract.py"
python3 "$root/tools/policy/check_formats.py" || fail=1
python3 "$root/tools/policy/check_settings_writes.py" || fail=1
python3 "$root/tools/policy/check_integration_test_modules.py" || fail=1
GIT_INDEX_FILE="$full_index" python3 "$root/tools/policy/check_too_many_arguments.py" || fail=1

# The staged names and diffs, read once. Every check below matches against
# these variables, never against a pipe from git: under pipefail, a `grep -q`
# that stops reading at its first match leaves git writing into a closed pipe,
# and on a large diff the pipeline then reports git's SIGPIPE instead of the
# match.
staged_names=$(git diff --cached --name-only)

# A vendored crate under vendor/ is upstream's code, carried as it ships: the
# added-code policy (ignore reasons, allow placement, dbg!) and rustfmt skip it.
own_rs=('*.rs' ':!vendor/')
own_diff=$(git diff --cached -U0 -- "${own_rs[@]}")

# rustfmt on staged files only, so the hook cost scales with the change. Same
# rule as CI (tools/ci/check-changed-rustfmt.sh): besides vendor/, a generated
# source says so with an `@generated` marker in its first five lines
# (capnpc-rust bindings); it is whatever its generator emits, never
# hand-formatted, so rustfmt skips it. tilo-app's registries are checked:
# tilo-app formats them, and `cargo fmt` formats them as ordinary modules.
staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- "${own_rs[@]}")
fmt_rs=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  head5=$(git show ":$f" 2>/dev/null | head -n 5 || true)
  case "$head5" in
    *"@generated by tilo-app"*) ;;
    *@generated*) continue ;;
  esac
  fmt_rs="$fmt_rs$f"$'\n'
done <<< "$staged_rs"
if [ -n "$fmt_rs" ] && command -v rustfmt >/dev/null 2>&1; then
  unformatted=$(printf '%s' "$fmt_rs" | xargs rustfmt --edition 2024 --check -- 2>/dev/null | grep -c '^Diff in' || true)
  if [ "${unformatted:-0}" -gt 0 ]; then
    note "rustfmt: $unformatted hunk(s) unformatted in staged files. Run: cargo fmt"
    fail=1
  fi
fi

# Require a reason for added #[ignore] attributes.
if grep -qE '^\+\s*#\[ignore\]\s*$' <<< "$own_diff"; then
  note "#[ignore] added with no reason string. Use #[ignore = \"why\"]."
  fail=1
fi

# Match CI's whole-file policy for the exact staged blobs. Looking only at
# added lines misses an unchanged `#[allow]` in a file that this commit edits.
python3 "$root/tools/ci/check_changed_rust_allows.py" --root "$root" --staged || fail=1

# Credentials, merge-conflict markers and dbg! in the lines the change adds.
# CI repeats this exact check on every new commit (check_commit_policy.py).
python3 "$root/tools/policy/added_line_policy.py" --root "$root" --staged || fail=1

# Catch ineffective `#[allow]` attributes before CI.
added=$(grep -E '^\+' <<< "$own_diff" || true)
# A Clippy lint without its prefix is unknown and leaves the violation in place.
bare=$(printf '%s\n' "$added" | grep -oE '#!?\[allow\(\s*(clippy::)?[a-z_]+' \
  | grep -v 'clippy::' \
  | grep -oE '(similar_names|too_many_lines|too_many_arguments|indexing_slicing|unwrap_used|expect_used|missing_errors_doc|missing_panics_doc|significant_drop_tightening|needless_pass_by_value|used_underscore_binding|items_after_statements|cast_possible_truncation|arithmetic_side_effects)$' || true)
if [ -n "$bare" ]; then
  note "#[allow] naming a clippy lint without the clippy:: prefix: $(printf '%s' "$bare" | tr '\n' ' ')"
  fail=1
fi
# An attribute on a macro invocation in statement position is ignored.
allow_context=$(grep -A1 -E '^\+\s*#\[allow\(' <<< "$own_diff" || true)
if grep -qE '^\+\s*(assert|assert_eq|assert_ne|debug_assert|println|eprintln|write|writeln|panic|vec|format)!' <<< "$allow_context"; then
  note "#[allow] directly above a macro invocation is ignored by rustc — put it on the enclosing function"
  fail=1
fi

# Require a manifest change alongside Cargo.lock changes; see AGENTS.md. The
# lock-only changes admitted are a declared single-crate update,
#   TILO_CARGO_UPDATE='-p <crate> --precise <version>' git commit
# that cargo metadata --locked accepts and that moves nothing else, and a
# relock that moves no version, such as `t fix lockfile` writes after a rebase
# (tools/ci/check_lock_update.py).
if grep -qx 'Cargo.lock' <<< "$staged_names" \
   && ! grep -qE '(^|/)Cargo\.toml$' <<< "$lock_staged_names"; then
  python3 "$root/tools/ci/check_lock_update.py" --root "$root" || fail=1
fi
# A manifest change can close a cycle in the package graph, which leaves the
# whole workspace unresolvable (cargo metadata, every build). Resolving it
# compiles nothing and takes about a second.
if grep -qE '(^|/)Cargo\.(toml|lock)$' <<< "$staged_names"; then
  python3 "$root/tools/policy/check_dependency_cycles.py" || fail=1
fi
# A vendored crate's own lock file is a build artifact, not ours.
if grep -qE '^vendor/[^/]+/Cargo\.lock$' <<< "$staged_names"; then
  note "a vendored crate's Cargo.lock is staged; it is a build artifact"
  fail=1
fi

exit "$fail"
