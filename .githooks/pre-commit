#!/usr/bin/env bash
# Compilation runs in CI to keep the pre-commit hook fast.
set -euo pipefail
# The policy scripts need Python 3.11 or newer (tomllib). On macOS the python3 first on PATH is
# often the system's 3.9, which fails every commit; put a newer interpreter's directory first.
if ! python3 -I -c 'import tomllib' 2>/dev/null; then
  for py in python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    found=$(command -v "$py" 2>/dev/null) || continue
    dir=$(dirname "$found")
    if [ -x "$dir/python3" ] && "$dir/python3" -I -c 'import tomllib' 2>/dev/null; then
      PATH="$dir:$PATH"; export PATH; break
    fi
  done
  if ! python3 -I -c 'import tomllib' 2>/dev/null; then
    echo "git hook: these checks need Python 3.11 or newer as python3; install it and put it first on PATH" >&2
    exit 1
  fi
fi
root="$(git rev-parse --show-toplevel)"
full_index="$(git rev-parse --git-path index)"
fail=0

# Keep the real manifest pairing for lock validation: a combined merge lock
# differs from both parents even when each manifest was taken from one parent.
lock_staged_names=$(git diff --cached --name-only)

# This inventory compares tracked paths with the working tree's baseline.
# Run before the merge-only index hides scripts inherited from main, or
# those baseline entries would incorrectly look like removed scripts.
GIT_INDEX_FILE="$full_index" python3 "$root/tools/policy/check_image_interpreters.py" || fail=1
# Content validation needs the complete index, including inherited exceptions.
GIT_INDEX_FILE="$full_index" python3 "$root/tools/policy/check_source_content.py" --staged || fail=1

# Audit the exact candidate tree, including inherited assets and their pinned
# exceptions. The filtered index below can remove a newly inherited manifest
# or restore obsolete binary assets from HEAD; neither represents the commit.
python3 "$root/tools/policy/check_source_content.py" --staged || fail=1

# Merging main into a branch stages everything main changed since the branch
# point, thousands of files that main's own checks already passed. The checks
# below read the staged change through the index, so they run against a copy
# of it in which every file staged exactly as the merged-in side has it is
# back at HEAD: what is left is what the merge resolution itself changed.
if merge_head=$(git rev-parse -q --verify MERGE_HEAD); then
  merge_index=$(mktemp)
  trap 'rm -f "$merge_index"' EXIT
  cp "$(git rev-parse --git-path index)" "$merge_index"
  differs_from_merged=$(git diff --cached --name-only "$merge_head")
  taken_from_merged=$(git diff --cached --name-only HEAD \
    | grep -vxF -f <(printf '%s\n' "$differs_from_merged") || true)
  # A combined lockfile needs the inherited manifest changes as context too.
  # Otherwise filtering those manifests makes a valid merge look lock-only.
  if grep -qx 'Cargo.lock' <<< "$differs_from_merged"; then
    taken_from_merged=$(grep -vE '(^|/)Cargo\.toml$' <<< "$taken_from_merged" || true)
  fi
  if [ -n "$taken_from_merged" ]; then
    printf '%s\n' "$taken_from_merged" \
      | GIT_INDEX_FILE="$merge_index" git reset -q HEAD --pathspec-from-file=- --
  fi
  export GIT_INDEX_FILE="$merge_index"
fi
python3 "$root/tools/policy/check_public_references.py" --staged || fail=1
note() { printf '  %s\n' "$*" >&2; }

# Every crate on disk must be a workspace member.
"$root/scripts/check-workspace-complete.sh"
# These judge a file by its own text, so a commit can only introduce a
# violation in a file it stages: `--staged` judges the commit's files, read
# from the index, instead of reading the ten thousand of the tree on every
# commit. That is what keeps the hook to a few seconds. Nothing slips through:
# tools/policy/run.sh and CI run each of these over the whole tree, and this
# hook is the fast answer, not the only one.
python3 "$root/tools/policy/check_app_text_contract.py" --staged
python3 "$root/tools/policy/check_session_copy_contract.py"
# A catalogue is judged against its siblings, not by its own text: half a
# translation or a key defined twice reads as drift or breaks the file only
# beside the others. It reads every catalogue in well under a second.
python3 "$root/tools/policy/check_catalogue_coverage.py"
python3 "$root/tools/policy/check_ui_host_inputs_contract.py" --staged
python3 "$root/tools/policy/check_ui_clock_contract.py" --staged
python3 "$root/tools/policy/check_formats.py" --staged || fail=1
python3 "$root/tools/policy/check_settings_writes.py" --staged || fail=1
python3 "$root/tools/policy/check_swallowed_failures.py" --staged || fail=1
python3 "$root/tools/policy/check_integration_test_modules.py" --staged || fail=1
python3 "$root/tools/policy/check_too_many_arguments.py" --staged || fail=1
python3 "$root/tools/policy/check_source_file_size.py" --staged || fail=1
# A wire enum keeps every variant it had, in its place: bytes already written
# keep meaning what they meant (docs/policies.md). Judged against HEAD, so a
# merge is charged only with what its resolution changed.
python3 "$root/tools/policy/check_wire_enums.py" staged || fail=1
# Every test-shaped file and every Rust file that reads outside its package is
# accounted for in tools/ci/suites.toml, so changing what it reads runs it.
# `--staged` reads only the commit's Rust files and the ones the manifest names
# (the whole tree when the manifest itself changes); the suites policy step
# reads them all.
python3 "$root/tools/ci/suites.py" check --staged || fail=1

# The staged names and diffs, read once. Every check below matches against
# these variables, never against a pipe from git: under pipefail, a `grep -q`
# that stops reading at its first match leaves git writing into a closed pipe,
# and on a large diff the pipeline then reports git's SIGPIPE instead of the
# match.
staged_names=$(git diff --cached --name-only)

# The code map is generated from the crates' manifests and crate docs. A change
# to one, or a merge whose driver took one side of the map
# (.githooks/merge-generated), leaves it stale; regenerating it is not a
# judgement call, so do it here, into the whole index even in a merge. A map
# with unstaged edits is left alone: staging it would stage those too.
if grep -qE '(^|/)(Cargo\.toml|lib\.rs|main\.rs)$|^docs/codemap\.md$' <<< "$lock_staged_names" \
   && ! python3 "$root/tools/docs/codemap.py" --check 2>/dev/null; then
  if GIT_INDEX_FILE="$full_index" git diff --quiet -- docs/codemap.md \
     && python3 "$root/tools/docs/codemap.py" >/dev/null \
     && GIT_INDEX_FILE="$full_index" git add -- docs/codemap.md; then
    note "docs/codemap.md: regenerated and staged"
  else
    note "docs/codemap.md is stale: run python3 tools/docs/codemap.py and stage it"
    fail=1
  fi
fi

# The SDK's types are generated from the apps' surfaces and manifests
# (`tilo sdk gen`), so a change to either leaves them stale: they are what an
# agent or a script reads an app's actions from, and nothing else in a commit
# notices. Regenerating them is not a judgement call, so do it here with this
# tree's own generator and stage what it wrote; a tree that has not built one
# is told the one command that writes them, rather than left stale.
if grep -qE '^apps/[^/]+/(surface|tilo-app)\.toml$' <<< "$lock_staged_names"; then
  # Like the tilolang formatter below: the freshest generator this tree has
  # built into target/, under any profile, answering `--help` so a binary for
  # another platform is skipped rather than run.
  sdk_gen=""
  sdk_found=()
  while IFS= read -r -d '' c; do sdk_found+=("$c"); done < <(
    find "$root/target" -maxdepth 4 -type f -name tilo -perm -u+x -print0 2>/dev/null)
  if [ "${#sdk_found[@]}" -gt 0 ]; then
    while IFS= read -r c; do
      [ -n "$c" ] && [ -x "$c" ] || continue
      case "$("$c" --help 2>&1)" in
        *"sdk"*) sdk_gen=$c; break ;;
      esac
    done < <(ls -td -- "${sdk_found[@]}" 2>/dev/null || true)
  fi
  sdk_paths="sdk/python/src/tilo/types sdk/typescript/src/types"
  if [ -n "$sdk_gen" ]; then
    # Which generated files the person is editing by hand: those are left
    # alone, since staging them would stage their edits too.
    sdk_dirty=$(git diff --name-only -- $sdk_paths)
    for lang in python ts; do
      case "$lang" in
        python) out=sdk/python/src/tilo/types ;;
        ts) out=sdk/typescript/src/types ;;
      esac
      (cd "$root" && "$sdk_gen" sdk gen --lang "$lang" --out "$out") >/dev/null || {
        note "the SDK's types could not be written with $sdk_gen; run 't fix sdk-types'"
        fail=1
      }
    done
    sdk_wrote=0
    sdk_left=""
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if grep -qxF "$f" <<< "$sdk_dirty"; then
        sdk_left="$sdk_left$f"$'\n'
      else
        GIT_INDEX_FILE="$full_index" git add -- "$f"
        sdk_wrote=$((sdk_wrote + 1))
      fi
    done < <(GIT_INDEX_FILE="$full_index" git diff --name-only -- $sdk_paths)
    if [ "$sdk_wrote" -gt 0 ]; then
      note "sdk: wrote the types of the apps whose surface changed and staged them"
    fi
    if [ -n "$sdk_left" ]; then
      note "sdk: these have unstaged edits, stage the whole file and commit again:"
      printf '%s' "$sdk_left" | sed 's/^/  /' >&2
      fail=1
    fi
  else
    note "sdk: an app's surface changed and this tree has no generator built; run 't fix sdk-types' and stage sdk/"
    fail=1
  fi
fi


# A vendored crate under vendor/ is upstream's code, carried as it ships: the
# added-code policy (ignore reasons, allow placement, dbg!) and rustfmt skip it.
own_rs=('*.rs' ':!vendor/')
own_diff=$(git diff --cached -U0 -- "${own_rs[@]}")

# rustfmt on staged files only, so the hook cost scales with the change. Same
# rule as CI (tools/ci/check-changed-rustfmt.sh): besides vendor/, a generated
# source says so with an `@generated` marker in its first five lines
# (capnpc-rust bindings); it is whatever its generator emits, never
# hand-formatted, so rustfmt skips it. tilo-app's registries are checked:
# tilo-app formats them, and `cargo fmt` formats them as ordinary modules.
staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- "${own_rs[@]}")
fmt_rs=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  head5=$(git show ":$f" 2>/dev/null | head -n 5 || true)
  case "$head5" in
    *"@generated by tilo-app"*) ;;
    *@generated*) continue ;;
  esac
  fmt_rs="$fmt_rs$f"$'\n'
done <<< "$staged_rs"
if [ -n "$fmt_rs" ] && command -v rustfmt >/dev/null 2>&1; then
  unformatted=$(printf '%s' "$fmt_rs" | xargs rustfmt --edition 2024 --check -- 2>/dev/null | grep -c '^Diff in' || true)
  if [ "${unformatted:-0}" -gt 0 ]; then
    # Formatting is not a judgement call, so do it rather than ask. A file with
    # unstaged changes is left alone: rewriting it would stage those too.
    dangerous=""
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if git diff --quiet -- "$f"; then
        rustfmt --edition 2024 -- "$f" && git add -- "$f"
      else
        dangerous="$dangerous$f"$'\n'
      fi
    done <<< "$fmt_rs"
    if [ -n "$dangerous" ]; then
      note "rustfmt: cannot format files with unstaged changes, stage the whole file first:"
      printf '%s' "$dangerous" | sed 's/^/  /' >&2
      fail=1
    else
      note "rustfmt: formatted $unformatted hunk(s) in staged files and staged them"
    fi
  fi
fi

# tilolang sources are kept in canonical form (`tlc fmt`), and the compiler's
# tests hold std and the example packages to it; a hand-wrapped .tl file fails
# them on main. Format the staged ones here, as rustfmt above. The formatter
# takes one package at a time (a package is a directory of .tl files): the
# example packages and std are the ones whose canonical form is held, and a
# fixture elsewhere is the text its test parses, wrapping and all.
tl_packages=$(GIT_INDEX_FILE="$full_index" git diff --cached --name-only \
    --diff-filter=ACM -- '*.tl' \
  | while IFS= read -r f; do
      case "$f" in
        (crates/lang/tilolang/std/*.tl) printf '%s\n' crates/lang/tilolang/std ;;
        (apps/tl/*/*.tl) printf '%s\n' "${f%/*}" ;;
      esac
    done | sort -u)
if [ -n "$tl_packages" ]; then
  # The compiler's own sources and manifests. A formatter older than any of them
  # prints an earlier revision's canonical form, so it is not this tree's: that
  # is what makes a binary in target/ one this hook may use.
  tl_sources=("$root/Cargo.lock" "$root/Cargo.toml"
    "$root/crates/lang/tilolang/Cargo.toml" "$root/crates/lang/tilolang/src"
    "$root/crates/lang/tilolang-cli/Cargo.toml" "$root/crates/lang/tilolang-cli/src")

  # Picks the freshest formatter this tree has built into target/, under any
  # profile: debug, release, `fast` for the dev loop, and the session's own copy
  # in target/nested-session/bin. Answers --help because a binary for another
  # platform cannot run here and one that is not the formatter does not know
  # `fmt`; both are skipped rather than failing the commit.
  tl_fmt=""
  tl_find_fmt() {
    local built=() c newer_count
    while IFS= read -r -d '' c; do built+=("$c"); done < <(
      find "$root/target" -maxdepth 4 -type f \
        \( -name tlc -o -name tilolangc -o -name tilolang \) -print0 2>/dev/null)
    [ "${#built[@]}" -gt 0 ] || return 0
    while IFS= read -r c; do
      if [ -n "$c" ] && [ -x "$c" ]; then
        newer_count=$(find "${tl_sources[@]}" -newer "$c" -print 2>/dev/null | wc -l)
        [ "$newer_count" -gt 0 ] && continue
        case "$("$c" --help 2>&1)" in
          *fmt*) tl_fmt=$c; return 0 ;;
        esac
      fi
    done < <(ls -td -- "${built[@]}" 2>/dev/null || true)
  }
  tl_find_fmt
  if [ -z "$tl_fmt" ]; then
    # The formatter is this tree's compiler, so build its one binary. A build
    # that fails is not retried by every commit: this worktree remembers it, and
    # why, for an hour. It is this worktree's, never the clone's, so one tree
    # that cannot build now does not silence the others.
    tl_build_state="$(git rev-parse --path-format=absolute --git-dir)/tilolang-fmt-build"
    tl_failed=""
    if [ -e "$tl_build_state" ]; then
      tl_when=$(cut -d' ' -f1 "$tl_build_state")
      case "$tl_when" in '' | *[!0-9]*) tl_when=0 ;; esac
      tl_age=$(( $(date +%s) - tl_when ))
      tl_ago="$((tl_age / 60)) min ago"
      [ "$tl_age" -lt 60 ] && tl_ago="just now"
      if [ "$tl_age" -lt 3600 ]; then
        tl_failed="a build failed $tl_ago: $(cut -d' ' -f2- "$tl_build_state")"
      fi
    fi
    if [ -z "$tl_failed" ]; then
      if ! command -v cargo >/dev/null 2>&1; then
        tl_failed="there is no cargo on PATH to build one with"
      else
        tl_log="$tl_build_state.log"
        tl_why=""
        if (cd "$root" && cargo build --quiet --locked -p tilolang --bin tlc) \
             >"$tl_log" 2>&1; then
          tl_find_fmt
        else
          tl_why=$(tail -n 1 "$tl_log" | cut -c1-200)
        fi
        rm -f "$tl_log"
        if [ -n "$tl_fmt" ]; then
          rm -f "$tl_build_state"
        else
          tl_why=${tl_why:-"the build left no formatter in target/"}
          printf '%s %s\n' "$(date +%s)" "$tl_why" >"$tl_build_state"
          tl_failed="a build failed: $tl_why"
        fi
      fi
    fi
  fi
  if [ -z "$tl_fmt" ]; then
    # No binary to format with, so these are left as they are: the compiler's
    # canonical-form tests, which CI runs, hold the invariant either way.
    note "tilolang fmt: no formatter for the staged .tl files: $tl_failed"
  else
    tl_formatted=0
    tl_unformatted=""
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      if GIT_INDEX_FILE="$full_index" git diff --quiet -- "$d"; then
        # Formatting is not a judgement call, so do it rather than ask.
        tl_status=0
        tl_out=$(cd "$root" && "$tl_fmt" fmt "$d" 2>&1) || tl_status=$?
        if [ "$tl_status" -ne 0 ]; then
          # A package that does not parse is the formatter's to report: its
          # message names the file, the line and what it expected.
          printf '%s\n' "$tl_out" | sed 's/^/  /' >&2
          fail=1
          continue
        fi
        if [ -n "$(GIT_INDEX_FILE="$full_index" git diff --name-only -- "$d")" ]; then
          GIT_INDEX_FILE="$full_index" git add -u -- "$d"
          tl_formatted=$((tl_formatted + 1))
        fi
      else
        # A package with unstaged changes is left alone: rewriting it would
        # stage those too. It is named only when it does need formatting.
        tl_status=0
        (cd "$root" && "$tl_fmt" fmt --check "$d") >/dev/null 2>&1 || tl_status=$?
        if [ "$tl_status" -ne 0 ]; then
          tl_unformatted="$tl_unformatted$d"$'\n'
          fail=1
        fi
      fi
    done <<< "$tl_packages"
    if [ "$tl_formatted" -gt 0 ]; then
      note "tilolang fmt: formatted $tl_formatted package(s) and staged them"
    fi
    if [ -n "$tl_unformatted" ]; then
      note "tilolang fmt: cannot format packages with unstaged changes, stage the whole package first:"
      printf '%s' "$tl_unformatted" | sed 's/^/  /' >&2
      fail=1
    fi
  fi
fi

# Require a reason for added #[ignore] attributes.
if grep -qE '^\+\s*#\[ignore\]\s*$' <<< "$own_diff"; then
  note "#[ignore] added with no reason string. Use #[ignore = \"why\"]."
  fail=1
fi

# Credentials, merge-conflict markers and dbg! in the lines the change adds.
# CI repeats this exact check on every new commit (check_commit_policy.py).
python3 "$root/tools/policy/added_line_policy.py" --root "$root" --staged || fail=1

# Catch ineffective `#[allow]` attributes before CI.
added=$(grep -E '^\+' <<< "$own_diff" || true)
# A Clippy lint without its prefix is unknown and leaves the violation in place.
bare=$(printf '%s\n' "$added" | grep -oE '#!?\[allow\(\s*(clippy::)?[a-z_]+' \
  | grep -v 'clippy::' \
  | grep -oE '(similar_names|too_many_lines|too_many_arguments|indexing_slicing|unwrap_used|expect_used|missing_errors_doc|missing_panics_doc|significant_drop_tightening|needless_pass_by_value|used_underscore_binding|items_after_statements|cast_possible_truncation|arithmetic_side_effects)$' || true)
if [ -n "$bare" ]; then
  note "#[allow] naming a clippy lint without the clippy:: prefix: $(printf '%s' "$bare" | tr '\n' ' ')"
  fail=1
fi
# An attribute on a macro invocation in statement position is ignored.
allow_context=$(grep -A1 -E '^\+\s*#\[allow\(' <<< "$own_diff" || true)
if grep -qE '^\+\s*(assert|assert_eq|assert_ne|debug_assert|println|eprintln|write|writeln|panic|vec|format)!' <<< "$allow_context"; then
  note "#[allow] directly above a macro invocation is ignored by rustc — put it on the enclosing function"
  fail=1
fi

# Require a manifest change alongside Cargo.lock changes; see AGENTS.md. The
# lock-only changes admitted are a declared single-crate update,
#   TILO_CARGO_UPDATE='-p <crate> --precise <version>' git commit
# that cargo metadata --locked accepts and that moves nothing else, and a
# relock that moves no version, such as `t fix lockfile` writes after a rebase
# (tools/ci/check_lock_update.py).
if grep -qx 'Cargo.lock' <<< "$staged_names" \
   && ! grep -qE '(^|/)Cargo\.toml$' <<< "$lock_staged_names"; then
  python3 "$root/tools/ci/check_lock_update.py" --root "$root" || fail=1
fi
# A vendored crate's own lock file is a build artifact, not ours.
if grep -qE '^vendor/[^/]+/Cargo\.lock$' <<< "$staged_names"; then
  note "a vendored crate's Cargo.lock is staged; it is a build artifact"
  fail=1
fi

exit "$fail"
