# Built fonts: every checkout builds its own (build.py, a few seconds), so
# parallel glyph work never conflicts on a binary.
/fonts/
# Upstream Instrument Sans checkout used by import_upstream.py and verify_upstream.py.
/.upstream/
# Working proofs. Only the sheets written with `proof.py --final` and the
# merged family's final and review sheets are tracked.
/proofs/*
!/proofs/sheets/
!/proofs/final/
__pycache__/
