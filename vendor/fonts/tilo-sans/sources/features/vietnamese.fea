# Vietnamese: stacked tone marks, the narrow tilde of ĩ Ĩ and y's dot below
# for decomposed text, and the stylistic-set forms of the Vietnamese letters.
# mark, mkmk and kern come from anchors and kerning; nothing here positions.
# i and j lose their dot under the hook above through @CombiningTopAccents in
# ccmp.fea, as under every other top mark.

@VietStack = [circumflexcomb_acutecomb circumflexcomb_gravecomb circumflexcomb_hookabovecomb circumflexcomb_tildecomb
    brevecomb_acutecomb brevecomb_gravecomb brevecomb_hookabovecomb brevecomb_tildecomb];
@VietStackCase = [circumflexcomb_acutecomb.case circumflexcomb_gravecomb.case circumflexcomb_hookabovecomb.case circumflexcomb_tildecomb.case
    brevecomb_acutecomb.case brevecomb_gravecomb.case brevecomb_hookabovecomb.case brevecomb_tildecomb.case];

feature ccmp {
    # A tone after a circumflex or breve: the Vietnamese stacked form (tone beside
    # the circumflex, on top of the breve). Precomposed letters already use them;
    # this catches decomposed (NFD) input that a shaper does not recompose.
    lookup vietnamese_stack {
        sub circumflexcomb acutecomb by circumflexcomb_acutecomb;
        sub circumflexcomb gravecomb by circumflexcomb_gravecomb;
        sub circumflexcomb hookabovecomb by circumflexcomb_hookabovecomb;
        sub circumflexcomb tildecomb by circumflexcomb_tildecomb;
        sub brevecomb acutecomb by brevecomb_acutecomb;
        sub brevecomb gravecomb by brevecomb_gravecomb;
        sub brevecomb hookabovecomb by brevecomb_hookabovecomb;
        sub brevecomb tildecomb by brevecomb_tildecomb;
    } vietnamese_stack;

    # The smaller stacks on capitals.
    lookup vietnamese_stack_case {
        lookupflag UseMarkFilteringSet @VietStack;
        sub [A E O] @VietStack' by @VietStackCase;
    } vietnamese_stack_case;

    # Inside a feature block a lookup flag carries over into the lookups that
    # follow; these two must see every mark, so they reset it.
    lookup vietnamese_narrow_tilde {
        lookupflag 0;
        sub [idotless I] tildecomb' by tildecomb.narrow;
    } vietnamese_narrow_tilde;

    # y + dot below: the dot sits beside the descender, not on it.
    lookup vietnamese_ydot {
        lookupflag 0;
        sub y dotbelowcomb by ydotbelow;
    } vietnamese_ydot;
} ccmp;

feature ss01 {
    lookup vietnamese_ss01 {
        sub dotbelowcomb by dotbelowcomb.ss01;
        sub Abrevedotbelow by Abrevedotbelow.ss01;
        sub Acircumflexdotbelow by Acircumflexdotbelow.ss01;
        sub Adotbelow by Adotbelow.ss01;
        sub Ecircumflexdotbelow by Ecircumflexdotbelow.ss01;
        sub Edotbelow by Edotbelow.ss01;
        sub Idotbelow by Idotbelow.ss01;
        sub Ocircumflexdotbelow by Ocircumflexdotbelow.ss01;
        sub Odotbelow by Odotbelow.ss01;
        sub Ohorndotbelow by Ohorndotbelow.ss01;
        sub Udotbelow by Udotbelow.ss01;
        sub Uhorndotbelow by Uhorndotbelow.ss01;
        sub Ydotbelow by Ydotbelow.ss01;
        sub abrevedotbelow by abrevedotbelow.ss01;
        sub acircumflexdotbelow by acircumflexdotbelow.ss01;
        sub adotbelow by adotbelow.ss01;
        sub ecircumflexdotbelow by ecircumflexdotbelow.ss01;
        sub edotbelow by edotbelow.ss01;
        sub idotbelow by idotbelow.ss01;
        sub ocircumflexdotbelow by ocircumflexdotbelow.ss01;
        sub odotbelow by odotbelow.ss01;
        sub ohorndotbelow by ohorndotbelow.ss01;
        sub udotbelow by udotbelow.ss01;
        sub uhorndotbelow by uhorndotbelow.ss01;
        sub ydotbelow by ydotbelow.ss01;
    } vietnamese_ss01;
} ss01;

feature ss02 {
    lookup vietnamese_ss02 {
        sub abreveacute by abreveacute.ss02;
        sub abrevedotbelow by abrevedotbelow.ss02;
        sub abrevedotbelow.ss01 by abrevedotbelow.ss01.ss02;
        sub abrevegrave by abrevegrave.ss02;
        sub abrevehookabove by abrevehookabove.ss02;
        sub abrevetilde by abrevetilde.ss02;
        sub acircumflexacute by acircumflexacute.ss02;
        sub acircumflexdotbelow by acircumflexdotbelow.ss02;
        sub acircumflexdotbelow.ss01 by acircumflexdotbelow.ss01.ss02;
        sub acircumflexgrave by acircumflexgrave.ss02;
        sub acircumflexhookabove by acircumflexhookabove.ss02;
        sub acircumflextilde by acircumflextilde.ss02;
        sub adotbelow by adotbelow.ss02;
        sub adotbelow.ss01 by adotbelow.ss01.ss02;
        sub ahookabove by ahookabove.ss02;
    } vietnamese_ss02;
} ss02;

feature ss03 {
    lookup vietnamese_ss03 {
        sub ydotbelow by ydotbelow.ss03;
        sub ydotbelow.ss01 by ydotbelow.ss01.ss03;
        sub yhookabove by yhookabove.ss03;
        sub ytilde by ytilde.ss03;
    } vietnamese_ss03;
} ss03;
