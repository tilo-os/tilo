# „Sag etwas dazu“ — die Verfassen-Fläche, die neben dem Kontextmenü aufgeht und
# die Adresse des ausgewählten Objekts mitführt.
#
# Die Ziel-Zeilen sind das, was die Auswahl anzeigt. Vertraulichkeit wird
# benannt, nie aus einem Namen erschlossen. Die Agent-Zeile sagt, warum ihre
# Vertraulichkeit unbedenklich ist, statt es vorauszusetzen.

remark_compose_placeholder = etwas dazu sagen
remark_compose_send = Senden

remark_destination_channel = # { $name }
remark_destination_private = { $name } — privat
remark_destination_agent = { $name } — privat; die Antwort erscheint im Raum
