# "Say something about this" — the compose surface that opens beside a context
# menu carrying the address of whatever is selected.
#
# The destination lines are what the selector shows. Privacy is stated, never
# left to be inferred from a name: someone must not have to work out from
# "Xaver" whether the room can read what they are writing. The agent line says
# why its privacy is unremarkable rather than expecting that to be known.

remark_compose_placeholder = say something about this
remark_compose_send = Send

remark_destination_channel = # { $name }
remark_destination_private = { $name } — private
remark_destination_agent = { $name } — private; its reply lands in the room
