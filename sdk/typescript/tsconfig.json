{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["bun"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "tilo-sdk": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "examples"]
}
