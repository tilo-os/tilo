+            let height =
+                (f64::from(tr.measure_style("Ag", None, &style).1).ceil() + 12.0).max(ROW_H);
+            let rect = Rect::new(0.0, 0.0, 240.0, height);
+            for kind in [
+                NavKind::Request {
+                    method: HttpMethod::Post,
+                    selected: true,
+                },
+                NavKind::History {
+                    method: HttpMethod::Get,
+                    status: 200,
+                },
