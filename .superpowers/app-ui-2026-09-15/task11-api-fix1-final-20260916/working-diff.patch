+        let boundaries: Vec<_> = label
+            .char_indices()
+            .map(|(i, _)| i)
+            .chain(std::iter::once(label.len()))
+            .collect();
+        let (mut low, mut high) = (0, boundaries.len() - 1);
+        while low < high {
+            let mid = (low + high).div_ceil(2);
+            if fits(tr, &format!("{}…", &label[..boundaries[mid]])) {
+                low = mid;
+            } else {
+                high = mid - 1;
+            }
+        }
+        format!("{}…", &label[..boundaries[low]])
+    }
