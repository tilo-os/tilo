+                        let different: Vec<_> = pixels
+                            .iter()
+                            .zip(low.iter().zip(&high))
+                            .enumerate()
+                            .filter(|(_, (p, (lo, hi)))| p < lo || p > hi)
+                            .map(|(i, (p, (lo, hi)))| (i, *p, *lo, *hi))
+                            .collect();
+                        assert!(
+                            different.is_empty(),
+                            "pixels outside measured reference range for {transform:?}, {clip:?}: {different:?}"
+                        );
