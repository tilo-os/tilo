{
  "name": "Find and open a document in Files",
  "goal": "Starting in Files, select Document-000.txt and open the intended document",
  "fixture": "files",
  "viewport": [
    800,
    700
  ],
  "budget": {
    "clicks": 2,
    "keys": 2
  },
  "steps": [
    {
      "op": "checkpoint",
      "name": "files",
      "checks": [
        {
          "kind": "state",
          "pointer": "/tab_titles/0",
          "equals": "Files"
        },
        {
          "kind": "visible",
          "target": "semantic:Document-000.txt"
        }
      ]
    },
    {
      "op": "input",
      "action": {
        "click_named": "semantic:Document-000.txt"
      }
    },
    {
      "op": "checkpoint",
      "name": "document-selected",
      "checks": [
        {
          "kind": "selected",
          "target": "semantic:Document-000.txt"
        }
      ]
    },
    {
      "op": "input",
      "action": {
        "key": "Enter"
      }
    },
    {
      "op": "wait_state",
      "pointer": "/tab_titles/1",
      "equals": "Document-000.txt",
      "timeout_ms": 2000
    },
    {
      "op": "checkpoint",
      "name": "document-open",
      "checks": [
        {
          "kind": "state",
          "pointer": "/tab_titles/1",
          "equals": "Document-000.txt"
        },
        {
          "kind": "state",
          "pointer": "/active_tabs/1/content/AppPlaceholder/kind/Other",
          "equals": "Editor"
        },
        {
          "kind": "visible",
          "target": "semantic:Document-000.txt"
        },
        {
          "kind": "semantic_value",
          "target": "semantic:Document-000.txt",
          "equals": "Fixture document 0\n"
        }
      ]
    }
  ]
}
