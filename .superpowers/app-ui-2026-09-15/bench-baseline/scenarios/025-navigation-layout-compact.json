{
  "name": "Desktop navigation geometry and contrast",
  "goal": "Read the current workspace and distinguish the controls for navigation",
  "viewport": [
    800,
    700
  ],
  "budget": {
    "clicks": 0,
    "keys": 0
  },
  "steps": [
    {
      "op": "checkpoint",
      "name": "navigation",
      "checks": [
        {
          "kind": "visible",
          "target": "semantic:topbar:workspace-settings"
        },
        {
          "kind": "target_size",
          "target": "semantic:topbar:overview",
          "min": [
            24,
            24
          ]
        },
        {
          "kind": "gap",
          "first": "semantic:topbar:workspace-down",
          "second": "semantic:topbar:workspace-settings",
          "axis": "x",
          "min": 4,
          "max": 12
        },
        {
          "kind": "aligned",
          "first": "semantic:topbar:overview",
          "second": "semantic:topbar:workspace-settings",
          "axis": "y",
          "tolerance": 1
        },
        {
          "kind": "no_overlap",
          "first": "semantic:topbar:workspace-down",
          "second": "semantic:topbar:workspace-settings"
        },
        {
          "kind": "contrast",
          "label": "Workspace name glyph and chip background \u2014 compact",
          "foreground": [
            164,
            25
          ],
          "background": [
            150,
            35
          ],
          "min": 4.5
        },
        {
          "kind": "contrast",
          "label": "App shortcut hint glyph and nearby desktop background \u2014 compact",
          "foreground": [
            275,
            591
          ],
          "background": [
            272,
            590
          ],
          "min": 4.5
        }
      ]
    }
  ]
}
