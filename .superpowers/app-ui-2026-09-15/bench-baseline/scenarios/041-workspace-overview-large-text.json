{
  "name": "Reach workspace overview",
  "goal": "Find and select a workspace using visible desktop navigation",
  "viewport": [
    1280,
    800
  ],
  "budget": {
    "clicks": 3,
    "keys": 0
  },
  "steps": [
    {
      "op": "input",
      "action": {
        "click_named": "semantic:topbar:overview"
      }
    },
    {
      "op": "checkpoint",
      "name": "overview",
      "checks": [
        {
          "kind": "visible",
          "target": "semantic:Home"
        }
      ]
    },
    {
      "op": "input",
      "action": {
        "click_named": "semantic:New workspace"
      }
    },
    {
      "op": "checkpoint",
      "name": "workspace-created",
      "checks": [
        {
          "kind": "state",
          "pointer": "/workspace_count",
          "equals": 2
        }
      ]
    },
    {
      "op": "input",
      "action": {
        "click_named": "semantic:topbar:workspace-up"
      }
    },
    {
      "op": "checkpoint",
      "name": "returned-home",
      "checks": [
        {
          "kind": "state",
          "pointer": "/active_workspace",
          "equals": "Home"
        },
        {
          "kind": "state",
          "pointer": "/workspace_count",
          "equals": 2
        }
      ]
    }
  ],
  "text_scale": 2
}
