+    fn worker_outcomes_keep_cpu_identity_independent_of_worker_counter() {
+        for outcome in [super::FrameOutcome::Presented, super::FrameOutcome::Skipped,
+            super::FrameOutcome::Reconfigured, super::FrameOutcome::SurfaceGone] {
+            let row = super::render_outcome_row(19, Some(7), (800, 600), outcome, 10, 20, None);
+            assert_eq!(row["frame_ix"], 19);
+            assert_eq!(row["cpu_frame_id"], 7);
+        }
+        let row = super::render_outcome_row(19, None, (800, 600),
+            super::FrameOutcome::Skipped, 10, 20, None);
