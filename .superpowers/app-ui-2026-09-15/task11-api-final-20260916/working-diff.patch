+            let full_glyphs = scenes[0].encoding().resources.glyphs.len();
+            let clipped_glyphs = scenes[1].encoding().resources.glyphs.len();
+            assert!(
+                clipped_glyphs * 3 < full_glyphs,
+                "offscreen glyphs must be omitted: {clipped_glyphs}/{full_glyphs}"
+            );
+        }
+    }
