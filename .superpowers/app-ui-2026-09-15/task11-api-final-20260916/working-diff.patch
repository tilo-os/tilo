+            Ok(buffers) => {
+                self.prepared = Some(buffers);
+                self.waiting.store(false, Ordering::SeqCst);
+                Ok(true)
+            }
+            Err(mpsc::TryRecvError::Empty) => Ok(false),
+            Err(error) => Err(error),
+        }
+    }
