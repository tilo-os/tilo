+                            .zip(low.iter().zip(&high))
+                            .enumerate()
+                            .filter(|(_, (v, (a, b)))| v < a || v > b)
+                            .take(20)
+                            .map(|(i, (v, (a, b)))| (
+                                i / 4 % w as usize,
+                                i / 4 / w as usize,
+                                i % 4,
+                                v,
+                                a,
+                                b
+                            ))
