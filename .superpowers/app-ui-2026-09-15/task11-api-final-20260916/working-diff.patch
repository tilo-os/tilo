+pub(crate) struct BufferPool<T> {
+    receiver: Receiver<T>,
+    prepared: Option<T>,
+    waiting: Arc<AtomicBool>,
+}
+
+impl<T> BufferPool<T> {
+    fn new(receiver: Receiver<T>, waiting: Arc<AtomicBool>) -> Self {
+        Self {
+            receiver,
+            prepared: None,
+            waiting,
+        }
+    }
