+fn move_pointer(d: &mut Driver, x: f64, y: f64) {
+    d.send(&winit::event::WindowEvent::CursorMoved {
+        device_id: winit::event::DeviceId::dummy(),
+        position: winit::dpi::PhysicalPosition::new(x, y),
+    });
+}
