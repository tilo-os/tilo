+fn click_tab(d: &mut Driver, index: usize) {
+    let rect = d.targets()["api.request-tabs"];
+    d.click_at(
+        rect.x0 + rect.width() * (index as f64 + 0.5) / 4.0,
+        rect.center().y,
+    );
+}
