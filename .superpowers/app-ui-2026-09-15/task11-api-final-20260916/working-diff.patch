+#[test]
+fn composition_params_fit_rows_and_divider_adjusts_with_keyboard() {
+    let mut d = driver();
+    let before = d.targets()["api.request-divider"];
+    assert!(
+        before.y0 < 310.0,
+        "three parameter rows fit above the response"
