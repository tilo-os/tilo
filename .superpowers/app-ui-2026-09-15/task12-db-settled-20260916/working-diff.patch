+        let endpoint=crate::storage::explicit_root().and_then(|_|std::env::var("QOS_BROWSER_FILTER_ENDPOINT").ok()).filter(|s|url::Url::parse(s).is_ok_and(|u|matches!(u.host_str(),Some("127.0.0.1"|"localhost"|"[::1]"))));
+        let lists=crate::blocker::LISTS.iter().map(|(name,url)|(name.to_string(),endpoint.clone().unwrap_or_else(||url.to_string()))).collect::<Vec<_>>();
