+                    }
+                }
+            }
+        }
+        let mut reference = Scene::new();
+        renderer.draw_rich(&mut reference, &layout, Affine::IDENTITY, Color::WHITE);
+        let mut invalid = Scene::new();
+        renderer.draw_rich_in_clip(
+            &mut invalid,
+            &layout,
+            Affine::IDENTITY,
+            Color::WHITE,
