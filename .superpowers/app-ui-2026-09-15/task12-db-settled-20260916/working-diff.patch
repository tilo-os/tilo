+            if text.len()>MAX_LIST as usize || text.trim().is_empty() || text.trim_start().starts_with('<') {return Err(format!("Invalid {name}"));}
+            downloads.push((path,text.clone()));text
+        };
+        if rules.len()+text.len()+1>MAX_TOTAL {return Err("Combined lists exceed limit".into());}
+        append_bounded(&mut rules,&text);
     }
+    // No cache is replaced until the whole requested set downloaded correctly.
+    if !downloads.is_empty() {std::fs::create_dir_all(directory).map_err(|_|"Cannot save filter cache")?;}
