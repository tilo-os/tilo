+                    .iter_mut()
+                    .zip(&mut high)
+                    .zip(renderer.render(&scenes[0], bg))
+                {
+                    *low = (*low).min(value);
+                    *high = (*high).max(value);
+                }
+            }
+            let variable = low.iter().zip(&high).filter(|(a, b)| a != b).count();
+            assert!(
