+        );
+    }
+    assert!(!renderer.ink_bounds.is_empty());
+    assert!(renderer.ink_bounds_entries <= SHAPE_CACHE_LIMIT);
+    assert_eq!(
+        renderer.ink_bounds_entries,
+        renderer
+            .ink_bounds
+            .values()
+            .map(HashMap::len)
+            .sum::<usize>()
+    );
