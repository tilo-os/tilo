+pub(crate) fn shell_action_kind(id: &str) -> qos_actions::OperationKind {
+    match id {
+        "shortcut-help.toggle"
+        | "desktop-tour.open"
+        | "overview.toggle"
+        | "settings.open"
+        | "settings.members.open"
+        | "settings.privacy.open"
+        | "settings.apps.open"
+        | "quick-settings.open"
+        | "projection.open"
+        | "capture.open"
+        | "collaborators.open"
+        | "room.activity.open"
+        | "peer.invite"
+        | "peer.connect" => qos_actions::OperationKind::View,
+        "text.insert" | "record.bring" | "peer.invite.named" | "agent.invite" => {
+            qos_actions::OperationKind::Document
+        }
+        _ if id.contains("#ownership.") => qos_actions::OperationKind::Document,
+        _ => qos_actions::OperationKind::Effect,
+    }
+}
