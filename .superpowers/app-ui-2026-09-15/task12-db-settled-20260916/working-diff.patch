+pub(crate) fn status()->Status {state().lock().unwrap().clone()}
+fn fetch_rules(directory:&Path,lists:&[(String,String)],force:bool)->Result<(String,bool),String> {
+    use std::io::Read;
+    let client=reqwest::blocking::Client::builder().timeout(std::time::Duration::from_secs(15)).build().map_err(|e|e.to_string())?;
+    let mut rules=BASELINE.to_string();let mut downloads=Vec::new();
+    for(name,url) in lists {
+        let path=directory.join(name);
+        let fresh=!force && std::fs::metadata(&path).ok().is_some_and(|m|m.len()<=MAX_LIST && m.modified().ok().and_then(|t|t.elapsed().ok()).is_some_and(|a|a.as_secs()<604800));
+        let text=if fresh {crate::blocker::read_cached_list(&path).ok_or_else(||format!("Cannot read {name}"))?}else {
+            let response=client.get(url).send().and_then(reqwest::blocking::Response::error_for_status).map_err(|_|format!("Could not download {name}"))?;
