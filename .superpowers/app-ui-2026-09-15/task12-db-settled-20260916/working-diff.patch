+                conn.closed = true;
+                return PendingConnectionProgress::Closed;
+            }
+            Ok(written) => conn.output_offset += written,
+            Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                return PendingConnectionProgress::OutputPending;
+            }
+            Err(error) => {
