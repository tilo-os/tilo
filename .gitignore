.env
os/output/
os/quick-desktop
**/target/
# rpmbuild's _topdir for the host session package (dist/rpm/build-rpm.sh):
# staged payload, tarball and the built RPMs.
dist/rpm/build/

# BranchBox
.branchbox/registry.json
.branchbox/secure/
.branchbox/secure/tunnels/
.devcontainer/.branchbox.env
.devcontainer/.cloudflared.env
.devcontainer/.github-token.env
.devcontainer/.git-signing-key
.devcontainer/.gitconfig.env
.branchbox.env
.env.local
scripts/headless-examples/__pycache__/
scripts/__pycache__/
tools/__pycache__/
tools/**/__pycache__/

# qOS signing keys — PRIVATE material is NEVER committed (see keys/README.md).
# Public keys (keys/*.pub, keys/*.public.pem) ARE tracked — verifiers need them.
keys/*.key
keys/*.password
keys/*.private.pem
keys/**/*.key
keys/**/*.private.pem
# runtime CRDT session artifacts (e.g. ui/examples write session.crdt)
*.crdt
.claude/test-scratch/
# Local build infrastructure and feature worktrees. These live under
# .claude so they travel with the checkout, but none of them belong in
# history: the sccache alone is ~11 GB, and .claude/qos is a nested
# clone that a fresh clone of this repo could never populate.
.claude/qos/
.claude/qos-sccache/
.claude/qos-build-sem/
.claude/qos-target/
.claude/qos-tools/
.claude/qos-logs/
.claude/qos-tmp/
.claude/build/
.claude/clippy-campaign/
.claude/worktrees/
.claude/app-status.md
.claude/*.log

# build.sh copies the real hardening kargs, the rollback machinery and the
# freshly built qos-rollback binary into the composefs build context
os/dev/composefs/01-hardening.toml
os/dev/composefs/stage/
