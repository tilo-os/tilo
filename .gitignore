# qOS signing keys — PRIVATE material is NEVER committed (see keys/README.md).
# Public keys (keys/*.pub, keys/*.public.pem) ARE tracked — verifiers need them.
keys/*.key
keys/*.password
keys/*.private.pem
keys/**/*.key
keys/**/*.private.pem

# Signing keys — private material must never be committed (public keys are tracked)
keys/*.key
keys/*.password
keys/*.private.pem
# runtime CRDT session artifacts (e.g. ui/examples write session.crdt)
*.crdt
.claude/test-scratch/
