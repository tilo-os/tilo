#!/usr/bin/env bash
# Cargo's outer compiler dispatcher. Keeping the sccache basename also lets
# cc-rs use the same native compiler cache, without changing its flags.
set -euo pipefail

workspace_wrapper="${BASH_SOURCE[0]%/thin-app/sccache}/rustc-thin-app-wrapper.sh"
if [[ ${1:-} == "$workspace_wrapper" ]]; then
    exec "$@"
fi
exec "${TILO_THIN_SCCACHE:?thin-app compiler cache is not configured}" "$@"
