#!/usr/bin/env bash
# cargo wrapper for trees that build inside a container. Install as `cargo` on PATH.
#
# Does three things:
#   - routes the build into the container named in `.build-container` (found by walking
#     up from $PWD, so worktrees are covered by the root's marker)
#   - selects the sccache server by port. distrobox shares the host network namespace
#     and copies the host environment inward, so without an explicit choice on both
#     sides a container build reaches the host's server, which cannot see the
#     container's headers. Presents as a cache miss, not an error.
#   - derives job count and cache ceiling from the hardware
#
# Every failure path falls through to plain cargo. QCARGO_BYPASS=1 skips it,
# QCARGO_DEBUG=1 prints the routing decision.
#
# Environment values are an API: nested builders deliberately use a disk-backed
# TMPDIR/CARGO_TARGET_DIR and sometimes set RUSTC_WRAPPER to the empty string.
# Defaults below must never replace those caller choices.

set -uo pipefail

real_cargo="${CARGO_HOME:-${HOME}/.cargo}/bin/cargo"

# Fall back to any other cargo on PATH that is not this shim (rustup-less environments).
if [ ! -x "$real_cargo" ]; then
  self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  real_cargo=""
  while IFS= read -r cand; do
    if [ "$(readlink -f "$cand" 2>/dev/null || echo "$cand")" != "$self" ]; then
      real_cargo="$cand"
      break
    fi
  done < <(type -a -p cargo 2>/dev/null)
  if [ -z "$real_cargo" ]; then
    echo "cargo: no cargo binary found" >&2
    exit 127
  fi
fi
readonly REAL_CARGO="$real_cargo"

[ -n "${QCARGO_BYPASS:-}" ] && exec "$REAL_CARGO" "$@"

_route() { [ -n "${QCARGO_DEBUG:-}" ] && echo "qcargo: $1" >&2; return 0; }

# Job count is bounded by memory, not cores. CARGO_BUILD_JOBS is not in sccache's
# cache key, so deriving it per-machine does not fragment the cache.
readonly GB_PER_RUSTC=7
derive_jobs() {
  local cores mem_gb by_mem
  cores=$(nproc 2>/dev/null || echo 4)
  mem_gb=$(awk '/^MemTotal:/{printf "%d", $2/1048576}' /proc/meminfo 2>/dev/null || echo 8)
  by_mem=$(( mem_gb / GB_PER_RUSTC ))
  [ "$by_mem" -lt 1 ] && by_mem=1
  if [ "$by_mem" -lt "$cores" ]; then echo "$by_mem"; else echo "$cores"; fi
}

# sccache ceiling: 20% of the filesystem, floor 64G, cap 200G.
#
# The cache ceiling keeps room for multiple workspace builds without consuming
# the whole filesystem.
derive_cache_size() {
  local kb gb
  kb=$(df -Pk "${SCCACHE_DIR:-$HOME/.cache}" 2>/dev/null | awk 'NR==2{print $2}')
  [ -z "$kb" ] && { echo "64G"; return; }
  gb=$(( kb / 1048576 / 5 ))
  [ "$gb" -lt 64 ] && gb=64
  [ "$gb" -gt 200 ] && gb=200
  echo "${gb}G"
}

use_sccache() {
  # `${name+x}` is deliberate: an explicitly empty wrapper means "plain
  # rustc".  `${name:-}` cannot distinguish that choice from an unset value
  # and used to silently turn sccache back on in nested packaging builds.
  if [ "${RUSTC_WRAPPER+x}" != x ]; then
    command -v sccache >/dev/null 2>&1 || return 0
    export RUSTC_WRAPPER=sccache
  fi
  case "${RUSTC_WRAPPER##*/}" in
    sccache) ;;
    *) return 0 ;;
  esac
  # sccache cannot cache incremental rustc invocations. Scope this policy to
  # cache users, so native builds can reuse work within changed crates. An
  # explicit caller choice still wins, including CARGO_INCREMENTAL=1.
  export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
  export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-$(derive_cache_size)}"
}

# Never set CARGO_TARGET_DIR; it participates in sccache's Rust cache key.

# distrobox preserves $PWD, so this resolves identically on both sides of the boundary.
find_marker() {
  local d="$PWD"
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    [ -r "$d/.build-container" ] && { echo "$d"; return 0; }
    [ "$d" = "$HOME" ] && break
    d="$(dirname "$d")"
  done
  return 1
}
marker_dir="$(find_marker || true)"

# Only for trees with a marker: this shim is `cargo` for every project on the box, and
# capping unrelated ones at this workspace's memory profile would throttle them.
[ -n "$marker_dir" ] && export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-$(derive_jobs)}"

# --- inside a container: this *is* the build environment, so build here ---------------------
if [ -f /run/.containerenv ] || [ -n "${CONTAINER_ID:-}" ]; then
  # A caller may deliberately select a separate server/cache namespace for a
  # reproducible or concurrent build.  Supply container-safe defaults without
  # replacing that explicit choice.  The namespace defaults are selected only
  # when neither the caller nor the surrounding build selected an override.
  export SCCACHE_SERVER_PORT="${SCCACHE_SERVER_PORT:-4226}"
  export SCCACHE_DIR="${SCCACHE_DIR:-${HOME}/.cache/sccache-distrobox}"
  use_sccache
  _route "container(${CONTAINER_ID:-?}) port=$SCCACHE_SERVER_PORT dir=$SCCACHE_DIR jobs=${CARGO_BUILD_JOBS:-cargo-default} size=${SCCACHE_CACHE_SIZE:-none}"
  exec "$REAL_CARGO" "$@"
fi

# --- host: route to a container if the project asks for one ---------------------------------
container=""
[ -n "$marker_dir" ] && container="$(head -n1 "$marker_dir/.build-container" | tr -d '[:space:]')"

if [ -n "$container" ] && command -v distrobox >/dev/null 2>&1; then
  # distrobox keeps its chatter on stderr, so stdout stays clean for callers that
  # parse it (`cargo metadata`, rust-analyzer).
  _route "dispatch->$container (marker in $marker_dir)"
  exec distrobox enter "$container" -- cargo "$@"
fi

export SCCACHE_SERVER_PORT=4227
export SCCACHE_DIR="${HOME}/.cache/sccache"
use_sccache
_route "host port=$SCCACHE_SERVER_PORT dir=$SCCACHE_DIR jobs=${CARGO_BUILD_JOBS:-cargo-default} size=${SCCACHE_CACHE_SIZE:-none}"
exec "$REAL_CARGO" "$@"
