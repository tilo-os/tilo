+/* Private review candidate: history is explicitly opted into by its owner.
+ * Derived widgets/buffers keep their own history. Foreign buffer writes retire
+ * this entry's stack; a shared buffer never lends another entry its selection.
+ */
+static void
+entry_history_clear (GtkEntry *entry)
+{
+  if (entry->priv->history)
+    gtk_text_history_set_enabled (entry->priv->history, FALSE);
+}
+
+/* Registration is an explicit owner contract, never inferred from focus.
+ * The owner agrees that the stock buffer is its history authority. A custom
+ * undo/redo handler requires its own adapter and is refused here.
+ */
+static gboolean
+entry_history_registered (GtkEntry *entry)
+{
+  return entry->priv->history_owner != NULL &&
+    G_OBJECT_TYPE (entry) == GTK_TYPE_ENTRY &&
+    G_OBJECT_TYPE (get_buffer (entry)) == GTK_TYPE_ENTRY_BUFFER &&
+    !g_signal_has_handler_pending (entry, signals[HISTORY_UNDO], 0, TRUE) &&
+    !g_signal_has_handler_pending (entry, signals[HISTORY_REDO], 0, TRUE);
+}
+
+static gboolean
+entry_history_available (GtkEntry *entry)
+{
+  GtkInputPurpose purpose = gtk_entry_get_input_purpose (entry);
+  return entry_history_registered (entry) && entry->priv->history_opt_in &&
+    entry->priv->editable && entry->priv->visible &&
+    gtk_widget_is_sensitive (GTK_WIDGET (entry)) &&
+    gtk_widget_is_visible (GTK_WIDGET (entry)) &&
+    gtk_widget_has_focus (GTK_WIDGET (entry)) &&
+    purpose != GTK_INPUT_PURPOSE_PASSWORD && purpose != GTK_INPUT_PURPOSE_PIN;
+}
+
+static void
+entry_history_refresh (GtkEntry *entry)
+{
+  GtkEntryPrivate *priv = entry->priv;
+  GtkInputPurpose purpose = gtk_entry_get_input_purpose (entry);
+  gboolean enabled = entry_history_registered (entry) &&
+    priv->history_opt_in && priv->editable && priv->visible &&
+    purpose != GTK_INPUT_PURPOSE_PASSWORD && purpose != GTK_INPUT_PURPOSE_PIN;
+  if (priv->history_depth == 0)
+    gtk_text_history_set_enabled (priv->history, enabled);
+}
+
+static void
+entry_history_state (gpointer data, gboolean modified,
+                     gboolean can_undo, gboolean can_redo)
+{
+  (void) modified; (void) can_undo; (void) can_redo;
+  g_object_notify (G_OBJECT (data), "can-undo");
+  g_object_notify (G_OBJECT (data), "can-redo");
+}
+
+static void
+entry_history_insert (gpointer data, guint begin, guint end,
+                      const char *text, guint len)
+{
+  GtkEntry *entry = data;
+  gint position = begin;
+  (void) end;
+  gtk_editable_insert_text (GTK_EDITABLE (entry), text, len, &position);
+}
+
+static void
+entry_history_delete (gpointer data, guint begin, guint end,
+                      const char *expected, guint len)
+{
+  GtkEntry *entry = data;
+  gchar *actual = gtk_editable_get_chars (GTK_EDITABLE (entry), begin, end);
+  if (strlen (actual) == len && memcmp (actual, expected, len) == 0)
+    gtk_editable_delete_text (GTK_EDITABLE (entry), begin, end);
+  else
+    entry_history_clear (entry);
+  g_free (actual);
+}
+
+static void
+entry_history_select (gpointer data, int insert, int bound)
+{
+  gtk_editable_select_region (GTK_EDITABLE (data), bound, insert);
+}
+
+static const GtkTextHistoryFuncs entry_history_funcs = {
+  entry_history_state, entry_history_insert,
+  entry_history_delete, entry_history_select
+};
+
+static gboolean
+entry_history_undo (GtkEntry *entry)
+{
+  entry_history_refresh (entry);
+  if (!entry_history_available (entry))
+    return FALSE;
+  gtk_text_history_undo (entry->priv->history);
+  return TRUE;
+}
+
+static gboolean
+entry_history_redo (GtkEntry *entry)
+{
+  entry_history_refresh (entry);
+  if (!entry_history_available (entry))
+    return FALSE;
+  gtk_text_history_redo (entry->priv->history);
+  return TRUE;
+}
