+    // Borrowed descriptor must be immutable and used exclusively during loading.
+    // Duplication shares its file offset; no caller descriptor is retained.
+    explicit llama_file(int fd) : fp(nullptr), size(0) {
+        const int flags = fcntl(fd, F_GETFL);
+        struct stat metadata {};
+        if (flags < 0 || (flags & O_ACCMODE) != O_RDONLY ||
+            fstat(fd, &metadata) != 0 || !S_ISREG(metadata.st_mode) || metadata.st_size < 0) {
+            throw std::runtime_error("model descriptor must be a read-only regular file");
+        }
+        const int owned = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+        if (owned < 0) throw std::runtime_error("failed to duplicate model descriptor");
+        fp = fdopen(owned, "rb");
+        if (!fp) {
+            close(owned);
+            throw std::runtime_error("failed to open model descriptor stream");
+        }
+        size = static_cast<size_t>(metadata.st_size);
+        if (fseek(fp, 0, SEEK_SET) != 0) {
+            fclose(fp);
+            fp = nullptr;
+            throw std::runtime_error("failed to rewind model descriptor");
+        }
+    }
