+/* Execution counters describe completed blocks, not pending self costs.
+ * Cache simulation can have recorded any prefix of the current block, even
+ * when collection is disabled before that block exits. Do not defer those
+ * instruction slots to a later dump, whose summary excludes them.
+ * Keep execution/jump counters unchanged: inventing an execution here would
+ * change instruction positions and jump counts (and double count on exit).
+ */
+static Bool bbcc_has_dump_data(BBCC* bbcc)
+{
+  UInt i;
+  jCC* jcc;
+
+  if (bbcc->ecounter_sum || bbcc->ret_counter) return True;
+  for (i = 0; i < bbcc->bb->cost_count; i++)
+    if (bbcc->cost[i]) return True;
+  if (bbcc->skipped &&
+      !CLG_(is_zero_cost)(CLG_(sets).full, bbcc->skipped)) return True;
+  for (i = 0; i <= bbcc->bb->cjmp_count; i++)
+    for (jcc = bbcc->jmp[i].jcc_list; jcc; jcc = jcc->next_from)
+      if (!CLG_(is_zero_cost)(CLG_(sets).full, jcc->cost)) return True;
+  return False;
+}
