## Pack + install + run: hello (packaging.md, sandbox.md, runtime.md,
## installation.md, hello-world.md)

  # Copy qos-hello into a payload dir
  cp target/release/qos-hello /tmp/qos-hello-demo/payload/bin/qos-hello

  # Write manifest.toml (see hello-world.md for exact contents)

  qos-pkg pack \
    --manifest /tmp/qos-hello-demo/manifest.toml \
    --payload  /tmp/qos-hello-demo/payload \
    --output   /tmp/qos-hello-demo/qos-hello.qpkg
  # → packed qpkg:b8bde92e2352dd7a3b3e094968272c42d51196697a5cec17f36e3595a55a71d3 (4 blobs)

  qos-install install /tmp/qos-hello-demo/qos-hello.qpkg
  # → WARN self-signed
  # → installed: dev.qos.hello 0.1.0

  qos-install list                                # → 1 row
  qos-install inspect dev.qos.hello               # → full record

  qos-install run dev.qos.hello --no-services
  # → landlock partially enforced (12 ro, 2 rw)
  # → collab/fs/identity unavailable (no fd — graceful)
  # → sandbox probes: /proc/self/status permission denied, /etc/passwd not found,
  #                   /tmp OK, /qos-launcher OK, /var/qos-apps/probe permission denied
  # → portal probes: NotAvailable (no bus proxied)

  tar tvf /tmp/qos-hello-demo/qos-hello.qpkg
  # → 8 entries: qpkg.toml, signed-root, manifest.toml, collection.qcl, 4× blobs/<hex>
  tar xOf /tmp/qos-hello-demo/qos-hello.qpkg qpkg.toml
  # → package_id = "qpkg:b8bde92e…"; format = 1

  qos-pkg inspect /tmp/qos-hello-demo/qos-hello.qpkg
  # → full manifest + payload listing

  qos-pkg verify /tmp/qos-hello-demo/qos-hello.qpkg
  # → ok: … verifies and publisher is trusted

  qos-install remove dev.qos.hello

## CLI apps (cli-apps.md)

  cp target/release/notes /tmp/qos-notes-demo/payload/bin/notes
  cp crates/packaging/notes-cli/manifest.toml /tmp/qos-notes-demo/

  qos-pkg pack \
    --manifest /tmp/qos-notes-demo/manifest.toml \
    --payload  /tmp/qos-notes-demo/payload \
    --output   /tmp/qos-notes-demo/notes-cli.qpkg
  # → packed qpkg:36c777e2… (4 blobs)

  QOS_CLI_SHIM_PATH=target/release/qos-cli-shim \
  QOS_LAUNCHER_PATH=target/release/qos-launcher \
  qos-install install /tmp/qos-notes-demo/notes-cli.qpkg
  # → shims: wrote 1 shim(s) into <bin-dir>

  qos-install list                                # → 1 row (dev.qos.notes-cli)
  qos-install path                                # → path + shell rc snippets
  ls -la <bin-dir>                                # → notes + notes.qos-shim sidecar

  # Ensure the fs.write target exists before launch (bwrap can't bind
  # a non-existent path)
  mkdir -p ~/.local/share/dev.qos.notes-cli

  PATH="<bin-dir>:$PATH"
  notes "hello from the shim"                     # → wrote note → file:// link
  notes list                                      # → prints inbox.md
  notes path                                      # → prints resolved path

  qos-install remove dev.qos.notes-cli

## Trust management (trust.md)

  qos-install trust list                          # → (no trusted attestors)
  qos-install trust add --id "test-attestor/2026" \
    --pubkey "00…01" --scope "all"
  qos-install trust list                          # → 1 row
  qos-install trust remove test-attestor/2026

  qos-install revoked list                        # → (no revoked keys)
  qos-install revoke deadbeef…deadbeef --reason "test revocation"
  qos-install revoked list                        # → 1 row

  # --require-attestor / --allow-self-signed matrix
  qos-install install --require-attestor "test-attestor/2026" \
    /tmp/qos-hello-demo/qos-hello.qpkg --force
  # → refused (self-signed vs required attestor)

  qos-install install --require-attestor "test-attestor/2026" \
    --allow-self-signed /tmp/qos-hello-demo/qos-hello.qpkg --force
  # → installed (fallback path taken)

