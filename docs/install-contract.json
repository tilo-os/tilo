{
  "schemaVersion": 2,
  "product": "Tilo",
  "imager": {
    "hosts": [
      {
        "os": "Linux",
        "architectures": ["x86_64", "aarch64"],
        "downloads": ["Flatpak bundle", "AppImage", "portable tarball"],
        "packageManager": "Homebrew formula"
      },
      {
        "os": "Windows 10 or 11",
        "architectures": ["x86_64", "aarch64"],
        "downloads": ["setup EXE", "standalone EXE", "portable zip"],
        "packageManager": "WinGet"
      },
      {
        "os": "macOS",
        "architectures": ["x86_64", "aarch64"],
        "downloads": ["notarized DMG", "app zip"],
        "packageManager": "Homebrew cask"
      }
    ]
  },
  "completeSystem": {
    "architectures": ["x86_64", "aarch64"],
    "usbCapacity": {
      "requirement": "expanded-image-size",
      "catalogField": "image_size",
      "unit": "bytes"
    },
    "minimumVmMemoryGiB": 4,
    "minimumVmDiskGiB": 40,
    "alongside": {
      "rootMinimumGiB": 32,
      "efiMinimumGiB": 2,
      "efiMinimumFreeGiB": 1,
      "resizesExistingFilesystems": false
    }
  },
  "desktopSession": [
    { "distribution": "Ubuntu", "versions": ["24.04"], "architectures": ["amd64"], "plannedArchitectures": ["arm64"], "package": "tilo-session" },
    { "distribution": "Debian", "versions": ["13"], "architectures": ["amd64"], "plannedArchitectures": ["arm64"], "package": "tilo-session" },
    { "distribution": "Fedora", "versions": ["44"], "architectures": ["x86_64"], "plannedArchitectures": ["aarch64"], "package": "tilo-session" },
    { "distribution": "Arch Linux", "versions": ["rolling"], "architectures": ["x86_64"], "plannedArchitectures": ["aarch64"], "package": "tilo-session" },
    { "distribution": "NixOS", "versions": ["flake"], "architectures": ["x86_64-linux"], "plannedArchitectures": ["aarch64-linux"], "package": "tilo-session" }
  ],
  "principles": [
    "Tilo Imager authenticates the selected installer before writing and verifies the medium after writing.",
    "The media-writing route carries only secret-free setup choices and does not migrate files or resize an internal disk.",
    "The development guided-import route copies explicitly selected local folders where native durability is supported, preserves originals, and does not authorize synchronization or sharing.",
    "The live installer never resizes an existing filesystem.",
    "A complete-system installation keeps recovery-key setup and destructive disk confirmation on the target computer."
  ]
}
