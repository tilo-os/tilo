cargo 1.97.1 (c980f4866 2026-06-30)
rustc 1.97.1 (8bab26f4f 2026-07-14)
binary: rustc
commit-hash: 8bab26f4f68e0e26f0bb7960be334d5b520ea452
commit-date: 2026-07-14
host: aarch64-unknown-linux-gnu
release: 1.97.1
LLVM version: 22.1.6
[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
panic = "abort"
strip = "symbols"
overflow-checks = false
debug = "line-tables-only"
incremental = false

# Thin-app profile: the release profile, minus the two settings that are
# fundamentally incompatible with dynamic linking of the SDK.
#
#   * `panic = "unwind"` — a Rust `dylib` (and anything linking one, via
#     `-C prefer-dynamic`) must unwind; `panic = "abort"` is rejected.
CXXFLAGS_x86_64_unknown_linux_gnu = { value = "-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -Wno-cpp -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -Wa,--noexecstack", force = true }

# sccache refuses `-C incremental=`; with it on, 13,417/16,947 requests refused.
# Here rather than Cargo.toml: a config [profile] overrides the manifest.
[profile.dev]
incremental = false

[profile.release]
incremental = false
cargo is /home/xaver/.yc/bin/cargo
cargo is /home/xaver/.yc/bin/cargo
cargo is /home/xaver/.yc/bin/cargo
cargo is /home/xaver/.cargo/bin/cargo
cargo is /home/xaver/.yc/bin/cargo
