+            .map_err(|_| OffscreenError::ContextPoisoned)?;
+        let handle = context
+            .devices
+            .get(self.dev_id)
+            .ok_or(OffscreenError::NoAdapter)?;
+        Ok(handle.adapter.get_info())
+    }
