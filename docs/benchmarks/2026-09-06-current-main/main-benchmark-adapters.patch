+    /// Submit a full-target Area render and wait for GPU completion without a texture readback.
+    ///
+    /// This is intentionally a benchmark adapter: ordinary screenshot APIs continue to use
+    /// [`Self::render`], including their texture copy and CPU pixel materialization.
+    pub fn render_and_wait(&mut self, scene: &Scene, bg: Color) -> Result<bool, String> {
+        let (device, queue) = {
+            let ctx = self
+                .context
+                .lock()
+                .map_err(|_| "shared RenderContext poisoned".to_owned())?;
+            let handle = ctx
+                .devices
+                .get(self.dev_id)
+                .ok_or_else(|| "renderer device missing".to_owned())?;
+            (handle.device.clone(), handle.queue.clone())
+        };
+        self.renderer
+            .render_to_texture(
+                &device,
+                &queue,
+                scene,
+                &self.view,
+                &RenderParams {
+                    base_color: bg,
+                    width: self.width,
+                    height: self.height,
+                    antialiasing_method: AaConfig::Area,
+                },
+            )
+            .map_err(|error| format!("vello render: {error:?}"))?;
+        device
+            .poll(wgpu::PollType::Wait {
+                submission_index: None,
+                timeout: Some(std::time::Duration::from_secs(1)),
+            })
+            .map_err(|error| format!("GPU completion wait: {error:?}"))?;
+        Ok(self.renderer.settle_bump_budget(&device))
+    }
+
+    /// Adapter actually backing this offscreen renderer, for benchmark reporting only.
