diff --git a/shell/examples/redraw_bench.rs b/shell/examples/redraw_bench.rs
new file mode 100644
index 000000000..a70c7a587
--- /dev/null
+++ b/shell/examples/redraw_bench.rs
@@ -0,0 +1,202 @@
+//! Native-4K, 1,000-action DRM bridge benchmark for the unmodified main renderer.
+//!
+//! Each sample performs input dispatch, relayout, scene paint, production `paint_into_xrgb8888`,
+//! its texture readback, swizzle, and the bridge's bounded GPU/map waits. There is no DRM/KMS
+//! page flip in this headless adapter. Main's bridge has no bump-settlement retry telemetry.
+
+use std::time::Instant;
+
+use automerge::{AutoCommit, ROOT};
+use shell::compositor::backend::drm::paint::VelloDrmBridge;
+use shell::compositor::frame::FrameBuilder;
+use ui::taffy::NodeId;
+use winit::dpi::PhysicalPosition;
+use winit::event::{DeviceId, ElementState, Modifiers, MouseButton, WindowEvent};
+
+const WIDTH: u32 = 3_840;
+const HEIGHT: u32 = 2_160;
+const SAMPLES: usize = 1_000;
+const TARGETS: [&str; 2] = ["topbar_tray_pill", "topbar_overview_button"];
+
+#[derive(Clone, Copy)]
+struct Summary {
+    total_us: u128,
+    mean_us: u128,
+    p99_us: u128,
+    min_us: u128,
+    max_us: u128,
+}
+
+fn summarize(samples: &mut [u128]) -> Result<Summary, String> {
+    if samples.len() != SAMPLES || samples.contains(&0) {
+        return Err("expected 1,000 nonzero completed samples".to_owned());
+    }
+    let total = samples
+        .iter()
+        .try_fold(0_u128, |sum, value| sum.checked_add(*value))
+        .ok_or_else(|| "sample total overflow".to_owned())?;
+    samples.sort_unstable();
+    let p99_index = samples.len().saturating_mul(99).saturating_add(99) / 100 - 1;
+    Ok(Summary {
+        total_us: total,
+        mean_us: total / u128::try_from(samples.len()).map_err(|_| "sample count overflow")?,
+        p99_us: *samples
+            .get(p99_index)
+            .ok_or_else(|| "p99 unavailable".to_owned())?,
+        min_us: *samples
+            .first()
+            .ok_or_else(|| "minimum unavailable".to_owned())?,
+        max_us: *samples
+            .last()
+            .ok_or_else(|| "maximum unavailable".to_owned())?,
+    })
+}
+
+fn click(
+    frame: &mut FrameBuilder,
+    target: &str,
+    document: &mut AutoCommit,
+    focus: &mut Option<NodeId>,
+) -> Result<(), String> {
+    let rect = frame
+        .widget_registry()
+        .get(target)
+        .copied()
+        .filter(|rect| rect.area() > 0.0)
+        .ok_or_else(|| format!("required target {target:?} is absent or empty"))?;
+    let center = rect.center();
+    let modifiers = Modifiers::default();
+    let cursor = WindowEvent::CursorMoved {
+        device_id: DeviceId::dummy(),
+        position: PhysicalPosition::new(center.x, center.y),
+    };
+    let press = WindowEvent::MouseInput {
+        device_id: DeviceId::dummy(),
+        state: ElementState::Pressed,
+        button: MouseButton::Left,
+    };
+    let release = WindowEvent::MouseInput {
+        device_id: DeviceId::dummy(),
+        state: ElementState::Released,
+        button: MouseButton::Left,
+    };
+    let _ = frame.dispatch_event(&cursor, &modifiers, document, &ROOT, focus);
+    let pressed = frame.dispatch_event(&press, &modifiers, document, &ROOT, focus);
+    let released = frame.dispatch_event(&release, &modifiers, document, &ROOT, focus);
+    (pressed || released)
+        .then_some(())
+        .ok_or_else(|| format!("target {target:?} did not handle click"))
+}
+
+fn destination_checksum(destination: &[u8]) -> u64 {
+    destination
+        .iter()
+        .fold(0xcbf2_9ce4_8422_2325_u64, |hash, byte| {
+            (hash ^ u64::from(*byte)).wrapping_mul(0x100_0000_01b3)
+        })
+}
+
+fn require_nonuniform_destination(destination: &[u8], label: &str) -> Result<(), String> {
+    let Some(first) = destination.chunks_exact(4).next() else {
+        return Err(format!("{label}: empty XRGB destination"));
+    };
+    if !destination.chunks_exact(4).any(|pixel| pixel != first) {
+        return Err(format!("{label}: XRGB destination is wholly uniform"));
+    }
+    Ok(())
+}
+
+fn require_visible_destination(destination: &[u8], label: &str) -> Result<u64, String> {
+    require_nonuniform_destination(destination, label)?;
+    Ok(destination_checksum(destination))
+}
+
+fn run() -> Result<(), String> {
+    let mut frame = FrameBuilder::new((WIDTH, HEIGHT));
+    let mut bridge = VelloDrmBridge::new(WIDTH, HEIGHT).map_err(|error| error.to_string())?;
+    let pitch = usize::try_from(WIDTH)
+        .map_err(|_| "width overflow")?
+        .checked_mul(4)
+        .ok_or_else(|| "pitch overflow".to_owned())?;
+    let destination_len = pitch
+        .checked_mul(usize::try_from(HEIGHT).map_err(|_| "height overflow")?)
+        .ok_or_else(|| "destination overflow".to_owned())?;
+    let mut destination = vec![0_u8; destination_len];
+    let mut document = AutoCommit::new();
+    let mut focus = None;
+    let mut samples = Vec::with_capacity(SAMPLES);
+    let adapter = bridge.adapter_info().map_err(|error| error.to_string())?;
+    println!(
+        "main benchmark adapter: name={} backend={:?} device_type={:?} driver={}",
+        adapter.name, adapter.backend, adapter.device_type, adapter.driver
+    );
+    bridge
+        .paint_into_xrgb8888(&frame.paint(), &mut destination, pitch)
+        .map_err(|error| format!("initial desktop paint: {error}"))?;
+    // Check only until a distinct pixel is found before the timed animation sequence; a full
+    // 33-MB checksum here would perturb time-driven widget state relative to the branch run.
+    require_nonuniform_destination(&destination, "initial desktop")?;
+    for index in 0..SAMPLES {
+        let start = Instant::now();
+        click(
+            &mut frame,
+            TARGETS[index % TARGETS.len()],
+            &mut document,
+            &mut focus,
+        )?;
+        frame.relayout();
+        let scene = frame.paint();
+        bridge
+            .paint_into_xrgb8888(&scene, &mut destination, pitch)
+            .map_err(|error| format!("sample {index}: {error}"))?;
+        let elapsed_us = start.elapsed().as_micros();
+        samples.push(elapsed_us);
+    }
+    let summary = summarize(&mut samples)?;
+    let final_checksum = require_visible_destination(&destination, "timed desktop")?;
+    println!(
+        "main DRM render/readback {WIDTH}x{HEIGHT}: samples={SAMPLES} total_us={} mean={}us p99={}us min={}us max={}us",
+        summary.total_us, summary.mean_us, summary.p99_us, summary.min_us, summary.max_us
+    );
+    println!("main XRGB destination checksum after timed actions: {final_checksum:#018x}");
+    println!(
+        "main bridge limitation: no bump settlement/recovery telemetry; each paint is its production single submission plus bounded map waits"
+    );
+    println!("presentation: unavailable (no DRM/KMS page flip or scanout in this adapter)");
+    Ok(())
+}
+
+fn main() -> Result<(), String> {
+    run()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{SAMPLES, require_nonuniform_destination, summarize};
+
+    #[test]
+    fn benchmark_adapter_aggregation_uses_exact_nearest_rank_p99() {
+        let mut samples = vec![1_000; 989];
+        samples.push(30_000);
+        samples.extend(std::iter::repeat_n(50_000, 10));
+        let summary = summarize(&mut samples).expect("complete samples");
+        assert_eq!(summary.p99_us, 30_000);
+        assert_eq!(summary.min_us, 1_000);
+        assert_eq!(summary.max_us, 50_000);
+        assert_eq!(summary.total_us, 1_519_000);
+    }
+
+    #[test]
+    fn benchmark_adapter_rejects_missing_or_zero_samples() {
+        assert!(summarize(&mut []).is_err());
+        assert!(summarize(&mut vec![1; 999]).is_err());
+        assert!(summarize(&mut vec![0; SAMPLES]).is_err());
+    }
+
+    #[test]
+    fn benchmark_adapter_destination_sanity_rejects_uniform_pixels() {
+        assert!(require_nonuniform_destination(&[0, 0, 0, 255, 0, 0, 0, 255], "black").is_err());
+        assert!(require_nonuniform_destination(&[3, 4, 5, 255, 3, 4, 5, 255], "colored").is_err());
+        assert!(require_nonuniform_destination(&[0, 0, 0, 255, 1, 0, 0, 255], "visible").is_ok());
+    }
+}
