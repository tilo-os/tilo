[Unit]
Description=qOS collab-bridge (SDK Cap'n Proto <-> shell serde-JSON broker)
# NOT installed by the OS image, and must not be enabled alongside a
# qOS session: the compositor serves the Cap'n Proto schema natively
# and binds this same path itself, so both running means one of them
# takes the socket from the other and the apps of whichever lost are
# stranded. The bridge is for driving a shell that predates native
# capnp support, or for a standalone app outside a session.
After=graphical-session-pre.target
Conflicts=shell-portal.service

[Service]
Type=notify
ExecStart=/usr/libexec/qos-collab-bridge --listen %t/qos/services/collab.sock --upstream %t/qos-shell-collab.sock
Restart=on-failure

[Install]
WantedBy=default.target
