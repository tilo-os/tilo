# Schrittitel des Durchgangs zur Feedback-Prüfung, gebaut aus einem aufgezeichneten Schritt.
feedback-review-step-opened = Du hast { $app } geöffnet
feedback-review-step-invoked = Du hast { $action } gedrückt
feedback-review-step-refused = Du hast { $action } gedrückt; es wurde abgelehnt
feedback-review-step-failed = Du hast { $action } gedrückt; es ist fehlgeschlagen
feedback-review-step-edited = Du hast „{ $field }“ bearbeitet
feedback-review-step-appeared = „{ $label }“ erschien
