# Step titles of the feedback review walk-through, built from a recorded step.
feedback-review-step-opened = You opened { $app }
feedback-review-step-invoked = You pressed { $action }
feedback-review-step-refused = You pressed { $action }; it was refused
feedback-review-step-failed = You pressed { $action }; it failed
feedback-review-step-edited = You edited “{ $field }”
feedback-review-step-appeared = “{ $label }” appeared
