            "list": {
              "named": "AccountView"
            }
          },
          "readonly": true
        }
      ],
      "types": [
        {
          "name": "AccountView",
          "doc": "One account the workspace connected, without its secret.",
          "fields": [
            {
              "name": "id",
              "type": "text",
              "title": "The account's id, as every action names it."
            },
            {
              "name": "kind",
              "type": {
                "named": "AccountKind"
              },
              "title": "The kind of service it is."
            },
            {
              "name": "name",
              "type": "text",
              "title": "What its person calls it."
            },
            {
              "name": "address",
              "type": "text",
              "title": "The address or name it signs in at."
            },
            {
              "name": "username",
              "type": "text",
              "title": "The name it signs in with."
            },
            {
              "name": "provider",
              "type": "text",
              "title": "The provider it belongs to."
            },
            {
              "name": "status",
              "type": {
                "named": "AccountStatus"
              },
              "title": "How its last sync went."
            },
            {
              "name": "words",
              "type": "text",
              "title": "What a person reads about that, as its device said it."
            },
            {
              "name": "enabled",
              "type": "bool",
              "title": "Whether the account is in use."
            },
            {
              "name": "incoming",
              "type": "text",
              "title": "A mail account's incoming server as a person writes it."
            },
            {
              "name": "outgoing",
              "type": "text",
              "title": "Its outgoing server as a person writes it."
            },
            {
              "name": "identities",
              "type": {
                "list": "text"
              },
              "title": "The other addresses it sends as, each `Name <address>`."
            },
            {
              "name": "calendars",
              "type": {
                "list": {
                  "named": "CalendarView"
                }
              },
              "title": "A calendar account's calendars and which of them show."
            },
            {
              "name": "services",
              "type": {
                "named": "AccountServices"
              },
              "title": "Which of its services the account feeds."
            },
            {
              "name": "files_mode",
              "type": "text",
              "title": "A cloud-storage account's files: `sync` kept in sync, `import` copied into the workspace once."
            },
            {
              "name": "paused",
              "type": "bool",
              "title": "Whether its background sync and uploads are paused."
            }
          ]
        },
        {
          "name": "MailSignIn",
          "doc": "A login of the workspace's vault that belongs to a mail server.",
          "fields": [
            {
              "name": "id",
              "type": "text",
              "title": "Its reference, as adding an account from it names it."
            },
            {
              "name": "title",
              "type": "text",
              "title": "What Passwords shows it as."
            },
            {
              "name": "username",
              "type": "text",
              "title": "The name it signs in with."
            },
            {
              "name": "places",
              "type": {
                "list": "text"
              },
              "title": "The places it belongs to, each `imap://…`, `smtp://…` or a                              server's origin."
            },
            {
              "name": "account",
              "type": {
                "named": "SignedInAccount"
              },
              "title": "The workspace's account it signs in for, where it keeps one."
            }
          ]
        },
        {
          "name": "SignedInAccount",
          "doc": "An account of the workspace's that has a sign-in: where it signs in, never                      what it signs in with.",
          "fields": [
            {
              "name": "id",
              "type": "text",
              "title": "The account's id."
            },
            {
              "name": "kind",
              "type": "text",
              "title": "The kind of account it is."
            },
            {
              "name": "name",
              "type": "text",
              "title": "What its person calls it."
            },
            {
              "name": "address",
              "type": "text",
              "title": "The address or name it signs in at."
            },
            {
              "name": "server",
              "type": "text",
              "title": "The server it signs in to, empty where its settings name none."
            },
            {
              "name": "read_only",
              "type": "bool",
              "title": "Whether nothing is ever written to its server."
            },
            {
              "name": "enabled",
              "type": "bool",
              "title": "Whether the account is in use."
            }
          ]
        },
        {
          "name": "MailSignIns",
          "doc": "The logins the workspace's vault keeps.",
          "fields": [
            {
              "name": "sign_ins",
              "type": {
                "list": {
                  "named": "MailSignIn"
                }
              },
              "title": "Each by its reference, its name and the places it belongs to."
            }
          ]
        },
        {
          "name": "CalendarView",
          "doc": "One of a calendar account's calendars.",
          "fields": [
            {
              "name": "id",
              "type": "text",
              "title": "Its id, as its server keeps it and the selection names it."
            },
            {
              "name": "name",
              "type": "text",
              "title": "What its server calls it."
            },
            {
              "name": "visible",
              "type": "bool",
              "title": "Whether its events show in the calendar."
            },
            {
              "name": "read_only",
              "type": "bool",
              "title": "Whether its server lets this workspace change it."
            }
          ]
        },
        {
          "name": "AccountServices",
          "doc": "Which of one account's services its person uses.",
          "fields": [
            {
              "name": "mail",
              "type": "bool",
              "title": "Whether its mail shows in Mail."
            },
            {
              "name": "calendar",
              "type": "bool",
              "title": "Whether its calendars show in Calendar."
            },
            {
              "name": "files",
              "type": "bool",
              "title": "Whether its files mount in Files."
            }
          ]
        },
        {
          "name": "SignInStep",
          "doc": "Where a sign-in goes, and what it waits for.",
          "fields": [
            {
              "name": "id",
              "type": "text",
              "title": "The sign-in's id, as finishing or stopping it names it."
            },
            {
              "name": "open",
              "type": "text",
              "title": "The provider's page to open in the browser."
            },
            {
              "name": "code",
              "type": "text",
              "title": "What it waits for beyond the browser: a verification code, or the code a provider showed. Empty when it needs none."
            }
          ]
        },
        {
          "name": "AccountKind",
          "doc": "The kind of service an account is.",
          "cases": [
            {
              "name": "mail",
              "label": "Mail"
            },
            {
              "name": "calendar",
              "label": "Calendar"
            },
            {
              "name": "cloud",
              "label": "Cloud storage"
            },
            {
              "name": "other",
              "label": "Other"
            }
          ]
        },
        {
          "name": "AccountStatus",
          "doc": "How an account's last sync went, as its row says.",
          "cases": [
            {
              "name": "connected",
              "label": "Up to date"
            },
            {
              "name": "needs-reconnect",
              "label": "Sign-in required"
            },
            {
              "name": "error",
              "label": "Sync failed"
            },
            {
              "name": "waiting",
              "label": "Waiting for a connection"
            },
            {
              "name": "syncing",
              "label": "Syncing"
            },
            {
              "name": "never",
              "label": "Not synced yet"
            }
          ]
        }
      ]
    }
  ]
