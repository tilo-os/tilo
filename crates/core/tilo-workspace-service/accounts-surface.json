{
  "resources": [
    {
      "kind": "accounts",
      "label": "Connected accounts",
      "version": 1,
      "verbs": [
        {
          "id": "add-mail",
          "label": "Add a mail account",
          "kind": "undoable",
          "params": [
            {
              "name": "address",
              "required": true,
              "type": "text"
            },
            {
              "name": "displayName",
              "required": false,
              "type": "text"
            },
            {
              "name": "username",
              "required": false,
              "type": "text"
            },
            {
              "name": "incomingHost",
              "required": false,
              "type": "text"
            },
            {
              "name": "incomingPort",
              "required": false,
              "type": "int"
            },
            {
              "name": "outgoingHost",
              "required": false,
              "type": "text"
            },
            {
              "name": "outgoingPort",
              "required": false,
              "type": "int"
            },
            {
              "name": "password",
              "required": true,
              "type": "text"
            },
            {
              "name": "identities",
              "required": false,
              "type": {
                "list": "text"
              }
            }
          ]
        },
        {
          "id": "reconnect",
          "label": "Sign an account in again",
          "kind": "undoable",
          "params": [
            {
              "name": "account",
              "required": true,
              "type": "text"
            }
          ]
        },
        {
          "id": "remove",
          "label": "Remove an account",
          "kind": "undoable",
          "params": [
            {
              "name": "account",
              "required": true,
              "type": "text"
            }
          ]
        }
      ],
      "fields": [
        {
          "path": "accounts",
          "title": "The accounts the workspace connected, in the record's order.",
          "stored": "value",
          "type": {
            "list": {
              "named": "AccountView"
            }
          },
          "readonly": true
        }
      ],
      "types": [
        {
          "name": "AccountView",
          "doc": "One account the workspace connected, without its secret.",
          "fields": [
            {
              "name": "id",
              "type": "text",
              "title": "The account's id, as every action names it."
            },
            {
              "name": "kind",
              "type": {
                "named": "AccountKind"
              },
              "title": "The kind of service it is."
            },
            {
              "name": "name",
              "type": "text",
              "title": "What its person calls it."
            },
            {
              "name": "address",
              "type": "text",
              "title": "The address or name it signs in at."
            },
            {
              "name": "provider",
              "type": "text",
              "title": "The provider it belongs to."
            },
            {
              "name": "status",
              "type": {
                "named": "AccountStatus"
              },
              "title": "How its last sync went."
            },
            {
              "name": "words",
              "type": "text",
              "title": "What a person reads about that, as its device said it."
            },
            {
              "name": "enabled",
              "type": "bool",
              "title": "Whether the account is in use."
            }
          ]
        },
        {
          "name": "AccountKind",
          "doc": "The kind of service an account is.",
          "cases": [
            {
              "name": "mail",
              "label": "Mail"
            },
            {
              "name": "calendar",
              "label": "Calendar"
            },
            {
              "name": "cloud",
              "label": "Cloud storage"
            },
            {
              "name": "other",
              "label": "Other"
            }
          ]
        },
        {
          "name": "AccountStatus",
          "doc": "How an account's last sync went, as its row says.",
          "cases": [
            {
              "name": "connected",
              "label": "Up to date"
            },
            {
              "name": "needs-reconnect",
              "label": "Sign-in required"
            },
            {
              "name": "error",
              "label": "Sync failed"
            },
            {
              "name": "waiting",
              "label": "Waiting for a connection"
            },
            {
              "name": "syncing",
              "label": "Syncing"
            },
            {
              "name": "never",
              "label": "Not synced yet"
            }
          ]
        }
      ]
    }
  ]
}
