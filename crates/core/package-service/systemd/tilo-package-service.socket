[Unit]
Description=Tilo package service activation socket
PartOf=tilo-graphical-session.target

[Socket]
ListenStream=%t/tilo/services/package-service.sock
SocketMode=0600
DirectoryMode=0700
Backlog=16
RemoveOnStop=yes
Service=tilo-package-service.service

[Install]
WantedBy=tilo-graphical-session.target
