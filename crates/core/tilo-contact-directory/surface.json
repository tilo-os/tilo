        {
          "id": "project-contacts",
          "label": "Take over contacts",
          "description": "Project many Contacts identities as one change, each person's label and hints as [`Self::project_contact`], [`Self::project_phones`] and [`Self::project_emails`] would, so a large import costs one change instead of three per person.",
          "kind": "undoable",
          "params": [
            {
              "name": "people",
              "required": true,
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "person",
                    "label",
                    "phones",
                    "emails"
                  ],
                  "properties": {
                    "person": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "phones": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "emails": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "photo": {
                      "type": "string",
                      "description": "The content hash of the person's picture, or empty for none. The bytes are kept as the workspace's content, and a reading carries this reference, never a picture."
                    },
                    "photo_size": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "How many bytes that picture is; 0 for none."
                    }
                  },
                  "additionalProperties": false,
                  "description": "One Contacts identity as Contacts projects it."
                }
              },
              "type": {
                "list": {
                  "named": "Projected"
                }
              }
            },
            {
              "name": "removed",
              "required": true,
              "schema": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "list": "text"
              }
            }
          ]
        },
