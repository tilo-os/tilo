{
  "resources": [
    {
      "kind": "settings.agent-provider-setup",
      "label": "Agent provider setup",
      "version": 1,
      "verbs": [
        {
          "id": "add-provider",
          "label": "Add a provider",
          "description": "Add a provider from a known one, which fills its name, endpoint, protocol and key header; its key and model are set afterwards",
          "kind": "outside",
          "params": [
            {
              "name": "preset",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "remove-provider",
          "label": "Remove the provider",
          "description": "Remove a provider and its key",
          "kind": "outside",
          "destructive": true,
          "params": [
            {
              "name": "provider",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "set-provider-enabled",
          "label": "Offer the provider to agents",
          "description": "Offer a provider to agents, or stop offering it",
          "kind": "outside",
          "params": [
            {
              "name": "provider",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "on",
              "required": true,
              "schema": {
                "type": "boolean"
              },
              "type": "bool"
            }
          ]
        },
        {
          "id": "set-provider-details",
          "label": "Name the provider",
          "description": "Name a provider, where it answers, and the model agents use from it",
          "kind": "outside",
          "params": [
            {
              "name": "provider",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "label",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "endpoint",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "model",
              "required": false,
              "schema": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "option": "text"
              }
            }
          ]
        },
        {
          "id": "set-provider-protocol",
          "label": "Change the protocol",
          "description": "Speak another protocol to a provider",
          "kind": "outside",
          "params": [
            {
              "name": "provider",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "protocol",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "set-provider-model",
          "label": "Use this model",
          "description": "Make one model the one agents use from this provider",
          "kind": "outside",
          "params": [
            {
              "name": "provider",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "model",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "set-default-provider",
          "label": "Make it the default provider",
          "description": "Make a provider the one agents use unless told otherwise",
          "kind": "outside",
          "params": [
            {
              "name": "provider",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "set-key",
          "label": "Keep the API key",
          "description": "Keep a provider's API key in this device's vault",
          "kind": "outside",
          "params": [
            {
              "name": "provider",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "key",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "clear-key",
          "label": "Forget the API key",
          "description": "Forget a provider's API key",
          "kind": "outside",
          "destructive": true,
          "params": [
            {
              "name": "provider",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "refresh-providers",
          "label": "Read the providers again",
          "description": "Read the providers and their keys again, after another window or a script changed them",
          "kind": "read",
          "params": []
        }
      ],
      "fields": [
        {
          "path": "providers",
          "stored": "value",
          "type": {
            "list": {
              "named": "AgentProviderShown"
            }
          },
          "readonly": true
        },
        {
          "path": "default_provider",
          "stored": "value",
          "type": "text",
          "readonly": true
        },
        {
          "path": "presets",
          "stored": "value",
          "type": {
            "list": {
              "named": "AgentProviderPresetShown"
            }
          },
          "readonly": true
        }
      ],
      "types": [
        {
          "name": "AgentProviderModelShown",
          "doc": "One model a provider offers.",
          "fields": [
            {
              "name": "id",
              "type": "text"
            },
            {
              "name": "label",
              "type": "text"
            }
          ]
        },
        {
          "name": "AgentProviderPresetShown",
          "doc": "One provider the person can add.",
          "fields": [
            {
              "name": "slug",
              "type": "text"
            },
            {
              "name": "label",
              "type": "text"
            },
            {
              "name": "description",
              "type": "text"
            },
            {
              "name": "protocol",
              "type": "text"
            },
            {
              "name": "authentication",
              "type": "text"
            }
          ]
        },
        {
          "name": "AgentProviderShown",
          "doc": "One provider the person set up.",
          "fields": [
            {
              "name": "id",
              "type": "text"
            },
            {
              "name": "label",
              "type": "text"
            },
            {
              "name": "protocol",
              "type": "text"
            },
            {
              "name": "endpoint",
              "type": "text"
            },
            {
              "name": "location",
              "type": "text"
            },
            {
              "name": "enabled",
              "type": "bool"
            },
            {
              "name": "models",
              "type": {
                "list": {
                  "named": "AgentProviderModelShown"
                }
              }
            },
            {
              "name": "model",
              "type": "text"
            },
            {
              "name": "model_label",
              "type": "text"
            },
            {
              "name": "in_use",
              "type": "bool"
            },
            {
              "name": "authentication",
              "type": "text"
            },
            {
              "name": "key",
              "type": "text"
            },
            {
              "name": "sign_in",
              "type": "text"
            }
          ]
        }
      ]
    }
  ]
}