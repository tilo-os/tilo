{
  "resources": [
    {
      "kind": "settings.agent-models",
      "label": "Agent model",
      "version": 1,
      "verbs": [
        {
          "id": "use-model",
          "label": "Use model",
          "description": "Answer with this model: make its provider the one agents use, and the model the one they plan with",
          "kind": "outside",
          "params": [
            {
              "name": "provider",
              "required": true,
              "type": "text"
            },
            {
              "name": "model",
              "required": true,
              "type": "text"
            }
          ]
        },
        {
          "id": "undo-model",
          "label": "Take back the model choice",
          "description": "Take back the last choice of a model, on either provider section",
          "kind": "outside",
          "params": []
        },
        {
          "id": "redo-model",
          "label": "Choose the model again",
          "description": "Make the last choice of a model again",
          "kind": "outside",
          "params": []
        }
      ],
      "fields": [
        {
          "path": "providers",
          "stored": "value",
          "type": {
            "list": {
              "named": "AgentProviderShown"
            }
          },
          "readonly": true
        },
        {
          "path": "in_use",
          "stored": "value",
          "type": {
            "named": "AgentModelInUse"
          },
          "readonly": true
        }
      ],
      "types": [
        {
          "name": "AgentModelInUse",
          "doc": "The model agents answer with, as the switcher shows it.",
          "fields": [
            {
              "name": "provider",
              "type": "text"
            },
            {
              "name": "model",
              "type": "text"
            },
            {
              "name": "model_label",
              "type": "text"
            }
          ]
        },
        {
          "name": "AgentModelShown",
          "doc": "One model a provider offers.",
          "fields": [
            {
              "name": "id",
              "type": "text"
            },
            {
              "name": "label",
              "type": "text"
            }
          ]
        },
        {
          "name": "AgentProviderShown",
          "doc": "One provider the person set up, as a composer's switcher shows it.",
          "fields": [
            {
              "name": "id",
              "type": "text"
            },
            {
              "name": "label",
              "type": "text"
            },
            {
              "name": "enabled",
              "type": "bool"
            },
            {
              "name": "models",
              "type": {
                "list": {
                  "named": "AgentModelShown"
                }
              }
            },
            {
              "name": "model",
              "type": "text"
            },
            {
              "name": "model_label",
              "type": "text"
            }
          ]
        }
      ]
    }
  ]
}