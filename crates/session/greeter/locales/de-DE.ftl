# Der Anmeldebildschirm.

greeter-title = Bei Tilo anmelden
greeter-username = Benutzername
greeter-passcode = Passwort
greeter-sign-in = Anmelden
greeter-signing-in = Anmeldung läuft…
greeter-starting = Deine Sitzung wird gestartet…
greeter-use-fingerprint = Fingerabdruck verwenden
greeter-caps-lock = Feststelltaste ist aktiv
greeter-session = Sitzung
greeter-restart = Neu starten
greeter-shut-down = Ausschalten

# Etwas, das vor der Anmeldung im Formular fehlt.
greeter-hint-username = Gib deinen Benutzernamen ein.
greeter-hint-passcode = Gib dein Passwort ein.
greeter-hint-no-fingerprint = Für dieses Konto ist kein Fingerabdruck eingerichtet.

# Ein Anmeldeversuch, der nicht geklappt hat.
greeter-error-passcode = Falsches Passwort. Versuch es noch einmal.
greeter-error-credentials = Falscher Benutzername oder falsches Passwort. Versuch es noch einmal.
greeter-error-locked = Zu viele Fehlversuche. Warte ein paar Minuten und versuch es dann erneut.
greeter-error-account-expired = Dieses Konto ist abgelaufen. Bitte eine Administratorin oder einen Administrator, es zu verlängern.
greeter-error-passcode-expired = Dein Passwort ist abgelaufen. Bitte eine Administratorin oder einen Administrator, es zurückzusetzen.
greeter-error-not-permitted = Dieses Konto kann sich an diesem Computer nicht anmelden.
greeter-error-unavailable = Dein Passwort konnte nicht geprüft werden. Versuch es noch einmal.
greeter-error-session = Dein Desktop konnte nicht starten. Versuch es noch einmal oder starte den Computer neu.
greeter-error-service = Der Anmeldedienst antwortet nicht. Starte den Computer neu und versuch es dann erneut.
greeter-error-no-session = Es ist kein Desktop installiert, bei dem du dich anmelden kannst.
greeter-error-passcode-again = Falsches Passwort, { $count }-mal hintereinander. Versuch es noch einmal.

# Die Statusecke und die Bedienelemente des Bildschirms.
greeter-suspend = Bereitschaft
greeter-power = Ein/Aus
greeter-larger-text = Größere Schrift
greeter-high-contrast = Hoher Kontrast
greeter-screen-reader = Bildschirmleser
greeter-accounts = Konten auf diesem Computer

greeter-auth-response = Antwort zur Anmeldung
greeter-auth-respond = Anmeldeabfrage beantworten
greeter-auth-cancel = Anmeldung abbrechen
greeter-auth-cancelling = Anmeldung wird abgebrochen…
greeter-auth-cancelled = Anmeldung abgebrochen
