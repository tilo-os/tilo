# Was das Studio über ein Bildschirmfoto sagt, das an eines der anderen
# Geräte der Person unterwegs ist oder in die Dateien dieses Arbeitsbereichs
# geschrieben wird.
screenshot-send-saving = Wird in die Dateien dieses Arbeitsbereichs gespeichert…
screenshot-send-sending = Wird an { $device } gesendet…
screenshot-send-offered = { $device } angeboten; nimm es dort an, um es zu speichern
screenshot-send-saved = In den Dateien dieses Arbeitsbereichs als { $name } gespeichert
screenshot-send-sync-off = Die Gerätesynchronisierung läuft nicht
screenshot-send-offline = Dieses Gerät ist nicht mehr online
screenshot-send-gone = Das Bildschirmfoto { $path } ist nicht mehr da
screenshot-send-not-kept = Es gibt kein Bildschirmfoto zum Senden
screenshot-send-no-folder = { $path } liegt in keinem Ordner
screenshot-send-no-workspace = In dieser Sitzung ist kein Arbeitsbereich geöffnet
screenshot-send-no-file-name = { $path } hat keinen Dateinamen
screenshot-send-create-failed = { $path } kann nicht erstellt werden: { $error }
screenshot-send-save-failed = Speichern in den Dateien dieses Arbeitsbereichs nicht möglich: { $error }
screenshot-send-too-many = In { $path } ist jeder Name vergeben
screenshot-send-too-large = Ein Nearby-Versand trägt bis zu { $limit }; dieses Bildschirmfoto ist { $size } groß
screenshot-send-refused = Das Bildschirmfoto wurde nicht angeboten: { $reason }

# Why a capture the person took did not come out as they asked.
capture-failed-recording-not-started = Eine Aufnahme wurde nicht gestartet: { $why }
capture-failed-recording-stopped = Die Aufnahme wurde beendet: { $why }
capture-failed-replay-not-started = Die letzte halbe Minute konnte nicht behalten werden: { $why }
capture-failed-replay-stopped = Die letzte halbe Minute wird nicht mehr behalten: { $why }
capture-failed-sound-lost = Die Aufnahme enthält keinen weiteren Ton: ihre Quelle endete
capture-failed-not-taken = Ein Bildschirmfoto wurde nicht aufgenommen: { $why }
capture-failed-not-written = Das Bildschirmfoto konnte nicht gespeichert werden: { $why }
capture-failed-not-written-permission = Tilo darf nicht in { $folder } schreiben
capture-failed-not-written-no-room = in { $folder } ist kein Platz mehr frei
capture-failed-not-written-read-only = { $folder } ist schreibgeschützt
capture-failed-not-written-folder = es gibt keinen Ordner { $folder }
capture-failed-not-written-other = das System ließ Tilo nicht in { $folder } schreiben
capture-failed-not-copied = Ein Bildschirmfoto wurde gespeichert, aber nicht kopiert: { $why }
capture-failed-not-read = Ein Bildschirmfoto wurde nicht kopiert: { $why }
capture-failed-clip-not-saved = Ein Ausschnitt des gerade Geschehenen wurde nicht gespeichert: { $why }
capture-failed-not-opened = { $path } konnte nicht geöffnet werden: { $why }

