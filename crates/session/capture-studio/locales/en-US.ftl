# What the studio says of a screenshot on its way to one of the person's
# other devices, or into this workspace's files.
screenshot-send-saving = Saving to this workspace's files…
screenshot-send-sending = Sending to { $device }…
screenshot-send-offered = Offered to { $device }; accept it there to save
screenshot-send-saved = Saved to this workspace's files as { $name }
screenshot-send-sync-off = Device sync is not running
screenshot-send-offline = That device is no longer online
screenshot-send-gone = The screenshot { $path } is gone
screenshot-send-not-kept = There is no screenshot to send
screenshot-send-no-folder = { $path } has no folder
screenshot-send-no-workspace = This session has no workspace open
screenshot-send-no-file-name = { $path } has no file name
screenshot-send-create-failed = Cannot create { $path }: { $error }
screenshot-send-save-failed = Cannot save to this workspace's files: { $error }
screenshot-send-too-many = Every name in { $path } is taken
screenshot-send-too-large = A Nearby send carries up to { $limit }; this screenshot is { $size }
screenshot-send-refused = The screenshot was not offered: { $reason }
