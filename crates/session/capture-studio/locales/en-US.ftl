# What the studio says of a screenshot on its way to one of the person's
# other devices, or into this workspace's files.
screenshot-send-saving = Saving to this workspace's files…
screenshot-send-sending = Sending to { $device }…
screenshot-send-offered = Offered to { $device }; accept it there to save
screenshot-send-saved = Saved to this workspace's files as { $name }
screenshot-send-sync-off = Device sync is not running
screenshot-send-offline = That device is no longer online
screenshot-send-gone = The screenshot { $path } is gone
screenshot-send-not-kept = There is no screenshot to send
screenshot-send-no-folder = { $path } has no folder
screenshot-send-no-workspace = This session has no workspace open
screenshot-send-no-file-name = { $path } has no file name
screenshot-send-create-failed = Cannot create { $path }: { $error }
screenshot-send-save-failed = Cannot save to this workspace's files: { $error }
screenshot-send-too-many = Every name in { $path } is taken
screenshot-send-too-large = A Nearby send carries up to { $limit }; this screenshot is { $size }
screenshot-send-refused = The screenshot was not offered: { $reason }

# Why a capture the person took did not come out as they asked.
capture-failed-recording-not-started = A recording was not started: { $why }
capture-failed-recording-stopped = The recording stopped: { $why }
capture-failed-replay-not-started = The last half minute could not be kept: { $why }
capture-failed-replay-stopped = The last half minute is not kept any more: { $why }
capture-failed-sound-lost = The recording carries no more sound: its source stopped
capture-failed-not-taken = A screenshot was not taken: { $why }
capture-failed-not-written = Couldn't save the screenshot: { $why }
capture-failed-not-written-permission = Tilo can't write to { $folder }
capture-failed-not-written-no-room = there's no room left in { $folder }
capture-failed-not-written-read-only = { $folder } is read-only
capture-failed-not-written-folder = there's no folder at { $folder }
capture-failed-not-written-other = the system wouldn't let Tilo write to { $folder }
capture-failed-not-copied = A screenshot was saved, but not copied: { $why }
capture-failed-not-read = A screenshot was not copied: { $why }
capture-failed-clip-not-saved = A clip of what just happened was not saved: { $why }
capture-failed-not-opened = { $path } could not be opened: { $why }

