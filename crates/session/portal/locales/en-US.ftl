# What the portal calls an app's request in the person's language.
notification-open = Open

## What the window names
portal-resource = Portal

## Actions

so-tilo-portal-autostart-remove = Stop the app starting at login
so-tilo-portal-capture-stop = Stop capturing
so-tilo-portal-shortcut-activate = Press the app's shortcut
so-tilo-portal-shortcut-deactivate = Release the app's shortcut
so-tilo-portal-shortcut-unbind = Unbind the app's shortcut
so-tilo-portal-inhibition-end = End the app's hold
so-tilo-portal-consent-forget = Forget what the app was allowed
so-tilo-portal-remote-control-end = Stop the app controlling this computer
so-tilo-portal-restore-forget = Forget the remembered share
