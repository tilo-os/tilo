 <office:body>
  <office:text>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Structure</text:h>
   <text:p text:style-name="Standard">An intro paragraph with a <text:span text:style-name="Keyword">keyword</text:span>, a <text:a xlink:type="simple" xlink:href="https://example.org/tilo">web link</text:a> and a <text:bookmark-start text:name="intro_mark"/>bookmarked phrase<text:bookmark-end text:name="intro_mark"/>.</text:p>
   <text:p text:style-name="Callout">A paragraph in the custom Callout style.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">Lists</text:h>
   <text:list text:style-name="Numbering_20_123">
    <text:list-item><text:p>First numbered</text:p>
     <text:list>
      <text:list-item><text:p>Nested a</text:p></text:list-item>
      <text:list-item><text:p>Nested b</text:p></text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item><text:p>Second numbered</text:p></text:list-item>
   </text:list>
   <text:list text:style-name="List_20_1">
    <text:list-item><text:p>Bullet one</text:p>
     <text:list>
      <text:list-item><text:p>Sub bullet</text:p></text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item><text:p>Bullet two</text:p></text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">Table</text:h>
   <table:table table:name="Merged">
    <table:table-column table:number-columns-repeated="3"/>
    <table:table-row>
     <table:table-cell table:number-columns-spanned="2" office:value-type="string"><text:p>Wide header</text:p></table:table-cell>
     <table:covered-table-cell/>
     <table:table-cell office:value-type="string"><text:p>C</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:number-rows-spanned="2" office:value-type="string"><text:p>Tall</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>b2</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>c2</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:covered-table-cell/>
     <table:table-cell office:value-type="string"><text:p>b3</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>c3</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:section text:style-name="Sect1" text:name="TwoColumns">
    <text:p text:style-name="Standard">Column text one. Column text one. Column text one.</text:p>
    <text:p text:style-name="Standard">Column text two. Column text two. Column text two.</text:p>
   </text:section>
   <text:p text:style-name="PBreak">After a page break.</text:p>
   <text:p text:style-name="Standard">Last paragraph.</text:p>
