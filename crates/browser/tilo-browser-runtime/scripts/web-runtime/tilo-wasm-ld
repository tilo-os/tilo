#!/usr/bin/env bash
# rustc's linker for the web core: wasm-ld, with the rlibs of the crates named
# in TILO_WEB_WHOLE_CRATES replaced by all of their objects, so the toolkit is
# in the core whole rather than only what the core itself calls.
#
# With TILO_WEB_LINK_STASH set, it also keeps what the link read there
# (objects rustc deletes afterwards, the toolkit objects, and the arguments
# minus --export-all and -o) so build-web-core.sh can relink the core with an
# explicit export list: the toolkit's surface plus what the app collection
# imports, instead of every symbol of every object.
set -euo pipefail
whole=" ${TILO_WEB_WHOLE_CRATES:-} "
stash=${TILO_WEB_LINK_STASH:-}
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
inputs=()
for arg in "$@"; do
  # rustc falls back to a response file for a long command line.
  if [[ "$arg" == @* ]]; then mapfile -t -O "${#inputs[@]}" inputs <"${arg#@}"; else inputs+=("$arg"); fi
done
if [[ -n "$stash" ]]; then rm -rf "$stash"; mkdir -p "$stash/inputs" "$stash/whole"; fi
args=() kept=() index=0 skip_output=0
for arg in "${inputs[@]}"; do
  if ((skip_output)); then skip_output=0; args+=("$arg"); continue; fi
  file=${arg##*/}
  crate=${file#lib}
  crate=${crate%-*.rlib}
  if [[ "$arg" == -o ]]; then
    skip_output=1; args+=("$arg"); continue
  elif [[ "$file" == lib*-*.rlib && "$whole" == *" $crate "* ]]; then
    dir="$scratch/$crate"
    [[ -n "$stash" ]] && dir="$stash/whole/$crate"
    mkdir -p "$dir"
    (cd "$dir" && ar x "$arg")
    rm -f "$dir/lib.rmeta"
    args+=("$dir"/*.o)
    kept+=("$dir"/*.o)
  elif [[ -n "$stash" && "$arg" != -* && "$arg" != *.rlib && -f "$arg" ]]; then
    copy="$stash/inputs/$index-$file"
    index=$((index + 1))
    cp "$arg" "$copy"
    args+=("$arg")
    kept+=("$copy")
  else
    args+=("$arg")
    [[ "$arg" == --export-all ]] || kept+=("$arg")
  fi
done
[[ -n "$stash" ]] && printf '%s\n' "${kept[@]}" >"$stash/args"
"${WASM_LD:-wasm-ld}" "${args[@]}"
