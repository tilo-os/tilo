# syntax=docker/dockerfile:1.7

# Keep the compiler and runtime roots immutable. The workflow also selects one
# platform explicitly, so a future upstream manifest change cannot alter these
# bytes or silently turn this into a multi-architecture release.
FROM docker.io/library/rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS builder

# The same pinned sccache client as the OS image, from the workflow's
# checksum-verified asset context. The runner's Actions cache URL and job token
# reach only the compile RUN, as BuildKit secrets.
ARG SCCACHE_VERSION=0.17.0
ARG SCCACHE_SHA256_X86_64=67c4a96dd237c1f518f6b36083f270f9976d516f1e57fce891755ea782e50006
RUN --mount=type=bind,from=github-assets,source=/,target=/tilo-assets,ro \
    test "$(uname -m)" = x86_64 \
    && name="sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl" \
    && echo "${SCCACHE_SHA256_X86_64}  /tilo-assets/${name}.tar.gz" | sha256sum -c - \
    && tar -xzf "/tilo-assets/${name}.tar.gz" -C /tmp \
    && install -m 0755 "/tmp/${name}/sccache" /usr/local/bin/sccache \
    && rm -rf "/tmp/${name}"

ENV CARGO_INCREMENTAL=0 \
    SCCACHE_IGNORE_SERVER_IO_ERROR=0 \
    SCCACHE_IDLE_TIMEOUT=0 \
    RUSTC_WRAPPER=/usr/local/bin/sccache

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    --mount=type=secret,id=actions_cache_url,required=false \
    --mount=type=secret,id=actions_runtime_token,required=false \
    if [ -s /run/secrets/actions_cache_url ] && [ -s /run/secrets/actions_runtime_token ]; then \
      export ACTIONS_CACHE_URL="$(cat /run/secrets/actions_cache_url)"; \
      export ACTIONS_RUNTIME_TOKEN="$(cat /run/secrets/actions_runtime_token)"; \
      export SCCACHE_GHA_ENABLED=on SCCACHE_GHA_VERSION=tilo-registry-server-v1; \
      sccache --start-server; \
    else \
      unset RUSTC_WRAPPER; \
    fi \
    && cargo build --locked --release -p registry-server --bin tilo-registry-server \
    && if [ -n "${RUSTC_WRAPPER:-}" ]; then sccache --show-stats; fi \
    && install -D -m 0755 target/release/tilo-registry-server /out/tilo-registry-server \
    && install -d -m 0750 -o 65532 -g 65532 /out/state

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f AS runtime

# No revision label: one build serves every commit with the same inputs, so the digest receipt
# the publication writes names the commit, not the image.
LABEL org.opencontainers.image.title="Tilo app registry server" \
      org.opencontainers.image.description="Signed Tilo application catalogue and moderation service" \
      org.opencontainers.image.source="https://code.tilo.so/tilo/tilo"

COPY --from=builder --chown=65532:65532 /out/tilo-registry-server /usr/local/bin/tilo-registry-server
# rustls-native-certs is intentionally patched to Tilo's single immutable
# trust path. Populate that path explicitly instead of depending on the
# runtime base image's distro-specific certificate layout.
COPY --from=builder --chown=65532:65532 /etc/ssl/certs/ca-certificates.crt /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
COPY --from=builder --chown=65532:65532 /out/state/ /var/lib/tilo-registry/

USER 65532:65532
EXPOSE 8443

ENTRYPOINT ["/usr/local/bin/tilo-registry-server"]
CMD ["--data-dir", "/var/lib/tilo-registry", "serve", "--bind", "0.0.0.0", "--port", "8443"]
