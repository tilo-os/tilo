[Unit]
Description=Tilo app host (verified package store and launch broker)
After=tilo-graphical-session.target
PartOf=tilo-graphical-session.target

[Service]
Type=notify
# The package store is the one the launcher, the shell and tilo-install
# read and write; the daemon keeps no store of its own. Packages the daemon
# once kept in its own state directory move into it at startup.
ExecStartPre=+/usr/bin/mkdir -p %h/.local/share/tilo-apps
ExecStart=/usr/libexec/tilo-app-host --socket %t/tilo/services/app-host.sock --store %h/.local/share/tilo-apps
Restart=on-failure
RestartSec=1
RuntimeDirectory=tilo/services
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=tilo-app-host
StateDirectoryMode=0700
ReadWritePaths=%S/tilo-app-host %h/.local/share/tilo-apps
