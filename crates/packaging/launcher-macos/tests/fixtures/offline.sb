(version 1)
(deny default)
(import "system.sb")
(system-graphics)
(allow process-fork)
(allow signal (target same-sandbox))
(allow system-socket (socket-domain AF_UNIX))
(allow ipc-posix-shm-read* ipc-posix-shm-write-create ipc-posix-shm-write-data
  (ipc-posix-name "com.apple.AppleDatabaseChanged"))
(allow mach-lookup
  (global-name "com.apple.windowserver.active")
  (global-name "com.apple.windowmanager.server")
  (global-name "com.apple.window_proxies")
  (global-name "com.apple.dock.server")
  (global-name "com.apple.dock.fullscreen")
  (global-name "com.apple.CoreServices.coreservicesd")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.lsd.mapdb")
  (global-name "com.apple.pasteboard.1")
  (global-name "com.apple.tsm.uiserver")
  (global-name "com.apple.inputmethodkit.getxpcendpoint")
  (global-name "com.apple.inputmethodkit.launchagent")
  (global-name "com.apple.inputmethodkit.launcher")
  (global-name "com.apple.inputmethodkit.setxpcendpoint")
  (global-name "com.apple.iohideventsystem")
  (global-name "com.apple.backboard.hid-services.xpc")
  (global-name "com.apple.FontObjectsServer")
  (global-name "com.apple.fonts")
  (global-name "com.apple.iconservices")
  (global-name "com.apple.iconservices.store")
  (global-name "com.apple.distributed_notifications@Uv3"))
(allow user-preference-read
  (preference-domain "kCFPreferencesAnyApplication")
  (preference-domain "com.apple.AppKit")
  (preference-domain "com.apple.HIToolbox")
  (preference-domain "com.apple.Accessibility")
  (preference-domain "com.apple.universalaccess")
  (preference-domain "com.apple.ATS")
  (preference-domain "com.apple.CoreGraphics")
  (preference-domain "com.apple.inputmethodkit"))
(allow file-read*
  (subpath "/Library/Fonts")
  (literal "/Library/Preferences/com.apple.ViewBridge.plist"))
(allow file-read* file-map-executable process-exec (subpath (param "PAYLOAD_DIR")))
(allow file-read* file-map-executable (subpath (param "RUNTIME_DIR")))
(allow file-read* file-write* (subpath (param "CONTAINER_DIR")))
(allow file-read* file-write* (subpath (param "DARWIN_CACHE_DIR")))
(allow file-read* (subpath (param "READ_0")))
(allow file-read* file-write* (subpath (param "WRITE_0")))
(allow file-read* file-write* (extension "com.apple.app-sandbox.read-write"))
(allow file-read-metadata (path-ancestors (param "PAYLOAD_DIR")))
(allow file-read-metadata (path-ancestors (param "RUNTIME_DIR")))
(allow file-read-metadata (path-ancestors (param "CONTAINER_DIR")))
(allow file-read-metadata (path-ancestors (param "DARWIN_CACHE_DIR")))
(allow file-read-metadata (path-ancestors (param "READ_0")))
(allow file-read-metadata (path-ancestors (param "WRITE_0")))
(deny file-read* file-write*
  (subpath (param "HIDDEN_0")))
(deny file-write*
  (literal (param "PINNED_0"))
  (literal (param "PINNED_1"))
  (literal (param "PINNED_2")))
(deny file-write*
  (subpath (param "PAYLOAD_DIR"))
  (subpath (param "RUNTIME_DIR")))
