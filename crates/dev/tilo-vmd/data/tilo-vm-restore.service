[Unit]
Description=Bring tilo-vm slots back after boot
# vkms seats need configfs and udev; slot sessions need logind.
After=systemd-logind.service systemd-udevd.service sys-kernel-config.mount systemd-user-sessions.service
Wants=systemd-logind.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo/tilo-vmd restore
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
