[Unit]
Description=Record the booted OS image for tilo-vm
# Records the booted image and names the slots that keep layers built on the
# image before, for tilo-vm status. It never changes a slot or deletes a layer:
# those are the person's deployed work, rolled back or forward deliberately.
# Nothing here may order this after systemd-tmpfiles-setup (sysext precedes
# it): no PrivateTmp, no other sandboxing that pulls in tmpfiles.
DefaultDependencies=no
After=local-fs.target
Before=systemd-sysext.service sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tilo/tilo-vmd reconcile-image

[Install]
WantedBy=sysinit.target
