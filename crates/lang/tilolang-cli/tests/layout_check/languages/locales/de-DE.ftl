# German for the words the sample shows in it. One message is left out on purpose: a window
# that reads German must not show the English one beside them (`tilolang layout-check`).

d-hjuxbfqp = Muster
    .doc = Ein Muster, dessen Wörter in zwei Sprachen ausgeliefert werden, eine davon ohne eine Meldung, für die Prüfung, dass ein Fenster durchgehend eine Sprache liest (`tilolang layout-check --locale`).
    .noun = { $count ->
        [one] Muster
       *[other] Muster
    }

d-urkaowcy = Name

d-gebschzi = Muster
    .w-a-translated-word = Ein übersetztes Wort
