# Multi-stage build for qos-relay.
#
# `podman build -t qos-relay:latest -f qos-relay/deploy/Containerfile .`
# from the workspace root. (Build context = workspace because the
# crate is a workspace member.)
#
# Run:
#   podman run -d --rm \
#     -p 4001:4001/tcp -p 4001:4001/udp \
#     -v qos-relay-state:/var/lib/qos-relay \
#     qos-relay:latest
#
# Bind-mount a config:
#   podman run ... \
#     -v ./qos-relay/example-config.toml:/etc/qos-relay/config.toml:ro \
#     qos-relay:latest --config /etc/qos-relay/config.toml

FROM rust:1.96 AS build
WORKDIR /src
COPY . .
# Build only the relay; the rest of the workspace is along for the ride.
RUN cargo build -p qos-relay --release \
    && strip target/release/qos-relay

FROM debian:12-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1000 --create-home --home-dir /var/lib/qos-relay qos-relay \
    && mkdir -p /etc/qos-relay \
    && chown -R qos-relay:qos-relay /var/lib/qos-relay /etc/qos-relay

COPY --from=build /src/target/release/qos-relay /usr/local/bin/qos-relay
COPY qos-relay/example-config.toml /etc/qos-relay/config.toml.example

EXPOSE 4001/tcp 4001/udp
USER qos-relay
VOLUME ["/var/lib/qos-relay"]
WORKDIR /var/lib/qos-relay

ENTRYPOINT ["/usr/local/bin/qos-relay"]
CMD []
