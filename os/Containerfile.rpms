# syntax=docker/dockerfile:1.7
# ============================================================================
# Frozen RPM repo snapshot — published by CI (.forgejo/workflows/
# snapshot-rpms.yml), or built locally for unpublished preparation. Resolves the exact install transaction
# against the digest-pinned base and packages it as a tiny FROM-scratch OCI
# image. os/Containerfile then installs ONLY from this (pinned by digest), so
# the OS image is reproducible across time regardless of upstream package
# movement. Re-dispatch the workflow to re-snapshot when bumping packages/base.
#
# BASE_REF is the same mirrored, digest-pinned base every other image builds
# FROM (os/base-snapshot.env) — the package set has to be resolved against the
# base it will be installed on.
# ============================================================================
ARG BASE_REF
FROM scratch AS external-assets
COPY --from=github-assets / /

FROM ${BASE_REF} AS configured-base

# Snapshot creation must not inherit a randomly selected, stale mirror and then
# retry every RPM serially. Use a current Fedora HTTPS mirror and bounded
# parallelism; RPM signatures still provide the package authenticity check.
RUN sed -i \
      -e 's|^#baseurl=http://download.example/pub/fedora/linux/releases/|baseurl=https://ftp.fau.de/fedora/linux/releases/|' \
      -e '/^metalink=.*repo=fedora-/s/^/#/' \
      /etc/yum.repos.d/fedora.repo \
 && sed -i \
      -e 's|^#baseurl=http://download.example/pub/fedora/linux/updates/|baseurl=https://ftp.fau.de/fedora/linux/updates/|' \
      -e 's|/Everything/SRPMS/|/Everything/source/tree/|' \
      -e '/^metalink=.*repo=updates-/s/^/#/' \
      /etc/yum.repos.d/fedora-updates.repo \
 && printf '[main]\nmax_parallel_downloads=20\n' > /etc/dnf/dnf.conf

# Tilo never distributes Cisco's OpenH264 binary: Cisco's patent licence covers
# only binaries the user downloads from Cisco. With the base's
# fedora-cisco-openh264 repository enabled, its `openh264` (which obsoletes
# Fedora's `noopenh264` stub) satisfies libopenh264.so.8 for libavcodec-free,
# libheif and freerdp-libs and so would enter every image. Without it the stub
# does; Cisco's build reaches a device only through the media-codecs extension.
RUN rm -f /etc/yum.repos.d/fedora-cisco-openh264.repo

# Repository tooling must never change the RPM database used for resolution.
FROM configured-base AS metadata-tools
RUN dnf install -y createrepo_c dnf5-plugins \
 && dnf clean packages

# Fedora's virtio-win project currently publishes this RPM unsigned. Treating
# its moving `stable` repository as trusted would therefore be dishonest: fetch
# the reviewed version through the shared external-input cache, whose manifest
# pins its SHA-256, and expose only that exact byte sequence as a local repo.
FROM metadata-tools AS vendor-repo
COPY os/external-assets/github-assets.tsv /tilo-assets.tsv
RUN --mount=type=bind,from=external-assets,source=/,target=/tilo-assets,ro \
    awk -F '\t' '$2 == "virtio-win-0.1.302-1.noarch.rpm" { print $1 "  /tilo-assets/" $2; n++ } END { if (n != 1) exit 1 }' \
      /tilo-assets.tsv > /virtio.sha256 \
 && sha256sum --check --strict /virtio.sha256 \
 && install -D -m 0644 /tilo-assets/virtio-win-0.1.302-1.noarch.rpm \
      /vendor/virtio-win-0.1.302-1.noarch.rpm \
 && createrepo_c --quiet /vendor

FROM configured-base AS resolve
COPY --from=vendor-repo /vendor /vendor
RUN printf '[virtio-win-pinned]\nname=Pinned virtio-win 0.1.302-1\nbaseurl=file:///vendor\ngpgcheck=0\nenabled=1\n' \
      > /etc/yum.repos.d/virtio-win-pinned.repo

# The exact package set the OS image installs (passed by the workflow, derived
# from os/Containerfile's dnf-install blocks — single source of truth).
ARG PACKAGES
ARG TARGETARCH

# Resolve the install transaction against the base (captures rich/
# conditional deps like greetd-selinux and the exact non-conflicting versions),
# store its exact solver transaction, then collect its RPMs into a repo.
# Preserve the full weak-dependency closure; unavailable packages must fail.
#
# --downloadonly skips packages the base already has installed. The later OS
# transaction can update a package that requires the matching version of an
# already-installed dependency (for example glibc-common or python3-libs), or
# reinstall a direct spec erased by an intermediate stage (pkgconf). Download
# the complete dependency closure, including already-installed packages.
# Upgrading a base-installed direct spec can also require upgrading a package
# outside that forward closure (openssh-clients pins the openssh version). Store
# that solver transaction and add its RPMs before the offline proof.
# After creating the repo, prove it resolves the complete requested transaction
# (including dependencies) with every network repository hidden.
RUN test -n "${PACKAGES}" \
 && dnf install -y --best --store=/tmp/tilo-install --exclude='qemu-user-static*' --setopt=install_weak_deps=True ${PACKAGES} \
 && mkdir -p /repo \
 && if test -d /tmp/tilo-install/packages; then cp -n /tmp/tilo-install/packages/*.rpm /repo/; fi \
 && dnf download -y --resolve --alldeps --destdir=/repo --exclude='qemu-user-static*' ${PACKAGES} \
 && installed_specs="$(for spec in ${PACKAGES}; do rpm -q --quiet "$spec" && printf '%s\n' "$spec"; done)" \
 && if test -n "$installed_specs"; then \
      dnf upgrade -y --best --store=/tmp/tilo-upgrade --exclude='qemu-user-static*' --setopt=install_weak_deps=True $installed_specs \
      && if test -d /tmp/tilo-upgrade/packages; then cp -n /tmp/tilo-upgrade/packages/*.rpm /repo/; fi; \
    fi \
 && cp /vendor/virtio-win-0.1.302-1.noarch.rpm /repo/ \
 && test -n "$(ls /repo/*.rpm 2>/dev/null)" \
 && printf '%s\n' ${PACKAGES} | sort -u > /repo/tilo-direct-package-specs.txt

FROM metadata-tools AS repository
COPY --from=resolve /repo /repo
COPY os/dev/verify-rpm-snapshot-signatures.sh /tilo-verify-signatures.sh
COPY os/scripts/verify-no-cisco-openh264.sh /tilo-verify-no-cisco-openh264.sh
COPY os/external-assets/github-assets.tsv /tilo-assets.tsv
COPY --from=configured-base /etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary /tilo-fedora44-primary.key
RUN bash /tilo-verify-no-cisco-openh264.sh --repo /repo \
 && bash /tilo-verify-signatures.sh /repo /tilo-assets.tsv /tilo-fedora44-primary.key > /repo/tilo-rpm-signatures.txt \
 && sha256sum /repo/*.rpm > /repo/tilo-rpm-sha256.txt \
 && createrepo_c --quiet /repo \
 && printf '[frozen]\nname=Tilo frozen package snapshot\nbaseurl=file:///repo\ngpgcheck=0\nenabled=1\n' > /repo/frozen.repo \
 && rpm -qa --qf '%{NAME}\t%{VERSION}\t%{RELEASE}\t%{ARCH}\n' | sort > /repo/tilo-metadata-tools.txt
# The newest build of every package must resolve its dependencies from this
# repository alone. A mirror caught mid-sync serves an update without the
# subpackages it pins exactly (glibc without its matching glibc-common); the
# offline install below can still pass by keeping the base's older copies,
# while an image stage that upgrades then fails. Refuse that snapshot here,
# before it is pushed or signed, so a later run takes a consistent mirror.
# Superseded builds that the transactions also stored are never chosen over
# the newest, so only the newest build of each package has to be closed.
# Multilib (i686) builds enter only as dependencies of native ones, and their
# conditional cross-architecture requirements are over-approximated here, so
# the check covers native and noarch builds.
RUN --network=none dnf repoclosure --newest --arch="$(uname -m),noarch" --setopt=reposdir=/repo --repo frozen

# Prove closure on the ORIGINAL base, not the createrepo tooling environment.
# The final COPY depends on this stage, so an optimizer cannot prune the check.
FROM ${BASE_REF} AS offline-check
ARG PACKAGES
COPY --from=repository /repo /repo
RUN --network=none dnf install -y --best --downloadonly --setopt=reposdir=/repo --setopt=install_weak_deps=True ${PACKAGES}
# os/Containerfile erases these base-installed packages once the compositor's
# development specs resolve, and later stages (Wine's mingw64-libxslt) need them
# again. Replay the same erase and prove the complete package set still
# resolves offline, so the snapshot carries every package the image removes
# together with its dependencies. The erase list must match os/Containerfile's.
RUN --network=none rpm -qa --qf '%{NAME}\n' \
      | awk '/^(pkgconf-pkg-config|pkgconf|pkgconf-m4|libpkgconf)$/' \
      | xargs -r rpm -e --nodeps \
 && ! rpm -qa --qf '%{NAME}\n' | grep -Eq '^(pkgconf-pkg-config|pkgconf|pkgconf-m4|libpkgconf)$' \
 && dnf install -y --best --downloadonly --setopt=reposdir=/repo --setopt=install_weak_deps=True ${PACKAGES}

# Sort the checked repository into content-stable slots, one image layer each
# (os/dev/layer-rpm-snapshot.py): a package's slot depends only on its name and
# size class, and every file's mode and time are normalized, so a refresh that
# updates a few packages changes only their slots' layers. Everyone who pulls
# the snapshot, CI and local builds alike, then re-downloads those, not 2.3 GB.
# Derived from offline-check, so the published files are the checked ones.
FROM metadata-tools AS layers
COPY --from=offline-check /repo /repo
COPY os/dev/layer-rpm-snapshot.py /tilo-layer-rpm-snapshot.py
RUN --network=none python3 /tilo-layer-rpm-snapshot.py /repo /slots

# The published artifact contains only the repository, overlaid from its slots
# back into the one /repo it always was. The slot list is
# layer-rpm-snapshot.py's slot_names(); os/tests/test_rpm_snapshot_boundaries.py
# holds the two to each other.
FROM scratch
COPY --from=layers /slots/big/00/ /
COPY --from=layers /slots/big/01/ /
COPY --from=layers /slots/big/02/ /
COPY --from=layers /slots/big/03/ /
COPY --from=layers /slots/big/04/ /
COPY --from=layers /slots/big/05/ /
