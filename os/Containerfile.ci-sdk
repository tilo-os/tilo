# The SDKs' test suites need their ecosystems' own tools, which no other CI image carries:
# uv, with the Python SDK's environment synced from sdk/python/uv.lock, and bun, with the
# TypeScript SDK's packages in its install cache from sdk/typescript/bun.lock. Both are baked
# in, so the suites run without network.
#
# The image is x86_64 only, like the ci-fast image it builds on. The checks that run in it
# (sdk-python, sdk-typescript) ask for that architecture.
#
# Built by t's image-ci-sdk check, from a context holding the two SDKs' manifests and lock
# files. It is not published: the checks that run in
# it are its consumers, so they always run in an image built from the tree's own locks. Keep
# the base on the pinned ci-fast image: the toolchain, python3 and the shell tools the checks
# use come from it.
ARG CI_FAST_IMAGE=registry.tilo.so/tilo/ci-fast@sha256:4974765531ae306e2c33265f0d7d33624c09579279dbf7ed0d519ca5ed0efa89
FROM ${CI_FAST_IMAGE}

# Release tarballs, pinned by version and checksum. A floating uv or bun would change which
# tools a suite runs with without a commit saying so, and an upstream release is not a change
# to this repository.
ARG UV_VERSION=0.13.7
ARG UV_SHA256=c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83
# bun's baseline build: it runs without AVX2, so a runner whose CPU lacks it still tests.
ARG BUN_VERSION=1.4.4
ARG BUN_BASELINE_SHA256=e0446eb55995772eb9894bebae9a6be368d985a8b9271ee124486f9946eedd76

RUN set -euo pipefail \
    && curl -sSfL -o /tmp/uv.tar.gz \
         "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
    && printf '%s  %s\n' "${UV_SHA256}" /tmp/uv.tar.gz | sha256sum -c - \
    && tar -xzf /tmp/uv.tar.gz --strip-components=1 -C /usr/local/bin uv-x86_64-unknown-linux-gnu/uv \
    && rm -f /tmp/uv.tar.gz \
    && uv --version

# bun's archive is a zip, unpacked by the base's python3 rather than by unzip: an `unzip` from
# one of Fedora's repositories is the newest build it holds, so installing it here would make the
# image's content move under an unchanged tree (t.toml, image-ci-sdk).
RUN set -euo pipefail \
    && curl -sSfL -o /tmp/bun.zip \
         "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64-baseline.zip" \
    && printf '%s  %s\n' "${BUN_BASELINE_SHA256}" /tmp/bun.zip | sha256sum -c - \
    && python3 -m zipfile -e /tmp/bun.zip /tmp/bun \
    && install -m 0755 /tmp/bun/bun-linux-x64-baseline/bun /usr/local/bin/bun \
    && ln -sf bun /usr/local/bin/bunx \
    && rm -rf /tmp/bun.zip /tmp/bun \
    && bun --version

# Where the checks find the two tools' state: uv's cache and the environment it syncs
# sdk/python into, bun's install cache. A job runs in this image read-only, so the checks copy
# the environment and the cache before uv installs the tree's project into it.
ENV UV_CACHE_DIR=/opt/tilo-sdk/uv-cache \
    UV_PROJECT_ENVIRONMENT=/opt/tilo-sdk/python-venv \
    UV_PYTHON_DOWNLOADS=never \
    BUN_INSTALL_CACHE_DIR=/opt/tilo-sdk/bun-cache

# The Python SDK's environment, from its lock: its dependencies, not the SDK itself, which the
# checks import from the tree's sdk/python/src (uv never builds the project, whose wheel
# compiles the SDK's native part).
COPY sdk/python/pyproject.toml sdk/python/uv.lock /opt/tilo-sdk/python/
RUN cd /opt/tilo-sdk/python \
    && uv sync --frozen --extra dev \
    && uv run --frozen --extra dev python -c 'import httpx, pytest, pytest_asyncio'

# The TypeScript SDK's packages, from its lock, in bun's install cache. The node_modules this
# writes are not needed: a check installs from the cache into its own copy of the tree.
COPY sdk/typescript/package.json sdk/typescript/bun.lock /opt/tilo-sdk/typescript/
RUN cd /opt/tilo-sdk/typescript \
    && bun install --frozen-lockfile \
    && ./node_modules/.bin/tsc --version \
    && rm -rf node_modules
