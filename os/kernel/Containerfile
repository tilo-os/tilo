# syntax=docker/dockerfile:1.7
# ============================================================================
# tilo-kernel — Fedora kernel rebuild with a config fragment that:
#   * statically links the storage / net / USB / HID / paravirt drivers on
#     the boot path, so the image mounts its root FS without an initramfs,
#   * tunes for interactive latency (PREEMPT + HZ=1000 + THP=madvise +
#     SCHED_MC), and
#   * drops DEBUG_INFO / KGDB — we ship the running kernel, not its
#     ~800 MB debuginfo companion.
#
# Output OCI image layout (published by .forgejo/workflows/build-kernel.yml):
#   /repo/
#     tilo-kernel-<ver>.<arch>.rpm
#     tilo-kernel-core-<ver>.<arch>.rpm
#     tilo-kernel-modules-<ver>.<arch>.rpm
#     repodata/…
#
# os/Containerfile mounts this image as a second RPM repo alongside the
# frozen fedora snapshot, and runs
#   dnf swap kernel-core tilo-kernel-core --nogpgcheck
# so the OS image ships this tuned kernel instead of Fedora's stock.
#
# Build takes ~40 min on the CI runner; on a laptop, allow ~60 min.
# ============================================================================


# ---- Frozen RPM repo (build deps, cross-time reproducible) -----------------
# Every dnf install below reads exclusively from this digest-pinned snapshot,
# same as os/Containerfile.  Adding a build dep here => the awk scan in
# .forgejo/workflows/snapshot-rpms.yml picks it up on the next re-snapshot
# and the frozen repo grows accordingly.  See os/rpms-snapshot.env for the
# current pin; the workflow passes it as --build-arg RPMS_REF.
#
# BASE_REF is the mirrored Fedora bootc base (os/base-snapshot.env), declared
# here with RPMS_REF because an ARG between two FROMs is scoped to the previous
# stage rather than global.
ARG BASE_REF
ARG RPMS_REF

FROM ${RPMS_REF} AS rpms

FROM scratch AS external-assets
COPY --from=github-assets / /


# ---- Stage 1: kernel builder ----------------------------------------------
# SAME base as os/Containerfile — one BASE_REF for both — so the produced
# modules link against the exact glibc + userspace the OS image ships.  A drift
# here would show up as "invalid module format" at boot.
#
# This stage ends with the Fedora source tree after %prep. os/kernel/dev-build.sh
# builds it (`--target build-toolchain`) as the dev builder image, and both it
# and the `build` stage below run os/kernel/build-support.sh on that tree.
FROM ${BASE_REF} AS build-toolchain

COPY --from=external-assets /v4l2loopback-0.15.3-a7e4a4d.tar.gz /work/v4l2loopback-0.15.3-a7e4a4d.tar.gz
RUN echo '1efa0d3535523df1d45da00ec09bba0b5fdbf44c3efd775dd480fa7c803c3034  /work/v4l2loopback-0.15.3-a7e4a4d.tar.gz' \
      | sha256sum --check --strict \
    && tar -xzf /work/v4l2loopback-0.15.3-a7e4a4d.tar.gz -C /work \
    && mv /work/v4l2loopback-a7e4a4dea36187ad3550c797d647bcc50faced42 /work/v4l2loopback-0.15.3 \
    && test -f /work/v4l2loopback-0.15.3/COPYING

# Toolchain for a kernel RPM build.  All from the frozen repo.
#   kernel-devel / kernel-headers  — matched headers so external module
#     ABIs (dwarves BTF) resolve.
#   rpm-build                       — rpmbuild(1) for -bp + -bb targets.
#   make gcc bc flex bison          — the kernel build itself.
#   tilo-crypto is copied from the digest-pinned build stage above.
#   elfutils-libelf-devel dwarves  — pahole/BTF, needed by CONFIG_DEBUG_INFO_BTF
#                                     (Fedora sets this; we override it off).
#   perl-generators python3 gzip xz cpio git  — misc SRPM build hooks.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        kernel-devel kernel-headers \
        rpm-build make gcc clang lld bc flex bison rust cargo \
        elfutils-libelf-devel elfutils-devel dwarves \
        perl perl-generators rsync \
        python3 python3-devel python3-rpm-macros \
        gzip xz zstd cpio git which findutils \
    && dnf clean all

# Compile the Rust-native signer on the selected native architecture. The
# compiler and crate dependencies are frozen by RPMS_REF and Cargo.lock; this
# avoids smuggling an x86-only CI builder into an ARM64 kernel build.
COPY Cargo.toml Cargo.lock /work/workspace/
COPY crates/system/tilo-crypto/Cargo.toml /work/crypto-member.toml
COPY os/kernel/project-crate.py /work/project-crate.py
COPY crates/system/tilo-crypto/src /work/tilo-crypto/src
# bootc keeps /root as a symlink into an unpopulated /var. Cargo's registry
# and lock files need a real writable build directory, independent of HOME.
ENV CARGO_HOME=/work/cargo-home
# Prune workspace-wide optional feature edges in the private lock copy, then
# prove every version/checksum/edge still comes from the unchanged root lock.
RUN python3 /work/project-crate.py --workspace /work/workspace/Cargo.toml \
        --member /work/crypto-member.toml --lockfile /work/workspace/Cargo.lock \
        --output /work/tilo-crypto \
    && cd /work/tilo-crypto \
    && cargo fetch \
    && python3 /work/project-crate.py --lockfile /work/workspace/Cargo.lock \
        --verify-lock /work/tilo-crypto/Cargo.lock \
    && RUSTC_WRAPPER= cargo build --release --frozen \
    && strip target/release/tilo-crypto \
    && install -m 0755 target/release/tilo-crypto /usr/local/bin/tilo-crypto \
    && rm -rf target

# Build the architecture-neutral UEFI console probe with the frozen native
# LLVM toolchain. Exporting the PE image avoids relying on each VM runner to
# happen to ship a PE-capable linker (GNU ld commonly does not on ARM64).
COPY os/tests/secureboot_vm_app.c /work/secureboot_vm_app.c
RUN case "$(uname -m)" in \
      x86_64) efi_target=x86_64-pc-win32-coff ;; \
      aarch64) efi_target=aarch64-pc-win32-coff ;; \
      *) echo "unsupported EFI probe architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    clang -target "$efi_target" -ffreestanding -fno-stack-protector \
      -fshort-wchar -c /work/secureboot_vm_app.c -o /work/secureboot_vm_app.obj; \
    ld.lld -flavor link /subsystem:efi_application /entry:efi_main \
      /out:/work/secureboot_vm_app.efi /work/secureboot_vm_app.obj

# `createrepo_c` is only needed at build time to write the repo metadata
# into our output image — it never ships to end users, so pulling it from
# the live Fedora mirrors here is fine. The frozen-repo snapshot's
# buildkit cache has been holding on to a version of the repo that
# lacks createrepo_c despite the awk-derived PACKAGES list requesting
# it; sidestepping that entirely.
RUN dnf install -y createrepo_c && dnf clean all

# Fetch the Fedora kernel SRPM. Preferring the frozen-repo copy keeps the
# build hermetic when the snapshot has it, but the frozen-repo builder
# has historically not always captured src.rpms cleanly — so fall back to
# a live `dnf5 download --srpm` against Fedora's public mirrors. The
# SRPM's Version + Release still land in the produced rpm's NVR, so a
# live-fetched SRPM does not weaken the reproducibility guarantee any
# more than the Fedora repo drift itself does.
WORKDIR /work
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    ( ls /repo/kernel-*.src.rpm 2>/dev/null | head -1 | xargs -r -I{} cp {} /work/kernel.src.rpm ) \
    || ( dnf5 download --srpm --destdir=/work kernel 2>/dev/null \
         && mv /work/kernel-*.src.rpm /work/kernel.src.rpm ) \
    || ( dnf --enablerepo='*-source' download --source --destdir=/work kernel \
         && mv /work/kernel-*.src.rpm /work/kernel.src.rpm ) \
    && test -s /work/kernel.src.rpm

# ---- Extract + patch the Fedora source tree --------------------------------
# `rpmbuild -bp` runs %prep from the Fedora kernel spec: unpacks the tarball,
# applies every Fedora patch, and drops the .config that matches the target
# arch/flavor.  --nodeps because we install the toolchain manually above
# instead of via the SRPM's BuildRequires (some of those are pandoc / bindgen
# heavyweights the Tilo build doesn't need — DEBUG_INFO=n skips them).
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo set -eu; \
    export HOME=/work; \
    mkdir -p /work/rpmbuild/BUILD /work/rpmbuild/BUILDROOT /work/rpmbuild/RPMS \
             /work/rpmbuild/SOURCES /work/rpmbuild/SPECS /work/rpmbuild/SRPMS; \
    printf '%%_topdir /work/rpmbuild\n' > /work/.rpmmacros; \
    # /usr/lib/rpm/brp-compress hangs indefinitely on this kernel's
    # payload — the spec that `make binrpm-pkg` synthesises invokes
    # the script by its literal path (not via %__brp_compress), so
    # rpm macros can't disable it. Replace it with /bin/true system-
    # wide before the rpm build runs — downstream install works fine
    # without the manpage compression it does.
    cp /usr/bin/true /usr/lib/rpm/brp-compress; \
    rpm -i --define '_topdir /work/rpmbuild' /work/kernel.src.rpm; \
    cd /work/rpmbuild/SPECS; \
    KERN_SPEC="$(ls kernel*.spec 2>/dev/null | head -1)"; \
    test -n "$KERN_SPEC"; \
    rpmbuild -bp --nodeps --define "_topdir /work/rpmbuild" "$KERN_SPEC"

# ---- Build on the prepared tree ---------------------------------------------
# Everything from here on is os/kernel/build-support.sh, which the dev build
# (os/kernel/dev-build.sh) runs on its persistent copy of the same tree.
FROM build-toolchain AS build

# One ephemeral signing identity per kernel build. Only the public
# certificate is compiled into the kernel; the key is deleted before publish.
COPY os/kernel/build-support.sh /work/kernel-build-support.sh
RUN sh /work/kernel-build-support.sh signing-key "$(uname -m)" /work/module-signing

# ---- Merge our config fragment on top of Fedora's --------------------------
COPY os/kernel/config-fragments/ /work/kernel-config/
COPY os/kernel/check-config.py /work/check-config.py
COPY os/kernel/patches/ /work/kernel-patches/

# Patches, the libcrypto-free signing shim, the fragment merge and every
# required-option check (build-support.sh prepare-source).
RUN set -eux; \
    KSRC="$(find /work/rpmbuild/BUILD -maxdepth 4 -type d -name 'linux-*' | head -1)"; \
    test -n "$KSRC" || { echo "no prepared kernel source tree found"; exit 1; }; \
    ARCH="$(uname -m)"; \
    sh /work/kernel-build-support.sh validate-arch "$ARCH"; \
    sh /work/kernel-build-support.sh prepare-source "$ARCH" "$KSRC"

# ---- Rebuild as tilo-kernel-* -----------------------------------------------
# `make binrpm-pkg` uses scripts/package/kernel.spec (upstream template) to
# produce a minimal binary RPM directly from the prepared source tree — much
# faster + simpler than re-running the full Fedora spec (which builds every
# flavor and the debuginfo pair).  We rename the package via the spec's
# Name: header so it doesn't collide with Fedora's `kernel-core` and can be
# swapped in cleanly via `dnf swap kernel-core tilo-kernel-core`.
#
# Reproducible timestamp: buildkit passes SOURCE_DATE_EPOCH; the kernel's
# KBUILD_BUILD_TIMESTAMP honours it. os/kernel/dev-build.sh passes the same
# environment; tools/policy/check_kernel_dev_build.py keeps the two equal.
ARG SOURCE_DATE_EPOCH=0
# Override on memory-constrained native builders; an empty value uses all CPUs.
ARG KERNEL_BUILD_JOBS
ENV KBUILD_BUILD_TIMESTAMP="@${SOURCE_DATE_EPOCH}" \
    KBUILD_BUILD_USER=tilo \
    KBUILD_BUILD_HOST=tilo-build \
    LC_ALL=C.UTF-8 \
    TZ=UTC

# Build vmlinuz + modules directly and stage into a rootfs image tree.
# We do NOT use `make binrpm-pkg`: that macro path drags in the full
# Fedora spec (brp-compress, brp-strip, %post scriptlets, debuginfo
# subpackages, doc/man packaging) and reliably stalls at the payload
# phase on this kernel size. Rolling our own spec below skips the
# entire brp-* chain and produces the exact three files we need
# (vmlinuz, modules tree, System.map) as a single tight RPM.
RUN set -eux; \
    KSRC="$(find /work/rpmbuild/BUILD -maxdepth 4 -type d -name 'linux-*' | head -1)"; \
    cd "$KSRC"; \
    JOBS="${KERNEL_BUILD_JOBS:-$(nproc)}"; \
    case "$JOBS" in ''|*[!0-9]*|0) echo "KERNEL_BUILD_JOBS must be a positive integer" >&2; exit 1;; esac; \
    sh /work/kernel-build-support.sh compile "$(uname -m)" "$KSRC" "$JOBS" /work/v4l2loopback-0.15.3; \
    KVER="$(make -s kernelrelease)"; \
    printf 'KVER=%s\n' "$KVER" > /work/kver.env; \
    STAGE=/work/stage; \
    sh /work/kernel-build-support.sh stage-modules "$(uname -m)" "$KSRC" "$STAGE" "$KVER" \
      /work/v4l2loopback-0.15.3 /work/module-signing "$JOBS"; \
    mkdir -p /work/secureboot-probe-inputs; \
    cp "$STAGE/lib/modules/$KVER/vmlinuz" /work/secureboot-probe-inputs/vmlinuz; \
    cp usr/gen_init_cpio /work/secureboot-probe-inputs/gen_init_cpio; \
    cp /usr/local/bin/tilo-crypto /work/secureboot-probe-inputs/tilo-crypto; \
    cp /work/secureboot_vm_app.efi /work/secureboot-probe-inputs/secureboot_vm_app.efi; \
    # The signing key existed for this build and no longer exists after it.
    # Nothing needs to sign as this identity again: the certificate that
    # verifies it is already compiled into the vmlinuz above, and an
    # image-based OS loads no out-of-tree modules.
    rm -f /work/module-signing/signing-key.pem; \
    du -sh "$STAGE"; \
    # The RPM step consumes only STAGE and kver.env. Exporting the compiler \
    # tree in a cached layer duplicates tens of GiB during image commit. \
    # Remove it only after the complete staged module tree passes its checks. \
    case "$KSRC" in /work/rpmbuild/BUILD/*) ;; \
        *) echo "refusing to remove kernel source outside the build root" >&2; exit 1;; esac; \
    cd /work; \
    rm -rf -- "$KSRC"

# Hand-written spec — no Fedora scriptlets, no debuginfo, no brp-*
# chain. `dnf swap kernel-core tilo-kernel-core` in os/Containerfile
# resolves against the `Provides: kernel-core` line.
COPY os/kernel/tilo-kernel-payload.spec /work/tilo-kernel-payload.spec
RUN set -eux; \
    . /work/kver.env; \
    rpmbuild -bb \
        --define "_topdir /work/rpmbuild" \
        --define "_binary_payload w0.gzdio" \
        --define "kver $KVER" \
        --define "stage /work/stage" \
        --define "__spec_install_pre %{nil}" \
        --define "__os_install_post %{nil}" \
        /work/tilo-kernel-payload.spec; \
    mkdir -p /out; \
    find /work/rpmbuild/RPMS -name 'tilo-kernel*.rpm' -exec cp -v {} /out/ \;; \
    ls -lh /out/

# The payload spec is named `tilo-kernel-core` and already Provides:
# kernel-core / kernel-modules / kernel — no separate meta-RPM is
# needed for the `dnf swap kernel-core tilo-kernel-core` step in
# os/Containerfile to resolve.

# Build the repo metadata. `createrepo_c` was installed in the
# toolchain step above, so no `dnf install` runs here — that had been
# probing `/repo` (which we're about to CREATE) and stalling on the
# missing repomd.xml.
RUN mkdir -p /repo \
    && cp /out/*.rpm /repo/ \
    && createrepo_c --quiet /repo \
    && printf '[tilo-kernel]\nname=Tilo custom kernel\nbaseurl=file:///repo\ngpgcheck=0\nenabled=1\n' > /repo/tilo-kernel.repo


# CI-only export target: the OVMF enforcement probe boots the exact kernel and
# invokes the exact Rust signer produced above. This is intentionally absent
# from the published RPM repository image.
FROM scratch AS secureboot-probe-inputs
COPY --from=build /work/secureboot-probe-inputs /

# ---- Stage 2: publish ------------------------------------------------------
# Same shape as the frozen-repo image (os/Containerfile.rpms): FROM scratch +
# just /repo.  Keep this last: it is the default build target.
FROM scratch AS publish
COPY --from=build /repo /repo
