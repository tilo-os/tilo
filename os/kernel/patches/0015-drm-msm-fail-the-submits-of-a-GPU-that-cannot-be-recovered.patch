From: Tilo <tilo@tilo.so>
Subject: drm/msm: fail the submits of a GPU that cannot be recovered

When recovery cannot bring the GPU back, the msm driver keeps going as if
it had: recover_worker() replays every queued submit onto a GPU that is not
powered, msm_gpu_submit() ignores the failed runtime resume and writes
to the ring anyway, and nothing ever completes. Each hangcheck period
queues another recovery, which fails the same way, and every fence that
userspace waits on stays unsignalled. On an X1E laptop that left the
compositor waiting on the GPU for 40 minutes, through 333 hangcheck
lockups, until the machine was power cycled.

Make a failed recovery fail the work instead of retrying it forever:

- msm_gpu_submit() returns the error from pm_runtime_resume_and_get()
  and msm_gpu_hw_init() before it touches the ring, and msm_job_run()
  hands it to the scheduler, which fails the job's fence with it. The
  seqno that msm_fence_init() already allocated is completed so hangcheck
  does not see work that was never queued.
- recover_worker() checks whether the GPU came back (needs_hw_init is
  still set after ->recover()) and, if not, completes every pending
  submit's fence with -ENODEV instead of replaying it. Userspace sees the
  device as lost and can rebuild its context. The next submit tries to
  power the GPU up again, so a GPU that comes back is used again.

Together with the runtime PM change that stops a failed resume from
latching -EINVAL, a GPU whose recovery fails costs the submits in flight
and not the machine.

diff --git a/drivers/gpu/drm/msm/msm_gpu.c b/drivers/gpu/drm/msm/msm_gpu.c
--- a/drivers/gpu/drm/msm/msm_gpu.c
+++ b/drivers/gpu/drm/msm/msm_gpu.c
@@ -461,6 +461,37 @@ static void get_comm_cmdline(struct msm_gem_submit *submit, char **comm, char **
 	put_task_struct(task);
 }
 
+/*
+ * Recovery could not bring the GPU back, so nothing queued on the rings will
+ * ever run. Complete every fence with an error instead of replaying the work
+ * onto a GPU that is not there: replaying only hangs again, each hang takes
+ * another recovery, and everything waiting on those fences, the compositor
+ * included, never wakes up. With the error on the fence, userspace sees the
+ * device as lost and can rebuild its context; the next submit tries to power
+ * the GPU up again.
+ */
+static void fail_pending_submits(struct msm_gpu *gpu)
+{
+	int i;
+
+	for (i = 0; i < gpu->nr_rings; i++) {
+		struct msm_ringbuffer *ring = gpu->rb[i];
+		struct msm_gem_submit *submit;
+		unsigned long flags;
+
+		spin_lock_irqsave(&ring->submit_lock, flags);
+		list_for_each_entry(submit, &ring->submits, node) {
+			if (fence_after(submit->hw_fence->seqno,
+					ring->fctx->completed_fence))
+				dma_fence_set_error(submit->hw_fence, -ENODEV);
+		}
+		spin_unlock_irqrestore(&ring->submit_lock, flags);
+
+		ring->memptrs->fence = ring->fctx->last_fence;
+		msm_update_fence(ring->fctx, ring->fctx->last_fence);
+	}
+}
+
 static void recover_worker(struct kthread_work *work)
 {
 	struct msm_gpu *gpu = container_of(work, struct msm_gpu, recover_work);
@@ -558,6 +589,17 @@ static void recover_worker(struct kthread_work *work)
 
 	gpu->funcs->recover(gpu);
 
+	/*
+	 * recover() leaves the GPU powered with hw_init done. If hw_init is
+	 * still pending the GPU did not come back.
+	 */
+	if (gpu->needs_hw_init) {
+		DRM_DEV_ERROR(dev->dev,
+			      "%s: recovery failed, failing the pending submits\n",
+			      gpu->name);
+		fail_pending_submits(gpu);
+	}
+
 	/* retire completed submits, plus the one that hung: */
 	retire_submits(gpu);
 
@@ -789,17 +831,35 @@ void msm_gpu_retire(struct msm_gpu *gpu)
 	kthread_queue_work(gpu->worker, &gpu->retire_work);
 }
 
-/* add bo's to gpu's ring, and kick gpu: */
-void msm_gpu_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit)
+/*
+ * add bo's to gpu's ring, and kick gpu.
+ *
+ * Returns an error, without touching the ring, if the GPU cannot be powered
+ * up and initialized. Writing to a GPU that is not running only produces a
+ * hang that can never be recovered, so the caller fails the job instead.
+ */
+int msm_gpu_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit)
 {
 	struct msm_ringbuffer *ring = submit->ring;
 	unsigned long flags;
+	int ret;
 
 	WARN_ON(!mutex_is_locked(&gpu->lock));
 
-	pm_runtime_get_sync(&gpu->pdev->dev);
+	ret = pm_runtime_resume_and_get(&gpu->pdev->dev);
+	if (ret) {
+		DRM_DEV_ERROR(gpu->dev->dev, "%s: GPU power up failed: %d\n",
+			      gpu->name, ret);
+		return ret;
+	}
 
-	msm_gpu_hw_init(gpu);
+	ret = msm_gpu_hw_init(gpu);
+	if (ret) {
+		DRM_DEV_ERROR(gpu->dev->dev, "%s: GPU init failed: %d\n",
+			      gpu->name, ret);
+		pm_runtime_put(&gpu->pdev->dev);
+		return ret;
+	}
 
 	submit->seqno = submit->hw_fence->seqno;
 
@@ -827,6 +887,8 @@ void msm_gpu_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit)
 
 	pm_runtime_put(&gpu->pdev->dev);
 	hangcheck_timer_reset(gpu);
+
+	return 0;
 }
 
 /*
diff --git a/drivers/gpu/drm/msm/msm_gpu.h b/drivers/gpu/drm/msm/msm_gpu.h
--- a/drivers/gpu/drm/msm/msm_gpu.h
+++ b/drivers/gpu/drm/msm/msm_gpu.h
@@ -743,7 +743,7 @@ void msm_devfreq_idle(struct msm_gpu *gpu);
 int msm_gpu_hw_init(struct msm_gpu *gpu);
 
 void msm_gpu_retire(struct msm_gpu *gpu);
-void msm_gpu_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit);
+int msm_gpu_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit);
 
 int msm_gpu_init(struct drm_device *drm, struct platform_device *pdev,
 		struct msm_gpu *gpu, const struct msm_gpu_funcs *funcs,
diff --git a/drivers/gpu/drm/msm/msm_ringbuffer.c b/drivers/gpu/drm/msm/msm_ringbuffer.c
--- a/drivers/gpu/drm/msm/msm_ringbuffer.c
+++ b/drivers/gpu/drm/msm/msm_ringbuffer.c
@@ -18,7 +18,7 @@ static struct dma_fence *msm_job_run(struct drm_sched_job *job)
 	struct msm_gpu *gpu = submit->gpu;
 	struct drm_device *dev = gpu->dev;
 	unsigned nr_cmds = submit->nr_cmds;
-	int i;
+	int i, ret;
 
 	msm_fence_init(submit->hw_fence, fctx);
 
@@ -40,10 +40,25 @@ static struct dma_fence *msm_job_run(struct drm_sched_job *job)
 	if (submit->queue->ctx->closed)
 		submit->nr_cmds = 0;
 
-	msm_gpu_submit(gpu, submit);
+	ret = msm_gpu_submit(gpu, submit);
 
 	submit->nr_cmds = nr_cmds;
 
+	if (ret) {
+		/*
+		 * Nothing was queued. The seqno was allocated in
+		 * msm_fence_init(), so complete it, or hangcheck sees work
+		 * that does not exist. The scheduler fails the job's fence
+		 * with the error.
+		 */
+		if (fence_after(submit->hw_fence->seqno,
+				submit->ring->memptrs->fence))
+			submit->ring->memptrs->fence = submit->hw_fence->seqno;
+		msm_update_fence(fctx, submit->hw_fence->seqno);
+		mutex_unlock(&gpu->lock);
+		return ERR_PTR(ret);
+	}
+
 	mutex_unlock(&gpu->lock);
 
 	return dma_fence_get(submit->hw_fence);
