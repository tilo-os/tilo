# x86-only protections; these symbols do not exist in ARM64 Kconfig.
# Userspace binaries opt in to hardware shadow stacks through their ELF marks.
CONFIG_X86_USER_SHADOW_STACK=y
# Compiler-backed Indirect Branch Tracking for kernel text.
CONFIG_X86_KERNEL_IBT=y
# Remove the legacy fixed-address executable vsyscall page.
CONFIG_LEGACY_VSYSCALL_NONE=y
