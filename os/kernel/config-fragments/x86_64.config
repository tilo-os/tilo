# x86-only protections; these symbols do not exist in ARM64 Kconfig.
# Userspace binaries opt in to hardware shadow stacks through their ELF marks.
CONFIG_X86_USER_SHADOW_STACK=y
# Compiler-backed Indirect Branch Tracking for kernel text.
CONFIG_X86_KERNEL_IBT=y
# Remove the legacy fixed-address executable vsyscall page.
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SCHED_MC_PRIO=y
# Tilo has no Intel HFI userspace consumer. ITMT still supplies preferred-core
# priorities directly to the scheduler; disable the separate thermal-netlink
# telemetry path instead of processing and publishing unused capability events.
CONFIG_INTEL_HFI_THERMAL=n
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_SND_SOC_INTEL_AVS_MACH_I2S_TEST=n
CONFIG_X86_AMD_PSTATE_UT=n
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_IA32_EMULATION=y
CONFIG_X86_X32_ABI=n
CONFIG_USELIB=n
CONFIG_DEVPORT=n
CONFIG_X86_MSR=n
CONFIG_X86_CPUID=n
# Wayland/KMS, KVM, and modern Wine use kernel device APIs. They never need the
# legacy iopl/ioperm syscalls, which otherwise let CAP_SYS_RAWIO holders reach
# all 65,536 hardware ports through an unusually broad architecture interface.
CONFIG_X86_IOPL_IOPERM=n
# Keep architectural machine-check detection and vendor recovery, but expose
# neither the deprecated mcelog character device nor the debug-only fault
# injector. Hardware failures remain visible through normal kernel reporting.
CONFIG_X86_MCELOG_LEGACY=n
CONFIG_X86_MCE_INJECT=n
CONFIG_X86_DECODER_SELFTEST=n
# Fedora enables the x86 extended firmware error log, which selects APEI and
# its persistent-store backend even when both are disabled in the shared
# fragment. Tilo has no collector for that firmware log, so disable the
# upstream selector and keep crash records out of persistent storage.
CONFIG_ACPI_EXTLOG=n
# Unlike Fedora's ARM64 Tegra host support, x86 has no host-controller option
# that selects the peripheral core. Remove it entirely on this architecture.
CONFIG_USB_GADGET=n
# Tilo supports USB and network printers, not legacy ISA/LPC parallel ports.
# Floppy and PCMCIA/CardBus media are likewise outside the supported hardware
# set. Omitting them removes old ioctl, DMA, CIS-tuple and hotplug parsers from
# the trusted kernel.
CONFIG_PARPORT=n
CONFIG_BLK_DEV_FD=n
CONFIG_PCCARD=n

# Microsoft Surface tablets and laptops reach their embedded controller, battery,
# thermal sensors, detachable-keyboard state and integrated keyboard/touchpad
# through the Surface System Aggregator Module over the serial hub. Every one of
# these drivers is mainline; no vendor kernel is involved. Fedora already ships
# them as modules but leaves their menu unset, so the subsystem, the client bus,
# the device registry and the drivers cascade to disabled. Pin each one so a
# stock image boots a Surface with its lid switch, battery, tablet-mode switch and
# keyboard working. Modules, like the rest of the hardware drivers: nothing on the
# boot path asks for them, and an unneeded one is never loaded.
CONFIG_SURFACE_PLATFORMS=y
CONFIG_SURFACE3_WMI=m
CONFIG_SURFACE_3_POWER_OPREGION=m
CONFIG_SURFACE_GPE=m
CONFIG_SURFACE_HOTPLUG=m
CONFIG_SURFACE_PRO3_BUTTON=m
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_CDEV=m
CONFIG_SURFACE_ACPI_NOTIFY=m
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=m
CONFIG_SURFACE_PLATFORM_PROFILE=m
CONFIG_SURFACE_DTX=m
CONFIG_SURFACE_KBD=m
CONFIG_SURFACE_HID=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m
CONFIG_SENSORS_SURFACE_FAN=m
CONFIG_SENSORS_SURFACE_TEMP=m
# hid-microsoft carries the button and multitouch quirks the Type Cover and the
# Surface Pen need before the generic HID layer sees them.
CONFIG_HID_MICROSOFT=m

# The webcams on Surface Pro 8 and later, and on Surface Laptop Studio, are
# MIPI sensors behind the SoC's Intel Image Processing Unit. The IPU6 driver
# binds the unit, the IPU bridge reads the sensor description Microsoft's ACPI
# tables leave behind, and one sensor driver per module the devices ship is
# enough to reach the camera. Modules, like the rest of the media stack: the
# session opens a camera only when a person does.
CONFIG_IPU_BRIDGE=m
CONFIG_VIDEO_INTEL_IPU6=m
CONFIG_VIDEO_OV01A10=m
CONFIG_VIDEO_OV02C10=m
CONFIG_VIDEO_OV08X40=m
CONFIG_VIDEO_HI556=m
CONFIG_VIDEO_DW9714=m
