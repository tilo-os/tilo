# Preserve Fedora's ARM64 platform and architecture hardening configuration.
# The shared Tilo fragment pins architecture-independent security requirements.
# ARM pointer authentication / BTI are not equivalents of x86 userspace shadow
# stacks / kernel IBT; this fragment deliberately makes no such guarantee.
# ARM64 counterparts to the x86 control-flow and address-randomization
# settings in tilo.config. Pointer authentication is runtime-detected, so this
# remains bootable on ARMv8.0 while newer CPUs protect return addresses.
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MODULE_REGION_FULL=y

# The perf hard-lockup detector needs pseudo-NMIs, which are off unless the
# command line enables them, and then cost every interrupt-masking section;
# without them the kernel disables the detector at boot. The buddy detector
# has each CPU check that the next one still takes its timer interrupt, which
# needs no NMI.
CONFIG_HARDLOCKUP_DETECTOR_PREFER_BUDDY=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y

# The Snapdragon X Elite's video codec block: `qcom-venus` binds the platform
# device the board device tree declares and registers the /dev/video* nodes that
# decode H.264, HEVC and VP9 in fixed-function hardware, which is the only
# hardware decode these laptops have. A module like the rest of the media stack,
# because nothing at boot decodes video.
CONFIG_VIDEO_QCOM_VENUS=m

# Orange Pi 3B mounts its root from the RK3566 SD host. These are built in so
# the shared ARM64 UKI does not depend on loading them from an initramfs that
# was generated on a machine without that controller. A profile whose kernel
# still ships them as modules lists the same names in boot_modules; dracut
# adds only the ones that are not already built in.
CONFIG_MMC=y
# MMC_BLOCK cannot be built-in while RPMB is a module (`depends on RPMB || !RPMB`).
CONFIG_RPMB=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK3568=y
CONFIG_ROCKCHIP_IODOMAIN=y

# The Raspberry Pi 4, 400, CM4 (BCM2711) and 5, 500 (BCM2712) have no
# second-stage loader of their own in this image, but their kernel is the
# shared one, so what their devices need has to be here rather than in a
# board-only file. Fedora's config already describes the BCM2835 platform
# family (CONFIG_ARCH_BCM2835), which is the config option covering every
# one of those boards; pinning it keeps a trim from dropping the platform a
# registered Pi profile names. The Pi 5 reaches the same family through the
# same option: BCM2712 is a BCM2835-platform SoC in Kconfig's sense.
CONFIG_ARCH_BCM2835=y

# The root filesystem of a Pi is on the SD card or the eMMC: the Arasan
# SDHCI-compatible controller ("brcm,bcm2835-sdhci") that the iProc driver
# binds, or on a Pi 5 an NVMe drive behind the RP1 south bridge's PCIe. Built
# in for the same reason as the Orange Pi's SD host: a modular storage driver
# would have to be loaded from an initramfs generated on a machine that had
# it, and the ARM64 UKI is shared across boards.
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_BLK_DEV_NVME=y
# BCM2712's RP1 south bridge is a PCIe multifunction device. Every Pi 5
# peripheral other than the SoC's own UART and the display -- Ethernet, USB,
# GPIO, I2C, SPI, and the SD card itself -- is a function of it, so the PCIe
# host controller and the RP1 core have to exist, and be built in, before the
# controller the root is on can be probed. Its pin controller and clock
# generators are built in for the same reason: they are providers the RP1
# functions request at probe time, and a provider that arrives as a module is
# too late for a root that is being mounted.
CONFIG_PCIE_BRCMSTB=y
CONFIG_MISC_RP1=y
CONFIG_PINCTRL_RP1=y
CONFIG_COMMON_CLK_RP1=y

# Both Pi families drive their display through the VideoCore: vc4 for the
# KMS pipeline and HDMI, and v3d for the GPU that Vulkan's V3DV driver talks
# to over the render node. Modular like the rest of the DRM stack, because
# nothing at boot needs them and the compressed UKI is smaller without them.
# The Pi's own firmware keeps the monitor lit until Linux binds vc4, so the
# board profile does not have to carry them into the initramfs.
CONFIG_DRM_VC4=m
CONFIG_DRM_V3D=m

# The Pi 4's onboard Ethernet is the SoC's GENET MAC and the Pi 5's is a
# function of RP1; both are ordinary network drivers that arrive after the
# root is mounted. The SDIO Wi-Fi on sdhost ("mmc-bcm2835") is not the
# storage controller, so it is a module too.
CONFIG_BCMGENET=m
CONFIG_MMC_BCM2835=m

# The SoC's PM block is the watchdog and the power-off controller. It is a
# module because the Pi profile feeds it from systemd rather than from the
# initramfs, so it only has to be installed, not built in.
CONFIG_BCM2835_WDT=m
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y

# The Snapdragon X laptops reach their built-in keyboard and touchpad over
# I2C HID on a GENI bus, and the LUKS unlock prompt runs before any module can
# be loaded, so the whole path is built in: the bus controller, the HID-over-I2C
# transport, HID-core and the input layer systemd reads keys from. On the
# Lenovo 83ED those drivers answer for the keyboard at 1-003a and the touchpad
# at 1-002c on b80000, and Fedora's stock config has all of them as modules.
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_HID_OF=y
CONFIG_HID=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y

# Snapdragon X laptops that use Microsoft Pluton as their TPM reach it through
# the qcom.tz.mssecapp Secure Application (os/kernel/patches/0016 and 0017).
# Built in so /dev/tpmrm0 exists before systemd starts in the initrd: the
# hardware profile keeps systemd.tpm2_wait=0 so a firmware that refuses
# mssecapp cannot stall boot, and nothing would wait for a module.
CONFIG_TCG_QCOM_MSSEC=y

# The I2C controllers sit behind the GCC clock controller, which also stays
# built in for the same reason: a modular clock provider would be probed too
# late for the buses that need it during early boot.
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_CLK_X1E80100=y
CONFIG_CLK_X1E80100_GCC=y
