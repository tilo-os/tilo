# Preserve Fedora's ARM64 platform and architecture hardening configuration.
# The shared Tilo fragment pins architecture-independent security requirements.
# ARM pointer authentication / BTI are not equivalents of x86 userspace shadow
# stacks / kernel IBT; this fragment deliberately makes no such guarantee.
# ARM64 counterparts to the x86 control-flow and address-randomization
# settings in tilo.config. Pointer authentication is runtime-detected, so this
# remains bootable on ARMv8.0 while newer CPUs protect return addresses.
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MODULE_REGION_FULL=y
