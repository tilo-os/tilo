# Tilo kernel config overrides.
#
# Layered on top of Fedora's stock kernel config via merge_config.sh, then
# resolved with `make olddefconfig`.  Every entry here is either:
#   (a) a boot-path driver we want built-in (=y) so the UKI's initramfs does
#       not need to discover and load it before mounting the root filesystem, or
#   (b) a scheduler/latency tunable for interactive desktop throughput, or
#   (c) a debug/tracing option we deliberately turn off to shrink the RPM +
#       cut build time (a full DEBUG_INFO=y build produces ~1 GB of
#       kernel-debuginfo, which we don't ship on the OS image).
#
# When adding a driver: prefer =y (built-in) only if it's on the boot path or
# universally needed (HID_GENERIC).  Everything else stays =m so /lib/modules
# stays curated.

# ---- Storage (root FS + block) --------------------------------------------
# virtio-blk / virtio-scsi cover every VM and the qemu-based dev flow;
# NVMe covers modern laptops/desktops; SATA/AHCI covers older machines.
# Built-in = kernel walks /dev at rootfs mount without loading a module.
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y

# ---- Filesystems (root candidates + /boot) --------------------------------
# Btrfs is the only supported Tilo root and therefore remains built in. XFS and
# ext4 are needed only for rescue/alongside-install inspection after the root
# and signed module store are available; keeping them modular removes two large
# parsers from every resident kernel and compressed UKI without dropping them.
# The ESP mounts as vfat via built-in FAT support carried below.
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=m
CONFIG_EXT4_FS=m

# ---- USB (needed to see a keyboard on physical hardware before login) -----
# xHCI covers every USB3 host; EHCI covers older USB2 chipsets.  Built-in
# so the pre-userspace stage can see a keyboard for e.g. LUKS unlock.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_HID_GENERIC=y
# USB packet tracing is a kernel debugging interface, not a device driver. It
# can expose keyboard, security-token, camera, and storage transactions to a
# compromised privileged process without helping ordinary USB operation.
CONFIG_USB_MON=n

# ---- Network (deliberately outside the boot path) -------------------------
# virtio-net covers every VM. e1000e/igb/r8169 cover the common Intel/Realtek
# laptop and desktop NICs; iwlwifi covers Intel Wi-Fi. Networking is not needed
# to mount the immutable root or reach the greeter, and peer services tolerate
# it arriving later. Keep all of these as signed modules so their probe/code is
# absent from the always-resident kernel and the compressed UKI is smaller.
CONFIG_VIRTIO_NET=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_R8169=m
CONFIG_IWLWIFI=m

# ---- Console / paravirt bits ----------------------------------------------
# virtio-gpu carries the console framebuffer in every VM we test with.
# virtio-console gives us a serial-equivalent for qemu-boot-measure.sh.
# virtio-rng seeds /dev/random early (cuts boot randomness stalls in VMs).
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# ---- Dev VM seats: vkms, uinput, configfs ---------------------------------
# The dev image (os/Containerfile.dev) runs each agent session on its own
# logind seat: a vkms card created through configfs, plus per-seat uinput
# devices. Fedora's config has all three; they are pinned here so a config
# trim cannot drop them silently, since the kernel build checks every line of
# this file. vkms stays a module: nothing loads it on a production image, and
# the dev image passes create_default_dev=0 through modprobe.d so that no card
# lands on seat0. uinput also backs production peripheral forwarding.
# os/scripts/check-dev-kernel.sh fails the dev image build when any is missing.
CONFIG_CONFIGFS_FS=y
CONFIG_DRM_VKMS=m
CONFIG_INPUT_UINPUT=m

# ---- Game controllers -------------------------------------------------------
# hid-nintendo drives Switch controllers directly (Pro, SNES, N64), and
# joycond folds its Joy-Con halves into one uinput controller, blinking the
# player LEDs through the timer trigger while a half waits to be paired.
# Fedora's config sets all three; pinned so a trim cannot drop them silently.
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_LEDS_TRIGGER_TIMER=m

# ---- Scheduler / latency tuning -------------------------------------------
# Full preemption for interactive latency: any kernel task can be preempted
# by a higher-priority one, so a click/keystroke never queues behind a
# kernel worker.  This trades a small amount of throughput for consistent
# desktop responsiveness.  PREEMPT_NONE / PREEMPT_VOLUNTARY are mutually
# exclusive with PREEMPT (Kconfig `choice` — olddefconfig will clear them).
CONFIG_PREEMPT=y
CONFIG_PREEMPT_VOLUNTARY=n
CONFIG_PREEMPT_NONE=n
# Keep the preemption model runtime-selectable. Full preemption remains the
# default above, while a benchmark or throughput-heavy workload can select
# preempt=voluntary without requiring a second kernel build.
CONFIG_PREEMPT_DYNAMIC=y

# Group tasks by their controlling terminal/session before applying nice
# weights. This stops a compile, game shader build, or decompression job from
# monopolising every CPU while the compositor and input path are runnable.
CONFIG_SCHED_AUTOGROUP=y

# Tilo's signed kernel carries one reviewed upstream scheduler policy. It does
# not ship scx tooling or BPF scheduler programs, so retaining sched_ext would
# add hot-path hooks and a privileged runtime scheduler-replacement interface
# without improving any supported workload.
CONFIG_SCHED_CLASS_EXT=n
# Core scheduling is opt-in and Tilo has no cookie-management/isolation policy;
# merely compiling its prctl surface does not protect SMT siblings. Likewise,
# production systems do not expose scheduler developer tunables or diagnostics.
# Remove both rather than paying for dormant hooks and mutable policy surface.
CONFIG_SCHED_CORE=n
CONFIG_SCHED_DEBUG=n

# 1000 Hz timer tick: the compositor's frame-pacing loop and scheduler
# wake-ups get 1 ms resolution instead of Fedora's default 250 Hz (4 ms).
# Cost is a small % more timer overhead; the win is stable frame delivery.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HZ_100=n
CONFIG_HZ_250=n
CONFIG_HZ_300=n

# THP=madvise: large, intentionally contiguous allocations can opt in without
# making an input/render thread enter direct compaction. THP=always improves a
# few throughput benchmarks but produces severe frame-time outliers once RAM
# is fragmented, which is the wrong trade for a desktop and gaming kernel.
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=n
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Multi-core scheduler awareness: pick a runqueue that respects the CPU
# package/cache topology (better locality on modern multi-die parts).
CONFIG_SCHED_MC=y
# Let the scheduler prefer the fastest cores exposed by Intel Thread Director /
# Turbo Boost Max and AMD CPPC. This is especially important to render and game
# threads on heterogeneous CPUs; without it they can land on an efficiency core
# while a background compiler occupies a preferred core.

# Intel/AMD P-state own frequency selection on most target machines. For CPUs
# that expose only generic cpufreq, schedutil must be the default rather than
# the latency-insensitive powersave governor. IRQ accounting gives schedutil a
# complete utilization signal instead of treating interrupt-heavy render/input
# work as idle time.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# Do not account every frequency transition into an unused sysfs statistics
# table. Tilo's power UI consumes battery/platform-profile state, not
# time_in_state. Likewise, retain the performance/powersave policies used by
# P-state drivers and schedutil for generic hardware, but remove three legacy
# mutable governors that no shipped component selects.
CONFIG_CPU_FREQ_STAT=n
CONFIG_CPU_FREQ_GOV_USERSPACE=n
CONFIG_CPU_FREQ_GOV_ONDEMAND=n
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=n
CONFIG_IRQ_TIME_ACCOUNTING=y

# Frame pacing and input timers need sub-jiffy deadlines even though the base
# scheduler tick is 1 kHz. Stop periodic ticks on idle CPUs to reduce wakeups
# and leave more package power/thermal budget for the active game threads.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_PERIODIC=n
CONFIG_NO_HZ_FULL=n

# Expose utilization clamps to cgroups so a compositor, game scope, or explicit
# performance profile can request prompt frequency ramp-up without pinning the
# whole machine at maximum frequency. Keep the upstream five-bucket cost bound.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_ENERGY_MODEL=y

# Upstream Windows NT synchronization primitives. Current Wine/Proton uses
# the descriptor-scoped /dev/ntsync ABI for cheaper waits and wakeups, which
# improves frame pacing without carrying an out-of-tree futex patch set or a
# privileged userspace daemon.
CONFIG_NTSYNC=y

# Preserve the conventional i686 ABI required by Wine/Proton, but omit x32
# (64-bit registers with 32-bit pointers), which no shipped executable targets
# and which duplicates much of the syscall argument-validation surface. The
# old uselib(2) loader predates modern ELF dynamic linking and has no consumer.

# BFQ provides per-process proportional I/O scheduling and honors the
# best-effort priority level inherited by game processes. Tilo selects it only
# for physical NVMe/SCSI disks via udev; virtio release VMs and dm/loop devices
# retain their kernel-selected scheduler.
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_DEADLINE=y

# Prefer low-latency module decompression. Zstd is substantially faster than
# XZ during cold boot while retaining enough compression for the immutable
# image; module signatures cover the module before compression.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_XZ=n
CONFIG_MODULE_COMPRESS_ALL=y
# The signed UKI carries an external dracut initramfs. Zstandard gives much
# lower cold-boot decompression latency than xz while retaining useful image
# compression; keep decoder support built into the kernel.
CONFIG_RD_ZSTD=y

# zram sits on the interactive memory-pressure path. LZ4 trades some ratio for
# much lower compression/decompression latency than zstd, avoiding long stalls
# when a game or shader compiler first pushes the desktop into swap.
CONFIG_CRYPTO_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# ---- Trim: debug + tracing we don't ship ----------------------------------
# Fedora ships kernel + kernel-debuginfo; Tilo ships only the runtime kernel.
# BPF CO-RE programs still require kernel BTF, and generating BTF requires
# temporary DWARF during compilation.  Keep DWARF5+BTF in the built kernel,
# while the payload packaging continues to omit separate debuginfo packages.
CONFIG_DEBUG_INFO_NONE=n
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_KGDB=n

# Fedora's generic kernel enables instrumentation intended for diagnosing any
# workload.  Tilo keeps perf/eBPF available for game profiling, but removes the
# always-compiled sanitizers and tracing hooks from the shipped kernel. UBSAN
# inserts checks throughout hot paths; function tracing reserves entry hooks
# in nearly every function even while no tracer is selected. Page-owner and
# scheduler statistics are opt-in at runtime, but retaining their collection
# machinery still costs memory/text and exposes diagnostic surface we do not
# use in the image.
CONFIG_UBSAN=n
CONFIG_FUNCTION_TRACER=n
CONFIG_STACK_TRACER=n
CONFIG_HIST_TRIGGERS=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_LATENCYTOP=n
CONFIG_SCHEDSTATS=n
CONFIG_PAGE_OWNER=n
# Tilo observes resource pressure through PSI/cgroups. It does not run accton,
# iotop, or a process-connector listener, so omit deprecated kernel-to-file
# accounting, per-task delay hooks, and fork/exec/exit netlink broadcasts.
CONFIG_BSD_PROCESS_ACCT=n
CONFIG_TASKSTATS=n
CONFIG_PROC_EVENTS=n
# Keep the text symbols needed for stack traces, perf and module resolution,
# but do not retain every data symbol. Linux 7.2 removed the former
# KALLSYMS_BASE_RELATIVE option, so there is no longer a separate offset-mode
# choice to pin here.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=n
# Keep perf events, BPF, and tracefs for profiling, but do not ship debugfs: no
# OS component mounts it, and its driver-specific files expose a broad,
# weakly-uniform privileged control surface intended for kernel developers.
CONFIG_DEBUG_FS=n
# Fedora enables these diagnostic drivers, which select DEBUG_FS even when
# explicitly disabled. Ordinary GPIO and SUNRPC functionality stay available.
CONFIG_GPIO_VIRTUSER=n
CONFIG_SUNRPC_DEBUG=n
# Never ship Fedora's broad kernel unit-test bundle as trusted, loadable code.
# It is useful to distribution kernel developers, not to an immutable desktop.
CONFIG_KUNIT=n
CONFIG_ASYNC_RAID6_TEST=n
CONFIG_EFI_TEST=n
CONFIG_LOCK_TORTURE_TEST=n
CONFIG_RCU_TORTURE_TEST=n
CONFIG_SND_PCMTEST=n
CONFIG_TEST_BPF=n
CONFIG_TEST_HMM=n
CONFIG_TEST_KMOD=n
CONFIG_TEST_LKM=n
CONFIG_TEST_LOCKUP=n
CONFIG_TEST_VMALLOC=n
CONFIG_CRYPTO_BENCHMARK=n
CONFIG_RING_BUFFER_BENCHMARK=n
# Fedora enables synthetic hardware for kernel/network test laboratories. Tilo
# needs real VM devices, not fake endpoints that become trusted modules.
CONFIG_GPIO_SIM=n
CONFIG_IEEE802154_FAKELB=n
CONFIG_MAC80211_HWSIM=n
CONFIG_MTD_NAND_NANDSIM=n
CONFIG_NETDEVSIM=n
CONFIG_NFC_SIM=n
CONFIG_STM_DUMMY=n
CONFIG_USB_DUMMY_HCD=n
CONFIG_VDPA_SIM=n
CONFIG_WWAN_HWSIM=n
# Tilo is a USB host, not an emulated peripheral or a network USB endpoint.
# ARM64 host-controller support can select the internal gadget core, so disable
# every userspace-configurable/precomposed gadget surface independently. x86,
# which has no such host dependency, disables the core in x86_64.config too.
CONFIG_USB_CONFIGFS=n
CONFIG_USB_GADGETFS=n
CONFIG_USB_FUNCTIONFS=n
CONFIG_USB_MASS_STORAGE=n
CONFIG_USB_G_SERIAL=n
CONFIG_USB_G_PRINTER=n
CONFIG_USB_G_WEBCAM=n
CONFIG_USB_RAW_GADGET=n
CONFIG_USBIP_CORE=n
# Runtime Verification's trace monitors/reactors are kernel-developer tools;
# they add trusted trace machinery and are not part of Tilo health monitoring.
CONFIG_RV=n
CONFIG_MEDIA_TEST_SUPPORT=n
# This validates exported headers during a distribution build; Tilo consumes
# Fedora's prepared source and does not publish a kernel-headers package.
CONFIG_UAPI_HEADER_TEST=n
# Production machines do not run kernel suspend/fault/self-test campaigns.
# Remove their injection controls, trace buffers and boot-time probes while
# retaining ordinary suspend, PCIe error recovery, audio and perf/eBPF support.
CONFIG_PM_TEST_SUSPEND=n
CONFIG_PM_TRACE=n
CONFIG_PM_TRACE_RTC=n
CONFIG_PCIEAER_INJECT=n
CONFIG_NET_DROP_MONITOR=n
CONFIG_DEBUG_SHIRQ=n
CONFIG_MMIOTRACE=n
CONFIG_ATOMIC64_SELFTEST=n
CONFIG_MEMTEST=n
# Strip runtime debug metadata and driver dump/control paths from the release
# kernel. These increase text size, logging work, boot checks, or privileged
# sysfs/proc surface; none is consumed by Tilo health or game profiling.
# Keep build-time section mismatch analysis and the cheap DEBUG_WX assertion.
CONFIG_PM_DEBUG=n
CONFIG_PM_SLEEP_DEBUG=n
CONFIG_ACPI_DEBUG=n
CONFIG_FW_LOADER_DEBUG=n
CONFIG_OVMF_DEBUG_LOG=n
CONFIG_SCSI_IPR_TRACE=n
CONFIG_SCSI_IPR_DUMP=n
CONFIG_DM_DEBUG=n
CONFIG_MLX4_DEBUG=n
CONFIG_ATH5K_DEBUG=n
CONFIG_ATH6KL_DEBUG=n
CONFIG_IWLEGACY_DEBUG=n
CONFIG_IWLWIFI_DEBUG=n
CONFIG_USB_SERIAL_DEBUG=n
CONFIG_DLM_DEBUG=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_DYNAMIC_DEBUG_CORE=n
CONFIG_SLUB_DEBUG=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_RCU_TRACE=n
CONFIG_TRACEFS_AUTOMOUNT_DEPRECATED=n

# ---- Module signing: enforced, with a key that exists for one build --------
# The threat is a root-level compromise loading a driver to get into ring 0,
# and an attacker with write access to /var swapping a module the kernel then
# trusts.  Enforcement is what makes the immutable image mean something at the
# kernel boundary: unsigned code cannot enter the kernel even from root.
#
# lockdown=integrity in the kargs refuses unsigned modules too, but only
# actually enforces under Secure Boot.  MODULE_SIG_FORCE holds with or without
# firmware help, which is the state most machines boot in today.
#
# Key lifecycle: tilo-crypto generates one key and certificate in the private
# builder stage. The DER certificate is compiled into the trusted keyring;
# after modules_install strips each module, tilo-crypto signs and verifies it.
# The private key is deleted before the scratch publication stage.
CONFIG_MODULE_SIG=y
# Tilo signs after install with tilo-crypto; upstream's automatic path builds a
# general-purpose libcrypto helper even though the resulting format is small.
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="/work/module-signing/signing-key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS=""
# Reject a module whose version magic does not match, rather than trying it.
CONFIG_MODVERSIONS=y
# Hardware drivers may enter only through the signed module path. Tilo never
# mutates a running kernel during an update: it installs a new signed UKI and
# reboots. Remove the inverse and bypass paths so even root cannot force an
# incompatible module, detach trusted kernel text, or install live patches.
CONFIG_MODULE_FORCE_LOAD=n
CONFIG_MODULE_UNLOAD=n
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_LIVEPATCH=n

# ---- Security features the rest of the image depends on --------------------
# These are not "extra hardening" — code in this tree stops working without
# them, so they are stated here rather than inherited on trust.
#
# USER_NS IS LOAD-BEARING.  Every workspace's app sandbox is bubblewrap, which
# creates an unprivileged user namespace before it drops anything.  Turning
# user namespaces off is a standard hardening recommendation and here it would
# delete the sandbox, leaving applications with more access rather than less.
# Constrain what a namespace can do from the inside (seccomp, Landlock,
# capabilities, cgroups) — never remove the ability to create one.
CONFIG_USER_NS=y
# seccomp-bpf: the per-workspace and per-package syscall filters.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Landlock: the path-scoped rulesets the launcher applies per package.
CONFIG_SECURITY_LANDLOCK=y
# Yama: kernel.yama.ptrace_scope, set to 3 in
# os/usr/lib/sysctl.d/60-tilo-hardening.conf.  Without the LSM the sysctl key
# does not exist and the setting silently does nothing.
CONFIG_SECURITY_YAMA=y
# Make the safe values active before sysctl is mounted and systemd applies the
# image policy. The sysctl remains an independently audited second layer.
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# Lockdown LSM, enabled early so lockdown=integrity applies from boot rather
# than from the point userspace would have set it.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# SELinux is Tilo's system MAC authority. The signed image never boots it
# disabled or permissive, so remove both kernel escape hatches rather than
# trusting command-line and setenforce policy forever.
CONFIG_SECURITY_SELINUX_BOOTPARAM=n
CONFIG_SECURITY_SELINUX_DEVELOP=n
# Do not compile or register parallel MAC frameworks for which the image ships
# no policy or loader. Landlock remains the deliberately unprivileged per-app
# restriction layer.
CONFIG_SECURITY_TOMOYO=n
CONFIG_SECURITY_IPE=n
# systemd 259 loads its BPF-LSM filesystem restriction program while PID 1 is
# starting. Keep the required BPF LSM and BTF support built in and register
# `bpf` explicitly, otherwise systemd fails before it can start any unit.
# Unprivileged BPF remains disabled above; this enables the privileged
# systemd RestrictFileSystems= enforcement path only.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_LSM=y
CONFIG_LSM="lockdown,yama,integrity,selinux,landlock,bpf"
# Architecture-specific control-flow protections live in x86_64.config and
# aarch64.config, merged after this shared fragment.

# ---- Kernel self-protection ------------------------------------------------
# All of these are compile-time or allocation-path changes with no measurable
# effect on the compositor's frame loop — none of them sit on a syscall the
# render path takes per frame.  The two knobs that WOULD cost something
# per-allocation, init_on_alloc and init_on_free, are deliberately left to the
# kargs in os/usr/lib/bootc/kargs.d/01-hardening.toml so they stay one boot
# away from being measured with and without.
#
# W^X for kernel memory, including module text.
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
# Randomize the kernel image base on every architecture. x86 additionally
# randomizes the direct physical-memory map, removing a second stable address
# oracle that would otherwise survive base KASLR.
CONFIG_RANDOMIZE_BASE=y
# Stack canaries and compile-time bounds checks inside the kernel itself.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
# Guard-paged kernel stacks: an overflow faults instead of corrupting the
# neighbouring thread's stack, and the scheduler re-checks the end marker.
CONFIG_VMAP_STACK=y
CONFIG_SCHED_STACK_END_CHECK=y
# copy_to/from_user validates that the object really lives where the caller
# claims, which is what stops a slab overflow from becoming an arbitrary read.
CONFIG_HARDENED_USERCOPY=y
# Slab freelist randomisation + pointer obfuscation, and no cache merging by
# default (the slab_nomerge karg says the same thing; this makes it the
# built-in default so the two cannot disagree).
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_MERGE_DEFAULT=n
# The frozen Linux 7.2 source treats RANDOM_KMALLOC_CACHES as transitional. Require
# the actual partitioned, randomized kmalloc cache mode in the saved config.
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_KMALLOC_PARTITION_RANDOM=y
# Free-list shuffling for the page allocator (the page_alloc.shuffle=1 karg's
# compile-time counterpart).
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
# Per-syscall kernel stack offset randomisation, opted in by the
# randomize_kstack_offset=on karg.
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
# Linked-list and plist integrity checks, and stop rather than continue when
# one trips: by the time a kernel list is corrupt, carrying on is the worse
# outcome.
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
# Raw physical memory windows.  lockdown=integrity blocks reads, but not
# compiling the windows in is what holds when lockdown is not enforced.
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_DEVKMEM=n
CONFIG_PROC_KCORE=n
# Monitor obtains RSS/virtual size from ordinary process accounting. Tilo does
# not run CRIU or restore process images, so remove checkpoint/restore and its
# soft-dirty tracker as well. MEM_SOFT_DIRTY otherwise selects page monitoring
# back on despite an explicit `n`, retaining physical page mappings,
# page-reference mutation, and the expensive per-VMA smaps parser.
CONFIG_CHECKPOINT_RESTORE=n
CONFIG_MEM_SOFT_DIRTY=n
CONFIG_PROC_PAGE_MONITOR=n
# Current terminals, containers, and compatibility runtimes use Unix98 devpts.
# Do not retain the fixed BSD PTY namespace or the legacy TIOCSTI ioctl that
# lets a process inject bytes into another process's controlling terminal.
CONFIG_LEGACY_PTYS=n
CONFIG_LEGACY_TIOCSTI=n
# Fault injection selects the proc page-monitor interface unconditionally.
CONFIG_HWPOISON_INJECT=n
# Desktop hardware discovery uses sysfs and ordinary CPUID instructions. It
# never needs root-facing character devices that expose raw I/O ports, MSRs,
# or per-CPU CPUID leaves, so omit those ambient kernel control surfaces.
# Tilo removes systemd-coredump and sets process dumpability policy to zero.
# Compile out the remaining kernel core-image writer so a crashing key-bearing
# process cannot be serialized through an overlooked core_pattern handler.
CONFIG_COREDUMP=n
# Drivers must not serialize firmware/device memory through devcoredump sysfs.
# Tilo has no crash-upload pipeline, and those blobs routinely contain device
# state or user traffic that should not survive a fault.
CONFIG_ALLOW_DEV_COREDUMP=n
# Recovery is provided by signed repair/rollback entries. Do not retain the
# keyboard and /proc trigger dispatcher that can sync, signal, remount, dump,
# or reboot the machine behind the lock screen when its runtime mask drifts.
CONFIG_MAGIC_SYSRQ=n
# Tilo always reboots through firmware into a signed UKI. It has no crash-kernel
# publication path and no reason to retain either kexec syscall in ring 0.
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_KEXEC_HANDOVER=n
# Swap is RAM-backed zram, so there is no persistent resume device. Compiling
# hibernation would retain an unused privileged image-restore parser.
CONFIG_HIBERNATION=n
# Tilo has no crash-upload or pstore recovery workflow, and deliberately keeps
# key-bearing process/kernel diagnostics off persistent storage. Do not expose
# firmware/ram crash-record backends merely to mask their userspace copier.
CONFIG_PSTORE=n
# APEI selects persistent firmware error storage; omit that reporting facility
# together with pstore rather than silently restoring the disabled subsystem.
CONFIG_ACPI_APEI=n
# Firmware is immutable image content loaded directly by the kernel. Never
# invoke a userspace fallback helper for a missing blob: besides expanding the
# privileged loading boundary, that path can hold boot for its request timeout.
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=n
# Firmware tables are accepted only from the platform at boot. The custom AML
# method and configfs SSDT loaders are kernel-development mechanisms that let
# local root inject firmware-described devices and executable AML at runtime.
CONFIG_ACPI_CUSTOM_METHOD=n
CONFIG_ACPI_CONFIGFS=n
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=n
# Wine/Proton, VMs, and app runtimes are launched through explicit trusted
# executors. Do not expose a global root-configurable interpreter registry that
# can redirect execution of otherwise unknown binary formats.
CONFIG_BINFMT_MISC=n
# Remove network families that have no Tilo consumer or supported desktop use.
# Each otherwise exposes a privileged parser/state machine to local sockets or
# received packets (and HAMRADIO also selects AX.25, NET/ROM, and ROSE).
CONFIG_ATM=n
# AppleTalk/DDP and mISDN serve legacy LAN and telephony hardware that Tilo
# neither discovers nor supports. Both accept untrusted protocol frames in
# kernel space, so do not retain their socket, datalink, or device parsers.
CONFIG_ATALK=n
CONFIG_CAN=n
CONFIG_CAIF=n
CONFIG_HAMRADIO=n
CONFIG_6LOWPAN=n
CONFIG_AF_RXRPC=n
CONFIG_IEEE802154=n
CONFIG_IP_DCCP=n
CONFIG_IP_SCTP=n
CONFIG_AF_KCM=n
CONFIG_LAPB=n
CONFIG_L2TP=n
CONFIG_MCTP=n
CONFIG_MISDN=n
CONFIG_MPLS=n
# Open vSwitch selects MPLS and NSH; the desktop does not need this virtual
# switch datapath. Ordinary bridges and network interfaces remain available.
CONFIG_OPENVSWITCH=n
CONFIG_NET_NSH=n
CONFIG_NFC=n
CONFIG_PHONET=n
CONFIG_RDS=n
CONFIG_SMC=n
# NetworkManager exposes WireGuard for encrypted tunnels; the image ships no
# IPsec/IKE daemon or VPN plugin. Remove PF_KEY, XFRM userspace control and the
# IPv4/IPv6 AH/ESP/IPComp packet handlers rather than leaving a second dormant
# privileged tunnel stack reachable through sockets and received packets.
CONFIG_NET_KEY=n
CONFIG_XFRM_USER=n
CONFIG_XFRM_INTERFACE=n
CONFIG_INET_AH=n
CONFIG_INET_ESP=n
CONFIG_INET_IPCOMP=n
CONFIG_INET6_AH=n
CONFIG_INET6_ESP=n
CONFIG_INET6_IPCOMP=n
# No Tilo transport opens IPPROTO_MPTCP or manages subflows. Keep the ordinary
# TCP implementation and omit the additional multipath control, fallback, and
# diagnostic state machines inherited from a general-purpose distro kernel.
CONFIG_MPTCP=n
CONFIG_INET_MPTCP_DIAG=n
# The desktop receives ordinary IPv4/IPv6 multicast but never acts as a PIM
# router. It also does not expose SRv6 or IOAM policy. Omit those forwarding,
# extension-header, netlink and BPF attachment paths while keeping IPv6 itself.
CONFIG_IP_MROUTE=n
CONFIG_IPV6_MROUTE=n
CONFIG_IPV6_SEG6_LWTUNNEL=n
CONFIG_IPV6_SEG6_HMAC=n
CONFIG_IPV6_SEG6_BPF=n
CONFIG_IPV6_IOAM6_LWTUNNEL=n
# Rustls terminates Tilo TLS in userspace. The kernel TLS ULP is unused, so do
# not retain a second privileged record/encryption and hardware-offload path.
CONFIG_TLS=n
# Tilo is neither a datacenter load balancer nor a mobile carrier gateway. It
# has no PSP key manager, IPVS control plane, GTP/PFCP daemon, or AMT relay.
# Omit those packet-processing state machines, along with pktgen's privileged
# arbitrary packet injector used only for network stress testing.
CONFIG_INET_PSP=n
CONFIG_IP_VS=n
CONFIG_NET_PKTGEN=n
CONFIG_GTP=n
CONFIG_PFCP=n
CONFIG_AMT=n
# Local PCIe NVMe remains available. Tilo remote storage is QuickFS and the
# image ships no iSCSI, FCoE, NVMe-oF, or kernel NBD client/server, so omit
# their network-facing command parsers, discovery paths, and target machinery.
CONFIG_BLK_DEV_NBD=n
CONFIG_ISCSI_TCP=n
CONFIG_ISCSI_BOOT_SYSFS=n
# These alternate firmware, RDMA, and NIC-offload consumers select the shared
# iSCSI interfaces independently of the software TCP client.
CONFIG_ISCSI_IBFT=n
CONFIG_SCSI_QLA_ISCSI=n
CONFIG_SCSI_BNX2_ISCSI=n
CONFIG_SCSI_CXGB3_ISCSI=n
CONFIG_SCSI_CXGB4_ISCSI=n
CONFIG_INFINIBAND_ISER=n
CONFIG_BE2ISCSI=n
CONFIG_QEDI=n
CONFIG_SCSI_ISCSI_ATTRS=n
CONFIG_FCOE=n
CONFIG_FCOE_FNIC=n
CONFIG_QEDF=n
CONFIG_SCSI_BNX2X_FCOE=n
CONFIG_SCSI_CHELSIO_FCOE=n
CONFIG_LIBFCOE=n
# Fibre Channel SAN host adapters are another independent remote-storage path;
# disabling their transport class removes libfc and all dependent QLogic,
# Emulex, Brocade and Fusion FC drivers while retaining local SCSI/SAS disks.
CONFIG_SCSI_FC_ATTRS=n
CONFIG_NET_FC=n
CONFIG_NVME_RDMA=n
CONFIG_NVME_FC=n
CONFIG_NVME_TCP=n
CONFIG_NVME_TARGET=n
CONFIG_NVME_HOST_AUTH=n
CONFIG_NVME_AUTH=n
CONFIG_NVME_KEYRING=n
# Remove the separate RDMA block client/server and generic configfs-backed
# storage-export framework. Ordinary virtio block devices used by local VMs do
# not depend on either host-side network target facility.
CONFIG_BLK_DEV_RNBD_CLIENT=n
CONFIG_BLK_DEV_RNBD_SERVER=n
CONFIG_TARGET_CORE=n
# Tilo has no RDMA application or management stack. QuickFS uses authenticated
# userspace networking, games use ordinary IP sockets, and local VM storage is
# virtio-backed. Omit the InfiniBand userspace ABI, configfs control plane,
# software transports and protocol-specific hardware drivers; Ethernet NIC
# drivers remain available independently.
CONFIG_INFINIBAND=n
CONFIG_NVME_TCP_TLS=n
CONFIG_NVME_TARGET_TCP_TLS=n
CONFIG_TIPC=n
CONFIG_X25=n

# Tilo cryptographic callers use memory-safe userspace implementations; LUKS,
# WireGuard, and module verification consume the kernel crypto API internally.
# None needs AF_ALG sockets, whose cipher/hash/RNG/AEAD request parsers would
# otherwise be reachable by every sandboxed local process.
CONFIG_CRYPTO_USER_API=n
CONFIG_CRYPTO_USER_API_HASH=n
CONFIG_CRYPTO_USER_API_SKCIPHER=n
CONFIG_CRYPTO_USER_API_RNG=n
CONFIG_CRYPTO_USER_API_AEAD=n
CONFIG_CRYPTO_USER_API_ENABLE_OBSOLETE=n

# Tilo authenticates the immutable root with the signed UKI's composefs digest
# and dm-verity, and authenticates modules with forced signatures. It ships no
# IMA policy or EVM xattr authority. Remove those duplicate per-file LSM hooks,
# runtime policy interfaces and mutable security.ima/security.evm parsers while
# retaining the integrity keyrings needed by dm-verity and platform trust.
CONFIG_IMA=n
CONFIG_EVM=n
# Keep the keyring core and immutable trust keyrings used for module and
# dm-verity verification, but omit unused user-instantiable key types and
# notification/DH operations. Tilo's TPM secrets use bounded userspace TPM2
# policies rather than the kernel trusted/encrypted-key payload parsers.
CONFIG_PERSISTENT_KEYRINGS=n
CONFIG_BIG_KEYS=n
CONFIG_TRUSTED_KEYS=n
CONFIG_ENCRYPTED_KEYS=n
CONFIG_KEY_DH_OPERATIONS=n
CONFIG_KEY_NOTIFICATIONS=n
# Firmware validates PE images before execution; the kernel cannot kexec and
# no longer runs IMA appraisal. Runtime blacklist mutation is unnecessary on
# an immutable signed-image update model, while the firmware dbx-derived
# blacklist and PKCS#7 module verification remain compiled.
CONFIG_SIGNED_PE_FILE_VERIFICATION=n
CONFIG_SYSTEM_BLACKLIST_AUTH_UPDATE=n
# Avoid per-decision AVC statistics updates; SELinux enforcement and audit
# denial records remain fully active.
CONFIG_SECURITY_SELINUX_AVC_STATS=n

# Fedora's general-purpose kernel accepts a long tail of obsolete local disk
# formats. Tilo neither boots from nor offers an importer for these formats, so
# letting an untrusted USB image reach their privileged parsers is pure attack
# surface. Keep mainstream interchange filesystems (VFAT/exFAT/NTFS, HFS+),
# optical media and SquashFS/EROFS unchanged. Tilo remote storage is QuickFS;
# it does not expose kernel NFS/SMB/Ceph/9P mounts, so those packet-to-kernel
# parsers are omitted as well rather than retained as signed loadable code.
CONFIG_AFFS_FS=n
CONFIG_ADFS_FS=n
CONFIG_BEFS_FS=n
CONFIG_BFS_FS=n
# Tilo supports Btrfs, Ext4 and XFS for local data. It has no bcache management
# or Bcachefs import/format path, so do not inherit their large block-mapping,
# journal and on-disk metadata parsers from Fedora.
CONFIG_BCACHE=n
CONFIG_BCACHEFS_FS=n
CONFIG_CRAMFS=n
CONFIG_EFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_HFS_FS=n
CONFIG_HPFS_FS=n
CONFIG_JFS_FS=n
CONFIG_MINIX_FS=n
CONFIG_NILFS2_FS=n
CONFIG_OMFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_ORANGEFS_FS=n
CONFIG_QNX4FS_FS=n
CONFIG_QNX6FS_FS=n
CONFIG_ROMFS_FS=n
CONFIG_SYSV_FS=n
CONFIG_UFS_FS=n
CONFIG_VXFS_FS=n

# Tilo shares workspaces through the authenticated userspace QuickFS protocol.
# No shipped service mounts a kernel network filesystem, and the local-root
# initramfs explicitly omits NFS. Removing these clients/servers prevents an
# app or compromised privileged service from reaching their kernel parsers.
CONFIG_9P_FS=n
CONFIG_AFS_FS=n
CONFIG_CEPH_FS=n
CONFIG_CIFS=n
CONFIG_CODA_FS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
# The OS has no Ceph/RBD, DRBD, or ATA-over-Ethernet control plane. Their
# network-facing block clients remain privileged packet and state-machine
# surface even without a mounted filesystem, so omit them independently.
CONFIG_BLK_DEV_RBD=n
CONFIG_BLK_DEV_DRBD=n
CONFIG_ATA_OVER_ETH=n
# ublk delegates a block device to io_uring workers. null_blk exists for
# block-layer benchmarks and fault injection. Neither should remain as trusted
# production driver surface.
CONFIG_BLK_DEV_UBLK=n
CONFIG_BLK_DEV_NULL_BLK=n
# Production storage keeps real SCSI/NVMe and dm-crypt/verity targets, not the
# synthetic SCSI device, deliberately unreliable device-mapper targets, or
# kernel fault-injection framework used by subsystem test suites.
CONFIG_SCSI_DEBUG=n
CONFIG_DM_DELAY=n
CONFIG_DM_FLAKEY=n
CONFIG_DM_DUST=n
CONFIG_FAULT_INJECTION=n
CONFIG_LKDTM=n

# Disk discovery needs GPT and DOS/MBR. These workstation-irrelevant legacy
# partition maps otherwise parse arbitrary sector zero metadata as soon as a
# removable device appears, before a userspace mount policy can help.
CONFIG_ACORN_PARTITION=n
CONFIG_AMIGA_PARTITION=n
CONFIG_ATARI_PARTITION=n
CONFIG_KARMA_PARTITION=n
CONFIG_SGI_PARTITION=n
CONFIG_SUN_PARTITION=n
CONFIG_ULTRIX_PARTITION=n
#
# io_uring was already disabled globally at runtime and has no Tilo consumer;
# compile out its syscall, worker, fixed-buffer, and command parsers rather
# than retaining unreachable code in every kernel. Async Tilo services use
# epoll, and ublk (its only in-tree dependent feature here) is also absent.
CONFIG_IO_URING=n
# userfaultfd was likewise restricted at runtime and has no consumer. Tilo
# does not support CRIU or VM post-copy migration; ordinary KVM guests and
# Wine/Proton do not require this process-controlled page-fault interface.
CONFIG_USERFAULTFD=n
# systemd path activation and desktop file watching use inotify. Tilo has no
# malware scanner or hierarchical storage manager requiring privileged
# fanotify permission events, and no consumer of the obsolete fcntl dnotify
# ABI. Keep inotify and omit the two redundant filesystem-observation APIs.
CONFIG_FANOTIFY=n
CONFIG_DNOTIFY=n
# QuickFS uses the ordinary /dev/fuse request protocol. It never creates
# userspace character devices or hands kernel I/O through to backing-file
# descriptors, so omit CUSE's unrestricted-ioctl path and FUSE passthrough.
CONFIG_CUSE=n
CONFIG_FUSE_PASSTHROUGH=n
# Kata uses a chrooted userspace virtiofsd as the host-side server; the Tilo
# host kernel never mounts a virtio-fs share. Remove its guest/client parser and
# the direct host-memory DAX mapping path. io_uring itself is absent, so keep
# the alternative FUSE request transport explicitly absent as well.
CONFIG_VIRTIO_FS=n
CONFIG_FUSE_DAX=n
CONFIG_FUSE_IO_URING=n

# Not set here, on purpose: DEBUG_WX is a cheap boot-time W^X assertion
# selected by DEBUG_KERNEL.

# ---- Retain: things stock Fedora config already sets, but that we want to
# reaffirm here so a future Fedora-side deselect wouldn't silently break us --
# The ESP is FAT; without VFAT_FS the initrd-less boot can't stat /boot.
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
