# Tilo kernel config overrides.
#
# Layered on top of Fedora's stock kernel config via merge_config.sh, then
# resolved with `make olddefconfig`.  Every entry here is either:
#   (a) a boot-path driver we want built-in (=y) so the UKI's initramfs does
#       not need to discover and load it before mounting the root filesystem, or
#   (b) a scheduler/latency tunable for interactive desktop throughput, or
#   (c) a debug/tracing option we deliberately turn off to shrink the RPM +
#       cut build time (a full DEBUG_INFO=y build produces ~1 GB of
#       kernel-debuginfo, which we don't ship on the OS image).
#
# When adding a driver: prefer =y (built-in) only if it's on the boot path or
# universally needed (HID_GENERIC).  Everything else stays =m so /lib/modules
# stays curated.

# ---- Storage (root FS + block) --------------------------------------------
# virtio-blk / virtio-scsi cover every VM and the qemu-based dev flow;
# NVMe covers modern laptops/desktops; SATA/AHCI covers older machines.
# Built-in = kernel walks /dev at rootfs mount without loading a module.
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y

# ---- Filesystems (root candidates + /boot) --------------------------------
# Btrfs is the only supported Tilo root and therefore remains built in. XFS and
# ext4 are needed only for rescue/alongside-install inspection after the root
# and signed module store are available; keeping them modular removes two large
# parsers from every resident kernel and compressed UKI without dropping them.
# The ESP mounts as vfat via built-in FAT support carried below.
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=m
CONFIG_EXT4_FS=m

# ---- USB (needed to see a keyboard on physical hardware before login) -----
# xHCI covers every USB3 host; EHCI covers older USB2 chipsets.  Built-in
# so the pre-userspace stage can see a keyboard for e.g. LUKS unlock.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_HID_GENERIC=y

# ---- Network (deliberately outside the boot path) -------------------------
# virtio-net covers every VM. e1000e/igb/r8169 cover the common Intel/Realtek
# laptop and desktop NICs; iwlwifi covers Intel Wi-Fi. Networking is not needed
# to mount the immutable root or reach the greeter, and peer services tolerate
# it arriving later. Keep all of these as signed modules so their probe/code is
# absent from the always-resident kernel and the compressed UKI is smaller.
CONFIG_VIRTIO_NET=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_R8169=m
CONFIG_IWLWIFI=m

# ---- Console / paravirt bits ----------------------------------------------
# virtio-gpu carries the console framebuffer in every VM we test with.
# virtio-console gives us a serial-equivalent for qemu-boot-measure.sh.
# virtio-rng seeds /dev/random early (cuts boot randomness stalls in VMs).
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# ---- Scheduler / latency tuning -------------------------------------------
# Full preemption for interactive latency: any kernel task can be preempted
# by a higher-priority one, so a click/keystroke never queues behind a
# kernel worker.  This trades a small amount of throughput for consistent
# desktop responsiveness.  PREEMPT_NONE / PREEMPT_VOLUNTARY are mutually
# exclusive with PREEMPT (Kconfig `choice` — olddefconfig will clear them).
CONFIG_PREEMPT=y
CONFIG_PREEMPT_VOLUNTARY=n
CONFIG_PREEMPT_NONE=n
# Keep the preemption model runtime-selectable. Full preemption remains the
# default above, while a benchmark or throughput-heavy workload can select
# preempt=voluntary without requiring a second kernel build.
CONFIG_PREEMPT_DYNAMIC=y

# Group tasks by their controlling terminal/session before applying nice
# weights. This stops a compile, game shader build, or decompression job from
# monopolising every CPU while the compositor and input path are runnable.
CONFIG_SCHED_AUTOGROUP=y

# 1000 Hz timer tick: the compositor's frame-pacing loop and scheduler
# wake-ups get 1 ms resolution instead of Fedora's default 250 Hz (4 ms).
# Cost is a small % more timer overhead; the win is stable frame delivery.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HZ_100=n
CONFIG_HZ_250=n
CONFIG_HZ_300=n

# THP=madvise: large, intentionally contiguous allocations can opt in without
# making an input/render thread enter direct compaction. THP=always improves a
# few throughput benchmarks but produces severe frame-time outliers once RAM
# is fragmented, which is the wrong trade for a desktop and gaming kernel.
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=n
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Multi-core scheduler awareness: pick a runqueue that respects the CPU
# package/cache topology (better locality on modern multi-die parts).
CONFIG_SCHED_MC=y
# Let the scheduler prefer the fastest cores exposed by Intel Thread Director /
# Turbo Boost Max and AMD CPPC. This is especially important to render and game
# threads on heterogeneous CPUs; without it they can land on an efficiency core
# while a background compiler occupies a preferred core.
CONFIG_SCHED_MC_PRIO=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3

# Intel/AMD P-state own frequency selection on most target machines. For CPUs
# that expose only generic cpufreq, schedutil must be the default rather than
# the latency-insensitive powersave governor. IRQ accounting gives schedutil a
# complete utilization signal instead of treating interrupt-heavy render/input
# work as idle time.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_IRQ_TIME_ACCOUNTING=y

# Frame pacing and input timers need sub-jiffy deadlines even though the base
# scheduler tick is 1 kHz. Stop periodic ticks on idle CPUs to reduce wakeups
# and leave more package power/thermal budget for the active game threads.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_PERIODIC=n
CONFIG_NO_HZ_FULL=n

# Expose utilization clamps to cgroups so a compositor, game scope, or explicit
# performance profile can request prompt frequency ramp-up without pinning the
# whole machine at maximum frequency. Keep the upstream five-bucket cost bound.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_ENERGY_MODEL=y

# Upstream Windows NT synchronization primitives. Current Wine/Proton uses
# the descriptor-scoped /dev/ntsync ABI for cheaper waits and wakeups, which
# improves frame pacing without carrying an out-of-tree futex patch set or a
# privileged userspace daemon.
CONFIG_NTSYNC=y

# BFQ provides per-process proportional I/O scheduling and honors the
# best-effort priority level inherited by game processes. Tilo selects it only
# for physical NVMe/SCSI disks via udev; virtio release VMs and dm/loop devices
# retain their kernel-selected scheduler.
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_DEADLINE=y

# Prefer low-latency module decompression. Zstd is substantially faster than
# XZ during cold boot while retaining enough compression for the immutable
# image; module signatures cover the module before compression.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_XZ=n
CONFIG_MODULE_COMPRESS_ALL=y
# The signed UKI carries an external dracut initramfs. Zstandard gives much
# lower cold-boot decompression latency than xz while retaining useful image
# compression; keep decoder support built into the kernel.
CONFIG_RD_ZSTD=y

# zram sits on the interactive memory-pressure path. LZ4 trades some ratio for
# much lower compression/decompression latency than zstd, avoiding long stalls
# when a game or shader compiler first pushes the desktop into swap.
CONFIG_CRYPTO_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# ---- Trim: debug + tracing we don't ship ----------------------------------
# Fedora ships kernel + kernel-debuginfo; Tilo ships only kernel.  Disabling
# DEBUG_INFO drops build time by ~10 min and image size by ~800 MB.
# DEBUG_INFO_NONE selects the modern Kconfig choice explicitly. DEBUG_KERNEL
# itself remains enabled because current kernel compile-time checks select it;
# expensive DWARF and KGDB output stay off.
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_KGDB=n

# Fedora's generic kernel enables instrumentation intended for diagnosing any
# workload.  Tilo keeps perf/eBPF available for game profiling, but removes the
# always-compiled sanitizers and tracing hooks from the shipped kernel. UBSAN
# inserts checks throughout hot paths; function tracing reserves entry hooks
# in nearly every function even while no tracer is selected. Page-owner and
# scheduler statistics are opt-in at runtime, but retaining their collection
# machinery still costs memory/text and exposes diagnostic surface we do not
# use in the image.
CONFIG_UBSAN=n
CONFIG_FUNCTION_TRACER=n
CONFIG_STACK_TRACER=n
CONFIG_HIST_TRIGGERS=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_LATENCYTOP=n
CONFIG_SCHEDSTATS=n
CONFIG_PAGE_OWNER=n
# Never ship Fedora's broad kernel unit-test bundle as trusted, loadable code.
# It is useful to distribution kernel developers, not to an immutable desktop.
CONFIG_KUNIT=n
CONFIG_ASYNC_RAID6_TEST=n
CONFIG_EFI_TEST=n
CONFIG_LOCK_TORTURE_TEST=n
CONFIG_RCU_TORTURE_TEST=n
CONFIG_SND_PCMTEST=n
CONFIG_SND_SOC_INTEL_AVS_MACH_I2S_TEST=n
CONFIG_TEST_BPF=n
CONFIG_TEST_HMM=n
CONFIG_TEST_KMOD=n
CONFIG_TEST_LKM=n
CONFIG_TEST_LOCKUP=n
CONFIG_TEST_VMALLOC=n
CONFIG_CRYPTO_BENCHMARK=n
CONFIG_RING_BUFFER_BENCHMARK=n
CONFIG_X86_AMD_PSTATE_UT=n
# Fedora enables synthetic hardware for kernel/network test laboratories. Tilo
# needs real VM devices, not fake endpoints that become trusted modules.
CONFIG_GPIO_SIM=n
CONFIG_IEEE802154_FAKELB=n
CONFIG_MAC80211_HWSIM=n
CONFIG_MTD_NAND_NANDSIM=n
CONFIG_NETDEVSIM=n
CONFIG_NFC_SIM=n
CONFIG_STM_DUMMY=n
CONFIG_USB_DUMMY_HCD=n
CONFIG_VDPA_SIM=n
CONFIG_WWAN_HWSIM=n
# Runtime Verification's trace monitors/reactors are kernel-developer tools;
# they add trusted trace machinery and are not part of Tilo health monitoring.
CONFIG_RV=n
CONFIG_MEDIA_TEST_SUPPORT=n
# This validates exported headers during a distribution build; Tilo consumes
# Fedora's prepared source and does not publish a kernel-headers package.
CONFIG_UAPI_HEADER_TEST=n

# ---- Module signing: enforced, with a key that exists for one build --------
# The threat is a root-level compromise loading a driver to get into ring 0,
# and an attacker with write access to /var swapping a module the kernel then
# trusts.  Enforcement is what makes the immutable image mean something at the
# kernel boundary: unsigned code cannot enter the kernel even from root.
#
# lockdown=integrity in the kargs refuses unsigned modules too, but only
# actually enforces under Secure Boot.  MODULE_SIG_FORCE holds with or without
# firmware help, which is the state most machines boot in today.
#
# Key lifecycle: tilo-crypto generates one key and certificate in the private
# builder stage. The DER certificate is compiled into the trusted keyring;
# after modules_install strips each module, tilo-crypto signs and verifies it.
# The private key is deleted before the scratch publication stage.
CONFIG_MODULE_SIG=y
# Tilo signs after install with tilo-crypto; upstream's automatic path builds a
# general-purpose libcrypto helper even though the resulting format is small.
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="/work/module-signing/signing-key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS=""
# Reject a module whose version magic does not match, rather than trying it.
CONFIG_MODVERSIONS=y
# Hardware drivers may enter only through the signed module path. Tilo never
# mutates a running kernel during an update: it installs a new signed UKI and
# reboots. Remove the inverse and bypass paths so even root cannot force an
# incompatible module, detach trusted kernel text, or install live patches.
CONFIG_MODULE_FORCE_LOAD=n
CONFIG_MODULE_UNLOAD=n
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_LIVEPATCH=n

# ---- Security features the rest of the image depends on --------------------
# These are not "extra hardening" — code in this tree stops working without
# them, so they are stated here rather than inherited on trust.
#
# USER_NS IS LOAD-BEARING.  Every workspace's app sandbox is bubblewrap, which
# creates an unprivileged user namespace before it drops anything.  Turning
# user namespaces off is a standard hardening recommendation and here it would
# delete the sandbox, leaving applications with more access rather than less.
# Constrain what a namespace can do from the inside (seccomp, Landlock,
# capabilities, cgroups) — never remove the ability to create one.
CONFIG_USER_NS=y
# seccomp-bpf: the per-workspace and per-package syscall filters.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Landlock: the path-scoped rulesets the launcher applies per package.
CONFIG_SECURITY_LANDLOCK=y
# Yama: kernel.yama.ptrace_scope, set to 3 in
# os/usr/lib/sysctl.d/60-tilo-hardening.conf.  Without the LSM the sysctl key
# does not exist and the setting silently does nothing.
CONFIG_SECURITY_YAMA=y
# Make the safe values active before sysctl is mounted and systemd applies the
# image policy. The sysctl remains an independently audited second layer.
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# Lockdown LSM, enabled early so lockdown=integrity applies from boot rather
# than from the point userspace would have set it.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# Hardware shadow stacks for userspace.  Every binary this tree builds is
# marked shadow-stack compatible (see .cargo/config.toml); without this symbol
# the mark has nothing to activate against and the protection is inert.
CONFIG_X86_USER_SHADOW_STACK=y

# ---- Kernel self-protection ------------------------------------------------
# All of these are compile-time or allocation-path changes with no measurable
# effect on the compositor's frame loop — none of them sit on a syscall the
# render path takes per frame.  The two knobs that WOULD cost something
# per-allocation, init_on_alloc and init_on_free, are deliberately left to the
# kargs in os/usr/lib/bootc/kargs.d/01-hardening.toml so they stay one boot
# away from being measured with and without.
#
# W^X for kernel memory, including module text.
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
# Randomize the kernel image base on every architecture. x86 additionally
# randomizes the direct physical-memory map, removing a second stable address
# oracle that would otherwise survive base KASLR.
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
# Stack canaries and compile-time bounds checks inside the kernel itself.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
# Guard-paged kernel stacks: an overflow faults instead of corrupting the
# neighbouring thread's stack, and the scheduler re-checks the end marker.
CONFIG_VMAP_STACK=y
CONFIG_SCHED_STACK_END_CHECK=y
# copy_to/from_user validates that the object really lives where the caller
# claims, which is what stops a slab overflow from becoming an arbitrary read.
CONFIG_HARDENED_USERCOPY=y
# Slab freelist randomisation + pointer obfuscation, and no cache merging by
# default (the slab_nomerge karg says the same thing; this makes it the
# built-in default so the two cannot disagree).
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_MERGE_DEFAULT=n
CONFIG_RANDOM_KMALLOC_CACHES=y
# Free-list shuffling for the page allocator (the page_alloc.shuffle=1 karg's
# compile-time counterpart).
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
# Per-syscall kernel stack offset randomisation, opted in by the
# randomize_kstack_offset=on karg.
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
# Linked-list and plist integrity checks, and stop rather than continue when
# one trips: by the time a kernel list is corrupt, carrying on is the worse
# outcome.
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
# Indirect Branch Tracking for kernel text.  This one IS compiler-backed —
# the kernel is built with -fcf-protection, unlike stable Rust.
CONFIG_X86_KERNEL_IBT=y
# The legacy vsyscall page is a fixed-address executable region, i.e. a ready
# made ROP target (the vsyscall=none karg's compile-time default).
CONFIG_LEGACY_VSYSCALL_NONE=y
# Raw physical memory windows.  lockdown=integrity blocks reads, but not
# compiling the windows in is what holds when lockdown is not enforced.
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_DEVKMEM=n
CONFIG_PROC_KCORE=n
# Desktop hardware discovery uses sysfs and ordinary CPUID instructions. It
# never needs root-facing character devices that expose raw I/O ports, MSRs,
# or per-CPU CPUID leaves, so omit those ambient kernel control surfaces.
CONFIG_DEVPORT=n
CONFIG_X86_MSR=n
CONFIG_X86_CPUID=n
# Tilo removes systemd-coredump and sets process dumpability policy to zero.
# Compile out the remaining kernel core-image writer so a crashing key-bearing
# process cannot be serialized through an overlooked core_pattern handler.
CONFIG_COREDUMP=n
# Tilo always reboots through firmware into a signed UKI. It has no crash-kernel
# publication path and no reason to retain either kexec syscall in ring 0.
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_KEXEC_HANDOVER=n
# Swap is RAM-backed zram, so there is no persistent resume device. Compiling
# hibernation would retain an unused privileged image-restore parser.
CONFIG_HIBERNATION=n
# Tilo has no crash-upload or pstore recovery workflow, and deliberately keeps
# key-bearing process/kernel diagnostics off persistent storage. Do not expose
# firmware/ram crash-record backends merely to mask their userspace copier.
CONFIG_PSTORE=n
# Firmware is immutable image content loaded directly by the kernel. Never
# invoke a userspace fallback helper for a missing blob: besides expanding the
# privileged loading boundary, that path can hold boot for its request timeout.
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=n
# Firmware tables are accepted only from the platform at boot. The custom AML
# method and configfs SSDT loaders are kernel-development mechanisms that let
# local root inject firmware-described devices and executable AML at runtime.
CONFIG_ACPI_CUSTOM_METHOD=n
CONFIG_ACPI_CONFIGFS=n
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=n
# Wine/Proton, VMs, and app runtimes are launched through explicit trusted
# executors. Do not expose a global root-configurable interpreter registry that
# can redirect execution of otherwise unknown binary formats.
CONFIG_BINFMT_MISC=n
# Remove network families that have no Tilo consumer or supported desktop use.
# Each otherwise exposes a privileged parser/state machine to local sockets or
# received packets (and HAMRADIO also selects AX.25, NET/ROM, and ROSE).
CONFIG_ATM=n
CONFIG_CAN=n
CONFIG_CAIF=n
CONFIG_HAMRADIO=n
CONFIG_6LOWPAN=n
CONFIG_AF_RXRPC=n
CONFIG_IEEE802154=n
CONFIG_IP_DCCP=n
CONFIG_IP_SCTP=n
CONFIG_AF_KCM=n
CONFIG_LAPB=n
CONFIG_L2TP=n
CONFIG_MCTP=n
CONFIG_MPLS=n
CONFIG_NET_NSH=n
CONFIG_NFC=n
CONFIG_PHONET=n
CONFIG_RDS=n
CONFIG_SMC=n
# Rustls terminates Tilo TLS in userspace. The kernel TLS ULP is unused, so do
# not retain a second privileged record/encryption and hardware-offload path.
CONFIG_TLS=n
CONFIG_TIPC=n
CONFIG_X25=n

# Tilo cryptographic callers use memory-safe userspace implementations; LUKS,
# WireGuard, and module verification consume the kernel crypto API internally.
# None needs AF_ALG sockets, whose cipher/hash/RNG/AEAD request parsers would
# otherwise be reachable by every sandboxed local process.
CONFIG_CRYPTO_USER_API=n
CONFIG_CRYPTO_USER_API_HASH=n
CONFIG_CRYPTO_USER_API_SKCIPHER=n
CONFIG_CRYPTO_USER_API_RNG=n
CONFIG_CRYPTO_USER_API_AEAD=n
CONFIG_CRYPTO_USER_API_ENABLE_OBSOLETE=n

# Fedora's general-purpose kernel accepts a long tail of obsolete local disk
# formats. Tilo neither boots from nor offers an importer for these formats, so
# letting an untrusted USB image reach their privileged parsers is pure attack
# surface. Keep mainstream interchange filesystems (VFAT/exFAT/NTFS, HFS+),
# optical media and SquashFS/EROFS unchanged. Tilo remote storage is QuickFS;
# it does not expose kernel NFS/SMB/Ceph/9P mounts, so those packet-to-kernel
# parsers are omitted as well rather than retained as signed loadable code.
CONFIG_AFFS_FS=n
CONFIG_ADFS_FS=n
CONFIG_BEFS_FS=n
CONFIG_BFS_FS=n
CONFIG_CRAMFS=n
CONFIG_EFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_HFS_FS=n
CONFIG_HPFS_FS=n
CONFIG_JFS_FS=n
CONFIG_MINIX_FS=n
CONFIG_NILFS2_FS=n
CONFIG_OMFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_ORANGEFS_FS=n
CONFIG_QNX4FS_FS=n
CONFIG_QNX6FS_FS=n
CONFIG_ROMFS_FS=n
CONFIG_SYSV_FS=n
CONFIG_UFS_FS=n
CONFIG_VXFS_FS=n

# Tilo shares workspaces through the authenticated userspace QuickFS protocol.
# No shipped service mounts a kernel network filesystem, and the local-root
# initramfs explicitly omits NFS. Removing these clients/servers prevents an
# app or compromised privileged service from reaching their kernel parsers.
CONFIG_9P_FS=n
CONFIG_AFS_FS=n
CONFIG_CEPH_FS=n
CONFIG_CIFS=n
CONFIG_CODA_FS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n

# Disk discovery needs GPT and DOS/MBR. These workstation-irrelevant legacy
# partition maps otherwise parse arbitrary sector zero metadata as soon as a
# removable device appears, before a userspace mount policy can help.
CONFIG_ACORN_PARTITION=n
CONFIG_AMIGA_PARTITION=n
CONFIG_ATARI_PARTITION=n
CONFIG_KARMA_PARTITION=n
CONFIG_SGI_PARTITION=n
CONFIG_SUN_PARTITION=n
CONFIG_ULTRIX_PARTITION=n
#
# Not set here, on purpose:
#   CONFIG_IO_URING=n — io_uring is a large, fast-moving surface that nothing
#     in this tree uses, but it is switched off at run time via
#     kernel.io_uring_disabled=2 instead.  A sysctl gives a clean EPERM if a
#     future component turns out to need it; compiling it out gives a missing
#     syscall and a sysctl key systemd then warns about on every boot.
#   DEBUG_WX — a cheap boot-time W^X assertion selected by DEBUG_KERNEL.

# ---- Retain: things stock Fedora config already sets, but that we want to
# reaffirm here so a future Fedora-side deselect wouldn't silently break us --
# The ESP is FAT; without VFAT_FS the initrd-less boot can't stat /boot.
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
