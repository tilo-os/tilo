# Per-architecture WPE buildroots. The protected snapshot-wpe-buildroot
# workflow writes digest-pinned refs here after building and signing both.
# Empty pins are an intentional bootstrap state: release CI fails closed, while
# local developers can explicitly set QOS_WPE_BOOTSTRAP=1 to build one locally.
WPE_BUILDROOT_X86_64_REF=
WPE_BUILDROOT_AARCH64_REF=
