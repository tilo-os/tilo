# The Fedora bootc base every Tilo image builds FROM — mirrored into the
# registry and pinned by digest, beside the fingerprint-resolved frozen RPM
# repository.
#
# Why the mirror: Fedora rebuilds the fedora-bootc tag daily and garbage-
# collects the manifest it replaces almost immediately, so a pin straight at
# quay.io stops resolving after about a day ("manifest unknown") and every
# image build dies at its first FROM — including the snapshot-rpms job, so the
# package set can't be refreshed either. Our registry collects nothing, so a
# pin against the mirror keeps resolving while the mirror retains it.
#
# BASE_SOURCE is the upstream tag we track. Builds and snapshot-rpms call
# os/dev/ensure-base-mirror.sh, which copies it into the mirror when the
# pinned BASE_REF digest is missing.
#
# Bumping Fedora major: edit BASE_SOURCE and BASE_REF (one-line digest bump).
# That changes the RPM fingerprint, so the next snapshot-rpms run publishes a
# new set-<fingerprint> tag against the new base.
BASE_SOURCE=quay.io/fedora/fedora-bootc:44
# Mirrored 2026-09-26 as registry.tilo.so/tilo/fedora-bootc:44-20260926-52078-1.
# Copied with --preserve-digests, so this is the same digest and the same bytes
# quay.io served: an OCI index over amd64/arm64/ppc64le/s390x, ostree.linux
# 7.2.7-200.fc44.x86_64.
BASE_REF=registry.tilo.so/tilo/fedora-bootc@sha256:5da3e5d18dfc666e6c3bc7d47cb7abde0d75492cafc924f65a8f70a937aa20c5
