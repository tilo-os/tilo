# Native tooling for retained development compilation in CI.
ARG BUILDER_REF
FROM ${BUILDER_REF}
RUN dnf -y install podman skopeo python3 openssl sbsigntools /usr/bin/bootctl \
 && dnf clean all
COPY cosign /usr/local/bin/cosign
# /var/lib/containers is a fresh Docker volume on the disposable CI guest.
# This keeps the Podman overlay upperdir off the container's overlay root.
RUN printf '[storage]\ndriver="overlay"\ngraphroot="/var/lib/containers/storage"\nrunroot="/run/containers/storage"\n' > /etc/containers/storage.conf \
 && printf '[engine]\ncgroup_manager="cgroupfs"\nevents_logger="file"\n' > /etc/containers/containers.conf
WORKDIR /work/repo
ENTRYPOINT ["python3", "os/dev/compile-development-os.py"]
