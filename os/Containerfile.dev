# syntax=docker/dockerfile:1.7
# ============================================================================
# Tilo dev image: the production image plus what dev VMs need
# ----------------------------------------------------------------------------
# NEVER A PRODUCTION IMAGE. It ships an SSH server, binaries built with the
# `dev-overrides` feature (they honour a fixed lock-screen password and a
# session-driving socket from the environment), the build toolchain and an
# unsealed /usr. It is published only as code.sandbox.example/qos/tilo-dev, which
# production policy rejects (os/etc/containers/policy.json), and built locally
# as localhost/tilo-dev. tools/policy/check_dev_image_contract.py enforces
# that, and keeps everything this file adds out of os/Containerfile.
#
# Built FROM the production image of the same commit, so a dev VM runs
# production code everywhere except for the pieces below:
#
#   * The components that declare `dev_features` in os/components.toml (the
#     compositor today) are rebuilt as release builds with those features. The
#     dev-only components (`dev-*` layers), tilo-control and tilo-devd, are
#     built alongside them. The cargo arguments and the install both come from
#     os/scripts/install-components.py --dev, so this file names no binary.
#   * The production builder's toolchain, installed into the image. The binaries
#     above are compiled with it, and so are in-VM builds. The package list is
#     read out of os/Containerfile's `builder` stage (os/scripts/builder-packages.py)
#     and installed from the same frozen RPM snapshot, so the compiler and
#     -devel libraries cannot drift from the production builder's.
#   * sshd (enabled), rsync, systemd-sysext, and tilo-devd's session unit
#     template, udev seat rules and vkms modprobe option, shipped from
#     crates/dev/tilo-devd/data. vkms and uinput load at boot.
#   * The image is UNSEALED. A layer on the sealed image breaks the composefs
#     digest its UKI pins, and dev layers have to merge into /usr. So the UKI
#     is removed and the kernel is restored to /usr/lib/modules/<kver>/. Then
#     os/dev/disk-image.sh installs it with ordinary boot entries.
#
# Build context: the repository root. Only BASE_IMAGE has to be given:
#
#     podman build -f os/Containerfile.dev \
#         --build-arg BASE_IMAGE=code.sandbox.example/qos/tilo:<tag> \
#         -t localhost/tilo-dev:latest .
#
# os/dev/build-dev-image.sh (./os/build.sh --dev) does that for the local
# production image and then writes a disk. The CI lane is
# .forgejo/workflows/dev-disk.yml.
# ============================================================================

# The production image to derive from: `localhost/tilo:latest` (./os/build.sh),
# a CI image (code.sandbox.example/qos/tilo:<tag> or @sha256:...), or the unsealed
# `rootfs` target of os/Containerfile.
ARG BASE_IMAGE=localhost/tilo:latest
# The frozen RPM snapshot the production image was built from. It must equal
# RPMS_REF in os/rpms-snapshot.env, which tools/policy/check_dev_image_contract.py
# checks, so a build of any commit installs what that commit's production
# builder installed.
ARG RPMS_REF=code.sandbox.example/qos/rpms@sha256:2caf1fe6010a981f7465754029ffdb92e4ae114246bdbb582d622fe4869c43fa

FROM ${RPMS_REF} AS rpms

# ---- The base, unsealed, with the builder's toolchain -------------------------
FROM ${BASE_IMAGE} AS dev-toolchain

# A production Tilo image, and not already a dev image.
RUN test -s /usr/lib/tilo/generation \
      || { echo "BASE_IMAGE is not a Tilo production image: it has no /usr/lib/tilo/generation" >&2; exit 1; } \
    && if [ -e /usr/lib/tilo/image-flavour ]; then \
         echo "BASE_IMAGE is already a $(cat /usr/lib/tilo/image-flavour) image; build from the production image" >&2; exit 1; \
       fi

# Unseal first: everything below changes the rootfs the UKI's digest describes.
RUN --mount=type=bind,source=os/scripts/unseal-rootfs.py,target=/run/tilo-dev/unseal-rootfs.py,ro \
    python3 /run/tilo-dev/unseal-rootfs.py /

# Fail now, not at the first slot, when this kernel cannot give a slot a seat.
RUN --mount=type=bind,source=os/scripts/check-dev-kernel.sh,target=/run/tilo-dev/check-dev-kernel.sh,ro \
    bash /run/tilo-dev/check-dev-kernel.sh /

# sshd for `tilo-dev`, rsync for worktree sync, and the production builder's
# packages. openssh-server is the one package the production image removes on
# purpose (the runtime crypto policy forbids an SSH server there).
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    --mount=type=bind,source=os,target=/run/tilo-dev/os,ro \
    python3 /run/tilo-dev/os/scripts/builder-packages.py \
      --containerfile /run/tilo-dev/os/Containerfile > /run/tilo-dev-builder-packages \
    && dnf install -y --setopt=reposdir=/repo openssh-server rsync \
    && xargs -r -a /run/tilo-dev-builder-packages dnf install -y --setopt=reposdir=/repo \
    && rm -f /run/tilo-dev-builder-packages \
    && dnf clean all && /usr/libexec/tilo/finalize-rpmdb \
    && rustc --version && cargo --version && sccache --version

# ---- Dev binaries -----------------------------------------------------------
# Compiled in the dev image's own toolchain, the same one in-VM builds use.
# Cache mounts follow the production builder: cargo home and sccache under
# /build, the target dir cleaned before fingerprinting. The target cache has its
# own id, since a feature change rebuilds the same crates differently.
FROM dev-toolchain AS dev-builder
WORKDIR /build
ENV CARGO_HOME=/build/.cargo-home \
    SCCACHE_DIR=/build/.sccache \
    RUSTC_WRAPPER=sccache \
    CARGO_INCREMENTAL=0 \
    LC_ALL=C.UTF-8 \
    TZ=UTC
COPY . /build
ARG TILO_CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${TILO_CARGO_BUILD_JOBS}
RUN --mount=type=cache,target=/build/.cargo-home \
    --mount=type=cache,id=tilo-dev-image-target,target=/build/target \
    --mount=type=cache,target=/build/.sccache \
    trap 'status=$?; sccache --show-stats 2>/dev/null || true; exit "$status"' EXIT \
    && if ! sccache --start-server; then \
         export RUSTC_WRAPPER=; \
         printf '%s\n' 'sccache unavailable; compiling normally' >&2; \
       fi \
    && cargo clean --release \
    && DEV_CARGO_ARGS="$(python3 os/scripts/install-components.py --dev --dry-run --format cargo)" \
    && DEV_BINS="$(python3 os/scripts/install-components.py --dev --dry-run --format bins)" \
    && [ -n "$DEV_CARGO_ARGS" ] && [ -n "$DEV_BINS" ] \
    && printf 'dev image build: cargo build --release %s\n' "$DEV_CARGO_ARGS" \
    && CARGO_PROFILE_RELEASE_LTO=thin \
       CARGO_PROFILE_RELEASE_CODEGEN_UNITS=8 \
       cargo build --release ${DEV_CARGO_ARGS} \
    && mkdir -p /out \
    && for b in ${DEV_BINS}; do cp "target/release/$b" /out/; done \
    && find /build/target -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
RUN /build/os/scripts/verify-elf-hardening.sh /out \
    && pinned="$(sed -n 's/^channel *= *"\([^"]*\)".*/\1/p' rust-toolchain.toml)" \
    && actual="$(rustc --version | awk '{print $2}')" \
    && if [ "$pinned" != "$actual" ]; then \
         printf 'WARNING: the image builder compiles with rustc %s, but rust-toolchain.toml pins %s\n' "$actual" "$pinned" >&2; \
       fi

# ---- Dev components, placed by the manifest ---------------------------------
FROM dev-toolchain AS dev-component-files
RUN --network=none \
    --mount=type=bind,source=os,target=/run/tilo-dev/os,ro \
    --mount=type=bind,from=dev-builder,source=/out,target=/out,ro \
    python3 /run/tilo-dev/os/scripts/install-components.py \
      --manifest /run/tilo-dev/os/components.toml \
      --from /out --dest /image --dev

# ---- The dev image ------------------------------------------------------------
FROM dev-toolchain AS dev
COPY --from=dev-component-files /image/ /
COPY os/components.toml /usr/share/tilo/components.toml
COPY crates/dev/tilo-devd/data/72-vkms-seat.rules crates/dev/tilo-devd/data/73-uinput-seat.rules /usr/lib/udev/rules.d/
COPY crates/dev/tilo-devd/data/tilo-dev-session@.service /usr/lib/systemd/system/tilo-dev-session@.service
COPY crates/dev/tilo-devd/data/tilo-dev-vkms.conf /usr/lib/modprobe.d/tilo-dev-vkms.conf
COPY os/dev-image/ /

# base.json for tilo-devd's layer checks, the dev-only update policy and the
# flavour marker; then proof that every piece above is really in place.
ARG BASE_IMAGE
ARG TILO_BASE_DIGEST=
RUN --mount=type=bind,source=os/scripts/finalize-dev-image.py,target=/run/tilo-dev/finalize-dev-image.py,ro \
    --mount=type=bind,source=Cargo.lock,target=/run/tilo-dev/Cargo.lock,ro \
    python3 /run/tilo-dev/finalize-dev-image.py \
      --base-image "$BASE_IMAGE" --base-digest "$TILO_BASE_DIGEST" \
      --cargo-lock /run/tilo-dev/Cargo.lock \
    && systemctl enable sshd.service systemd-sysext.service \
    && test -x /usr/bin/tilo-control && test -x /usr/libexec/tilo-devd \
    && /usr/bin/tilo-devd --version \
    && grep -aq 'dev-overrides build: developer environment overrides' /usr/bin/shell \
    && systemd-sysext --version >/dev/null \
    && ssh-keygen -q -t ed25519 -N '' -f /run/tilo-dev-hostkey \
    && /usr/sbin/sshd -t -h /run/tilo-dev-hostkey \
    && rm -f /run/tilo-dev-hostkey /run/tilo-dev-hostkey.pub \
    && bootc container lint

LABEL sh.tilo.image.flavour="dev" \
      org.opencontainers.image.title="Tilo dev image (not for production)"
