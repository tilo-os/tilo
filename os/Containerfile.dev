# syntax=docker/dockerfile:1.7
# ============================================================================
# Tilo dev image: the production image plus what dev VMs need
# ----------------------------------------------------------------------------
# NEVER A PRODUCTION IMAGE. It ships an SSH server, binaries built with the
# `dev-overrides` feature (they honour a fixed lock-screen password and a
# session-driving socket from the environment), the build toolchain and an
# unsealed /usr. It is published only as registry.tilo.so/tilo/tilo-vm, which
# production policy rejects (os/etc/containers/policy.json), and built locally
# as localhost/tilo-vm. tools/policy/check_dev_image_contract.py enforces
# that, and keeps everything this file adds out of os/Containerfile.
#
# Built FROM the production image of the same commit, so a dev VM runs
# production code everywhere except for the pieces below:
#
#   * The components that declare `dev_features` in os/components.toml (the
#     compositor today) are rebuilt as release builds with those features. The
#     dev-only components (`dev-*` layers), such as tilo-vmd, are
#     built alongside them. The cargo arguments and the install both come from
#     os/scripts/install-components.py --dev, so this file names no binary.
#   * A build toolchain, installed into the image. The binaries above are
#     compiled with it, and so are in-VM builds. The Rust compiler is the
#     release rust-toolchain.toml pins, the one CI checks and tests the
#     workspace with, copied from the digest-pinned CI builder image
#     (RUST_TOOLCHAIN_IMAGE). Everything else is the production builder's: the
#     package list is generated from os/Containerfile's `builder` stage into
#     os/scripts/builder-packages.txt (os/Containerfile is not in the build
#     context), checked against it by the dev image contract, and installed from
#     the same frozen RPM snapshot, so the C toolchain and -devel libraries
#     cannot drift from the production builder's.
#   * sshd (enabled), rsync, systemd-sysext, and tilo-vmd's session unit
#     template, udev seat rules and vkms modprobe option, shipped from
#     crates/dev/tilo-vmd/data. vkms and uinput load at boot.
#   * tilo-device-admin.service (enabled): tilo-vmd's requests over the peer
#     network for the owner's administrators, so `tilo-vm` reaches the machine
#     beyond the LAN, at the greeter too.
#   * The image is UNSEALED. A layer on the sealed image breaks the composefs
#     digest its UKI pins, and dev layers have to merge into /usr. So the UKI
#     is removed and the kernel is restored to /usr/lib/modules/<kver>/. Then
#     os/dev/disk-image.sh installs it with ordinary boot entries.
#
# Build context: the repository root. Only BASE_IMAGE has to be given:
#
#     podman build -f os/Containerfile.dev \
#         --build-arg BASE_IMAGE=registry.tilo.so/tilo/tilo:<tag> \
#         -t localhost/tilo-vm:latest .
#
# os/dev/build-dev-image.sh (./os/build.sh --dev) does that for the local
# production image and then writes a disk. CI runs the same script: the OS
# integration lane (.forgejo/workflows/build-image.yml) FROM the image it just
# built, and .forgejo/workflows/dev-disk.yml FROM a published one.
# ============================================================================

# The production image to derive from: `localhost/tilo:latest` (./os/build.sh),
# a CI image (registry.tilo.so/tilo/tilo:<tag> or @sha256:...), or the unsealed
# `rootfs` target of os/Containerfile.
ARG BASE_IMAGE=localhost/tilo:latest
# The frozen RPM snapshot the production image was built from. Like
# os/Containerfile, this has no default: os/dev/build-dev-image.sh and
# .forgejo/workflows/dev-disk.yml pass a fingerprint-resolved RPMS_REF, so a
# build of any commit installs what that commit's production builder installed.
ARG RPMS_REF
# Where the Rust toolchain comes from: a registry.tilo.so/tilo/tilo-builder index,
# pinned by digest. .forgejo/workflows/build-builder-image.yml installs the
# channel rust-toolchain.toml names into it, through dist/ci/install-build-deps.sh's
# checksum-pinned rustup bootstrap, for both architectures. The dev-toolchain
# stage takes exactly the channel rust-toolchain.toml pins out of it and fails
# when the image lacks it, so a toolchain bump that forgets this pin cannot
# build a dev image with a different compiler. Fedora's rust package is not an
# option: its version moves whenever the RPM snapshot is refreshed.
# The Fedora bootc base os/Containerfile's builder-base starts from
# (os/base-snapshot.env). The dev binaries compile on it with the production
# builder's packages, as the production binaries do, so their compile needs
# neither BASE_IMAGE nor its rootfs and can run while BASE_IMAGE is built.
ARG BASE_REF
ARG RUST_TOOLCHAIN_IMAGE=registry.tilo.so/tilo/tilo-builder@sha256:568fca1f8b4a4b1700c871cca033d2d291a5eb02c4b3be9681410f456b5a7bc9

FROM ${RPMS_REF} AS rpms
FROM ${RUST_TOOLCHAIN_IMAGE} AS rust-toolchain

# The fixed wall clock the production rootfs's dnf transactions see
# (os/scripts/build-clock.c), for the toolchain transaction below.
FROM ${RUST_TOOLCHAIN_IMAGE} AS dev-build-clock
COPY os/scripts/build-clock.c /tmp/build-clock.c
RUN cc -std=c11 -Wall -Wextra -Werror -O2 -fPIC -shared /tmp/build-clock.c -o /build-clock.so

# The build scripts and inputs the stages below run, staged through a scratch
# stage and bind-mounted from it, so no stage mounts the build context itself
# (which SELinux hosts would refuse without relabelling the checkout).
FROM scratch AS dev-inputs
COPY os/components.toml /tilo/os/
COPY os/usr/libexec/tilo-session /tilo/os/usr/libexec/
COPY os/usr/lib/systemd/user/tilo-ush.service /tilo/os/usr/lib/systemd/user/
COPY os/usr/share/tilo/system-interfaces.toml /tilo/os/usr/share/tilo/
COPY os/scripts/unseal-rootfs.py os/scripts/check-dev-kernel.sh os/scripts/builder-packages.txt \
     os/scripts/install-components.py os/scripts/finalize-dev-image.py \
     os/scripts/verify-boot-ordering.sh os/scripts/install-dev-toolchain.sh \
     os/scripts/install-env-runtime.sh os/scripts/ensure-dev-env-runtime.sh /tilo/os/scripts/
COPY Cargo.lock rust-toolchain.toml /tilo/

# ---- The base, unsealed, with the builder's toolchain -------------------------
FROM ${BASE_IMAGE} AS dev-toolchain

# A production Tilo image, and not already a dev image.
RUN test -s /usr/lib/tilo/generation \
      || { echo "BASE_IMAGE is not a Tilo production image: it has no /usr/lib/tilo/generation" >&2; exit 1; } \
    && if [ -e /usr/lib/tilo/image-flavour ]; then \
         echo "BASE_IMAGE is already a $(cat /usr/lib/tilo/image-flavour) image; build from the production image" >&2; exit 1; \
       fi

# Unseal first: everything below changes the rootfs the UKI's digest describes.
RUN --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    python3 /run/tilo-dev/os/scripts/unseal-rootfs.py /

# tilo-vm hands a dev VM its root SSH key as an SMBIOS credential
# (ssh.authorized_keys.root), which the sealed image refuses to import.
RUN rm /usr/lib/bootc/kargs.d/05-credentials.toml

# Fail now, not at the first slot, when this kernel cannot give a slot a seat.
RUN --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    bash /run/tilo-dev/os/scripts/check-dev-kernel.sh /

# Buildah leaves the rust-toolchain mount out of the layer cache key; this ARG keys it on RUST_TOOLCHAIN_IMAGE.
ARG RUST_TOOLCHAIN_IMAGE
# The pinned Rust release and the production builder's packages but for its
# Rust compiler (os/scripts/install-dev-toolchain.sh), plus sshd for `tilo-vm`
# and rsync for worktree sync. openssh-server is the one package the production
# image removes on purpose (the runtime crypto policy forbids an SSH server
# there). The sealed base also removes openssh, so the frozen repo must carry
# its exact matching core RPM even when the snapshot's original base already
# had it installed.
#
# These layers are the bulk of a dev image, and they are the same for every
# commit on one rootfs: with the clock fixed at SOURCE_DATE_EPOCH (rpm records
# install times) and the build's mtimes clamped to it, their blobs are
# identical and a registry that has them is not sent them again. ld.so.cache,
# which lists the commit's own libraries too, is written by the next, small
# layer instead.
RUN --mount=type=bind,from=rust-toolchain,source=/usr/local/rustup/toolchains,target=/run/tilo-rust-toolchains,ro \
    --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    sh /run/tilo-dev/os/scripts/install-dev-toolchain.sh rust
# tilo-rpm-snapshot-package: openssh
# tilo-rpm-snapshot-package: openssh-server
# tilo-rpm-snapshot-package: rsync
ARG SOURCE_DATE_EPOCH=0
# Buildah leaves the rpms mount out of the layer cache key; this ARG keys it on RPMS_REF.
ARG RPMS_REF
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    --mount=type=bind,from=dev-build-clock,source=/build-clock.so,target=/run/tilo-build-clock.so \
    sh /run/tilo-dev/os/scripts/install-dev-toolchain.sh packages openssh-server rsync
RUN ldconfig

# ---- The tilo-dev-tools sysext tree -------------------------------------------
# The Rust toolchain (about 680 MB) and the test GUI clients (about 600 MB,
# two thirds Chromium) as a separate /usr overlay instead of base content:
#
#     podman build -f os/Containerfile.dev --target dev-tools-sysext \
#         --build-arg ... -o type=tar,dest=tilo-dev-tools.tar .
#
# The tar is a layer tilo-vm imports (crates/dev/tilo-vmd/src/layers.rs accepts
# only usr/ and opt/, and writes the extension-release itself). It is computed
# on dev-toolchain, so it holds exactly the packages the clients add to what
# the base already has. The `dev` stage below still installs both into the
# base image until tilo-vm installs this layer on the VMs that need it and
# os/scripts/finalize-dev-image.py stops requiring rustc in the base.
FROM dev-toolchain AS dev-tools-tree
ARG RUST_TOOLCHAIN_IMAGE
ARG SOURCE_DATE_EPOCH=0
ARG RPMS_REF
RUN --mount=type=bind,from=rust-toolchain,source=/usr/local/rustup/toolchains,target=/run/tilo-rust-toolchains,ro \
    --mount=type=bind,from=rpms,source=/repo,target=/repo \
    --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    --mount=type=bind,from=dev-build-clock,source=/build-clock.so,target=/run/tilo-build-clock.so \
    sh /run/tilo-dev/os/scripts/install-dev-toolchain.sh tools-tree /out-tools

FROM scratch AS dev-tools-sysext
COPY --from=dev-tools-tree /out-tools/ /

# ---- Dev binaries -----------------------------------------------------------
# Compiled outside any image build, as the production binaries are: os/image/compile.sh --dev
# in the OS builder image (the base and RPM snapshot with the toolchains), with t's compiler
# cache and warm build directories on t, or os/output's locally (os/dev/build-dev-image.sh).
# The tree comes in as the `compiled-dev` build context: the components with their dev
# features, as os/scripts/install-components.py --dev names them.
FROM scratch AS dev-builder
COPY --from=compiled-dev / /out/

# ---- Dev components, placed by the manifest ---------------------------------
# What a component installs from its final path (the shell's fonts) comes from
# the base, the production image of the same commit.
FROM dev-toolchain AS dev-component-files
RUN --network=none \
    --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    --mount=type=bind,from=dev-builder,source=/out,target=/out,ro \
    python3 /run/tilo-dev/os/scripts/install-components.py \
      --manifest /run/tilo-dev/os/components.toml \
      --from /out --build-root / --dest /image --dev

# ---- The dev image ------------------------------------------------------------
FROM dev-toolchain AS dev

# Third-party apps the VM acceptance suite (scripts/vm-acceptance, A07-A13)
# opens, one per toolkit and protocol path people use every day: Chromium, the
# engine Electron apps (VS Code, Cursor, chat clients) ship, on Wayland and
# forced onto X11 through Xwayland; GNOME Text Editor (GTK4 and libadwaita);
# FeatherPad on Qt's Wayland platform (Qt6); alacritty (winit and OpenGL); and
# glxgears, an OpenGL X11 client the way games are; and xterm, a plain X11 client (A07),
# which otherwise has to come from a network install in the VM: without it A07 fell back
# to Wine File, whose first start sets up a Wine prefix. os/dev-image/ carries the
# desktop entries and the page that start the variants. Without weak
# dependencies they add about 600 MiB, two thirds of it Chromium. Like the
# toolchain layer this one is the same for every commit on one rootfs.
ARG SOURCE_DATE_EPOCH=0
# Buildah leaves the rpms mount out of the layer cache key; this ARG keys it on RPMS_REF.
ARG RPMS_REF
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    --mount=type=bind,from=dev-build-clock,source=/build-clock.so,target=/run/tilo-build-clock.so \
    LD_PRELOAD=/run/tilo-build-clock.so dnf install -y --setopt=reposdir=/repo \
      --setopt=install_weak_deps=False \
      chromium gnome-text-editor featherpad qt6-qtwayland alacritty glx-utils xterm \
    && dnf clean all \
    && if [ -x /usr/libexec/tilo/finalize-rpmdb ]; then /usr/libexec/tilo/finalize-rpmdb; fi \
    && rm -rf /var/log/dnf5.log* /var/cache/libdnf5 /var/lib/dnf/system-repo.lock /run/dnf /etc/ld.so.cache
RUN ldconfig

COPY --from=dev-component-files /image/ /
COPY os/components.toml /usr/share/tilo/components.toml
COPY crates/dev/tilo-vmd/data/72-vkms-seat.rules crates/dev/tilo-vmd/data/73-uinput-seat.rules /usr/lib/udev/rules.d/
COPY crates/dev/tilo-vmd/data/tilo-vm-session@.service /usr/lib/systemd/system/tilo-vm-session@.service
COPY crates/dev/tilo-vmd/data/tilo-vm-restore.service /usr/lib/systemd/system/tilo-vm-restore.service
COPY crates/dev/tilo-vmd/data/tilo-vm-reconcile-image.service /usr/lib/systemd/system/tilo-vm-reconcile-image.service
COPY crates/dev/tilo-vmd/data/tilo-vm-vkms.conf /usr/lib/modprobe.d/tilo-vm-vkms.conf
COPY crates/dev/tilo-vmd/data/tilo-vm-community.toml /usr/share/tilo/tilo-vm-community.toml
COPY os/dev-image/ /

# An env-runtime, so environments (Terminal's shell among them) start in the tree under test.
# The image below ships the published runtime of its definition, and none while stable has not
# published this tree's: then the runtime this build is given (`dev-env-runtime`, sealed in the
# same t run with a throwaway key, or an empty directory) goes into the system store, its
# publisher trusted by this dev image alone. With neither the build fails.
RUN --network=none \
    --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    --mount=type=bind,from=dev-env-runtime,source=/,target=/run/tilo-dev-env-runtime,ro \
    bash /run/tilo-dev/os/scripts/ensure-dev-env-runtime.sh /run/tilo-dev-env-runtime \
      /usr/libexec/tilo/tilo-install

# base.json for tilo-vmd's layer checks, the dev-only update policy and the
# flavour marker; then proof that every piece above is really in place.
ARG BASE_IMAGE
ARG TILO_BASE_DIGEST=
ARG TILO_BASE_CREATED=
RUN --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    python3 /run/tilo-dev/os/scripts/finalize-dev-image.py \
      --base-image "$BASE_IMAGE" --base-digest "$TILO_BASE_DIGEST" \
      --base-created "$TILO_BASE_CREATED" \
      --cargo-lock /run/tilo-dev/Cargo.lock \
    && systemctl unmask systemd-sysext.service \
    && systemctl enable sshd.service systemd-sysext.service tilo-vm-restore.service \
       tilo-vm-reconcile-image.service \
       tilo-device-admin.service \
    && test -x /usr/libexec/tilo/tilo-control && test -x /usr/libexec/tilo/tilo-vmd \
    && /usr/libexec/tilo/tilo-vmd --version && /usr/libexec/tilo/tilo-device-admin --version \
    && grep -aq 'dev-overrides build: developer environment overrides' /usr/bin/shell \
    && systemd-sysext --version >/dev/null \
    && ssh-keygen -q -t ed25519 -N '' -f /run/tilo-dev-hostkey \
    && /usr/sbin/sshd -t -h /run/tilo-dev-hostkey \
    && rm -f /run/tilo-dev-hostkey /run/tilo-dev-hostkey.pub \
    && bash /run/tilo-dev/os/scripts/verify-boot-ordering.sh \
    && bootc container lint

LABEL sh.tilo.image.flavour="dev" \
      org.opencontainers.image.title="Tilo dev image (not for production)"
