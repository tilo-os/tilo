# Confine the collaborative filesystem daemon in its own SELinux domain
# (qos_fs_t) instead of unconfined_service_t. Shipped permissive so it can't
# break the working daemon; tightens to enforcing from captured AVCs (see the
# module header). The drop-in runs fs.service in the domain via SELinuxContext.
COPY os/usr/share/qos/selinux/qos-base.cil /usr/share/qos/selinux/qos-base.cil
COPY os/usr/lib/systemd/system/fs.service.d/20-selinux.conf /usr/lib/systemd/system/fs.service.d/20-selinux.conf
# `libsemanage` writes a sandbox at /etc/selinux/targeted/tmp during
# install and fails "File exists" if any prior partial state carried
# forward (a caching quirk under rootless podman that CI's docker
# daemon happens to sidestep). Clear it first.
# libsemanage builds its sandbox by hardlinking the current policy store, and a
# hardlink to a file that lives in a lower container layer fails EEXIST — which
# surfaces as "Could not copy files to sandbox /etc/selinux/targeted/tmp (File
# exists)" while that directory is demonstrably absent. Removing the stale
# sandbox, which this step already did, addresses the wrong half: the store
# itself has to exist in this layer. Copy it into place first.
#
# Add-on SELinux RPM scriptlets are deliberately non-fatal (`semodule ... || :`).
# Under the same rootless-overlay failure their policy archives are installed
# but their modules are absent from `active` (they can also be left only in
# abandoned `previous`/`tmp` stores). Reinstall and then verify every shipped
# add-on policy archive after copying up the store. Keeping this generic matters:
# optional desktop/virtualization packages can add a policy archive without also
# changing this Containerfile.
RUN cp -a /etc/selinux/targeted /var/tmp/qos-sestore \
 && rm -rf /etc/selinux/targeted \
 && mv /var/tmp/qos-sestore /etc/selinux/targeted \
 && rm -rf /etc/selinux/targeted/tmp \
 && find /usr/share/selinux/packages -type f \( -name '*.pp' -o -name '*.pp.bz2' \) -print \
      | sort \
      | while IFS= read -r policy; do \
          semodule -n -s targeted -X 200 -i "$policy" || exit 1; \
        done \
 && semodule -i /usr/share/qos/selinux/qos-base.cil \
 && semodule -s targeted -lfull > /var/tmp/qos-active-selinux-modules \
 && find /usr/share/selinux/packages -type f \( -name '*.pp' -o -name '*.pp.bz2' \) -print \
      | sort \
      | while IFS= read -r policy; do \
          module="$(basename "$policy")"; module="${module%.bz2}"; module="${module%.pp}"; \
          awk -v module="$module" '$1 == "200" && $2 == module { found=1 } END { exit !found }' \
            /var/tmp/qos-active-selinux-modules || exit 1; \
        done \
 && semodule -s targeted -lfull | grep -Eq '^400[[:space:]]+qos-base[[:space:]]' \
 && rm -f /var/tmp/qos-active-selinux-modules \
 && restorecon -v /usr/lib/systemd/user/qos-graphical-session.target \
 && echo "all packaged add-on and qos-base SELinux modules loaded"

# ---------------------------------------------------------------------------
# Enable services
# ---------------------------------------------------------------------------
# The portal backend needs no unit: the compositor serves it in-process,
# so it starts and stops with the session it answers for.
# `shell-peer-sync.service` is pointedly **NOT** enabled — that's the
# user-opt-in part.
#
# `qos-ush.service` is `--global` enabled too, and has to be: it owns the
# `ush` service socket that every app declaring `ush = "required@<v>"` is
# refused without, which today is the Terminal.
#
# C6 audio: enable the PipeWire user stack for every account (socket-activated
# pipewire + pipewire-pulse, plus the wireplumber session manager).
RUN systemctl enable greetd.service && \
    systemctl set-default graphical.target && \
    systemctl enable shell-firstboot.service && \
    systemctl enable qos-growfs-sysroot.service && \
    systemctl enable fs.service fs-identity.path && \
    systemctl enable qos-system-extension-dispatcher.socket && \
    systemctl --global enable qos-identity.service && \
    systemctl --global enable qos-model-manager.service && \
    systemctl --global enable qos-ush.service && \
    systemctl --global enable qos-fs-recipient.service && \
    systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service

# C2 time sync, C5 firewall, C7 bluetooth, C8 power — system services.
# Printing is socket-activated rather than always-on: cupsd starts when
# something first talks to it (the settings pane's lpstat, or a print dialog)
# and costs nothing on a machine that never prints.
RUN systemctl enable cups.socket

RUN systemctl enable chronyd.service && \
    systemctl enable firewalld.service && \
    systemctl enable bluetooth.service && \
    systemctl enable ModemManager.service && \
    systemctl enable power-profiles-daemon.service && \
    systemctl enable systemd-homed.service && \
    systemctl enable qos-power.service

# C9 printing. The *socket*, not the service: cupsd starts on first use and
# stays stopped on a machine that never prints, so the IPP parser is not
# running for most of the fleet's uptime. cups-browsed is not installed, so
# there is nothing to disable.
RUN systemctl enable cups.socket

# §11 hardening services: hidepid remount + the boot security self-check.
RUN systemctl enable qos-hidepid.service && \
    systemctl enable qos-security-audit.service && \
    systemctl enable qos-rollback-harden.service && \
    systemctl enable qos-rollback-confirm.timer

# Boot assessment. qos-boot-health.service installs itself RequiredBy
# boot-complete.target, which systemd only starts when the boot loader passed a
# try counter — so on an entry that has already been blessed neither unit runs.
RUN systemctl enable qos-boot-entries.service && \
    systemctl enable qos-boot-health.service

# A3: automatic bootc updates. The timer pulls + applies the image at
# QOS_TARGET_IMGREF (code.sandbox.example/qos/qos:latest, baked at install by
# qos-install) on a schedule, so installed systems stay current.
RUN systemctl enable bootc-fetch-apply-updates.timer

# The installer and first-login experience expose NetworkManager-backed
# connectivity controls. Enable it explicitly instead of depending on a base
# image preset that may change independently of qOS.
RUN systemctl enable NetworkManager.service

# Boot-time prune. These units sit on the critical chain but their work
# is either irrelevant to a desktop qOS (offline man-db caching), or a
# `Wants=network-online.target` wait we don't need (nothing on the boot
# path blocks on a routable interface — the shell + peer sync tolerate
# late network). Masking (not just disabling) makes them
# unable to be pulled in by transitive `Wants=`.
#
# `|| true` because the unit is only present when its package is
# installed — we don't fail the image build if a mask target is absent.
RUN for u in \
        NetworkManager-wait-online.service \
        systemd-networkd-wait-online.service \
        man-db-cache-update.timer \
        man-db-cache-update.service \
        systemd-update-utmp.service \
    ; do systemctl mask "$u" || true; done

# C5 firewall policy. Default to the desktop zone (FedoraWorkstation), whose
# 1025-65535 UDP range covers Iroh's ephemeral QUIC endpoint. Invites carry
# authenticated endpoint addresses, so collaboration needs no multicast
# discovery service or fixed inbound port.
# firewalld isn't running at build time, so edit the permanent config offline.
#
# Printing adds NO service here, deliberately. `ipp` (631/tcp) would expose
# the scheduler, and `ipp-client` would open the door for the DNS-SD printer
# announcements qOS does not listen for. Printing on this image is outbound
# only — the desktop talks to a printer, nothing talks to the desktop — and
# the FedoraWorkstation zone already permits the outbound side. Adding either
# service is a decision to be argued for, not a default.
RUN firewall-offline-cmd --set-default-zone=FedoraWorkstation

# ---------------------------------------------------------------------------
# Custom qOS kernel: swap Fedora's kernel-core for our tuned qos-kernel-core.
# ---------------------------------------------------------------------------
# The kernel image (see os/kernel/Containerfile + .forgejo/workflows/
# build-kernel.yml) rebuilds Fedora's kernel with a config fragment that:
#   * links the storage/net/USB/HID boot-path drivers statically, so the
#     boot path needs no module loading to reach the root device, and
#   * tunes for interactive throughput (PREEMPT + HZ=1000 + THP=always +
#     SCHED_MC), and
#   * drops DEBUG_INFO so the RPM doesn't carry ~800 MB of debuginfo.
#
# Because the qos-kernel repo is a distinct OCI image (KERNEL_RPMS_REF),
# we mount it alongside the frozen repo, write a two-repo dnf config on
# the fly, and swap kernel-core → qos-kernel-core.  --nogpgcheck: our
# in-house RPMs aren't signed by Fedora's key; provenance for the whole
# image is verified via cosign against code.sandbox.example/qos/qos-kernel
# (see os/etc/containers/policy.json).
#
# An initramfs is mandatory, and the static drivers do not remove the need
# for one: unlocking an encrypted root takes early USERSPACE (device-mapper
# setup, a TPM unseal or a passphrase prompt, systemd-cryptsetup). Static
# drivers get the kernel as far as seeing the block device; they cannot open
# a LUKS volume. Under the base's `layout=ostree` kernel-install config,
# kernel-install deliberately does not run dracut, so the image build owns
# initramfs generation — hence the explicit dracut call below. The base's
# dracut drop-ins (/usr/lib/dracut/dracut.conf.d/*bootc*) already add the
# crypt, systemd-cryptsetup, tpm2-tss and clevis modules.
RUN --mount=type=bind,from=rpms,source=/repo,target=/frozen-repo \
    --mount=type=bind,from=kernel-rpms,source=/repo,target=/qkernel-repo \
    set -eux; \
    mkdir -p /etc/qos-swap.d; \
    printf '[frozen]\nname=frozen\nbaseurl=file:///frozen-repo\ngpgcheck=0\nenabled=1\n' \
        > /etc/qos-swap.d/frozen.repo; \
    printf '[qos-kernel]\nname=qos-kernel\nbaseurl=file:///qkernel-repo\ngpgcheck=0\nenabled=1\n' \
        > /etc/qos-swap.d/qos-kernel.repo; \
    # --allowerasing lets the swap drop the base's `kernel` meta-package
    # (it hard-requires kernel-core-uname-r = <exact-fedora-version>,
    # which our qos-kernel-core doesn't satisfy since it carries a
    # different Release tag). qos-kernel-core Provides: kernel so nothing
    # downstream loses a dependency.
    dnf swap -y --setopt=reposdir=/etc/qos-swap.d --nogpgcheck --allowerasing \
        kernel-core qos-kernel-core; \
    rm -rf /etc/qos-swap.d; \
    # Which kernel version did the swap leave behind? Ask the filesystem: rpm is
    # no help here, because qos-kernel-core provides no kernel-uname-r and its
    # file list records /lib/modules/... where a query would say /usr/lib/... .
    #
    # Count kernel IMAGES, not directories. Removing kernel-core does not remove
    # its modules directory: the base ships a prebuilt initramfs there that no
    # package owns, so the directory survives with that file in it and a count of
    # directories finds two. The loop further down exists to clear exactly that
    # leftover — so asserting on directories here is the cleanup firing too late
    # rather than a real ambiguity, and it failed every build that did not restore
    # this layer from cache.
    #
    # A kernel image is /usr/lib/modules/<kver>/vmlinuz (Fedora's layout) or
    # /boot/vmlinuz-<kver> (qos-kernel-core's, moved into place below). The
    # leftover directory has neither, because its vmlinuz belonged to the package
    # that was just removed.
    kver=""; n=0; \
    for d in /usr/lib/modules/*/; do \
      k="$(basename "$d")"; \
      if [ -f "$d/vmlinuz" ] || [ -f "/boot/vmlinuz-$k" ]; then \
        kver="$k"; n=$((n+1)); \
      fi; \
    done; \
    if [ "$n" -ne 1 ]; then \
      echo "expected exactly one kernel image after the kernel swap, found $n" >&2; \
      ls -la /usr/lib/modules/ /boot >&2 || true; \
      exit 1; \
    fi; \
    # qos-kernel-core installs its kernel as /boot/vmlinuz-<kver>, not into the
    # modules directory the way Fedora's kernel-core does. ostree does find it
    # there — it falls back to /boot/vmlinuz-<kver> — which is why nobody noticed,
    # but it means the image carried a kernel and no initramfs beside it, and
    # every tool that goes looking for the pair (this build included) came up
    # empty. Put both where the base image puts them.
    if [ -f "/boot/vmlinuz-$kver" ] && [ ! -f "/usr/lib/modules/$kver/vmlinuz" ]; then \
      mv "/boot/vmlinuz-$kver" "/usr/lib/modules/$kver/vmlinuz"; \
    fi; \
    test -f "/usr/lib/modules/$kver/vmlinuz"; \
    # The base ships a prebuilt initramfs for ITS kernel, and that file is
    # owned by no RPM — so removing kernel-core leaves the old modules
    # directory behind and the image would carry two kernel versions.
    for d in /usr/lib/modules/*; do \
      [ "$d" = "/usr/lib/modules/$kver" ] || rm -rf "$d"; \
    done; \
    # --add rather than trusting the base's drop-ins to pull these in: the same
    # invocation produced an initramfs WITH the crypt modules locally and WITHOUT
    # them under the CI builder, silently, and a missing module here is a root
    # that cannot be unlocked. Naming them makes dracut fail instead of omit.
    dracut --force --reproducible -v --kver "$kver" \
        --add "crypt systemd-cryptsetup tpm2-tss plymouth" \
        "/usr/lib/modules/$kver/initramfs.img" > /tmp/dracut.log 2>&1 \
      || { cat /tmp/dracut.log >&2; exit 1; }; \
    test -s "/usr/lib/modules/$kver/initramfs.img"; \
    # Record what dracut says it included, and check THAT rather than reading the
    # image back. dracut wraps the contents in a squashfs, and listing one needs
    # privileges an unprivileged image builder does not have — so inspecting the
    # artefact reports "no cryptsetup" for an initramfs that has it. dracut's own
    # report is the same fact without the privilege dependency, and shipping the
    # list lets the runtime check use it too.
    mkdir -p /usr/lib/qos; \
    sed -n 's/.*Including module: \([a-z0-9_-]*\).*/\1/p' /tmp/dracut.log \
      | sort -u > /usr/lib/qos/initramfs-modules.txt; \
    for m in crypt systemd-cryptsetup tpm2-tss plymouth; do \
      grep -qx "$m" /usr/lib/qos/initramfs-modules.txt || { \
        echo "dracut did not include the $m module; an encrypted root could not be opened" >&2; \
        cat /usr/lib/qos/initramfs-modules.txt >&2; exit 1; }; \
    done; \
    rm -f /tmp/dracut.log; \
    # /boot belongs to the deployment, not the image: whatever the kernel
    # packages dropped there is now duplicated under the modules directory.
    rm -f /boot/vmlinuz-* /boot/initramfs-* /boot/System.map-* /boot/config-*; \
    dnf clean all && ${FINALIZE_RPMDB}

# The rpm database this image ships is intact and carries no WAL sidecars.
#
# Asserted positively rather than by absence of an error, because that is how
# this failed before: `rpm -qa` kept working off the Packages blob while the
# Basenames/Dirnames indexes were structurally corrupt, so every step still
# "succeeded" until a dnf resolve needed a file dependency and claimed the base
# image did not provide /usr/bin/basename. `rpm -qf` on a file the base owns is
# the cheapest query that actually reads those indexes.
RUN owner="$(rpm -qf /usr/bin/basename 2>&1 || true)" \
 && case "$owner" in \
      coreutils-*) echo "rpmdb file index intact: /usr/bin/basename -> $owner" ;; \
      *) echo "rpmdb file index is corrupt: /usr/bin/basename -> $owner" >&2; exit 1 ;; \
    esac \
 && rpm --verifydb \
 && rm -f /usr/lib/sysimage/rpm/rpmdb.sqlite-wal \
           /usr/lib/sysimage/rpm/rpmdb.sqlite-shm \
 && ( test ! -e /usr/lib/sysimage/rpm/rpmdb.sqlite-wal \
        || { echo "rpmdb.sqlite-wal is in the image; see FINALIZE_RPMDB" >&2; exit 1; } ) \
 && ( test ! -e /usr/lib/sysimage/rpm/rpmdb.sqlite-shm \
        || { echo "rpmdb.sqlite-shm is in the image; see FINALIZE_RPMDB" >&2; exit 1; } )

# Boot-chain invariants, asserted at BUILD time so the image cannot ship in the
# state it once did: offering `qos-install --encrypt` while carrying no
# initramfs, which leaves the kernel able to see the LUKS device and unable to
# open it. Also bundled so an operator can re-run it on a live machine.
COPY os/tests/boot_chain_invariants.sh /usr/libexec/qos/boot-chain-test.sh
RUN chmod 0755 /usr/libexec/qos/boot-chain-test.sh \
    && OS_ROOT=/ bash /usr/libexec/qos/boot-chain-test.sh

# Collaborative Files installed-image contract.  This is deliberately inside
# the production rootfs build rather than a source-tree lint: it inspects the
# actual copied binaries, enabled system/user units, FUSE package/config,
# tmpfiles/ACL seed, and the Files package as installed in the launcher's
# immutable registry.  The same script's runtime mode is run after a bootc
# install + graphical login by build-image.yml.
COPY os/tests/collaborative-files-image-contract.sh /usr/libexec/qos/collaborative-files-image-contract.sh
COPY apps/file-explorer/tests/atspi_smoke.sh /usr/libexec/qos/files-atspi-smoke.sh
RUN chmod 0755 /usr/libexec/qos/collaborative-files-image-contract.sh \
        /usr/libexec/qos/files-atspi-smoke.sh \
    && OS_ROOT=/ /usr/libexec/qos/collaborative-files-image-contract.sh image

# Enrolment invariants, likewise at BUILD time. A build container has no
# /dev/tpm*, which is exactly the path this needs to exercise: the machine with
# no TPM, whose owner has nothing but the passphrase they were asked for. The
# image once shipped an `enrol` that added no passphrase key slot on that path,
# so the volume it produced could not be opened by the secret it had just asked
# for and printed no usable recovery key either. Runs against a throwaway sparse
# file, needs no device-mapper, and takes about ten seconds.
COPY os/tests/luks_enrolment.sh /usr/libexec/qos/luks-enrolment-test.sh
RUN chmod 0755 /usr/libexec/qos/luks-enrolment-test.sh \
    && bash /usr/libexec/qos/luks-enrolment-test.sh

# Validate.
#
# This stays at the end of the rootfs stage, ahead of the kernel split rather than
# moved before it defensively.
# The worry was that lint would reject a split-kernel rootfs — `bootc container
# split-kernel-and-rootfs` moves vmlinuz and initramfs.img out of
# /usr/lib/modules/$kver and into a UKI under /boot — and would have to run
# before the split. It does not: checked against a built split-kernel UKI image
# under bootc 1.16.4, lint exits 0. The `kernel` check counts
# /usr/lib/modules/$kver *directories*, and the split leaves that directory in
# place, so one kernel is still one kernel; `nonempty-boot` is a warning, not a
# fatal, so a UKI in /boot does not fail it either.
RUN bootc container lint

# ---------------------------------------------------------------------------
# The sealed layout: split the kernel out, build the UKI over what remains
# ---------------------------------------------------------------------------
# Three stages, following bootc's documented sealed-image pattern:
#
#   split   the kernel and initramfs move out of /usr/lib/modules/<kver> — bootc
#           refuses to seal an image that still carries them in the rootfs, and
#           they belong in the UKI now.
#   uki     `bootc container ukify` over the split rootfs, so the composefs digest
#           it seals is the digest of what will actually be mounted.
#   final   the split rootfs plus the UKI under /boot, which is the one tree
#           excluded from that digest.
#
# Nothing may be added to the rootfs after the split: the digest was computed over
# it, and a later layer would invalidate the seal. That is why the sealed command
# line and ukify's measurement report are pulled off the `uki` stage by
# os/dev/build-image.sh instead of being copied into the image.

FROM rootfs AS split
RUN mkdir /kernel && bootc container split-kernel-and-rootfs --rootfs / --output /kernel

# A throwaway builder, so ukify and binutils do not ship in the OS image. It comes
# out of the same digest-pinned base and the same frozen RPM snapshot as
# everything else, so no stage of this build reaches the network. The UKI is
# self-contained: its EFI stub comes from this stage's systemd-boot and does not
# have to match the systemd in the rootfs.
FROM ${BASE_REF} AS uki-tools
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        systemd-ukify \
        systemd-boot-unsigned \
        binutils \
    && dnf clean all
COPY os/dev/uki.sh /usr/local/bin/uki.sh
COPY os/dev/make-boot-splash.py /usr/local/bin/make-boot-splash.py

FROM uki-tools AS uki
# Set to the digest `bootc install` asked for, to close the seal in a second pass
# (bootc#2334). Empty on a first pass; see os/dev/uki.sh.
ARG QOS_CFS_DIGEST=
ENV CFS_DIGEST=${QOS_CFS_DIGEST}
# The negative control: 0 builds a UKI that measures perfectly and carries no
# generation, which is what proves rollback-boot-check.sh fails on the generation
# assertions rather than on "nothing measured". Always 1 for a real image.
ARG QOS_SEAL_GENERATION=1
ENV QOS_SEAL_GENERATION=${QOS_SEAL_GENERATION}
# The cache mount on /var/tmp is not an optimisation, it is required. Computing
# the composefs digest builds a temporary composefs repository there, and writing
# an object into it needs O_TMPFILE — which overlayfs, the filesystem a build
# stage's root is, does not support. The failure is "Creating object tmpfile: ...
# Operation not supported (os error 95)" and it names neither /var/tmp nor
# overlayfs. A cache mount is host-backed, so it both supports O_TMPFILE and lets
# the objects survive between builds instead of re-hashing the whole rootfs each
# time. tmpfs would work too but would hold the entire rootfs content in RAM.
RUN --mount=type=cache,target=/var/tmp,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/run \
    --mount=type=bind,from=split,target=/target \
    --mount=type=bind,from=split,source=/kernel,target=/kernel \
    bash /usr/local/bin/uki.sh

# NOTHING MAY BE LAYERED ON THIS IMAGE. A derived image that adds a single file to
# the rootfs has a different composefs digest from the one its inherited UKI seals,
# and `bootc install` refuses it — correctly, since the seal no longer describes
# what would be mounted. Rebuilding the UKI in the derived image is not a way out
# either: the kernel and initramfs are no longer in the rootfs to build one from,
# they are sections of the UKI it inherited.
#
# So `os/Containerfile.test` and `os/Containerfile.installer`, which both do
# `FROM localhost/qos:latest`, have to be built from the UNSEALED rootfs and sealed
# themselves — `podman build --target rootfs` gives them that. Until they are, the
# disk step for those two images fails at the digest check with the message
# os/dev/disk-image.sh prints, rather than producing something that boots wrong.
FROM split AS final
COPY --from=uki /out/*.efi /boot/EFI/Linux/
