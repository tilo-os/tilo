# ---------------------------------------------------------------------------
# Bootloader — swap GRUB for systemd-boot
# ---------------------------------------------------------------------------
# systemd-boot is smaller + simpler than GRUB (no menu render step, no module
# load path, BLS entries loaded straight off the ESP), so cold boot to the
# kernel handoff is measurably shorter. bootc chooses which bootloader to
# plant on the ESP at install time based on the `bootloader` key in the
# /usr/lib/bootc/install/*.toml drop-ins baked into this image (see the
# 40-tilo.toml file below). The `systemd-boot-unsigned` package supplies the
# EFI binaries + BLS layout that bootc/bootupd copy across.
#
# The GRUB stack (grub2 + shim + bootupd's grub2 side) is pulled in by the
# fedora-bootc base and would otherwise still ship on the rootfs, wasting
# ~30 MB and leaving dead code paths in bootupd. Drop it after installing
# systemd-boot so nothing during install can pick GRUB by accident.
#
# dnf5 refuses to remove grub2-efi-x64 / grub2-pc / grub2-tools-minimal /
# shim-x64 (each ships an `/etc/dnf/protected.d/*.conf` marking itself
# protected against removal) and won't accept `--allowerasing` on `remove`.
# The systemd-boot install already satisfies the "some bootloader must
# exist" invariant, so shell out to `rpm -e --nodeps` for the protected
# ones — dnf handles the unprotected ones on the same pass.
#
# Tilo's narrow Rust crypto tool replaces the trust that removal takes away.
# Deleting shim and GRUB, and building a custom kernel, leaves nothing on the boot
# path that a distribution key covers — so the machine has to be able to sign its
# own artefacts and enrol its own Platform Key. tilo-crypto does the signing,
# verification, and bounded efivarfs enrollment. See docs/security/boot-chain.md.
# bootupd goes with them, and that is a requirement of the sealed layout rather
# than tidiness: bootc refuses to seal an image that still offers a bootupd
# install path, because bootupd only ever plants GRUB. Its payload directory and
# the legacy ostree boot dir have to go too — bootc finds the path through either.
# Nothing on this image needs it: with a UKI there is exactly one PE binary on the
# boot path, /usr/libexec/tilo-secureboot signs it with tilo-crypto, and
# tilo-secureboot-sign.path already watches /boot/EFI/Linux for a newly staged one.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        systemd-boot-unsigned \
    && rpm -qa | grep -E '^(shim-(x64|aa64)|grub2-)' | xargs -r rpm -e --nodeps \
    && rpm -e --nodeps bootupd \
    && rm -rf /usr/lib/bootupd /usr/lib/ostree-boot \
    && dnf clean all && ${FINALIZE_RPMDB}

# Splash rendering needs Pillow once. The frozen snapshot already carries it
# through the ukify build spec, so use that existing transaction, render the
# immutable PNGs, then remove both packages in the same layer. UKI construction
# later uses its own throwaway uki-tools stage.
# Retain the base's openssh and openssh-clients: virt-viewer requires them later,
# and the frozen RPM transaction assumes dependencies already in the base remain
# installed. The SSH server remains forbidden by the runtime crypto policy.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        systemd-ukify \
    && python3 /usr/local/bin/make-plymouth-assets.py /usr/share/plymouth/themes/tilo \
    && plymouth-set-default-theme tilo \
    && test "$(plymouth-set-default-theme)" = tilo \
    && dnf --disablerepo='*' remove -y systemd-ukify python3-pillow \
    && installed="$(rpm -qa --qf '%{NAME}\n')" \
    && printf '%s\n' "$installed" | awk '/^(systemd-ukify|openssl|sbsigntools|efitools|mokutil|pesign|nss-tools|gnutls-utils|git|git-core|openvpn|NetworkManager-openvpn|openssh-server)$/' \
           | xargs -r dnf --disablerepo='*' remove -y \
    && installed="$(rpm -qa --qf '%{NAME}\n')" \
    && ! printf '%s\n' "$installed" | grep -Eq '^(python3-pillow|systemd-ukify|openssl|sbsigntools|efitools|mokutil|pesign|nss-tools|gnutls-utils|git|git-core|openvpn|NetworkManager-openvpn|openssh-server)$' \
    && rpm -q openssh openssh-clients \
    && dnf clean all && ${FINALIZE_RPMDB}

# The install-config drop-in that flips bootc's bootloader choice to
# systemd-boot. Lives at /usr/lib/bootc/install/*.toml — a drop-in dir bootc
# merges at every `bootc install {to-disk,to-filesystem}` invocation. bib
# runs the same install code path, so this covers the disk-image step
# (os/dev/disk-image.sh) and the installer's `bootc install to-disk` alike.
COPY os/usr/lib/bootc/install/40-tilo.toml /usr/lib/bootc/install/40-tilo.toml

# ---------------------------------------------------------------------------
# Kernel/userspace hardening (security plan §11 — "table stakes")
# ---------------------------------------------------------------------------
# Kernel args (init_on_alloc/free, lockdown=integrity, slab_nomerge, kstack
# randomisation, page-alloc shuffle, vsyscall=none). bootc applies kargs.d at
# install/upgrade, and `bootc container ukify` seals it into the UKI command line
# at build time — which is what makes this set measured rather than merely
# applied. 03-boot.toml carries the arguments the install step used to inject.
COPY \
    os/usr/lib/bootc/kargs.d/01-hardening.toml \
    os/usr/lib/bootc/kargs.d/00-root.toml \
    os/usr/lib/bootc/kargs.d/03-boot.toml \
    os/usr/lib/bootc/kargs.d/04-mode.toml \
    /usr/lib/bootc/kargs.d/
# Which mode the sealed command line boots into. `tilo.mode=repair` is what the
# repair entry carries, and it can only come from inside the signature — see the
# file's own header for why the two values have to stay the same length.

# Disk-encryption block work: partitioning + LUKS2 + unlock-factor enrolment.
# Used by the installer (os/Containerfile.installer layers tilo-install on top of
# this image), and afterwards on the installed system — `enrol` is also how a
# volume is re-sealed to a replaced TPM, which is exactly the case where the
# machine can only be reached with the recovery key.
COPY --chmod=0755 \
    os/usr/libexec/tilo-disk-encrypt \
    os/usr/libexec/tilo-verified-boot-install-preflight \
    /usr/libexec/

# Owner-enrolled Secure Boot. Tilo builds its own kernel, so the base image's
# Fedora/Microsoft-signed chain cannot cover it; the machine generates its own
# Platform Key instead, which is also what keeps a self-built image attestable
# to a collaborator who trusts that key.
#
# Generating and enrolling keys is a deliberate act the owner takes — nothing
# here does it, and the image build must never do it. What IS enabled by default
# is the re-signing unit, so the hook is already in place before any key is
# enrolled; it is a no-op until keys exist (ConditionPathExists). Getting that
# order wrong — keys enrolled, signing hook missing — is what leaves a machine
# refusing its own kernel.
COPY os/usr/libexec/tilo-secureboot /usr/libexec/tilo-secureboot
COPY --chmod=0755 \
    os/usr/libexec/tilo-image-trust-staged \
    os/usr/libexec/tilo-verified-update \
    /usr/libexec/
COPY \
    os/usr/lib/systemd/system/tilo-secureboot-sign.service \
    os/usr/lib/systemd/system/tilo-secureboot-sign.timer \
    os/usr/lib/systemd/system/tilo-secureboot-sign.path \
    os/usr/lib/systemd/system/tilo-secureboot-sign-shutdown.service \
    /usr/lib/systemd/system/
RUN chmod 0755 /usr/libexec/tilo-secureboot \
    && systemctl enable tilo-secureboot-sign.timer tilo-secureboot-sign.path \
                        tilo-secureboot-sign-shutdown.service

# Runtime tunables: no cross-process debugging, no kernel pointers or ring
# buffer for unprivileged readers, no unprivileged BPF, plus the /tmp
# symlink-race and LAN-spoofing settings. Under
# /usr/lib because it is part of the image; /etc/sysctl.d/ with a higher number
# still wins for a machine that needs to differ. The file's header explains why
# unprivileged user namespaces are NOT disabled — bubblewrap, hence the whole
# app sandbox, needs them.
COPY os/usr/lib/sysctl.d/60-tilo-hardening.conf /usr/lib/sysctl.d/60-tilo-hardening.conf
COPY os/usr/lib/sysctl.d/70-tilo-performance.conf /usr/lib/sysctl.d/70-tilo-performance.conf

# Which sandboxed packages get the expensive protections (hardened allocator +
# hardware shadow stacks). Read by tilo-launcher at launch; scoped rather than
# image-wide because the allocator costs multiples on allocation-heavy work and
# most of this system is Rust, which does not produce the bugs it catches. The
# image owns the list — an app manifest can neither request nor decline it.

# Which sandboxed packages may map memory writable and executable at once.
# Read by tilo-launcher when it compiles the syscall filter. Same reasoning as
# the file above and the same format: a package that could name its own
# profile would be lifting a protection off itself, so the image decides and
# the manifest only asks.
COPY \
    os/usr/lib/tilo/untrusted-parsers.conf \
    os/usr/lib/tilo/jit-entitled.conf \
    /usr/lib/tilo/

# hidepid on /proc + the boot self-check that ASSERTS what's actually active.
COPY \
    os/usr/lib/systemd/system/tilo-security-audit.service \
    os/usr/lib/systemd/system/tilo-security-audit.timer \
    os/usr/lib/systemd/system/tilo-hidepid.service \
    /usr/lib/systemd/system/

# ---------------------------------------------------------------------------
# Bounded rollback protection
# ---------------------------------------------------------------------------
# The last few OS generations may unseal the disk; older ones may not. A TPM2 NV
# monotonic counter holds the OLDEST permitted generation, and each generation's
# LUKS2 keyslot is sealed to a policy requiring the floor to be at or below it.
#
# The generation number this image carries. It MUST be a dense monotonic integer
# (+1 per published image), because the retention window is arithmetic on it —
# "the last three generations" is meaningless if the numbering is a timestamp, and
# moving the floor costs one TPM NV write per step (tilo-rollback refuses an
# advance of more than MAX_INCREMENTS_PER_ADVANCE at all). os/dev/build-image.sh
# resolves it from the published series; the CI job that publishes an image
# derives it the same way and tags the result `gen<N>`.
#
# It reaches the running system by two routes, for two different jobs:
#
#   /usr/lib/bootc/kargs.d/02-generation.toml
#       `bootc container ukify` reads this directory and puts what it finds on the
#       UKI's sealed command line, which systemd-stub measures into PCR 11. That
#       is the authoritative copy — inside the signature, measured, and therefore
#       the one an unseal can be bound to. A number the bootloader assembled from
#       an editable file would look identical and be worth nothing.
#   /usr/lib/tilo/generation
#       A plain file holding the same number, for the one question the command
#       line cannot answer: what generation is the deployment that has been
#       *staged* but never booted? Its keyslot has to be sealed before the reboot
#       that first runs it. Not trusted for anything — at that moment the machine
#       is already unlocked.
#
# Both are written from the same build argument in the same step, so they cannot
# disagree; rollback-boot-check.sh asserts on a booted machine that they don't.
#
# There is deliberately no default. A default is what a constant looks like once
# a caller forgets the argument, and an image that silently ships generation 0 is
# one whose rollback floor can never move — the failure would appear months later
# as a machine that will not unseal.
ARG TILO_GENERATION
RUN case "${TILO_GENERATION}" in \
      ''|*[!0-9]*) \
        echo "TILO_GENERATION must be a decimal integer; got '${TILO_GENERATION}'." >&2; \
        echo "It is the generation this image carries: +1 per published image, sealed" >&2; \
        echo "onto the UKI command line. os/dev/build-image.sh resolves it from the" >&2; \
        echo "published series; pass TILO_GENERATION=<N> to build one by hand." >&2; \
        exit 1 ;; \
    esac \
 && install -d -m 0755 /usr/lib/tilo \
 && printf '%s\n' "${TILO_GENERATION}" > /usr/lib/tilo/generation \
 && printf '# Written by the image build from the TILO_GENERATION build argument.\nkargs = ["tilo.generation=%s"]\n' \
      "${TILO_GENERATION}" > /usr/lib/bootc/kargs.d/02-generation.toml \
 && echo "generation ${TILO_GENERATION}: sealed via kargs.d, readable at /usr/lib/tilo/generation"

# tpm2-tools: the NV counter, the policy sessions and TPM2_NV_Certify are driven
# through it. Also reachable from recovery mode, which is where someone will need
# it when automatic unlock has failed.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        tpm2-tools \
    && dnf clean all && ${FINALIZE_RPMDB} && rm -rf /var/cache/dnf /var/log/dnf* /var/lib/dnf

COPY --from=rollback-files / /
RUN chmod 0755 /usr/libexec/tilo-rollback-common /usr/libexec/tilo-rollback-confirm \
        /usr/libexec/tilo-rollback-initrd-unlock \
        /usr/libexec/tilo-root-discover \
        /usr/lib/systemd/system-generators/tilo-rollback-unlock-generator \
        /usr/lib/systemd/system-generators/tilo-root-generator \
        /usr/lib/dracut/modules.d/91tilo-rollback/module-setup.sh \
        /usr/libexec/tilo-rollback-harden /usr/libexec/tilo-rollback-boot-check \
 && install -d -m 0755 /usr/share/tilo/pcr-predictions

# ---------------------------------------------------------------------------
# Getting back from a bad update: boot assessment, rollback, repair mode
# ---------------------------------------------------------------------------
# The rollback machinery above narrows which generations may unseal the disk. This
# is the other half — the part that notices a generation is bad and gets the
# machine off it.
#
#   tilo-boot-entries.timer     schedules non-blocking maintenance that gives every
#                              not-yet-proven deployment a systemd-boot try counter
#                              and derives the repair entry.
#   tilo-boot-health.service    ordered before boot-complete.target, so a boot that
#                              never reaches a login is never blessed and the
#                              counter it spent stays spent.
#   tilo-boot-mode-generator    turns `tilo.mode=repair` on the SEALED command line
#                              into a boot that comes up at the repair console
#                              instead of the desktop.
#
# `bootc rollback` is the command that should do this and it is not dependable on
# the composefs backend (bootc#2208), so /usr/libexec/tilo-deployment verifies what
# it did and falls back to the boot loader's own default entry.
#
# uki-cmdline.py ships as tilo-uki-cmdline because the repair entry is DERIVED from
# the installed UKI rather than built: a second UKI inside the rootfs would change
# the composefs digest it has to name. It rewrites `tilo.mode=normal` to
# `tilo.mode=repair` in place, same length, so every following PE section keeps its
# offset and the image still loads.
# The user-facing command. Thin: the work is in tilo-deployment, and this is the
# part that decides how to become root to run it — directly when already root,
# through the polkit-authorised unit from a desktop session, and saying to use
# sudo rather than failing with a permission error from three layers down.
COPY --from=recovery-files / /
# The narrow polkit grant that makes Settings' rollback control and its automatic
# -updates switch able to do what they say. See the rule for how narrow.
# The boot-side check, bundled so it can be re-run on a live machine. It is the
# only place several of these facts can be established at all — see its header.

# The signed PCR predictions this image was built with go in
# /usr/share/tilo/pcr-predictions/generation-<N>*.json, produced by
# `tilo-rollback sign-prediction` on the build host — the private half of
# keys/tpm2-pcr-signing.pem is deliberately not in the image, so a device cannot
# sign its own expected measurements. This layer is necessarily empty because
# the final composefs-resealed UKI does not exist yet. build-image.sh measures
# that exact UKI with its paired systemd-measure and adds authority-verified
# prediction sidecars in a /boot-only layer; published builds fail closed if the
# protected signer is unavailable.

# Hardened userspace allocator (scudo, from compiler-rt) LD_PRELOADed into the
# trusted-base daemon fs.service. Resolve the lib path at build time and bake a
# drop-in, so a packaging move can't silently leave a dangling LD_PRELOAD that
# would fail the service. (Base daemons use the system allocator — verified no
# jemalloc — so the preload is safe.)
#
# Alongside it, hardware shadow stacks. Every binary in this image is marked
# shadow-stack compatible at link time, but Fedora's glibc only switches them on
# when a process also asks through this tunable — which is precisely what makes
# the protection scopeable instead of global. fs.service earns it because it
# parses bytes that arrived from a peer. Measured cost on an allocation-heavy
# loop: about 8%. If the CPU, the kernel or any loaded library cannot support
# it, glibc leaves shadow stacks off rather than failing, and
# tilo-security-audit reports which processes actually got them.
#
# Only Scudo has to remain for tilo-launcher's scoped hardening. Copy that one
# DSO to a stable image-owned path, then erase compiler-rt's other sanitizers,
# runtimes, headers, and versioned toolchain tree.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo compiler-rt && \
    scudo="$(find /usr/lib /usr/lib64 -name 'libclang_rt.scudo_standalone.so' 2>/dev/null | head -1)" && \
    test -n "$scudo" && \
    install -D -m 0755 "$scudo" /usr/lib/tilo/libclang_rt.scudo_standalone.so && \
    rpm -e --nodeps compiler-rt clang-resource-filesystem && \
    ! rpm -q compiler-rt clang-resource-filesystem >/dev/null 2>&1 && \
    test -s /usr/lib/tilo/libclang_rt.scudo_standalone.so && \
    dnf clean all && ${FINALIZE_RPMDB} && \
    scudo=/usr/lib/tilo/libclang_rt.scudo_standalone.so && \
    mkdir -p /usr/lib/systemd/system/fs.service.d && \
    printf '[Service]\n# Hardened userspace allocator; path resolved at image build.\nEnvironment=LD_PRELOAD=%s\n# Hardware shadow stacks. The ELF marking alone does not enable them.\nEnvironment=GLIBC_TUNABLES=glibc.cpu.hwcaps=SHSTK\n' "$scudo" \
      > /usr/lib/systemd/system/fs.service.d/10-hardened-malloc.conf && \
    echo "scudo wired: $scudo"

# Windows compatibility is intentionally assembled at the end of the rootfs.
# The compacted VirtIO media payload is large; placing it earlier makes
# rootless Podman rescan that immutable layer for every subsequent COPY/RUN and
# turns safe installer iteration into hours of avoidable layer commits.
# Wine is the tested desktop-program baseline; UMU + its pinned Proton build are
# copied below for non-Steam games. The appliance packages provide one
# KVM-accelerated, TPM-backed Windows fallback. Changing this list requires
# refreshing RPMS_REF (see the file header).
# tilo-rpm-snapshot-package[x86_64]: edk2-ovmf
# tilo-rpm-snapshot-package[x86_64]: wine
# tilo-rpm-snapshot-package[x86_64]: wine-dxvk
# tilo-rpm-snapshot-package[aarch64]: edk2-aarch64
# Native FEX executable/Qt frontend dependencies and host graphics/audio thunks.
# tilo-rpm-snapshot-package[aarch64]: glibc
# tilo-rpm-snapshot-package[aarch64]: libgcc
# tilo-rpm-snapshot-package[aarch64]: libstdc++
# tilo-rpm-snapshot-package[aarch64]: libglvnd-glx
# tilo-rpm-snapshot-package[aarch64]: libglvnd-opengl
# tilo-rpm-snapshot-package[aarch64]: libglvnd-egl
# tilo-rpm-snapshot-package[aarch64]: qt6-qtbase
# tilo-rpm-snapshot-package[aarch64]: qt6-qtbase-gui
# tilo-rpm-snapshot-package[aarch64]: qt6-qtdeclarative
# tilo-rpm-snapshot-package[aarch64]: alsa-lib
# tilo-rpm-snapshot-package[aarch64]: libdrm
# tilo-rpm-snapshot-package[aarch64]: libwayland-client
# tilo-rpm-snapshot-package[aarch64]: vulkan-loader
ARG TILO_WINDOWS_ARCH
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    test "$(uname -m)" = "$TILO_WINDOWS_ARCH" && \
    case "$(uname -m)" in \
      x86_64) vm_firmware=edk2-ovmf; windows_packages='wine wine-dxvk' ;; \
      aarch64) vm_firmware=edk2-aarch64; windows_packages='glibc libgcc libstdc++ libglvnd-glx libglvnd-opengl libglvnd-egl qt6-qtbase qt6-qtbase-gui qt6-qtdeclarative alsa-lib libdrm libwayland-client vulkan-loader' ;; \
      *) echo 'unsupported Windows VM firmware architecture' >&2; exit 1 ;; \
    esac && dnf install -y --setopt=reposdir=/repo \
    $windows_packages \
    qemu-kvm \
    libvirt-client \
    libvirt-daemon-kvm \
    libvirt-daemon-config-nwfilter \
    swtpm \
    swtpm-tools \
    "$vm_firmware" \
    freerdp \
    xwayland-satellite \
    virt-viewer \
    xorriso \
    genisoimage \
    udftools \
    && dnf clean all && ${FINALIZE_RPMDB}

COPY --from=windows-provider /out/usr/ /usr/
RUN --network=none --mount=type=bind,source=os/dev/windows_provider.py,target=/tilo-windows-provider.py,ro \
    python3 /tilo-windows-provider.py host --manifest /usr/share/tilo/windows/provider.json
COPY --from=virtio-win-media /out/virtio-win.iso /usr/share/virtio-win/virtio-win.iso
COPY --from=virtio-win-media /out/installer/virtio-win-guest-tools.exe /usr/share/virtio-win/installer/virtio-win-guest-tools.exe

COPY --from=windows-compat-artifacts /out/bin/umu-run /usr/libexec/tilo-umu-run
COPY --from=windows-compat-artifacts /out/bin/umu_run.py /usr/libexec/umu_run.py
COPY --from=windows-compat-artifacts /out/proton/ /usr/lib/tilo/windows-runners/proton/
COPY --from=windows-compat-artifacts /out/steam-runtime/ /usr/lib/tilo/windows-runners/steam-runtime/
COPY --from=windows-compat-artifacts /out/catalogues/ /usr/share/tilo/windows/catalogues/
COPY os/usr/share/tilo/windows/fex-emulator.json os/usr/share/tilo/windows/fex-graphics-provider.json /usr/share/tilo/windows/
# The VM is defined only after an owner supplies installation media. These
# immutable host/guest contracts deliberately ship no Windows image or key.
COPY \
    os/usr/libexec/tilo-windows-vm-network \
