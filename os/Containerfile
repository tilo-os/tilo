COPY os/docs/peer-sync.md /usr/share/doc/qos/peer-sync.md
# The Secure Boot + disk-encryption procedure. On-image because the enrolment
# sequence has to be readable from the machine being enrolled, which is the one
# place a wrong step stops it from booting.
COPY docs/secure-boot.md /usr/share/doc/qos/secure-boot.md

# ---------------------------------------------------------------------------
# Bootloader — GRUB via bootupd
# ---------------------------------------------------------------------------
# The GRUB stack (grub2 + shim, and the payload bootupd plants from them) comes
# from the fedora-bootc base and MUST stay. bootc's ostree backend — the backend
# every qOS install path uses — installs the bootloader by calling bootupd, and
# bootupd's only EFI payload is grub2 + shim. See the long comment in
# os/usr/lib/bootc/install/40-qos.toml for the code path; the short version is
# that bootc has no systemd-boot support outside its composefs backend, so an
# image without GRUB cannot be installed at all.
#
# Two things make that failure mode easy to reintroduce, so they are called out:
#
#  * The payload lives in /usr/lib/efi/<component>/<rpm_evr>/EFI/, owned by
#    grub2-efi-x64 and shim-x64. Removing those packages empties the payload
#    while leaving /usr/lib/bootupd/updates/EFI.json still naming them, and
#    `bootupctl backend generate-update-metadata` re-derives the same names from
#    the now-empty directories and exits 0 — so the image looks self-consistent
#    and still fails at install time.
#  * The frozen RPM snapshot resolves against what this file installs. Once the
#    packages were removed here they left the snapshot too, so putting them back
#    is "stop removing them", not "dnf install them" — they are only ever
#    inherited from the base.
#
# systemd-boot-unsigned stays installed: it costs ~150 KB, it is what a future
# move to bootc's composefs backend would plant, and /usr/libexec/qos-secureboot
# signs whichever loader is actually on the ESP.
#
# sbsigntools and efitools cover the trust that building our own kernel takes
# away. shim and GRUB carry Fedora signatures, but the qOS kernel they chainload
# does not, so the machine still has to sign its own kernels and enrol its own
# Platform Key. sbsign/sbverify do the signing, cert-to-efi-sig-list/
# efi-updatevar/efi-readvar the enrolment; without them
# /usr/libexec/qos-secureboot can only refuse. See docs/secure-boot.md.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        systemd-boot-unsigned \
    && dnf clean all

# Fail the build rather than ship an uninstallable image. Each of these is a
# thing that was true of the image that could not be installed: the bootloader
# bootc will ask bootupd for has to have a payload on disk, and the install
# config has to name a bootloader bootc's ostree backend can actually plant.
RUN set -eu; \
    test -f /usr/lib/bootupd/updates/EFI.json \
      || { echo "bootupd EFI metadata missing"; exit 1; }; \
    grep -q '"name":"shim"' /usr/lib/bootupd/updates/EFI.json \
      || { echo "bootupd EFI metadata does not describe shim"; exit 1; }; \
    grep -q '"name":"grub2"' /usr/lib/bootupd/updates/EFI.json \
      || { echo "bootupd EFI metadata does not describe grub2"; exit 1; }; \
    test -n "$(find /usr/lib/efi -name 'shimx64.efi' -print -quit)" \
      || { echo "bootupd EFI payload has no shimx64.efi"; exit 1; }; \
    test -n "$(find /usr/lib/efi -name 'grubx64.efi' -print -quit)" \
      || { echo "bootupd EFI payload has no grubx64.efi"; exit 1; }; \
    echo "bootupd EFI payload + metadata present"

# The signing tools, in their own transaction and allowed to be absent.
#
# They are named here so the snapshot job keeps resolving them into the frozen
# package set, but a snapshot that predates them must not fail the whole image
# build: nothing on the boot path needs them, and the one thing that does —
# /usr/libexec/qos-secureboot — already refuses every command with the exact
# remedy when they are missing. The safety property lives in the tool failing
# closed, not in the build failing open. systemd-boot-unsigned above stays in a
# strict transaction, because an image with no bootloader IS a broken image.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --skip-unavailable --setopt=reposdir=/repo \
        sbsigntools \
        efitools \
    && dnf clean all

# The install-config drop-in that pins bootc's bootloader choice. Lives at
# /usr/lib/bootc/install/*.toml — a drop-in dir bootc merges at every
# `bootc install {to-disk,to-filesystem}` invocation. bib (bootc-image-builder)
# runs the same install code path when it builds a qcow2, so this covers both
# interactive Anaconda installs and the direct bib->qcow2 path.
COPY os/usr/lib/bootc/install/40-qos.toml /usr/lib/bootc/install/40-qos.toml

# `bootloader = "systemd"` here is what made every install fail; bootc's ostree
# backend bails on it instead of falling back. Refuse to build the image rather
# than discover that from a failed install.
RUN set -eu; \
    grep -qE '^[[:space:]]*bootloader[[:space:]]*=[[:space:]]*"grub"' \
        /usr/lib/bootc/install/40-qos.toml \
      || { echo "install config does not select a bootloader bootc's ostree backend can plant"; exit 1; }; \
    echo "install config selects grub"

# ---------------------------------------------------------------------------
# Kernel/userspace hardening (security plan §11 — "table stakes")
# ---------------------------------------------------------------------------
# Kernel args (init_on_alloc/free, lockdown=integrity, slab_nomerge, kstack
# randomisation, page-alloc shuffle, vsyscall=none). bootc applies kargs.d at
# install/upgrade.
COPY os/usr/lib/bootc/kargs.d/01-hardening.toml /usr/lib/bootc/kargs.d/01-hardening.toml

# Disk-encryption block work: partitioning + LUKS2 + unlock-factor enrolment.
# Used by the installer (os/Containerfile.installer layers qos-install on top of
# this image), and afterwards on the installed system — `enrol` is also how a
# volume is re-sealed to a replaced TPM, which is exactly the case where the
# machine can only be reached with the recovery key.
COPY os/usr/libexec/qos-disk-encrypt /usr/libexec/qos-disk-encrypt
RUN chmod 0755 /usr/libexec/qos-disk-encrypt

# Owner-enrolled Secure Boot. qOS builds its own kernel, so the base image's
# Fedora/Microsoft-signed chain cannot cover it; the machine generates its own
# Platform Key instead, which is also what keeps a self-built image attestable
# to a collaborator who trusts that key.
#
# Generating and enrolling keys is a deliberate act the owner takes — nothing
# here does it, and the image build must never do it. What IS enabled by default
# is the re-signing unit, so the hook is already in place before any key is
# enrolled; it is a no-op until keys exist (ConditionPathExists). Getting that
# order wrong — keys enrolled, signing hook missing — is what leaves a machine
# refusing its own kernel.
COPY os/usr/libexec/qos-secureboot /usr/libexec/qos-secureboot
COPY os/usr/lib/systemd/system/qos-secureboot-sign.service /usr/lib/systemd/system/qos-secureboot-sign.service
COPY os/usr/lib/systemd/system/qos-secureboot-sign.path /usr/lib/systemd/system/qos-secureboot-sign.path
COPY os/usr/lib/systemd/system/qos-secureboot-sign-shutdown.service /usr/lib/systemd/system/qos-secureboot-sign-shutdown.service
RUN chmod 0755 /usr/libexec/qos-secureboot \
    && systemctl enable qos-secureboot-sign.service qos-secureboot-sign.path \
                        qos-secureboot-sign-shutdown.service

# Runtime tunables: no cross-process debugging, no kernel pointers or ring
# buffer for unprivileged readers, no unprivileged BPF, no kexec, no io_uring
# or userfaultfd, plus the /tmp symlink-race and LAN-spoofing settings. Under
# /usr/lib because it is part of the image; /etc/sysctl.d/ with a higher number
# still wins for a machine that needs to differ. The file's header explains why
# unprivileged user namespaces are NOT disabled — bubblewrap, hence the whole
# app sandbox, needs them.
COPY os/usr/lib/sysctl.d/60-qos-hardening.conf /usr/lib/sysctl.d/60-qos-hardening.conf

# Which sandboxed packages get the expensive protections (hardened allocator +
# hardware shadow stacks). Read by qos-launcher at launch; scoped rather than
# image-wide because the allocator costs multiples on allocation-heavy work and
# most of this system is Rust, which does not produce the bugs it catches. The
# image owns the list — an app manifest can neither request nor decline it.
COPY os/usr/lib/qos/untrusted-parsers.conf /usr/lib/qos/untrusted-parsers.conf

# hidepid on /proc + the boot self-check that ASSERTS what's actually active.
COPY os/usr/libexec/qos-security-audit /usr/libexec/qos-security-audit
COPY os/usr/lib/systemd/system/qos-security-audit.service /usr/lib/systemd/system/qos-security-audit.service
COPY os/usr/lib/systemd/system/qos-hidepid.service /usr/lib/systemd/system/qos-hidepid.service
RUN chmod 0755 /usr/libexec/qos-security-audit

# ---------------------------------------------------------------------------
# Bounded rollback protection
# ---------------------------------------------------------------------------
# The last few OS generations may unseal the disk; older ones may not. A TPM2 NV
# monotonic counter holds the OLDEST permitted generation, and each generation's
# LUKS2 keyslot is sealed to a policy requiring the floor to be at or below it.
#
# The generation number this image carries. It MUST be a dense monotonic integer
# (+1 per published image), because the retention window is arithmetic on it —
# "the last three generations" is meaningless if the numbering is a timestamp. It
# MUST also match the `qos.generation=` value on the sealed UKI command line: that
# is the copy an attacker cannot forge, and the copy every unseal is bound to.
# The file below exists only so that a *staged* deployment's generation can be
# read before it has ever booted, which is when its keyslot has to be sealed.
ARG QOS_GENERATION=0
RUN install -d -m 0755 /usr/lib/qos \
 && printf '%s\n' "${QOS_GENERATION}" > /usr/lib/qos/generation

# tpm2-tools: the NV counter, the policy sessions and TPM2_NV_Certify are driven
# through it. Also reachable from recovery mode, which is where someone will need
# it when automatic unlock has failed.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        tpm2-tools \
    && dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* /var/lib/dnf

COPY --from=builder /out/qos-rollback /usr/bin/qos-rollback
COPY os/usr/libexec/qos-rollback-common /usr/libexec/qos-rollback-common
COPY os/usr/libexec/qos-rollback-confirm /usr/libexec/qos-rollback-confirm
COPY os/usr/libexec/qos-rollback-harden /usr/libexec/qos-rollback-harden
COPY os/usr/lib/systemd/system/qos-rollback-confirm.service /usr/lib/systemd/system/qos-rollback-confirm.service
COPY os/usr/lib/systemd/system/qos-rollback-confirm.timer /usr/lib/systemd/system/qos-rollback-confirm.timer
COPY os/usr/lib/systemd/system/qos-rollback-harden.service /usr/lib/systemd/system/qos-rollback-harden.service
COPY os/tests/rollback-boot-check.sh /usr/libexec/qos-rollback-boot-check
RUN chmod 0755 /usr/libexec/qos-rollback-common /usr/libexec/qos-rollback-confirm \
        /usr/libexec/qos-rollback-harden /usr/libexec/qos-rollback-boot-check \
 && install -d -m 0755 /usr/share/qos/pcr-predictions

# The signed PCR predictions this image was built with go in
# /usr/share/qos/pcr-predictions/generation-<N>*.json, produced by
# `qos-rollback sign-prediction` on the build host — the private half of
# keys/tpm2-pcr-signing.pem is deliberately not in the image, so a device cannot
# sign its own expected measurements. Until the UKI is built and measured there is
# nothing meaningful to predict, so the directory ships empty and the enrollment
# path refuses to seal a keyslot without a prediction rather than sealing one that
# can never open.

# Hardened userspace allocator (scudo, from compiler-rt) LD_PRELOADed into the
# trusted-base daemon fs.service. Resolve the lib path at build time and bake a
# drop-in, so a packaging move can't silently leave a dangling LD_PRELOAD that
# would fail the service. (Base daemons use the system allocator — verified no
# jemalloc — so the preload is safe.)
#
# Alongside it, hardware shadow stacks. Every binary in this image is marked
# shadow-stack compatible at link time, but Fedora's glibc only switches them on
# when a process also asks through this tunable — which is precisely what makes
# the protection scopeable instead of global. fs.service earns it because it
# parses bytes that arrived from a peer. Measured cost on an allocation-heavy
# loop: about 8%. If the CPU, the kernel or any loaded library cannot support
# it, glibc leaves shadow stacks off rather than failing, and
# qos-security-audit reports which processes actually got them.
#
# compiler-rt also has to be present for qos-launcher's scoped hardening, which
# preloads the same library into the packages listed in
# /usr/lib/qos/untrusted-parsers.conf.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo compiler-rt && dnf clean all && \
    scudo="$(find /usr/lib /usr/lib64 -name 'libclang_rt.scudo_standalone.so' 2>/dev/null | head -1)" && \
    test -n "$scudo" && \
    mkdir -p /usr/lib/systemd/system/fs.service.d && \
    printf '[Service]\n# Hardened userspace allocator; path resolved at image build.\nEnvironment=LD_PRELOAD=%s\n# Hardware shadow stacks. The ELF marking alone does not enable them.\nEnvironment=GLIBC_TUNABLES=glibc.cpu.hwcaps=SHSTK\n' "$scudo" \
      > /usr/lib/systemd/system/fs.service.d/10-hardened-malloc.conf && \
    echo "scudo wired: $scudo"

# Confine the collaborative filesystem daemon in its own SELinux domain
# (qos_fs_t) instead of unconfined_service_t. Shipped permissive so it can't
# break the working daemon; tightens to enforcing from captured AVCs (see the
# module header). The drop-in runs fs.service in the domain via SELinuxContext.
COPY os/usr/share/qos/selinux/qos-base.cil /usr/share/qos/selinux/qos-base.cil
COPY os/usr/lib/systemd/system/fs.service.d/20-selinux.conf /usr/lib/systemd/system/fs.service.d/20-selinux.conf
# `libsemanage` writes a sandbox at /etc/selinux/targeted/tmp during
# install and fails "File exists" if any prior partial state carried
# forward (a caching quirk under rootless podman that CI's docker
# daemon happens to sidestep). Clear it first.
# libsemanage builds its sandbox by hardlinking the current policy store, and a
# hardlink to a file that lives in a lower container layer fails EEXIST — which
# surfaces as "Could not copy files to sandbox /etc/selinux/targeted/tmp (File
# exists)" while that directory is demonstrably absent. Removing the stale
# sandbox, which this step already did, addresses the wrong half: the store
# itself has to exist in this layer. Copy it into place first.
RUN cp -a /etc/selinux/targeted /var/tmp/qos-sestore \
 && rm -rf /etc/selinux/targeted \
 && mv /var/tmp/qos-sestore /etc/selinux/targeted \
 && rm -rf /etc/selinux/targeted/tmp \
 && semodule -i /usr/share/qos/selinux/qos-base.cil \
 && echo "qos-base SELinux module loaded"

# ---------------------------------------------------------------------------
# Enable services
# ---------------------------------------------------------------------------
# `shell-portal.service` is `--global` enabled so it lights up for every user
# account; `shell-peer-sync.service` is pointedly **NOT** enabled — that's the
# user-opt-in part.
#
# C6 audio: enable the PipeWire user stack for every account (socket-activated
# pipewire + pipewire-pulse, plus the wireplumber session manager).
RUN systemctl enable greetd.service && \
    systemctl set-default graphical.target && \
    systemctl enable shell-firstboot.service && \
    systemctl enable fs.service && \
    systemctl --global enable shell-portal.service && \
    systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service

# C2 time sync, C5 firewall, C7 bluetooth, C8 power — system services.
RUN systemctl enable chronyd.service && \
    systemctl enable firewalld.service && \
    systemctl enable bluetooth.service && \
    systemctl enable power-profiles-daemon.service && \
    systemctl enable systemd-homed.service && \
    systemctl enable qos-power.service

# §11 hardening services: hidepid remount + the boot security self-check.
RUN systemctl enable qos-hidepid.service && \
    systemctl enable qos-security-audit.service && \
    systemctl enable qos-rollback-harden.service && \
    systemctl enable qos-rollback-confirm.timer

# A3: automatic bootc updates. The timer pulls + applies the image at
# QOS_TARGET_IMGREF (code.podesta.ai/qos/qos:latest, baked at install by
# qos-install) on a schedule, so installed systems stay current.
RUN systemctl enable bootc-fetch-apply-updates.timer

# Boot-time prune. These units sit on the critical chain but their work
# is either irrelevant to a desktop qOS (offline man-db caching), or a
# `Wants=network-online.target` wait we don't need (nothing on the boot
# path blocks on a routable interface — the shell + peer sync tolerate
# late network), or plymouth cleanup that we avoid by not booting with
# plymouth in the first place. Masking (not just disabling) makes them
# unable to be pulled in by transitive `Wants=`.
#
# `|| true` because the unit is only present when its package is
# installed — we don't fail the image build if a mask target is absent.
RUN for u in \
        NetworkManager-wait-online.service \
        systemd-networkd-wait-online.service \
        plymouth-quit-wait.service \
        plymouth-quit.service \
        man-db-cache-update.timer \
        man-db-cache-update.service \
        systemd-update-utmp.service \
    ; do systemctl mask "$u" || true; done

# C5 firewall policy. Default to the desktop zone (FedoraWorkstation), whose
# 1025-65535 tcp/udp ranges already cover the compositor's peer-sync traffic:
#   * mDNS LAN discovery on 5353/udp (also added explicitly below).
#   * The libp2p/gossipsub TCP listener, which binds an EPHEMERAL port
#     (`/ip4/0.0.0.0/tcp/0` in shell/src/network/p2p.rs) inside that range.
# firewalld isn't running at build time, so edit the permanent config offline.
RUN firewall-offline-cmd --set-default-zone=FedoraWorkstation && \
    firewall-offline-cmd --zone=FedoraWorkstation --add-service=mdns

# ---------------------------------------------------------------------------
# Custom qOS kernel: swap Fedora's kernel-core for our tuned qos-kernel-core.
# ---------------------------------------------------------------------------
# The kernel image (see os/kernel/Containerfile + .forgejo/workflows/
# build-kernel.yml) rebuilds Fedora's kernel with a config fragment that:
#   * links the storage/net/USB/HID boot-path drivers statically, so the
#     boot path needs no module loading to reach the root device, and
#   * tunes for interactive throughput (PREEMPT + HZ=1000 + THP=always +
#     SCHED_MC), and
#   * drops DEBUG_INFO so the RPM doesn't carry ~800 MB of debuginfo.
#
# Because the qos-kernel repo is a distinct OCI image (KERNEL_RPMS_REF),
# we mount it alongside the frozen repo, write a two-repo dnf config on
# the fly, and swap kernel-core → qos-kernel-core.  --nogpgcheck: our
# in-house RPMs aren't signed by Fedora's key; provenance for the whole
# image is verified via cosign against code.podesta.ai/qos/qos-kernel
# (see os/etc/containers/policy.json).
#
# An initramfs is mandatory, and the static drivers do not remove the need
# for one: unlocking an encrypted root takes early USERSPACE (device-mapper
# setup, a TPM unseal or a passphrase prompt, systemd-cryptsetup). Static
# drivers get the kernel as far as seeing the block device; they cannot open
# a LUKS volume. Under the base's `layout=ostree` kernel-install config,
# kernel-install deliberately does not run dracut, so the image build owns
# initramfs generation — hence the explicit dracut call below. The base's
# dracut drop-ins (/usr/lib/dracut/dracut.conf.d/*bootc*) already add the
# crypt, systemd-cryptsetup, tpm2-tss and clevis modules.
RUN --mount=type=bind,from=rpms,source=/repo,target=/frozen-repo \
    --mount=type=bind,from=kernel-rpms,source=/repo,target=/qkernel-repo \
    set -eux; \
    mkdir -p /etc/qos-swap.d; \
    printf '[frozen]\nname=frozen\nbaseurl=file:///frozen-repo\ngpgcheck=0\nenabled=1\n' \
        > /etc/qos-swap.d/frozen.repo; \
    printf '[qos-kernel]\nname=qos-kernel\nbaseurl=file:///qkernel-repo\ngpgcheck=0\nenabled=1\n' \
        > /etc/qos-swap.d/qos-kernel.repo; \
    # --allowerasing lets the swap drop the base's `kernel` meta-package
    # (it hard-requires kernel-core-uname-r = <exact-fedora-version>,
    # which our qos-kernel-core doesn't satisfy since it carries a
    # different Release tag). qos-kernel-core Provides: kernel so nothing
    # downstream loses a dependency.
    dnf swap -y --setopt=reposdir=/etc/qos-swap.d --nogpgcheck --allowerasing \
        kernel-core qos-kernel-core; \
    rm -rf /etc/qos-swap.d; \
    # Which kernel version did the swap leave behind? Ask the filesystem: rpm is
    # no help here, because qos-kernel-core provides no kernel-uname-r and its
    # file list records /lib/modules/... where a query would say /usr/lib/... .
    # Exactly one modules directory must remain, and anything else is a build
    # failure that says what it saw rather than an empty variable.
    kver=""; n=0; \
    for d in /usr/lib/modules/*/; do kver="$(basename "$d")"; n=$((n+1)); done; \
    if [ "$n" -ne 1 ]; then \
      echo "expected exactly one /usr/lib/modules entry after the kernel swap, found $n" >&2; \
      ls -la /usr/lib/modules/ >&2 || true; \
      exit 1; \
    fi; \
    # qos-kernel-core installs its kernel as /boot/vmlinuz-<kver>, not into the
    # modules directory the way Fedora's kernel-core does. ostree does find it
    # there — it falls back to /boot/vmlinuz-<kver> — which is why nobody noticed,
    # but it means the image carried a kernel and no initramfs beside it, and
    # every tool that goes looking for the pair (this build included) came up
    # empty. Put both where the base image puts them.
    if [ -f "/boot/vmlinuz-$kver" ] && [ ! -f "/usr/lib/modules/$kver/vmlinuz" ]; then \
      mv "/boot/vmlinuz-$kver" "/usr/lib/modules/$kver/vmlinuz"; \
    fi; \
    test -f "/usr/lib/modules/$kver/vmlinuz"; \
    # The base ships a prebuilt initramfs for ITS kernel, and that file is
    # owned by no RPM — so removing kernel-core leaves the old modules
    # directory behind and the image would carry two kernel versions.
    for d in /usr/lib/modules/*; do \
      [ "$d" = "/usr/lib/modules/$kver" ] || rm -rf "$d"; \
    done; \
    # --add rather than trusting the base's drop-ins to pull these in: the same
    # invocation produced an initramfs WITH the crypt modules locally and WITHOUT
    # them under the CI builder, silently, and a missing module here is a root
    # that cannot be unlocked. Naming them makes dracut fail instead of omit.
    dracut --force --reproducible -v --kver "$kver" \
        --add "crypt systemd-cryptsetup tpm2-tss" \
        "/usr/lib/modules/$kver/initramfs.img" > /tmp/dracut.log 2>&1 \
      || { cat /tmp/dracut.log >&2; exit 1; }; \
    test -s "/usr/lib/modules/$kver/initramfs.img"; \
    # Record what dracut says it included, and check THAT rather than reading the
    # image back. dracut wraps the contents in a squashfs, and listing one needs
    # privileges an unprivileged image builder does not have — so inspecting the
    # artefact reports "no cryptsetup" for an initramfs that has it. dracut's own
    # report is the same fact without the privilege dependency, and shipping the
    # list lets the runtime check use it too.
    mkdir -p /usr/lib/qos; \
    sed -n 's/.*Including module: \([a-z0-9_-]*\).*/\1/p' /tmp/dracut.log \
      | sort -u > /usr/lib/qos/initramfs-modules.txt; \
    for m in crypt systemd-cryptsetup tpm2-tss; do \
      grep -qx "$m" /usr/lib/qos/initramfs-modules.txt || { \
        echo "dracut did not include the $m module; an encrypted root could not be opened" >&2; \
        cat /usr/lib/qos/initramfs-modules.txt >&2; exit 1; }; \
    done; \
    rm -f /tmp/dracut.log; \
    # /boot belongs to the deployment, not the image: whatever the kernel
    # packages dropped there is now duplicated under the modules directory.
    rm -f /boot/vmlinuz-* /boot/initramfs-* /boot/System.map-* /boot/config-*; \
    dnf clean all

# Boot-chain invariants, asserted at BUILD time so the image cannot ship in the
# state it once did: offering `qos-install --encrypt` while carrying no
# initramfs, which leaves the kernel able to see the LUKS device and unable to
# open it. Also bundled so an operator can re-run it on a live machine.
COPY os/tests/boot_chain_invariants.sh /usr/libexec/qos/boot-chain-test.sh
RUN chmod 0755 /usr/libexec/qos/boot-chain-test.sh \
    && OS_ROOT=/ bash /usr/libexec/qos/boot-chain-test.sh

# Enrolment invariants, likewise at BUILD time. A build container has no
# /dev/tpm*, which is exactly the path this needs to exercise: the machine with
# no TPM, whose owner has nothing but the passphrase they were asked for. The
# image once shipped an `enrol` that added no passphrase key slot on that path,
# so the volume it produced could not be opened by the secret it had just asked
# for and printed no usable recovery key either. Runs against a throwaway sparse
# file, needs no device-mapper, and takes about ten seconds.
COPY os/tests/luks_enrolment.sh /usr/libexec/qos/luks-enrolment-test.sh
RUN chmod 0755 /usr/libexec/qos/luks-enrolment-test.sh \
    && bash /usr/libexec/qos/luks-enrolment-test.sh

# Validate
RUN bootc container lint
