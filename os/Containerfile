# App launcher + runtime-bundle CLI. `qos-launcher` is what actually
# execs installed / declared packages inside their bwrap sandbox;
# `qos-runtime-bundle` is the CLI over the same crate that produced
# the baked bundle at image-build time — shipping it lets operators
# `verify` or extend the bundle from a running system.
COPY --from=builder /out/qos-launcher /usr/bin/qos-launcher
COPY --from=builder /out/qos-runtime-bundle /usr/bin/qos-runtime-bundle
# Package management on the running system: `qos-install` installs, lists and
# removes `.qpkg`s into the user's own store, `qos-pkg` packs and verifies
# them, and `qos-cli-shim` is what `qos-install` drops on $PATH for a package
# that declares CLI commands. Without these in the image the only apps a user
# could ever have are the ones the image shipped.
COPY --from=builder /out/qos-install /usr/bin/qos-install
COPY --from=builder /out/qos-pkg /usr/bin/qos-pkg
COPY --from=builder /out/qos-cli-shim /usr/libexec/qos-cli-shim
COPY --from=builder /out/qos-power /usr/bin/qos-power
# The session-unlock verify helper: the compositor spawns it while the session
# is locked to verify the user's password via PAM (see os/etc/pam.d/qos-unlock).
# It lives under /usr/libexec (not on $PATH) since only the compositor invokes
# it, and matches the compositor's DEFAULT_UNLOCK_HELPER path.
COPY --from=builder /out/qos-unlock-helper /usr/libexec/qos-unlock-helper
# The confined shell runtime. Apps declare `ush = "required@<v>"` under
# [sandbox.services] and the launcher refuses to start them when its socket is
# absent — apps/terminal does, so without this binary and the user unit below
# the packaged Terminal cannot launch. /usr/libexec because the terminal's own
# lookup order is $QOS_USH_BIN, then /usr/libexec/qos-ush, then $PATH.
COPY --from=builder /out/qos-ush /usr/libexec/qos-ush
COPY --from=builder /out/qos-projector /usr/libexec/qos-projector
