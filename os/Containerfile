 && systemd-sysusers /usr/lib/sysusers.d/qos-local-model.conf

# The user unit that read-only verifies the identity after qos-session's
# first-login ceremony, `--global` enabled further down.
# It has to be installed here and not only exist in the source tree:
# `systemctl --global enable` resolves the unit file at build time, so a unit
# that was never copied in fails the build outright with "does not exist" —
# which is what a unit whose ExecStart is wrong looks like too.
COPY os/usr/lib/systemd/user/qos-identity.service /usr/lib/systemd/user/qos-identity.service

# xdg-desktop-portal backend registration.
#
# One file now: qos.portal, which tells xdg-desktop-portal which
# interfaces we provide and what `UseIn` desktop string activates us.
# The compositor itself owns `org.freedesktop.impl.portal.desktop.qos`
# on the session bus — see `compositor::native::start_portal_backend`.
#
# The D-Bus activation file and shell-portal.service used to start a
# separate `shell --portal-server-only` process to own that name. They
# are gone, for two reasons. That process built its portal context on an
# empty WorkspaceTree, so it could not answer a single question about
# the running session; and D-Bus allows one owner per name, so with the
# compositor also serving, whichever lost the race left a portal that
# answered nothing while looking healthy.
COPY os/usr/share/xdg-desktop-portal/portals/qos.portal /usr/share/xdg-desktop-portal/portals/qos.portal

