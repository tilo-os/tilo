              /usr/bin/qos-install /usr/bin/qos-pkg /usr/libexec/qos-cli-shim \
              /usr/bin/qos-power /usr/libexec/qos-unlock-helper /usr/libexec/qos-ush \
              /usr/libexec/qos-projector /usr/libexec/qos-doubletake \
              /usr/libexec/qos-doubletake-test-receiver \
              /usr/libexec/qos-fluxcast \
    && { [ ! -e /usr/bin/browser ] || chmod 755 /usr/bin/browser; } \
    && /usr/libexec/qos-doubletake -h >/dev/null \
    && /usr/libexec/qos-fluxcast --help >/dev/null

# Exercise the exact modern-AirPlay CLI path that ships: PIN pairing,
# FairPlay setup, encrypted RTSP/video transport and real H.264 media into the
# source-pinned receiver simulator. No receiver hardware or live network is
# involved, but an empty/control-plane-only session fails the stats assertions.
COPY os/tests/airplay-encrypted-session.sh /usr/libexec/qos/airplay-encrypted-session-test.sh
COPY os/tests/projection-boot-check.sh /usr/libexec/qos/projection-boot-check.sh
# The media sender has a bounded graceful-shutdown path. Immediately after a
# full-workspace LTO build, host CPU/I/O pressure can make that cleanup miss
# its deadline even though pairing, FairPlay and encrypted video all succeeded.
# Retry the complete contract once; each attempt retains every protocol, media
# and teardown assertion.
RUN chmod 0755 /usr/libexec/qos/airplay-encrypted-session-test.sh \
        /usr/libexec/qos/projection-boot-check.sh \
    && ( /usr/libexec/qos/airplay-encrypted-session-test.sh \
         || /usr/libexec/qos/airplay-encrypted-session-test.sh )

# ---- WPE WebKit runtime (browser engine) ------------------------------------
# Engine libraries + the WebKit helper processes (WPEWebProcess,
# WPENetworkProcess) from the wpe-builder stage, plus the runtime libraries
# the engine links that aren't already in this image. GStreamer base/good are
# installed above.
#
# This list has to cover every DT_NEEDED entry of libWPEWebKit-2.0.so or the
# browser dies at exec with a loader error. atk/at-spi2-atk/libmanette/libxslt
# are there because the engine is built with accessibility, gamepad and XSLT
# support; they arrive via no other package in this image.
#
# Copies nothing under QOS_WITH_BROWSER=0 (the stage is an empty /wpe then). The
# dnf list below still runs: those are ordinary frozen-repo packages that cost
# seconds, and installing them either way keeps the two images' package sets —
# and this layer's cache entry — identical.
COPY --from=wpe-builder /wpe/ /
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    libepoxy \
    libsoup3 \
    enchant2 \
    hyphen \
    woff2 \
    lcms2 \
    openjpeg2 \
    libavif \
    libwebp \
    libgcrypt \
    libtasn1 \
    libsecret \
    atk \
    at-spi2-atk \
    libmanette \
    libxslt \
    && dnf clean all && ${FINALIZE_RPMDB} \
    && ldconfig \
    && gst-inspect-1.0 h264parse >/dev/null \
    && gst-inspect-1.0 hlssink2 >/dev/null \
    && gst-inspect-1.0 pulsesrc >/dev/null \
    && gst-inspect-1.0 avenc_aac >/dev/null \
    && gst-inspect-1.0 aacparse >/dev/null

# ---- Baked signed runtime bundle -------------------------------------------
# The builder stage produced a signed content-addressed bundle from THIS
# image's own rootfs at /usr/lib/qos-runtime/${RUNTIME_VERSION} — the same
# path it takes here, because `qos-install` had to find it there while
# packing the app store — and wrote its publisher pubkey to
# /out/runtime-bundle-publisher.hex. Install both here so:
#   * The launcher's `/usr/lib/qos-runtime/<v>/` lookup succeeds out
#     of the box — no `qos-install runtime install --from-host` needed
#     after first boot.
#   * The signature check the launcher performs before every mount
#     accepts this bake (the pubkey is the trust root).
COPY --from=builder /usr/lib/qos-runtime/ /usr/lib/qos-runtime/
COPY --from=builder /out/runtime-bundle-publisher.hex /usr/share/qos/runtime-bundle-publisher.hex
# Trust list read by the launcher — one hex pubkey per line, `#` for
# comments. The baked publisher is the only entry by default; operators
# can extend it via `echo <hex> >> /etc/qos/runtime-bundle-trusted-publishers.txt`.
RUN mkdir -p /etc/qos \
    && cat /usr/share/qos/runtime-bundle-publisher.hex \
        > /etc/qos/runtime-bundle-trusted-publishers.txt

# ---- Preinstalled application store -----------------------------------------
# The registry + unpacked payloads the builder produced with `qos-pkg pack` and
# `qos-install install`. The launcher reads this store alongside the per-user
# one (crates/packaging/launcher/src/registry.rs), so the command palette lists
# these apps on a first boot with nobody having installed anything, and a user
# installing their own build of the same id shadows the preinstalled row rather
# than duplicating it.
#
# Read-only, being inside the image. That is the *only* way these packages
# differ from a user's: the sandbox is still built from the manifest, the
# payload is still ro-bound, and the single writable directory still comes from
# the launcher's per-room app dir. Nothing here is trusted for being shipped.
COPY --from=builder /usr/share/qos-apps/ /usr/share/qos-apps/
# Which key signed them, for auditing a built image. Not a trust root: package
# trust is the user's `~/.config/qos/trusted-attestors.toml`, and this key is
# deliberately absent from it — a preinstalled package is self-signed by the
# image build, and claims nothing more.
COPY --from=builder /out/app-publisher.hex /usr/share/qos/app-publisher.hex
# Put both stores' command shims on PATH, so a package that declares CLI
# commands can be run by name — the only way a CLI package is meant to be run.
COPY os/etc/profile.d/qos-apps.sh /etc/profile.d/qos-apps.sh

# FUSE mount service
COPY os/usr/lib/systemd/system/fs.service /usr/lib/systemd/system/fs.service
COPY os/usr/lib/systemd/system/fs-identity.path /usr/lib/systemd/system/fs-identity.path
# A measured installer UKI must not try to persist its transient TPM identity
# to the read-only live ESP. These conditions stop both systemd setup phases
# only while the sealed command line carries qos.install.
COPY os/usr/lib/systemd/system/systemd-tpm2-setup.service.d/10-qos-live-installer.conf /usr/lib/systemd/system/systemd-tpm2-setup.service.d/10-qos-live-installer.conf
COPY os/usr/lib/systemd/system/systemd-tpm2-setup-early.service.d/10-qos-live-installer.conf /usr/lib/systemd/system/systemd-tpm2-setup-early.service.d/10-qos-live-installer.conf
# The capability list that mount enforces. Shipped read-only under /usr;
# tmpfiles.d copies it to /var/lib/qos on first boot, where it can be
# edited and survives image updates. See fs.service for why the subject
# is a principal rather than a key.
COPY os/usr/share/qos/fs-capabilities.json /usr/share/qos/fs-capabilities.json

