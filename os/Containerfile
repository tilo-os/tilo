    /out/tilo-greeter /out/tilo-installer /out/tilo-launcher \
    /out/tilo-runtime-bundle /out/app /out/store /out/system /out/tilo-install /out/tilo-app-package /out/tilo-crypto \
    /out/tilo-image-trust /out/tilo-device-key-init \
    /usr/bin/
COPY --from=builder /out/optional/ /usr/bin/
COPY --chmod=0755 --from=builder \
    /out/tilo-system-extension-manager /out/tilo-home-peer-control \
    /out/tilo-cli-shim /out/tilo-unlock-helper /out/tilo-ush /out/tilo-projector \
    /out/tilo-app-host \
    /usr/libexec/
COPY --from=doubletake-builder /out/doubletake /usr/libexec/tilo-doubletake
COPY --from=doubletake-builder /out/doubletake-test-receiver /usr/libexec/tilo-doubletake-test-receiver
COPY --from=fluxcast-builder /src/src /usr/libexec/tilo-fluxcast-src

