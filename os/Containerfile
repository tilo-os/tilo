# syntax=docker/dockerfile:1.7
# ============================================================================
# Tilo bootc image — multi-stage build
# ----------------------------------------------------------------------------
# Stage 1 (builder): compiles the Rust workspace binaries INSIDE the image
#   build, on a Fedora 44 base whose glibc matches the runtime. This removes
#   the old host-build + `COPY shell`/`COPY fs` hack and the F43->F44 glibc
#   coupling it caused.
# Stage 2 (final): the fedora-bootc:44 OS image. Installs the runtime
#   packages + configs + systemd units and copies the binaries out of the
#   builder. None of the builder's toolchain/-devel deps land here.
#
# The build context MUST be the repo root (the builder needs the workspace
# source). The OS config files live under os/, so their COPY sources are
# `os/`-prefixed:
#
#     podman build -f os/Containerfile -t localhost/tilo:latest <repo-root>
#
# `.containerignore` at the repo root trims target/, os/output and .git from
# the context. See os/dev/build-image.sh and os/build.sh.
# ============================================================================


# ---- Frozen RPM repo (cross-time reproducibility) --------------------------
# Every `dnf install` below installs ONLY from this digest-pinned snapshot of
# the exact RPM set (built by os/Containerfile.rpms / the snapshot-rpms CI
# job), never live Fedora mirrors — so the same source rebuilds the same image
# regardless of when. RPMS_REF (registry.tilo.so/tilo/rpms@sha256:...) comes from
# resolve-rpm-snapshot.sh via the build scripts.
# ADD/REMOVE A PACKAGE below -> re-run the `snapshot-rpms` workflow (it prints a
# new set-<fingerprint> tag), else the build fails "No
# match for argument". The snapshot's package list is derived from this file.
# All three ARGs are declared here (before the first FROM) so they're in
# scope for FROM directives. An `ARG NAME` placed between two FROMs is
# scoped to the previous stage, not global — buildkit then reports
# `base name (${…}) should not be blank` when the next FROM tries to
# use it.
#
# BASE_REF (registry.tilo.so/tilo/fedora-bootc@sha256:...) is the Fedora bootc
# base, mirrored into our registry and pinned by digest — see
# os/base-snapshot.env for why the mirror exists and how to refresh it. Every
# fedora-bootc stage below uses it, so builder and final share one base and
# their glibc cannot drift.
ARG BASE_REF
ARG RPMS_REF
ARG KERNEL_RPMS_REF
ARG WPE_BUILDROOT_REF
ARG TILO_WINDOWS_ARCH=x86_64
# Scratch is only a parseable placeholder for an unselected provider branch.
# ARM validation rejects it; no diagnostic payload or mutable tag is a fallback.
ARG FEX_PAYLOAD_REF=scratch
ARG WINDOWS_GUEST_REF=scratch
# TILO_WITH_WINDOWS=0 builds an ARM image without the Windows provider (FEX and
# the x86 guest): /usr/share/tilo/windows/provider.json records provider
# "none", the image carries org.tilo.with-windows=0, and the compatibility
# service refuses capsule launches with that explanation. Never choose it by
# hand: `os/dev/windows_provider.py mode` derives it from the two pins (0 only
# while neither is set) for os/dev/build-image.sh and CI alike, and x86_64,
# whose Fedora Wine is always present, refuses it.
ARG TILO_WITH_WINDOWS=1
# The published env-runtime environment image (os/dev/resolve-env-runtime.sh),
# shipped in the system app store so the first environment opens offline.
# Scratch while no runtime is published for this checkout's definition: the
# image then ships none, and environments fetch it on first use.
ARG ENV_RUNTIME_REF=scratch

# TILO_WITH_BROWSER=0 builds the image without the browser: no WPE WebKit engine
# stage, no `browser` binary. Default 1 — a normal build is unchanged.
#
# The engine compiles in os/Containerfile.wpe (libwpe + wpebackend-fdo + wpewebkit).
# Measure cold and warm durations on the selected native runner; no universal
# build-time estimate applies across hardware. Nothing about the boot chain
# (kernel, initramfs, LUKS/TPM unlock, greeter, installer, rollback) depends on
# it, so an engine failure should not be able to block boot verification. Opting
# out is how you get an image to boot-test in minutes while the browser's own
# build is being repaired.
ARG TILO_WITH_BROWSER=1
FROM scratch AS public-trust
COPY keys/cosign.pub keys/tpm2-pcr-signing.public.pem /

FROM ${RPMS_REF} AS rpms
FROM ${ENV_RUNTIME_REF} AS env-runtime

# Public trust parsing is a build-only operation. The pinned base supplies the
# OpenSSL CLI while its ABI libraries remain part of the runtime package policy.
FROM ${BASE_REF} AS public-trust-tools

# Restore the runtime resolver only after transient-state cleanup. A RUN with
# /etc/resolv.conf pointing into /run/NetworkManager makes BuildKit mount its
# build-time DNS file there, so /run cannot be emptied by bootc's lint gate.
FROM ${BASE_REF} AS runtime-resolver-link
RUN mkdir -p /out && ln -s ../run/NetworkManager/resolv.conf /out/resolv.conf

# ---- Custom kernel repo ----------------------------------------------------
# Same "OCI image with /repo" shape as the frozen RPM repo (see
# os/Containerfile.rpms), but its content is a rebuilt Fedora kernel with
# our config fragment applied (static storage/net/USB/HID + PREEMPT +
# HZ=1000 + THP=always + trimmed debuginfo).  Built by
# .forgejo/workflows/build-kernel.yml and pinned by digest via
# os/kernel-snapshot.env — the runtime stage below swaps kernel-core for
# tilo-kernel-core out of it.
FROM ${KERNEL_RPMS_REF} AS kernel-rpms

# CI restores these checksum-pinned files from persistent storage before the
# build; local builds use the same resumable verifier.
FROM scratch AS external-assets
COPY --from=github-assets / /

FROM --platform=linux/arm64 ${FEX_PAYLOAD_REF} AS windows-fex-input
FROM --platform=linux/amd64 ${WINDOWS_GUEST_REF} AS windows-guest-input

FROM ${BASE_REF} AS windows-provider-aarch64-1
ARG FEX_PAYLOAD_REF
ARG WINDOWS_GUEST_REF
COPY os/dev/windows_provider.py os/dev/validate-fex-payload.py os/dev/validate-windows-guest.py os/dev/apply-fex-patches.py /tilo/
COPY os/external-assets/fex-source.env os/dev/wine-source.json /tilo/
COPY os/external-assets/fex-patches/ /tilo/fex-patches/
RUN --network=none \
    --mount=type=bind,from=windows-fex-input,source=/,target=/fex,ro \
    --mount=type=bind,from=windows-guest-input,source=/,target=/guest,ro \
    test "$(uname -m)" = aarch64 \
    && mkdir -p /out/usr/share/tilo/windows /out/usr/lib/tilo/windows-runners \
    && python3 /tilo/windows_provider.py validate \
      --fex-ref "$FEX_PAYLOAD_REF" --guest-ref "$WINDOWS_GUEST_REF" \
      --fex-root /fex --guest-root /guest/rootfs \
      --source-pin /tilo/fex-source.env --wine-pin /tilo/wine-source.json \
      > /out/usr/share/tilo/windows/provider.json \
    && cp -a /fex/usr/. /out/usr/ \
    && cp -a /guest/rootfs /out/usr/lib/tilo/windows-runners/x86

FROM ${BASE_REF} AS windows-provider-x86_64-1
COPY os/dev/windows_provider.py /tilo/
RUN --network=none test "$(uname -m)" = x86_64 \
    && mkdir -p /out/usr/share/tilo/windows \
    && python3 /tilo/windows_provider.py inputs --arch x86_64 \
       > /out/usr/share/tilo/windows/provider.json

# Without the provider only its build record is copied. `absent` rejects any
# architecture but aarch64, so an x86_64 build selecting this fails here.
FROM ${BASE_REF} AS windows-provider-off
COPY os/dev/windows_provider.py /tilo/
RUN --network=none mkdir -p /out/usr/share/tilo/windows \
    && python3 /tilo/windows_provider.py absent --arch "$(uname -m)" \
       > /out/usr/share/tilo/windows/provider.json
FROM windows-provider-off AS windows-provider-aarch64-0
FROM windows-provider-off AS windows-provider-x86_64-0

FROM windows-provider-${TILO_WINDOWS_ARCH}-${TILO_WITH_WINDOWS} AS windows-provider


# ---- Minimal Windows paravirtual driver media -----------------------------
# Fedora's pinned virtio-win RPM expands to almost 2 GiB because it contains
# the same driver tree in several layouts. Tilo only consumes the bootable ISO
# and the signed guest-tools installer. Extract and authenticate those exact
# payloads in a throwaway stage instead of installing all duplicated files in
# the immutable OS. Keep the RPM in the frozen snapshot so this remains an
# offline, digest-pinned build input.
# tilo-rpm-snapshot-package: virtio-win
FROM ${BASE_REF} AS virtio-win-media
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo,ro \
    /bin/bash -euo pipefail -c '\
      rpm_path=$(find /repo -maxdepth 1 -type f -name "virtio-win-*.rpm" -print -quit); \
      test -n "$rpm_path"; \
      mkdir -p /tmp/virtio /out/installer; \
      cd /tmp/virtio; \
      rpm2cpio "$rpm_path" \
        | cpio -idm --quiet \
            ./usr/share/virtio-win/virtio-win-0.1.302.iso \
            ./usr/share/virtio-win/installer/virtio-win-guest-tools.exe; \
      printf "%s  %s\n%s  %s\n" \
        303f7ae40dad495d6ae474fdc571df58958a4dbc5c37a522d80f9a203867949d \
        usr/share/virtio-win/virtio-win-0.1.302.iso \
        d8ae9ea1e943384ac195e012cd36f82c3161620e5fc9529be4e42e6f420e222d \
        usr/share/virtio-win/installer/virtio-win-guest-tools.exe \
        | sha256sum --check --strict; \
      mv usr/share/virtio-win/virtio-win-0.1.302.iso /out/virtio-win.iso; \
      mv usr/share/virtio-win/installer/virtio-win-guest-tools.exe \
        /out/installer/virtio-win-guest-tools.exe; \
      chmod 0644 /out/virtio-win.iso /out/installer/virtio-win-guest-tools.exe'


# ---- Pinned Windows compatibility runtimes -------------------------------
# UMU is the upstream-supported way to run Proton outside Steam. Keep the
# launcher and the default Proton build as independently pinned artifacts:
# catalogues may select another installed runner, while a fresh image is still
# able to provision an offline game capsule. Ship the matching Steam runtime
# as immutable content; UMU metadata, runtime locks, and variable state belong
# to each capsule. See os/docs/proton-runtime-validation.md for that contract.
FROM ${BASE_REF} AS windows-compat-artifacts
## Bottles' upstream program records improve catalogue matching. They are data,
## never an instruction source: Tilo imports identity/runner hints only and does
## not execute a record's Steps, URLs, shell snippets, or dependencies.
RUN --mount=type=bind,from=external-assets,source=/,target=/tilo-assets,ro \
    mkdir -p /out/bin /out/proton /out/steam-runtime \
    && install -D -m 0644 /tilo-assets/umu-database-8297d420.csv /out/catalogues/umu-database.csv \
    && tar -xf /tilo-assets/umu-launcher-1.4.0.tar -C /tmp \
    && install -m 0755 /tmp/umu/umu-run /out/bin/umu-run \
    && install -m 0644 /tmp/umu/umu_run.py /out/bin/umu_run.py \
    && tar -xzf /tilo-assets/umu-proton-10.0-4.tar.gz -C /out/proton \
    && test -x /out/proton/UMU-Proton-10.0-4/proton \
    && tar -xJf /tilo-assets/steam-runtime-sniper-3.0.20260805.254768.tar.xz -C /out/steam-runtime \
    && case "$(uname -m)" in \
         x86_64) pv=pressure-vessel ;; \
         aarch64) pv=pressure-vessel-arm64 ;; \
         *) echo "unsupported Steam runtime host architecture: $(uname -m)" >&2; exit 1 ;; \
       esac \
    && /out/steam-runtime/SteamLinuxRuntime_sniper/${pv}/bin/pv-verify /out/steam-runtime/SteamLinuxRuntime_sniper \
    && touch /out/steam-runtime/SteamLinuxRuntime_sniper/sniper_platform_3.0.20260805.254768/files/.ref \
    && mkdir -p /out/catalogues/bottles-programs \
    && tar -xzf /tilo-assets/bottles-programs-d1160b8.tar.gz --strip-components=1 -C /out/catalogues/bottles-programs \
    && chmod -R a-w /out/catalogues/bottles-programs


# ---- AirPlay sender ---------------------------------------------------------
# Doubletake's current protocol implementation is newer than its last binary
# release: it includes the CoreUtils/HAP pairing path required by current
# AirPlay receivers. Build one audited commit, run its hardware-free protocol
# suite, and copy only the static sender into the OS image.
FROM docker.io/library/golang:1.25.0-bookworm@sha256:81dc45d05a7444ead8c92a389621fafabc8e40f8fd1a19d7e5df14e61e98bc1a AS doubletake-builder
ENV GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org
RUN --mount=type=bind,from=external-assets,source=/,target=/tilo-assets,ro \
    mkdir -p /src /out \
    && tar -xzf /tilo-assets/doubletake-ae06722.tar.gz --strip-components=1 -C /src
WORKDIR /src
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go test ./... \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w -extldflags=-static' \
        -o /out/doubletake ./cmd/doubletake \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w -extldflags=-static' \
        -o /out/doubletake-test-receiver ./cmd/doubletake-test-receiver


# ---- Architecture-neutral Miracast/Wi-Fi Display sender -------------------
# Build/test FluxCast from its pinned Python source on the target architecture
# instead of shipping the project's x86-64-only AppImage.
FROM ${BASE_REF} AS fluxcast-builder
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    dnf install -y --setopt=reposdir=/repo python3 \
    && dnf clean all
RUN --mount=type=bind,from=external-assets,source=/,target=/tilo-assets,ro \
    mkdir -p /src \
    && tar -xzf /tilo-assets/fluxcast-a74f39f.tar.gz --strip-components=1 -C /src
COPY os/tests/fluxcast-rtsp-receiver.py /fluxcast-rtsp-receiver.py
RUN PYTHONPATH=/src/src python3 -m unittest discover -s /src/tests -p 'test_wfd.py' \
    && PYTHONPATH=/src/src python3 /fluxcast-rtsp-receiver.py


# ---- Joy-Con pairing daemon -------------------------------------------------
# joycond (GPL-3.0-only) folds a left and a right Joy-Con into one uinput
# controller, or releases a single half to be held sideways. Fedora carries it
# only in COPR, which the frozen snapshot's signature policy cannot admit
# (os/dev/verify-rpm-snapshot-signatures.sh), so build the pinned upstream
# commit from snapshot build dependencies. Its udev rules are replaced by
# os/usr/lib/udev/rules.d/72-joycond.rules, which scopes it to Joy-Cons, and
# its modules-load snippet moves from /etc to the immutable /usr/lib.
# tilo-rpm-snapshot-package: libevdev-devel
FROM ${BASE_REF} AS joycond-builder
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    dnf install -y --setopt=reposdir=/repo \
      cmake gcc-c++ make pkgconf-pkg-config libevdev-devel systemd-devel \
    && dnf clean all
RUN --mount=type=bind,from=external-assets,source=/,target=/tilo-assets,ro \
    mkdir -p /src \
    && tar -xzf /tilo-assets/joycond-0df025a.tar.gz --strip-components=1 -C /src \
    && cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build --parallel \
    && DESTDIR=/out cmake --install /build \
    && install -D -m 0644 /out/etc/modules-load.d/joycond.conf \
      /out/usr/lib/modules-load.d/joycond.conf \
    && test -x /out/usr/bin/joycond \
    && test -f /out/usr/lib/systemd/system/joycond.service


# ---- Stage 1a: WPE WebKit (browser engine) ----------------------------------
# Compilation lives only in os/Containerfile.wpe. Image entrypoints
# (os/dev/build-image.sh, the WPE producer, and adoption/import) supply the
# completed stage as `--build-context wpe-builder=container-image://…`. This
# stage exists so a forgotten context fails closed instead of compiling here
# and invalidating WPE receipts on unrelated OS recipe edits.
FROM ${WPE_BUILDROOT_REF} AS wpe-builder-1
RUN printf '%s\n' \
      'WPE compilation lives in os/Containerfile.wpe; supply --build-context wpe-builder=…' >&2 \
    && exit 1


# ---- Stage 1a-off: the same stage with no engine in it ----------------------
# Selected when TILO_WITH_BROWSER=0. It only has to satisfy the two
# `COPY --from=wpe-builder /wpe/ /` instructions below — copying the contents of
# an empty directory is a no-op, so both overlays vanish without either COPY
# needing to be conditional (a Containerfile has no conditional COPY).
FROM ${BASE_REF} AS wpe-builder-0
RUN mkdir -p /wpe

# Whichever of the two above TILO_WITH_BROWSER names becomes `wpe-builder`. The
# other is never built: an unreferenced stage is pruned from the build graph by
# both buildkit and buildah, so TILO_WITH_BROWSER=0 skips the engine compile
# rather than building and discarding it.
FROM wpe-builder-${TILO_WITH_BROWSER} AS wpe-builder

# ---- The sources the Rust compile reads -------------------------------------
# Only what the builder stage reads, never the whole context: with
# `COPY . /build`, a unit, an /etc file or a test script under os/ re-ran the
# compile and relinked every binary (about twenty minutes in CI), although none
# of them depends on it. That is the workspace, the few repository files a
# workspace crate include!s from outside it, the scripts the builder's RUNs
# call, and the prebuilt payloads CI may stage (empty in a checkout).
# tools/policy/check_image_builder_inputs.py keeps this list complete. A
# scratch stage, so these commits are cheap and the builder takes one layer.
FROM scratch AS builder-sources
COPY Cargo.toml Cargo.lock rust-toolchain.toml /build/
COPY .cargo /build/.cargo
COPY crates /build/crates
COPY apps /build/apps
COPY examples /build/examples
COPY vendor /build/vendor
COPY dist /build/dist
COPY tools/ci/rustc-thin-app-wrapper.sh /build/tools/ci/rustc-thin-app-wrapper.sh
COPY tools/policy/app_portability_rules.toml /build/tools/policy/app_portability_rules.toml
COPY tools/policy/app_capability_usage.toml /build/tools/policy/app_capability_usage.toml
COPY os/usr/share/tilo/installer-locales.txt /build/os/usr/share/tilo/installer-locales.txt
COPY \
    os/scripts/cargo-freshness.sh \
    os/scripts/build-thin-apps.sh \
    os/scripts/cargo-timings-summary.py \
    os/scripts/verify-elf-hardening.sh \
    os/scripts/pack-apps.sh \
    os/scripts/install-env-runtime.sh \
    os/scripts/browser-runtime-launcher.c \
    /build/os/scripts/
COPY os/desktop-artifacts /build/os/desktop-artifacts
COPY os/app-artifacts /build/os/app-artifacts
COPY os/app-runtime /build/os/app-runtime

# ---- Stage 1: builder ------------------------------------------------------
# Base pinned by digest against our own mirror (BASE_REF, os/base-snapshot.env):
# a tag can be repointed, a digest can't — but upstream deletes the manifest a
# digest points at within about a day, so the pin remains usable only if we hold a
# copy. Builder and final share BASE_REF, so their glibc matches by
# construction. Bump deliberately: re-run `mirror-base`, commit the new
# BASE_REF, re-run `snapshot-rpms`.
FROM ${BASE_REF} AS builder-base

# Rust toolchain + the C/-devel deps the workspace's *-sys crates link or build
# against. Superset of the my-distrobox dev deps (repo CLAUDE.md) plus the base
# toolchain a minimal bootc image lacks: cmake/perl/clang etc. that
# vendored crates (aws-lc-sys, the freetype/harfbuzz/fontconfig font stack,
# jemalloc, sqlite) need to build. `sccache` honours the project's
# .cargo/config.toml `rustc-wrapper`. Throwaway stage — nothing here ships.
#
# The last three lines of the list are for the WPE overlay copied in below
# rather than for any crate of ours, and they serve two different linker needs:
#
#   * glib2-devel + libsoup3-devel supply .pc files. `wpe-webkit-2.0.pc`
#     declares `Requires: glib-2.0 libsoup-3.0 wpe-1.0 wpe-platform-2.0`, and
#     pkg-config fails the whole lookup when any link in that chain is missing
#     — which crates/sdk/ui-core/build.rs reports as the unhelpful "wpe-webkit-2.0 was not
#     found".
#   * The rest supply plain shared objects. libWPEWebKit-2.0.so records them in
#     DT_NEEDED, so linking `browser` against it makes ld open each one to
#     resolve symbols transitively; absent, ld reports them as `needed by
#     ... not found` and then buries that in hundreds of undefined references
#     to gst_*/epoxy_*/manette_*. Runtime packages are enough — no -devel
#     needed, because nothing here compiles against their headers. The engine
#     decodes JPEG XL (libjxl, colour-managed through lcms2) and speaks through
#     flite; shell links the same engine when the browser is built, because
#     both share one Cargo invocation.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        rust cargo sccache capnproto \
        gcc gcc-c++ make cmake perl perl-FindBin python3 git \
        clang clang-devel pkgconf-pkg-config \
        libxkbcommon-devel wayland-devel \
        libseat-devel libinput-devel systemd-devel libdrm-devel \
        mesa-libgbm-devel mesa-libGL-devel mesa-libEGL-devel \
        pipewire-devel \
        sqlite-devel zlib-ng-compat-devel \
        fontconfig-devel freetype-devel harfbuzz-devel expat-devel \
        glib2-devel libsoup3-devel \
        atk at-spi2-atk gstreamer1 gstreamer1-plugins-base \
        hyphen libavif libepoxy libmanette libxslt \
        flite lcms2 libjxl \
        nasm \
        gstreamer1-devel gstreamer1-plugins-base-devel \
    && dnf clean all

# Fedora's sccache RPM is built without the S3 backend. Use the same pinned,
# full-feature static client as the canonical CI builder so the nested image
# build can reach the shared compiler cache without leaking credentials into a
# layer. The archive checksum is also pinned in os/Containerfile.builder.
ARG SCCACHE_VERSION=0.17.0
ARG SCCACHE_SHA256_X86_64=67c4a96dd237c1f518f6b36083f270f9976d516f1e57fce891755ea782e50006
ARG SCCACHE_SHA256_AARCH64=821a86343191aa1cbab74bd42f9e93c9a63bf85e4742945f40d3ae84193c1c77
RUN --mount=type=bind,from=external-assets,source=/,target=/tilo-assets,ro \
    case "$(uname -m)" in \
      x86_64) sccache_arch=x86_64; sccache_sha="$SCCACHE_SHA256_X86_64" ;; \
      aarch64) sccache_arch=aarch64; sccache_sha="$SCCACHE_SHA256_AARCH64" ;; \
      *) echo "unsupported sccache architecture: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && archive="sccache-v${SCCACHE_VERSION}-${sccache_arch}-unknown-linux-musl.tar.gz" \
    && echo "${sccache_sha}  /tilo-assets/${archive}" | sha256sum -c - \
    && tar -xzf "/tilo-assets/${archive}" -C /tmp \
    && install -m 0755 \
       "/tmp/sccache-v${SCCACHE_VERSION}-${sccache_arch}-unknown-linux-musl/sccache" \
       /usr/local/bin/sccache \
    && rm -rf "/tmp/sccache-v${SCCACHE_VERSION}-${sccache_arch}-unknown-linux-musl" \
    && /usr/local/bin/sccache --version

# mold links the thirty-odd binaries below, where GNU ld spent minutes; with
# LTO off (TILO_RUST_LTO below) the link is most of what a one-crate rebuild
# does. The checksum-pinned upstream binary, the same one os/Containerfile.builder
# installs, not Fedora's package: its aarch64 build pulls in a mimalloc that
# needs ARM LSE atomics. It is the stage's default linker through a cargo config
# above the workspace, /.cargo/config.toml, whose rustflags Cargo joins with the
# workspace's own target flags, so every cargo invocation here links with it and
# none has to ask. mold's output is deterministic, and the hardening the
# workspace flags request is read back off the binaries below
# (verify-elf-hardening.sh), so a linker that dropped one fails the build.
ARG MOLD_VERSION=2.40.4
ARG MOLD_SHA256_X86_64=4c999e19ffa31afa5aa429c679b665d5e2ca5a6b6832ad4b79668e8dcf3d8ec1
ARG MOLD_SHA256_AARCH64=c799b9ccae8728793da2186718fbe53b76400a9da396184fac0c64aa3298ec37
RUN --mount=type=bind,from=external-assets,source=/,target=/tilo-assets,ro \
    case "$(uname -m)" in \
      x86_64) mold_arch=x86_64; mold_sha="$MOLD_SHA256_X86_64" ;; \
      aarch64) mold_arch=aarch64; mold_sha="$MOLD_SHA256_AARCH64" ;; \
      *) echo "unsupported mold architecture: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && archive="mold-${MOLD_VERSION}-${mold_arch}-linux.tar.gz" \
    && source="mold-${MOLD_VERSION}-${mold_arch}-linux" \
    && echo "${mold_sha}  /tilo-assets/${archive}" | sha256sum -c - \
    && tar -xzf "/tilo-assets/${archive}" -C /tmp \
    && install -m 0755 "/tmp/${source}/bin/mold" /usr/local/bin/mold \
    && install -m 0755 "/tmp/${source}/bin/ld.mold" /usr/local/bin/ld.mold \
    && rm -rf "/tmp/${source}" \
    && mold --version \
    && mkdir -p /.cargo \
    && printf '%s\n' \
         '# The OS image builder stage links with mold.' \
         "[target.'cfg(target_os = \"linux\")']" \
         'rustflags = ["-C", "link-arg=-fuse-ld=mold"]' \
         > /.cargo/config.toml \
    && printf 'int main(void) { return 0; }\n' > /tmp/mold-probe.c \
    && cc -fuse-ld=mold -Wl,-z,relro,-z,now -o /tmp/mold-probe /tmp/mold-probe.c \
    && readelf -p .comment /tmp/mold-probe | grep -q 'mold' \
    && rm -f /tmp/mold-probe /tmp/mold-probe.c

WORKDIR /build

# Keep cargo's home and sccache's cache under /build (which exists via WORKDIR/
# itself). The fedora-bootc base has no /root, so nesting cache mounts there fails
# ("stat /root: no such file or directory"); single subdirs of /build are safe.
# Deterministic compile (reproducible builds): no incremental state in output,
# remap the build path so binaries don't embed /build, fixed locale/timezone so
# any sorted/formatted output is stable.
#
# The compile sees a fixed SOURCE_DATE_EPOCH, not the commit time the build
# scripts pass. Nothing Cargo builds reads it except a C compiler's __DATE__,
# where any fixed value is as reproducible as another, but as an environment
# variable it is part of this stage's cache key: carrying the commit time here
# made every commit, even one that touched only os/ configuration, recompile
# and relink every binary. The packaging steps after the compile, which stamp
# bundles and registry rows with it, take the real value (ARG below).
ARG SCCACHE_BUCKET=""
ARG SCCACHE_ENDPOINT=""
ARG SCCACHE_REGION="auto"
ARG SCCACHE_S3_KEY_PREFIX="tilo/image/v1"
ARG SCCACHE_S3_USE_SSL="false"
# BuildKit can overlap the production and dev compiles. Keep their servers
# on private filesystem sockets instead of competing for localhost:4226.
ENV CARGO_HOME=/build/.cargo-home \
    SCCACHE_DIR=/build/.sccache \
    SCCACHE_SERVER_UDS=/tmp/tilo-image-sccache.sock \
    SCCACHE_BUCKET=${SCCACHE_BUCKET} \
    SCCACHE_ENDPOINT=${SCCACHE_ENDPOINT} \
    SCCACHE_REGION=${SCCACHE_REGION} \
    SCCACHE_S3_KEY_PREFIX=${SCCACHE_S3_KEY_PREFIX} \
    SCCACHE_S3_USE_SSL=${SCCACHE_S3_USE_SSL} \
    SCCACHE_IGNORE_SERVER_IO_ERROR=1 \
    SCCACHE_IDLE_TIMEOUT=0 \
    RUSTC_WRAPPER=sccache \
    CARGO_INCREMENTAL=0 \
    SOURCE_DATE_EPOCH=0 \
    LC_ALL=C.UTF-8 \
    TZ=UTC

# WPE WebKit headers + libs so `browser --features wpe` links against the
# engine built in the wpe-builder stage. Overlaying /usr in this throwaway
# stage keeps pkg-config discovery entirely standard.
COPY --from=wpe-builder /wpe/ /
# The link below needs every library the engine records in DT_NEEDED, and the
# toolchain list above is what provides them. A WPE buildroot refresh that
# builds the engine with a new feature fails here, naming the packages to add,
# instead of as undefined references in the browser and shell links.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    --mount=type=bind,source=os/scripts/check-wpe-runtime.sh,target=/run/tilo-check-wpe-runtime.sh,ro \
    bash /run/tilo-check-wpe-runtime.sh "the builder stage's dnf list (and its mirror, builder-packages.txt)"

# Everything above is the build toolchain: it changes with packages, the pinned
# tools and the browser engine, not with the workspace, and CI caches it on its
# own (the compile below goes through the compiler cache instead).
FROM builder-base AS builder

# Copy the frequently changing workspace only after the large, stable WPE
# overlay. This keeps source-only iterations from re-importing the browser
# engine before Cargo can reach its cache mounts. The sources arrive as one
# layer (the builder-sources stage above): each instruction here commits a
# layer of this multi-gigabyte stage, and rootless podman commits one by
# walking the whole tree, minutes apiece.
COPY --from=builder-sources /build/ /build/

# Compile the binaries the OS images need. Cache mounts persist cargo's
# registry + git checkouts (CARGO_HOME), the target dir, and the sccache store
# across rebuilds; a cache-mounted target/ isn't in any layer, so the binaries
# are cp'd to /out (outside the cache mount) in the same RUN for the final stage
# to COPY.
#
# Two CI guards (the image builds under buildkit, not just podman/buildah):
#  - The resolve comes from the tracked `Cargo.lock`, which is why that file is
#    committed: a fresh resolve picks incompatible transitive versions (iroh
#    pulls a pre-release ed25519-dalek that does not compile against current
#    `signature`), and the failure surfaces inside a dependency rather than
#    anywhere this image touches. `cargo build` (not --locked) still lets the
#    resolve adjust conservatively where a manifest here differs, while keeping
#    the good pins.
#  - Brace the trailing sccache stat so a failing `cargo build` fails the RUN
#    instead of being swallowed by `|| true` (which masked a cargo failure as a
#    confusing downstream "COPY --from /out: not found").
#
# The browser is the one optional binary (TILO_WITH_BROWSER, top of file). It is
# staged into /out/optional/ rather than /out/ so the final image can copy the
# directory's contents unconditionally: empty means no browser, and no COPY
# needs a condition it cannot express.
#
# The application set is read out of the workspace members rather than listed
# here. A hand-maintained list is how the image came to ship two GUI apps while
# the tree held forty-six: adding an app to the workspace and forgetting this
# file was silent. Deriving it means a new `apps/<name>/` is shipped by the
# build that follows it, and an empty match is a hard failure rather than an
# image with no apps. The browser is filtered out only because it alone needs
# the `wpe` feature and the TILO_WITH_BROWSER condition.
#
# `tilo-app-package-cli`, `install` and `cli-shim` build the packaging tools: `tilo-app-package` and
# `tilo-install` pack and install those apps into the image-wide store below,
# and `tilo-install` ships so the running system can install and remove
# packages of its own.
# Every media engine in this tree sits behind a cargo feature that is OFF by
# default, and deliberately so: `--shots`, the offline tests and CI must build
# without a GStreamer stack, a camera or a network. An image that takes those
# defaults is the one case where the trade-off is wrong — it ships a music
# player that cannot produce sound, a video player that synthesises frames
# instead of decoding them, a camera that cannot capture and clients whose
# network backends are compiled out. The features are named here so the image,
# and only the image, turns them on.
#
# Package-qualified (`<pkg>/<feature>`). The tapp applications and their
# versioned shared runtime are built together below: Rust dylib symbol names
# contain crate hashes, so separate Cargo invocations are not ABI-compatible.
#
# `mail/html-webview` is deliberately NOT here: it pulls ui/webview-wpe, and the
# engine behind it is the browser's, which TILO_WITH_BROWSER=0 does not build.
#
# No app takes a `portal` feature, because none has one: `ui` compiles the host
# file chooser into every app on every build, including --shots. Asking for
# `video-editor/portal` is not a no-op — cargo refuses the whole invocation with
# "none of the selected packages contains these features", which fails the image
# build after the package install and the cold Rust compile have already run.
# os/tests/app_store.sh checks each pair against cargo metadata for that reason.
#
# Fat LTO with one codegen unit serialized the final links for roughly fifty
# binaries and made a warm image rebuild spend over an hour in this step.
# The image-only Cargo overrides below use thin LTO, retaining cross-crate
# optimization while allowing LLVM to use the runner cores. Eight codegen
# units also bound concurrent thin-LTO scratch data on the image runner.
# Other release artifacts keep the workspace's stricter profile unchanged.
#
# TILO_RUST_LTO says which of two the image takes: `thin`, the default and what
# every published image is built with, or `off`, for integration, dev and local
# builds. Thin LTO re-optimizes each binary's whole dependency graph at link
# time, which sccache cannot cache: a warm CI rebuild that hit the compiler
# cache for every object still spent fifteen minutes relinking. Without it a
# one-crate change relinks in seconds. The build scripts choose the value from
# what the build is for (os/dev/build-image.sh, .forgejo/workflows/build-image.yml),
# and the image says which it got in its org.tilo.rust-lto label.
# Layer timestamp rewriting can make a restored target cache newer than changed
# workspace sources. Profiles are cleaned before fingerprinting so Cargo never
# accepts a stale path-dependency rlib; sccache still reuses compiler objects.
# That is TILO_CARGO_FRESHNESS=clean, the default and what CI builds. Local
# builds (os/dev/local-inputs.sh) pass `content`: os/scripts/cargo-freshness.sh
# marks exactly the sources whose contents changed newer than the cached target,
# and every other source older, so Cargo reuses what did not change instead of
# relinking ~50 binaries through thin LTO on every rebuild.
ARG TILO_CARGO_FRESHNESS=clean
ARG TILO_RUST_LTO=thin
ARG TILO_WITH_BROWSER
ARG TILO_PREBUILT_APPS=0
ARG TILO_PREBUILT_DESKTOP=0
ARG TILO_CARGO_BUILD_JOBS=4
# Debug info the release profile compiles (it strips symbols from the output
# either way): the profile's line tables by default; 0 skips them, which only
# makes a dev build compile faster.
ARG TILO_RUST_DEBUGINFO=line-tables-only
# 1 prints where each cargo build spent its time (cargo --timings).
ARG TILO_CARGO_TIMINGS=
ARG TILO_REQUIRE_COMPILER_CACHE=0
# `shared` compiles through sccache: CI's runner cache when the build passes
# the actions_cache_url and actions_runtime_token secrets (the Actions cache
# protocol the runners serve), an S3 bucket when SCCACHE_BUCKET is set, else
# only the local cache mount. `off` is
# the independent reproduction lane of a publication: with no cache at all, a
# planted object in the shared cache makes the two builds differ. It runs no
# wrapper, and refuses compiler-cache credentials or settings.
# `publication` is a publication's own cache: short-lived role credentials
# (a session token is required, so the shared static key cannot stand in)
# for a bucket only publication runs can write, under tilo/publication/.
ARG TILO_COMPILER_CACHE=shared
ENV CARGO_BUILD_JOBS=${TILO_CARGO_BUILD_JOBS}
ARG TILO_APP_COLLECTION_PUBLISHER=""
# Names the target cache, so builds that compile differently (os/dev/build-image.sh
# hashes the settings into it) keep separate target directories instead of
# rebuilding each other's artifacts. The cargo home and sccache are shared.
ARG TILO_BUILD_CACHE_KEY=default
RUN --mount=type=cache,target=/build/.cargo-home \
    --mount=type=cache,id=tilo-cargo-target-${TILO_BUILD_CACHE_KEY},target=/build/target \
    --mount=type=cache,target=/build/.sccache \
    --mount=type=secret,id=aws_access_key_id \
    --mount=type=secret,id=aws_secret_access_key \
    --mount=type=secret,id=aws_session_token \
    --mount=type=secret,id=actions_cache_url \
    --mount=type=secret,id=actions_runtime_token \
    export AWS_ACCESS_KEY_ID="$(cat /run/secrets/aws_access_key_id 2>/dev/null || true)" \
    && ACTIONS_CACHE_URL="$(cat /run/secrets/actions_cache_url 2>/dev/null || true)" \
    && ACTIONS_RUNTIME_TOKEN="$(cat /run/secrets/actions_runtime_token 2>/dev/null || true)" \
    && if [ -n "$ACTIONS_CACHE_URL" ] && [ -n "$ACTIONS_RUNTIME_TOKEN" ]; then \
         export ACTIONS_CACHE_URL ACTIONS_RUNTIME_TOKEN SCCACHE_GHA_ENABLED=on SCCACHE_GHA_VERSION=tilo-image-v1; \
       fi \
    && export AWS_SECRET_ACCESS_KEY="$(cat /run/secrets/aws_secret_access_key 2>/dev/null || true)" \
    && AWS_SESSION_TOKEN="$(cat /run/secrets/aws_session_token 2>/dev/null || true)" \
    && { [ -z "$AWS_SESSION_TOKEN" ] || export AWS_SESSION_TOKEN; } \
    && phase=rust-setup && started=$(date +%s) \
    && build_phase() { \
         now=$(date +%s); \
         printf 'TILO_BUILD_TIMING phase=%s elapsed_seconds=%s exit_code=0\n' "$phase" "$((now - started))"; \
         phase=$1; started=$now; \
       } \
    && trap 'status=$?; printf "TILO_BUILD_TIMING phase=%s elapsed_seconds=%s exit_code=%s\n" "$phase" "$(( $(date +%s) - started ))" "$status"; if [ "$status" != 0 ]; then df -h /build /build/target /tmp; df -i /build /build/target /tmp; fi; sccache --show-stats 2>/dev/null || true; exit "$status"' EXIT \
    && case "$TILO_COMPILER_CACHE:$TILO_REQUIRE_COMPILER_CACHE" in \
         shared:0|off:0|publication:0) ;; \
         shared:1|publication:1) export SCCACHE_IGNORE_SERVER_IO_ERROR=0 ;; \
         *) printf '%s\n' 'TILO_COMPILER_CACHE must be shared, publication or off, TILO_REQUIRE_COMPILER_CACHE 0 or 1 (0 when off)' >&2; exit 1 ;; \
       esac \
    && if [ "$TILO_COMPILER_CACHE" = publication ]; then \
         case "${AWS_SESSION_TOKEN:-}:$SCCACHE_S3_KEY_PREFIX" in \
           ?*:tilo/publication/*) ;; \
           *) printf '%s\n' 'The publication cache needs role session credentials and a tilo/publication/ prefix' >&2; exit 1 ;; \
         esac; \
       fi \
    && if [ "$TILO_COMPILER_CACHE" = off ]; then \
         if [ -n "${AWS_ACCESS_KEY_ID}${AWS_SECRET_ACCESS_KEY}${SCCACHE_BUCKET}${SCCACHE_ENDPOINT}${ACTIONS_CACHE_URL}${ACTIONS_RUNTIME_TOKEN}" ]; then \
           printf '%s\n' 'A build without the compiler cache received compiler-cache settings' >&2; exit 1; \
         fi; \
         export RUSTC_WRAPPER=; \
         printf '%s\n' 'compiling without a compiler cache' >&2; \
       elif ! sccache --start-server; then \
         if [ "$TILO_REQUIRE_COMPILER_CACHE" = 1 ]; then \
           printf '%s\n' 'Required compiler cache is unavailable; refusing an uncached build' >&2; exit 1; \
         fi; \
         export RUSTC_WRAPPER=; \
         printf '%s\n' 'sccache backend unavailable; compiling normally' >&2; \
       fi \
    && { sccache --zero-stats 2>/dev/null || true; } \
    && case "$TILO_RUST_LTO" in \
         thin|off) ;; \
         *) printf '%s\n' 'TILO_RUST_LTO must be thin or off' >&2; exit 1 ;; \
       esac \
    && case "$TILO_CARGO_FRESHNESS" in \
         clean) cargo clean --release && cargo clean --profile thin-app ;; \
         content) sh os/scripts/cargo-freshness.sh /build /build/target/.tilo-content-hashes \
                    || { cargo clean --release && cargo clean --profile thin-app; } ;; \
         *) printf '%s\n' 'TILO_CARGO_FRESHNESS must be clean or content' >&2; exit 1 ;; \
       esac \
    # Thin apps use the same package set and features as dist/apps/app-collections.toml
    # (default collection). Browser stays out of that graph: ui/webview from
    # browser/wpe otherwise unifies into every tapp and was the ~1.9 MB .text gap
    # versus CI package-apps (#1158). Ship browser through the separate runtime
    # below, the same route prebuilt collections already use.
    && if [ "${TILO_WITH_BROWSER}" = "0" ]; then \
         BROWSER_PKG=""; \
       else \
         BROWSER_PKG="-p browser --bin browser --features browser/wpe"; \
       fi \
    && THIN_EXCLUDES="browser" \
    && APP_FEATURES="music/audio,music/live,video-player/decode,camera/live-capture,tube/live,tube/media,tube/grayjay-sync,chat/live-media,mail/live,disks/live,video-editor/decode,video-editor/gst" \
    && if [ "${TILO_PREBUILT_DESKTOP}" = 1 ]; then \
         DESKTOP_RELEASE_ARGS=""; \
       else \
         DESKTOP_RELEASE_ARGS="-p shell --bin shell --bin tilo-runtime-mcp -p launcher --bin tilo-launcher -p tilo-unlock-helper --bin tilo-unlock-helper"; \
       fi \
    && RELEASE_ARGS="${DESKTOP_RELEASE_ARGS} -p tilo-fs -p terminal -p file-explorer -p settings -p greeter -p installer -p runtime-bundle -p tilo-rollback -p tilo-crypto -p tilo-user-identity -p tilo-cli -p app-cli -p ush -p tilo-projector -p tilo-pdf -p tilo-app-package-cli -p install -p cli-shim -p app-host -p local-model-service -p tilo-model-gateway -p system-extension -p compat-service -p account-custody" \
    # Select the shipped executables explicitly: --bins also links shell dev tools.
    && RELEASE_BINS="--bin fs --bin terminal --bin file-explorer --bin settings --bin tilo-model-manager --bin tilo-model-gateway --bin tilo-greeter --bin tilo-installer --bin tilo-runtime-bundle --bin tilo-app-host --bin tilo-rollback --bin tilo-crypto --bin tilo-image-trust --bin tilo-device-key-init --bin tilo --bin app --bin tilo-app-package --bin tilo-install --bin tilo-cli-shim --bin tilo-ush --bin tilo-projector --bin tilo-pdf-helper --bin tilo-system-extension-manager --bin tilo-windows-runtime --bin tilo-relay --bin tilo-relay-admin --bin tilo-enroll --bin tilo-home-peer-control --bin tilo-account-credential" \
    # The thin-app profile compiles each crate as one codegen unit, for tapp
    # size. Built in the image without LTO (a dev build) the runtime and its
    # dependencies take 16: one unit made fs alone compile for ten minutes.
    # The wrapper still builds each app binary as one unit.
    && build_thin_apps() { \
         EXCLUDE_PACKAGES="${THIN_EXCLUDES}" \
         APP_FEATURES="${APP_FEATURES}" \
         CARGO_PROFILE_THIN_APP_CODEGEN_UNITS="$([ "$TILO_RUST_LTO" = off ] && echo 16 || echo 1)" \
         CARGO_PROFILE_THIN_APP_DEBUG="$TILO_RUST_DEBUGINFO" \
         EXTRA_CARGO_ARGS="$1" \
           /build/os/scripts/build-thin-apps.sh; \
       } \
    # A build without LTO (the dev lanes) compiles the thin apps alongside the
    # release binaries: Cargo locks each profile's directory on its own, and
    # the release graph mostly waits on a few long units (tilo-ui, shell)
    # while the apps compile wide. With thin LTO the two would not fit in the
    # builder's memory, so a release builds them one after the other.
    && thin_pid="" \
    && if [ "${TILO_PREBUILT_APPS}" != 1 ] && [ "$TILO_RUST_LTO" = off ]; then \
         { ( thin_started=$(date +%s); build_thin_apps "" \
             && printf 'TILO_BUILD_TIMING phase=rust-thin-apps-parallel elapsed_seconds=%s exit_code=0\n' "$(( $(date +%s) - thin_started ))" \
           ) > /tmp/tilo-thin-apps.log 2>&1 & } \
         && thin_pid=$!; \
       fi \
    && build_phase rust-release \
    # Without LTO nothing merges the units again, so a dev build splits the
    # large crates (shell's library alone ran 180 s at eight) further.
    && release_units="$([ "$TILO_RUST_LTO" = off ] && echo 16 || echo 8)" \
    && CARGO_PROFILE_RELEASE_LTO="$TILO_RUST_LTO" \
       CARGO_PROFILE_RELEASE_CODEGEN_UNITS="$release_units" \
       CARGO_PROFILE_RELEASE_DEBUG="$TILO_RUST_DEBUGINFO" \
       cargo build --release ${TILO_CARGO_TIMINGS:+--timings} ${RELEASE_ARGS} -p tilo-relay ${RELEASE_BINS} ${BROWSER_PKG} \
    && { [ -z "$TILO_CARGO_TIMINGS" ] || python3 os/scripts/cargo-timings-summary.py target/cargo-timings/cargo-timing.html; } \
    && build_phase rust-windows-vm \
    && CARGO_PROFILE_RELEASE_LTO="$TILO_RUST_LTO" \
       CARGO_PROFILE_RELEASE_CODEGEN_UNITS="$release_units" \
       CARGO_PROFILE_RELEASE_DEBUG="$TILO_RUST_DEBUGINFO" \
       cargo build --release -p windows-vm \
         --bin tilo-windows-vm-control --bin tilo-windows-rail \
    && build_phase rust-output-validation \
    && missing=0 \
    && for b in shell tilo-runtime-mcp tilo-projector tilo-pdf-helper fs tilo-relay tilo-relay-admin tilo-enroll tilo-home-peer-control terminal file-explorer settings tilo-model-manager tilo-model-gateway tilo-greeter tilo-installer tilo-runtime-bundle tilo-launcher tilo-app-host tilo-unlock-helper tilo-rollback tilo-crypto tilo-image-trust tilo-device-key-init tilo app tilo-app-package tilo-install tilo-cli-shim tilo-ush tilo-system-extension-manager tilo-windows-vm-control tilo-windows-rail tilo-windows-runtime tilo-account-credential; do \
         case "${TILO_PREBUILT_DESKTOP}:$b" in 1:shell|1:tilo-launcher|1:tilo-unlock-helper|1:tilo-runtime-mcp) continue ;; esac; \
         if [ ! -x "target/release/$b" ]; then \
           printf 'Required build output is missing: %s\n' "$b" >&2; missing=1; \
         fi; \
       done \
    && if [ "${TILO_WITH_BROWSER}" != "0" ] && [ ! -x target/release/browser ]; then \
         printf '%s\n' 'Required build output is missing: browser' >&2; missing=1; \
       fi \
    # Profiles were already cleaned before compilation. A missing output now
    # indicates a build contract error; repeating the same full build hides it.
    && [ "$missing" = 0 ] \
    && build_phase rust-stage-outputs \
    && mkdir -p /out /out/optional /out/thin-apps \
    && if [ "${TILO_PREBUILT_DESKTOP}" = 1 ]; then \
         cp /build/os/desktop-artifacts/shell \
            /build/os/desktop-artifacts/tilo-runtime-mcp \
            /build/os/desktop-artifacts/tilo-launcher \
            /build/os/desktop-artifacts/tilo-unlock-helper \
            /out/; \
       else \
         cp target/release/shell \
            target/release/tilo-runtime-mcp \
            target/release/tilo-launcher \
            target/release/tilo-unlock-helper \
            /out/; \
       fi \
    && { [ "${TILO_WITH_BROWSER}" = "0" ] \
         || cp target/release/browser /out/optional/browser; } \
    && cp target/release/tilo-projector \
          target/release/tilo-pdf-helper \
          target/release/fs \
          target/release/tilo-relay \
          target/release/tilo-relay-admin \
          target/release/tilo-enroll \
          target/release/tilo-home-peer-control \
          target/release/terminal \
          target/release/file-explorer \
          target/release/settings \
          target/release/tilo-model-manager \
          target/release/tilo-model-gateway \
          target/release/tilo-system-extension-manager \
          target/release/tilo-greeter \
          target/release/tilo-installer \
          target/release/tilo-runtime-bundle \
          target/release/tilo-app-host \
          target/release/tilo-rollback \
          target/release/tilo-crypto \
          target/release/tilo-image-trust \
          target/release/tilo-device-key-init \
          target/release/tilo \
          target/release/app \
          target/release/tilo-app-package \
          target/release/tilo-install \
          target/release/tilo-cli-shim \
          target/release/tilo-ush \
          target/release/tilo-windows-vm-control \
          target/release/tilo-windows-rail \
          target/release/tilo-windows-runtime \
          target/release/tilo-account-credential \
          /out/ \
    && ln -s app /out/store \
    && ln -s tilo /out/system \
    && mkdir -p /out/completions/bash /out/completions/fish /out/completions/zsh \
    && target/release/tilo completions bash > /out/completions/bash/tilo \
    && target/release/app completions bash > /out/completions/bash/app \
    && target/release/tilo completions fish > /out/completions/fish/tilo.fish \
    && target/release/app completions fish > /out/completions/fish/app.fish \
    && target/release/tilo completions zsh > /out/completions/zsh/_tilo \
    && target/release/app completions zsh > /out/completions/zsh/_app \
    # Files stays a standalone /usr/bin binary for recovery; its package is the
    # thin build like every other app, matching the release collection.
    && build_phase rust-thin-apps \
    && if [ "${TILO_PREBUILT_APPS}" = 1 ]; then \
         mkdir -p /out/prebuilt-apps /out/browser-app \
         && cp /build/os/app-artifacts/*.tapp /out/prebuilt-apps/ \
         && cp -a /build/os/app-runtime/tilo-runtime /usr/lib/ \
         && cp /build/os/app-runtime/runtime-bundle-publisher.hex /out/ \
         && RUNTIME_DYLIB="$(find /usr/lib/tilo-runtime -name libruntime_dylib.so -print -quit)" \
         && [ -n "$RUNTIME_DYLIB" ] \
         && cp "$RUNTIME_DYLIB" /out/libruntime_dylib.so; \
       else \
         if [ -n "$thin_pid" ]; then \
           thin_status=0; wait "$thin_pid" || thin_status=$?; \
           cat /tmp/tilo-thin-apps.log; \
           [ "$thin_status" = 0 ]; \
         else \
           build_thin_apps "${TILO_CARGO_TIMINGS:+--timings}" \
           && { [ -z "$TILO_CARGO_TIMINGS" ] || python3 os/scripts/cargo-timings-summary.py target/cargo-timings/cargo-timing.html; }; \
         fi \
         && for m in /build/apps/*/tilo-app.toml; do \
              p="$(sed -n 's/^name *= *"\([^"]*\)".*/\1/p' "$(dirname "$m")/Cargo.toml" | head -1)"; \
              b="$(basename "$(sed -n 's/^bin  *= *"\([^"]*\)".*/\1/p' "$m" | head -1)")"; \
              case " ${THIN_EXCLUDES} " in *" $p "*) continue ;; esac; \
              [ -z "$b" ] || cp "target/thin-app/$b" /out/thin-apps/; \
            done \
         && cp target/thin-app/libruntime_dylib.so /out/ \
         && LIBSTD="$(find "$(rustc --print target-libdir)" -maxdepth 1 -name 'libstd-*.so' -print -quit)" \
         && [ -n "${LIBSTD}" ] \
         && cp "${LIBSTD}" /out/; \
       fi \
    && build_phase rust-cleanup \
    # Every build product needed below now lives in /out. A clean build's
    # target cache is disposable (sccache holds reusable compiler objects), so
    # it is emptied to keep it from starving the later, large Windows
    # compatibility RPM transaction. A content-fresh build keeps it: it is what
    # the next build reuses, together with the hash record inside it, and
    # emptying it made every local rebuild relink every binary.
    && if [ "$TILO_CARGO_FRESHNESS" = clean ]; then \
         find /build/target -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; \
       fi

# Read the hardening back off the linked binaries. `.cargo/config.toml` sets
# the flags; this is what proves they survived to the artifacts this image
# ships — a dropped linker argument or a target change is otherwise invisible
# until someone runs readelf on a released image. Fails the build, on purpose.
RUN /build/os/scripts/verify-elf-hardening.sh /out \
    && { [ "${TILO_PREBUILT_APPS}" = 1 ] \
         || /build/os/scripts/verify-elf-hardening.sh /out/thin-apps; } \
    && /build/os/scripts/verify-elf-hardening.sh /out/libruntime_dylib.so

# ---- Bake a signed runtime bundle from THIS image's rootfs -----------------
# Runs at image-build time so the produced OS image ships a pre-mounted
# /usr/lib/tilo-runtime/<RUNTIME_VERSION>/ that the launcher can find
# without a post-boot `tilo-install runtime install`.
#
# The signing key is generated fresh per build. Its pubkey is baked into
# /usr/share/tilo/runtime-bundle-trusted-publishers.txt so the launcher's
# signature-verify step accepts this bake. The private key is discarded
# once the bundle is signed — this is fine for a build-time attestation
# (nothing else ever needs to sign as this identity again).
# Must match the `runtime = "tilo-runtime/<version>"` every app manifest under
# apps/ declares: the launcher resolves that literal version to
# /usr/lib/tilo-runtime/<version>/ and refuses to start the app when it is not
# there. Baking "1" while the fleet asked for 2026.07 meant every packaged app
# failed at launch with RuntimeBundleMissing.
#
# Baked at /usr/lib/tilo-runtime/<version>/ — the path it will occupy on the
# booted system — and not into a staging directory, for the same reason the app
# store below is written at its final path. `tilo-install` refuses to install a
# package whose declared runtime is absent, and it looks for exactly two places:
# the per-user bundle dir and this system one (runtime_status ->
# runtime_bundle::system_bundle_path). Staging the bake somewhere else and
# relocating it in the rootfs stage left that lookup failing during pack-apps,
# so every packaged app was refused at *install* time with the message telling
# the operator to run `tilo-install runtime install` — 46 of them, and no image.
ARG RUNTIME_VERSION=2026.07
ENV RUNTIME_VERSION=${RUNTIME_VERSION}
# The bundle and the app store below record when they were produced: the build
# scripts' SOURCE_DATE_EPOCH, not the fixed one the compile above ran with.
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
# libstd is not on the system loader path and ldd reports it "not found", so
# the dependency loop below never picks it up: it is included by name. The
# closure check then loads every bundled object and thin app the way the
# launcher does, with only the bundle's lib/ on LD_LIBRARY_PATH.
RUN --mount=type=bind,source=os/scripts/verify-runtime-bundle-closure.sh,target=/usr/local/libexec/tilo-verify-runtime-bundle-closure.sh,ro \
    if [ "${TILO_PREBUILT_APPS}" = 1 ]; then \
      test -s /out/runtime-bundle-publisher.hex \
      && /out/tilo-runtime-bundle verify \
        "/usr/lib/tilo-runtime/${RUNTIME_VERSION}" \
        --require-publisher "$(cat /out/runtime-bundle-publisher.hex)" \
      && bash /usr/local/libexec/tilo-verify-runtime-bundle-closure.sh \
        "/usr/lib/tilo-runtime/${RUNTIME_VERSION}"; \
    else \
      /out/tilo-runtime-bundle key generate --out /out/runtime-bundle-identity.json \
      && RUST_LIBSTD="$(find /out -maxdepth 1 -name 'libstd-*.so' -print -quit)" \
      && [ -n "${RUST_LIBSTD}" ] \
      && /bin/bash -eu -o pipefail -c ' \
        args=(/out/tilo-runtime-bundle build \
          --version "${RUNTIME_VERSION}" --arch "$(uname -m)" --from / \
          --include /out/libruntime_dylib.so \
          --include "$1" \
          --identity /out/runtime-bundle-identity.json \
          --out "/usr/lib/tilo-runtime/${RUNTIME_VERSION}"); \
        while IFS= read -r dependency; do args+=(--include "$dependency"); done \
          < <(ldd /out/libruntime_dylib.so \
              | awk '\''{ for (i=1; i<=NF; i++) if ($i ~ /^\//) print $i }'\'' \
              | sort -u); \
        "${args[@]}"' bundle "${RUST_LIBSTD}" \
      && /out/tilo-runtime-bundle key pubkey \
        --identity /out/runtime-bundle-identity.json \
        > /out/runtime-bundle-publisher.hex \
      && /out/tilo-runtime-bundle verify \
        "/usr/lib/tilo-runtime/${RUNTIME_VERSION}" \
        --require-publisher "$(cat /out/runtime-bundle-publisher.hex)" \
      && bash /usr/local/libexec/tilo-verify-runtime-bundle-closure.sh \
        "/usr/lib/tilo-runtime/${RUNTIME_VERSION}" /out/thin-apps/* \
      && rm -f /out/runtime-bundle-identity.json; \
    fi

# A full WPE browser is much larger than the application wire limit, and putting
# browser/wpe into the thin-app Cargo graph unified ui/webview into every tapp
# (~1.9 MB of .text on Settings vs CI). Keep the executable in a separately
# signed runtime and package only a tiny entrypoint for both source and prebuilt
# collections, matching dist/apps/app-collections.toml which excludes browser.
ARG TILO_BROWSER_RUNTIME_PUBLISHER=""
RUN --mount=type=secret,id=browser_runtime_identity \
    : > /out/browser-runtime-publisher.hex \
    && if [ "${TILO_WITH_BROWSER}" != 0 ]; then \
         mkdir -p /out/browser-app \
         && test "${RUNTIME_VERSION}" = 2026.07 \
         && test -x /out/optional/browser \
         && if [ -n "$TILO_BROWSER_RUNTIME_PUBLISHER" ]; then \
              test -s /run/secrets/browser_runtime_identity \
              && actual="$(/out/tilo-runtime-bundle key pubkey \
                   --identity /run/secrets/browser_runtime_identity)" \
              && test "$actual" = "$TILO_BROWSER_RUNTIME_PUBLISHER" \
              && identity=/run/secrets/browser_runtime_identity; \
            else \
              /out/tilo-runtime-bundle key generate --out /out/browser-runtime-identity.json \
              && identity=/out/browser-runtime-identity.json; \
            fi \
         && /out/tilo-runtime-bundle build \
              --version 2026.7.0-browser --arch "$(uname -m)" --from / \
              --include /out/optional/browser \
              --identity "$identity" \
              --out /usr/lib/tilo-runtime/2026.7.0-browser \
         && /out/tilo-runtime-bundle key pubkey \
              --identity "$identity" \
              > /out/browser-runtime-publisher.hex \
         && /out/tilo-runtime-bundle verify \
              /usr/lib/tilo-runtime/2026.7.0-browser \
              --require-publisher "$(cat /out/browser-runtime-publisher.hex)" \
         && test -x /usr/lib/tilo-runtime/2026.7.0-browser/lib/browser \
         && if [ "$(uname -m)" = x86_64 ]; then cet=-Wl,-z,shstk; else cet=; fi \
         && cc -std=c11 -Wall -Wextra -Werror -O2 -fPIE -pie \
              -fstack-protector-strong -Wl,-z,relro,-z,now ${cet} \
              /build/os/scripts/browser-runtime-launcher.c \
              -o /out/browser-app/browser \
         && /build/os/scripts/verify-elf-hardening.sh /out/browser-app/browser \
         && rm -f /out/browser-runtime-identity.json; \
       fi

# ---- Pack + install every app into the image-wide app store -----------------
# Without this the launcher's registry is empty on a fresh install and the
# command palette's Applications provider has nothing to list, however many
# app binaries the image contains.
#
# The store is written at the path it will occupy on the booted system:
# `tilo-install` records absolute payload paths in registry.toml, so staging it
# elsewhere and relocating it afterwards would leave every row dangling.
#
# Packages take the ordinary route — `tilo-app-package pack` then `tilo-install install`
# — so a preinstalled app is described exactly as a user-installed one is, and
# the launcher grants it exactly the same thing. See os/scripts/pack-apps.sh.
RUN --mount=type=secret,id=browser_app_identity \
    export TILO_IMAGE_BUILD=1 \
    && BIN_DIR=/out/thin-apps \
    TAPP_DIR=/out/prebuilt-apps \
    EXPECTED_PUBKEY="${TILO_APP_COLLECTION_PUBLISHER}" \
    PKG_BIN=/out/tilo-app-package \
    INSTALL_BIN=/out/tilo-install \
    BUNDLE_BIN=/out/tilo-runtime-bundle \
    SHIM_BIN=/out/tilo-cli-shim \
    PUBKEY_OUT=/out/app-publisher.hex \
    /build/os/scripts/pack-apps.sh \
    && { [ "${TILO_WITH_BROWSER}" = 0 ] \
         || { mkdir -p /tmp/browser-package-repo/apps/browser \
            && sed "s#tilo-runtime/${RUNTIME_VERSION}\"#tilo-runtime/2026.7.0-browser\"#" \
                 /build/apps/browser/tilo-app.toml \
                 > /tmp/browser-package-repo/apps/browser/tilo-app.toml \
            && grep -Eq '^runtime[[:space:]]*=[[:space:]]*"tilo-runtime/2026\.7\.0-browser"$' \
                 /tmp/browser-package-repo/apps/browser/tilo-app.toml \
            && if [ -n "$TILO_BROWSER_RUNTIME_PUBLISHER" ]; then \
                 test -s /run/secrets/browser_app_identity \
                 && browser_app_identity=/run/secrets/browser_app_identity \
                 && browser_app_publisher="$TILO_APP_COLLECTION_PUBLISHER"; \
               else \
                 browser_app_identity= \
                 browser_app_publisher=; \
               fi \
            && REPO=/tmp/browser-package-repo \
            BIN_DIR=/out/browser-app \
            TAPP_DIR= \
            IDENTITY_JSON="$browser_app_identity" \
            EXPECTED_PUBKEY="$browser_app_publisher" \
            PKG_BIN=/out/tilo-app-package \
            INSTALL_BIN=/out/tilo-install \
            BUNDLE_BIN=/out/tilo-runtime-bundle \
            SHIM_BIN=/out/tilo-cli-shim \
            REQUIRE_MIN=1 \
            PUBKEY_OUT=/out/browser-publisher.hex \
            /build/os/scripts/pack-apps.sh \
            && rm -rf /tmp/browser-package-repo; }; }

# The env-runtime environment image joins the apps in the read-only store, so
# the first environment opens offline. It takes the path every image takes on
# a device (`tilo-install image add`); see os/scripts/install-env-runtime.sh.
RUN --mount=type=bind,from=env-runtime,source=/,target=/tilo-env-runtime,ro \
    /build/os/scripts/install-env-runtime.sh /tilo-env-runtime/env-runtime \
      /usr/share/tilo-apps /usr/share/tilo-apps /out/tilo-install

# Enumerated artifact overlays keep the expensive rootfs stage shallow without
# bulk-copying os/usr (which would accidentally ship development/test-only
# files). Their internal COPY layers are cheap scratch-tree commits; each is
# applied to the multi-gigabyte bootc rootfs once, at the same logical boundary
# where its individual files were previously copied.
FROM scratch AS native-builder-payload
COPY --from=builder /out/ /out/
COPY --from=builder /usr/lib/tilo-runtime/ /usr/lib/tilo-runtime/
COPY --from=builder /usr/share/tilo-apps/ /usr/share/tilo-apps/

# Fedora DNF/RPM record wall-clock transaction times in rpmdb and history.
# Build the tiny clock shim separately so it does not invalidate Rust/WPE output.
FROM ${WPE_BUILDROOT_REF} AS dnf-build-clock
COPY os/scripts/build-clock.c /tmp/build-clock.c
RUN cc -std=c11 -Wall -Wextra -Werror -O2 -fPIC -shared \
    /tmp/build-clock.c -o /build-clock.so

FROM ${WPE_BUILDROOT_REF} AS virtio-gallivm-cpu
COPY os/scripts/virtio-gallivm-cpu.c /tmp/virtio-gallivm-cpu.c
RUN cc -std=c11 -Wall -Wextra -Werror -O2 -fPIC -shared \
    -Wl,-z,relro,-z,now /tmp/virtio-gallivm-cpu.c -o /virtio-gallivm-cpu.so

# ---- Tilo build outputs, arranged by os/components.toml ---------------------
# The manifest is the one record of which Tilo-built file lands where. This
# stage applies it: every file of every image layer is installed under
# /image/<layer>/, and each overlay below copies its layer as one tree. Dev
# sysext layers are assembled by the same installer from the same entries, so
# the image and a dev layer cannot place a binary differently. Only /out is
# read, which a restored native builder payload provides as well. The manifest's
# `direct` files (baked runtime, app store) are copied by the rootfs stage from
# the builder itself, since the build writes them at their final paths.
# tools/policy/check_component_manifest.py fails when a build output is copied
# into the image outside this path.
FROM ${BASE_REF} AS component-files
ARG SOURCE_DATE_EPOCH=0
COPY os/components.toml os/scripts/install-components.py /tilo-components/
RUN --network=none \
    --mount=type=bind,from=native-builder-payload,source=/out,target=/out,ro \
    python3 /tilo-components/install-components.py \
      --manifest /tilo-components/components.toml \
      --from /out --from /out/optional \
      --dest /image --by-layer --all

FROM scratch AS desktop-binaries
COPY --from=component-files /image/desktop-binaries/ /
COPY --from=doubletake-builder /out/doubletake /usr/libexec/tilo-doubletake
COPY --from=doubletake-builder /out/doubletake-test-receiver /usr/libexec/tilo-doubletake-test-receiver
COPY --from=fluxcast-builder /src/src /usr/libexec/tilo-fluxcast-src
COPY --from=joycond-builder /out/usr/bin/joycond /usr/bin/joycond
COPY --from=joycond-builder /out/usr/lib/systemd/system/joycond.service /usr/lib/systemd/system/joycond.service
COPY --from=joycond-builder /out/usr/lib/modules-load.d/joycond.conf /usr/lib/modules-load.d/joycond.conf
# tilo-session records each login through the flight recorder; the report
# summarises those records. The host package installs the same two files.
COPY dist/session/tilo-flight-recorder.py /usr/libexec/tilo-flight-recorder
COPY dist/session/tilo-session-report.py /usr/libexec/tilo-session-report

FROM scratch AS remote-capture-files
COPY os/etc/tilo/desktop.toml /etc/tilo/desktop.toml
COPY os/etc/modprobe.d/tilo-remote-camera.conf /etc/modprobe.d/tilo-remote-camera.conf
COPY os/etc/modules-load.d/tilo-remote-camera.conf os/etc/modules-load.d/tilo-ddc.conf /etc/modules-load.d/

FROM scratch AS rollback-files
COPY --from=component-files /image/rollback-files/ /
COPY \
