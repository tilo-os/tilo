COPY os/docs/peer-sync.md /usr/share/doc/qos/peer-sync.md
# The Secure Boot + disk-encryption procedure. On-image because the enrolment
# sequence has to be readable from the machine being enrolled, which is the one
# place a wrong step stops it from booting.
# The boot-chain document the Secure Boot units and qos-security-audit point at.
# It used to be copied from docs/secure-boot.md, which was folded into
# docs/security/ — and the COPY was not updated, so every image build since has
# failed at this line with `"/docs/secure-boot.md": not found`. Installed under its
# real name, and the Documentation= lines that referenced the old one follow it.
COPY docs/security/boot-chain.md /usr/share/doc/qos/boot-chain.md
COPY docs/security/rollback.md /usr/share/doc/qos/rollback.md

# ---------------------------------------------------------------------------
# Bootloader — swap GRUB for systemd-boot
# ---------------------------------------------------------------------------
# systemd-boot is smaller + simpler than GRUB (no menu render step, no module
# load path, BLS entries loaded straight off the ESP), so cold boot to the
# kernel handoff is measurably shorter. bootc chooses which bootloader to
# plant on the ESP at install time based on the `bootloader` key in the
# /usr/lib/bootc/install/*.toml drop-ins baked into this image (see the
# 40-qos.toml file below). The `systemd-boot-unsigned` package supplies the
# actual EFI binaries + BLS layout that bootc/bootupd copy across.
#
# The GRUB stack (grub2 + shim + bootupd's grub2 side) is pulled in by the
# fedora-bootc base and would otherwise still ship on the rootfs, wasting
# ~30 MB and leaving dead code paths in bootupd. Drop it after installing
# systemd-boot so nothing during install can pick GRUB by accident.
#
# dnf5 refuses to remove grub2-efi-x64 / grub2-pc / grub2-tools-minimal /
# shim-x64 (each ships an `/etc/dnf/protected.d/*.conf` marking itself
# protected against removal) and won't accept `--allowerasing` on `remove`.
# The systemd-boot install already satisfies the "some bootloader must
# exist" invariant, so shell out to `rpm -e --nodeps` for the protected
# ones — dnf handles the unprotected ones on the same pass.
#
# sbsigntools and efitools are what replaces the trust that removal takes away.
# Deleting shim and GRUB, and building our own kernel, leaves nothing on the boot
# path that a distribution key covers — so the machine has to be able to sign its
# own artefacts and enrol its own Platform Key. sbsign/sbverify do the signing,
# cert-to-efi-sig-list/efi-updatevar/efi-readvar the enrolment; without them
# /usr/libexec/qos-secureboot can only refuse. See docs/security/boot-chain.md.
# bootupd goes with them, and that is a requirement of the sealed layout rather
# than tidiness: bootc refuses to seal an image that still offers a bootupd
# install path, because bootupd only ever plants GRUB. Its payload directory and
# the legacy ostree boot dir have to go too — bootc finds the path through either.
# Nothing on this image needs it: with a UKI there is exactly one PE binary on the
# boot path, /usr/libexec/qos-secureboot signs it with sbsign, and
# qos-secureboot-sign.path already watches /boot/EFI/Linux for a newly staged one.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        systemd-boot-unsigned \
    && rpm -qa | grep -E '^(shim-x64|grub2-)' | xargs -r rpm -e --nodeps \
    && rpm -e --nodeps bootupd \
    && rm -rf /usr/lib/bootupd /usr/lib/ostree-boot \
    && dnf clean all && ${FINALIZE_RPMDB}

# The signing tools, in their own transaction and allowed to be absent.
#
# They are named here so the snapshot job keeps resolving them into the frozen
# package set, but a snapshot that predates them must not fail the whole image
# build: nothing on the boot path needs them, and the one thing that does —
# /usr/libexec/qos-secureboot — already refuses every command with the exact
# remedy when they are missing. The safety property lives in the tool failing
# closed, not in the build failing open. systemd-boot-unsigned above stays in a
# strict transaction, because an image with no bootloader IS a broken image.
# systemd-ukify joins them for the same reason and with the same tolerance. It
# builds the Unified Kernel Image that seals the kernel, initramfs and command
# line into one signed artefact — which is what puts `qos.generation=` inside a
# signature and into PCR 11, where the rollback policy can bind to it. A bare
# kernel plus a loader entry cannot: the command line sits beside it as an
# editable file.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --skip-unavailable --setopt=reposdir=/repo \
        sbsigntools \
        efitools \
        systemd-ukify \
    && dnf clean all && ${FINALIZE_RPMDB}

# systemd-ukify's pinned dependency set now provides Pillow, while the font
# transaction above provides Noto Sans. Render the unlock copy only once both
# are present; the resulting PNGs, not either desktop dependency, are what the
# initramfs theme consumes.
RUN python3 /usr/local/bin/make-plymouth-assets.py /usr/share/plymouth/themes/qos \
 && plymouth-set-default-theme qos \
 && test "$(plymouth-set-default-theme)" = qos

# The install-config drop-in that flips bootc's bootloader choice to
# systemd-boot. Lives at /usr/lib/bootc/install/*.toml — a drop-in dir bootc
# merges at every `bootc install {to-disk,to-filesystem}` invocation. bib
# runs the same install code path, so this covers the disk-image step
# (os/dev/disk-image.sh) and the installer's `bootc install to-disk` alike.
COPY os/usr/lib/bootc/install/40-qos.toml /usr/lib/bootc/install/40-qos.toml

# ---------------------------------------------------------------------------
# Kernel/userspace hardening (security plan §11 — "table stakes")
# ---------------------------------------------------------------------------
# Kernel args (init_on_alloc/free, lockdown=integrity, slab_nomerge, kstack
# randomisation, page-alloc shuffle, vsyscall=none). bootc applies kargs.d at
# install/upgrade, and `bootc container ukify` seals it into the UKI command line
# at build time — which is what makes this set measured rather than merely
# applied. 03-boot.toml carries the arguments the install step used to inject.
COPY os/usr/lib/bootc/kargs.d/01-hardening.toml /usr/lib/bootc/kargs.d/01-hardening.toml
COPY os/usr/lib/bootc/kargs.d/03-boot.toml /usr/lib/bootc/kargs.d/03-boot.toml
# Which mode the sealed command line boots into. `qos.mode=repair` is what the
# repair entry carries, and it can only come from inside the signature — see the
# file's own header for why the two values have to stay the same length.
COPY os/usr/lib/bootc/kargs.d/04-mode.toml /usr/lib/bootc/kargs.d/04-mode.toml

# Disk-encryption block work: partitioning + LUKS2 + unlock-factor enrolment.
# Used by the installer (os/Containerfile.installer layers qos-install on top of
# this image), and afterwards on the installed system — `enrol` is also how a
# volume is re-sealed to a replaced TPM, which is exactly the case where the
# machine can only be reached with the recovery key.
COPY os/usr/libexec/qos-disk-encrypt /usr/libexec/qos-disk-encrypt
RUN chmod 0755 /usr/libexec/qos-disk-encrypt

# Owner-enrolled Secure Boot. qOS builds its own kernel, so the base image's
# Fedora/Microsoft-signed chain cannot cover it; the machine generates its own
# Platform Key instead, which is also what keeps a self-built image attestable
# to a collaborator who trusts that key.
#
# Generating and enrolling keys is a deliberate act the owner takes — nothing
# here does it, and the image build must never do it. What IS enabled by default
# is the re-signing unit, so the hook is already in place before any key is
# enrolled; it is a no-op until keys exist (ConditionPathExists). Getting that
# order wrong — keys enrolled, signing hook missing — is what leaves a machine
# refusing its own kernel.
COPY os/usr/libexec/qos-secureboot /usr/libexec/qos-secureboot
COPY os/usr/libexec/qos-verified-boot-install-preflight /usr/libexec/qos-verified-boot-install-preflight
COPY os/usr/lib/systemd/system/qos-secureboot-sign.service /usr/lib/systemd/system/qos-secureboot-sign.service
COPY os/usr/lib/systemd/system/qos-secureboot-sign.path /usr/lib/systemd/system/qos-secureboot-sign.path
COPY os/usr/lib/systemd/system/qos-secureboot-sign-shutdown.service /usr/lib/systemd/system/qos-secureboot-sign-shutdown.service
RUN chmod 0755 /usr/libexec/qos-secureboot /usr/libexec/qos-verified-boot-install-preflight \
    && systemctl enable qos-secureboot-sign.service qos-secureboot-sign.path \
                        qos-secureboot-sign-shutdown.service

# Runtime tunables: no cross-process debugging, no kernel pointers or ring
# buffer for unprivileged readers, no unprivileged BPF, no kexec, no io_uring
# or userfaultfd, plus the /tmp symlink-race and LAN-spoofing settings. Under
# /usr/lib because it is part of the image; /etc/sysctl.d/ with a higher number
# still wins for a machine that needs to differ. The file's header explains why
# unprivileged user namespaces are NOT disabled — bubblewrap, hence the whole
# app sandbox, needs them.
COPY os/usr/lib/sysctl.d/60-qos-hardening.conf /usr/lib/sysctl.d/60-qos-hardening.conf

# Which sandboxed packages get the expensive protections (hardened allocator +
# hardware shadow stacks). Read by qos-launcher at launch; scoped rather than
# image-wide because the allocator costs multiples on allocation-heavy work and
# most of this system is Rust, which does not produce the bugs it catches. The
# image owns the list — an app manifest can neither request nor decline it.
COPY os/usr/lib/qos/untrusted-parsers.conf /usr/lib/qos/untrusted-parsers.conf

# Which sandboxed packages may map memory writable and executable at once.
# Read by qos-launcher when it compiles the syscall filter. Same reasoning as
# the file above and the same format: a package that could name its own
# profile would be lifting a protection off itself, so the image decides and
# the manifest only asks.
COPY os/usr/lib/qos/jit-entitled.conf /usr/lib/qos/jit-entitled.conf

# hidepid on /proc + the boot self-check that ASSERTS what's actually active.
COPY os/usr/libexec/qos-security-audit /usr/libexec/qos-security-audit
COPY os/usr/lib/systemd/system/qos-security-audit.service /usr/lib/systemd/system/qos-security-audit.service
COPY os/usr/lib/systemd/system/qos-hidepid.service /usr/lib/systemd/system/qos-hidepid.service
RUN chmod 0755 /usr/libexec/qos-security-audit

# ---------------------------------------------------------------------------
# Bounded rollback protection
# ---------------------------------------------------------------------------
# The last few OS generations may unseal the disk; older ones may not. A TPM2 NV
# monotonic counter holds the OLDEST permitted generation, and each generation's
# LUKS2 keyslot is sealed to a policy requiring the floor to be at or below it.
#
# The generation number this image carries. It MUST be a dense monotonic integer
# (+1 per published image), because the retention window is arithmetic on it —
# "the last three generations" is meaningless if the numbering is a timestamp, and
# moving the floor costs one TPM NV write per step (qos-rollback refuses an
# advance of more than MAX_INCREMENTS_PER_ADVANCE at all). os/dev/build-image.sh
# resolves it from the published series; the CI job that publishes an image
# derives it the same way and tags the result `gen<N>`.
#
# It reaches the running system by two routes, for two different jobs:
#
#   /usr/lib/bootc/kargs.d/02-generation.toml
#       `bootc container ukify` reads this directory and puts what it finds on the
#       UKI's sealed command line, which systemd-stub measures into PCR 11. That
#       is the authoritative copy — inside the signature, measured, and therefore
#       the one an unseal can be bound to. A number the bootloader assembled from
#       an editable file would look identical and be worth nothing.
#   /usr/lib/qos/generation
#       A plain file holding the same number, for the one question the command
#       line cannot answer: what generation is the deployment that has been
#       *staged* but never booted? Its keyslot has to be sealed before the reboot
#       that first runs it. Not trusted for anything — at that moment the machine
#       is already unlocked.
#
# Both are written from the same build argument in the same step, so they cannot
# disagree; rollback-boot-check.sh asserts on a booted machine that they don't.
#
# There is deliberately no default. A default is what a constant looks like once
# a caller forgets the argument, and an image that silently ships generation 0 is
# one whose rollback floor can never move — the failure would appear months later
# as a machine that will not unseal.
ARG QOS_GENERATION
RUN case "${QOS_GENERATION}" in \
      ''|*[!0-9]*) \
        echo "QOS_GENERATION must be a decimal integer; got '${QOS_GENERATION}'." >&2; \
        echo "It is the generation this image carries: +1 per published image, sealed" >&2; \
        echo "onto the UKI command line. os/dev/build-image.sh resolves it from the" >&2; \
        echo "published series; pass QOS_GENERATION=<N> to build one by hand." >&2; \
        exit 1 ;; \
    esac \
 && install -d -m 0755 /usr/lib/qos \
 && printf '%s\n' "${QOS_GENERATION}" > /usr/lib/qos/generation \
 && printf '# Written by the image build from the QOS_GENERATION build argument.\nkargs = ["qos.generation=%s"]\n' \
      "${QOS_GENERATION}" > /usr/lib/bootc/kargs.d/02-generation.toml \
 && echo "generation ${QOS_GENERATION}: sealed via kargs.d, readable at /usr/lib/qos/generation"

# tpm2-tools: the NV counter, the policy sessions and TPM2_NV_Certify are driven
# through it. Also reachable from recovery mode, which is where someone will need
# it when automatic unlock has failed.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        tpm2-tools \
    && dnf clean all && ${FINALIZE_RPMDB} && rm -rf /var/cache/dnf /var/log/dnf* /var/lib/dnf

