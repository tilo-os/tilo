 && install -d -m 0755 /usr/share/qos/pcr-predictions

# ---------------------------------------------------------------------------
# Getting back from a bad update: boot assessment, rollback, repair mode
# ---------------------------------------------------------------------------
# The rollback machinery above narrows which generations may unseal the disk. This
# is the other half — the part that notices a generation is bad and gets the
# machine off it.
#
#   qos-boot-entries.service   gives every not-yet-proven deployment a systemd-boot
#                              try counter, and derives the repair entry.
#   qos-boot-health.service    ordered before boot-complete.target, so a boot that
#                              never reaches a login is never blessed and the
#                              counter it spent stays spent.
#   qos-boot-mode-generator    turns `qos.mode=repair` on the SEALED command line
#                              into a boot that comes up at the repair console
#                              instead of the desktop.
#
# `bootc rollback` is the command that should do this and it is not dependable on
# the composefs backend (bootc#2208), so /usr/libexec/qos-deployment verifies what
# it did and falls back to the boot loader's own default entry.
#
# uki-cmdline.py ships as qos-uki-cmdline because the repair entry is DERIVED from
# the installed UKI rather than built: a second UKI inside the rootfs would change
# the composefs digest it has to name. It rewrites `qos.mode=normal` to
# `qos.mode=repair` in place, same length, so every following PE section keeps its
# offset and the image still loads.
# The user-facing command. Thin: the work is in qos-deployment, and this is the
# part that decides how to become root to run it — directly when already root,
# through the polkit-authorised unit from a desktop session, and saying to use
# sudo rather than failing with a permission error from three layers down.
COPY --from=builder /out/qos /usr/bin/qos
COPY os/usr/libexec/qos-deployment /usr/libexec/qos-deployment
COPY os/usr/libexec/qos-system-extension-activate /usr/libexec/qos-system-extension-activate
COPY os/usr/libexec/qos-system-extension-dispatch /usr/libexec/qos-system-extension-dispatch
COPY os/usr/libexec/qos-boot-health /usr/libexec/qos-boot-health
COPY os/usr/libexec/qos-repair /usr/libexec/qos-repair
COPY os/dev/uki-cmdline.py /usr/libexec/qos-uki-cmdline
COPY os/usr/lib/systemd/system-generators/qos-boot-mode-generator /usr/lib/systemd/system-generators/qos-boot-mode-generator
COPY os/usr/lib/systemd/system/qos-boot-entries.service /usr/lib/systemd/system/qos-boot-entries.service
COPY os/usr/lib/systemd/system/qos-boot-health.service /usr/lib/systemd/system/qos-boot-health.service
COPY os/usr/lib/systemd/system/qos-repair.target /usr/lib/systemd/system/qos-repair.target
COPY os/usr/lib/systemd/system/qos-repair@.service /usr/lib/systemd/system/qos-repair@.service
COPY os/usr/lib/systemd/system/qos-deployment-rollback.service /usr/lib/systemd/system/qos-deployment-rollback.service
COPY os/usr/lib/systemd/system/qos-deployment-update.service /usr/lib/systemd/system/qos-deployment-update.service
COPY os/usr/lib/systemd/system/qos-system-extension-userspace.service /usr/lib/systemd/system/qos-system-extension-userspace.service
COPY os/usr/lib/systemd/system/qos-system-extension-boot-stage.service /usr/lib/systemd/system/qos-system-extension-boot-stage.service
COPY os/usr/lib/systemd/system/qos-local-model.service /usr/lib/systemd/system/qos-local-model.service
COPY os/usr/lib/systemd/system/qos-system-extension-dispatcher.socket /usr/lib/systemd/system/qos-system-extension-dispatcher.socket
COPY os/usr/lib/systemd/system/qos-system-extension-dispatcher@.service /usr/lib/systemd/system/qos-system-extension-dispatcher@.service
COPY os/usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/10-qos-boot-entries.conf /usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/10-qos-boot-entries.conf
COPY os/usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/20-qos-update-policy.conf /usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/20-qos-update-policy.conf
COPY os/usr/lib/systemd/system/qos-update-policy@.service /usr/lib/systemd/system/qos-update-policy@.service
COPY os/usr/libexec/qos-update-policy-set /usr/libexec/qos-update-policy-set
COPY os/usr/libexec/qos-update-policy-check /usr/libexec/qos-update-policy-check
# The narrow polkit grant that makes Settings' rollback control and its automatic
# -updates switch able to do what they say. See the rule for how narrow.
COPY os/etc/polkit-1/rules.d/49-qos-updates.rules /etc/polkit-1/rules.d/49-qos-updates.rules
COPY os/usr/share/qos/system-extensions /usr/share/qos/system-extensions
COPY os/usr/share/doc/qos/system-extensions.md /usr/share/doc/qos/system-extensions.md
