# syntax=docker/dockerfile:1.7
# ============================================================================
# qOS bootc image — multi-stage build
# ----------------------------------------------------------------------------
# Stage 1 (builder): compiles the Rust workspace binaries INSIDE the image
#   build, on a Fedora 44 base whose glibc matches the runtime. This removes
#   the old host-build + `COPY shell`/`COPY fs` hack and the F43->F44 glibc
#   coupling it caused.
# Stage 2 (final): the actual fedora-bootc:44 OS image. Installs the runtime
#   packages + configs + systemd units and copies the binaries out of the
#   builder. None of the builder's toolchain/-devel deps land here.
#
# The build context MUST be the repo root (the builder needs the workspace
# source). The OS config files live under os/, so their COPY sources are
# `os/`-prefixed:
#
#     podman build -f os/Containerfile -t localhost/qos:latest <repo-root>
#
# `.containerignore` at the repo root trims target/, os/output and .git from
# the context. See os/dev/build-image.sh and os/build.sh.
# ============================================================================


# ---- Frozen RPM repo (cross-time reproducibility) --------------------------
# Every `dnf install` below installs ONLY from this digest-pinned snapshot of
# the exact RPM set (built by os/dev/snapshot-rpms.sh / the snapshot-rpms CI
# job), never live Fedora mirrors — so the same source rebuilds the same image
# regardless of when. RPMS_REF (code.podesta.ai/qos/rpms@sha256:...) comes from
# os/rpms-snapshot.env via the build scripts.
# ADD/REMOVE A PACKAGE below -> re-run the `snapshot-rpms` workflow (it prints a
# new RPMS_REF; commit it to os/rpms-snapshot.env), else the build fails "No
# match for argument". The snapshot's package list is derived from this file.
# All three ARGs are declared here (before the first FROM) so they're in
# scope for FROM directives. An `ARG NAME` placed between two FROMs is
# scoped to the previous stage, not global — buildkit then reports
# `base name (${…}) should not be blank` when the next FROM tries to
# use it.
#
# BASE_REF (code.podesta.ai/qos/fedora-bootc@sha256:...) is the Fedora bootc
# base, mirrored into our registry and pinned by digest — see
# os/base-snapshot.env for why the mirror exists and how to refresh it. Every
# fedora-bootc stage below uses it, so builder and final share one base and
# their glibc cannot drift.
ARG BASE_REF
ARG RPMS_REF
ARG KERNEL_RPMS_REF

# QOS_WITH_BROWSER=0 builds the image without the browser: no WPE WebKit engine
# stage, no `browser` binary. Default 1 — a normal build is unchanged.
#
# The engine stage compiles libwpe + wpebackend-fdo + wpewebkit from source and
# takes ~45 of the ~60 minutes a cold build costs. Nothing about the boot chain
# (kernel, initramfs, LUKS/TPM unlock, greeter, installer, rollback) depends on
# it, so an engine failure should not be able to block boot verification. Opting
# out is how you get an image to boot-test in minutes while the browser's own
# build is being repaired.
ARG QOS_WITH_BROWSER=1
FROM ${RPMS_REF} AS rpms

# ---- Custom kernel repo ----------------------------------------------------
# Same "OCI image with /repo" shape as the frozen RPM repo (see
# os/Containerfile.rpms), but its content is a rebuilt Fedora kernel with
# our config fragment applied (static storage/net/USB/HID + PREEMPT +
# HZ=1000 + THP=always + trimmed debuginfo).  Built by
# .forgejo/workflows/build-kernel.yml and pinned by digest via
# os/kernel-snapshot.env — the runtime stage below swaps kernel-core for
# qos-kernel-core out of it.
FROM ${KERNEL_RPMS_REF} AS kernel-rpms


# ---- Stage 1a: WPE WebKit (browser engine) ----------------------------------
# The browser's engine is WPE WebKit; Fedora ships no WPE packages, so the
# stack (libwpe + wpebackend-fdo + wpewebkit) is compiled from release
# tarballs by the same script developers use locally (os/dev/build-wpe.sh).
# Configured for prefix=/usr and staged into /wpe: the rust builder overlays
# it to link `browser --features wpe`, the final image copies it into the
# rootfs.
#
# Build deps come from `dnf builddep webkitgtk6.0` (wpewebkit builds from the
# same source tree) against live repos — a deliberate exception to the
# frozen-repo rule for this throwaway stage: the output is pinned by the
# wpewebkit version in build-wpe.sh and reused from the layer cache until
# that changes. Folding the builddep set into the frozen snapshot is a
# follow-up.
FROM ${BASE_REF} AS wpe-builder-1

# The explicit list covers what the WPE port needs and the GTK port does not,
# so `builddep webkitgtk6.0` never pulls it: libinput + libudev (systemd-devel)
# back ENABLE_WPE_PLATFORM_DRM, and gbm/wayland/epoxy the rest of WPEPlatform.
RUN dnf install -y 'dnf5-command(builddep)' \
    && dnf builddep -y webkitgtk6.0 \
    && dnf install -y \
        meson ninja-build gperf unifdef libgbm-devel curl xz \
        wayland-devel wayland-protocols-devel libepoxy-devel \
        libinput-devel systemd-devel \
    && dnf clean all

COPY os/dev/build-wpe.sh /build-wpe.sh
RUN --mount=type=cache,target=/wpe-cache \
    QOS_WPE_CACHE=/wpe-cache QOS_WPE_PREFIX=/usr QOS_WPE_DESTDIR=/wpe \
    bash /build-wpe.sh build \
    && { [ ! -L /wpe/usr/lib ] || rm /wpe/usr/lib; }


# ---- Stage 1a-off: the same stage with no engine in it ----------------------
# Selected when QOS_WITH_BROWSER=0. It only has to satisfy the two
# `COPY --from=wpe-builder /wpe/ /` instructions below — copying the contents of
# an empty directory is a no-op, so both overlays vanish without either COPY
# needing to be conditional (a Containerfile has no conditional COPY).
FROM ${BASE_REF} AS wpe-builder-0
RUN mkdir -p /wpe

# Whichever of the two above QOS_WITH_BROWSER names becomes `wpe-builder`. The
# other is never built: an unreferenced stage is pruned from the build graph by
# both buildkit and buildah, so QOS_WITH_BROWSER=0 skips the engine compile
# rather than building and discarding it.
FROM wpe-builder-${QOS_WITH_BROWSER} AS wpe-builder


# ---- Stage 1: builder ------------------------------------------------------
# Base pinned by digest against our own mirror (BASE_REF, os/base-snapshot.env):
# a tag can be repointed, a digest can't — but upstream deletes the manifest a
# digest points at within about a day, so the pin only stays real if we hold a
# copy. Builder and final share BASE_REF, so their glibc matches by
# construction. Bump deliberately: re-run `mirror-base`, commit the new
# BASE_REF, re-run `snapshot-rpms`.
FROM ${BASE_REF} AS builder

# Rust toolchain + the C/-devel deps the workspace's *-sys crates link or build
# against. Superset of the my-distrobox dev deps (repo CLAUDE.md) plus the base
# toolchain a minimal bootc image lacks: cmake/perl/clang/openssl etc. that
# vendored crates (aws-lc-sys, the freetype/harfbuzz/fontconfig font stack,
# jemalloc, sqlite) need to build. `sccache` honours the project's
# .cargo/config.toml `rustc-wrapper`. Throwaway stage — nothing here ships.
#
# The last three lines of the list are for the WPE overlay copied in below
# rather than for any crate of ours, and they serve two different linker needs:
#
#   * glib2-devel + libsoup3-devel supply .pc files. `wpe-webkit-2.0.pc`
#     declares `Requires: glib-2.0 libsoup-3.0 wpe-1.0 wpe-platform-2.0`, and
#     pkg-config fails the whole lookup when any link in that chain is missing
#     — which ui/build.rs reports as the unhelpful "wpe-webkit-2.0 was not
#     found".
#   * The rest supply plain shared objects. libWPEWebKit-2.0.so records them in
#     DT_NEEDED, so linking `browser` against it makes ld open each one to
#     resolve symbols transitively; absent, ld reports them as `needed by
#     ... not found` and then buries that in hundreds of undefined references
#     to gst_*/epoxy_*/manette_*. Runtime packages are enough — no -devel
#     needed, because nothing here compiles against their headers.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        rust cargo sccache capnproto \
        gcc gcc-c++ make cmake perl perl-FindBin python3 git \
        clang clang-devel pkgconf-pkg-config \
        libxkbcommon-devel wayland-devel \
        libseat-devel libinput-devel systemd-devel libdrm-devel \
        mesa-libgbm-devel mesa-libGL-devel mesa-libEGL-devel \
        pipewire-devel \
        ffmpeg-free-devel libva-devel \
        openssl-devel sqlite-devel zlib-ng-compat-devel \
        fontconfig-devel freetype-devel harfbuzz-devel expat-devel \
        glib2-devel libsoup3-devel \
        atk at-spi2-atk gstreamer1 gstreamer1-plugins-base \
        hyphen libavif libepoxy libmanette libxslt \
        nasm \
    && dnf clean all

WORKDIR /build

# The whole cargo workspace: in-tree crates (ui) + submodule working trees
# (shell, fs, greeter, installer, apps/*). .containerignore keeps target/,
# os/output and .git out of the context.
COPY . /build

# Keep cargo's home and sccache's cache under /build (which exists via WORKDIR/
# COPY). The fedora-bootc base has no /root, so nesting cache mounts there fails
# ("stat /root: no such file or directory"); single subdirs of /build are safe.
# Deterministic compile (reproducible builds): no incremental state in output,
# remap the build path so binaries don't embed /build, fixed locale/timezone so
# any sorted/formatted output is stable. SOURCE_DATE_EPOCH (passed by the build
# scripts as a build-arg, default 0) is honoured by tools that timestamp output.
ARG SOURCE_DATE_EPOCH=0
ENV CARGO_HOME=/build/.cargo-home \
    SCCACHE_DIR=/build/.sccache \
    CARGO_INCREMENTAL=0 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    LC_ALL=C.UTF-8 \
    TZ=UTC

# WPE WebKit headers + libs so `browser --features wpe` links against the
# engine built in the wpe-builder stage. Overlaying /usr in this throwaway
# stage keeps pkg-config discovery entirely standard.
COPY --from=wpe-builder /wpe/ /

# Compile the binaries the OS images need. Cache mounts persist cargo's
# registry + git checkouts (CARGO_HOME), the target dir, and the sccache store
# across rebuilds; a cache-mounted target/ isn't in any layer, so the binaries
# are cp'd to /out (a real path) in the same RUN for the final stage to COPY.
#
# Two CI guards (the image builds under buildkit, not just podman/buildah):
#  - The resolve comes from the tracked `Cargo.lock`, which is why that file is
#    committed: a fresh resolve picks incompatible transitive versions (iroh
#    pulls a pre-release ed25519-dalek that does not compile against current
#    `signature`), and the failure surfaces inside a dependency rather than
#    anywhere this image touches. `cargo build` (not --locked) still lets the
#    resolve adjust conservatively where a manifest here differs, while keeping
#    the good pins.
#  - Brace the trailing sccache stat so a failing `cargo build` fails the RUN
#    instead of being swallowed by `|| true` (which masked a cargo failure as a
#    confusing downstream "COPY --from /out: not found").
#
# The browser is the one optional binary (QOS_WITH_BROWSER, top of file). It is
# staged into /out/optional/ rather than /out/ so the final image can copy the
# directory's contents unconditionally: empty means no browser, and no COPY
# needs a condition it cannot express.
ARG QOS_WITH_BROWSER
RUN --mount=type=cache,target=/build/.cargo-home \
    --mount=type=cache,target=/build/target \
    --mount=type=cache,target=/build/.sccache \
    if [ "${QOS_WITH_BROWSER}" = "0" ]; then BROWSER_PKG=""; \
    else BROWSER_PKG="-p browser --features browser/wpe"; fi \
    && cargo build --release \
        -p shell -p fs -p terminal -p file-explorer -p greeter -p installer \
        -p runtime-bundle -p launcher -p qos-power -p qos-unlock-helper \
        -p qos-rollback \
        ${BROWSER_PKG} \
    && mkdir -p /out /out/optional \
    && { [ "${QOS_WITH_BROWSER}" = "0" ] \
         || cp target/release/browser /out/optional/browser; } \
    && cp target/release/shell \
          target/release/fs \
          target/release/terminal \
          target/release/file-explorer \
          target/release/qos-greeter \
          target/release/qos-installer \
          target/release/qos-runtime-bundle \
          target/release/qos-launcher \
          target/release/qos-power \
          target/release/qos-unlock-helper \
          target/release/qos-rollback \
          /out/ \
    && { sccache --show-stats 2>/dev/null || true; }

# Read the hardening back off the linked binaries. `.cargo/config.toml` sets
# the flags; this is what proves they survived to the artifacts this image
# ships — a dropped linker argument or a target change is otherwise invisible
# until someone runs readelf on a released image. Fails the build, on purpose.
RUN /build/os/scripts/verify-elf-hardening.sh /out

# ---- Bake a signed runtime bundle from THIS image's rootfs -----------------
# Runs at image-build time so the produced OS image ships a pre-mounted
# /usr/lib/qos-runtime/<RUNTIME_VERSION>/ that the launcher can find
# without a post-boot `qos-install runtime install`.
#
# The signing key is generated fresh per build. Its pubkey is baked into
# /usr/share/qos/runtime-bundle-trusted-publishers.txt so the launcher's
# signature-verify step accepts this bake. The private key is discarded
# once the bundle is signed — this is fine for a build-time attestation
# (nothing else ever needs to sign as this identity again).
ARG RUNTIME_VERSION=1
ENV RUNTIME_VERSION=${RUNTIME_VERSION}
RUN /out/qos-runtime-bundle key generate --out /out/runtime-bundle-identity.json \
    && ARCH="$(uname -m)" \
    && /out/qos-runtime-bundle build \
        --version "${RUNTIME_VERSION}" \
        --arch "${ARCH}" \
        --from / \
        --identity /out/runtime-bundle-identity.json \
        --out "/out/qos-runtime-bundle-tree/${RUNTIME_VERSION}" \
    && /out/qos-runtime-bundle key pubkey \
        --identity /out/runtime-bundle-identity.json \
        > /out/runtime-bundle-publisher.hex \
    && /out/qos-runtime-bundle verify \
        "/out/qos-runtime-bundle-tree/${RUNTIME_VERSION}" \
        --require-publisher "$(cat /out/runtime-bundle-publisher.hex)" \
    && rm -f /out/runtime-bundle-identity.json


# ---- Stage 2: final (the OS image) -----------------------------------------
FROM ${BASE_REF}

# Graphics stack
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    mesa-dri-drivers \
    mesa-vulkan-drivers \
    libglvnd-egl \
    && dnf clean all

# Audio/Video
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    pipewire \
    pipewire-pulseaudio \
    wireplumber \
    && dnf clean all

# GStreamer — the Music app plays audio through a `playbin` whose sink chain
# ends in `autoaudiosink` (→ `pulsesink`, from -plugins-good, over the PipeWire
# pulse shim above). `gstreamer1-plugin-libav` supplies the AAC/Opus decoders
# (`avdec_aac`, `avdec_opus`) YouTube-Music streams need — without it the
# pipeline demuxes but decodes nothing and playback is silent.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    gstreamer1 \
    gstreamer1-plugins-base \
    gstreamer1-plugins-good \
    gstreamer1-plugin-libav \
    && dnf clean all

# Display manager + fingerprint auth (pam_fprintd for the greeter; the
# greeter's PAM stack references it via a tolerant `-auth` line).
#
# `polkit` is required so the greeter's Reboot / Shut down buttons can drive
# logind: `systemctl reboot` / `poweroff` issue the
# `org.freedesktop.login1.{reboot,power-off}` actions, which polkit authorises
# for the `greetd` user via etc/polkit-1/rules.d/49-qos-greeter-power.rules.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    greetd \
    greetd-tuigreet \
    fprintd \
    fprintd-pam \
    polkit \
    && dnf clean all

# System utilities.
#
# `xdg-dbus-proxy` (Fedora package name) is the filtered D-Bus proxy
# `qos-launcher` spawns per-sandbox so an app that declares
# `[sandbox.portals] X = "via-host"` reaches only the portal + fd.o
# notifications + MPRIS interfaces on the session bus (instead of the
# full bus surface). Without this package the launcher logs a warning
# and falls back to a direct bind of the raw session bus — degraded
# security, no functional regression.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    bubblewrap \
    flatpak \
    xdg-dbus-proxy \
    distrobox \
    podman \
    foot \
    wl-clipboard \
    NetworkManager \
    fuse3 \
    cage \
    && dnf clean all

# xdg-desktop-portal — the frontend that proxies sandboxed-app
# capability requests (FileChooser, ScreenCast, Camera) to our
# qOS backend (Sandbox Phase 4.3).
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    xdg-desktop-portal \
    && dnf clean all

# ---------------------------------------------------------------------------
# OS infrastructure (C2-C8)
# ---------------------------------------------------------------------------
# C2 time sync (chrony), C3 zram swap (zram-generator), C4 locale data,
# C5 firewall (firewalld), C7 bluetooth (bluez), C8 power (power-profiles-daemon).
# Audio (C6) reuses the pipewire stack installed above.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    chrony \
    zram-generator \
    glibc-langpack-en \
    firewalld \
    bluez \
    power-profiles-daemon \
    && dnf clean all

# Ensure system groups exist in /etc/group and add greetd to them
RUN (getent group video || echo "video:x:39:greetd" >> /etc/group) && \
    (getent group input || echo "input:x:104:greetd" >> /etc/group) && \
    sed -i 's/^video:x:39:$/video:x:39:greetd/' /etc/group && \
    sed -i 's/^input:x:104:$/input:x:104:greetd/' /etc/group

# Fonts
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    google-noto-sans-fonts \
    google-noto-sans-mono-fonts \
    && dnf clean all

# Wayland runtime libraries (needed by compositor)
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    wayland-devel \
    libxkbcommon-devel \
    libinput-devel \
    && dnf clean all

# ---------------------------------------------------------------------------
# Compiled qOS binaries (built in the `builder` stage above)
# ---------------------------------------------------------------------------
# Compositor
COPY --from=builder /out/shell /usr/bin/shell
# FUSE driver
COPY --from=builder /out/fs /usr/bin/fs
# System apps
COPY --from=builder /out/terminal /usr/bin/terminal
COPY --from=builder /out/file-explorer /usr/bin/file-explorer
# Browser: chrome over the ui toolkit's WebView widget, engine = WPE WebKit
# (built in the wpe-builder stage; its libs + WebProcess binaries are copied
# into this rootfs below). Copied as the contents of /out/optional/ because the
# browser is omitted under QOS_WITH_BROWSER=0, and that leaves the directory
# empty rather than leaving this COPY pointing at a path that does not exist.
COPY --from=builder /out/optional/ /usr/bin/
# Graphical login greeter (ui-toolkit based). Launched at the greetd VT inside
# `cage` — see etc/greetd/config.toml.
COPY --from=builder /out/qos-greeter /usr/bin/qos-greeter
# Graphical installer. Primarily consumed by the layered installer image
# (Containerfile.installer); bundled here so it no longer needs a host build.
COPY --from=builder /out/qos-installer /usr/bin/qos-installer
# App launcher + runtime-bundle CLI. `qos-launcher` is what actually
# execs installed / declared packages inside their bwrap sandbox;
# `qos-runtime-bundle` is the CLI over the same crate that produced
# the baked bundle at image-build time — shipping it lets operators
# `verify` or extend the bundle from a running system.
COPY --from=builder /out/qos-launcher /usr/bin/qos-launcher
COPY --from=builder /out/qos-runtime-bundle /usr/bin/qos-runtime-bundle
COPY --from=builder /out/qos-power /usr/bin/qos-power
# The session-unlock verify helper: the compositor spawns it while the session
# is locked to verify the user's password via PAM (see os/etc/pam.d/qos-unlock).
# It lives under /usr/libexec (not on $PATH) since only the compositor invokes
# it, and matches the compositor's DEFAULT_UNLOCK_HELPER path.
COPY --from=builder /out/qos-unlock-helper /usr/libexec/qos-unlock-helper
RUN chmod 755 /usr/bin/shell /usr/bin/fs /usr/bin/terminal \
              /usr/bin/file-explorer /usr/bin/qos-greeter \
              /usr/bin/qos-installer /usr/bin/qos-launcher /usr/bin/qos-runtime-bundle \
              /usr/bin/qos-power /usr/libexec/qos-unlock-helper \
    && { [ ! -e /usr/bin/browser ] || chmod 755 /usr/bin/browser; }

# ---- WPE WebKit runtime (browser engine) ------------------------------------
# Engine libraries + the WebKit helper processes (WPEWebProcess,
# WPENetworkProcess) from the wpe-builder stage, plus the runtime libraries
# the engine links that aren't already in this image. GStreamer base/good are
# installed above.
#
# This list has to cover every DT_NEEDED entry of libWPEWebKit-2.0.so or the
# browser dies at exec with a loader error. atk/at-spi2-atk/libmanette/libxslt
# are there because the engine is built with accessibility, gamepad and XSLT
# support; they arrive via no other package in this image.
#
# Copies nothing under QOS_WITH_BROWSER=0 (the stage is an empty /wpe then). The
# dnf list below still runs: those are ordinary frozen-repo packages that cost
# seconds, and installing them either way keeps the two images' package sets —
# and this layer's cache entry — identical.
COPY --from=wpe-builder /wpe/ /
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    libepoxy \
    libsoup3 \
    enchant2 \
    hyphen \
    woff2 \
    lcms2 \
    openjpeg2 \
    libavif \
    libwebp \
    libgcrypt \
    libtasn1 \
    libsecret \
    gstreamer1-plugins-bad-free \
    atk \
    at-spi2-atk \
    libmanette \
    libxslt \
    && dnf clean all \
    && ldconfig

# ---- Baked signed runtime bundle -------------------------------------------
# The builder stage produced a signed content-addressed bundle from THIS
# image's own rootfs at /out/qos-runtime-bundle-tree/${RUNTIME_VERSION}
# and wrote its publisher pubkey to /out/runtime-bundle-publisher.hex.
# Install both here so:
#   * The launcher's `/usr/lib/qos-runtime/<v>/` lookup succeeds out
#     of the box — no `qos-install runtime install --from-host` needed
#     after first boot.
#   * The signature check the launcher performs before every mount
#     accepts this bake (the pubkey is the trust root).
COPY --from=builder /out/qos-runtime-bundle-tree/ /usr/lib/qos-runtime/
COPY --from=builder /out/runtime-bundle-publisher.hex /usr/share/qos/runtime-bundle-publisher.hex
# Trust list read by the launcher — one hex pubkey per line, `#` for
# comments. The baked publisher is the only entry by default; operators
# can extend it via `echo <hex> >> /etc/qos/runtime-bundle-trusted-publishers.txt`.
RUN mkdir -p /etc/qos \
    && cat /usr/share/qos/runtime-bundle-publisher.hex \
        > /etc/qos/runtime-bundle-trusted-publishers.txt

# FUSE mount service
COPY os/usr/lib/systemd/system/fs.service /usr/lib/systemd/system/fs.service
# The capability list that mount enforces. Shipped read-only under /usr;
# tmpfiles.d copies it to /var/lib/qos on first boot, where it can be
# edited and survives image updates. See fs.service for why the subject
# is a principal rather than a key.
COPY os/usr/share/qos/fs-capabilities.json /usr/share/qos/fs-capabilities.json

# Wayland session desktop entries. Two files land here:
#   - shell.desktop          — default session (no peer-sync)
#   - shell-peer-sync.desktop — opt-in session (libp2p enabled)
# tuigreet lists both at the login prompt; see docs/peer-sync.md.
COPY os/usr/share/wayland-sessions/shell.desktop /usr/share/wayland-sessions/shell.desktop
COPY os/usr/share/wayland-sessions/shell-peer-sync.desktop /usr/share/wayland-sessions/shell-peer-sync.desktop

# Default compositor config
COPY os/etc/qos/desktop.toml /etc/qos/desktop.toml

# greetd display manager config
COPY os/etc/greetd/config.toml /etc/greetd/config.toml

# PAM stack for the greetd auth service (adds tolerant pam_fprintd so a
# fingerprint can satisfy login; falls back to password-auth).
COPY os/etc/pam.d/greetd /etc/pam.d/greetd
# PAM stack for in-session unlock (qos-unlock-helper). Auth + account only.
COPY os/etc/pam.d/qos-unlock /etc/pam.d/qos-unlock

# polkit rule authorising the greeter's Reboot / Shut down buttons. Lets the
# `greetd` user issue org.freedesktop.login1.{reboot,power-off} via logind
# from the pre-login screen (see the rule's header for the rationale).
COPY os/etc/polkit-1/rules.d/49-qos-greeter-power.rules /etc/polkit-1/rules.d/49-qos-greeter-power.rules

# --- Signing trust roots (security plan §9 image signing, §4 measured boot) ---
# Public keys only (the private keys are git-excluded; see keys/README.md).
#  - cosign.pub verifies the OS image signature before `bootc upgrade` applies
#    it (policy.json below). CI signs each pushed image (see .forgejo/workflows).
#  - tpm2-pcr-signing.public.pem is the trust root for SIGNED PCR policies, and
#    nothing reads it yet. LUKS binds to PCR 7 (the Secure Boot policy) because
#    that value is stable across OS updates; binding to PCR 4 — the boot
#    artefacts themselves — needs a signed prediction, or every update would
#    break the seal. This key is what such a prediction would verify against.
#    See docs/secure-boot.md.
COPY keys/cosign.pub /usr/share/qos/cosign.pub
COPY keys/tpm2-pcr-signing.public.pem /usr/share/qos/tpm2-pcr-signing.public.pem

# Container signature policy: REQUIRE a valid cosign signature for
# code.podesta.ai/qos/qos (everything else stays permissive), so a tampered or
# unsigned OS image is refused at `bootc upgrade`. registries.d points the
# verifier at cosign's sigstore attachment in the same repo.
COPY os/etc/containers/policy.json /etc/containers/policy.json
COPY os/etc/containers/registries.d/code.podesta.ai.yaml /etc/containers/registries.d/code.podesta.ai.yaml

# First-boot setup service
COPY os/usr/lib/systemd/system/shell-firstboot.service /usr/lib/systemd/system/shell-firstboot.service
COPY os/usr/lib/systemd/system/qos-power.service /usr/lib/systemd/system/qos-power.service

