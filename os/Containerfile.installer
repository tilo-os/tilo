# qOS CUSTOM installer image.
#
# Layered on top of the already-built qOS desktop image (localhost/qos:latest),
# this adds the qOS-branded graphical installer and the OS plumbing that makes a
# live medium self-install the booted image to a target disk. This is the only
# installer path; the Anaconda ISO it used to sit beside was scaffolding from
# before this existed and has been removed.
#
# Build context is the os/ dir (see os/dev/build-custom-installer.sh):
#     podman build -t localhost/qos-installer:latest -f os/Containerfile.installer os/
FROM localhost/qos:latest

ARG QOS_INSTALLER_DEV_SSH=0

# The graphical installer UI (a ui::App; staged into os/ by
# build-custom-installer.sh — either the real release binary or a --stub-ui
# placeholder for testing OS plumbing without the toolkit).
COPY qos-installer /usr/bin/qos-installer
RUN chmod 755 /usr/bin/qos-installer

# Privileged install + power backends + greetd session selector + first-boot
# user setup.
COPY usr/libexec/qos-install /usr/libexec/qos-install
COPY usr/libexec/qos-power /usr/libexec/qos-power
COPY usr/libexec/qos-session-select /usr/libexec/qos-session-select
COPY usr/libexec/qos-firstboot-user /usr/libexec/qos-firstboot-user
RUN chmod 755 /usr/libexec/qos-install \
              /usr/libexec/qos-power \
              /usr/libexec/qos-session-select \
              /usr/libexec/qos-firstboot-user

# systemd units: first-boot user creation (runs on the INSTALLED system) and
# live-medium sudoers setup (runs only when qos.installer is on the cmdline).
COPY usr/lib/systemd/system/qos-firstboot-user.service /usr/lib/systemd/system/qos-firstboot-user.service
COPY usr/lib/systemd/system/qos-installer-setup.service /usr/lib/systemd/system/qos-installer-setup.service

# Inactive-until-runtime sudoers rule (qos-installer-setup.service installs it).
COPY usr/share/qos/installer-sudoers /usr/share/qos/installer-sudoers

# Live-medium SELinux module (qos-installer-setup.service `semodule -i`s it at
# boot): lets the greeter session domain launch the privileged install backend
# as a transient system unit, so the live medium can boot SELinux-ENFORCING
# instead of enforcing=0. See os/usr/share/qos/selinux/qos-installer.cil.
COPY usr/share/qos/selinux/qos-installer.cil /usr/share/qos/selinux/qos-installer.cil

# Keep the normal installed-system greeter config available outside /etc, then
# point the live medium at the installer selector. qos-install restores the
# normal config into the target deployment's writable /etc before first boot.
COPY etc/greetd/config.toml /usr/share/qos/greetd-config.toml
COPY etc/greetd/config.installer.toml /etc/greetd/config.toml

# `qos.installer=1` — the one thing that distinguishes the live medium from a
# normal install:
#   * qos-session-select sees it and launches the installer, not the greeter.
#   * qos-install refuses to run without it (a safety guard).
#   * qos-installer-setup.service (ConditionKernelCommandLine=qos.installer)
#     drops in the passwordless sudoers rule only here.
# qos-install explicitly deletes this argument from the target deployment, so
# the installed system boots the normal greeter rather than re-entering setup.
#
# It belongs to the image rather than to the disk-image step. It used to be
# bootc-image-builder's `[customizations.kernel] append` in os/installer-disk.toml,
# which reached only that one build path — and could not reach a sealed image at
# all, since a UKI's command line is signed at build time. /usr/lib/bootc/kargs.d
# is read by every install path AND by `bootc container ukify`, so the same two
# lines put the argument on an unsealed command line today and inside the signed,
# measured one the moment this image grows a UKI.
RUN printf 'kargs = ["qos.installer=1"]\n' \
      > /usr/lib/bootc/kargs.d/50-installer.toml

# Enable the two new units. greetd / graphical.target are already enabled by
# the base qOS image.
RUN systemctl enable qos-firstboot-user.service qos-installer-setup.service

# Release media have no remote-login surface. A developer can opt in while
# building a local diagnostic image, paired with an explicitly supplied
# non-default password in build-custom-installer.sh.
RUN if [ "$QOS_INSTALLER_DEV_SSH" = 1 ]; then \
      systemctl unmask sshd.service && systemctl enable sshd.service; \
    else \
      systemctl disable sshd.service 2>/dev/null || true; \
      systemctl mask sshd.service; \
    fi

# Validate the layered image.
RUN bootc container lint
