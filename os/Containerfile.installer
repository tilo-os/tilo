# Tilo custom installer image.
#
# Layered on top of the already-built Tilo Desktop image (localhost/tilo:latest),
# this adds the graphical installer and the OS plumbing that makes a live medium
# self-install the booted image to a target disk.
#
# build-custom-installer.sh assembles an exact rootfs overlay as the context.
ARG TILO_BASE_IMAGE=localhost/tilo:latest
FROM ${TILO_BASE_IMAGE}

ARG TILO_INSTALLER_DEV_SSH=0

# One layer contains the graphical installer, privileged backends, live/target
# units, validated-profile extractor, SELinux policy, sudoers source, and both
# live and installed greetd configurations. The staging script assigns their
# final paths and modes before Podman sees the context.
COPY rootfs/ /

# `tilo.install` — the one thing that distinguishes the live medium from a
# normal install:
#   * tilo-session-select sees it and launches the installer, not the greeter.
#   * tilo-install refuses to run without it (a safety guard).
#   * tilo-installer-setup.service (ConditionKernelCommandLine=tilo.install)
#     drops in the passwordless sudoers rule only here.
# tilo-install explicitly deletes this argument from the target deployment, so
# the installed system boots the normal greeter rather than re-entering setup.
#
# It belongs to the image rather than to the disk-image step. It used to be
# bootc-image-builder's `[customizations.kernel] append` in os/installer-disk.toml,
# which reached only that one build path — and could not reach a sealed image at
# all, since a UKI's command line is signed at build time. /usr/lib/bootc/kargs.d
# is read by every install path AND by `bootc container ukify`, so the same two
# lines put the argument on an unsealed command line today and inside the signed,
# measured one the moment this image grows a UKI.
# Enable the new units, apply the live-only kernel argument, remove the remote
# login surface from release media, and validate the result in one final layer.
# A developer can opt in to SSH only for a local diagnostic image paired with
# the explicit non-default password required by build-custom-installer.sh.
# The installed target is copied from this image. Refuse a release whose
# manual postboot enlist command or firmware utility was omitted.
RUN test -x /usr/libexec/tilo/tilo-installer \
    && test -x /usr/libexec/tilo-session-select \
    && test -x /usr/libexec/tilo-cage-session \
    && test -x /usr/libexec/tilo-boot-order \
    && command -v efibootmgr >/dev/null \
    && printf 'kargs = ["tilo.install"]\n' \
      > /usr/lib/bootc/kargs.d/50-installer.toml \
    # Keep tilo.mode=normal: tilo-deployment derives the equal-width repair UKI
    # from it. Error-only kernel/udev logging and Plymouth already keep boot
    # clean. Dropping the redundant explicit systemd default and the udev log
    # overrides (quiet already covers them) reserves enough measured .cmdline
    # space for the target-only boot mount without giving up the quiet splash.
    && /usr/libexec/tilo-uki-cmdline remove systemd.show_status \
    && /usr/libexec/tilo-uki-cmdline remove rd.udev.log_level \
    && /usr/libexec/tilo-uki-cmdline remove loglevel \
    && /usr/libexec/tilo-uki-cmdline remove vt.global_cursor_default \
    # Refuse a malformed base before deriving either signed UKI. Both variants
    # inherit the target-independent root and unlock discovery contract.
    && live_cmdline="$(/usr/libexec/tilo-uki-cmdline show)" \
    && test "$(printf '%s\n' "$live_cmdline" | tr '[:space:]' '\n' | grep -E '^root(=|$)')" = root=tilo-auto \
    && test "$(printf '%s\n' "$live_cmdline" | tr '[:space:]' '\n' | grep -E '^rd[.]luks[.]options(=|$)')" = rd.luks.options=tpm2-device=auto,fido2-device=auto \
    # Live media and installed targets use the same target-independent root
    # discovery contract.  The boot ESP identifies the physical disk and the
    # dedicated Tilo GPT type identifies its root, so no per-machine UUID or
    # inert placeholder belongs in either signed UKI.
    && /usr/libexec/tilo-uki-cmdline append tilo.install \
    # Keep a deterministic installed-target UKI outside bootc's EFI scan path.
    # It seals the same composefs tree but contains no live marker or device UUID.
    && install -d -m 0755 /boot/tilo-target/predictions \
    # Reject ambiguous live UKI trees instead of depending on traversal order.
    && set -- /boot/EFI/Linux/*.efi \
    && [ "$#" -eq 1 ] && [ -f "$1" ] \
    && cp "$1" /boot/tilo-target/tilo-target.efi \
    && /usr/libexec/tilo-uki-cmdline remove tilo.install /boot/tilo-target/tilo-target.efi \
    # The encrypted installer creates a dedicated ext4 /boot with this unique
    # label.  Keep it in the signed target UKI: bootc's composefs Type2 path
    # cannot synthesize per-machine kernel arguments during installation.
    && /usr/libexec/tilo-uki-cmdline append systemd.mount-extra=LABEL=TILO_BOOT:/boot:ext4:ro,nosuid,nodev,noexec /boot/tilo-target/tilo-target.efi \
    && target_cmdline="$(/usr/libexec/tilo-uki-cmdline show /boot/tilo-target/tilo-target.efi)" \
    && test "$(printf '%s\n' "$target_cmdline" | tr '[:space:]' '\n' | grep -E '^root(=|$)')" = root=tilo-auto \
    && test "$(printf '%s\n' "$target_cmdline" | tr '[:space:]' '\n' | grep -E '^rd[.]luks[.]options(=|$)')" = rd.luks.options=tpm2-device=auto,fido2-device=auto \
    && /usr/libexec/tilo-uki-cmdline show | grep -qw tilo.mode=normal \
    && /usr/libexec/tilo-uki-cmdline show | grep -qw tilo.install \
    && /usr/libexec/tilo-uki-cmdline show | grep -qw root=tilo-auto \
    && /usr/libexec/tilo-uki-cmdline show /boot/tilo-target/tilo-target.efi | grep -qw root=tilo-auto \
    && /usr/libexec/tilo-uki-cmdline show /boot/tilo-target/tilo-target.efi | grep -qw systemd.mount-extra=LABEL=TILO_BOOT:/boot:ext4:ro,nosuid,nodev,noexec \
    && ! /usr/libexec/tilo-uki-cmdline show /boot/tilo-target/tilo-target.efi | grep -qw tilo.install \
    && systemctl enable tilo-installer-code-refresh.service tilo-firstboot-user.service tilo-firstboot-autologin-cleanup.service tilo-installer-setup.service tilo-live-recovery.service \
    # USB-free installation: recognise a staged installer and grow its root on
    # the live side (both conditioned on tilo.install), and reclaim the staging
    # partitions once on the installed system (conditioned on its record).
    && systemctl enable tilo-staging-handoff.service tilo-installer-grow-root.service tilo-staging-reclaim.timer \
    && if [ "$TILO_INSTALLER_DEV_SSH" = 1 ]; then \
         systemctl unmask sshd.service && systemctl enable sshd.service; \
       else \
         systemctl disable sshd.service 2>/dev/null || true; \
         systemctl mask sshd.service; \
       fi \
    && bootc container lint
