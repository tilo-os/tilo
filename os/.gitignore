# Binary artifacts some build paths stage here. Produced by
# `cargo build --release -p shell -p fs -p terminal -p browser -p file-explorer`
# and copied in; never commit them.
/shell
/fs
/terminal
/browser
/file-explorer
/tilo-greeter
# Custom installer UI binary, staged by ./dev/build-custom-installer.sh.
/tilo-installer
# Legacy names from before the tilo rename; kept for hygiene during the
# transition so a stale build doesn't accidentally re-stage them.
/tilo-desktop
/quick-fs-fuse
/quick-terminal
/quick-browser

# disk-image.sh outputs
/output/
/output-*/

# QEMU + first-boot artifacts produced by ./test-vm.sh / ./verify-test.sh
/qemu-*.log
/test-boot*.log
/test-results.log
*.log

# Captured VM journals (verify-test.sh dumps these to /vm-logs* on the host)
/vm-logs/
/vm-logs-*/
