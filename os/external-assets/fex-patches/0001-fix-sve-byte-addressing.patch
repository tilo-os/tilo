+
+; Masked element loads/stores must use byte addresses, independent of both
+; host vector length and the SVE word/doubleword register-offset scale.
+mov rdx, 0xe0000200
+%assign slot 0
+%rep 128
+  mov rax, 0x1111000000000000 + slot
+  mov [rdx - 256 + slot * 8], rax
+%assign slot slot + 1
+%endrep
+vmovups ymm15, [rel .mask]
+vmaskmovps ymm0, ymm15, [rdx + 32]
+vmaskmovps ymm1, ymm15, [rdx - 32]
+vmaskmovpd ymm2, ymm15, [rdx + 64]
+vmaskmovpd ymm3, ymm15, [rdx - 64]
+vmaskmovps xmm4, xmm15, [rdx + 16]
+vmaskmovpd xmm5, xmm15, [rdx - 16]
+mov rcx, 32
+vmaskmovps ymm6, ymm15, [rdx + rcx]
+
+mov rdi, 0xe0000800
+vmaskmovps [rdi + 32], ymm15, ymm0
+vmaskmovps [rdi - 32], ymm15, ymm1
+vmaskmovpd [rdi + 64], ymm15, ymm2
+vmaskmovpd [rdi - 64], ymm15, ymm3
+vmaskmovps [rdi + 128], xmm15, xmm4
+mov rax, [rdi + 32]
+mov rbx, [rdi + 56]
+mov rcx, [rdi - 32]
+mov r8, [rdi - 8]
+mov r9, [rdi + 64]
+mov r10, [rdi + 88]
+mov r11, [rdi - 64]
+mov r12, [rdi - 40]
+mov r13, [rdi + 128]
+mov r14, [rdi + 136]
+hlt
+
+align 32
+.mask:
+dq -1, -1, -1, -1
