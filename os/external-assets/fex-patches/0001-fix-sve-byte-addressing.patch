+mov rax, [rdi + 16]
+mov rbx, [rdi + 24]
+mov rcx, [rdi + 32]
+mov r8, [rdi + 56]
+mov r9, [rdi - 16]
+mov r10, [rdi - 8]
+mov r11, [rdi - 64]
+mov r12, [rdi - 40]
+hlt
