+/// Use the ESP that the to-filesystem caller mounted under its target. Merely
+/// choosing the first ESP on the root disk can write an unrelated operating
+/// system's boot partition when the disk has more than one ESP.
+fn esp_for_install(root_setup: &RootSetup) -> Result<bootc_blockdev::Device> {
+    if root_setup.target_root_path.is_none() {
+        return root_setup.device_info.find_first_colocated_esp();
+    }
+
+    let esp_dir = root_setup
+        .physical_root
+        .open_dir("boot/efi")
+        .context("Opening target /boot/efi")?;
+    if esp_dir.is_mountpoint(".")? != Some(true) {
+        bail!("Target /boot/efi must be a separate mounted ESP");
+    }
+    let selected =
+        bootc_blockdev::list_dev_by_dir(&esp_dir).context("Identifying mounted target ESP")?;
+    if !selected
+        .parttype
+        .as_deref()
+        .is_some_and(|t| t.eq_ignore_ascii_case(bootc_blockdev::ESP))
+        || selected.partuuid.as_deref().is_none_or(str::is_empty)
+    {
+        bail!("Target /boot/efi is not a GPT EFI System Partition");
+    }
+    let root_disks = root_setup.device_info.find_all_roots()?;
+    let esp_disks = selected.find_all_roots()?;
+    if !esp_disks.iter().any(|esp_disk| {
+        esp_disk.maj_min.as_ref().is_some_and(|id| {
+            root_disks
+                .iter()
+                .any(|root_disk| root_disk.maj_min.as_ref() == Some(id))
+        })
+    }) {
+        bail!("Mounted target ESP is not on a disk backing the target root");
+    }
+    Ok(selected)
+}
