+                    let inspect = conn_src
+                        .inspect(handle_src, &image.to_string())
+                        .await
+                        .context("zlink transport error calling Inspect")?
+                        .map_err(|e| anyhow::anyhow!("Inspect failed: {e:?}"))?;
+                    let diff_ids =
+                        composefs_oci::extract_layer_ids(&inspect.manifest, &inspect.config)
+                            .context("extracting layer identifiers")?
+                            .iter()
+                            .map(|id| id.parse())
+                            .collect::<std::result::Result<Vec<composefs_oci::OciDigest>, _>>()
+                            .context("parsing layer identifiers")?;
+                    let copied = composefs_oci::layer_copy::copy_layers_by_object_id(
