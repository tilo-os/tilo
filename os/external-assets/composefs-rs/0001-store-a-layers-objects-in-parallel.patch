+/// How many objects one layer's drain stores at once. Storing an object is a
+/// copy and an fs-verity enable, and enabling fs-verity first writes the file
+/// out, so stored one at a time a layer of many files waits on each write in
+/// turn.
+fn object_store_workers() -> usize {
+    std::thread::available_parallelism().map_or(4, |n| n.get()).clamp(2, 8)
+}
+
+/// What the drain owes the splitstream, in stream order, while objects ahead
+/// of it are still being stored.
+enum Pending<ObjectID> {
+    Inline(Vec<u8>),
+    Object {
+        size: u64,
+        name: String,
+        stored: std::sync::mpsc::Receiver<Result<(ObjectID, ObjectStoreMethod)>>,
+    },
+}
+
+/// One object for a store worker, and where its result goes.
+type StoreJob<ObjectID> = (
+    std::fs::File,
+    u64,
+    bool,
+    std::sync::mpsc::SyncSender<Result<(ObjectID, ObjectStoreMethod)>>,
+);
+
+/// The splitstream's next bytes: written now when nothing is pending ahead of
+/// them, queued behind the pending objects otherwise.
+fn emit_inline<ObjectID>(
+    writer: &mut SplitStreamWriter<ObjectID>,
+    pending: &mut std::collections::VecDeque<Pending<ObjectID>>,
+    data: &[u8],
+) where
+    ObjectID: FsVerityHashValue,
+{
+    if pending.is_empty() {
+        writer.write_inline(data);
+    } else {
+        pending.push_back(Pending::Inline(data.to_vec()));
+    }
+}
+
+/// Write the oldest pending entry into the splitstream, waiting for its object
+/// to be stored if it is one.
+fn write_oldest<ObjectID: FsVerityHashValue>(
+    writer: &mut SplitStreamWriter<ObjectID>,
+    pending: &mut std::collections::VecDeque<Pending<ObjectID>>,
+    stats: &mut ImportStats,
+) -> Result<()> {
+    match pending.pop_front() {
+        None => Ok(()),
+        Some(Pending::Inline(data)) => {
+            writer.write_inline(&data);
+            Ok(())
+        }
+        Some(Pending::Object { size, name, stored }) => {
+            let (object_id, method) = stored
+                .recv()
+                .context("an object store worker stopped")?
+                .with_context(|| format!("Failed to store object for {name}"))?;
+            record_stored(stats, method, size);
+            writer.add_external_size(size);
+            writer.write_reference(object_id)
+        }
+    }
+}
+
+fn record_stored(stats: &mut ImportStats, method: ObjectStoreMethod, size: u64) {
+    match method {
+        ObjectStoreMethod::Reflinked => {
+            stats.objects_reflinked += 1;
+            stats.bytes_reflinked += size;
+        }
+        ObjectStoreMethod::Hardlinked => {
+            stats.objects_hardlinked += 1;
+            stats.bytes_hardlinked += size;
+        }
+        ObjectStoreMethod::Copied => {
+            stats.objects_copied += 1;
+            stats.bytes_copied += size;
+        }
+        ObjectStoreMethod::AlreadyPresent => {
+            stats.objects_already_present += 1;
+        }
+    }
+}
+
