From 9cb125a34b6e09b1f37740508113731df2dde2fb Mon Sep 17 00:00:00 2001
From: qwolff <quinten@tilo.so>
Date: Wed, 28 Oct 2026 11:47:48 -0700
Subject: [PATCH] cryptbase: Size the random buffer for every processor.

SystemInterruptInformation fails with STATUS_INFO_LENGTH_MISMATCH unless
the buffer holds one entry per processor, but the buffer was capped at
256 entries. On hosts with more than 256 logical processors every
RtlGenRandom call failed, and with it BCryptGenRandom and ProcessPrng.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=54364
---
 dlls/cryptbase/cryptbase_main.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/dlls/cryptbase/cryptbase_main.c b/dlls/cryptbase/cryptbase_main.c
index 3a79744..fd2de37 100644
--- a/dlls/cryptbase/cryptbase_main.c
+++ b/dlls/cryptbase/cryptbase_main.c
@@ -34,17 +34,20 @@ static CRITICAL_SECTION_DEBUG random_debug =
 };
 static CRITICAL_SECTION random_cs = { &random_debug, -1, 0, 0, 0, 0 };
 
-#define MAX_CPUS 256
-static char random_buf[sizeof(SYSTEM_INTERRUPT_INFORMATION) * MAX_CPUS];
+static char *random_buf;
 static ULONG random_len;
 static ULONG random_pos;
 
 /* FIXME: assumes interrupt information provides sufficient randomness */
 static BOOL fill_random_buffer(void)
 {
-    ULONG len = sizeof(SYSTEM_INTERRUPT_INFORMATION) * min( NtCurrentTeb()->Peb->NumberOfProcessors, MAX_CPUS );
+    ULONG len = sizeof(SYSTEM_INTERRUPT_INFORMATION) * NtCurrentTeb()->Peb->NumberOfProcessors;
     NTSTATUS status;
 
+    /* The query fails unless the buffer covers every processor. */
+    if (!random_buf && !(random_buf = RtlAllocateHeap( NtCurrentTeb()->Peb->ProcessHeap, 0, len )))
+        return FALSE;
+
     if ((status = NtQuerySystemInformation( SystemInterruptInformation, random_buf, len, NULL )))
     {
         WARN( "failed to get random bytes, status %#lx\n", status );
