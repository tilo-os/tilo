From: Tilo <noreply@tilo.so>
Subject: [PATCH] composefs: boot entries survive a power cut

bootc writes a boot entry, a UKI or a grub configuration and then fsyncs the
directory that holds it. That makes the directory durable, not the file's
contents: on the ESP's FAT filesystem the entry's data stays in the page
cache until writeback, about half a minute later. A machine that loses power
in that time (a board with no shutdown button, an update staged just before a
power cut) boots with an entry that has a name and no contents, and from then
on every `bootc status` fails on it ("Parsing bls config: Missing 'version'
value"), so neither the next update nor a fallback can run.

Each of those syncs now flushes the whole boot filesystem (syncfs), which
writes the files' contents along with their directory. The boot filesystems
are small and these syncs happen once per update, rollback or finalize.
---
--- a/crates/lib/src/bootc_composefs/backwards_compat/bcompat_boot.rs
+++ b/crates/lib/src/bootc_composefs/backwards_compat/bcompat_boot.rs
@@ -26,7 +26,7 @@ use cap_std_ext::{cap_std::fs::Dir, dirext::CapStdExtDirExt};
 use composefs_ctl::composefs_boot::bootloader::{EFI_ADDON_DIR_EXT, EFI_EXT};
 use fn_error_context::context;
 use ocidir::cap_std::ambient_authority;
-use rustix::fs::{RenameFlags, fsync, renameat_with};
+use rustix::fs::{RenameFlags, syncfs, renameat_with};
 
 /// Represents a pending rename operation to be executed atomically
 #[derive(Debug)]
@@ -244,7 +244,7 @@ fn create_staged_bls_entries(boot_dir: &Dir, entries: &Vec<(String, BLSConfig)>)
         staged_entries.atomic_write(filename, new_entry.to_string().as_bytes())?;
     }
 
-    fsync(staged_entries.reopen_as_ownedfd()?).context("fsync")
+    syncfs(staged_entries.reopen_as_ownedfd()?).context("syncfs")
 }
 
 fn get_boot_type(storage: &Storage, cfs_cmdline: &ComposefsCmdline) -> Result<BootType> {
@@ -303,7 +303,7 @@ fn handle_bls_conf(
         .execute_transaction(&binaries_dir)
         .context("Failed to execute EFI binary rename transaction")?;
 
-    fsync(binaries_dir.reopen_as_ownedfd()?)?;
+    syncfs(binaries_dir.reopen_as_ownedfd()?)?;
 
     let loader_dir = boot_dir.open_dir("loader").context("Opening loader dir")?;
     rename_exchange_bls_entries(&loader_dir)?;
@@ -384,7 +384,7 @@ pub(crate) async fn prepend_custom_prefix(
                     .execute_transaction(&uki_dir)
                     .context("Failed to execute EFI binary rename transaction")?;
 
-                fsync(uki_dir.reopen_as_ownedfd()?)?;
+                syncfs(uki_dir.reopen_as_ownedfd()?)?;
                 rename_exchange_user_cfg(&grub_dir)?;
             }
 
