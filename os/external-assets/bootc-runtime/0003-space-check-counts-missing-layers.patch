     // Pre-flight disk space check before pulling.
-    crate::deploy::check_disk_space_composefs(&*booted_cfs.repo, manifest, imgref)?;
+    crate::deploy::check_disk_space_composefs(&*booted_cfs.repo, img, imgref)?;
 
