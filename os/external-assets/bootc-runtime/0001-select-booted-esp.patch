+    #[test]
+    fn test_select_booted_esp_on_shared_disk() {
+        let roots = [shared_disk()];
+        let esp = select_colocated_esp(&roots, Some("2DBC5C51-A046-4266-A3EF-4256B25CDD1D"))
+            .unwrap()
+            .unwrap();
+        assert_eq!(esp.name, "nvme0n1p4");
+        // Without the loader variable: the first ESP, as before.
+        let esp = select_colocated_esp(&roots, None).unwrap().unwrap();
+        assert_eq!(esp.name, "nvme0n1p1");
+        // A loader partition UUID that is not an ESP here selects nothing by UUID.
+        let esp = select_colocated_esp(&roots, Some("fa6ad2c9-bd0e-4780-9d68-324b93376d01"))
+            .unwrap()
+            .unwrap();
+        assert_eq!(esp.name, "nvme0n1p1");
+    }
+
+    #[test]
+    fn test_parse_loader_device_partuuid() {
+        let mut raw = vec![0x06, 0, 0, 0];
+        for unit in "2DBC5C51-A046-4266-A3EF-4256B25CDD1D\0".encode_utf16() {
+            raw.extend_from_slice(&unit.to_le_bytes());
+        }
+        assert_eq!(
+            parse_loader_device_partuuid(&raw).as_deref(),
+            Some("2dbc5c51-a046-4266-a3ef-4256b25cdd1d")
+        );
+        assert_eq!(parse_loader_device_partuuid(&[0x06, 0, 0, 0]), None);
+        assert_eq!(parse_loader_device_partuuid(&[]), None);
+    }
