+/// `LoaderDevicePartUUID` in the Boot Loader Interface vendor namespace.
+const LOADER_DEVICE_PARTUUID_EFIVAR: &str =
+    "/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f";
+
+/// The partition UUID of the ESP the boot loader was started from, if the
+/// loader recorded it.
+fn loader_device_partuuid() -> Option<String> {
+    let raw = match std::fs::read(LOADER_DEVICE_PARTUUID_EFIVAR) {
+        Ok(raw) => raw,
+        Err(e) => {
+            tracing::debug!("No LoaderDevicePartUUID: {e}");
+            return None;
+        }
+    };
+    let partuuid = parse_loader_device_partuuid(&raw);
+    tracing::debug!("LoaderDevicePartUUID: {partuuid:?}");
+    partuuid
+}
+
+/// Decode an efivarfs `LoaderDevicePartUUID`: four attribute bytes, then the
+/// UUID as NUL-terminated UTF-16LE.
+fn parse_loader_device_partuuid(raw: &[u8]) -> Option<String> {
+    let units: Vec<u16> = raw
+        .get(4..)?
+        .chunks_exact(2)
+        .map(|c| u16::from_le_bytes([c[0], c[1]]))
+        .take_while(|&u| u != 0)
+        .collect();
+    let value = String::from_utf16(&units).ok()?;
+    let value = value.trim().to_ascii_lowercase();
+    (!value.is_empty()).then_some(value)
+}
+
+/// Pick the ESP among the root devices: the one named by the loader's
+/// partition UUID when one of them carries it, otherwise the first.
+fn select_colocated_esp<'a>(
+    roots: &'a [Device],
+    loader_partuuid: Option<&str>,
+) -> Result<Option<&'a Device>> {
+    if let Some(partuuid) = loader_partuuid {
+        for root in roots {
+            if let Some(esp) = root.find_esp_by_partuuid(partuuid)? {
+                return Ok(Some(esp));
+            }
+        }
+        tracing::debug!("LoaderDevicePartUUID {partuuid} names no ESP backing this device");
+    }
+    for root in roots {
+        if let Some(esp) = root.find_partition_of_esp_optional()? {
+            return Ok(Some(esp));
+        }
+    }
+    Ok(None)
+}
