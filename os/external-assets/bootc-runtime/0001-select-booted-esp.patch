+    /// Find the ESP the running system was booted from among all root
+    /// devices backing this device.
+    ///
+    /// A disk shared with another operating system usually carries that
+    /// system's ESP too, often as its first partition. The boot loader names
+    /// the partition it was started from in `LoaderDevicePartUUID` (the Boot
+    /// Loader Interface systemd-boot implements), and that is the ESP whose
+    /// entries describe this system. Without the variable, or when it names
+    /// no ESP backing this device, this is [`Self::find_first_colocated_esp`].
+    pub fn find_booted_colocated_esp(&self) -> Result<Device> {
+        let roots = self.find_all_roots()?;
+        select_colocated_esp(&roots, loader_device_partuuid().as_deref())?
+            .cloned()
+            .ok_or_else(|| anyhow!("No ESP partition found among backing devices"))
+    }
+
+    /// Find a descendant EFI System Partition with this partition UUID.
+    fn find_esp_by_partuuid(&self, partuuid: &str) -> Result<Option<&Device>> {
+        let Some(children) = self.children.as_ref() else {
+            return Ok(None);
+        };
+        let mbr = match self.pttype.as_deref() {
+            Some("dos") => true,
+            Some("gpt") | None => false,
+            Some(other) => return Err(anyhow!("Unsupported partition table type: {other}")),
+        };
+        for child in children {
+            let is_esp = child.parttype.as_deref().is_some_and(|pt| {
+                if mbr {
+                    let pt = pt.strip_prefix("0x").unwrap_or(pt);
+                    u8::from_str_radix(pt, 16).is_ok_and(|pt| ESP_ID_MBR.contains(&pt))
+                } else {
+                    pt.eq_ignore_ascii_case(ESP)
+                }
+            });
+            let matches = child
+                .partuuid
+                .as_deref()
+                .is_some_and(|u| u.eq_ignore_ascii_case(partuuid));
+            if is_esp && matches {
+                return Ok(Some(child));
+            }
+            // Firmware RAID: disk -> md array -> partitions.
+            if child.pttype.is_some()
+                && let Some(esp) = child.find_esp_by_partuuid(partuuid)?
+            {
+                return Ok(Some(esp));
+            }
+        }
+        Ok(None)
+    }
+
