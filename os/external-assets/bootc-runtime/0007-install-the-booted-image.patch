+    /// The image this system booted, in the booted composefs repository.
+    #[context("Gathering source info from the booted image")]
+    pub(crate) async fn from_booted(root: &Dir) -> Result<Self> {
+        let storage = crate::cli::get_storage().await?;
+        let crate::store::BootedStorageKind::Composefs(booted) = storage.kind()? else {
+            anyhow::bail!("--source-booted needs a system booted from a composefs image");
+        };
+        let host = crate::bootc_composefs::status::get_composefs_status(&storage, &booted).await?;
+        let entry = host
+            .status
+            .booted
+            .as_ref()
+            .ok_or_else(|| anyhow!("No booted deployment"))?;
+        let image = entry
+            .image
+            .as_ref()
+            .ok_or_else(|| anyhow!("The booted deployment names no image"))?;
+        let verity = &entry.require_composefs()?.verity;
+        let (_, manifest_digest) =
+            crate::bootc_composefs::status::get_imginfo(&storage, verity)?;
+        let manifest_digest = if manifest_digest.starts_with("sha256:") {
+            manifest_digest
+        } else {
+            format!("sha256:{manifest_digest}")
+        };
+        let imageref = ostree_container::ImageReference {
+            transport: ostree_container::Transport::try_from(image.image.transport.as_str())?,
+            name: image.image.image.clone(),
+        };
+        let mut source = Self::new(imageref, Some(manifest_digest), root, false)?;
+        source.composefs_repo = Some(format!(
+            "/{}/{}",
+            crate::store::SYSROOT,
+            crate::store::COMPOSEFS
+        ));
+        Ok(source)
+    }
+
