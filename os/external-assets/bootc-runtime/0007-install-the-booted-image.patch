+/// Copy the image `manifest_digest` names from the composefs repository at
+/// `source_repo` into `repo`, the target's, which is at `repo_path`. Its manifest,
+/// config and layers are copied as they are stored, so the image keeps its manifest
+/// digest; each layer is checked against its diff id on the way in.
+async fn copy_composefs_image(
+    repo: &crate::store::ComposefsRepository,
+    repo_path: &camino::Utf8Path,
+    source_repo: &str,
+    manifest_digest: &str,
+) -> Result<PullResult<Sha512HashValue>> {
+    tracing::info!("Copying {manifest_digest} from the composefs repository {source_repo}");
+    let started = std::time::Instant::now();
+    composefs_ctl::run_from_iter([
+        "--repo".to_owned(),
+        repo_path.as_str().to_owned(),
+        "oci".to_owned(),
+        "copy".to_owned(),
+        format!("@{manifest_digest}"),
+        "--from".to_owned(),
+        source_repo.to_owned(),
+    ])
+    .await
+    .with_context(|| format!("Copying {manifest_digest} from {source_repo}"))?;
+    println!(
+        "Copied the image's layers from {source_repo} in {:.1}s",
+        started.elapsed().as_secs_f64()
+    );
+    let digest: composefs_oci::OciDigest = manifest_digest
+        .parse()
+        .with_context(|| format!("Parsing manifest digest {manifest_digest}"))?;
+    let image = composefs_oci::oci_image::OciImage::open(repo, &digest, None)
+        .context("Opening the copied image")?;
+    Ok(PullResult {
+        manifest_digest: image.manifest_digest().clone(),
+        manifest_verity: image.manifest_verity().clone(),
+        config_digest: image.config_digest().clone(),
+        config_verity: image.config_verity().clone(),
+        stats: Default::default(),
+    })
+}
+
+/// The manifest and config of the image `manifest_digest` names in the composefs
+/// repository at `source_repo`, as an install from that repository copies them.
+pub(crate) fn composefs_image_manifest_and_config(
+    source_repo: &str,
+    manifest_digest: &str,
+) -> Result<crate::bootc_composefs::status::ImgConfigManifest> {
+    let repo = crate::store::ComposefsRepository::open_path(rustix::fs::CWD, source_repo)
+        .with_context(|| format!("Opening the composefs repository {source_repo}"))?;
+    let digest: composefs_oci::OciDigest = manifest_digest
+        .parse()
+        .with_context(|| format!("Parsing manifest digest {manifest_digest}"))?;
+    let image = composefs_oci::oci_image::OciImage::open(&repo, &digest, None)
+        .with_context(|| format!("Opening {manifest_digest} in {source_repo}"))?;
+    let config = image
+        .config()
+        .cloned()
+        .ok_or_else(|| anyhow::anyhow!("{manifest_digest} in {source_repo} has no config"))?;
+    Ok(crate::bootc_composefs::status::ImgConfigManifest {
+        config,
+        manifest: image.manifest().clone(),
+    })
+}
+
 /// Result of pulling a composefs repository, including the OCI manifest digest
 /// needed to reconstruct image metadata from the local composefs repo.
 pub(crate) struct PullRepoResult {
