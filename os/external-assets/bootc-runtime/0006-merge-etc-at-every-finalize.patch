+/// Whether `loader/entries.staged` still holds an entry to exchange with `loader/entries`. An empty
+/// one is not exchanged: that would leave the boot loader nothing to boot.
+fn staged_bls_entries_pending(loader: &Dir) -> Result<bool> {
+    let Some(staged) = loader.open_dir_optional(STAGED_BOOT_LOADER_ENTRIES)? else {
+        return Ok(false);
+    };
+    for entry in staged.entries()? {
+        if entry?.file_name().as_encoded_bytes().ends_with(b".conf") {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
