+/// The tree a deployment's next /etc is built in, beside its `etc`, until the two are exchanged.
+pub const NEXT_ETC: &str = "etc.next";
+
+/// Copies an image's own /etc (`image_etc`, in a mounted image) into `dest`, an existing directory,
+/// as the image has it: owners, modes, extended attributes and times. `.updated` is left out, so
+/// that the services gated on `ConditionNeedsUpdate=/etc` (systemd-sysusers, systemd-tmpfiles) run
+/// at the first boot of the deployment, as ostree arranges it.
+#[context("Copying {image_etc:?} to {dest:?}")]
+pub fn copy_image_etc(image_etc: &Path, dest: &Path) -> anyhow::Result<()> {
+    let output = Command::new("cp")
+        .args(["-a", "--remove-destination"])
+        .arg(image_etc.join("."))
+        .arg(dest.join("."))
+        .output()
+        .context("Starting cp")?;
+    if !output.status.success() {
+        anyhow::bail!(
+            "cp failed ({}): {}",
+            output.status,
+            String::from_utf8_lossy(&output.stderr).trim()
+        );
+    }
+    let dest = CapStdDir::open_ambient_dir(dest, cap_std::ambient_authority())?;
+    dest.remove_file_optional(".updated")
+        .context("Removing .updated")?;
+    Ok(())
+}
+
+/// Gives the deployment whose state directory is `deployment` the /etc it is to boot with: its
+/// image's own /etc (`image_etc`), with every change the running system made to its booted
+/// image's /etc (`pristine_etc`, as `current_etc` has it now) carried over.
+///
+/// It starts from the image's /etc each time instead of merging into the deployment's present
+/// `etc`, so it can be repeated: a merge when the deployment is staged and another when the system
+/// shuts down end as if only the second had been made. A file the running system deleted after
+/// the first is gone after the second too; merging into the first one's result would keep it.
+///
+/// The new tree is built beside `etc`, as [`NEXT_ETC`], written to disk and exchanged with `etc` in
+/// one rename, so a boot after a power loss at any point finds the deployment's previous /etc or
+/// the new one, each whole.
+#[context("Merging /etc into {deployment:?}")]
+pub fn merge_deployment_etc(
+    deployment: &Path,
+    image_etc: &Path,
+    pristine_etc: &CapStdDir,
+    current_etc: &CapStdDir,
+) -> anyhow::Result<()> {
+    let deployment_dir = CapStdDir::open_ambient_dir(deployment, cap_std::ambient_authority())
+        .context("Opening the deployment")?;
+    // What a merge that was cut short left.
+    deployment_dir
+        .remove_all_optional(NEXT_ETC)
+        .context("Removing an unfinished merge")?;
+    deployment_dir.create_dir(NEXT_ETC)?;
+    copy_image_etc(image_etc, &deployment.join(NEXT_ETC))?;
+    let next_etc = deployment_dir.open_dir(NEXT_ETC)?;
+
+    let (pristine_files, current_files, next_files) =
+        traverse_etc(pristine_etc, current_etc, Some(&next_etc))?;
+    let next_files =
+        next_files.ok_or_else(|| anyhow::anyhow!("Failed to get dirtree for new etc"))?;
+    let diff = compute_diff(&pristine_files, &current_files, &next_files)?;
+    merge(current_etc, &current_files, &next_etc, &next_files, &diff)?;
+    // The running system's `.updated` says its own /etc is up to date, not the deployment's.
+    next_etc
+        .remove_file_optional(".updated")
+        .context("Removing .updated")?;
+    drop(next_etc);
+
+    let deployment_fd = deployment_dir.reopen_as_ownedfd()?;
+    // All of the new tree on disk before it is the deployment's /etc.
+    syncfs(&deployment_fd).context("syncfs")?;
+    renameat_with(
+        &deployment_fd,
+        NEXT_ETC,
+        &deployment_fd,
+        "etc",
+        RenameFlags::EXCHANGE,
+    )
+    .context("Exchanging the merged etc with the deployment's etc")?;
+    fsync(&deployment_fd).context("fsync")?;
+    // The previous /etc. Leaving it is harmless: the next merge removes it first.
+    if let Err(e) = deployment_dir.remove_all_optional(NEXT_ETC) {
+        tracing::warn!("Could not remove the deployment's previous etc: {e:#}");
+    }
+    Ok(())
+}
+
 #[cfg(test)]
 mod tests {
     use cap_std::fs::PermissionsExt;
@@ -1299,4 +1389,87 @@ mod tests {
 
         Ok(())
     }
+    /// A directory with a path, for what runs `cp`, removed when the test ends.
+    struct PathDir(PathBuf);
+
+    impl PathDir {
+        fn new(name: &str) -> anyhow::Result<Self> {
+            let path = std::env::temp_dir().join(format!("{name}-{}", std::process::id()));
+            let _ = std::fs::remove_dir_all(&path);
+            std::fs::create_dir_all(&path)?;
+            Ok(Self(path))
+        }
+
+        fn dir(&self, rel: &str) -> anyhow::Result<CapStdDir> {
+            std::fs::create_dir_all(self.0.join(rel))?;
+            Ok(CapStdDir::open_ambient_dir(
+                self.0.join(rel),
+                cap_std::ambient_authority(),
+            )?)
+        }
+    }
+
+    impl Drop for PathDir {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+
+    /// The deployment's /etc is merged when it is staged and again when the system shuts down.
+    /// Every change made to /etc between the two is in what the deployment boots with: a file
+    /// added, a file changed, and files that were there at staging (a default of the booted image
+    /// and one the system added itself) and deleted since.
+    #[test]
+    fn test_merge_deployment_etc_again() -> anyhow::Result<()> {
+        let root = PathDir::new("etc-merge-deployment")?;
+        let pristine = root.dir("pristine")?;
+        let current = root.dir("current")?;
+        let image = root.dir("image")?;
+        let deployment = root.0.join("deployment");
+        root.dir("deployment/etc")?;
+
+        for (file, booted, next) in [
+            ("unchanged", "a", "b"),
+            ("tweaked", "a", "b"),
+            ("default-deleted", "a", "b"),
+        ] {
+            pristine.write(file, booted)?;
+            current.write(file, booted)?;
+            image.write(file, next)?;
+        }
+        image.write(".updated", "")?;
+        current.write("tweaked", "mine at staging")?;
+        current.write("added-before", "mine")?;
+
+        // Staging lays down the image's /etc, then merges.
+        copy_image_etc(&root.0.join("image"), &deployment.join("etc"))?;
+        merge_deployment_etc(&deployment, &root.0.join("image"), &pristine, &current)?;
+        let etc = CapStdDir::open_ambient_dir(deployment.join("etc"), cap_std::ambient_authority())?;
+        assert_eq!(etc.read_to_string("unchanged")?, "b");
+        assert_eq!(etc.read_to_string("tweaked")?, "mine at staging");
+        assert_eq!(etc.read_to_string("added-before")?, "mine");
+        assert_eq!(etc.read_to_string("default-deleted")?, "b");
+        drop(etc);
+
+        // The system goes on changing /etc after staging.
+        current.write("added-after", "new")?;
+        current.write("tweaked", "mine at shutdown")?;
+        current.remove_file("added-before")?;
+        current.remove_file("default-deleted")?;
+        current.write(".updated", "")?;
+        // And an earlier merge was cut short.
+        root.dir("deployment/etc.next")?.write("half-written", "x")?;
+
+        merge_deployment_etc(&deployment, &root.0.join("image"), &pristine, &current)?;
+        let etc = CapStdDir::open_ambient_dir(deployment.join("etc"), cap_std::ambient_authority())?;
+        assert_eq!(etc.read_to_string("added-after")?, "new");
+        assert_eq!(etc.read_to_string("tweaked")?, "mine at shutdown");
+        assert!(!etc.try_exists("added-before")?, "a file deleted after staging came back");
+        assert!(!etc.try_exists("default-deleted")?, "a default deleted after staging came back");
+        assert_eq!(etc.read_to_string("unchanged")?, "b");
+        assert!(!etc.try_exists(".updated")?);
+        assert!(!etc.try_exists("half-written")?);
+        assert!(!deployment.join(NEXT_ETC).exists(), "the previous etc was left behind");
+        Ok(())
+    }
 }
