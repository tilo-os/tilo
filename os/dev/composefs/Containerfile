# composefs-backend + UKI probe image.
#
# A deliberately thin image containing the Tilo *boot chain* pieces used by the
# composefs probe (hardening kargs, a generation number on the measured
# command line, the bounded-rollback machinery that binds to it, systemd-boot, no
# bootupd) on top of the same digest-pinned Fedora bootc base the desktop image uses
# — and nothing else. The full Tilo rootfs takes ~25 minutes to build and none
# of it participates in the mechanism under test. os/dev/composefs/build-tilo.sh
# builds the desktop image once the mechanism is settled.
#
# Build with os/dev/composefs/build.sh (it passes BASE_REF and GENERATION).
#
# Stages follow bootc's documented sealed-image pattern:
#   rootfs -> split (kernel/initrd moved out of the rootfs) -> uki (ukify over
#   the split rootfs, so the composefs digest it embeds is the digest of what
#   will actually be mounted) -> final (split rootfs + the UKI under /boot,
#   which is outside the digest).
#
# The tools and uki stages are intentionally independent of the production
# sealer (os/Containerfile `uki-tools`/`uki`, os/dev/uki.sh), which
# tools/policy/check_uki_pipeline.py keeps identical across the shipped images.
# The probe's build context is this directory, not the repository, and its
# uki.sh can sign the UKI in the build with tilo-crypto (SIGN), which
# os/dev/uki.sh does not, and its negative control (SEAL_GENERATION) leaves the generation out of the kargs
# rather than skipping an assertion. A probe result therefore speaks for the
# mechanism, not for os/dev/uki.sh; re-check a production change in a real
# image build.
ARG BASE_REF
ARG RPMS_REF
ARG GENERATION=1
# Whether the generation number reaches the sealed command line at all. Always 1
# for a built image; 0 builds the negative control — a UKI that measures perfectly
# but carries no generation — so that a check reporting the generation as measured
# can be shown to fail when it is not there. A check that only ever passes is not
# evidence.
ARG SEAL_GENERATION=1

FROM ${RPMS_REF} AS rpms

FROM ${BASE_REF} AS rootfs
ARG GENERATION

# Buildah leaves the rpms mount out of the layer cache key; this ARG keys it on RPMS_REF.
ARG RPMS_REF
# systemd-boot comes out of the digest-pinned RPM snapshot, not the network, so
# this stage builds the same way the desktop image does — and stays buildable
# when Fedora's `updates` metalink is serving repodata checksums that 404 on
# every mirror, which is a state it does reach.
#
# Nothing else needs installing: the Fedora bootc base already ships tpm2-tools
# (so PCRs and the TPM event log can be read), openssh-server, sudo,
# shadow-utils and a python3 with tomllib. ukify comes from the snapshot too,
# but only in the throwaway tools stage.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    dnf install -y --setopt=reposdir=/repo --disablerepo='*' --enablerepo=frozen \
        systemd-boot-unsigned \
    && dnf clean all

# A sealed composefs image must have systemd-boot and must NOT have bootupd.
# The GRUB stack goes with it: Tilo already drops shim + grub2, and bootupd's
# payload directory and the legacy ostree boot dir have to go too, or bootc
# still finds a bootupd install path.
RUN rpm -e --nodeps bootupd \
    && rm -rf /usr/lib/bootupd /usr/lib/ostree-boot \
    && (rpm -qa | grep -E '^(shim-x64|grub2-)' | xargs -r rpm -e --nodeps)

# Tilo's hardening kargs, unmodified. This is the file whose contents have
# to reach the *measured* command line for the rollback design to work.
COPY 01-hardening.toml /usr/lib/bootc/kargs.d/01-hardening.toml
# And the mode karg, likewise unmodified. `tilo.mode=repair` on a sealed command
# line is what makes repair mode selectable and unforgeable; the probe is where
# that gets booted rather than reasoned about.
COPY 04-mode.toml /usr/lib/bootc/kargs.d/04-mode.toml

# The generation number. Tilo binds rollback protection to it, and it has to be
# sealed into the UKI rather than written by a bootloader, so it enters through
# the same kargs.d mechanism the hardening set uses.
ARG SEAL_GENERATION
RUN mkdir -p /usr/lib/tilo /boot/EFI/Linux \
    && printf '%s\n' "${GENERATION}" > /usr/lib/tilo/generation \
    && if [ "${SEAL_GENERATION}" = 1 ]; then \
         printf 'kargs = ["tilo.generation=%s"]\n' "${GENERATION}" \
           > /usr/lib/bootc/kargs.d/02-generation.toml; \
       else \
         echo "NEGATIVE CONTROL: no generation on the sealed command line"; \
       fi

# Spike-only kargs: a writable root (bootc's composefs root is mounted
# read-only without it) and a serial console so a headless boot leaves a log.
RUN printf '%s\n' \
        'kargs = [' \
        '  "rw",' \
        '  "rootflags=compress=zstd:1",' \
        '  "console=tty0",' \
        '  "console=ttyS0,115200",' \
        ']' > /usr/lib/bootc/kargs.d/03-spike.toml

# btrfs root (matching Tilo) and systemd-boot, both through the same install
# drop-in mechanism the desktop image uses.
RUN printf '%s\n' '[install]' 'bootloader = "systemd"' \
        > /usr/lib/bootc/install/40-tilo.toml \
    && printf '%s\n' '[install.filesystem.root]' 'type = "btrfs"' \
        > /usr/lib/bootc/install/80-rootfs.toml

# A login. The evidence for every numbered step is collected over ssh.
RUN useradd -m -G wheel tester \
    && printf 'tester:tilo\n' | chpasswd \
    && printf 'root:tilo\n' | chpasswd \
    && printf '%%wheel ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/wheel-nopasswd \
    && chmod 0440 /etc/sudoers.d/wheel-nopasswd \
    && systemctl enable sshd.service \
    && mkdir -p /etc/ssh/sshd_config.d \
    && printf 'PermitRootLogin yes\nPasswordAuthentication yes\n' \
        > /etc/ssh/sshd_config.d/01-spike.conf

# The consumer of that measured generation: Tilo's bounded-rollback machinery,
# copied from the desktop image rather than reimplemented, so that
# os/tests/rollback-boot-check.sh runs here against the same files it will run
# against an install. Without it the boot-side check can only report the
# tooling as missing, which says nothing about whether the measurement works.
#
# One COPY, not eight: each layer commit here rewrites a 2.3 GB rootfs through
# fuse-overlayfs and costs minutes, so build.sh assembles the files under
# stage/tree/ at their final paths and this copies the tree in a single layer.
COPY stage/tree/ /
# ReadWritePaths=/var/lib/tilo in the units is not optional: a namespace that
# cannot bind a path it was told to make writable refuses to start, and the unit
# then fails for a reason that has nothing to do with rollback.
RUN chmod 0755 /usr/bin/tilo-rollback /usr/libexec/tilo-rollback-common \
        /usr/libexec/tilo-rollback-confirm /usr/libexec/tilo-rollback-harden \
        /usr/libexec/tilo-rollback-boot-check /usr/libexec/tilo-recovery-boot-check \
        /usr/libexec/tilo-deployment /usr/libexec/tilo-boot-health \
        /usr/libexec/tilo-repair /usr/libexec/tilo-uki-cmdline \
        /usr/lib/systemd/system-generators/tilo-boot-mode-generator \
    && printf 'd /var/lib/tilo 0755 root root -\n' \
        > /usr/lib/tmpfiles.d/tilo-rollback.conf \
    && systemctl enable tilo-rollback-harden.timer tilo-rollback-confirm.timer \
    && systemctl enable tilo-boot-entries.timer tilo-boot-health.service

# --- what "the session came up" means on an image with no session ------------
# tilo-boot-health waits for greetd, which this image does not have — it is the
# boot chain without the desktop. So it is pointed at a stand-in that plays the
# same part in the same units: something the boot has to reach for the boot to
# count. SESSION_OK=0 builds a generation whose stand-in fails, which is the
# deliberately-broken deployment the automatic rollback is demonstrated against.
#
# The health check, boot-complete.target, systemd-bless-boot and the boot counters
# are all the production ones. Only the unit being waited for differs.
ARG SESSION_OK=1
RUN if [ "${SESSION_OK}" = 1 ]; then start=/bin/true; else start=/bin/false; fi \
    && printf '%s\n' \
        '[Unit]' \
        'Description=Stand-in for the desktop session on the boot-chain probe' \
        'After=multi-user.target' \
        '' \
        '[Service]' \
        'Type=oneshot' \
        'RemainAfterExit=yes' \
        "ExecStart=$start" \
        '' \
        '[Install]' \
        'WantedBy=multi-user.target' > /usr/lib/systemd/system/tilo-probe-session.service \
    && mkdir -p /usr/lib/systemd/system/tilo-boot-health.service.d \
    && printf '%s\n' \
        '[Unit]' \
        'After=tilo-probe-session.service' \
        '' \
        '[Service]' \
        'Environment=TILO_BOOT_HEALTH_UNIT=tilo-probe-session.service' \
        'Environment=TILO_BOOT_HEALTH_TIMEOUT=45' \
        > /usr/lib/systemd/system/tilo-boot-health.service.d/10-probe-session.conf \
    && systemctl enable tilo-probe-session.service \
    && echo "probe session unit: ExecStart=$start (SESSION_OK=${SESSION_OK})"

# The registry the update series is served from runs on the VM host, reachable
# from user-mode networking at 10.0.2.2 over plain HTTP.
RUN printf '%s\n' \
        '[[registry]]' \
        'location = "10.0.2.2:5000"' \
        'insecure = true' > /etc/containers/registries.conf.d/99-spike.conf

# --- split: move the kernel and initramfs out of the rootfs ------------------
# They go into the UKI instead, and bootc refuses a sealed image that still
# carries them in /usr/lib/modules/<kver>/.
FROM rootfs AS split
RUN mkdir /kernel && bootc container split-kernel-and-rootfs --rootfs / --output /kernel

# --- uki: build (and optionally sign) the Unified Kernel Image ---------------
FROM ${BASE_REF} AS tools
# The frozen snapshot carries the same tools the production sealer installs
# (os/dev/uki-tools.packages, outside this build context), so this throwaway
# builder no longer reaches the network either. The UKI is self-contained — its
# stub comes from this stage's systemd-boot-unsigned and does not have to match
# the systemd in the rootfs.
# Buildah leaves the rpms mount out of the layer cache key; this ARG keys it on RPMS_REF.
ARG RPMS_REF
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    dnf install -y --setopt=reposdir=/repo --disablerepo='*' --enablerepo=frozen \
        systemd-ukify systemd-boot-unsigned binutils \
    && dnf clean all
COPY uki.sh /usr/local/bin/uki.sh
COPY stage/tree/usr/bin/tilo-crypto /usr/local/bin/tilo-crypto

FROM tools AS uki
ARG SIGN=0
ENV SIGN=${SIGN}
# Set to install's expected digest to work around bootc#2334; see uki.sh.
ARG CFS_DIGEST=
ENV CFS_DIGEST=${CFS_DIGEST}
# The cache mount on /var/tmp is not an optimisation, it is required. Computing
# the composefs digest builds a temporary composefs repository under /var/tmp,
# and writing an object there needs O_TMPFILE — which overlayfs, the filesystem
# a build stage's root is, does not support. The failure is
# "Creating object tmpfile: ... Operation not supported (os error 95)" and it
# names neither /var/tmp nor overlayfs. A cache mount is host-backed, so it both
# supports O_TMPFILE and lets the objects survive between generations instead of
# re-hashing the whole rootfs each time. tmpfs would also work but would hold
# the entire rootfs content in RAM.
RUN --mount=type=cache,target=/var/tmp,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/run \
    --mount=type=bind,from=split,target=/target \
    --mount=type=bind,from=split,source=/kernel,target=/kernel \
    --mount=type=secret,id=secureboot_key \
    --mount=type=secret,id=secureboot_cert \
    bash /usr/local/bin/uki.sh

# --- final: the split rootfs plus the UKI ------------------------------------
# Nothing may be added outside /boot here: the composefs digest the UKI embeds
# was computed over the split stage, and /boot is the only tree excluded from
# it. The sealed command line and the ukify measurement report are pulled off
# the uki stage by build.sh instead of being copied into the rootfs.
FROM split AS final
COPY --from=uki /out/*.efi /boot/EFI/Linux/
