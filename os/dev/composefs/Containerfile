# composefs-backend + UKI probe image.
#
# A deliberately thin image: the qOS *boot chain* pieces that the composefs
# question turns on (hardening kargs, a generation number on the measured
# command line, the bounded-rollback machinery that binds to it, systemd-boot, no
# bootupd) on top of the same digest-pinned Fedora bootc base the real image uses
# — and nothing else. The full qOS
# rootfs takes ~25 minutes to build and none of it participates in the
# mechanism under test, so building it three times to prove an update series
# would only slow the answer down. os/dev/composefs/build-qos.sh does the real
# image once the mechanism is settled.
#
# Build with os/dev/composefs/build.sh (it passes BASE_REF and GENERATION).
#
# Stages follow bootc's documented sealed-image pattern:
#   rootfs -> split (kernel/initrd moved out of the rootfs) -> uki (ukify over
#   the split rootfs, so the composefs digest it embeds is the digest of what
#   will actually be mounted) -> final (split rootfs + the UKI under /boot,
#   which is outside the digest).
ARG BASE_REF
ARG RPMS_REF
ARG GENERATION=1
# Whether the generation number reaches the sealed command line at all. Always 1
# for a real image; 0 builds the negative control — a UKI that measures perfectly
# but carries no generation — so that a check reporting the generation as measured
# can be shown to fail when it is not there. A check that only ever passes is not
# evidence.
ARG SEAL_GENERATION=1

FROM ${RPMS_REF} AS rpms

FROM ${BASE_REF} AS rootfs
ARG GENERATION

# systemd-boot comes out of the digest-pinned RPM snapshot, not the network, so
# this stage builds the same way the real qOS image does — and stays buildable
# when Fedora's `updates` metalink is serving repodata checksums that 404 on
# every mirror, which is a state it does reach.
#
# Nothing else needs installing: the Fedora bootc base already ships tpm2-tools
# (so PCRs and the TPM event log can be read), openssh-server, sudo,
# shadow-utils and a python3 with tomllib. The one thing the snapshot does not
# carry is systemd-ukify — see the tools stage.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    dnf install -y --setopt=reposdir=/repo --disablerepo='*' --enablerepo=frozen \
        systemd-boot-unsigned \
    && dnf clean all

# A sealed composefs image must have systemd-boot and must NOT have bootupd.
# The GRUB stack goes with it: qOS already drops shim + grub2, and bootupd's
# payload directory and the legacy ostree boot dir have to go too, or bootc
# still finds a bootupd install path.
RUN rpm -e --nodeps bootupd \
    && rm -rf /usr/lib/bootupd /usr/lib/ostree-boot \
    && (rpm -qa | grep -E '^(shim-x64|grub2-)' | xargs -r rpm -e --nodeps)

# qOS's real hardening kargs, unmodified. This is the file whose contents have
# to reach the *measured* command line for the rollback design to work.
COPY 01-hardening.toml /usr/lib/bootc/kargs.d/01-hardening.toml

# The generation number. qOS binds rollback protection to it, and it has to be
# sealed into the UKI rather than written by a bootloader, so it enters through
# the same kargs.d mechanism the hardening set uses.
ARG SEAL_GENERATION
RUN mkdir -p /usr/lib/qos /boot/EFI/Linux \
    && printf '%s\n' "${GENERATION}" > /usr/lib/qos/generation \
    && if [ "${SEAL_GENERATION}" = 1 ]; then \
         printf 'kargs = ["qos.generation=%s"]\n' "${GENERATION}" \
           > /usr/lib/bootc/kargs.d/02-generation.toml; \
       else \
         echo "NEGATIVE CONTROL: no generation on the sealed command line"; \
       fi

# Spike-only kargs: a writable root (bootc's composefs root is mounted
# read-only without it) and a serial console so a headless boot leaves a log.
RUN printf '%s\n' \
        'kargs = [' \
        '  "rw",' \
        '  "rootflags=compress=zstd:1",' \
        '  "console=tty0",' \
        '  "console=ttyS0,115200",' \
        ']' > /usr/lib/bootc/kargs.d/03-spike.toml

# btrfs root (matching qOS) and systemd-boot, both through the same install
# drop-in mechanism the real image uses.
RUN printf '%s\n' '[install]' 'bootloader = "systemd"' \
        > /usr/lib/bootc/install/40-qos.toml \
    && printf '%s\n' '[install.filesystem.root]' 'type = "btrfs"' \
        > /usr/lib/bootc/install/80-rootfs.toml

# A login. The evidence for every numbered step is collected over ssh.
RUN useradd -m -G wheel tester \
    && printf 'tester:quickdesktop\n' | chpasswd \
    && printf 'root:quickdesktop\n' | chpasswd \
    && printf '%%wheel ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/wheel-nopasswd \
    && chmod 0440 /etc/sudoers.d/wheel-nopasswd \
    && systemctl enable sshd.service \
    && mkdir -p /etc/ssh/sshd_config.d \
    && printf 'PermitRootLogin yes\nPasswordAuthentication yes\n' \
        > /etc/ssh/sshd_config.d/01-spike.conf

# The consumer of that measured generation: qOS's bounded-rollback machinery,
# copied from the real image rather than reimplemented, so that
# os/tests/rollback-boot-check.sh runs here against the same files it will run
# against on a real install. Without it the boot-side check can only report the
# tooling as missing, which says nothing about whether the measurement works.
# stage/ is populated by build.sh (the binary comes from cargo, the rest from os/).
COPY stage/qos-rollback /usr/bin/qos-rollback
COPY stage/qos-rollback-common /usr/libexec/qos-rollback-common
COPY stage/qos-rollback-confirm /usr/libexec/qos-rollback-confirm
COPY stage/qos-rollback-harden /usr/libexec/qos-rollback-harden
COPY stage/rollback-boot-check.sh /usr/libexec/qos-rollback-boot-check
COPY stage/qos-rollback-confirm.service /usr/lib/systemd/system/qos-rollback-confirm.service
COPY stage/qos-rollback-confirm.timer /usr/lib/systemd/system/qos-rollback-confirm.timer
COPY stage/qos-rollback-harden.service /usr/lib/systemd/system/qos-rollback-harden.service
# ReadWritePaths=/var/lib/qos in the units is not optional: a namespace that
# cannot bind a path it was told to make writable refuses to start, and the unit
# then fails for a reason that has nothing to do with rollback.
RUN chmod 0755 /usr/bin/qos-rollback /usr/libexec/qos-rollback-common \
        /usr/libexec/qos-rollback-confirm /usr/libexec/qos-rollback-harden \
        /usr/libexec/qos-rollback-boot-check \
    && printf 'd /var/lib/qos 0755 root root -\n' \
        > /usr/lib/tmpfiles.d/qos-rollback.conf \
    && systemctl enable qos-rollback-harden.service qos-rollback-confirm.timer

# The registry the update series is served from runs on the VM host, reachable
# from user-mode networking at 10.0.2.2 over plain HTTP.
RUN printf '%s\n' \
        '[[registry]]' \
        'location = "10.0.2.2:5000"' \
        'insecure = true' > /etc/containers/registries.conf.d/99-spike.conf

# --- split: move the kernel and initramfs out of the rootfs ------------------
# They go into the UKI instead, and bootc refuses a sealed image that still
# carries them in /usr/lib/modules/<kver>/.
FROM rootfs AS split
RUN mkdir /kernel && bootc container split-kernel-and-rootfs --rootfs / --output /kernel

# --- uki: build (and optionally sign) the Unified Kernel Image ---------------
FROM ${BASE_REF} AS tools
# systemd-ukify is not in the frozen snapshot, so this stage does need the
# network. `updates` is disabled because its metadata is not reliably
# downloadable, and the downgrades that causes are harmless here: this is a
# throwaway builder that ships nothing. The UKI is self-contained — its stub
# comes from this stage's systemd-boot-unsigned and does not have to match the
# systemd in the rootfs.
RUN dnf install -y --disablerepo=updates --disablerepo=updates-archive \
        systemd-ukify sbsigntools binutils \
    && dnf clean all
COPY uki.sh /usr/local/bin/uki.sh

FROM tools AS uki
ARG SIGN=0
ENV SIGN=${SIGN}
# Set to install's expected digest to work around bootc#2334; see uki.sh.
ARG CFS_DIGEST=
ENV CFS_DIGEST=${CFS_DIGEST}
# The cache mount on /var/tmp is not an optimisation, it is required. Computing
# the composefs digest builds a temporary composefs repository under /var/tmp,
# and writing an object there needs O_TMPFILE — which overlayfs, the filesystem
# a build stage's root is, does not support. The failure is
# "Creating object tmpfile: ... Operation not supported (os error 95)" and it
# names neither /var/tmp nor overlayfs. A cache mount is host-backed, so it both
# supports O_TMPFILE and lets the objects survive between generations instead of
# re-hashing the whole rootfs each time. tmpfs would also work but would hold
# the entire rootfs content in RAM.
RUN --mount=type=cache,target=/var/tmp,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/run \
    --mount=type=bind,from=split,target=/target \
    --mount=type=bind,from=split,source=/kernel,target=/kernel \
    --mount=type=secret,id=secureboot_key \
    --mount=type=secret,id=secureboot_cert \
    bash /usr/local/bin/uki.sh

# --- final: the split rootfs plus the UKI ------------------------------------
# Nothing may be added outside /boot here: the composefs digest the UKI embeds
# was computed over the split stage, and /boot is the only tree excluded from
# it. The sealed command line and the ukify measurement report are pulled off
# the uki stage by build.sh instead of being copied into the rootfs.
FROM split AS final
COPY --from=uki /out/*.efi /boot/EFI/Linux/
