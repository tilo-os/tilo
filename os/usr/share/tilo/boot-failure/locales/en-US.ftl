# The screen a failed start shows, before any desktop exists. It is drawn by
# the boot splash, so it has one line of text per message and no markup.

boot-failure-title = Tilo couldn't start
boot-failure-step-unlock = Unlocking the disk didn't work.
boot-failure-step-mount = Mounting the system didn't work.
boot-failure-step-prepare = Preparing the system didn't work.
boot-failure-step-desktop = Starting the desktop didn't work.
boot-failure-try-again = Try again
boot-failure-previous = Start the previous version
boot-failure-previous-dated = Start the previous version from { $date }
boot-failure-console = Recovery console
boot-failure-show-details = Show details
boot-failure-hide-details = Hide details
boot-failure-menu-hint = To choose a version yourself, hold the Space key while the computer starts.
boot-failure-restarting = Restarting…
boot-failure-detail-unit = Failed: { $unit }
boot-failure-detail-boot = Start number: { $boot }
boot-failure-detail-entry = Version: { $entry }
boot-failure-date = { $month } { $day }, { $year }
boot-failure-month-1 = January
boot-failure-month-2 = February
boot-failure-month-3 = March
boot-failure-month-4 = April
boot-failure-month-5 = May
boot-failure-month-6 = June
boot-failure-month-7 = July
boot-failure-month-8 = August
boot-failure-month-9 = September
boot-failure-month-10 = October
boot-failure-month-11 = November
boot-failure-month-12 = December

# The recovery console's own prompts, on the text console.
boot-failure-console-passphrase = Enter the disk passphrase or the recovery key to open the recovery console.
boot-failure-console-refused = That passphrase doesn't unlock this disk.
boot-failure-console-signin = Sign in with an administrator account to open the recovery console.
boot-failure-console-back = Leave the console to return to the start screen.
boot-failure-console-shut = The recovery console can't be opened at this start. Use Repair Mode from the boot menu.
