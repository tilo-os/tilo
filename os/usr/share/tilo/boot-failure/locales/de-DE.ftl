# The screen a failed start shows, before any desktop exists. It is drawn by
# the boot splash, so it has one line of text per message and no markup.

boot-failure-title = Tilo konnte nicht starten
boot-failure-step-unlock = Das Entsperren der Festplatte hat nicht funktioniert.
boot-failure-step-mount = Das Einbinden des Systems hat nicht funktioniert.
boot-failure-step-prepare = Das Vorbereiten des Systems hat nicht funktioniert.
boot-failure-step-desktop = Das Starten des Desktops hat nicht funktioniert.
boot-failure-try-again = Erneut versuchen
boot-failure-previous = Vorherige Version starten
boot-failure-previous-dated = Vorherige Version vom { $date } starten
boot-failure-console = Wiederherstellungskonsole
boot-failure-show-details = Details anzeigen
boot-failure-hide-details = Details ausblenden
boot-failure-menu-hint = Um selbst eine Version zu wählen, halte beim Einschalten die Leertaste gedrückt.
boot-failure-restarting = Wird neu gestartet…
boot-failure-detail-unit = Fehlgeschlagen: { $unit }
boot-failure-detail-boot = Startnummer: { $boot }
boot-failure-detail-entry = Version: { $entry }
boot-failure-date = { $day }. { $month } { $year }
boot-failure-month-1 = Januar
boot-failure-month-2 = Februar
boot-failure-month-3 = März
boot-failure-month-4 = April
boot-failure-month-5 = Mai
boot-failure-month-6 = Juni
boot-failure-month-7 = Juli
boot-failure-month-8 = August
boot-failure-month-9 = September
boot-failure-month-10 = Oktober
boot-failure-month-11 = November
boot-failure-month-12 = Dezember

# The recovery console's own prompts, on the text console.
boot-failure-console-passphrase = Gib die Passphrase der Festplatte oder den Wiederherstellungsschlüssel ein, um die Wiederherstellungskonsole zu öffnen.
boot-failure-console-refused = Diese Passphrase entsperrt diese Festplatte nicht.
boot-failure-console-signin = Melde dich mit einem Administratorkonto an, um die Wiederherstellungskonsole zu öffnen.
boot-failure-console-back = Verlasse die Konsole, um zum Startbildschirm zurückzukehren.
boot-failure-console-shut = Die Wiederherstellungskonsole kann bei diesem Start nicht geöffnet werden. Nutze den Reparaturmodus im Startmenü.
