# Repositories the opt-in codec pack resolves against. Read only by
# /usr/libexec/tilo-codec-pack (dnf5 --setopt=reposdir=...), never by the
# system's own dnf configuration, and only after the owner asked for the pack.
#
# Fedora's repositories are listed so the pack's dependencies that live there
# (x265, svt-av1, ...) can be fetched; anything the base already has installed
# is excluded per repository by the helper, so nothing here can replace a base
# package. RPM Fusion nonfree is limited to Intel's media driver.
#
# gpgcheck is on for dnf's own benefit; the helper verifies every package again
# in an isolated keyring against the fingerprints pinned in the helper.

[fedora]
name=Fedora $releasever - $basearch
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&arch=$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-primary

[updates]
name=Fedora $releasever - $basearch - Updates
metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&arch=$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-primary

# OpenH264 built and served by Cisco; the metadata is Fedora's and the
# packages carry Fedora's signature.
[fedora-cisco-openh264]
name=Fedora $releasever openh264 (From Cisco) - $basearch
metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-cisco-openh264-$releasever&arch=$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-primary

[rpmfusion-free]
name=RPM Fusion for Fedora $releasever - Free
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-$releasever&arch=$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///usr/share/tilo/codec-pack/keys/RPM-GPG-KEY-rpmfusion-free-fedora-2020

[rpmfusion-free-updates]
name=RPM Fusion for Fedora $releasever - Free - Updates
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-updates-released-$releasever&arch=$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///usr/share/tilo/codec-pack/keys/RPM-GPG-KEY-rpmfusion-free-fedora-2020

[rpmfusion-nonfree]
name=RPM Fusion for Fedora $releasever - Nonfree
metalink=https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-$releasever&arch=$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
includepkgs=intel-media-driver
gpgkey=file:///usr/share/tilo/codec-pack/keys/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020

[rpmfusion-nonfree-updates]
name=RPM Fusion for Fedora $releasever - Nonfree - Updates
metalink=https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-updates-released-$releasever&arch=$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
includepkgs=intel-media-driver
gpgkey=file:///usr/share/tilo/codec-pack/keys/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020
