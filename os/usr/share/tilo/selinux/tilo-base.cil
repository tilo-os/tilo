; Tilo trusted-base SELinux confinement (CIL).
; ===========================================================================
; Confines the collaborative filesystem daemon (fs.service) into its own
; SELinux domain instead of the catch-all unconfined_service_t it lands in
; today (a custom binary with no policy = no MAC confinement). This is the
; MAC backstop for the trusted base: if fs is ever compromised, the kernel
; still boxes it.
;
; POSTURE: enforcing.
; -------------------
; tilo_fs_t enforces. Its allow-set below was captured from live AVCs, with
; the domain permissive and dontaudit rules disabled (`semodule -DB`), on a
; booted dev image running fs.service under a certified device identity:
; mount /var/workspace, create/write/append/rename/copy/truncate/chmod/
; touch/xattr/delete through the mount as two local accounts, restart and
; stop the unit (ExecStopPost), the storage and media sockets, the
; Iroh endpoint waking (relays, net report, DNS), and the native data plane's
; probes against a Btrfs store volume. It was then re-run with the domain
; enforcing and no tilo_fs_t denial. Every rule names the type it needs; a
; new behaviour of fs that needs another one shows up as an AVC denial for
; scontext tilo_fs_t (`journalctl -b _TRANSPORT=audit | grep tilo_fs_t`) and
; is added here with its reason, never by making the domain permissive again
; (os/tests/kernel_hardening_invariants.sh fails if that line returns).
;
; HOW fs ENTERS THE DOMAIN
; ------------------------
; fs.service carries `SELinuxContext=system_u:system_r:tilo_fs_t:s0` (drop-in),
; so systemd setexeccon's into tilo_fs_t at exec — no binary relabel needed
; (the executable stays bin_t; tilo_fs_t is allowed to entrypoint bin_t). The
; init_t -> tilo_fs_t transition is allowed explicitly (init_t is enforcing).

(type tilo_fs_t)
(typeattributeset domain (tilo_fs_t))
(roletype system_r tilo_fs_t)

; Let init (systemd) transition fs into the domain and entrypoint the binary
; (which keeps its default bin_t label — no relabel in the image).
(allow init_t tilo_fs_t (process (transition)))
(allow tilo_fs_t bin_t (file (entrypoint execute execute_no_trans read open getattr map ioctl)))
(allow init_t tilo_fs_t (process (siginh rlimitinh noatsecure)))
; fs.service also sets NoNewPrivileges=yes, and with the nnp_nosuid_transition
; policy capability a transition under no_new_privs needs its own permission:
; without it every exec into tilo_fs_t (fs, and the umount in ExecStopPost)
; fails with EPERM, status 203/EXEC.
(allow init_t tilo_fs_t (process2 (nnp_transition nosuid_transition)))

; tilo-firstboot-user.service (initrc_t) runs with NoNewPrivileges=yes and
; creates the first account with useradd (useradd_t) and sets its password
; with chpasswd and chage (passwd_t). Under no_new_privs those are bounded
; transitions that need their own permission; denied, the tools run on in
; initrc_t instead of the domains that confine them and label what they write.
(allow initrc_t useradd_t (process2 (nnp_transition nosuid_transition)))
(allow initrc_t passwd_t (process2 (nnp_transition nosuid_transition)))

; bootc (install_exec_t) belongs in install_t, the domain Fedora's policy
; gives it when systemd or an admin runs it: install_t holds mac_admin, which
; bootc needs to write labels the running policy does not know yet (an update
; to an image with new types). Tilo's deployment services are scripts in
; unconfined_service_t that run bootc, mostly under NoNewPrivileges, and
; Fedora has no transition from there. bootc then probes mac_admin with chcon
; on every call, `bootc status` included, is denied, copies itself to /tmp
; and re-executes, and stays without it. install_t is unconfined like
; unconfined_service_t; what the transition adds is mac_admin, for the one
; family of programs the policy means to have it.
(typetransition unconfined_service_t install_exec_t process install_t)
(allow unconfined_service_t install_t (process (transition)))
(allow unconfined_service_t install_t (process2 (nnp_transition nosuid_transition)))

; systemd's TPM measurement log, /run/log/systemd/tpm2-measure.log, is what
; makes the PCR extensions of each boot phase auditable. The initrd, with no
; policy loaded yet, creates it as systemd-pcrphase measures enter-initrd;
; after switch-root /run is relabelled and the file falls under /run/log's
; syslogd_var_run_t, which systemd-tpm2-setup.service (init_t, it has no
; domain of its own) may create but not write. The service then fails on
; every boot of a measured UKI. A type of its own gives exactly the
; measurement log to the two writers, not the volatile journal beside it.
(type tilo_tpm2_measure_log_t)
(roletype object_r tilo_tpm2_measure_log_t)
(typeattributeset file_type (tilo_tpm2_measure_log_t))
(typeattributeset non_auth_file_type (tilo_tpm2_measure_log_t))
(typeattributeset non_security_file_type (tilo_tpm2_measure_log_t))
(typeattributeset pidfile (tilo_tpm2_measure_log_t))
(filecon "/run/log/systemd/tpm2-measure\.log" file (system_u object_r tilo_tpm2_measure_log_t ((s0) (s0))))
(typetransition init_t syslogd_var_run_t file "tpm2-measure.log" tilo_tpm2_measure_log_t)
(typetransition systemd_pcrextend_t syslogd_var_run_t file "tpm2-measure.log" tilo_tpm2_measure_log_t)
(allow init_t tilo_tpm2_measure_log_t (file (create open getattr read write append lock ioctl)))
(allow systemd_pcrextend_t tilo_tpm2_measure_log_t (file (create open getattr read write append lock ioctl setattr)))

; --- what fs does, grouped by subsystem -------------------------------------
; Types the domain attribute already grants (proc, sysfs, /dev/null and
; urandom, shared libraries, locale, its own process signals, unix stream
; sockets of its own) are not repeated.

; Capabilities, all inside fs.service's CapabilityBoundingSet. sys_admin:
; mount and unmount (fusermount3, which also unshares a mount namespace for
; auto_unmount, and the umount of ExecStopPost). dac_override: fusermount3
; opens /dev/fuse and the mount point as root regardless of their owner.
(allow tilo_fs_t self (capability (sys_admin dac_override)))

; FUSE: the device, the helper that mounts it (fs execs fusermount3 without
; a transition, so it stays in this domain), the mount over /var/workspace (a
; var_t directory created by tmpfiles) and the fuse file system it serves.
; umount is what fusermount3 runs to detach, and ExecStopPost's lazy detach,
; entered from systemd. fusermount3 makes / private in the mount namespace it
; unshares for auto_unmount (mounton root_t). /run/mount/utab is libmount's
; record of the mount.
(allow tilo_fs_t fuse_device_t (chr_file (open read write ioctl getattr)))
(allow tilo_fs_t fusermount_exec_t (file (execute execute_no_trans open read map)))
(allow tilo_fs_t mount_exec_t (file (entrypoint execute execute_no_trans open read map)))
(allow tilo_fs_t var_t (dir (mounton)))
(allow tilo_fs_t root_t (dir (mounton)))
(allow tilo_fs_t fusefs_t (filesystem (mount unmount getattr)))
(allow tilo_fs_t mount_var_run_t (dir (getattr search open read write add_name remove_name)))
(allow tilo_fs_t mount_var_run_t (file (getattr open read write create lock unlink)))

; The workspace as fs sees it: the FUSE mount, and the native data plane's
; store volume, which tilo-store-volume mounts with context=fusefs_t (its
; capability probes and content area at /var/lib/tilo/store). setattr on a
; directory is the change signal: fs sets its no-op user.tilo.change-signal
; attribute through its own mount so inotify hears of a peer's edit.
(allow tilo_fs_t fusefs_t (dir (getattr search open read ioctl write add_name remove_name create setattr)))
(allow tilo_fs_t fusefs_t (file (getattr open read write create rename lock ioctl)))

; The content store and record database under /var/cache/quick-fs (var_t,
; created by tmpfiles): blobs, staging files, redb, history log, the
; namespace backups and the workspace ticket, written atomically.
(allow tilo_fs_t var_t (dir (getattr search open read write add_name remove_name create setattr)))
(allow tilo_fs_t var_t (file (getattr open read write append create rename unlink setattr lock ioctl)))

; /var/lib/tilo: the device key and certificate, the capability list it
; enforces (re-read on every inotify change), read only.
(allow tilo_fs_t var_lib_t (dir (read watch)))
(allow tilo_fs_t var_lib_t (file (getattr open read)))
; --native-owner names the local person by uid; fs resolves accounts.
(allow tilo_fs_t passwd_file_t (file (getattr open read)))

; Local sockets in /run/tilo (var_run_t, shared by the identity group):
; the storage-accounting, document-media and workspace-content sockets.
(allow tilo_fs_t var_run_t (dir (write add_name remove_name)))
(allow tilo_fs_t var_run_t (sock_file (create getattr setattr unlink)))
; stdout and stderr: the journal stream systemd hands the service.
(allow tilo_fs_t init_t (unix_stream_socket (read write)))
(allow tilo_fs_t init_var_run_t (dir (search)))

; Iroh: QUIC over UDP (bound on an unreserved port), TCP to the relays and
; the HTTPS net report and DNS lookups, the routing table over netlink and
; /proc/<pid>/net/route, and interface queries on a datagram socket.
; Port mapping's follow-up HTTP to a router's UPnP port is not granted: it
; was not observed, and without it Iroh still connects through relays and
; hole punching.
(allow tilo_fs_t self (udp_socket (create bind connect getattr getopt setopt read write)))
(allow tilo_fs_t self (tcp_socket (create connect getattr getopt setopt read write)))
(allow tilo_fs_t self (netlink_route_socket (create bind getattr nlmsg_read read write)))
(allow tilo_fs_t self (unix_dgram_socket (create ioctl)))
(allow tilo_fs_t unreserved_port_t (udp_socket (name_bind)))
(allow tilo_fs_t node_t (udp_socket (node_bind)))
(allow tilo_fs_t http_port_t (tcp_socket (name_connect)))
(allow tilo_fs_t proc_net_t (file (open read)))
(allow tilo_fs_t proc_net_t (lnk_file (read)))
(allow tilo_fs_t net_conf_t (file (getattr open read)))
(allow tilo_fs_t net_conf_t (lnk_file (read)))
; Network state: NetworkManager over the system bus, and its runtime
; connection profiles, read only.
(allow tilo_fs_t system_dbusd_var_run_t (dir (search)))
(allow tilo_fs_t system_dbusd_var_run_t (sock_file (write)))
(allow tilo_fs_t system_dbusd_t (unix_stream_socket (connectto)))
(allow tilo_fs_t system_dbusd_t (dbus (send_msg)))
(allow tilo_fs_t NetworkManager_t (dbus (send_msg)))
(allow tilo_fs_t NetworkManager_var_run_t (dir (getattr search open read)))
(allow tilo_fs_t NetworkManager_var_run_t (file (getattr open read)))

; The async runtime sizes itself from the unit's cgroup CPU quota, and
; statfs of / reports free space for the content store.
(allow tilo_fs_t cgroup_t (dir (search)))
(allow tilo_fs_t cgroup_t (file (getattr open read)))
(allow tilo_fs_t fs_t (filesystem (getattr)))

; The compositor (shell) runs in the greetd session domain; giving it its own
; confined domain is the next base-daemon target, same workflow.

; The console channel of a VM (crates/session/console-control): the greeter
; and the live installer run in xdm_t and answer the tilo-control action
; protocol on the virtio-serial port named org.tilo.console.0. That port only
; exists when a hypervisor attaches it (real hardware has no virtio-serial
; bus). 70-tilo-console.rules gives exactly that port to the greetd user;
; every other virtio port stays root-only by owner and mode, so this MAC
; grant does not widen who can open them.
(allow xdm_t virtio_device_t (chr_file (open read write getattr ioctl lock)))

; tilo-authd checks every secret. It runs unconfined (unconfined_service_t)
; and listens on /run/tilo-auth/socket, a var_run_t socket in its runtime
; directory. The PAM callers that run confined must reach it: greetd and the
; greeter (xdm_t: the sign-in and the boot sign-in), polkit's authentication
; helper (policykit_auth_t), console login (local_login_t) and sshd (sshd_t).
; Sessions run unconfined and need nothing. The daemon decides what each
; peer may ask from its credentials, so this grant only opens the door.
(allow xdm_t var_run_t (sock_file (getattr write)))
(allow xdm_t unconfined_service_t (unix_stream_socket (connectto)))
(allow policykit_auth_t var_run_t (sock_file (getattr write)))
(allow policykit_auth_t unconfined_service_t (unix_stream_socket (connectto)))
(allow local_login_t var_run_t (sock_file (getattr write)))
(allow local_login_t unconfined_service_t (unix_stream_socket (connectto)))
(allow sshd_t var_run_t (sock_file (getattr write)))
(allow sshd_t unconfined_service_t (unix_stream_socket (connectto)))
