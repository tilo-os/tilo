<!--
  The sole network for the Tilo Windows appliance.

  `forward mode='none'` is intentional: this bridge has no NAT, route, or
  physical-interface attachment.  It only connects the host and the one guest
  so the pinned, mutually authenticated RemoteApp channel can be reached.  Do
  not turn this into libvirt's `default` network just to make an installer
  download something; guest egress is a capability-broker operation.
-->
<network>
  <name>tilo-windows-hostonly</name>
  <metadata>
    <tilo:windows-hostonly xmlns:tilo="https://tilo.sh/vm/1"/>
  </metadata>
  <forward mode="none"/>
  <bridge name="virbr-tilowin" stp="on" delay="0"/>
  <ip address="192.168.251.1" netmask="255.255.255.0">
    <dhcp>
      <!-- The bridge client accepts only this fixed singleton address. -->
      <host mac="52:54:00:71:4f:53" name="tilo-windows-appliance" ip="192.168.251.2"/>
      <range start="192.168.251.2" end="192.168.251.254"/>
    </dhcp>
  </ip>
</network>
