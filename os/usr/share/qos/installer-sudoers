# qOS installer — passwordless sudo for the privileged install backend.
#
# This file is NOT active as shipped. It lives at /usr/share and is copied to
# /etc/sudoers.d/qos-installer (mode 0440) at runtime by
# qos-installer-setup.service, which only fires when `qos.install` is on the
# kernel cmdline — i.e. on the installer live medium. The installed system
# never gets this rule.
#
# It lets the unprivileged greetd session user (which runs the qos-installer
# UI under cage) self-escalate the privileged backend commands via
# `sudo -n`: the installer, Finish-screen power/recovery actions, and the exact
# read-only guided-receipt inspection form. The create verb is not granted.
#
# Preserve a release-channel tag/digest override across the sudo env reset.
# qos-install rejects repositories outside the signature-required qOS origin.
Defaults env_keep += "QOS_TARGET_IMGREF"

# The installer UI runs under cage with no controlling tty, and that session
# can't allocate a pty — so Fedora's global `Defaults use_pty` makes the
# backend's `sudo -n` fail with "unable to allocate pty: Permission denied".
# Disable use_pty for greetd's invocations (the command is a fixed, audited
# path, so the pty hardening buys little here).
Defaults:greetd !use_pty

greetd ALL=(root) NOPASSWD: /usr/libexec/qos-install, /usr/libexec/qos-power, /usr/libexec/qos-recovery, /usr/libexec/qos-guided-partition inspect --disk /dev/*
