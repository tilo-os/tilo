[Desktop Entry]
# Alternate Wayland session entry for users who explicitly want the
# Iroh peer-sync stack enabled (direct paths plus encrypted relay fallback
# discovery). Off by default — see /usr/share/doc/qos/peer-sync.md
# for the privacy/trust trade-off and how to opt in.
#
# Both entries land in /usr/share/wayland-sessions/, so the greeter lists
# "qOS" and "qOS with peer sync" side by side and the user picks at login
# time. As in shell.desktop, `Name` is the human label and `DesktopNames`
# is the internal id the portal matches on.
Name=qOS with peer sync
GenericName=Desktop
Comment=Collaborative session with Iroh peer discovery enabled
Exec=/usr/libexec/qos-session --backend drm --enable-peer-sync
Type=Application
DesktopNames=nirios
