[Desktop Entry]
# Wayland session entry advertised to the graphical greeter's session
# picker (tilo-greeter reads this directory directly).
#
# `Name` is shown to the person logging in, so it is the product name, not
# the internal desktop id. `DesktopNames` below is the machine-facing id and
# is a contract with the portal — the two are deliberately different.
#
# `Exec` uses the Tilo session wrapper, which activates the standard systemd
# graphical-session targets, waits for verified identity enrollment, then runs
# shell in its default native mode. It is not a nested compositor wrapper.
#
# `DesktopNames=tilo` is what the xdg-desktop-portal `tilo.portal`
# file matches via `UseIn=tilo` to activate our portal backend.
Name=Tilo
GenericName=Desktop
Comment=Collaborative spatial desktop environment
Exec=/usr/libexec/tilo-session --backend drm
Type=Application
DesktopNames=tilo
