[Desktop Entry]
# The old shell compositor (/usr/bin/shell), offered beside the native session
# while the shell is still shipped; it goes away with the shell crate.
#
# `Exec` runs the same Tilo session wrapper as tilo-session.desktop, with the
# same systemd targets, activation environment and flight record; `--shell`
# makes it run /usr/bin/shell, and the rest is that binary's command line.
#
# Its `Name` sorts after "Tilo" and it carries no
# `X-Tilo-Session-Default=true`, so the greeter offers it second
# (crates/session/greeter/src/sessions.rs).
Name=Tilo (old shell)
GenericName=Desktop
Comment=Collaborative spatial desktop environment, previous session
Exec=/usr/libexec/tilo-session --shell --backend drm
Type=Application
DesktopNames=tilo
