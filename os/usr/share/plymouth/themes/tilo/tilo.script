# Tilo boot, sign-in and encrypted-root unlock theme. Keep this dependency-free:
# it runs in the initramfs before the real root filesystem is available.
Window.SetBackgroundTopColor(0.055, 0.063, 0.090);
Window.SetBackgroundBottomColor(0.035, 0.039, 0.060);

logo.image = Image("tilo-logo.png");
logo.sprite = Sprite(logo.image);
logo.phase = 0;
logo.sprite.SetZ(10);

progress.background_image = Image("progress-background.png");
progress.background = Sprite(progress.background_image);
progress.fill_source = Image("progress-fill.png");
progress.fill = Sprite();
progress.background.SetZ(20);
progress.fill.SetZ(21);

status.boot_image = Image("starting-tilo.png");
status.shutdown_image = Image("shutting-down.png");
status.help_image = Image("startup-help.png");
status.heading = Sprite();
status.help = Sprite(status.help_image);
status.heading.SetZ(30);
status.help.SetZ(30);

# Fixed text is pre-rendered into PNGs (os/dev/make-plymouth-assets.py). Only
# what the boot cannot know in advance (a person's name, the tries left) is
# drawn with Image.Text, through Plymouth's FreeType label plugin and the one
# font the initramfs carries. Where that is missing, Image.Text draws nothing,
# and every such line falls back to a pre-rendered one that says the same
# without the detail.
text_probe = Image.Text("Tilo", 1, 1, 1);
can_draw_text = text_probe && text_probe.GetWidth() > 0;

fun show_normal_status()
  {
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    local.shutdown = Plymouth.GetMode() == "shutdown";
    if (shutdown)
      global.status.image = status.shutdown_image;
    else
      global.status.image = status.boot_image;
    status.heading.SetImage(status.image);
    status.heading.SetPosition(center_x - status.image.GetWidth() / 2,
                               Window.GetY() + Window.GetHeight() * 0.58, 30);
    status.help.SetPosition(center_x - status.help_image.GetWidth() / 2,
                            Window.GetY() + Window.GetHeight() * 0.78, 30);
    status.heading.SetOpacity(1);
    if (shutdown)
      status.help.SetOpacity(0);
    else
      status.help.SetOpacity(1);
  }

fun place_brand(unlock_mode)
  {
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    if (unlock_mode)
      logo.y = Window.GetY() + Window.GetHeight() * 0.29;
    else
      logo.y = Window.GetY() + Window.GetHeight() * 0.39;
    logo.sprite.SetPosition(center_x - logo.image.GetWidth() / 2,
                            logo.y - logo.image.GetHeight() / 2, 10);

    progress.x = center_x - progress.background_image.GetWidth() / 2;
    progress.y = Window.GetY() + Window.GetHeight() * 0.72;
    progress.background.SetPosition(progress.x, progress.y, 20);
    progress.fill.SetPosition(progress.x, progress.y, 21);
  }

fun set_dialog_opacity(opacity)
  {
    if (!dialog.ready)
      return;
    dialog.heading.SetOpacity(opacity);
    dialog.help.SetOpacity(opacity);
    dialog.lock.SetOpacity(opacity);
    dialog.entry.SetOpacity(opacity);
    for (index = 0; dialog.bullet[index]; index++)
      dialog.bullet[index].SetOpacity(opacity);
  }

fun setup_dialog()
  {
    global.dialog.heading_image = Image("unlock-heading.png");
    global.dialog.heading = Sprite(dialog.heading_image);
    global.dialog.help_image = Image("unlock-help.png");
    global.dialog.help = Sprite(dialog.help_image);
    global.dialog.retry_image = Image("unlock-retry.png");
    global.dialog.retry = Sprite(dialog.retry_image);
    dialog.retry.SetOpacity(0);
    global.dialog.entry_image = Image("entry.png");
    global.dialog.entry = Sprite(dialog.entry_image);
    global.dialog.lock_image = Image("lock.png");
    global.dialog.lock = Sprite(dialog.lock_image);
    global.dialog.bullet_image = Image("bullet.png");
    global.dialog.ready = 1;
  }

fun place_dialog()
  {
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    dialog.heading.SetPosition(center_x - dialog.heading_image.GetWidth() / 2,
                               Window.GetY() + Window.GetHeight() * 0.48, 100);
    dialog.help.SetPosition(center_x - dialog.help_image.GetWidth() / 2,
                            Window.GetY() + Window.GetHeight() * 0.535, 100);
    dialog.retry.SetPosition(center_x - dialog.retry_image.GetWidth() / 2,
                             Window.GetY() + Window.GetHeight() * 0.67, 100);
    global.dialog.entry_x = center_x - dialog.entry_image.GetWidth() / 2;
    global.dialog.entry_y = Window.GetY() + Window.GetHeight() * 0.59;
    dialog.entry.SetPosition(dialog.entry_x, dialog.entry_y, 100);
    dialog.lock.SetPosition(dialog.entry_x + 18,
                            dialog.entry_y + dialog.entry_image.GetHeight() / 2
                              - dialog.lock_image.GetHeight() / 2,
                            101);
    for (index = 0; dialog.bullet[index]; index++)
      dialog.bullet[index].SetPosition(dialog.entry_x + 64 + index * 11,
                                       dialog.entry_y + 24, 102);
  }

# ---- Sign-in ---------------------------------------------------------------
# tilo-boot-signin (crates/system/boot-signin) drives this screen with
# `display-message` texts `tilo-signin-<what>:<value>`. It follows the login
# screen's layout: who is signing in, the field labelled for their secret, one
# message line, and the other ways in below. With several people, they first
# pick themselves from a list that ends with "Can't sign in".

signin.active = 0;
signin.view = "";
signin.count = 0;
signin.selected = 0;
signin.name = "";
signin.kind = "password";
signin.back = 0;
signin.note_class = "none";
signin.note_text = "";
signin.checking = 0;
signin.bullets = 0;

fun index_of_colon(text)
  {
    for (local.i = 0; i < text.Length(); i++)
      {
        if (text.CharAt(i) == ":")
          return i;
      }
    return -1;
  }

fun to_number(text)
  {
    local.value = 0;
    local.digits = "0123456789";
    for (local.i = 0; i < text.Length(); i++)
      {
        local.found = 0;
        for (local.d = 0; d < 10; d++)
          {
            if (text.CharAt(i) == digits.CharAt(d))
              {
                value = value * 10 + d;
                found = 1;
              }
          }
        if (!found)
          return value;
      }
    return value;
  }

# The capital initial for the avatar, or "" when the name starts with
# something the one font may not draw.
fun initial_of(name)
  {
    local.lower = "abcdefghijklmnopqrstuvwxyz";
    local.upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    local.digits = "0123456789";
    local.first = name.CharAt(0);
    for (local.i = 0; i < 26; i++)
      {
        if (first == lower.CharAt(i) || first == upper.CharAt(i))
          return upper.CharAt(i);
      }
    for (i = 0; i < 10; i++)
      {
        if (first == digits.CharAt(i))
          return first;
      }
    return "";
  }

fun text_image(text, size, red, green, blue)
  {
    if (!can_draw_text || text == "")
      return NULL;
    local.image = Image.Text(text, red, green, blue, 1, "Sans " + size);
    if (!image || image.GetWidth() < 1)
      return NULL;
    return image;
  }

fun setup_signin()
  {
    global.signin.ready = 1;
    signin.avatar_image = Image("avatar.png");
    signin.avatar_person_image = Image("avatar-person.png");
    signin.avatar = Sprite(signin.avatar_image);
    signin.initial = Sprite();
    signin.name_sprite = Sprite();
    signin.heading_image = Image("signin-heading.png");
    signin.entry_image = Image("entry.png");
    signin.entry = Sprite(signin.entry_image);
    signin.placeholder_pin = Image("placeholder-pin.png");
    signin.placeholder_password = Image("placeholder-password.png");
    signin.placeholder = Sprite();
    signin.bullet_image = Image("bullet.png");
    signin.note = Sprite();
    signin.wrong_pin_image = Image("note-wrong-pin.png");
    signin.wrong_password_image = Image("note-wrong-password.png");
    signin.wait_image = Image("note-wait.png");
    signin.checking_image = Image("signing-in.png");
    signin.hint_other_image = Image("hint-other-ways.png");
    signin.hint_back_image = Image("hint-someone-else.png");
    signin.hint = Sprite();
    signin.list_heading = Sprite(Image("list-heading.png"));
    signin.list_keys = Sprite(Image("list-keys.png"));
    signin.row_image = Image("row.png");
    signin.row_selected_image = Image("row-selected.png");
    signin.other_ways_image = Image("cant-sign-in.png");
    signin.rendered_name = "";
  }

fun hide_signin_field()
  {
    signin.avatar.SetOpacity(0);
    signin.initial.SetOpacity(0);
    signin.name_sprite.SetOpacity(0);
    signin.entry.SetOpacity(0);
    signin.placeholder.SetOpacity(0);
    signin.note.SetOpacity(0);
    signin.hint.SetOpacity(0);
    for (local.i = 0; signin.bullet[i]; i++)
      signin.bullet[i].SetOpacity(0);
  }

fun hide_signin_list()
  {
    signin.list_heading.SetOpacity(0);
    signin.list_keys.SetOpacity(0);
    for (local.i = 0; signin.row_sprite[i]; i++)
      {
        signin.row_sprite[i].SetOpacity(0);
        signin.row_label[i].SetOpacity(0);
      }
  }

fun hide_signin()
  {
    if (!signin.ready)
      return;
    hide_signin_field();
    hide_signin_list();
  }

fun place_centered(sprite, image, top, z)
  {
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    sprite.SetImage(image);
    sprite.SetPosition(center_x - image.GetWidth() / 2, top, z);
    sprite.SetOpacity(1);
  }

fun draw_signin_field()
  {
    local.top = Window.GetY();
    local.height = Window.GetHeight();
    local.center_x = Window.GetX() + Window.GetWidth() / 2;

    local.avatar_top = top + height * 0.30;
    local.initial = initial_of(signin.name);
    local.letter = text_image(initial, 40, 0.94, 0.94, 0.98);
    if (letter)
      {
        place_centered(signin.avatar, signin.avatar_image, avatar_top, 110);
        signin.initial.SetImage(letter);
        signin.initial.SetPosition(center_x - letter.GetWidth() / 2,
                                   avatar_top + signin.avatar_image.GetHeight() / 2
                                     - letter.GetHeight() / 2, 111);
        signin.initial.SetOpacity(1);
      }
    else
      {
        place_centered(signin.avatar, signin.avatar_person_image, avatar_top, 110);
        signin.initial.SetOpacity(0);
      }

    if (signin.rendered_name != signin.name)
      {
        signin.name_image = text_image(signin.name, 26, 0.94, 0.94, 0.98);
        if (!signin.name_image)
          signin.name_image = signin.heading_image;
        signin.rendered_name = signin.name;
      }
    place_centered(signin.name_sprite, signin.name_image,
                   avatar_top + signin.avatar_image.GetHeight() + 16, 110);

    local.entry_top = top + height * 0.52;
    local.entry_x = center_x - signin.entry_image.GetWidth() / 2;
    place_centered(signin.entry, signin.entry_image, entry_top, 110);
    if (signin.checking)
      signin.entry.SetOpacity(0.5);

    if (signin.kind == "pin")
      signin.placeholder.SetImage(signin.placeholder_pin);
    else
      signin.placeholder.SetImage(signin.placeholder_password);
    signin.placeholder.SetPosition(entry_x + 22,
                                   entry_top + signin.entry_image.GetHeight() / 2
                                     - signin.placeholder_pin.GetHeight() / 2, 111);
    if (signin.bullets == 0 && !signin.checking)
      signin.placeholder.SetOpacity(1);
    else
      signin.placeholder.SetOpacity(0);

    # Very long passphrases stay visually bounded while accepted in full.
    local.visible = signin.bullets;
    if (signin.checking)
      visible = 0;
    if (visible > 24)
      visible = 24;
    for (local.i = 0; signin.bullet[i] || i < visible; i++)
      {
        if (!signin.bullet[i])
          signin.bullet[i] = Sprite(signin.bullet_image);
        signin.bullet[i].SetPosition(entry_x + 24 + i * 13,
                                     entry_top + signin.entry_image.GetHeight() / 2 - 4, 112);
        if (i < visible)
          signin.bullet[i].SetOpacity(1);
        else
          signin.bullet[i].SetOpacity(0);
      }

    local.note_image = NULL;
    if (signin.checking)
      note_image = signin.checking_image;
    else if (signin.note_class != "none")
      {
        note_image = text_image(signin.note_text, 17, 0.957, 0.663, 0.604);
        if (!note_image && signin.note_class == "wait")
          note_image = signin.wait_image;
        else if (!note_image && signin.kind == "pin")
          note_image = signin.wrong_pin_image;
        else if (!note_image)
          note_image = signin.wrong_password_image;
      }
    if (note_image)
      place_centered(signin.note, note_image,
                     entry_top + signin.entry_image.GetHeight() + 18, 110);
    else
      signin.note.SetOpacity(0);

    if (signin.back)
      place_centered(signin.hint, signin.hint_back_image, top + height * 0.84, 110);
    else
      place_centered(signin.hint, signin.hint_other_image, top + height * 0.84, 110);
  }

fun draw_signin_list()
  {
    local.top = Window.GetY();
    local.height = Window.GetHeight();
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    local.row_x = center_x - signin.row_image.GetWidth() / 2;
    local.rows_top = top + height * 0.38;
    local.step = signin.row_image.GetHeight() + 10;

    place_centered(signin.list_heading, signin.list_heading.GetImage(), top + height * 0.30, 110);
    for (local.i = 0; i <= signin.count; i++)
      {
        if (!signin.row_sprite[i])
          {
            signin.row_sprite[i] = Sprite();
            signin.row_label[i] = Sprite();
          }
        if (i == signin.selected)
          signin.row_sprite[i].SetImage(signin.row_selected_image);
        else
          signin.row_sprite[i].SetImage(signin.row_image);
        signin.row_sprite[i].SetPosition(row_x, rows_top + i * step, 110);
        signin.row_sprite[i].SetOpacity(1);

        local.label = NULL;
        if (i < signin.count)
          {
            label = text_image(signin.person[i], 20, 0.94, 0.94, 0.98);
            if (!label)
              label = Image("account-" + (i + 1) + ".png");
          }
        else
          label = signin.other_ways_image;
        if (label)
          {
            signin.row_label[i].SetImage(label);
            signin.row_label[i].SetPosition(row_x + 24,
                                            rows_top + i * step
                                              + signin.row_image.GetHeight() / 2
                                              - label.GetHeight() / 2, 111);
            signin.row_label[i].SetOpacity(1);
          }
        else
          signin.row_label[i].SetOpacity(0);
      }
    for (i = signin.count + 1; signin.row_sprite[i]; i++)
      {
        signin.row_sprite[i].SetOpacity(0);
        signin.row_label[i].SetOpacity(0);
      }
    place_centered(signin.list_keys, signin.list_keys.GetImage(), top + height * 0.84, 110);
  }

fun draw_signin()
  {
    if (!signin.ready)
      setup_signin();
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    logo.y = Window.GetY() + Window.GetHeight() * 0.17;
    logo.sprite.SetPosition(center_x - logo.image.GetWidth() / 2,
                            logo.y - logo.image.GetHeight() / 2, 10);
    progress.background.SetOpacity(0);
    progress.fill.SetOpacity(0);
    status.heading.SetOpacity(0);
    status.help.SetOpacity(0);
    set_dialog_opacity(0);
    if (dialog.ready)
      dialog.retry.SetOpacity(0);
    if (signin.view == "list")
      {
        hide_signin_field();
        draw_signin_list();
      }
    else
      {
        hide_signin_list();
        draw_signin_field();
      }
  }

fun signin_message(text)
  {
    local.cut = index_of_colon(text);
    local.key = text;
    local.value = "";
    if (cut >= 0)
      {
        key = text.SubString(0, cut);
        value = text.SubString(cut + 1, text.Length());
      }
    if (key == "people")
      {
        signin.active = 1;
        signin.count = to_number(value);
      }
    else if (key == "person")
      {
        local.at = index_of_colon(value);
        if (at > 0)
          signin.person[to_number(value.SubString(0, at))] = value.SubString(at + 1, value.Length());
      }
    else if (key == "choose")
      {
        signin.active = 1;
        signin.view = "list";
        signin.selected = to_number(value);
      }
    else if (key == "name")
      {
        signin.active = 1;
        signin.view = "field";
        signin.name = value;
        signin.checking = 0;
      }
    else if (key == "kind")
      signin.kind = value;
    else if (key == "back")
      signin.back = value == "1";
    else if (key == "note")
      {
        local.split = index_of_colon(value);
        if (split >= 0)
          {
            signin.note_class = value.SubString(0, split);
            signin.note_text = value.SubString(split + 1, value.Length());
          }
        signin.checking = 0;
      }
    else if (key == "checking")
      signin.checking = 1;
    else if (key == "end")
      {
        signin.active = 0;
        signin.view = "";
        signin.checking = 0;
        hide_signin();
        display_hotplug();
        return;
      }
    if (signin.active)
      draw_signin();
  }

# ---- Plymouth callbacks ----------------------------------------------------

fun display_password(prompt, bullets)
  {
    global.mode = "password";
    global.password_bullets = bullets;
    if (signin.active)
      {
        signin.bullets = bullets;
        draw_signin();
        return;
      }
    hide_signin();
    place_brand(1);
    progress.background.SetOpacity(0);
    progress.fill.SetOpacity(0);
    status.heading.SetOpacity(0);
    status.help.SetOpacity(0);
    if (!global.dialog)
      setup_dialog();
    place_dialog();
    set_dialog_opacity(1);
    if (global.unlock_rejected)
      dialog.retry.SetOpacity(1);
    else
      dialog.retry.SetOpacity(0);

    # Keep very long passphrases visually bounded while accepting them in full.
    local.visible_bullets = bullets;
    if (visible_bullets > 24)
      visible_bullets = 24;
    for (index = 0; dialog.bullet[index] || index < visible_bullets; index++)
      {
        if (!dialog.bullet[index])
          {
            global.dialog.bullet[index] = Sprite(dialog.bullet_image);
            dialog.bullet[index].SetPosition(dialog.entry_x + 64 + index * 11,
                                              dialog.entry_y + 24, 102);
          }
        if (index < visible_bullets)
          dialog.bullet[index].SetOpacity(1);
        else
          dialog.bullet[index].SetOpacity(0);
      }
  }

fun display_normal()
  {
    global.mode = "normal";
    if (signin.active)
      {
        # Between entries (while one is checked) the sign-in screen stays up.
        signin.bullets = 0;
        draw_signin();
        return;
      }
    hide_signin();
    if (dialog.ready)
      dialog.retry.SetOpacity(0);
    place_brand(0);
    set_dialog_opacity(0);
    progress.background.SetOpacity(1);
    progress.fill.SetOpacity(1);
    show_normal_status();
  }

fun display_hotplug()
  {
    # The splash usually starts on the firmware framebuffer and moves to the
    # GPU driver's native mode once that loads, so the window can change size
    # and scale mid-boot. Every position derives from the window: lay the
    # current screen out again rather than keep the first framebuffer's.
    if (signin.active)
      draw_signin();
    else if (global.mode == "password")
      display_password("", global.password_bullets);
    else
      display_normal();
  }

fun refresh()
  {
    # A restrained breathing animation keeps the screen alive without making a
    # password prompt feel busy.
    logo.phase += 0.025;
    logo.sprite.SetOpacity(0.90 + 0.10 * ((Math.Sin(logo.phase) + 1) / 2));
  }

fun boot_progress(duration, percent)
  {
    local.width = Math.Int(progress.fill_source.GetWidth() * percent);
    if (width < 1)
      width = 1;
    progress.fill.SetImage(progress.fill_source.Scale(width,
                                                       progress.fill_source.GetHeight()));
  }

fun display_message(text)
  {
    if (text.SubString(0, 12) == "tilo-signin-")
      {
        signin_message(text.SubString(12, text.Length()));
        return;
      }
    # Root discovery forwards a confirmed passphrase rejection. Password
    # prompt redraws alone cannot distinguish submission from backspacing.
    if (text == "tilo-unlock-retry")
      {
        global.unlock_rejected = 1;
        if (dialog.ready)
          dialog.retry.SetOpacity(1);
      }
    if (text == "tilo-unlock-success")
      {
        global.unlock_rejected = 0;
        if (dialog.ready)
          dialog.retry.SetOpacity(0);
      }
  }

mode = "normal";
place_brand(0);
show_normal_status();
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(boot_progress);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetDisplayHotplugFunction(display_hotplug);
