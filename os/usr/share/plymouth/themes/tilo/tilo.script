# Tilo boot and encrypted-root unlock theme. Keep this dependency-free: it runs
# in the initramfs before the real root filesystem is available.
Window.SetBackgroundTopColor(0.055, 0.063, 0.090);
Window.SetBackgroundBottomColor(0.035, 0.039, 0.060);

logo.image = Image("tilo-logo.png");
logo.sprite = Sprite(logo.image);
logo.phase = 0;
logo.sprite.SetZ(10);

progress.background_image = Image("progress-background.png");
progress.background = Sprite(progress.background_image);
progress.fill_source = Image("progress-fill.png");
progress.fill = Sprite();
progress.background.SetZ(20);
progress.fill.SetZ(21);

status.boot_image = Image("starting-tilo.png");
status.shutdown_image = Image("shutting-down.png");
status.help_image = Image("startup-help.png");
status.heading = Sprite();
status.help = Sprite(status.help_image);
status.heading.SetZ(30);
status.help.SetZ(30);

fun show_normal_status()
  {
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    local.shutdown = Plymouth.GetMode() == "shutdown";
    if (shutdown)
      global.status.image = status.shutdown_image;
    else
      global.status.image = status.boot_image;
    status.heading.SetImage(status.image);
    status.heading.SetPosition(center_x - status.image.GetWidth() / 2,
                               Window.GetY() + Window.GetHeight() * 0.58, 30);
    status.help.SetPosition(center_x - status.help_image.GetWidth() / 2,
                            Window.GetY() + Window.GetHeight() * 0.78, 30);
    status.heading.SetOpacity(1);
    if (shutdown)
      status.help.SetOpacity(0);
    else
      status.help.SetOpacity(1);
  }

fun place_brand(unlock_mode)
  {
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    if (unlock_mode)
      logo.y = Window.GetY() + Window.GetHeight() * 0.29;
    else
      logo.y = Window.GetY() + Window.GetHeight() * 0.39;
    logo.sprite.SetPosition(center_x - logo.image.GetWidth() / 2,
                            logo.y - logo.image.GetHeight() / 2, 10);

    progress.x = center_x - progress.background_image.GetWidth() / 2;
    progress.y = Window.GetY() + Window.GetHeight() * 0.72;
    progress.background.SetPosition(progress.x, progress.y, 20);
    progress.fill.SetPosition(progress.x, progress.y, 21);
  }

fun set_dialog_opacity(opacity)
  {
    if (!dialog.ready)
      return;
    dialog.heading.SetOpacity(opacity);
    dialog.help.SetOpacity(opacity);
    dialog.lock.SetOpacity(opacity);
    dialog.entry.SetOpacity(opacity);
    for (index = 0; dialog.bullet[index]; index++)
      dialog.bullet[index].SetOpacity(opacity);
  }

fun setup_dialog()
  {
    # Text is pre-rendered into these assets. Image.Text depends on fonts and
    # Pango data that intentionally are not carried in the small initramfs and
    # can otherwise turn an encrypted-root prompt into an invisible wait.
    global.dialog.heading_image = Image("unlock-heading.png");
    global.dialog.heading = Sprite(dialog.heading_image);
    global.dialog.help_image = Image("unlock-help.png");
    global.dialog.help = Sprite(dialog.help_image);
    global.dialog.retry_image = Image("unlock-retry.png");
    global.dialog.retry = Sprite(dialog.retry_image);
    dialog.retry.SetOpacity(0);
    global.dialog.entry_image = Image("entry.png");
    global.dialog.entry = Sprite(dialog.entry_image);
    global.dialog.lock_image = Image("lock.png");
    global.dialog.lock = Sprite(dialog.lock_image);
    global.dialog.bullet_image = Image("bullet.png");
    global.dialog.ready = 1;
  }

fun place_dialog()
  {
    local.center_x = Window.GetX() + Window.GetWidth() / 2;
    dialog.heading.SetPosition(center_x - dialog.heading_image.GetWidth() / 2,
                               Window.GetY() + Window.GetHeight() * 0.48, 100);
    dialog.help.SetPosition(center_x - dialog.help_image.GetWidth() / 2,
                            Window.GetY() + Window.GetHeight() * 0.535, 100);
    dialog.retry.SetPosition(center_x - dialog.retry_image.GetWidth() / 2,
                             Window.GetY() + Window.GetHeight() * 0.67, 100);
    global.dialog.entry_x = center_x - dialog.entry_image.GetWidth() / 2;
    global.dialog.entry_y = Window.GetY() + Window.GetHeight() * 0.59;
    dialog.entry.SetPosition(dialog.entry_x, dialog.entry_y, 100);
    dialog.lock.SetPosition(dialog.entry_x + 18,
                            dialog.entry_y + dialog.entry_image.GetHeight() / 2
                              - dialog.lock_image.GetHeight() / 2,
                            101);
    for (index = 0; dialog.bullet[index]; index++)
      dialog.bullet[index].SetPosition(dialog.entry_x + 64 + index * 11,
                                       dialog.entry_y + 24, 102);
  }

fun display_password(prompt, bullets)
  {
    global.mode = "password";
    global.password_bullets = bullets;
    place_brand(1);
    progress.background.SetOpacity(0);
    progress.fill.SetOpacity(0);
    status.heading.SetOpacity(0);
    status.help.SetOpacity(0);
    if (!global.dialog)
      setup_dialog();
    place_dialog();
    set_dialog_opacity(1);
    if (global.unlock_rejected)
      dialog.retry.SetOpacity(1);
    else
      dialog.retry.SetOpacity(0);

    # Keep very long passphrases visually bounded while accepting them in full.
    local.visible_bullets = bullets;
    if (visible_bullets > 24)
      visible_bullets = 24;
    for (index = 0; dialog.bullet[index] || index < visible_bullets; index++)
      {
        if (!dialog.bullet[index])
          {
            global.dialog.bullet[index] = Sprite(dialog.bullet_image);
            dialog.bullet[index].SetPosition(dialog.entry_x + 64 + index * 11,
                                              dialog.entry_y + 24, 102);
          }
        if (index < visible_bullets)
          dialog.bullet[index].SetOpacity(1);
        else
          dialog.bullet[index].SetOpacity(0);
      }
  }

fun display_normal()
  {
    # A failed start's screen stays until tilo-boot-failure restarts.
    if (global.mode == "failure")
      return;
    global.mode = "normal";
    if (dialog.ready)
      dialog.retry.SetOpacity(0);
    place_brand(0);
    set_dialog_opacity(0);
    progress.background.SetOpacity(1);
    progress.fill.SetOpacity(1);
    show_normal_status();
  }

fun display_hotplug()
  {
    # The splash usually starts on the firmware framebuffer and moves to the
    # GPU driver's native mode once that loads, so the window can change size
    # and scale mid-boot. Every position derives from the window: lay the
    # current screen out again rather than keep the first framebuffer's.
    if (global.mode == "failure")
      failure_redraw();
    else if (global.mode == "password")
      display_password("", global.password_bullets);
    else
      display_normal();
  }

fun refresh()
  {
    # A restrained breathing animation keeps the screen alive without making a
    # password prompt feel busy.
    logo.phase += 0.025;
    logo.sprite.SetOpacity(0.90 + 0.10 * ((Math.Sin(logo.phase) + 1) / 2));
  }

fun boot_progress(duration, percent)
  {
    local.width = Math.Int(progress.fill_source.GetWidth() * percent);
    if (width < 1)
      width = 1;
    progress.fill.SetImage(progress.fill_source.Scale(width,
                                                       progress.fill_source.GetHeight()));
  }

# --- the boot-failure screen ---------------------------------------------------
# tilo-boot-failure (/usr/libexec) sends "tilo-failure:<message>" lines through
# display-message and owns the layout: positions are permille of the screen's
# height, so the taps it hit-tests land where this draws. All words are
# pre-rendered per locale (os/dev/make-plymouth-assets.py); what fills them at
# run time is printable ASCII drawn glyph by glyph from an atlas.
#
#   reset:<locale>                     a clean screen in that locale
#   logo:<y>                           where the logo goes
#   text:<y>:<role key>                one pre-rendered line, centred
#   button:<y>:<focused>:<segments>    a button; its label is segments
#   detail:<y>:<segments>              a details line, left-aligned
#
# Segments are separated by "|": "k=<key>" a pre-rendered piece, "a=<text>"
# glyphs at the buttons' size, "m=<text>" monospaced glyphs at the details'.
failure.glyphs = " !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{}~";
for (failure_at = 0; failure.glyphs.CharAt(failure_at) != ""; failure_at++)
  failure.glyph_index[failure.glyphs.CharAt(failure_at)] = failure_at;
for (failure_at = 0; failure_at < 10; failure_at++)
  failure.digit["0123456789".CharAt(failure_at)] = failure_at;
failure.count = 0;
failure.messages = 0;

fun failure_find(text, char, from)
  {
    for (local.at = from; text.CharAt(at) != ""; at++)
      if (text.CharAt(at) == char)
        return at;
    return -1;
  }

fun failure_end(text)
  {
    local.at = 0;
    while (text.CharAt(at) != "")
      at++;
    return at;
  }

fun failure_number(text)
  {
    local.value = 0;
    for (local.at = 0; text.CharAt(at) != ""; at++)
      value = value * 10 + failure.digit[text.CharAt(at)];
    return value;
  }

fun failure_image(name)
  {
    if (!failure.cache[name])
      global.failure.cache[name] = Image("failure/" + name + ".png");
    return failure.cache[name];
  }

# One sprite of the screen's pool, shown with this image at (x, y).
fun failure_put(image, x, y, z)
  {
    if (!failure.sprite[failure.count])
      global.failure.sprite[failure.count] = Sprite();
    local.sprite = failure.sprite[failure.count];
    sprite.SetImage(image);
    sprite.SetPosition(x, y, z);
    sprite.SetOpacity(1);
    global.failure.count = failure.count + 1;
  }

# The images a segment list is drawn with, in order.
fun failure_segments(text)
  {
    local.images.count = 0;
    local.start = 0;
    local.end = failure_end(text);
    while (start < end)
      {
        local.stop = failure_find(text, "|", start);
        if (stop < 0)
          stop = end;
        local.kind = text.CharAt(start);
        local.body = text.SubString(start + 2, stop);
        if (kind == "k")
          {
            images[images.count] = failure_image(failure.locale + "/" + body);
            images.count = images.count + 1;
          }
        else
          {
            for (local.at = 0; body.CharAt(at) != ""; at++)
              {
                local.index = failure.glyph_index[body.CharAt(at)];
                # A glyph the atlas lacks (index 0 is the space) shows as "?".
                if (!index && body.CharAt(at) != " ")
                  index = failure.glyph_index["?"];
                images[images.count] = failure_image(kind + "/" + index);
                images.count = images.count + 1;
              }
          }
        start = stop + 1;
      }
    return images;
  }

fun failure_width(images)
  {
    local.width = 0;
    for (local.at = 0; at < images.count; at++)
      width += images[at].GetWidth();
    return width;
  }

fun failure_row(images, x, centre_y, z)
  {
    for (local.at = 0; at < images.count; at++)
      {
        failure_put(images[at], x, centre_y - images[at].GetHeight() / 2, z);
        x += images[at].GetWidth();
      }
  }

fun failure_draw(text)
  {
    local.colon = failure_find(text, ":", 0);
    if (colon < 0)
      colon = failure_end(text);
    local.kind = text.SubString(0, colon);
    local.rest = text.SubString(colon + 1, failure_end(text));
    local.centre_x = Window.GetX() + Window.GetWidth() / 2;

    if (kind == "reset")
      {
        for (local.at = 0; failure.sprite[at]; at++)
          failure.sprite[at].SetOpacity(0);
        global.failure.count = 0;
        global.failure.locale = rest;
        logo.sprite.SetPosition(centre_x - logo.image.GetWidth() / 2,
                                Window.GetY() + Window.GetHeight() * 0.17
                                  - logo.image.GetHeight() / 2, 10);
        return;
      }

    colon = failure_find(rest, ":", 0);
    local.y = Window.GetY() + Window.GetHeight() * failure_number(rest.SubString(0, colon)) / 1000;
    rest = rest.SubString(colon + 1, failure_end(rest));

    if (kind == "logo")
      logo.sprite.SetPosition(centre_x - logo.image.GetWidth() / 2,
                              y - logo.image.GetHeight() / 2, 10);
    if (kind == "text")
      {
        local.image = failure_image(failure.locale + "/" + rest);
        failure_put(image, centre_x - image.GetWidth() / 2, y - image.GetHeight() / 2, 200);
      }
    if (kind == "button")
      {
        local.images = failure_segments(rest.SubString(2, failure_end(rest)));
        local.label_width = failure_width(images);
        if (rest.CharAt(0) == "1")
          local.back = failure_image("button-focus");
        else
          local.back = failure_image("button");
        local.width = back.GetWidth();
        if (label_width + 48 > width)
          width = label_width + 48;
        if (width != back.GetWidth())
          back = back.Scale(width, back.GetHeight());
        failure_put(back, centre_x - width / 2, y - back.GetHeight() / 2, 200);
        failure_row(images, centre_x - label_width / 2, y, 201);
      }
    if (kind == "detail")
      failure_row(failure_segments(rest), centre_x - 340, y, 200);
  }

fun failure_message(text)
  {
    if (global.mode != "failure")
      {
        global.mode = "failure";
        set_dialog_opacity(0);
        progress.background.SetOpacity(0);
        progress.fill.SetOpacity(0);
        status.heading.SetOpacity(0);
        status.help.SetOpacity(0);
      }
    # Kept since the last reset, so a new screen size lays it out again.
    if (text.SubString(0, 6) == "reset:")
      global.failure.messages = 0;
    global.failure.message[failure.messages] = text;
    global.failure.messages = failure.messages + 1;
    failure_draw(text);
  }

fun failure_redraw()
  {
    for (local.at = 0; at < failure.messages; at++)
      failure_draw(failure.message[at]);
  }

fun display_message(text)
  {
    # Root discovery forwards a confirmed passphrase rejection. Password
    # prompt redraws alone cannot distinguish submission from backspacing.
    if (text == "tilo-unlock-retry")
      {
        global.unlock_rejected = 1;
        if (dialog.ready)
          dialog.retry.SetOpacity(1);
      }
    if (text.SubString(0, 13) == "tilo-failure:")
      failure_message(text.SubString(13, failure_end(text)));
    if (text == "tilo-unlock-success")
      {
        global.unlock_rejected = 0;
        if (dialog.ready)
          dialog.retry.SetOpacity(0);
      }
  }

mode = "normal";
place_brand(0);
show_normal_status();
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(boot_progress);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetDisplayHotplugFunction(display_hotplug);
