#!/bin/sh
# Start the hosted-VM service on the machine that owns its VMs (crates/vm/
# linux-vm/src/hosted): fetch the guest this build pins, then
# `tilo-linux-vm hosted serve` as the service's own account.
#
#   tilo-hosted-serve --state DIR --run DIR
#
# One start, run from two places: os/containers/tilo-vm-host/entrypoint.sh does
# the pod's own setup first and then executes this, and tilo-hosted.service on
# the server OS runs it as the machine's own start. What the service does is the
# same either way, from the environment the container README names (TILO_VM_*).
set -eu

state=
run=
while [ $# -gt 0 ]; do
  case "$1" in
    --state) state=${2:?--state needs a directory}; shift 2 ;;
    --run) run=${2:?--run needs a directory}; shift 2 ;;
    *) printf 'tilo-hosted-serve: unknown argument %s\n' "$1" >&2; exit 2 ;;
  esac
done
[ -n "$state" ] && [ -n "$run" ] || { echo 'usage: tilo-hosted-serve --state DIR --run DIR' >&2; exit 2; }

# The service's account, and its home (where skopeo reads its configuration):
# the state disk's root, which both images keep at /var/lib/tilo-hosted. The
# server OS starts this as that account already; inside the pod it starts as root,
# and drops to it here.
uid=10001
gid=10001
data=/var/lib/tilo-hosted
say() { printf 'tilo-hosted-serve: %s\n' "$*" >&2; }

if [ "$(id -u)" = "$uid" ]; then
  as_service() { HOME=$data "$@"; }
else
  as_service() { HOME=$data setpriv --reuid=$uid --regid=$gid --init-groups --inh-caps=-all -- "$@"; }
fi

# The guest: the image the release key signed, fetched once per digest
# (TILO_VM_GUEST_REF overrides the one this build pins).
if [ -n "${TILO_VM_GUEST_REF:-}" ]; then
  guest=$(as_service tilo-linux-vm hosted fetch-guest --images "$data/images" --ref "$TILO_VM_GUEST_REF")
else
  guest=$(as_service tilo-linux-vm hosted fetch-guest --images "$data/images")
fi
kernel=$(printf '%s\n' "$guest" | sed -n 's/^kernel //p')
rootfs=$(printf '%s\n' "$guest" | sed -n 's/^rootfs //p')
say "guest kernel $kernel, root filesystem $rootfs"

set -- --state "$state" --run "$run" --kernel "$kernel" --disk-image "$rootfs" \
  --jail-helper /usr/libexec/tilo/tilo-hosted-jail --jail-config /etc/tilo/hosted-jail.json
if [ -n "${TILO_VM_PLANS:-}" ]; then set -- "$@" --plans "$TILO_VM_PLANS"; fi
if [ -n "${TILO_VM_EVICT_NOTICE:-}" ]; then set -- "$@" --evict-notice "$TILO_VM_EVICT_NOTICE"; fi
# The node's memory its VMs are packed into, and what stays free for the node
# itself. VMs are admitted by what they really use, which the service reads from
# each VM's processes, so the budget is the node's memory and not a sum of the
# sizes its VMs were configured at: auto takes all of it (TILO_VM_MEMORY_MIB).
# The reserve (TILO_VM_MEMORY_RESERVE_MIB, 2 GiB) is what the service keeps for
# this process, its VMs' helper processes and the room a balloon needs to give
# memory back, and the headroom (TILO_VM_MEMORY_HEADROOM_MIB, 128 MiB) is added
# to what a VM is counted at until the kernel has measured it.
memory_mib=${TILO_VM_MEMORY_MIB:-}
if [ "$memory_mib" = auto ]; then
  total_mib=$(( $(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo) / 1024 ))
  memory_mib=$total_mib
  say "memory for VMs: all of the node's $memory_mib MiB"
fi
set -- "$@" --memory-reserve-mib "${TILO_VM_MEMORY_RESERVE_MIB:-2048}"
set -- "$@" --memory-headroom-mib "${TILO_VM_MEMORY_HEADROOM_MIB:-128}"
if [ -n "$memory_mib" ]; then set -- "$@" --memory-mib "$memory_mib"; fi
# The browser session in a workspace's VM joins its workspace through the server
# at TILO_VM_SERVER_ENDPOINT, an address inside the host's network: it is the one
# destination besides the internet a VM may reach.
if [ -n "${TILO_VM_SERVER_ENDPOINT:-}" ]; then
  set -- "$@" --server-endpoint "$TILO_VM_SERVER_ENDPOINT"
fi

# The cgroup tree every VM's cgroup is made in was handed down by
# tilo-hosted-prepare, which runs as root before this on both machines.
if [ "$(id -u)" = "$uid" ]; then
  HOME=$data exec tilo-linux-vm hosted serve "$@"
fi
HOME=$data exec setpriv --reuid=$uid --regid=$gid --init-groups --inh-caps=-all -- tilo-linux-vm hosted serve "$@"
