#!/usr/bin/bash
# Shared helpers for the tilo-rollback units. Sourced, not executed.
#
# Everything here is about answering two questions without guessing:
#   * which block device holds the encrypted root, and
#   * is this machine actually healthy enough to discard its fallback.

log()  { printf 'tilo-rollback: %s\n' "$*"; }
warn() { printf 'tilo-rollback: WARNING: %s\n' "$*" >&2; }
die()  { printf 'tilo-rollback: %s\n' "$*" >&2; exit 1; }

# The LUKS2 backing device of the root filesystem, or empty when root is not
# encrypted.
#
# Discovery is by content, not by configuration: find the block device the root
# filesystem sits on, then follow the kernel's own record of what is underneath
# it. Reading /etc/crypttab would tell us what was *intended*; this tells us
# what is.
#
# The root is composefs, which no block device backs; the physical root is
# /sysroot. The walk goes through sysfs alone (a crypt mapping's dm/uuid and its
# one underlying device in slaves/), never a device-mapper ioctl, so it gives the
# same answer in a unit without CAP_SYS_ADMIN and whatever name the mount table
# records for the source. tilo-root-discover's link to the device it opened is
# the last candidate, for a mount namespace without /sysroot.
rollback_luks_device() {
  local majmin target
  for majmin in \
    "$(findmnt -nro MAJ:MIN /sysroot 2>/dev/null | head -1)" \
    "$(findmnt -nro MAJ:MIN / 2>/dev/null | head -1)"; do
    rollback_luks_under "$majmin" && return 0
  done
  target="$(readlink -f "${TILO_ROLLBACK_ROOT_LINK:-/run/tilo-root/device}" 2>/dev/null)" || return 0
  [ -b "$target" ] || return 0
  rollback_luks_under "$(lsblk -dnro MAJ:MIN "$target" 2>/dev/null)" || true
}

# Print the LUKS device under the block device MAJ:MIN when that is an open
# LUKS mapping; fail otherwise.
rollback_luks_under() {
  local majmin="$1" sys="${TILO_ROLLBACK_SYSFS:-/sys}" uuid slaves dev
  case "$majmin" in [0-9]*:[0-9]*) ;; *) return 1 ;; esac
  sys="$sys/dev/block/$majmin"
  uuid="$(cat "$sys/dm/uuid" 2>/dev/null)" || return 1
  case "$uuid" in CRYPT-LUKS*) ;; *) return 1 ;; esac
  slaves=("$sys"/slaves/*)
  [ "${#slaves[@]}" -eq 1 ] && [ -e "${slaves[0]}" ] || return 1
  dev="${TILO_ROLLBACK_DEVROOT:-/dev}/${slaves[0]##*/}"
  # Confirm it really is LUKS before handing it to anything destructive.
  cryptsetup isLuks "$dev" 2>/dev/null || return 1
  printf '%s\n' "$dev"
}

# Is there a keyslot on $1 that no tilo-rollback token claims?
#
# That is the recovery key's slot (and any systemd-cryptenroll slot). Its
# presence is the precondition for touching the TPM's lockout settings: doing so
# makes a forgotten PIN unrecoverable without it.
#
# Each generation this tool enrolls owns exactly one keyslot, so "more keyslots
# than enrolled generations" is exactly "at least one slot we do not own". Counting
# is used rather than matching slot numbers because it cannot be fooled by a
# malformed token that this tool declines to parse — an unparseable token would
# make its slot look foreign, and this check has to err towards refusing.
rollback_has_independent_keyslot() {
  local dev="$1" slots enrolled
  slots="$(cryptsetup luksDump "$dev" 2>/dev/null \
          | sed -n '/^Keyslots:/,/^Tokens:/p' \
          | grep -cE '^  [0-9]+:')"
  [ -n "$slots" ] && [ "$slots" -gt 0 ] 2>/dev/null || return 1
  # `enrolled_generations` is a JSON array of numbers; count its elements.
  enrolled="$("${TILO_ROLLBACK_BIN:-/usr/libexec/tilo/tilo-rollback}" status --device "$dev" --json 2>/dev/null \
             | sed -n 's/.*"enrolled_generations":\[\([^]]*\)\].*/\1/p' \
             | tr ',' '\n' | grep -c '[0-9]')"
  [ -n "$enrolled" ] || enrolled=0
  [ "$slots" -gt "$enrolled" ]
}

# Refuse to discard the fallback unless the machine is demonstrably usable.
#
# Each check exists because a machine that fails it is one you want to be able to
# roll back FROM. `is-system-running` reporting `degraded` means some unit failed
# on this boot, which is exactly the situation where the previous generation
# should stay bootable.
rollback_system_is_healthy() {
  local state
  state="$(systemctl is-system-running 2>/dev/null || true)"
  case "$state" in
    running) : ;;
    *)
      warn "system state is '$state', not 'running' — not confirming this generation"
      systemctl --failed --no-legend --plain 2>/dev/null | sed 's/^/tilo-rollback:   failed: /'
      return 1
      ;;
  esac
  if ! systemctl is-active --quiet greetd.service; then
    warn "greetd is not active — the session never came up, so this generation is not confirmed"
    return 1
  fi
  return 0
}

# Parse the generation number out of a command line string.
#
# Split from the file read so it can be tested (os/tests/rollback-wrappers.sh)
# rather than only exercised on a booted machine.
rollback_generation_from() {
  printf '%s' "$1" | tr ' \t' '\n\n' | sed -n 's/^tilo\.generation=\([0-9][0-9]*\)$/\1/p' | head -1
}

# The generation number of the running system, from the sealed command line.
rollback_running_generation() {
  rollback_generation_from "$(cat /proc/cmdline 2>/dev/null || true)"
}
