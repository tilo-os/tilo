#!/usr/bin/python3
"""tilo-codec-pack: the opt-in "additional codecs" pack.

    tilo-codec-pack install    opt in, then download, verify and merge the pack
    tilo-codec-pack remove     opt out: unmerge and delete everything it added
    tilo-codec-pack refresh    re-resolve the pack for the booted base (no-op
                               unless the owner opted in)
    tilo-codec-pack guard      boot-time, offline: park a Mesa extension built
                               for a different base Mesa before systemd-sysext
                               merges it
    tilo-codec-pack status     print the status JSON

The Tilo image ships no patented codecs. When the owner asks for them, this
helper downloads the packages on the device from the third parties that publish
them -- RPM Fusion (free, plus nonfree only for Intel's media driver) and
Cisco's OpenH264 builds through Fedora's fedora-cisco-openh264 repository -- and
turns them into two local systemd-sysext directory images:

    tilo-codecs        GStreamer freeworld/ugly plugins, libavcodec-freeworld,
                       OpenH264 and its GStreamer plugin, intel-media-driver
    tilo-codecs-mesa   RPM Fusion's freeworld Mesa VA-API drivers

Tilo neither hosts nor redistributes any of these files.

Every downloaded RPM is checked against the pinned OpenPGP fingerprint of the
repository it may come from, in an isolated keyring containing only the keys
shipped in the image (RPM Fusion) or in the base (Fedora). Nothing in the pack
may replace a package the base has installed: dependencies must be satisfied by
the base, which keeps the pack from silently upgrading half of /usr.

The freeworld Mesa driver has to be built from exactly the Mesa version the base
runs, because it brings its own libgallium-<version>.so which then serves every
Mesa client. It lives in a separate extension so a mismatch can only ever turn
hardware H.264/HEVC off, never break graphics: without an exact match the Mesa
extension stays disabled and the status says it is waiting; the boot guard parks
a Mesa extension whose recorded version differs from the booted base.

See /usr/share/doc/tilo/codec-pack.md.
"""

from __future__ import annotations

import base64
import contextlib
import dataclasses
import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path, PurePosixPath

COMMANDS = ("install", "remove", "refresh", "guard", "status")

CODECS = "tilo-codecs"
MESA = "tilo-codecs-mesa"
EXTENSIONS = (CODECS, MESA)

# The pinned signing keys. RPM Fusion's 2020 keys sign every Fedora release
# from 32 on; the Fedora primary key is per release and comes from the base.
# A Fedora release without a pinned key here cannot get the pack until the
# image ships one: failing closed is the point.
RPMFUSION_FREE_FPR = "e9a491a3de247814e7e067eae06f8ecdd651ff2e"
RPMFUSION_NONFREE_FPR = "79bdb88f9bbf73910fd4095b6a2af96194843c65"
FEDORA_PRIMARY_FPR = {
    "44": "36f612dcf27f7d1a48a835e4dbfcf71c6d9f90a6",
}

# Top-level packages of each extension and the base package whose version each
# one follows. `exact`: only the base's own version is acceptable. `compatible`:
# the base's version, else the newest older build of the same major.minor (an
# older plugin against a newer core is the direction these libraries keep
# compatible). `newest`: no base counterpart.
@dataclasses.dataclass(frozen=True)
class Component:
    name: str
    rule: str
    follows: str | None = None
    arches: tuple[str, ...] = ()


CODEC_COMPONENTS = (
    Component("gstreamer1-plugins-bad-freeworld", "compatible", "gstreamer1"),
    Component("gstreamer1-plugins-ugly", "compatible", "gstreamer1"),
    Component("gstreamer1-plugin-openh264", "compatible", "gstreamer1"),
    Component("openh264", "newest"),
    Component("libavcodec-freeworld", "compatible", "libavcodec-free"),
    Component("intel-media-driver", "newest", arches=("x86_64",)),
)
MESA_COMPONENTS = (
    Component("mesa-va-drivers-freeworld", "exact", "mesa-dri-drivers"),
)
BASE_MESA_PACKAGE = "mesa-dri-drivers"

WAITING_MESSAGE = "Hardware H.264/HEVC is waiting for a matching Mesa build from RPM Fusion."

ARCHITECTURES = {"x86_64": "x86-64", "aarch64": "arm64"}

STATES = ("not-installed", "installing", "installed", "removing", "failed")
MESA_STATES = ("off", "enabled", "waiting", "unsupported")

# Where the booted-base guard parks a Mesa extension it must not merge, so a
# rollback to the deployment it was built for can restore it offline.
MAX_PARKED = 3


class PackError(Exception):
    """A failure the status file reports to the owner."""


# ---------------------------------------------------------------------------
# Pure logic
# ---------------------------------------------------------------------------

def parse_command(argv: list[str]) -> str:
    """Exactly one argument, from the fixed verb list. Nothing else is accepted."""
    if len(argv) != 1:
        raise PackError("expected exactly one command")
    command = argv[0]
    if command not in COMMANDS:
        raise PackError(f"unknown command; expected one of {', '.join(COMMANDS)}")
    return command


def _vercmp_segments(value: str) -> list[str]:
    return re.findall(r"~|\^|[0-9]+|[A-Za-z]+", value)


def rpmvercmp(left: str, right: str) -> int:
    """rpm's version comparison (tilde sorts first, caret after the base)."""
    if left == right:
        return 0
    a = _vercmp_segments(left)
    b = _vercmp_segments(right)
    while a or b:
        x = a.pop(0) if a else None
        y = b.pop(0) if b else None
        if x == "~" or y == "~":
            if x != y:
                return -1 if x == "~" else 1
            continue
        if x == "^" or y == "^":
            if x is None:
                return -1
            if y is None:
                return 1
            if x != y:
                return -1 if x == "^" else 1
            continue
        if x is None:
            return -1
        if y is None:
            return 1
        if x.isdigit() != y.isdigit():
            return 1 if x.isdigit() else -1
        if x.isdigit():
            xi, yi = int(x), int(y)
            if xi != yi:
                return 1 if xi > yi else -1
        elif x != y:
            return 1 if x > y else -1
    return 0


@dataclasses.dataclass(frozen=True, order=False)
class Nevra:
    name: str
    epoch: int
    version: str
    release: str
    arch: str
    repo: str = ""

    @property
    def evr(self) -> str:
        prefix = f"{self.epoch}:" if self.epoch else ""
        return f"{prefix}{self.version}-{self.release}"

    @property
    def spec(self) -> str:
        return f"{self.name}-{self.evr}.{self.arch}"

    def compare(self, other: "Nevra") -> int:
        if self.epoch != other.epoch:
            return 1 if self.epoch > other.epoch else -1
        return rpmvercmp(self.version, other.version) or rpmvercmp(self.release, other.release)


def parse_nevra_line(line: str) -> Nevra | None:
    fields = line.split()
    if len(fields) != 6:
        return None
    name, epoch, version, release, arch, repo = fields
    return Nevra(name, int(epoch) if epoch.isdigit() else 0, version, release, arch, repo)


def newest(candidates: list[Nevra]) -> Nevra | None:
    best: Nevra | None = None
    for candidate in candidates:
        if best is None or candidate.compare(best) > 0:
            best = candidate
    return best


def _major_minor(version: str) -> tuple[str, ...]:
    return tuple(version.split(".")[:2])


def choose_candidate(rule: str, base_version: str | None, candidates: list[Nevra]) -> Nevra | None:
    """The build of one component to install on this base, or None to wait.

    Epochs are ignored when comparing with the base: RPM Fusion's GStreamer
    plugins carry epoch 1 where Fedora's core has none.
    """
    if rule == "newest":
        return newest(candidates)
    if base_version is None:
        return None
    exact = [c for c in candidates if c.version == base_version]
    if exact:
        return newest(exact)
    if rule == "exact":
        return None
    if rule != "compatible":
        raise ValueError(f"unknown rule {rule}")
    older = [
        c for c in candidates
        if _major_minor(c.version) == _major_minor(base_version)
        and rpmvercmp(c.version, base_version) < 0
    ]
    return newest(older)


@dataclasses.dataclass(frozen=True)
class MesaDecision:
    action: str  # "enable" | "wait" | "unsupported"
    candidate: Nevra | None
    message: str


def decide_mesa(base_mesa: Nevra | None, candidates: list[Nevra]) -> MesaDecision:
    """Lockstep: the freeworld drivers must be built from the base's Mesa version."""
    if base_mesa is None:
        return MesaDecision("unsupported", None, "The base image has no Mesa drivers.")
    match = choose_candidate("exact", base_mesa.version, candidates)
    if match is not None:
        return MesaDecision("enable", match, f"Freeworld Mesa {match.evr} matches the base Mesa {base_mesa.evr}.")
    offered = ", ".join(sorted({c.version for c in candidates})) or "none"
    return MesaDecision(
        "wait",
        None,
        f"{WAITING_MESSAGE} Base Mesa is {base_mesa.version}; RPM Fusion offers {offered}.",
    )


def guard_decision(merged_version: str | None, base_version: str | None, parked: list[str]) -> tuple[str, str | None]:
    """What the offline boot guard does with the Mesa extension.

    Returns ("keep" | "park" | "restore" | "none", version).
    """
    if merged_version is not None:
        if base_version is not None and merged_version == base_version:
            return ("keep", merged_version)
        return ("park", merged_version)
    if base_version is not None and base_version in parked:
        return ("restore", base_version)
    return ("none", None)


def extension_release(os_id: str, version_id: str, architecture: str, extra: dict[str, str]) -> str:
    """The contents of usr/lib/extension-release.d/extension-release.<name>."""
    for value in (os_id, version_id, architecture, *extra.values()):
        if not re.fullmatch(r"[A-Za-z0-9._:~^+-]+", value):
            raise PackError(f"refusing unsafe extension-release value {value!r}")
    lines = [
        f"ID={os_id}",
        f"VERSION_ID={version_id}",
        f"ARCHITECTURE={architecture}",
        "SYSEXT_SCOPE=system",
    ]
    for key in sorted(extra):
        if not re.fullmatch(r"TILO_[A-Z0-9_]+", key):
            raise PackError(f"refusing extension-release key {key!r}")
        lines.append(f"{key}={extra[key]}")
    return "\n".join(lines) + "\n"


def parse_os_release(text: str) -> dict[str, str]:
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip().strip("\"'")
    return values


def next_state(current: str, event: str, *, installed: bool = False) -> str:
    """The pack's user-visible state after an event.

    A failed background refresh of a working pack leaves it installed (the
    error is reported separately); a failed install or removal is "failed".
    """
    if current not in STATES:
        current = "not-installed"
    table = {
        "install-started": "installing",
        "refresh-started": "installing" if not installed else "installed",
        "remove-started": "removing",
        "removed": "not-installed",
        "succeeded": "installed",
    }
    if event in table:
        return table[event]
    if event == "failed":
        if current == "removing":
            return "failed"
        # The previous extension is still merged and still works.
        return "installed" if installed else "failed"
    raise ValueError(f"unknown event {event}")


def openpgp_fingerprint(armored: str) -> str:
    """The v4 fingerprint of the primary key in an ASCII-armoured public key."""
    body = []
    inside = False
    for line in armored.splitlines():
        line = line.strip()
        if line.startswith("-----BEGIN PGP PUBLIC KEY BLOCK"):
            inside = True
            continue
        if line.startswith("-----END PGP PUBLIC KEY BLOCK"):
            break
        if not inside or not line or ":" in line and not body:
            continue
        if line.startswith("="):
            break
        body.append(line)
    data = base64.b64decode("".join(body))
    if not data:
        raise PackError("empty key")
    tag_byte = data[0]
    if not tag_byte & 0x80:
        raise PackError("not an OpenPGP packet")
    if tag_byte & 0x40:  # new format
        tag = tag_byte & 0x3F
        first = data[1]
        if first < 192:
            length, offset = first, 2
        elif first < 224:
            length, offset = ((first - 192) << 8) + data[2] + 192, 3
        elif first == 255:
            length, offset = int.from_bytes(data[2:6], "big"), 6
        else:
            raise PackError("partial-length key packet")
    else:  # old format
        tag = (tag_byte >> 2) & 0x0F
        kind = tag_byte & 0x03
        size = {0: 1, 1: 2, 2: 4}.get(kind)
        if size is None:
            raise PackError("indeterminate-length key packet")
        length, offset = int.from_bytes(data[1:1 + size], "big"), 1 + size
    if tag != 6:
        raise PackError("first packet is not a public key")
    packet = data[offset:offset + length]
    if len(packet) != length or not packet or packet[0] != 4:
        raise PackError("only v4 public keys are supported")
    return hashlib.sha1(b"\x99" + length.to_bytes(2, "big") + packet).hexdigest()


def parse_checksig(output: str) -> tuple[bool, set[str]]:
    """(all checks OK, signing fingerprints) from `rpmkeys -Kv` output."""
    ok = True
    fingerprints = set()
    saw_signature = False
    for line in output.splitlines()[1:]:
        line = line.strip()
        if not line:
            continue
        if not line.endswith(": OK"):
            ok = False
        match = re.search(r"signature, key fingerprint: ([0-9a-f]{40}): OK$", line)
        if match:
            saw_signature = True
            fingerprints.add(match.group(1))
    return ok and saw_signature, fingerprints


def expected_fingerprints(repo: str, version_id: str) -> set[str]:
    """Which key may sign a package from a given repository id."""
    if repo.startswith("rpmfusion-free"):
        return {RPMFUSION_FREE_FPR}
    if repo.startswith("rpmfusion-nonfree"):
        return {RPMFUSION_NONFREE_FPR}
    if repo in ("fedora", "updates", "fedora-cisco-openh264"):
        fpr = FEDORA_PRIMARY_FPR.get(version_id)
        return {fpr} if fpr else set()
    return set()


def archive_name(name: str) -> str:
    """An rpm2archive member name ("./usr/...") as a relative path."""
    return name.removeprefix("./").lstrip("/")


def inside(tree: Path, target: Path) -> bool:
    """Whether writing `target` stays in `tree`, even through earlier symlinks."""
    try:
        target.parent.resolve().relative_to(tree.resolve())
    except ValueError:
        return False
    return True


def safe_member(name: str) -> PurePosixPath | None:
    """The in-tree path for an archive member, or None to drop it.

    Only /usr is part of a system extension. Build-id links are debugging
    metadata the base owns for its own files. Anything that escapes the tree is
    rejected outright rather than dropped.
    """
    path = PurePosixPath(archive_name(name))
    if any(part == ".." for part in path.parts):
        raise PackError(f"archive member escapes the tree: {name}")
    if not path.parts or path.parts[0] != "usr":
        return None
    if path.parts[:3] == ("usr", "lib", ".build-id"):
        return None
    return path


def relocation_dirs(ld_conf_text: str) -> list[PurePosixPath]:
    """Private library directories an RPM gives precedence via ld.so.conf.d.

    RPM Fusion's freeworld builds put a same-soname library (libgallium,
    libavcodec) into a private directory and list it in /etc/ld.so.conf.d so it
    wins over the base's copy. A system extension cannot change /etc; putting
    the library at the base's own path in /usr/lib64 has the same effect.
    """
    dirs = []
    for line in ld_conf_text.splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        path = PurePosixPath(line)
        if path.is_absolute() and path.parent in (PurePosixPath("/usr/lib64"), PurePosixPath("/usr/lib")):
            dirs.append(path)
    return dirs


# ---------------------------------------------------------------------------
# The machine
# ---------------------------------------------------------------------------

@dataclasses.dataclass(frozen=True)
class Layout:
    root: Path = Path("/")

    def at(self, path: str) -> Path:
        return self.root / path.lstrip("/")

    @property
    def state(self) -> Path:
        return self.at("/var/lib/tilo/codec-pack")

    @property
    def status(self) -> Path:
        return self.state / "status.json"

    @property
    def desired(self) -> Path:
        return self.state / "enabled"

    @property
    def parked(self) -> Path:
        return self.state / "parked"

    @property
    def cache(self) -> Path:
        return self.at("/var/cache/tilo-codec-pack")

    @property
    def extensions(self) -> Path:
        return self.at("/var/lib/extensions")

    @property
    def data(self) -> Path:
        return self.at("/usr/share/tilo/codec-pack")

    @property
    def os_release(self) -> Path:
        return self.at("/usr/lib/os-release")

    @property
    def fedora_keys(self) -> Path:
        return self.at("/etc/pki/rpm-gpg")


def run(argv: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(argv, capture_output=True, text=True, check=False)
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().splitlines()[-5:]
        raise PackError(f"{argv[0]} failed: {' '.join(detail)[:400]}")
    return result


def now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_status(layout: Layout) -> dict:
    try:
        value = json.loads(layout.status.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def write_status(layout: Layout, **changes) -> dict:
    status = read_status(layout)
    status.update(changes)
    status["schema"] = 1
    status["updated"] = now()
    status["desired"] = layout.desired.exists()
    layout.state.mkdir(parents=True, exist_ok=True)
    os.chmod(layout.state, 0o755)
    fd, name = tempfile.mkstemp(dir=layout.state, prefix=".status.")
    with os.fdopen(fd, "w") as handle:
        json.dump(status, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.chmod(name, 0o644)
    os.replace(name, layout.status)
    return status


@contextlib.contextmanager
def locked(layout: Layout):
    layout.state.mkdir(parents=True, exist_ok=True)
    with open(layout.state / "lock", "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


@dataclasses.dataclass(frozen=True)
class Base:
    os_id: str
    version_id: str
    rpm_arch: str
    installed: dict[str, Nevra]

    @property
    def architecture(self) -> str:
        return ARCHITECTURES[self.rpm_arch]

    def version_of(self, name: str | None) -> str | None:
        if name is None or name not in self.installed:
            return None
        return self.installed[name].version


def probe_base(layout: Layout) -> Base:
    release = parse_os_release(layout.os_release.read_text())
    os_id, version_id = release.get("ID", ""), release.get("VERSION_ID", "")
    if os_id != "fedora" or not version_id.isdigit():
        raise PackError(f"the codec pack needs a Fedora base, found {os_id} {version_id}")
    rpm_arch = os.uname().machine
    if rpm_arch not in ARCHITECTURES:
        raise PackError(f"the codec pack does not support {rpm_arch}")
    output = run(["rpm", "--root", str(layout.root), "-qa", "--qf",
                  "%{NAME} %{EPOCHNUM} %{VERSION} %{RELEASE} %{ARCH} base\n"]).stdout
    installed = {}
    for line in output.splitlines():
        nevra = parse_nevra_line(line)
        if nevra is not None and nevra.arch in (rpm_arch, "noarch"):
            installed[nevra.name] = nevra
    return Base(os_id, version_id, rpm_arch, installed)


class Dnf:
    """dnf5 against the pack's own repository definitions, never /etc's."""

    def __init__(self, layout: Layout, base: Base):
        self.layout = layout
        self.base = base
        cache = layout.cache
        self.prefix = [
            "dnf5", "--assumeyes", "--quiet", "--no-plugins",
            f"--releasever={base.version_id}",
            f"--setopt=reposdir={layout.data / 'repos.d'}",
            f"--setopt=cachedir={cache / 'dnf'}",
            f"--setopt=system_cachedir={cache / 'dnf'}",
            f"--setopt=logdir={cache / 'log'}",
            f"--setopt=system_state_dir={cache / 'state'}",
            f"--setopt=varsdir={layout.data / 'vars'}",
            "--setopt=install_weak_deps=False",
            "--setopt=gpgcheck=True",
        ]
        if layout.root != Path("/"):
            self.prefix.append(f"--installroot={layout.root}")
            self.prefix.append("--use-host-config")

    def repo_ids(self) -> list[str]:
        ids = []
        for repo in sorted((self.layout.data / "repos.d").glob("*.repo")):
            ids.extend(re.findall(r"^\[([A-Za-z0-9._-]+)\]\s*$", repo.read_text(), re.MULTILINE))
        return ids

    def base_excludes(self) -> list[str]:
        """Nothing the base installed may be replaced, only depended on."""
        names = ",".join(sorted(self.base.installed))
        return [f"--setopt={repo}.excludepkgs={names}" for repo in self.repo_ids()] if names else []

    def candidates(self, names: list[str]) -> dict[str, list[Nevra]]:
        output = run(self.prefix + ["repoquery", "--available", "--qf",
                                    "%{name} %{epoch} %{version} %{release} %{arch} %{repoid}\n", *names]).stdout
        found: dict[str, list[Nevra]] = {name: [] for name in names}
        for line in output.splitlines():
            nevra = parse_nevra_line(line)
            if nevra and nevra.name in found and nevra.arch in (self.base.rpm_arch, "noarch"):
                found[nevra.name].append(nevra)
        return found

    def download(self, specs: list[str], destdir: Path) -> list[Path]:
        destdir.mkdir(parents=True, exist_ok=True)
        run(self.prefix + self.base_excludes()
            + ["download", "--resolve", f"--arch={self.base.rpm_arch}", "--arch=noarch",
               f"--destdir={destdir}", *specs])
        return sorted(destdir.glob("*.rpm"))

    def origins(self, rpms: list[Path]) -> dict[str, str]:
        """Repository id of each downloaded package, from repository metadata."""
        names = sorted({rpm_header(path)["name"] for path in rpms})
        found = {}
        for nevras in self.candidates(names).values():
            for nevra in nevras:
                found[f"{nevra.name}-{nevra.version}-{nevra.release}.{nevra.arch}"] = nevra.repo
        return found


def rpm_header(path: Path) -> dict[str, str]:
    output = run(["rpm", "-qp", "--nosignature", "--nodigest", "--qf",
                  "%{NAME}\t%{VERSION}\t%{RELEASE}\t%{ARCH}\t%{LICENSE}\t%{VENDOR}\n", str(path)]).stdout
    name, version, release, arch, licence, vendor = output.rstrip("\n").split("\t")
    return {"name": name, "version": version, "release": release, "arch": arch,
            "license": licence, "vendor": vendor, "nvra": f"{name}-{version}-{release}.{arch}"}


class Keyring:
    """An isolated rpm keyring holding only the pinned keys for this release."""

    def __init__(self, layout: Layout, base: Base, workdir: Path):
        self.defines = [
            "--define", "_keyring fs",
            "--define", f"_keyringpath {workdir / 'keys'}",
            "--define", f"_dbpath {workdir / 'db'}",
            "--define", "_pkgverify_level signature",
        ]
        fedora_fpr = FEDORA_PRIMARY_FPR.get(base.version_id)
        if fedora_fpr is None:
            raise PackError(f"no pinned Fedora {base.version_id} signing key in this image")
        keys = {
            layout.data / "keys" / "RPM-GPG-KEY-rpmfusion-free-fedora-2020": RPMFUSION_FREE_FPR,
            layout.data / "keys" / "RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020": RPMFUSION_NONFREE_FPR,
            layout.fedora_keys / f"RPM-GPG-KEY-fedora-{base.version_id}-primary": fedora_fpr,
        }
        for path, pinned in keys.items():
            actual = openpgp_fingerprint(path.read_text())
            if actual != pinned:
                raise PackError(f"{path.name} has fingerprint {actual}, expected {pinned}")
            run(["rpmkeys", *self.defines, "--import", str(path)])
        self.version_id = base.version_id

    def verify(self, path: Path, repo: str) -> str:
        result = run(["rpmkeys", *self.defines, "-Kv", str(path)], check=False)
        ok, fingerprints = parse_checksig(result.stdout)
        if result.returncode != 0 or not ok:
            raise PackError(f"{path.name}: signature check failed")
        allowed = expected_fingerprints(repo, self.version_id)
        if not fingerprints or not fingerprints <= allowed:
            raise PackError(f"{path.name} from {repo or 'an unknown repository'} is not signed by that repository's key")
        return sorted(fingerprints)[0]


def extract_rpm(path: Path, tree: Path, ld_conf: list[str]) -> None:
    archive = subprocess.Popen(["rpm2archive", "-n", "-"], stdin=path.open("rb"), stdout=subprocess.PIPE)
    try:
        with tarfile.open(fileobj=archive.stdout, mode="r|") as tar:
            for member in tar:
                raw = PurePosixPath(archive_name(member.name))
                if raw.parts[:2] == ("etc", "ld.so.conf.d") and member.isfile():
                    handle = tar.extractfile(member)
                    if handle is not None:
                        ld_conf.append(handle.read().decode("utf-8", "replace"))
                    continue
                relative = safe_member(member.name)
                if relative is None:
                    continue
                target = tree / relative
                if not inside(tree, target):
                    raise PackError(f"{path.name}: {member.name} would be written outside the tree")
                if member.isdir():
                    target.mkdir(parents=True, exist_ok=True)
                    os.chmod(target, 0o755)
                elif member.issym():
                    target.parent.mkdir(parents=True, exist_ok=True)
                    if target.is_symlink() or target.exists():
                        target.unlink()
                    os.symlink(member.linkname, target)
                elif member.isfile():
                    target.parent.mkdir(parents=True, exist_ok=True)
                    handle = tar.extractfile(member)
                    if handle is None:
                        raise PackError(f"{path.name}: unreadable member {member.name}")
                    with open(target, "wb") as out:
                        shutil.copyfileobj(handle, out)
                    # No set-id bits and no writable-by-others files, ever.
                    os.chmod(target, 0o755 if member.mode & 0o111 else 0o644)
                elif member.islnk():
                    source = safe_member(member.linkname)
                    if source is None:
                        raise PackError(f"{path.name}: hard link outside /usr: {member.name}")
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(tree / source, target)
                else:
                    raise PackError(f"{path.name}: unsupported member type {member.name}")
    finally:
        if archive.stdout:
            archive.stdout.close()
        if archive.wait() != 0:
            raise PackError(f"rpm2archive failed on {path.name}")


def relocate_private_libraries(tree: Path, ld_conf: list[str]) -> list[str]:
    moved = []
    for text in ld_conf:
        for directory in relocation_dirs(text):
            source = tree / str(directory).lstrip("/")
            if not source.is_dir():
                continue
            destination = source.parent
            for entry in sorted(source.iterdir()):
                if not entry.name.startswith("lib") or ".so" not in entry.name:
                    continue
                target = destination / entry.name
                if target.is_symlink() or target.exists():
                    target.unlink()
                os.replace(entry, target)
                # Whatever pointed at the private copy (the VA drivers are
                # symlinks to libgallium) keeps resolving, to the moved file.
                os.symlink(f"../{entry.name}", entry)
                moved.append(f"/{target.relative_to(tree)}")
    return moved


def relabel(tree: Path) -> None:
    """Label the tree as the files it overlays would be, when SELinux is on."""
    contexts = Path("/etc/selinux/targeted/contexts/files/file_contexts")
    if not Path("/sys/fs/selinux/enforce").exists() or not contexts.exists() or not shutil.which("setfiles"):
        return
    run(["setfiles", "-F", "-r", str(tree), str(contexts), str(tree)])


def build_extension(layout: Layout, base: Base, name: str, rpms: list[dict], extra: dict[str, str]) -> None:
    """Assemble a directory sysext next to the live one, then swap it in."""
    layout.extensions.mkdir(parents=True, exist_ok=True)
    staging = layout.extensions / f".{name}.new"
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(mode=0o755)
    ld_conf: list[str] = []
    for rpm in rpms:
        extract_rpm(Path(rpm["path"]), staging, ld_conf)
    relocated = relocate_private_libraries(staging, ld_conf)
    release = staging / "usr/lib/extension-release.d" / f"extension-release.{name}"
    release.parent.mkdir(parents=True, exist_ok=True)
    release.write_text(extension_release(base.os_id, base.version_id, base.architecture, extra))
    os.chmod(release, 0o644)
    manifest = {
        "extension": name,
        "packages": [{k: rpm[k] for k in ("nvra", "repo", "license", "vendor", "fingerprint")} for rpm in rpms],
        "relocated": relocated,
        "built": now(),
        **{k.lower(): v for k, v in extra.items()},
    }
    (staging / "usr/share/tilo-codec-pack").mkdir(parents=True, exist_ok=True)
    (staging / "usr/share/tilo-codec-pack" / f"{name}.json").write_text(json.dumps(manifest, indent=2) + "\n")
    relabel(staging)
    live = layout.extensions / name
    old = layout.extensions / f".{name}.old"
    shutil.rmtree(old, ignore_errors=True)
    if live.exists():
        os.replace(live, old)
    os.replace(staging, live)
    shutil.rmtree(old, ignore_errors=True)


def read_extension_release(path: Path) -> dict[str, str]:
    try:
        return parse_os_release(path.read_text())
    except OSError:
        return {}


def extension_release_path(tree: Path, name: str) -> Path:
    return tree / "usr/lib/extension-release.d" / f"extension-release.{name}"


def merge(layout: Layout) -> None:
    """Ask PID 1 to (re)merge; this unit's own mount namespace must not do it."""
    if layout.root != Path("/") or not Path("/run/systemd/system").is_dir():
        return
    run(["systemctl", "enable", "systemd-sysext.service"])
    run(["systemctl", "reload-or-restart", "systemd-sysext.service"])


def bump_generation(layout: Layout) -> int:
    generation = int(read_status(layout).get("generation", 0)) + 1
    write_status(layout, generation=generation)
    return generation


def fetch(layout: Layout, base: Base, dnf: Dnf, keyring: Keyring, specs: list[str], workdir: Path) -> list[dict]:
    rpms = dnf.download(specs, workdir)
    if not rpms:
        raise PackError("nothing was downloaded")
    origins = dnf.origins(rpms)
    verified = []
    for path in rpms:
        header = rpm_header(path)
        if header["name"] in base.installed:
            raise PackError(f"{header['nvra']} would replace a base package; waiting for a base update")
        repo = origins.get(header["nvra"], "")
        fingerprint = keyring.verify(path, repo)
        verified.append({**header, "path": str(path), "repo": repo, "fingerprint": fingerprint})
    return verified


def select(components: tuple[Component, ...], base: Base, dnf: Dnf) -> tuple[list[str], list[str]]:
    """Specs to download, and components that have to wait for a matching build."""
    wanted = [c for c in components if not c.arches or base.rpm_arch in c.arches]
    wanted = [c for c in wanted if c.name not in base.installed]
    found = dnf.candidates([c.name for c in wanted]) if wanted else {}
    specs, waiting = [], []
    for component in wanted:
        choice = choose_candidate(component.rule, base.version_of(component.follows), found.get(component.name, []))
        if choice is None:
            waiting.append(component.name)
        else:
            specs.append(choice.spec)
    return specs, waiting


def park(layout: Layout, name: str, version: str) -> None:
    source = layout.extensions / name
    if not source.exists():
        return
    layout.parked.mkdir(parents=True, exist_ok=True)
    os.chmod(layout.parked, 0o700)
    target = layout.parked / f"{name}-{version}"
    shutil.rmtree(target, ignore_errors=True)
    os.replace(source, target)
    parked = sorted(layout.parked.iterdir(), key=lambda p: p.stat().st_mtime)
    for stale in parked[:-MAX_PARKED]:
        shutil.rmtree(stale, ignore_errors=True)


def parked_versions(layout: Layout, name: str) -> list[str]:
    if not layout.parked.is_dir():
        return []
    prefix = f"{name}-"
    return [p.name[len(prefix):] for p in layout.parked.iterdir() if p.name.startswith(prefix)]


def refresh(layout: Layout, *, explicit: bool) -> dict:
    if not layout.desired.exists():
        return write_status(layout, state="not-installed", mesa="off", message="")
    previous = read_status(layout)
    installed = (layout.extensions / CODECS).exists()
    write_status(layout, state=next_state(previous.get("state", "not-installed"),
                                          "install-started" if explicit else "refresh-started",
                                          installed=installed), last_error="")
    try:
        base = probe_base(layout)
        base_mesa = base.installed.get(BASE_MESA_PACKAGE)
        dnf = Dnf(layout, base)
        work = layout.cache / "work"
        shutil.rmtree(work, ignore_errors=True)
        work.mkdir(parents=True)
        os.chmod(layout.cache, 0o700)
        keyring = Keyring(layout, base, work / "keyring")

        specs, waiting = select(CODEC_COMPONENTS, base, dnf)
        if not specs:
            raise PackError("no codec packages are available for this base")
        codecs = fetch(layout, base, dnf, keyring, specs, work / "codecs")

        mesa_candidates = dnf.candidates([c.name for c in MESA_COMPONENTS]).get(MESA_COMPONENTS[0].name, [])
        decision = decide_mesa(base_mesa, mesa_candidates)
        mesa_rpms = []
        if decision.action == "enable" and decision.candidate is not None:
            mesa_rpms = fetch(layout, base, dnf, keyring, [decision.candidate.spec], work / "mesa")

        build_extension(layout, base, CODECS, codecs, {"TILO_CODEC_PACK": CODECS})
        if mesa_rpms and base_mesa is not None:
            build_extension(layout, base, MESA, mesa_rpms, {
                "TILO_CODEC_PACK": MESA,
                "TILO_MESA_VERSION": base_mesa.version,
                "TILO_BASE_MESA": base_mesa.evr,
            })
            mesa_state = "enabled"
        else:
            current = read_extension_release(extension_release_path(layout.extensions / MESA, MESA))
            if current:
                park(layout, MESA, current.get("TILO_MESA_VERSION", "unknown"))
            mesa_state = "waiting" if decision.action == "wait" else "unsupported"
        merge(layout)
        shutil.rmtree(work, ignore_errors=True)
        generation = bump_generation(layout)
        return write_status(
            layout,
            state="installed",
            mesa=mesa_state,
            message=decision.message if mesa_state != "enabled" else "",
            waiting=waiting,
            base={"version_id": base.version_id, "mesa": base_mesa.evr if base_mesa else None},
            packages={CODECS: [r["nvra"] for r in codecs], MESA: [r["nvra"] for r in mesa_rpms]},
            generation=generation,
        )
    except (PackError, OSError, ValueError) as error:
        state = next_state(read_status(layout).get("state", ""), "failed",
                           installed=(layout.extensions / CODECS).exists())
        write_status(layout, state=state, last_error=str(error))
        raise


def remove(layout: Layout) -> dict:
    write_status(layout, state="removing")
    with contextlib.suppress(FileNotFoundError):
        layout.desired.unlink()
    for name in EXTENSIONS:
        shutil.rmtree(layout.extensions / name, ignore_errors=True)
        shutil.rmtree(layout.extensions / f".{name}.new", ignore_errors=True)
        shutil.rmtree(layout.extensions / f".{name}.old", ignore_errors=True)
    shutil.rmtree(layout.parked, ignore_errors=True)
    shutil.rmtree(layout.cache, ignore_errors=True)
    merge(layout)
    bump_generation(layout)
    return write_status(layout, state="not-installed", mesa="off", message="", waiting=[],
                        packages={}, last_error="")


def guard(layout: Layout) -> dict:
    """Offline, before systemd-sysext: never merge Mesa built for another base."""
    base_version = None
    output = run(["rpm", "--root", str(layout.root), "-q", "--qf", "%{VERSION}", BASE_MESA_PACKAGE], check=False)
    if output.returncode == 0:
        base_version = output.stdout.strip() or None
    release = read_extension_release(extension_release_path(layout.extensions / MESA, MESA))
    merged = release.get("TILO_MESA_VERSION") if release else None
    if release and merged is None:
        merged = "unknown"
    action, version = guard_decision(merged, base_version, parked_versions(layout, MESA))
    if action == "park" and version is not None:
        park(layout, MESA, version)
        return write_status(layout, mesa="waiting",
                            message=f"{WAITING_MESSAGE} The Mesa part built for {version} was set aside.")
    if action == "restore" and version is not None:
        os.replace(layout.parked / f"{MESA}-{version}", layout.extensions / MESA)
        return write_status(layout, mesa="enabled", message="")
    return read_status(layout)


def main(argv: list[str]) -> int:
    try:
        command = parse_command(argv)
    except PackError as error:
        print(f"tilo-codec-pack: {error}", file=sys.stderr)
        return 2
    layout = Layout()
    if command == "status":
        print(json.dumps(read_status(layout) or {"schema": 1, "state": "not-installed", "mesa": "off"},
                         indent=2, sort_keys=True))
        return 0
    if os.geteuid() != 0:
        print("tilo-codec-pack: must run as root (start tilo-codec-pack@<command>.service)", file=sys.stderr)
        return 2
    os.umask(0o022)
    try:
        with locked(layout):
            if command == "install":
                layout.state.mkdir(parents=True, exist_ok=True)
                layout.desired.write_text("owner opted in\n")
                os.chmod(layout.desired, 0o644)
                refresh(layout, explicit=True)
            elif command == "refresh":
                refresh(layout, explicit=False)
            elif command == "remove":
                remove(layout)
            elif command == "guard":
                guard(layout)
    except (PackError, OSError, ValueError) as error:
        print(f"tilo-codec-pack: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
