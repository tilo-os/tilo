#!/usr/bin/bash
# Prepare, but never silently install, Tilo's singleton Windows fallback.
#
# Tilo does not redistribute Windows or collect product keys.  The owner gives
# this command an ISO; Windows Setup receives its licence directly in the
# explicit provisioning console.  A product key must never be passed on argv,
# stored in the manifest, or copied into the guest-tools ISO.
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
readonly ROOT='/var/lib/tilo/windows'
readonly GUEST_SOURCE='/usr/share/tilo/windows/guest'
readonly DISK="$ROOT/system.qcow2"
readonly INSTALL_MEDIA="$ROOT/install-media.iso"
readonly TOOLS_MEDIA="$ROOT/tilo-guest-tools.iso"
readonly VIRTIO_DRIVERS_MEDIA='/usr/share/virtio-win/virtio-win.iso'
readonly VIRTIO_GUEST_TOOLS='/usr/share/virtio-win/installer/virtio-win-guest-tools.exe'
readonly STATE="$ROOT/session/state.json"
readonly UUID_FILE="$ROOT/domain.uuid"
readonly SECRET="$ROOT/bridge/bootstrap.secret"
readonly VM_CONTROL='/usr/libexec/tilo-windows-vm-control'
stage=''

die() { printf '%s\n' "tilo-windows-provision: $*" >&2; exit 1; }
usage() {
    cat <<'EOF'
Usage: tilo-windows-provision prepare --iso /absolute/path/to/windows.iso
       tilo-windows-provision assert

`prepare` creates the one protected appliance disk and a guest-tools ISO. It
starts the headless singleton, but does not open a desktop, transmit an ISO over
the network, or accept a licence key. Open the owner-authorised provisioning
console to complete Windows Setup, and type a product key directly into Windows
if one is required.
EOF
}

require_root() { [ "${EUID}" -eq 0 ] || die 'must run as root'; }
canonical_regular_file() {
    local path
    path="$(readlink -f -- "$1")" || die 'could not canonicalize ISO path'
    [ "${path#/}" != "$path" ] && [ -f "$path" ] && [ -r "$path" ] \
        || die 'ISO must be a readable regular file at an absolute path'
    printf '%s\n' "$path"
}

prepare() {
    [ "$#" -eq 2 ] && [ "$1" = '--iso' ] || { usage >&2; return 2; }
    local source_iso digest uuid
    case "$2" in /*) ;; *) die 'ISO argument must be an absolute path' ;; esac
    source_iso="$(canonical_regular_file "$2")"
    [ -d "$GUEST_SOURCE" ] || die "missing immutable guest setup payload"
    [ -r "$VIRTIO_DRIVERS_MEDIA" ] || die "the packaged virtio-win driver ISO is missing"
    [ -r "$VIRTIO_GUEST_TOOLS" ] || die "the packaged virtio-win guest-tools installer is missing"
    command -v qemu-img >/dev/null || die 'qemu-img is not installed'
    command -v xorriso >/dev/null || die 'xorriso is not installed'
    [ -x "$VM_CONTROL" ] || die 'the singleton VM controller is not installed'

    # The active Tilo owner is in tilo-identity. It may authenticate the
    # host-only guest bridge and update non-secret readiness/pin state, while
    # Windows media, disk, and NVRAM remain root-only.
    install -d -m 0750 -o root -g tilo-identity "$ROOT" "$ROOT/bridge"
    install -d -m 0770 -o root -g tilo-identity "$ROOT/session"
    # A second appliance would merge two Windows security domains. Refuse both
    # partial and complete prior state; this tool never resets an appliance.
    [ ! -e "$DISK" ] && [ ! -e "$INSTALL_MEDIA" ] && [ ! -e "$STATE" ] \
        || die 'an appliance already exists; Tilo does not reset it from this tool'

    umask 077
    stage="$(mktemp -d "$ROOT/.guest-tools.XXXXXX")"
    trap 'rm -rf -- "${stage:-}"' EXIT
    cp -- "$GUEST_SOURCE/Install-TiloRemoteApp.ps1" "$stage/"
    cp -- "$GUEST_SOURCE/Start-TiloGuestBridge.ps1" "$stage/"
    cp -- "$GUEST_SOURCE/Start-TiloNetworkProxy.ps1" "$stage/"
    cp -- "$GUEST_SOURCE/Start-TiloRemoteApp.ps1" "$stage/"
    cp -- "$GUEST_SOURCE/Start-TiloFocusedApp.ps1" "$stage/"
    cp -- "$GUEST_SOURCE/Start-TiloInstaller.ps1" "$stage/"
    cp -- "$GUEST_SOURCE/Start-TiloUninstaller.ps1" "$stage/"
    cp -- "$GUEST_SOURCE/Tilo-ProcessJob.ps1" "$stage/"
    cp -- "$GUEST_SOURCE/Start-TiloProcessJobBroker.ps1" "$stage/"
    # Bind the copy on the separately attached Fedora virtio-win ISO to the
    # exact installer shipped by the same digest-pinned host RPM snapshot.
    sha256sum "$VIRTIO_GUEST_TOOLS" | awk '{print $1}' > "$stage/virtio-win-guest-tools.sha256"
    head -c 32 /dev/urandom > "$stage/tilo-bridge.secret"
    install -m 0640 -o root -g tilo-identity "$stage/tilo-bridge.secret" "$SECRET"
    cat > "$stage/tilo-bridge.json" <<'EOF'
{"protocolMajor":1,"bridgePort":49888,"hostOnlyGateway":"192.168.251.1","network":"192.168.251.0/24"}
EOF

    # qcow2 is allocated lazily and discard-capable; guest installation remains
    # the only writer.  The user ISO is copied once so removable media cannot
    # change underneath an in-progress installation.
    qemu-img create -f qcow2 -o compat=1.1,lazy_refcounts=on "$DISK" 128G >/dev/null
    install -m 0600 -o root -g root "$source_iso" "$INSTALL_MEDIA"
    xorriso -as mkisofs -quiet -iso-level 3 -R -J -V TILO_GUEST_TOOLS \
        -o "$TOOLS_MEDIA" "$stage"
    rm -rf -- "$stage"
    stage=''
    trap - EXIT
    chmod 0600 "$TOOLS_MEDIA"
    digest="$(sha256sum "$INSTALL_MEDIA" | awk '{print $1}')"
    uuid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    # Rename the identity into place complete: its appearance starts the
    # Windows status timer (tilo-windows-vm-egress-reaper.path).
    printf '%s\n' "$uuid" > "$UUID_FILE.new"
    chown root:tilo-identity "$UUID_FILE.new"
    chmod 0640 "$UUID_FILE.new"
    mv -f "$UUID_FILE.new" "$UUID_FILE"
    printf '{"schema_version":1,"phase":{"installing":{"media_digest":"%s"}},"license":"unknown","catalog_generation":0}\n' "$digest" > "$STATE"
    chown root:tilo-identity "$STATE"
    chmod 0660 "$STATE"

    if ! "$VM_CONTROL" start; then
        die "the appliance is prepared but could not start; retry with: $VM_CONTROL start"
    fi

    cat <<EOF
Prepared and started the headless singleton Windows appliance.
  disk: $DISK
  install media: $INSTALL_MEDIA
  guest tools: $TOOLS_MEDIA
  domain UUID: $uuid

Next: open the owner-authorised provisioning console and complete Windows
Setup. Product keys and organisation activation stay inside Windows; Tilo has
not read or retained either.
EOF
}

assert_state() {
    require_root
    [ -r "$VIRTIO_DRIVERS_MEDIA" ] || die 'the packaged virtio-win driver ISO is missing'
    [ -r "$VIRTIO_GUEST_TOOLS" ] || die 'the packaged virtio-win guest-tools installer is missing'
    [ -f "$DISK" ] && [ -f "$INSTALL_MEDIA" ] && [ -f "$TOOLS_MEDIA" ] \
        && [ -f "$STATE" ] && [ -f "$UUID_FILE" ] && [ -f "$SECRET" ] \
        || die 'appliance preparation is incomplete'
    local item mode owner
    for item in "$DISK" "$INSTALL_MEDIA" "$TOOLS_MEDIA"; do
        mode="$(stat -c '%a' "$item")"; owner="$(stat -c '%U:%G' "$item")"
        [ "$mode" = 600 ] && [ "$owner" = root:root ] \
            || die "private appliance media has unsafe ownership or mode: $item"
    done
    [ "$(stat -c '%a:%U:%G' "$UUID_FILE")" = '640:root:tilo-identity' ] \
        || die "Windows VM identity has unsafe ownership or mode: $UUID_FILE"
    [ "$(stat -c '%a:%U:%G' "$SECRET")" = '640:root:tilo-identity' ] \
        || die "Windows bridge key has unsafe ownership or mode: $SECRET"
    [ "$(stat -c '%a:%U:%G' "$STATE")" = '660:root:tilo-identity' ] \
        || die "Windows session state has unsafe ownership or mode: $STATE"
    grep -Fq '"license":"unknown"' "$STATE" \
        || die 'host provisioning state must not contain a Windows licence'
    grep -Fq '"installing"' "$STATE" || die 'unexpected provisioning state'
    printf '%s\n' 'Tilo Windows appliance preparation is private and awaiting guest setup'
}

require_root
case "${1:-}" in
    prepare) shift; prepare "$@" ;;
    assert) shift; [ "$#" -eq 0 ] || { usage >&2; exit 2; }; assert_state ;;
    -h|--help|'') usage ;;
    *) usage >&2; exit 2 ;;
esac
