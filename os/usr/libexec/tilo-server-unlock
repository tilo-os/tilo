#!/usr/bin/env bash
# Set up the unlock of this server's root with the person's other devices, the way every
# computer does: its own daemon has the person's root certify a boot key (`devices#setUpUnlock`),
# asking the person on a device that keeps the root, and their devices carry the half that opens
# the volume at boot.
#
# tilo-server-unlock.service runs it in three parts, once the daemon runs:
#
#   prepare   root: spends the install key the installer kept inside the encrypted root
#             (tilo-disk-encrypt finish --unlock owner-device) on a new key slot, and hands the
#             boot key's request to the server's account, in the unit's runtime directory.
#   register  the server's account: asks its own daemon, and waits for as long as the person
#             takes to answer.
#   finish    root: writes the token with that answer, or removes the slot again; once the
#             volume opens with the person's devices, removes the install key's slot and
#             shreds the key.
#
# A no, or no device of the person's that keeps the root within reach, leaves the install key in
# place and the unlock pending; the next boot asks again, and `tilo server status` names it
# pending meanwhile.
#
# Paths and commands are overridable so the logic runs against fakes
# (os/tests/server_unlock.sh); a boot passes none of them.
set -euo pipefail

key_dir="${TILO_SERVER_INSTALL_KEY_DIR:-/var/lib/tilo/install-key}"
key_conf="$key_dir/volume.conf"
install_key="$key_dir/luks.key"
waiting="$key_dir/waiting.json"
state_root="${TILO_SERVER_STATE_ROOT:-/var/lib/tilo/state}"
pending_marker="$state_root/sibling-unlock-pending"
auth_bin="${TILO_TILO_AUTH:-/usr/libexec/tilo/tilo-auth}"
cryptsetup_bin="${TILO_CRYPTSETUP:-cryptsetup}"
# Root in every boot; a check runs the same logic as its own account.
key_owner="${TILO_SERVER_KEY_OWNER:-0}"

log() { printf 'tilo-server-unlock: %s\n' "$*" >&2; }

# The unit's runtime directory, the server account's own: where root hands the request over and
# the account keeps its daemon's answer.
handed() {
    [ -n "${RUNTIME_DIRECTORY:-}" ] || { log "no runtime directory to hand the request over in"; return 1; }
    printf '%s' "${RUNTIME_DIRECTORY%%:*}"
}

# The install-time file, read without sourcing it: it names the volume and the one key file the
# installer left root-only in this root.
read_install_key() {
    local metadata uuid key
    [[ -f "$key_conf" && ! -L "$key_conf" ]] || return 1
    metadata="$(stat -c '%u:%a:%h:%s' -- "$key_conf" 2>/dev/null || true)"
    [[ "$metadata" =~ ^$key_owner:600:1:([0-9]+)$ ]] || return 1
    (( BASH_REMATCH[1] > 0 && BASH_REMATCH[1] <= 4096 )) || return 1
    uuid="$(sed -n 's/^luks_uuid=//p' "$key_conf")"
    key="$(sed -n 's/^key_file=//p' "$key_conf")"
    [[ "$uuid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || return 1
    [ "$key" = "$install_key" ] || return 1
    [ -f "$key" ] && [ ! -L "$key" ] || return 1
    metadata="$(stat -c '%u:%a:%h:%s' -- "$key" 2>/dev/null || true)"
    [[ "$metadata" =~ ^$key_owner:600:1:([0-9]+)$ ]] || return 1
    (( BASH_REMATCH[1] >= 32 && BASH_REMATCH[1] <= 4096 ))
    VOLUME_UUID="$uuid"
}

# What the unlock will open. The installed system finds it by the LUKS UUID; a check names it
# directly.
unlock_device() {
    if [ -n "${TILO_UNLOCK_DEVICE:-}" ]; then
        if [ ! -b "$TILO_UNLOCK_DEVICE" ] && [ "${TILO_UNLOCK_ALLOW_REGULAR:-0}" != 1 ]; then
            return 1
        fi
        printf '%s' "$TILO_UNLOCK_DEVICE"
        return 0
    fi
    printf '/dev/disk/by-uuid/%s' "$VOLUME_UUID"
}

# The volume, once the install file is one to trust: nothing to do without one, a refusal for an
# unsafe one, and pending while the volume is not there.
volume() {
    if ! read_install_key; then
        log "refusing an unsafe or malformed install-key file at $key_conf"
        return 1
    fi
    DEV="$(unlock_device)" && [ -e "$DEV" ] \
        || { log "the volume $VOLUME_UUID is not present; its unlock stays pending"; return 2; }
}

prepare() {
    [ -e "$key_conf" ] || [ -L "$key_conf" ] || return 0
    volume || return 1
    # Already set up (a boot that ended before the install key went): only that key is left.
    "$auth_bin" sibling status "$DEV" >/dev/null 2>&1 && return 0
    local dir
    dir="$(handed)" || return 1
    log "asking the person's root to certify this server's boot key"
    "$auth_bin" sibling prepare "$DEV" --key-file "$install_key" \
        --waiting "$waiting" --hand-to "$dir"
}

register() {
    local dir
    dir="$(handed)" || return 1
    # Nothing was handed over: the volume is set up already.
    [ -e "$dir/asked.json" ] || return 0
    "$auth_bin" sibling register "$dir"
}

finish() {
    [ -e "$key_conf" ] || [ -L "$key_conf" ] || return 0
    local found=0
    volume || found=$?
    [ "$found" -ne 2 ] || return 0
    [ "$found" -eq 0 ] || return 1
    if [ -e "$waiting" ]; then
        local dir
        dir="$(handed)" || return 1
        if ! "$auth_bin" sibling finish "$DEV" --key-file "$install_key" \
            --waiting "$waiting" --answer-in "$dir"; then
            log "the unlock is not set up; the next boot asks again"
            return 0
        fi
    fi
    if ! "$auth_bin" sibling status "$DEV" >/dev/null 2>&1; then
        log "the unlock is not set up; the next boot asks again"
        return 0
    fi
    # The install key's slot must not outlive the unlock that replaces it.
    if ! "$cryptsetup_bin" luksRemoveKey "$DEV" --key-file "$install_key"; then
        log "the install key slot could not be removed; it will be retried at the next boot"
        return 0
    fi
    shred -u "$install_key" 2>/dev/null || rm -f "$install_key"
    rm -f "$key_conf"
    rmdir "$key_dir" 2>/dev/null || true
    rm -f "$pending_marker"
    log "the unlock is set up with the person's devices, and the install key is removed"
}

case "${1:-}" in
    prepare) prepare ;;
    register) register ;;
    finish) finish ;;
    *) log "usage: $0 prepare|register|finish"; exit 2 ;;
esac
