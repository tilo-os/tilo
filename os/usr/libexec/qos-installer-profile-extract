#!/usr/bin/env bash
# Extract the secret-free, checksummed profile written by qOS Imager from the
# tail of the live medium. This runs as root before greetd; the UI only reads
# the validated JSON copied into /run.
set -u

readonly block_size=65536
readonly magic_expected=QOS_INSTALL_PROFILE_V1
readonly out_dir=/run/qos-installer
readonly out_file="$out_dir/profile.json"
readonly error_file="$out_dir/profile.error"

install -d -m 0755 "$out_dir"
rm -f "$out_file" "$error_file"

report_error() {
  printf '%s\n' "$*" > "$error_file"
  chmod 0644 "$error_file"
}

declare -a candidates=()
while read -r source mountpoint; do
  source="${source%%\[*}"
  [ -b "$source" ] || continue
  case "$mountpoint" in
    /|/boot|/boot/*|/sysroot|/sysroot/*|/run/initramfs/live|/run/initramfs/live/*|/run/rootfsbase|/run/rootfsbase/*) ;;
    *) continue ;;
  esac
  disk="$(lsblk -spno NAME,TYPE "$source" 2>/dev/null | awk '$2 == "disk" || $2 == "rom" { print $1; exit }')"
  [ -n "$disk" ] && candidates+=("$disk")
done < <(findmnt -rn -o SOURCE,TARGET 2>/dev/null)

# Some live-root overlay stacks hide their backing block source from findmnt.
# In that case only inspect removable whole disks. A valid profile is accepted
# only when exactly one candidate has a matching checksum.
if [ "${#candidates[@]}" -eq 0 ]; then
  while read -r disk type removable; do
    [ "$type" = disk ] && [ "$removable" = 1 ] && candidates+=("$disk")
  done < <(lsblk -dpno NAME,TYPE,RM 2>/dev/null)
fi

tmp_dir="$(mktemp -d /run/qos-installer-profile.XXXXXX)" || exit 0
trap 'rm -rf "$tmp_dir"' EXIT
valid=0

for disk in "${candidates[@]}"; do
  [ -b "$disk" ] || continue
  size="$(blockdev --getsize64 "$disk" 2>/dev/null || true)"
  case "$size" in ''|*[!0-9]*) continue ;; esac
  [ "$size" -ge "$block_size" ] || continue
  tail_file="$tmp_dir/tail-$valid"
  dd if="$disk" of="$tail_file" bs=1 skip="$((size - block_size))" count="$block_size" status=none 2>/dev/null || continue
  magic="$(sed -n '1p' "$tail_file")"
  [ "$magic" = "$magic_expected" ] || continue
  digest="$(sed -n '2p' "$tail_file")"
  length="$(sed -n '3p' "$tail_file")"
  case "$digest" in [0-9a-f][0-9a-f]*) ;; *) report_error "The installation profile checksum is malformed."; continue ;; esac
  [ "${#digest}" -eq 64 ] || { report_error "The installation profile checksum is malformed."; continue; }
  case "$length" in ''|*[!0-9]*) report_error "The installation profile length is malformed."; continue ;; esac
  header_size=$((${#magic} + ${#digest} + ${#length} + 3))
  [ "$length" -le "$((block_size - header_size))" ] || { report_error "The installation profile is too large."; continue; }
  payload="$tmp_dir/profile-$valid.json"
  dd if="$tail_file" of="$payload" bs=1 skip="$header_size" count="$length" status=none 2>/dev/null || continue
  actual="$(sha256sum "$payload" 2>/dev/null | awk '{print $1}')"
  if [ "$actual" != "$digest" ]; then
    report_error "The installation profile was damaged after it was written. Configure this device manually."
    continue
  fi
  valid=$((valid + 1))
  install -m 0644 "$payload" "$out_file.$valid"
done

if [ "$valid" -eq 1 ]; then
  mv "$out_file.1" "$out_file"
  rm -f "$error_file"
elif [ "$valid" -gt 1 ]; then
  rm -f "$out_file".*
  report_error "More than one attached device contains a qOS installation profile. Remove the extra media and reboot."
fi

exit 0
