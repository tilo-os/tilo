#!/usr/bin/bash
# Fetch, owner-verify when configured, then activate an OS update.
set -euo pipefail

BOOTC="${TILO_IMAGE_TRUST_BOOTC:-/usr/bin/bootc}"
TRUST_DIR="${TILO_IMAGE_TRUST_DIR:-/var/lib/tilo/image-trust}"
GATE="${TILO_IMAGE_TRUST_GATE:-/usr/libexec/tilo-image-trust-staged}"
UPDATE_LOCK="${TILO_IMAGE_TRUST_UPDATE_LOCK:-/run/tilo-verified-update.lock}"
SUCCESSOR="${TILO_IMAGE_TRUST_SUCCESSOR:-/usr/libexec/tilo-board-successor}"

# One lock spans download, identity verification, rollback-floor publication,
# and activation. It is taken even before owner trust is armed: `tilo-image-trust
# arm` takes the same lock, so an update cannot observe a half-published trust
# store or race past the marker while arming completes.
umask 077
if [ -L "$UPDATE_LOCK" ]; then
  echo 'tilo-verified-update: update lock must not be a symlink' >&2
  exit 1
fi
exec {update_lock_fd}>>"$UPDATE_LOCK"
lock_metadata="$(stat -Lc '%u:%a:%h' "/proc/self/fd/$update_lock_fd")"
expected_lock="$(id -u):600:1"
[ -f "/proc/self/fd/$update_lock_fd" ] \
  && [ "$lock_metadata" = "$expected_lock" ] || {
  echo 'tilo-verified-update: update lock must be caller-owned mode 0600 with one link' >&2
  exit 1
}
flock -x "$update_lock_fd"

board=0
if "$SUCCESSOR" applicable; then
  board=1
else
  result=$?
  [ "$result" -eq 3 ] || exit "$result"
fi
if [ "$board" -eq 0 ] && [ ! -e "$TRUST_DIR/required" ] && [ ! -L "$TRUST_DIR/required" ]; then
  exec "$BOOTC" upgrade "$@"
fi

# Keep the new deployment ineligible for boot until its identity endorsement
# has authenticated both the OCI manifest and measured generation.
apply=0
common=()
for argument in "$@"; do
  case "$argument" in
    --apply) apply=1 ;;
    --download-only|--download-only=*|--from-downloaded|--from-downloaded=*|--apply=*)
      echo "tilo-verified-update: phase-control argument is reserved: $argument" >&2
      exit 2
      ;;
    *) common+=("$argument") ;;
  esac
done
command=upgrade
gate_arguments=(--require-staged)
if [ "$board" -eq 1 ]; then
  now="$("$GATE" --trusted-time)"
  if selected="$("$SUCCESSOR" "$now")"; then
    readarray -t fields <<<"$selected"
    [ "${#fields[@]}" -eq 4 ] \
      && [[ "${fields[0]}" =~ ^code\.tilo\.so/tilo/tilo@sha256:[0-9a-f]{64}$ ]] \
      && [[ "${fields[1]}" =~ ^[1-9][0-9]*$ ]] \
      && [[ "${fields[2]}" =~ ^[0-9a-f]{40}$ ]] \
      && [[ "${fields[3]}" =~ ^[1-9][0-9]*$ ]] || {
      echo 'tilo-verified-update: malformed verified successor result' >&2
      exit 1
    }
  else
    result=$?
    if [ "$result" -eq 3 ]; then
      echo 'tilo-verified-update: no newer verified board release'
      exit 0
    fi
    exit "$result"
  fi
  command=switch
  gate_arguments=(--successor "${fields[0]##*@}" "${fields[1]}" "${fields[3]}" "$update_lock_fd" "$UPDATE_LOCK")
  "$BOOTC" switch --download-only "${common[@]}" "${fields[0]}"
else
  "$BOOTC" upgrade --download-only "${common[@]}"
fi
if "$GATE" "${gate_arguments[@]}"; then
  :
else
  result=$?
  if [ "$result" -eq 3 ] && [ "$board" -eq 0 ]; then
    echo 'tilo-verified-update: no new deployment to activate'
    exit 0
  fi
  exit "$result"
fi
activate=(--from-downloaded)
[ "$apply" -eq 0 ] || activate+=(--apply)
"$BOOTC" "$command" "${activate[@]}" "${common[@]}"
