#!/usr/bin/python3
"""Return the temporary installer space to Tilo (design spec §7).

A USB-free installation leaves two partitions behind the new Tilo root: the
staging ESP and staging root the live installer booted from. The installer
recorded their exact identities in /var/lib/tilo/staging-reclaim.json. Once the
installed system has reached a real user session, this removes them and grows
the Tilo root (GPT entry, LUKS mapping, filesystem) into the freed space.

Every step is decided from the disk as it is now, so a crash at any point is
resumed by the next run: a staging partition is either still present with its
exact recorded identity or absent with its extent unallocated; the root either
still ends at its recorded end or already ends at the grown end. Anything else
is a mismatch, and a mismatch leaves every partition untouched and says why.

Test seams (never set on a real system): TILO_STAGING_RECLAIM_RECORD,
TILO_STAGING_RECLAIM_ROOT_MOUNT, TILO_STAGING_RECLAIM_SKIP_LOCK and
TILO_STAGING_RECLAIM_ALLOW_LOOP; the external tools are found on PATH.
"""
import fcntl
import json
import os
import re
import subprocess
import sys

RECORD = os.environ.get('TILO_STAGING_RECLAIM_RECORD', '/var/lib/tilo/staging-reclaim.json')
ROOT_MOUNT = os.environ.get('TILO_STAGING_RECLAIM_ROOT_MOUNT', '/sysroot')
RECORD_MAX_BYTES = 16 * 1024
GUID_RE = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
ESP_TYPE = 'c12a7328-f81f-11d2-ba4b-00a0c93ec93b'
# The Tilo staging root type; only the live installer UKI resolves it
# (os/usr/libexec/tilo-root-discover).
STAGING_ROOT_TYPE = 'd4c4daf6-f72c-43ee-b8e3-5ba32550311d'
TILO_ROOT_TYPE = '7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab'
RECORD_KEYS = {'schema', 'operation_id', 'disk_guid', 'disk_size_bytes', 'sector_bytes',
               'staging_esp', 'staging_root', 'target_root', 'target_esp_partuuid'}


class Mismatch(Exception):
    """The disk does not look exactly like the record; touch nothing."""


def log(message):
    print('tilo-staging-reclaim: %s' % message, flush=True)


def run(argv, check=True):
    result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            universal_newlines=True, stdin=subprocess.DEVNULL)
    if check and result.returncode != 0:
        raise RuntimeError('%s failed: %s' % (' '.join(argv), result.stderr.strip()))
    return result


# --- record ------------------------------------------------------------------

def _int(value, label, minimum=0):
    if type(value) is not int or value < minimum or value >= 1 << 62:
        raise Mismatch('record field %s is not a bounded integer' % label)
    return value


def _extent(value, label):
    if not isinstance(value, dict) or set(value) != {'partuuid', 'first_lba', 'last_lba'}:
        raise Mismatch('record field %s has unexpected shape' % label)
    if not isinstance(value['partuuid'], str) or not GUID_RE.match(value['partuuid']):
        raise Mismatch('record field %s.partuuid is not a lowercase GUID' % label)
    first = _int(value['first_lba'], label + '.first_lba', 1)
    last = _int(value['last_lba'], label + '.last_lba', 1)
    if last < first:
        raise Mismatch('record field %s ends before it starts' % label)
    return value


def load_record(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        data = os.read(fd, RECORD_MAX_BYTES + 1)
    finally:
        os.close(fd)
    if len(data) > RECORD_MAX_BYTES:
        raise Mismatch('record is unexpectedly large')
    try:
        raw = json.loads(data.decode('utf-8'))
    except (UnicodeDecodeError, ValueError) as error:
        raise Mismatch('record is not valid JSON: %s' % error)
    if not isinstance(raw, dict) or set(raw) != RECORD_KEYS or raw['schema'] != 1:
        raise Mismatch('record fields differ from schema 1')
    for key in ('disk_guid', 'operation_id', 'target_esp_partuuid'):
        if not isinstance(raw[key], str) or not GUID_RE.match(raw[key]):
            raise Mismatch('record field %s is not a lowercase GUID' % key)
    _int(raw['disk_size_bytes'], 'disk_size_bytes', 1)
    if raw['sector_bytes'] not in (512, 4096):
        raise Mismatch('record sector size is unsupported')
    for key in ('staging_esp', 'staging_root', 'target_root'):
        _extent(raw[key], key)
    esp, root, target = raw['staging_esp'], raw['staging_root'], raw['target_root']
    if len({esp['partuuid'], root['partuuid'], target['partuuid'], raw['disk_guid']}) != 4:
        raise Mismatch('record GUIDs are not distinct')
    if not target['last_lba'] < esp['first_lba'] or overlaps(esp, root):
        raise Mismatch('record places the staging partitions before or inside the Tilo root')
    return raw


def overlaps(a, b):
    return a['first_lba'] <= b['last_lba'] and b['first_lba'] <= a['last_lba']


# --- gate: a real session exists ---------------------------------------------

def user_session_exists():
    listing = run(['loginctl', 'list-sessions', '--no-legend'], check=False)
    if listing.returncode != 0:
        return False
    for line in listing.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        shown = run(['loginctl', 'show-session', fields[0], '-p', 'Class', '-p', 'Uid',
                     '-p', 'State'], check=False).stdout
        values = dict(item.split('=', 1) for item in shown.splitlines() if '=' in item)
        if (values.get('Class') == 'user' and values.get('Uid', '').isdigit()
                and 1000 <= int(values['Uid']) < 60000
                and values.get('State') in ('active', 'online')):
            return True
    return False


# --- disk facts ----------------------------------------------------------------

def find_disk(record):
    listing = json.loads(run(['lsblk', '-J', '-b', '-p', '-d', '-o', 'NAME,TYPE,PTTYPE,PTUUID,SIZE']).stdout)
    kinds = ('disk', 'loop') if os.environ.get('TILO_STAGING_RECLAIM_ALLOW_LOOP') else ('disk',)
    candidates = [item for item in listing.get('blockdevices', []) if item.get('type') in kinds]
    for item in candidates:
        # lsblk reads PTTYPE/PTUUID from udev; read the GPT itself when the
        # udev database has nothing (containers, very early boot).
        if not item.get('ptuuid') or not item.get('pttype'):
            probe = subprocess.run(['sfdisk', '--json', item['name']], capture_output=True, text=True)
            if probe.returncode == 0:
                table = json.loads(probe.stdout).get('partitiontable', {})
                item['ptuuid'] = item.get('ptuuid') or table.get('id')
                item['pttype'] = item.get('pttype') or table.get('label')
    disks = [item for item in candidates
             if str(item.get('ptuuid') or '').lower() == record['disk_guid']]
    if len(disks) != 1:
        raise Mismatch('expected exactly one disk with GPT GUID %s, found %d' % (record['disk_guid'], len(disks)))
    disk = disks[0]
    if str(disk.get('pttype') or '').lower() != 'gpt' or int(disk.get('size') or 0) != record['disk_size_bytes']:
        raise Mismatch('disk %s differs from the recorded disk' % disk.get('name'))
    return disk['name']


def partition_table(disk, record):
    table = json.loads(run(['sfdisk', '--json', disk]).stdout)['partitiontable']
    if table.get('label') != 'gpt' or str(table.get('id', '')).lower() != record['disk_guid']:
        raise Mismatch('partition table of %s is not the recorded GPT' % disk)
    if int(table.get('sectorsize', 0)) != record['sector_bytes']:
        raise Mismatch('sector size of %s differs from the record' % disk)
    parts = []
    for part in table.get('partitions', []):
        start, size = int(part['start']), int(part['size'])
        parts.append({'node': part['node'], 'partuuid': str(part.get('uuid', '')).lower(),
                      'type': str(part.get('type', '')).lower(), 'first_lba': start,
                      'last_lba': start + size - 1})
    return parts


def partition_number(node):
    match = re.search(r'(\d+)$', node)
    if not match:
        raise Mismatch('cannot derive a partition number from %s' % node)
    return int(match.group(1))


def holders_and_mounts(node):
    tree = json.loads(run(['lsblk', '-J', '-p', '-o', 'NAME,TYPE,MOUNTPOINTS', node]).stdout)
    device = tree['blockdevices'][0]
    points = [point for point in device.get('mountpoints') or [] if point]
    return device.get('children') or [], points


def staged_state(parts, expected, part_type, label):
    """Return the present partition, or None when it is already gone."""
    same = [part for part in parts if part['partuuid'] == expected['partuuid']]
    if len(same) > 1:
        raise Mismatch('%s GUID appears more than once' % label)
    if same:
        part = same[0]
        if part['type'] != part_type:
            raise Mismatch('%s type changed' % label)
        if (part['first_lba'], part['last_lba']) != (expected['first_lba'], expected['last_lba']):
            raise Mismatch('%s extent changed' % label)
        children, points = holders_and_mounts(part['node'])
        if children or points:
            raise Mismatch('%s is in use' % label)
        return part
    return None


def grown_end(record):
    """Where the Tilo root ends once staging is gone, or None if not adjacent."""
    esp, root, target = record['staging_esp'], record['staging_root'], record['target_root']
    if target['last_lba'] + 1 != esp['first_lba']:
        return None
    end = esp['last_lba']
    if root['first_lba'] == esp['last_lba'] + 1:
        end = root['last_lba']
    return end


def plan(record, parts):
    esp = staged_state(parts, record['staging_esp'], ESP_TYPE, 'staging ESP')
    root = staged_state(parts, record['staging_root'], STAGING_ROOT_TYPE, 'staging root')
    targets = [part for part in parts if part['partuuid'] == record['target_root']['partuuid']]
    if len(targets) != 1:
        raise Mismatch('the Tilo root partition is not present exactly once')
    target = targets[0]
    if target['type'] != TILO_ROOT_TYPE or target['first_lba'] != record['target_root']['first_lba']:
        raise Mismatch('the Tilo root partition type or start changed')
    end = grown_end(record)
    if target['last_lba'] == record['target_root']['last_lba']:
        grow_to = end
    elif end is not None and target['last_lba'] == end and esp is None and root is None:
        grow_to = None
    else:
        raise Mismatch('the Tilo root ends neither at its recorded end nor at the reclaimed end')
    # Only the staging partitions themselves, or the Tilo root once it has
    # grown into their space, may occupy the recorded extents.
    allowed = {record['staging_esp']['partuuid'], record['staging_root']['partuuid']}
    if grow_to is None and target['last_lba'] != record['target_root']['last_lba']:
        allowed.add(target['partuuid'])
    for extent in (record['staging_esp'], record['staging_root']):
        for part in parts:
            if part['partuuid'] not in allowed and overlaps(part, extent):
                raise Mismatch('%s now occupies the recorded staging space' % part['node'])
    if grow_to is not None:
        freed = {'first_lba': record['target_root']['last_lba'] + 1, 'last_lba': grow_to}
        for part in parts:
            if part['partuuid'] not in allowed and part is not target and overlaps(part, freed):
                raise Mismatch('%s lies inside the space the Tilo root would grow into' % part['node'])
    return esp, root, target, grow_to


# --- mutation --------------------------------------------------------------------

def reclaim(record):
    disk = find_disk(record)
    lock_fd = None
    if not os.environ.get('TILO_STAGING_RECLAIM_SKIP_LOCK'):
        lock_fd = os.open(disk, os.O_RDONLY)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
    try:
        parts = partition_table(disk, record)
        esp, root, target, grow_to = plan(record, parts)
        for part, label in ((esp, 'staging ESP'), (root, 'staging root')):
            if part is None:
                continue
            number = partition_number(part['node'])
            run(['sfdisk', '--no-reread', '--lock=no', '--delete', disk, str(number)])
            run(['partx', '-d', '--nr', str(number), disk], check=False)
            log('deleted the %s (%s)' % (label, part['partuuid']))
        if grow_to is not None:
            number = partition_number(target['node'])
            size = grow_to - target['first_lba'] + 1
            script = 'start=%d, size=%d\n' % (target['first_lba'], size)
            subprocess.run(['sfdisk', '--no-reread', '--lock=no', '-N', str(number), disk],
                           input=script, universal_newlines=True, check=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            run(['partx', '-u', '--nr', str(number), disk])
            after = [part for part in partition_table(disk, record)
                     if part['partuuid'] == record['target_root']['partuuid']]
            if (len(after) != 1 or after[0]['type'] != TILO_ROOT_TYPE
                    or (after[0]['first_lba'], after[0]['last_lba']) != (target['first_lba'], grow_to)):
                raise RuntimeError('the grown Tilo root entry did not persist as planned')
            log('grew the Tilo root partition to LBA %d' % grow_to)
        else:
            # Idempotent after a crash between the GPT write and the kernel
            # update: make sure the running kernel sees the recorded size.
            run(['partx', '-u', '--nr', str(partition_number(target['node'])), disk])
    finally:
        if lock_fd is not None:
            os.close(lock_fd)
    grow_filesystem(target['node'])


def grow_filesystem(node):
    children, _ = holders_and_mounts(node)
    mappers = [child['name'] for child in children if child.get('type') == 'crypt']
    if len(mappers) > 1:
        raise RuntimeError('the Tilo root has more than one encrypted mapping')
    if mappers:
        name = os.path.basename(mappers[0])
        resize = run(['cryptsetup', 'resize', '--batch-mode', name], check=False)
        if resize.returncode != 0:
            # The mapping is sized to its partition at the next unlock, and the
            # existing root-growth unit then finishes the job on that boot.
            log('could not grow the encrypted mapping now (%s); it grows at the next boot'
                % resize.stderr.strip())
            return
    fstype = run(['findmnt', '-no', 'FSTYPE', ROOT_MOUNT]).stdout.strip()
    if fstype == 'btrfs':
        run(['btrfs', 'filesystem', 'resize', 'max', ROOT_MOUNT])
    else:
        run(['/usr/lib/systemd/systemd-growfs', ROOT_MOUNT])
    log('grew the %s filesystem at %s' % (fstype, ROOT_MOUNT))


def remove_record(path):
    os.unlink(path)
    directory = os.open(os.path.dirname(path), os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def main():
    if not os.path.exists(RECORD):
        return 0
    if not user_session_exists():
        log('waiting for the first user session before reclaiming installer space')
        return 0
    try:
        record = load_record(RECORD)
        reclaim(record)
    except Mismatch as error:
        # `refused:` and `done` are stable markers: the unit mirrors them to
        # the console, where the VM round trip (test-internal-install-cycle.sh)
        # reads them from the serial log.
        log('refused: left the installer partitions untouched: %s' % error)
        return 1
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        # Kept for the next run, which resumes from whatever state the disk is in.
        log('incomplete: stopped before finishing; will resume on the next run: %s' % error)
        return 1
    remove_record(RECORD)
    log('returned the temporary installer space to Tilo')
    log('done')
    return 0


if __name__ == '__main__':
    sys.exit(main())
