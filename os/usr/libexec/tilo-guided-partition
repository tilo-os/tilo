#!/bin/bash
# Append Tilo's dedicated ESP, boot and root inside one already-unallocated GPT extent.
# Existing entries are a reviewed input: their UUID/start/size map must match
# exactly under the disk lock, and no command here deletes, moves, or resizes.
set -euo pipefail

die() { printf 'error: guided partitioning: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }
lower() { tr '[:upper:]' '[:lower:]'; }

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ "${1:-}" = create ] || die "usage: $0 create [reviewed plan arguments]"
shift

DISK="" EXPECT_PTUUID="" EXPECT_SECTOR="" EXPECT_DISK_SIZE="" EXPECT_DEVNUM=""
EXPECT_WWN="" EXPECT_SERIAL=""
FREE_START="" FREE_SIZE="" EFI_START="" EFI_SIZE="" BOOT_START="" BOOT_SIZE="" ROOT_START="" ROOT_SIZE=""
EFI_UUID="" BOOT_UUID="" ROOT_UUID=""
IN_USE_DISK=0
EXPECTED_PARTITIONS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --disk) DISK="${2:-}"; shift 2 ;;
    --expect-disk-ptuuid) EXPECT_PTUUID="${2:-}"; shift 2 ;;
    --expect-disk-size-bytes) EXPECT_DISK_SIZE="${2:-}"; shift 2 ;;
    --expect-disk-devnum) EXPECT_DEVNUM="${2:-}"; shift 2 ;;
    --expect-disk-wwn) EXPECT_WWN="${2:-}"; shift 2 ;;
    --expect-disk-serial) EXPECT_SERIAL="${2:-}"; shift 2 ;;
    --expect-logical-sector-size) EXPECT_SECTOR="${2:-}"; shift 2 ;;
    --free-start-bytes) FREE_START="${2:-}"; shift 2 ;;
    --free-size-bytes) FREE_SIZE="${2:-}"; shift 2 ;;
    --efi-start-bytes) EFI_START="${2:-}"; shift 2 ;;
    --efi-size-bytes) EFI_SIZE="${2:-}"; shift 2 ;;
    --boot-start-bytes) BOOT_START="${2:-}"; shift 2 ;;
    --boot-size-bytes) BOOT_SIZE="${2:-}"; shift 2 ;;
    --root-start-bytes) ROOT_START="${2:-}"; shift 2 ;;
    --root-size-bytes) ROOT_SIZE="${2:-}"; shift 2 ;;
    --new-efi-partuuid) EFI_UUID="${2:-}"; shift 2 ;;
    --new-boot-partuuid) BOOT_UUID="${2:-}"; shift 2 ;;
    --new-root-partuuid) ROOT_UUID="${2:-}"; shift 2 ;;
    --expect-partition) EXPECTED_PARTITIONS+=("${2:-}"); shift 2 ;;
    # A staged (USB-free) install runs from two partitions of this disk, so the
    # kernel refuses a whole-table reread. partx below registers the new entries;
    # every identity check afterwards is unchanged.
    --in-use-disk) IN_USE_DISK=1; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done

# The compiled installer helper answers the arithmetic and GPT JSON questions.
STAGING_HANDOFF="${TILO_STAGING_HANDOFF:-/usr/libexec/tilo-staging-handoff}"
for tool in blkid blockdev findmnt flock lsblk mkfs.vfat partx readlink sfdisk sort udevadm "$STAGING_HANDOFF"; do need "$tool"; done

# Validate with unbounded integers before Bash's signed arithmetic. FREE_SIZE
# is the chosen write allocation, which may be smaller than the available gap.
# Keeping it exact also binds restart recovery to only the reviewed writes.
"$STAGING_HANDOFF" guided-geometry "$EXPECT_DISK_SIZE" "$EXPECT_SECTOR" "$FREE_START" "$FREE_SIZE" \
  "$EFI_START" "$EFI_SIZE" "$BOOT_START" "$BOOT_SIZE" "$ROOT_START" "$ROOT_SIZE" \
  "${EXPECTED_PARTITIONS[@]}" || die "invalid reviewed allocation; refresh disks and review again"
case "$DISK" in /dev/*) : ;; *) die "disk must be an absolute /dev path" ;; esac
[ -b "$DISK" ] || die "$DISK is not a block device"
DISK="$(readlink -f "$DISK")"
[ "$(lsblk -dno TYPE "$DISK" 2>/dev/null | xargs)" = disk ] || die "$DISK is not a whole disk"
[[ "$EXPECT_PTUUID" =~ ^[0-9A-Fa-f-]{8,64}$ ]] || die "invalid expected GPT UUID"
[[ "$EXPECT_DISK_SIZE" =~ ^[0-9]+$ ]] && [ "$EXPECT_DISK_SIZE" -gt 0 ] \
  || die "invalid expected disk size"
[[ "$EXPECT_DEVNUM" =~ ^[0-9]+:[0-9]+$ ]] || die "invalid expected disk device number"
[ -n "$EXPECT_WWN$EXPECT_SERIAL" ] || die "missing stable disk identity"
[[ "$EFI_UUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
  || die "invalid new EFI PARTUUID"
[[ "$ROOT_UUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
  || die "invalid new root PARTUUID"
[ "${EFI_UUID,,}" != "${ROOT_UUID,,}" ] || die "new partition UUIDs must be distinct"
if [ -n "$BOOT_START$BOOT_SIZE$BOOT_UUID" ]; then
  [[ "$BOOT_UUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
    || die "invalid new boot PARTUUID"
  [ "${BOOT_UUID,,}" != "${EFI_UUID,,}" ] && [ "${BOOT_UUID,,}" != "${ROOT_UUID,,}" ] \
    || die "new partition UUIDs must be distinct"
  for value in BOOT_START BOOT_SIZE; do
    [[ "${!value}" =~ ^[0-9]+$ ]] && [ "${!value}" -gt 0 ] || die "missing or invalid $value"
  done
fi
for value in EXPECT_SECTOR FREE_START FREE_SIZE EFI_START EFI_SIZE ROOT_START ROOT_SIZE; do
  number="${!value}"
  [[ "$number" =~ ^[0-9]+$ ]] && [ "$number" -gt 0 ] || die "missing or invalid $value"
done
[ "$EXPECT_SECTOR" -eq 512 ] || [ "$EXPECT_SECTOR" -eq 4096 ] \
  || die "unsupported logical sector size $EXPECT_SECTOR"
if [ -n "$BOOT_UUID" ]; then
  [ "$BOOT_SIZE" -ge 1073741824 ] || die "guided boot must be at least 1 GiB"
  [ "$BOOT_START" -eq $((EFI_START + EFI_SIZE)) ] || die "boot does not immediately follow EFI"
  [ "$ROOT_START" -eq $((BOOT_START + BOOT_SIZE)) ] || die "root does not immediately follow boot"
  [ $((BOOT_START % EXPECT_SECTOR)) -eq 0 ] && [ $((BOOT_SIZE % EXPECT_SECTOR)) -eq 0 ] \
    || die "boot partition is not sector-aligned"
else
  [ "$ROOT_START" -eq $((EFI_START + EFI_SIZE)) ] || die "root does not immediately follow EFI"
fi
[ "$EFI_SIZE" -eq 2147483648 ] || die "guided EFI partition must be exactly 2 GiB"
[ "$ROOT_SIZE" -ge 34359738368 ] || die "guided root must be at least 32 GiB"
[ "$EFI_START" -eq "$FREE_START" ] || die "EFI does not start at the reviewed free extent"
[ $((ROOT_START + ROOT_SIZE)) -eq $((FREE_START + FREE_SIZE)) ] \
  || die "new partitions do not exactly fill the reviewed free extent"
for value in FREE_START FREE_SIZE EFI_START EFI_SIZE ROOT_START ROOT_SIZE; do
  [ $(( ${!value} % EXPECT_SECTOR )) -eq 0 ] || die "$value is not sector-aligned"
done

canonical_expected() {
  local item uuid start size
  for item in "${EXPECTED_PARTITIONS[@]}"; do
    IFS=: read -r uuid start size extra <<<"$item"
    [ -z "${extra:-}" ] \
      && [[ "$uuid" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
      && [[ "$start" =~ ^[0-9]+$ ]] && [ "$start" -gt 0 ] \
      && [[ "$size" =~ ^[0-9]+$ ]] && [ "$size" -gt 0 ] \
      || die "invalid reviewed partition extent '$item'"
    printf '%s:%s:%s\n' "${uuid,,}" "$start" "$size"
  done | sort -t: -k2,2n
}

canonical_actual() {
  sfdisk --json "$DISK" | "$STAGING_HANDOFF" gpt map
}

EXPECTED_MAP="$(canonical_expected)"
FINAL_EXPECTED_MAP="$({
  [ -z "$EXPECTED_MAP" ] || printf '%s\n' "$EXPECTED_MAP"
  printf '%s:%s:%s\n' "${EFI_UUID,,}" "$EFI_START" "$EFI_SIZE"
  [ -z "$BOOT_UUID" ] || printf '%s:%s:%s\n' "${BOOT_UUID,,}" "$BOOT_START" "$BOOT_SIZE"
  printf '%s:%s:%s\n' "${ROOT_UUID,,}" "$ROOT_START" "$ROOT_SIZE"
} | sort -t: -k2,2n)"

# Hold one exclusive advisory lock from the last validation through the GPT
# write, kernel reread, formatting, and post-write identity checks.
exec 9<>"$DISK"
flock -x 9
[ "$(blockdev --getsize64 "$DISK")" = "$EXPECT_DISK_SIZE" ] || die "disk size changed after review"
[ "$(lsblk -dno MAJ:MIN "$DISK" | xargs)" = "$EXPECT_DEVNUM" ] || die "disk device identity changed after review"
if [ -n "$EXPECT_WWN" ]; then
  [ "$(lsblk -dno WWN "$DISK" | xargs)" = "$EXPECT_WWN" ] || die "disk WWN changed after review"
fi
if [ -n "$EXPECT_SERIAL" ]; then
  [ "$(lsblk -dno SERIAL "$DISK" | xargs)" = "$EXPECT_SERIAL" ] || die "disk serial changed after review"
fi
[ "$(lsblk -dno PTTYPE "$DISK" | xargs | lower)" = gpt ] || die "disk is no longer GPT"
[ "$(lsblk -dno PTUUID "$DISK" | xargs | lower)" = "${EXPECT_PTUUID,,}" ] \
  || die "GPT UUID changed after review"
[ "$(lsblk -dno LOG-SEC "$DISK" | xargs)" = "$EXPECT_SECTOR" ] \
  || die "logical sector size changed after review"
ACTUAL_MAP="$(canonical_actual | sort -t: -k2,2n)"
[ "$ACTUAL_MAP" = "$EXPECTED_MAP" ] \
  || die "partition map changed after review; automatic reinitialization is unavailable"

# An installed Tilo resolves root=tilo-auto to the one Tilo root on its disk
# and refuses to boot beside a second one (tilo-root-discover). Never create
# the partition that would make an existing Tilo installation, and this one,
# unbootable. A staged installer's own root has its own type and does not count.
existing_tilo_roots="$(sfdisk --json "$DISK" | "$STAGING_HANDOFF" gpt tilo-roots)"
[ "$existing_tilo_roots" = 0 ] \
  || die "$DISK already holds a Tilo root partition; a second one would make both unbootable"

# The complete-map equality above is the TOCTOU binding. Repeat the geometric
# assertion explicitly so this safety property remains obvious and testable.
while IFS=: read -r _ start size; do
  [ -n "${start:-}" ] || continue
  end=$((start + size))
  free_end=$((FREE_START + FREE_SIZE))
  [ "$end" -le "$FREE_START" ] || [ "$start" -ge "$free_end" ] \
    || die "reviewed free extent now overlaps an existing partition"
done <<<"$EXPECTED_MAP"

disk_bytes="$(blockdev --getsize64 "$DISK")"
[ $((FREE_START + FREE_SIZE)) -le $((disk_bytes - 1048576)) ] \
  || die "reviewed extent no longer fits before backup GPT metadata"

efi_sector=$((EFI_START / EXPECT_SECTOR))
efi_sectors=$((EFI_SIZE / EXPECT_SECTOR))
root_sector=$((ROOT_START / EXPECT_SECTOR))
root_sectors=$((ROOT_SIZE / EXPECT_SECTOR))
partition_lines="$(printf 'start=%s, size=%s, type=%s, uuid=%s, name="Tilo EFI"\n' \
  "$efi_sector" "$efi_sectors" c12a7328-f81f-11d2-ba4b-00a0c93ec93b "${EFI_UUID,,}")"
if [ -n "$BOOT_UUID" ]; then
  boot_sector=$((BOOT_START / EXPECT_SECTOR))
  boot_sectors=$((BOOT_SIZE / EXPECT_SECTOR))
  partition_lines+=$'\n'"$(printf 'start=%s, size=%s, type=%s, uuid=%s, name="Tilo boot"\n' \
    "$boot_sector" "$boot_sectors" 0fc63daf-8483-4772-8e79-3d69d8477de4 "${BOOT_UUID,,}")"
fi
partition_lines+=$'\n'"$(printf 'start=%s, size=%s, type=%s, uuid=%s, name="Tilo root"\n' \
  "$root_sector" "$root_sectors" 7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab "${ROOT_UUID,,}")"
printf '%s\n' "$partition_lines" | sfdisk --append --no-reread --lock=no --wipe never --wipe-partitions never "$DISK"
[ "$(canonical_actual | sort -t: -k2,2n)" = "$FINAL_EXPECTED_MAP" ] \
  || die "final PARTUUID/geometry map differs from the reviewed plan"
if [ "$IN_USE_DISK" -eq 0 ]; then
  blockdev --rereadpt "$DISK"
fi

# The staged root and ESP stay mounted on this disk, so the kernel cannot
# reread its whole partition table. Register only the newly reviewed GPT
# entries in that case. An EEXIST result is harmless only if the live node
# matches the reviewed disk, partition number, geometry, and PARTUUID below.
disk_sysfs="$(readlink -f "/sys/dev/block/$EXPECT_DEVNUM")" \
  || die "reviewed disk has no kernel block-device identity"
[ -d "$disk_sysfs" ] || die "reviewed disk has no kernel block-device identity"
kernel_partition_matches() {
  local node="$1" number="$2" start="$3" sectors="$4" uuid="$5"
  local part_sysfs live_uuid=""
  [ -b "$node" ] || return 1
  part_sysfs="$(readlink -f "/sys/class/block/${node##*/}")" || return 1
  [ "$(dirname "$part_sysfs")" = "$disk_sysfs" ] || return 1
  [ "$(cat "$part_sysfs/start" 2>/dev/null)" = "$start" ] || return 1
  [ "$(cat "$part_sysfs/size" 2>/dev/null)" = "$sectors" ] || return 1
  [ "$(cat "$part_sysfs/partition" 2>/dev/null)" = "$number" ] || return 1
  [ "$(lsblk -dno MAJ:MIN "$node" 2>/dev/null | xargs)" = "$(cat "$part_sysfs/dev" 2>/dev/null)" ] || return 1
  # uevent and udev can lag behind the partition node. Probe the entry
  # directly; do not accept a stale or unrelated node on UUID alone.
  live_uuid="$(blkid -p -s PART_ENTRY_UUID -o value "$node" 2>/dev/null || true)"
  [ -n "$live_uuid" ] || live_uuid="$(lsblk -dno PARTUUID "$node" 2>/dev/null | xargs)"
  [ "${live_uuid,,}" = "${uuid,,}" ]
}
for new_uuid in "$EFI_UUID" "$BOOT_UUID" "$ROOT_UUID"; do
  [ -n "$new_uuid" ] || continue
  new_record="$(sfdisk --json "$DISK" | "$STAGING_HANDOFF" gpt number-node "${new_uuid,,}")" \
    || die "new partition number was not recorded in GPT"
  read -r new_number new_node <<<"$new_record"
  case "${new_uuid,,}" in
    "${EFI_UUID,,}") new_start="$efi_sector"; new_sectors="$efi_sectors" ;;
    "${BOOT_UUID,,}") new_start="$boot_sector"; new_sectors="$boot_sectors" ;;
    "${ROOT_UUID,,}") new_start="$root_sector"; new_sectors="$root_sectors" ;;
    *) die "unrecognized reviewed partition UUID" ;;
  esac
  if [ "$IN_USE_DISK" -eq 1 ]; then
    partx -a -n "$new_number:$new_number" "$DISK" || true
  fi
  udevadm settle --timeout=10 2>/dev/null || true
  for _ in {1..300}; do
    kernel_partition_matches "$new_node" "$new_number" "$new_start" "$new_sectors" "$new_uuid" && break
    sleep 0.1
  done
  kernel_partition_matches "$new_node" "$new_number" "$new_start" "$new_sectors" "$new_uuid" \
    || die "kernel partition $new_number differs from the reviewed plan"
done
udevadm settle --timeout=5 2>/dev/null || true

partition_by_uuid() {
  sfdisk --json "$DISK" | "$STAGING_HANDOFF" gpt node "${1,,}"
}
EFI_PARTITION="$(partition_by_uuid "$EFI_UUID")" || die "new EFI partition did not appear"
BOOT_PARTITION=""
[ -z "$BOOT_UUID" ] || BOOT_PARTITION="$(partition_by_uuid "$BOOT_UUID")" || die "new boot partition did not appear"
ROOT_PARTITION="$(partition_by_uuid "$ROOT_UUID")" || die "new root partition did not appear"
for _ in {1..50}; do
  [ -b "$EFI_PARTITION" ] && [ -b "$ROOT_PARTITION" ] \
    && { [ -z "$BOOT_PARTITION" ] || [ -b "$BOOT_PARTITION" ]; } && break
  sleep 0.1
done
[ -b "$EFI_PARTITION" ] && [ -b "$ROOT_PARTITION" ] \
  && { [ -z "$BOOT_PARTITION" ] || [ -b "$BOOT_PARTITION" ]; } \
  || die "kernel did not expose the new partition devices"
[ "$(blockdev --getsize64 "$EFI_PARTITION")" = "$EFI_SIZE" ] || die "new EFI size differs from plan"
[ "$(blockdev --getsize64 "$ROOT_PARTITION")" = "$ROOT_SIZE" ] || die "new root size differs from plan"
if [ -n "$BOOT_UUID" ]; then
  [ -b "$BOOT_PARTITION" ] && [ "$(blockdev --getsize64 "$BOOT_PARTITION")" = "$BOOT_SIZE" ] \
    || die "new boot partition size differs from plan"
fi
[ "$(canonical_actual | sort -t: -k2,2n)" = "$FINAL_EXPECTED_MAP" ] \
  || die "final PARTUUID/geometry map differs from the reviewed plan"

partition_type_by_uuid() {
  sfdisk --json "$DISK" | "$STAGING_HANDOFF" gpt type "${1,,}"
}
[ "$(partition_type_by_uuid "$EFI_UUID")" = c12a7328-f81f-11d2-ba4b-00a0c93ec93b ] \
  || die "reviewed EFI partition type changed"
[ "$(partition_type_by_uuid "$ROOT_UUID")" = 7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab ] \
  || die "reviewed root partition type changed"
if [ -n "$BOOT_UUID" ]; then
  [ "$(partition_type_by_uuid "$BOOT_UUID")" = 0fc63daf-8483-4772-8e79-3d69d8477de4 ] \
    || die "reviewed boot partition type changed"
  findmnt -rn -S "$BOOT_PARTITION" >/dev/null 2>&1 && die "reviewed boot partition is mounted"
  boot_signature="$(blkid -p -s TYPE -o value "$BOOT_PARTITION" 2>/dev/null || true)"
  [ -z "$boot_signature" ] || die "reviewed boot partition unexpectedly contains a $boot_signature signature"
fi
findmnt -rn -S "$EFI_PARTITION" >/dev/null 2>&1 && die "reviewed EFI partition is mounted"
findmnt -rn -S "$ROOT_PARTITION" >/dev/null 2>&1 && die "reviewed root partition is mounted"

root_signature="$(blkid -p -s TYPE -o value "$ROOT_PARTITION" 2>/dev/null || true)"
[ -z "$root_signature" ] || die "reviewed root partition unexpectedly contains a $root_signature signature"
efi_signature="$(blkid -p -s TYPE -o value "$EFI_PARTITION" 2>/dev/null || true)"
case "$efi_signature" in
  "") mkfs.vfat -n TILO-EFI "$EFI_PARTITION" >/dev/null ;;
  vfat)
    [ "$(blkid -p -s LABEL -o value "$EFI_PARTITION" 2>/dev/null || true)" = TILO-EFI ] \
      || die "reviewed EFI partition has an unexpected filesystem label"
    ;;
  *) die "reviewed EFI partition unexpectedly contains a $efi_signature signature" ;;
esac

sync "$DISK" "$EFI_PARTITION"
printf 'EFI_PARTITION=%s\n' "$EFI_PARTITION"
[ -z "$BOOT_PARTITION" ] || printf 'BOOT_PARTITION=%s\n' "$BOOT_PARTITION"
printf 'ROOT_PARTITION=%s\n' "$ROOT_PARTITION"
