#!/usr/bin/env bash
# Complete this machine's enrollment with one of the person's devices, and its
# provisioning.
set -euo pipefail

token=/etc/tilo/enrollment-token.txt
cert=/var/lib/tilo/device/cert.bin
home_peer=/etc/tilo/home-peer.toml
# The plan this machine installs from is named by the token's nonce: the
# server reads it after enrolling and finishes installing what it describes.
install_plan=/var/lib/tilo-server/install-plan.nonce

handoff_home_peer() {
    local metadata owner
    metadata="$(stat -c '%u:%a:%h:%s' -- "$home_peer" 2>/dev/null || true)"
    if [[ ! -f "$home_peer" || -L "$home_peer" \
        || ! "$metadata" =~ ^(0|[0-9]+):(600|644):1:([0-9]+)$ \
        || "${BASH_REMATCH[3]:-65537}" -gt 65536 ]]; then
        echo "tilo-server-firstboot: refusing unsafe home-peer configuration inode" >&2
        exit 1
    fi
    owner="$(id -u tilo-server)"
    [[ "${BASH_REMATCH[1]}" = 0 || "${BASH_REMATCH[1]}" = "$owner" ]] \
        || { echo "tilo-server-firstboot: home-peer configuration has unexpected owner" >&2; exit 1; }
    chown --no-dereference tilo-server:tilo-server "$home_peer"
    chmod 0600 "$home_peer"
}

valid_device_certificate() {
    local metadata size
    metadata="$(stat -c '%u:%a:%h:%s' -- "$cert" 2>/dev/null || true)"
    [[ -f "$cert" && ! -L "$cert" \
        && "$metadata" =~ ^0:(600|640|644):1:([0-9]+)$ ]] || return 1
    size="${BASH_REMATCH[2]}"
    (( size > 0 && size <= 65536 ))
}

if [[ -e /var/lib/tilo-server/decommissioned ]]; then
    exit 0
fi

if [[ -e "$cert" || -L "$cert" ]] && ! valid_device_certificate; then
    echo "tilo-server-firstboot: refusing unsafe device-certificate inode" >&2
    exit 1
fi

if valid_device_certificate && [[ -s "$home_peer" ]]; then
    handoff_home_peer
    exit 0
fi
# The name this machine is offered under. `hostnamectl --static` succeeds with
# nothing to say when the image carries no /etc/hostname, which a bootc image
# may not, and an empty label is refused by the enrollment: fall back on the
# running name and then on a fixed one, so a machine with its own idea of its
# name still pairs.
label="$(hostnamectl --static 2>/dev/null || true)"
[[ -n "$label" ]] || label="$(hostname 2>/dev/null || true)"
[[ -n "$label" ]] || label='Home server'

# What this machine was handed is root's to read: a token another account
# could have swapped in is not one.
if [[ -e "$token" || -L "$token" ]]; then
    [[ "$(stat -c '%u' -- "$token" 2>/dev/null || echo unknown)" = 0 ]] \
        || { echo "tilo-server-firstboot: refusing an enrollment token not owned by root" >&2; exit 1; }
fi

# The one enrollment every Tilo image uses. It takes the token in
# /etc/tilo/enrollment-token.txt when the deployment put a real one there,
# and otherwise shows a code a device of the person's approves; the methods it
# may use are the ones this image declares in
# /usr/lib/tilo/enrollment-methods. It burns the token it spends.
#
# The relay its configuration names is where it shows that code: a server
# behind a network address translation is reached only through it.
relay=""
if [[ -r /etc/tilo/server.toml ]]; then
    relay="$(sed -n 's/^[[:space:]]*relay[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        /etc/tilo/server.toml | head -n 1)"
fi
enroll_args=(--identity-root /var/lib/tilo
    --home-peer-output /etc/tilo/home-peer.toml --label "$label" --timeout 270
    --nonce-output "$install_plan")
[[ -n "$relay" ]] && enroll_args+=(--relay "$relay")
/usr/libexec/tilo/tilo-enroll enroll "${enroll_args[@]}"
valid_device_certificate \
    || { echo "tilo-server-firstboot: enrollment produced an unsafe device certificate" >&2; exit 1; }
handoff_home_peer
# The server reads the plan it must finish installing from this file: it is
# the server account's to read, and nobody else's.
if [[ -e "$install_plan" || -L "$install_plan" ]]; then
    chown --no-dereference tilo-server:tilo-server "$install_plan"
    chmod 0600 "$install_plan"
fi
echo "tilo-server-firstboot: enrollment and full-sync setup complete"
