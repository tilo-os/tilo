#!/usr/bin/env bash
# Complete this machine's join with one of the person's devices, and its
# provisioning. Where the install planned the person's devices to unlock its
# root, tilo-server-unlock.service sets that up once the server's daemon runs.
#
# Paths and commands are overridable so the logic runs against fakes; a boot
# passes none of them.
set -euo pipefail

identity_root="${TILO_SERVER_IDENTITY_ROOT:-/var/lib/tilo}"
# The account's state lives on the same volume, so the login and the identity outlive a boot and
# the server reads them at the path it serves from.
state_home="${TILO_SERVER_STATE_HOME:-$identity_root/state}"
login_file="$state_home/tilo/device/login.json"
# The one secret an empty volume joins with, written by whoever provisioned the machine.
ticket="${TILO_SERVER_TICKET:-/etc/tilo/ticket}"
cert="$identity_root/device/cert.bin"
decommissioned="${TILO_SERVER_DECOMMISSIONED:-/var/lib/tilo-server/decommissioned}"
tilo_bin="${TILO_TILO_BIN:-/usr/bin/tilo}"

valid_device_certificate() {
    local metadata size
    metadata="$(stat -c '%u:%a:%h:%s' -- "$cert" 2>/dev/null || true)"
    [[ -f "$cert" && ! -L "$cert" \
        && "$metadata" =~ ^0:(600|640|644):1:([0-9]+)$ ]] || return 1
    size="${BASH_REMATCH[2]}"
    (( size > 0 && size <= 65536 ))
}

if [[ -e $decommissioned ]]; then
    exit 0
fi

if [[ -e "$cert" || -L "$cert" ]] && ! valid_device_certificate; then
    echo "tilo-server-firstboot: refusing unsafe device-certificate inode" >&2
    exit 1
fi

if valid_device_certificate && [ -s "$login_file" ]; then
    exit 0
fi
# The name this machine is offered under. `hostnamectl --static` succeeds with
# nothing to say when the image carries no /etc/hostname, which a bootc image
# may not, and an empty label is refused by the login: fall back on the
# running name and then on a fixed one.
label="$(hostnamectl --static 2>/dev/null || true)"
[[ -n "$label" ]] || label="$(hostname 2>/dev/null || true)"
[[ -n "$label" ]] || label='Home server'

no_identity='no identity on this volume: make a ticket with `tilo device add` and pass it as TILO_TICKET'
# What this machine was handed is root's to read: a ticket another account
# could have swapped in is not one.
if [[ -e "$ticket" || -L "$ticket" ]]; then
    [[ "$(stat -c '%u' -- "$ticket" 2>/dev/null || echo unknown)" = 0 ]] \
        || { echo "tilo-server-firstboot: refusing a ticket not owned by root" >&2; exit 1; }
fi
if [[ ! -s "$ticket" ]]; then
    echo "$no_identity" >&2
    exit 1
fi

# This machine joins the person's devices the way any computer does: one ticket, spent once, and
# the identity and login it leaves on the volume from then on.
install -d -m 0700 "$state_home"
TILO_IDENTITY_ROOT="$identity_root" XDG_STATE_HOME="$state_home" HOME="$state_home" \
    "$tilo_bin" login - --label "$label" < "$ticket" \
    || { echo "$no_identity" >&2; exit 1; }
valid_device_certificate \
    || { echo "tilo-server-firstboot: the login left an unsafe device certificate" >&2; exit 1; }
rm -f "$ticket"
# The certificates and the person's public key are given to the tilo-identity group the server
# reads them through, with the setgid flag the identity tree's directories inherit. The device key
# is the server daemon's own file: root:tilo-identity would make it a group's, and this account
# must not read it.
getent group tilo-identity >/dev/null 2>&1 \
    || { echo "tilo-server-firstboot: the image declares no tilo-identity group" >&2; exit 1; }
find "$identity_root" -mindepth 1 \
    \( -path "$identity_root/device-private" -prune \) -o -exec chown root:tilo-identity {} + \
    || { echo "tilo-server-firstboot: could not give the identity to the tilo-identity group" >&2; exit 1; }
find "$identity_root" -mindepth 1 -type d \
    \( -path "$identity_root/device-private" -prune \) -o -exec chmod g+s {} + \
    || { echo "tilo-server-firstboot: could not make the identity's directories group-inheriting" >&2; exit 1; }
install -d -o tilo-server -g tilo-server -m 0700 "$identity_root/device-private" \
    || { echo "tilo-server-firstboot: could not give the device key directory to the server" >&2; exit 1; }
if [ -f "$identity_root/device-private/keypair.bin" ]; then
    chown tilo-server:tilo-server "$identity_root/device-private/keypair.bin" \
        || { echo "tilo-server-firstboot: could not give the device key to the server" >&2; exit 1; }
    chmod 0600 "$identity_root/device-private/keypair.bin" \
        || { echo "tilo-server-firstboot: could not make the device key owner-only" >&2; exit 1; }
fi
chown -R tilo-server:tilo-server "$state_home/tilo"
echo "tilo-server-firstboot: login and full-sync setup complete"
