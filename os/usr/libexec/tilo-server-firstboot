#!/usr/bin/env bash
# Complete this machine's join with one of the person's devices, its
# provisioning, and — where the install planned it — the sibling unlock of its
# root.
#
# The sibling step spends the install key the installer kept inside the
# encrypted root (tilo-disk-encrypt finish --unlock owner-device): it enrols a
# LUKS2 slot another of the person's devices releases at boot, then removes
# that install slot and shreds the key. It can only run once this machine is
# joined and holds the person's device store, which is what the login above
# hands it. A failure leaves both in place and tries again on the next
# boot; the installed system's status names the slot pending until then.
#
# Paths and commands are overridable so the logic runs against fakes
# (os/tests/server_firstboot_sibling.sh); a boot passes none of them.
set -euo pipefail

identity_root="${TILO_SERVER_IDENTITY_ROOT:-/var/lib/tilo}"
# The account's state lives on the same volume, so the login and the identity outlive a boot and
# the server reads them at the path it serves from.
state_home="${TILO_SERVER_STATE_HOME:-$identity_root/state}"
login_file="$state_home/tilo/device/login.json"
# The one secret an empty volume joins with, written by whoever provisioned the machine.
ticket="${TILO_SERVER_TICKET:-/etc/tilo/ticket}"
cert="$identity_root/device/cert.bin"
decommissioned="${TILO_SERVER_DECOMMISSIONED:-/var/lib/tilo-server/decommissioned}"
state_root="${TILO_SERVER_STATE_ROOT:-/var/lib/tilo-server}"
sibling_dir="${TILO_SERVER_SIBLING_DIR:-/var/lib/tilo/sibling-enrol}"
sibling_conf="$sibling_dir/enrol.conf"
sibling_key="$sibling_dir/luks.key"
pending_marker="$state_root/sibling-unlock-pending"
tilo_bin="${TILO_TILO_BIN:-/usr/bin/tilo}"
disk_encrypt="${TILO_DISK_ENCRYPT:-/usr/libexec/tilo-disk-encrypt}"
auth_bin="${TILO_TILO_AUTH:-/usr/libexec/tilo/tilo-auth}"
cryptsetup_bin="${TILO_CRYPTSETUP:-cryptsetup}"
sibling_seconds="${TILO_SIBLING_SECONDS:-240}"
# Root in every boot; a check runs the same logic as its own account.
sibling_owner="${TILO_SERVER_SIBLING_OWNER:-0}"

log() { printf 'tilo-server-firstboot: %s\n' "$*" >&2; }

valid_device_certificate() {
    local metadata size
    metadata="$(stat -c '%u:%a:%h:%s' -- "$cert" 2>/dev/null || true)"
    [[ -f "$cert" && ! -L "$cert" \
        && "$metadata" =~ ^0:(600|640|644):1:([0-9]+)$ ]] || return 1
    size="${BASH_REMATCH[2]}"
    (( size > 0 && size <= 65536 ))
}

# The install-time enrolment file, read without sourcing it: it names the
# volume and the one key file the installer left root-only in this root.
read_sibling_enrol() {
    local metadata uuid key
    [[ -f "$sibling_conf" && ! -L "$sibling_conf" ]] || return 1
    metadata="$(stat -c '%u:%a:%h:%s' -- "$sibling_conf" 2>/dev/null || true)"
    [[ "$metadata" =~ ^$sibling_owner:600:1:([0-9]+)$ ]] || return 1
    (( BASH_REMATCH[1] > 0 && BASH_REMATCH[1] <= 4096 )) || return 1
    uuid="$(sed -n 's/^luks_uuid=//p' "$sibling_conf")"
    key="$(sed -n 's/^key_file=//p' "$sibling_conf")"
    [[ "$uuid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || return 1
    [ "$key" = "$sibling_key" ] || return 1
    [ -f "$key" ] && [ ! -L "$key" ] || return 1
    metadata="$(stat -c '%u:%a:%h:%s' -- "$key" 2>/dev/null || true)"
    [[ "$metadata" =~ ^$sibling_owner:600:1:([0-9]+)$ ]] || return 1
    (( BASH_REMATCH[1] >= 32 && BASH_REMATCH[1] <= 4096 ))
    SIBLING_UUID="$uuid"
}

# What the sibling unlock will open. The installed system finds it by the LUKS
# UUID; a check names it directly.
sibling_device() {
    if [ -n "${TILO_SIBLING_DEVICE:-}" ]; then
        if [ ! -b "$TILO_SIBLING_DEVICE" ] && [ "${TILO_SIBLING_ALLOW_REGULAR:-0}" != 1 ]; then
            return 1
        fi
        printf '%s' "$TILO_SIBLING_DEVICE"
        return 0
    fi
    printf '/dev/disk/by-uuid/%s' "$SIBLING_UUID"
}

# Spend the kept install key: enrol the sibling slot, then remove the key's
# own slot and the file. Returns 0 whether or not the enrolment is done yet;
# a pending one is retried on the next boot and named by `tilo server status`.
sibling_enrol() {
    [ -e "$sibling_conf" ] || [ -L "$sibling_conf" ] || return 0
    if ! read_sibling_enrol; then
        log "refusing an unsafe or malformed sibling-enrolment file at $sibling_conf"
        return 1
    fi
    local dev
    dev="$(sibling_device)" || { log "the volume $SIBLING_UUID is not present; sibling unlock stays pending"; return 0; }
    [ -e "$dev" ] || { log "the volume $SIBLING_UUID is not present; sibling unlock stays pending"; return 0; }

    if ! "$auth_bin" sibling status "$dev" >/dev/null 2>&1; then
        log "enrolling the sibling unlock with another of your devices"
        if ! timeout "$sibling_seconds" "$disk_encrypt" enrol "$dev" --sibling \
            --key-file "$sibling_key"; then
            log "the sibling unlock is not enrolled yet; it will be retried at the next boot"
            return 0
        fi
    fi

    # The sibling slot may already exist; either way the install key's slot is
    # the one that must not outlive this step.
    if ! "$cryptsetup_bin" luksRemoveKey "$dev" --key-file "$sibling_key"; then
        log "the install key slot could not be removed; it will be retried at the next boot"
        return 0
    fi
    shred -u "$sibling_key" 2>/dev/null || rm -f "$sibling_key"
    rm -f "$sibling_conf"
    rmdir "$sibling_dir" 2>/dev/null || true
    rm -f "$pending_marker"
    log "sibling unlock enrolled and the install key removed"
}

if [ "${1:-}" = sibling-enrol ]; then
    sibling_enrol
    exit 0
fi
[ "$#" -eq 0 ] || { log "usage: $0 [sibling-enrol]"; exit 2; }

if [[ -e $decommissioned ]]; then
    exit 0
fi

if [[ -e "$cert" || -L "$cert" ]] && ! valid_device_certificate; then
    echo "tilo-server-firstboot: refusing unsafe device-certificate inode" >&2
    exit 1
fi

if valid_device_certificate && [ -s "$login_file" ]; then
    sibling_enrol
    exit 0
fi
# The name this machine is offered under. `hostnamectl --static` succeeds with
# nothing to say when the image carries no /etc/hostname, which a bootc image
# may not, and an empty label is refused by the login: fall back on the
# running name and then on a fixed one.
label="$(hostnamectl --static 2>/dev/null || true)"
[[ -n "$label" ]] || label="$(hostname 2>/dev/null || true)"
[[ -n "$label" ]] || label='Home server'

no_identity='no identity on this volume: make a ticket with `tilo device add` and pass it as TILO_TICKET'
# What this machine was handed is root's to read: a ticket another account
# could have swapped in is not one.
if [[ -e "$ticket" || -L "$ticket" ]]; then
    [[ "$(stat -c '%u' -- "$ticket" 2>/dev/null || echo unknown)" = 0 ]] \
        || { echo "tilo-server-firstboot: refusing a ticket not owned by root" >&2; exit 1; }
fi
if [[ ! -s "$ticket" ]]; then
    echo "$no_identity" >&2
    exit 1
fi

# This machine joins the person's devices the way any computer does: one ticket, spent once, and
# the identity and login it leaves on the volume from then on.
install -d -m 0700 "$state_home"
TILO_IDENTITY_ROOT="$identity_root" XDG_STATE_HOME="$state_home" HOME="$state_home" \
    "$tilo_bin" login - --label "$label" < "$ticket" \
    || { echo "$no_identity" >&2; exit 1; }
valid_device_certificate \
    || { echo "tilo-server-firstboot: the login left an unsafe device certificate" >&2; exit 1; }
rm -f "$ticket"
# The server's own account reads its device key through the identity group, and the login as
# itself: what a join from the installer left is given the same group and setgid flag, and the
# state is the server account's.
getent group tilo-identity >/dev/null 2>&1 \
    || { echo "tilo-server-firstboot: the image declares no tilo-identity group" >&2; exit 1; }
find "$identity_root" -mindepth 1 -exec chown root:tilo-identity {} + \
    || { echo "tilo-server-firstboot: could not give the identity to the tilo-identity group" >&2; exit 1; }
find "$identity_root" -mindepth 1 -type d -exec chmod g+s {} + \
    || { echo "tilo-server-firstboot: could not make the identity's directories group-inheriting" >&2; exit 1; }
chown -R tilo-server:tilo-server "$state_home/tilo"
sibling_enrol
echo "tilo-server-firstboot: login and full-sync setup complete"
