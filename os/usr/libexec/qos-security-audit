#!/usr/bin/bash
# qOS security self-check (security plan §11). Oneshot at boot: logs which
# hardening features are actually ACTIVE to the journal, so "we think it's on"
# becomes "verified on". Read with: journalctl -u qos-security-audit
# A failed audit marks this oneshot failed so health surfaces and agents can
# detect it. It is deliberately not a boot dependency, so a diagnostic failure
# never strands the user outside their session.
set -u

failures=0
ok()   { echo "[ OK ]   $*"; }
warn() { echo "[FAIL]   $*"; failures=$((failures + 1)); }
note() { echo "[info]   $*"; }

cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
has_karg() { case " $cmdline " in *" $1 "*) return 0;; *) return 1;; esac; }

echo "=== qOS security audit ==="

# SELinux
mode="$(getenforce 2>/dev/null || echo unknown)"
[ "$mode" = "Enforcing" ] && ok "SELinux: Enforcing" || warn "SELinux: $mode (expected Enforcing)"

# Kernel lockdown
lock="$(cat /sys/kernel/security/lockdown 2>/dev/null || echo 'n/a')"
case "$lock" in
  *'[integrity]'*|*'[confidentiality]'*) ok "kernel lockdown: $lock" ;;
  *) warn "kernel lockdown: $lock (expected [integrity]; needs Secure Boot to fully enforce)" ;;
esac

# Memory-init + heap hardening kargs
for k in init_on_alloc=1 init_on_free=1 slab_nomerge page_alloc.shuffle=1 vsyscall=none; do
  has_karg "$k" && ok "karg $k" || warn "karg $k MISSING"
done
case " $cmdline " in *randomize_kstack_offset=on*|*randomize_kstack_offset=1*) ok "karg randomize_kstack_offset";; *) warn "karg randomize_kstack_offset MISSING";; esac

# The kargs above are what we ASKED for. This is what the kernel actually did:
# it reports the resolved zero-on-alloc / zero-on-free state once at boot, and
# that line is the only place the live setting is observable — there is no
# sysfs knob for either. A karg that was ignored (typo, unsupported build)
# shows up here and nowhere else.
meminit="$(dmesg 2>/dev/null | grep -m1 'mem auto-init:' || true)"
case "$meminit" in
  *'alloc:on'*'free:on'*) ok "${meminit#*mem auto-init: }(live, from the kernel's own report)" ;;
  '')                     note "mem auto-init: kernel report not in the ring buffer (rotated out?)" ;;
  *)                      warn "mem auto-init NOT fully on: ${meminit#*mem auto-init: }" ;;
esac

# Enforced module signatures. sig_enforce is the live value of
# CONFIG_MODULE_SIG_FORCE; with it set, no unsigned module enters the kernel
# even from root, with or without Secure Boot behind it.
sigenf="$(cat /sys/module/module/parameters/sig_enforce 2>/dev/null || echo '?')"
case "$sigenf" in
  Y) ok "module signatures enforced (sig_enforce=Y)" ;;
  N) warn "module signatures NOT enforced (sig_enforce=N; CONFIG_MODULE_SIG_FORCE lost?)" ;;
  *) warn "module signature enforcement unknown (no sig_enforce parameter)" ;;
esac

# Runtime tunables from /usr/lib/sysctl.d/60-qos-hardening.conf. Reads the
# effective value, so an unapplied drop-in or an /etc override that relaxed
# something is visible rather than assumed.
check_sysctl() {
  key="$1"; want="$2"
  have="$(sysctl -n "$key" 2>/dev/null || echo '?')"
  if [ "$have" = "$want" ]; then ok "$key = $have"
  else warn "$key = $have (expected $want)"; fi
}
check_sysctl kernel.yama.ptrace_scope 3
check_sysctl kernel.kptr_restrict 2
check_sysctl kernel.dmesg_restrict 1
check_sysctl kernel.unprivileged_bpf_disabled 1
check_sysctl kernel.kexec_load_disabled 1
check_sysctl kernel.perf_event_paranoid 3
check_sysctl kernel.io_uring_disabled 2
check_sysctl kernel.sysrq 16
check_sysctl kernel.randomize_va_space 2
check_sysctl vm.unprivileged_userfaultfd 0
check_sysctl vm.mmap_min_addr 65536
check_sysctl fs.suid_dumpable 0
check_sysctl fs.protected_symlinks 1
check_sysctl fs.protected_hardlinks 1
check_sysctl fs.protected_fifos 2
check_sysctl fs.protected_regular 2
check_sysctl dev.tty.ldisc_autoload 0
check_sysctl net.core.bpf_jit_harden 2
check_sysctl net.ipv4.conf.all.accept_redirects 0
check_sysctl net.ipv4.conf.default.accept_redirects 0
check_sysctl net.ipv4.conf.all.secure_redirects 0
check_sysctl net.ipv4.conf.default.secure_redirects 0
check_sysctl net.ipv4.conf.all.send_redirects 0
check_sysctl net.ipv4.conf.default.send_redirects 0
check_sysctl net.ipv6.conf.all.accept_redirects 0
check_sysctl net.ipv6.conf.default.accept_redirects 0
check_sysctl net.ipv4.conf.all.accept_source_route 0
check_sysctl net.ipv4.conf.default.accept_source_route 0
check_sysctl net.ipv6.conf.all.accept_source_route 0
check_sysctl net.ipv6.conf.default.accept_source_route 0
check_sysctl net.ipv4.conf.all.rp_filter 2
check_sysctl net.ipv4.conf.default.rp_filter 2
check_sysctl net.ipv4.conf.all.log_martians 1
check_sysctl net.ipv4.conf.default.log_martians 1
check_sysctl net.ipv4.icmp_echo_ignore_broadcasts 1
check_sysctl net.ipv4.icmp_ignore_bogus_error_responses 1
check_sysctl net.ipv4.tcp_syncookies 1
check_sysctl net.ipv4.tcp_rfc1337 1

# Hardware shadow stacks. Every qOS binary is marked compatible at link time,
# but glibc only switches them on for a process that also asks via
# GLIBC_TUNABLES, which is how they stay scoped to the processes proven to run
# under them. Report the CPU/kernel capability and who is actually using it.
if grep -qw user_shstk /proc/cpuinfo 2>/dev/null; then
  shstk_procs=""
  for st in /proc/[0-9]*/status; do
    grep -q '^x86_Thread_features:.*shstk' "$st" 2>/dev/null || continue
    p="${st%/status}"
    shstk_procs="$shstk_procs $(cat "$p/comm" 2>/dev/null)"
  done
  if [ -n "$shstk_procs" ]; then ok "shadow stacks active in:$shstk_procs"
  else note "CPU supports shadow stacks; no process has enabled them yet (they are opt-in per process)"; fi
else
  note "CPU/kernel report no user shadow-stack support (pre-Tiger Lake / pre-Zen 5); the ELF marking is inert here"
fi
# Secure Boot. Read the EFI variable when mokutil is absent — mokutil arrives
# with the shim stack this image removes, so the tool it reports through must not
# be the thing that decides whether the check happens.
sb_var() {
  local f
  f="$(ls /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | head -1)"
  [ -n "$f" ] || return 1
  od -An -tu1 -j4 -N1 "$f" 2>/dev/null | tr -d ' \n'
}
if sb="$(mokutil --sb-state 2>/dev/null | head -1)" && [ -n "$sb" ]; then
  :
elif v="$(sb_var)"; then
  [ "$v" = "1" ] && sb="SecureBoot enabled" || sb="SecureBoot disabled"
else
  sb="no Secure Boot variables (not UEFI, or no SB support)"
fi
case "$sb" in
  *enabled*) ok "Secure Boot: $sb" ;;
  *) note "Secure Boot: $sb — native qOS will not create a TPM short-PIN slot until verified boot and kernel lockdown are active (see /usr/share/doc/qos/boot-chain.md)" ;;
esac

# Owner-enrolled Secure Boot: are the keys there, and will the next deployment's
# kernel get signed? A machine with keys enrolled and no re-signing is one update
# away from not booting, so this is worth saying out loud on every boot.
if [ -f /var/lib/qos/secureboot/db.key ]; then
  if systemctl is-enabled qos-secureboot-sign.path >/dev/null 2>&1 \
     && systemctl is-enabled qos-secureboot-sign.service >/dev/null 2>&1; then
    ok "owner Secure Boot keys present, re-signing armed"
  else
    warn "owner Secure Boot keys present but re-signing is NOT armed — the next update stages an unsigned kernel"
  fi
else
  note "no owner Secure Boot keys (qos-secureboot generate-keys)"
fi

if [ -x /usr/libexec/qos-verified-boot-install-preflight ]; then
  warn "an unsupported TPM short-PIN preflight is installed; keep it disabled until unlock is bound to measured qOS artifacts"
else
  ok "TPM short-PIN install is disabled; native install requires a strong passphrase until measured-artifact binding ships"
fi

# Root filesystem encryption. Walk from the root mount to its backing device and
# ask whether a dm-crypt layer is under it.
rootsrc="$(findmnt -nro SOURCE / 2>/dev/null | sed 's/\[.*//')"
roottype="$(lsblk -nro TYPE "$rootsrc" 2>/dev/null | head -1)"
case "${roottype:-}" in
  crypt) ok "root filesystem is encrypted ($rootsrc)" ;;
  "")    note "root filesystem is not backed by a block device (${rootsrc:-unknown}); encryption state undetermined" ;;
  *)     note "root filesystem is NOT encrypted ($rootsrc, $roottype) — install with --encrypt to change that" ;;
esac

# hidepid on /proc (other users' processes hidden)
if findmnt -no OPTIONS /proc 2>/dev/null | grep -qE 'hidepid=(2|invisible|1)'; then
  ok "hidepid on /proc: $(findmnt -no OPTIONS /proc | tr ',' '\n' | grep hidepid)"
else
  warn "hidepid on /proc NOT set"
fi

# Hardened userspace allocator (scudo) on the base daemons
fspid="$(systemctl show -p MainPID --value fs.service 2>/dev/null)"
if [ -n "${fspid:-}" ] && [ "$fspid" != 0 ] && grep -q 'scudo' "/proc/$fspid/maps" 2>/dev/null; then
  ok "scudo hardened allocator active in fs.service"
else
  warn "scudo allocator NOT detected in fs.service"
fi

# fs daemon SELinux confinement (its own domain, not unconfined_service_t)
fsctx="$(ps -eo label,comm 2>/dev/null | awk '$2=="fs"{print $1; exit}')"
case "$fsctx" in
  *qos_fs_t*) ok "fs.service confined: $fsctx" ;;
  *unconfined_service_t*) warn "fs.service is unconfined_service_t (qos_fs_t not applied)" ;;
  "" ) note "fs.service not running; SELinux domain unknown" ;;
  *) note "fs.service domain: $fsctx" ;;
esac

# Image signature enforcement (verify-before-update). Match the qOS registry
# scope and pinned public-key path together: an unrelated sigstore policy must
# not make this check pass.
policy=/etc/containers/policy.json
if [ -r "$policy" ] \
   && grep -Fq '"code.sandbox.example/qos/qos"' "$policy" \
   && grep -Fq '"type": "sigstoreSigned"' "$policy" \
   && grep -Fq '"keyPath": "/usr/share/qos/cosign.pub"' "$policy" \
   && [ -s /usr/share/qos/cosign.pub ]; then
  ok "container signature policy pins signed qOS images to the installed verification key"
else
  warn "qOS image signature policy or its pinned verification key is missing"
fi

# systemd-homed available (per-user encrypted homes; homed users get a
# LUKS-backed home unlocked at login). The default account is traditional;
# additional users created with `homectl` are per-user-encrypted.
if systemctl is-active systemd-homed >/dev/null 2>&1; then
  ok "systemd-homed active (per-user encrypted homes available)"
else
  note "systemd-homed not active (per-user encrypted homes unavailable)"
fi

# Display server is Wayland (no X11 keylogging surface)
note "display server: Wayland (compositor: shell --backend drm)"

# Unprivileged userns is intentionally ALLOWED — bubblewrap creates one before
# it can drop anything, so switching them off would delete the app sandbox
# rather than harden it. See the header of
# /usr/lib/sysctl.d/60-qos-hardening.conf. Checked, not just noted: a zero here
# means the sandbox cannot start.
maxns="$(sysctl -n user.max_user_namespaces 2>/dev/null || echo '?')"
if [ "$maxns" = "0" ]; then
  warn "user.max_user_namespaces=0 — the app sandbox CANNOT start; something 'hardened' this"
else
  ok "unprivileged user namespaces available (bwrap requires them); max=$maxns"
fi

echo "=== end qOS security audit ==="
if [ "$failures" -ne 0 ]; then
  echo "qOS security audit failed: $failures required invariant(s) are inactive" >&2
  exit 1
fi
exit 0
