#!/bin/bash
# qos-firstboot-user — turn the installer-seeded credential file into a real
# account on the installed system's first boot.
#
# The custom installer cannot create users at install time (bootc install
# makes no users), so it drops `<name>:<sha512-crypt-hash>` into the new
# deployment's /etc/qos/install-user.conf. On first boot, qos-firstboot-user.service
# runs this once: it creates the user (in wheel for sudo), sets the
# pre-hashed password, then SHREDS the file so the hash doesn't linger.
set -euo pipefail

CONF=/etc/qos/install-user.conf
FULL_NAME_CONF=/etc/qos/install-user-full-name
[ -f "$CONF" ] || exit 0

line="$(head -n1 "$CONF")"
user="${line%%:*}"
hash="${line#*:}"
full_name=""
if [ -f "$FULL_NAME_CONF" ]; then
  full_name="$(head -n1 "$FULL_NAME_CONF")"
fi

if [ -z "$user" ] || [ -z "$hash" ] || [ "$user" = "$hash" ]; then
  echo "qos-firstboot-user: malformed $CONF (expected name:hash)" >&2
  # Don't leave a bad credential file lying around.
  shred -u "$CONF" 2>/dev/null || rm -f "$CONF"
  exit 1
fi

if id "$user" >/dev/null 2>&1; then
  echo "qos-firstboot-user: refusing to modify pre-existing account '$user'" >&2
  shred -u "$CONF" 2>/dev/null || rm -f "$CONF"
  exit 1
else
  # `qos-identity` is read access to the machine's device key. The
  # compositor runs in this user's session and presents the device
  # identity on the network — the same identity fs.service presents as
  # root — so without this the session has no network identity at all.
  #
  # `video` is write access to the backlight: 90-qos-backlight.rules
  # hands the group `/sys/class/backlight/*/brightness`, which is what
  # the brightness keys and the quick-settings slider write. Without it
  # brightness silently does nothing.
  if [ -n "$full_name" ]; then
    useradd -m -c "$full_name" -G wheel,qos-identity,video "$user"
  else
    useradd -m -G wheel,qos-identity,video "$user"
  fi
fi

printf '%s:%s\n' "$user" "$hash" | chpasswd -e

# Remove the seed file (best-effort shred; fall back to rm).
shred -u "$CONF" 2>/dev/null || rm -f "$CONF"
[ ! -f "$FULL_NAME_CONF" ] || shred -u "$FULL_NAME_CONF" 2>/dev/null || rm -f "$FULL_NAME_CONF"

echo "qos-firstboot-user: created account '$user'"
