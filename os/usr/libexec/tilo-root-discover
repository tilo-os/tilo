#!/usr/bin/bash
# Resolve the root on the disk whose ESP systemd-stub booted from.
#
# Two GPT types name a root, and each UKI kind selects only its own:
#
#   Tilo root          7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab
#                      an installed system, and the root of a removable
#                      live installer medium
#   Tilo staging root  d4c4daf6-f72c-43ee-b8e3-5ba32550311d
#                      the live installer the Imager staged onto an internal
#                      disk (apps/imager/src/setup/staging), until the
#                      installed system reclaims it (tilo-staging-reclaim)
#
# An installed UKI (no `tilo.install`) boots exactly one Tilo root and never
# considers a staging root, so the staging root left beside a fresh install
# cannot make it ambiguous. The live installer UKI (`tilo.install`) boots
# exactly one staging root when its disk has any, else exactly one Tilo root
# (its own medium). A staged installer booted again after a failed or
# interrupted install therefore still finds itself, not the partial target.
# Zero or several candidates of the selected kind fail closed.
set -euo pipefail

TILO_ROOT_TYPE=7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab
TILO_STAGING_ROOT_TYPE=d4c4daf6-f72c-43ee-b8e3-5ba32550311d
cmdline_file="${TILO_ROOT_CMDLINE_FILE:-/proc/cmdline}"
sysroot="${TILO_ROOT_SYSROOT:-/sys}"
devroot="${TILO_ROOT_DEVROOT:-/dev}"
runtime="${TILO_ROOT_RUNTIME:-/run}"
lsblk_bin="${TILO_ROOT_LSBLK:-lsblk}"
cryptsetup_bin="${TILO_ROOT_CRYPTSETUP:-systemd-cryptsetup}"
cryptsetup_probe="${TILO_ROOT_CRYPTSETUP_PROBE:-cryptsetup}"
plymouth_bin="${TILO_ROOT_PLYMOUTH:-plymouth}"
unlock_bin="${TILO_ROOT_UNLOCK:-/usr/libexec/tilo-rollback-initrd-unlock}"
signin_bin="${TILO_ROOT_SIGNIN:-/usr/libexec/tilo/tilo-boot-signin}"
sibling_bin="${TILO_ROOT_SIBLING_UNLOCK:-tilo-sibling-unlock}"
systemctl_bin="${TILO_ROOT_SYSTEMCTL:-systemctl}"

die() { printf 'tilo-root: %s\n' "$*" >&2; exit 1; }
# Each step of opening the root says what it does, in the journal.
note() { printf 'tilo-root: %s\n' "$*" >&2; }

loader_var="${TILO_ROOT_LOADER_PARTUUID:-}"
if [ -z "$loader_var" ]; then
  var="$(find "$sysroot/firmware/efi/efivars" -maxdepth 1 -type f \
    -name 'LoaderDevicePartUUID-*' -print -quit 2>/dev/null || true)"
  [ -n "$var" ] || die "systemd-stub did not identify the boot ESP"
  loader_var="$(dd if="$var" bs=1 skip=4 status=none | tr -d '\000' | tr '[:upper:]' '[:lower:]')"
fi
case "$loader_var" in
  ????????-????-????-????-????????????) ;;
  *) die "invalid LoaderDevicePartUUID" ;;
esac

esp="$devroot/disk/by-partuuid/$loader_var"
for _ in $(seq 1 100); do [ -e "$esp" ] && break; udevadm settle 2>/dev/null || true; sleep .05; done
[ -e "$esp" ] || die "boot ESP $loader_var did not appear"
esp="$(readlink -f "$esp")"
mapfile -t parents < <("$lsblk_bin" -dno PKNAME "$esp")
[ "${#parents[@]}" -eq 1 ] \
  || die "could not identify exactly one physical disk for the boot ESP"
read -r parent extra <<<"${parents[0]}"
[ -n "$parent" ] && [ -z "${extra:-}" ] \
  || die "could not identify the boot ESP's physical disk"
case "$parent" in /*) disk="$parent" ;; *) disk="$devroot/$parent" ;; esac

live=0
cmdline=()
read -r -a cmdline <"$cmdline_file" || [ "${#cmdline[@]}" -gt 0 ] \
  || die "could not read the kernel command line"
for token in "${cmdline[@]}"; do
  [ "$token" != tilo.install ] || live=1
done

partitions="$("$lsblk_bin" -lnpo NAME,TYPE,PARTTYPE "$disk")" \
  || die "could not list the partitions of the boot ESP's disk"
of_type() {
  awk -v t="$1" 'tolower($2)=="part" && tolower($3)==t {print $1}' <<<"$partitions"
}

roots=()
kind="Tilo root"
if [ "$live" -eq 1 ]; then
  mapfile -t roots < <(of_type "$TILO_STAGING_ROOT_TYPE")
  [ "${#roots[@]}" -eq 0 ] || kind="Tilo staging root"
fi
[ "${#roots[@]}" -gt 0 ] || mapfile -t roots < <(of_type "$TILO_ROOT_TYPE")
[ "${#roots[@]}" -eq 1 ] \
  || die "expected exactly one $kind on the boot ESP's disk; found ${#roots[@]}"
root="${roots[0]}"

install -d -m 0700 "$runtime/tilo-root" "$runtime/cryptsetup-keys.d"
if "$cryptsetup_probe" isLuks "$root" >/dev/null 2>&1; then
  # The key file opens the volume, and /run is carried into the booted
  # system: it goes once the volume is open or an attempt is over.
  forget_key() { rm -f -- "$runtime/cryptsetup-keys.d/root.key"; }
  # A root enrolled for unlocking with another of the owner's devices asks
  # them while the prompts below are up; the person can still type the
  # passphrase meanwhile, and whichever answers first opens the volume. The
  # attempt is stopped, and everything it held wiped, once the volume is open.
  sibling_unit=""
  stop_sibling() {
    [ -z "$sibling_unit" ] || "$systemctl_bin" stop "$sibling_unit" 2>/dev/null || true
    sibling_unit=""
  }
  attach_pid=""
  stop_attach() {
    if [ -n "$attach_pid" ]; then
      kill "$attach_pid" 2>/dev/null || true
      wait "$attach_pid" 2>/dev/null || true
    fi
    attach_pid=""
  }
  # While tilo-boot-signin asks systemd-cryptsetup's questions in its place
  # (below), Plymouth's own password agent is stopped; it is started again
  # whenever that ends.
  agent_stopped=0
  resume_agent() {
    if [ "$agent_stopped" -eq 1 ]; then
      note "starting Plymouth's password agent again"
      "$systemctl_bin" start systemd-ask-password-plymouth.path \
        || note "Plymouth's password agent did not start again"
    fi
    agent_stopped=0
  }
  trap 'stop_attach; stop_sibling; resume_agent; forget_key' EXIT
  # Until someone has a sign-in on this root, the booted system needs the
  # volume key once, to add the first person's keyslot when they sign in;
  # tilo-authd takes it from uid 0's user keyring and unlinks it.
  attach_options='tpm2-device=auto,fido2-device=auto,tries=0,timeout=0,password-cache=no'
  if ! "$cryptsetup_probe" luksDump "$root" 2>/dev/null | awk '
      /^Tokens:/ { tokens = 1; next }
      /^[^ \t]/ { tokens = 0 }
      tokens && $2 == "tilo-signin" { found = 1 }
      END { exit !found }'; then
    attach_options="$attach_options,link-volume-key=@u::%user:tilo-auth:volume-key"
  fi
  # systemd-cryptsetup sends rejection details to its log, not to the
  # graphical password agent. Preserve those logs and forward only an opaque
  # retry event to Plymouth; no password is read or retained by this wrapper.
  report_rejections() {
    while IFS= read -r message; do
      printf '%s\n' "$message" >&2
      case "$message" in
        *'Failed to activate with specified passphrase. (Passphrase incorrect?)'*)
          "$plymouth_bin" display-message --text=tilo-unlock-retry 2>/dev/null || true
          ;;
      esac
    done
  }

  # The boot screen says what the volume's own prompt takes: the password,
  # a disk passphrase, the recovery key, as this volume's header has them.
  if [ -x "$signin_bin" ]; then
    "$signin_bin" unlock-prompt --device "$root" \
      || note "the volume's prompt keeps its general wording"
  fi
  while :; do
    # A root that people sign in to (tilo-signin tokens) asks for a person's
    # own PIN or password first, and that sign-in carries on into their
    # session. It leaves the volume's key file when it succeeds; otherwise
    # (nobody to sign in, or "Can't sign in") the volume opens as any other
    # root does. After "Can't sign in" an empty answer to any of those
    # questions comes back here, to the sign-in screen.
    signed_in=0
    offer_back=0
    if [ -x "$signin_bin" ]; then
      note "sign-in screen"
      signin=0
      "$signin_bin" --device "$root" --volume root || signin=$?
      case "$signin" in
        0) signed_in=1; note "signed in" ;;
        3) offer_back=1; note "another way in was chosen" ;;
        *) note "nobody signs in here (sign-in screen exited $signin)" ;;
      esac
    fi
    if [ "$signed_in" -eq 0 ]; then
      note "TPM PIN prompt, if the volume has a tilo-rollback token"
      "$unlock_bin" "$root" root || true
      if "$sibling_bin" probe "$root" >/dev/null 2>&1; then
        sibling_unit="tilo-sibling-unlock@$(systemd-escape --path "$root").service"
        note "asking another of the owner's devices ($sibling_unit)"
        "$systemctl_bin" start --no-block "$sibling_unit" || sibling_unit=""
      fi
    fi
    if [ "$offer_back" -eq 1 ]; then
      if "$systemctl_bin" stop \
           systemd-ask-password-plymouth.path systemd-ask-password-plymouth.service; then
        agent_stopped=1
        note "Plymouth's password agent stopped; the sign-in screen asks the volume's questions"
      else
        note "Plymouth's password agent could not be stopped; no way back from these questions"
      fi
    fi
    # Keep the graphical prompt available after a typo. Do not recycle a
    # failed passphrase from the agent cache into the remaining attempts.
    # TPM/FIDO enrollments and recovery keys remain available on functioning
    # platforms.
    # The log is read in its own process, so the attach itself has a process
    # id to tell its questions apart by, and is read to the end before the
    # outcome is reported.
    exec {log_fd}> >(report_rejections)
    log_pid=$!
    LC_ALL=C SYSTEMD_LOG_TARGET=console "$cryptsetup_bin" attach root "$root" - "$attach_options" \
      >&"$log_fd" 2>&1 &
    attach_pid=$!
    exec {log_fd}>&-
    note "attaching the volume (systemd-cryptsetup $attach_pid)"
    if [ "$agent_stopped" -eq 1 ]; then
      relayed=0
      "$signin_bin" other-ways --device "$root" --pid "$attach_pid" || relayed=$?
      note "the sign-in screen's agent ended ($relayed)"
      if [ "$relayed" -eq 3 ]; then
        note "back to the sign-in screen"
        stop_attach
        wait "$log_pid" 2>/dev/null || true
        stop_sibling
        resume_agent
        forget_key
        continue
      fi
      # Done, or Plymouth could not ask: its own agent takes over any
      # question still waiting.
      resume_agent
    fi
    attached=0
    wait "$attach_pid" || attached=$?
    attach_pid=""
    wait "$log_pid" 2>/dev/null || true
    [ "$attached" -eq 0 ] || die "encrypted Tilo root did not unlock"
    note "the volume is open"
    break
  done
  stop_sibling
  forget_key
  "$plymouth_bin" display-message --text=tilo-unlock-success 2>/dev/null || true
  target="$devroot/mapper/root"
else
  target="$root"
fi
if [ "${TILO_ROOT_ALLOW_NONBLOCK:-0}" != 1 ]; then
  [ -b "$target" ] || die "resolved Tilo root is not a block device"
fi
ln -sfn "$target" "$runtime/tilo-root/device"
printf '%s\n' "$root" > "$runtime/tilo-root/source"
