#!/bin/bash
# tilo-install — the privileged backend for the Tilo custom (self-install)
# installer. The tilo-installer UI (a ui::App, run under cage on the live
# medium) shells out to this with:
#
#     /usr/libexec/tilo-install --disk <dev> --confirm-erase <dev> --user <name> --yes
#
# and the account password on **stdin** (a single line). Optional flags:
#
#     --filesystem <btrfs|ext4|xfs>   root filesystem (default: btrfs)
#     --hostname <name>               hostname for the installed system (default: tilo)
#     --timezone <Area/City>          IANA time zone (default: system default / UTC)
#     --keymap <xkb-layout>           keyboard layout, e.g. us, de (default: us)
#     --keyvariant <xkb-variant>      keyboard variant, e.g. dvorak (default: none)
#     --encrypt                       accepted for UI compatibility; native Tilo
#                                     always uses LUKS2 full-disk encryption
#     --pin                           legacy flag name for the required strong
#                                     disk passphrase on stdin line 2
#                                     (requires --encrypt)
#     --fido2                         also enrol a FIDO2 token (requires --encrypt)
#     --extension ID                  the owner turned on the Tilo extension ID
#                                     (e.g. media-codecs; repeatable): record it
#                                     for the installed system, which downloads
#                                     it from its publishers once it is online
#                                     (nothing is fetched here; see
#                                     /usr/share/tilo/system-extensions/README.md)
#     --alongside --root-partition P --efi-partition P
#                                     preserve the disk's partition table;
#                                     format only a prepared empty Linux root
#                                     and reuse (never format) its existing ESP
#     --guided-alongside [reviewed free-space geometry and partition map]
#                                     append a dedicated ESP and root inside one
#                                     exact unallocated GPT extent; never resize,
#                                     move, or delete an existing partition
#     --internal-handoff FILE         USB-free install: the disk holding the
#                                     running (staged) installer may be the
#                                     target, but only for --guided-alongside
#                                     into the staged target extent. Every fact
#                                     is re-derived by tilo-staging-handoff.
#     --confirm-erase <dev>           required for whole-disk installs and must
#                                     exactly match --disk
#     --confirm-root <partition>      required for alongside installs and must
#                                     exactly match --root-partition
#     --expect-disk-size-bytes N --expect-disk-devnum MAJ:MIN
#                                     bind the reviewed disk to its discovered
#                                     size and kernel device number
#     --expect-disk-wwn ID            also bind its WWN when hardware exposes it
#     --expect-disk-serial ID         also bind its serial when exposed
#     --expect-root-partuuid UUID --expect-root-size-bytes N
#     --expect-efi-partuuid UUID --expect-efi-size-bytes N
#                                     bind both alongside partitions to their
#                                     discovered GPT identities and sizes
#
# An older UI may omit `--encrypt`, but the backend still encrypts. It must
# provide `--pin`; otherwise installation fails closed. We:
#
#   1. authenticate and import a separately signed offline target when one is
#      preloaded; otherwise copy the currently-booted image into local storage
#      (`bootc image copy-to-storage` -> containers-storage:localhost/bootc),
#   2. install from the selected image, in a privileged podman container, onto
#      the target disk (wipes it, --filesystem layout). tilo-disk-encrypt builds
#      the GPT + LUKS2 layout and bootc installs `to-filesystem` into the opened
#      mapping — see that script for why the volume is not created by
#      `--block-setup tpm2-luks`. On a large enough disk the layout ends with
#      the LUKS2 + Btrfs room store the storage daemon's native data plane
#      serves from; its key file goes into the encrypted root (step 3b),
#      from where it unlocks at boot without a second prompt,
#   3. create the user account: `bootc install` does NOT make users, so we
#      hash the password and drop `<name>:<hash>` into the freshly-installed
#      deployment's WRITABLE /etc/tilo/install-user.conf, which a baked
#      first-boot oneshot (tilo-firstboot-user.service) turns into a real
#      account on the installed system's first boot.
#   4. seed the hostname (/etc/hostname), the time zone (/etc/localtime
#      symlink + /etc/timezone) and the keyboard layout into the same
#      writable /etc: XKB_DEFAULT_LAYOUT/VARIANT in /etc/environment (the
#      Tilo Wayland compositor reads these via xkbcommon when its own xkb
#      config is empty) and KEYMAP in /etc/vconsole.conf for the console.
#
# Everything human-readable goes to stdout (the UI tails it line by line);
# exit 0 == success, non-zero == failure.
#
# This is intentionally an OFFLINE model: no network pull is needed for the OS
# bits. Development media self-install; CI media can carry a distinct signed
# target whose digest and provenance are checked before any disk mutation.
# The target image *reference* recorded in the install (so future
# `bootc upgrade` knows where to pull from) is bound by a hardware profile.
# Generic images retain the official latest default and trusted overrides.
set -euo pipefail

# Where the installed system will look for updates (the "origin" imgref
# baked into the deployment). NOT where the bits come from now — those come
# from the booted image we copy to storage. Resolve the immutable profile on
# every re-exec; an environment override may not change its reviewed origin.
TILO_TARGET_IMGREF="$(python3 /usr/lib/tilo/hardware_profile.py \
  --install-update-origin "${TILO_TARGET_IMGREF:-}")" || exit 1

# The local-storage tag `bootc image copy-to-storage` writes to by default.
LOCAL_IMG="localhost/bootc"

# The block-level half of an encrypted install (partitioning, LUKS2, factor
# enrolment). Overridable so it can be driven directly in a test VM.
DISK_ENCRYPT="${TILO_DISK_ENCRYPT:-/usr/libexec/tilo-disk-encrypt}"
STAGING_HANDOFF="${TILO_STAGING_HANDOFF:-/usr/libexec/tilo-staging-handoff}"
# The room store volume the storage daemon's native data plane serves from.
STORE_VOLUME="${TILO_STORE_VOLUME:-/usr/libexec/tilo-store-volume}"
GUIDED_PARTITION="${TILO_GUIDED_PARTITION:-/usr/libexec/tilo-guided-partition}"
EFI_ARTIFACTS="${TILO_INSTALL_EFI_ARTIFACTS:-/usr/libexec/tilo-install-efi-artifacts}"
BOOT_MENU="${TILO_INSTALL_BOOT_MENU:-/usr/libexec/tilo-install-boot-menu}"
BOOT_MOUNT_CONTRACT="${TILO_BOOT_MOUNT_CONTRACT:-/usr/libexec/tilo-boot-mount-contract}"
LOCALE_CATALOG=/usr/share/tilo/installer-locales.txt
BOOT_MOUNT_CONTRACT="${TILO_BOOT_MOUNT_CONTRACT:-/usr/libexec/tilo-boot-mount-contract}"

# Alongside installs share a firmware-visible FAT ESP with Tilo's retained,
# staged, and repair UKIs. Six 160 MiB image slots plus filesystem slack need
# 1 GiB available; requiring a 2 GiB partition also leaves room for firmware
# metadata and any other vendor boot files already present.
MIN_ALONGSIDE_ESP_BYTES=2147483648
MIN_ALONGSIDE_ESP_FREE_BYTES=1073741824

log()  { printf '%s\n' "$*"; }
step() { printf '\n==> %s\n' "$*"; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

# The shared immutable-image resolver above enforces the production repository
# or the development image's exact bound origin and required-signature policy.
# An environment override alone cannot enable development trust.

# Map an xkb layout (+optional variant) to a Linux console (kbd) keymap
# name for /etc/vconsole.conf. The console map set doesn't line up 1:1 with
# xkb, so this is a curated table for the layouts the installer offers;
# anything unknown falls back to "us" so the TTY is always usable.
xkb_to_vconsole() {
  local layout="$1" variant="$2"
  # Variants first (e.g. us/dvorak → dvorak; us/colemak has no stock kbd
  # map, so it falls back to us).
  case "${layout}/${variant}" in
    us/dvorak) printf 'dvorak'; return ;;
  esac
  case "$layout" in
    us)  printf 'us' ;;
    gb)  printf 'uk' ;;
    de)  printf 'de' ;;
    fr)  printf 'fr' ;;
    es)  printf 'es' ;;
    it)  printf 'it' ;;
    pt)  printf 'pt-latin1' ;;
    br)  printf 'br-abnt2' ;;
    ru)  printf 'ru' ;;
    se)  printf 'se-latin1' ;;
    no)  printf 'no' ;;
    dk)  printf 'dk' ;;
    ch)  printf 'sg' ;;
    pl)  printf 'pl' ;;
    *)   printf 'us' ;;
  esac
}

# --- self-escalate -----------------------------------------------------------
# The UI runs as the unprivileged greetd session user; re-exec ourselves as
# root via passwordless sudo (the live-medium-only sudoers drop-in installed
# by tilo-installer-setup.service permits exactly this command). sudo passes
# our stdin (the password) straight through to the re-exec'd copy, so we read
# it only once we are root.
if [ "$(id -u)" -ne 0 ]; then
  exec sudo -n "$0" "$@"
fi

# --- run the privileged work as a TRANSIENT SYSTEM UNIT ----------------------
# Even as root, this script is still in the greeter session's SELinux domain
# (xdm_t) — the UI runs under cage in the greetd session, and a plain `sudo`
# does not change the SELinux domain. xdm_t is denied the privileged
# container/install operations: `bootc image copy-to-storage` returns EACCES
# ("Permission denied (os error 13)") under SELinux enforcing. This is the one
# thing that historically forced the live medium to boot `enforcing=0`.
#
# Fix: re-launch ourselves as a TRANSIENT systemd unit. systemd (PID 1, the
# `init_t` domain) spawns the unit, so the real work runs in a system-service
# domain — NOT xdm_t — which the targeted policy already permits to drive
# podman/bootc (the normal "systemd runs a container service" path). This is
# what lets the installer live medium stay SELinux-ENFORCING (no enforcing=0).
#
# We are already root here (via the sudoers drop-in), so `systemd-run` talks to
# the system manager directly — no second sudo, and the existing sudoers rule
# is unchanged. Do not use `systemd-run --pipe`: Fedora/systemd can reset the
# transient-unit D-Bus request while passing the greeter process's anonymous
# pipes as file descriptors. A private /run bridge gives the unit ordinary
# root-only files instead. We tail its output back to the UI while it runs; the
# startup secret and recovery key never enter the journal or command line.
# The TILO_INSTALL_TRANSIENT guard breaks the re-exec recursion: the unit runs
# this same script again, already in the system domain, and falls through to
# the real work below.
#
# A live install requires the system-service transition. Running the backend
# directly from the greeter would bypass its enforced SELinux boundary.
if [ -z "${TILO_INSTALL_TRANSIENT:-}" ] && command -v systemd-run >/dev/null 2>&1; then
  # tilo-installer-setup creates this from PID 1 before the greeter starts, so
  # it has a system runtime SELinux label rather than xdm_tmp_t. The latter is
  # deliberately inaccessible to an enforcing transient system service.
  [ -d /run/tilo-installer/bridge ] \
    || die "installer runtime bridge is missing (tilo-installer-setup did not complete)"
  BRIDGE="/run/tilo-installer/bridge/run.$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  INPUT="$BRIDGE/stdin"
  OUTPUT="$BRIDGE/output"
  # Only the system manager creates and labels these files. The greeter's
  # domain has read/write access to this dedicated type, but no create or
  # relabel permission. No secret is passed to this preparation unit.
  systemd-run --collect --quiet --wait --unit="tilo-bridge-prepare-$$" \
    --property=Type=exec -- /usr/bin/bash -ec \
    'umask 077; mkdir -m 0700 -- "$1"; : > "$1/stdin"; : > "$1/output"; /usr/sbin/restorecon -RF -- "$1"' \
    _ "$BRIDGE"
  cleanup_bridge() {
    systemd-run --collect --quiet --wait --unit="tilo-bridge-clean-$$" \
      --property=Type=exec -- /usr/bin/rm -rf -- "$BRIDGE" || true
  }
  trap cleanup_bridge EXIT
  [ "$(stat -c '%u:%a' "$BRIDGE")" = 0:700 ] \
    && [ "$(stat -c '%u:%a' "$INPUT")" = 0:600 ] \
    && [ "$(stat -c '%u:%a' "$OUTPUT")" = 0:600 ] \
    || die "installer runtime bridge permissions are unsafe"
  if /usr/sbin/selinuxenabled; then
    /usr/sbin/matchpathcon -V "$BRIDGE" "$INPUT" "$OUTPUT" >/dev/null 2>&1 \
      || die "installer runtime bridge has an unexpected SELinux label"
  fi
  cat > "$INPUT"
  systemd-run \
    --collect --quiet --wait \
    --unit="tilo-install-$$" \
    --property=Type=exec \
    --property=PrivateMounts=yes \
    --property="StandardInput=file:$INPUT" \
    --property="StandardOutput=append:$OUTPUT" \
    --property="StandardError=append:$OUTPUT" \
    --setenv=TILO_INSTALL_TRANSIENT=1 \
    --setenv=TILO_TARGET_IMGREF="$TILO_TARGET_IMGREF" \
    -- "$0" "$@" &
  RUNNER=$!
  tail --pid="$RUNNER" -n +1 -F "$OUTPUT" &
  TAILER=$!
  set +e
  wait "$RUNNER"
  RC=$?
  wait "$TAILER" 2>/dev/null
  if [ ! -s "$OUTPUT" ]; then
    printf 'error: transient installer service failed before producing output (status %s)\n' "$RC" >&2
  fi
  set -e
  exit "$RC"
fi
if [ -z "${TILO_INSTALL_TRANSIENT:-}" ]; then
  die "systemd-run is required for the enforced installer backend"
fi

# Only the transient backend owns this lock. The greeter launcher re-execs
# through systemd first and must neither access root-private state nor hold
# the lock while waiting for its child unit.
if [ -d /run/tilo-installer/code-refresh ]; then
  exec {installer_code_lock}>/run/tilo-installer/code-refresh/lock
  flock -n "$installer_code_lock" || { echo 'installer code refresh is running' >&2; exit 1; }
  python3 -c 'import json; from pathlib import Path; p=Path("/run/tilo-installer/code-refresh/active.json"); assert not p.exists() or json.loads(p.read_text())["state"] == "applied", "installer code refresh is incomplete"'
fi

# TILO_VM_CODE_REFRESH_PROBE_V1: read-only execution evidence for the opted-in
# local helper loop. Runs AFTER the real transient re-exec and backend lock.
if { [ "$#" -eq 1 ] || { [ "$#" -eq 2 ] && [ "$2" = --cached-target ]; }; } && [ "$1" = --dev-code-refresh-probe ]; then
  [ "${TILO_INSTALL_TRANSIENT:-}" = 1 ] && [ "$(id -u)" = 0 ] \
    && [ -f /usr/share/tilo/unverified-vm-install ] \
    && [ "$(cat /usr/lib/tilo/image-flavour)" = dev ] \
    && [ -c /dev/virtio-ports/org.tilo.installer-code ] \
    && [ -c /dev/virtio-ports/org.tilo.vm-install-proof ] \
    && grep -qw tilo.install /proc/cmdline \
    && timeout 5s systemd-detect-virt --vm --quiet \
    || die "backend code probe requires the opted-in development VM"
  python3 - "$0" "${2:-}" <<'PY'
import hashlib, importlib.util, json, os, sys
from pathlib import Path
context = Path('/proc/self/attr/current').read_text().strip().strip('\0')
enforcing = Path('/sys/fs/selinux/enforce').read_bytes().strip() == b'1'
assert enforcing and context.split(':')[2] in ('init_t', 'unconfined_service_t'), f'backend probe did not execute in enforcing system service: enforcing={enforcing} domain={context!r}'
resolver = None
target = None
helper_path = Path('/usr/libexec/tilo-installer-dev-target-uki.py')
spec = importlib.util.spec_from_file_location('runtime_projection_probe', helper_path)
helper = importlib.util.module_from_spec(spec); spec.loader.exec_module(helper)
if hasattr(helper, 'PROFILE_TOOLS'):
    module_path = helper.PROFILE_TOOLS / 'hardware_profile.py'
    module = helper.load_module(module_path, 'runtime_profile_probe')
    module.resolve_profile(Path('/'), os.uname().release, 'aarch64')
    resolver = hashlib.sha256(module_path.read_bytes()).hexdigest()
if sys.argv[2] == '--cached-target':
    path = Path('/etc/tilo/installer-code-bootstrap/tilo-installer-code-target-probe.py')
    spec = importlib.util.spec_from_file_location('cached_target_probe', path)
    probe = importlib.util.module_from_spec(spec); spec.loader.exec_module(probe)
    target = probe.probe()
print(json.dumps({'schema':'tilo.installer-code-backend-probe.v1', 'transient':1,
                  'domain':context, 'enforcing':enforcing, 'tag':'initial',
                  'profile_resolver_sha256':resolver,
                  'cached_target':target,
                  'helper_sha256':hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest()}, sort_keys=True))
PY
  exit 0
fi

# --- parse args --------------------------------------------------------------
DISK=""
USERNAME=""
ASSUME_YES=0
# New, optional options (UI passes these; older UIs omit them → defaults).
FILESYSTEM="btrfs"   # btrfs | ext4 | xfs
HOSTNAME_VAL="tilo"
FULL_NAME=""
LOCALE_VAL="en_US.UTF-8"
TIMEZONE_VAL=""      # empty → leave system default (UTC)
KEYMAP_VAL="us"      # xkb layout (default us)
KEYVARIANT_VAL=""    # xkb variant (empty → none)
ENCRYPT=1            # Native Tilo is always installed into a LUKS2 root.
WANT_PIN=0           # --pin is mandatory; secret arrives on stdin line 2.
WANT_FIDO2=0         # --fido2 → also enroll a FIDO2 security key if present
EXTENSIONS=""        # --extension ID → seed that extension's opt-in for first boot
ALONGSIDE=0
GUIDED_ALONGSIDE=0
PREFLIGHT_ALONGSIDE=0
ROOT_PARTITION=""
BOOT_PARTITION=""
EFI_PARTITION=""
CONFIRM_ERASE=""
CONFIRM_ROOT=""
EXPECT_DISK_SIZE_BYTES=""
EXPECT_DISK_DEVNUM=""
EXPECT_DISK_WWN=""
EXPECT_DISK_SERIAL=""
EXPECT_ROOT_PARTUUID=""
EXPECT_ROOT_SIZE_BYTES=""
EXPECT_BOOT_PARTUUID=""
EXPECT_BOOT_SIZE_BYTES=""
EXPECT_EFI_PARTUUID=""
EXPECT_EFI_SIZE_BYTES=""
FREE_START_BYTES=""
FREE_SIZE_BYTES=""
EFI_START_BYTES=""
EFI_SIZE_BYTES=""
BOOT_START_BYTES=""
BOOT_SIZE_BYTES=""
ROOT_START_BYTES=""
ROOT_SIZE_BYTES=""
EXPECT_DISK_PTUUID=""
EXPECT_LOGICAL_SECTOR_SIZE=""
NEW_EFI_PARTUUID=""
NEW_BOOT_PARTUUID=""
NEW_ROOT_PARTUUID=""
CONFIRM_FREE_SPACE=""
INTERNAL_HANDOFF=""
EXPECTED_PARTITIONS=()
PIN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --disk) DISK="${2:-}"; shift 2 ;;
    --user) USERNAME="${2:-}"; shift 2 ;;
    --filesystem) FILESYSTEM="${2:-}"; shift 2 ;;
    --hostname) HOSTNAME_VAL="${2:-}"; shift 2 ;;
    --full-name) FULL_NAME="${2:-}"; shift 2 ;;
    --locale) LOCALE_VAL="${2:-}"; shift 2 ;;
    --timezone) TIMEZONE_VAL="${2:-}"; shift 2 ;;
    --keymap) KEYMAP_VAL="${2:-}"; shift 2 ;;
    --keyvariant) KEYVARIANT_VAL="${2:-}"; shift 2 ;;
    --encrypt) ENCRYPT=1; shift ;;
    --pin) WANT_PIN=1; shift ;;
    --fido2) WANT_FIDO2=1; shift ;;
    --extension)
      case "${2:-}" in
        [a-z0-9]*) ;;
        *) die "--extension needs an extension id" ;;
      esac
      case "${2}" in
        *[!a-z0-9-]*) die "invalid extension id: ${2}" ;;
      esac
      [ -f "/usr/share/tilo/system-extensions/sysext.d/${2}.json" ] \
        || die "this image has no extension ${2}"
      EXTENSIONS="$EXTENSIONS ${2}"; shift 2 ;;
    --alongside) ALONGSIDE=1; shift ;;
    --preflight-alongside) ALONGSIDE=1; PREFLIGHT_ALONGSIDE=1; shift ;;
    --guided-alongside) ALONGSIDE=1; GUIDED_ALONGSIDE=1; shift ;;
    --root-partition) ROOT_PARTITION="${2:-}"; shift 2 ;;
    --boot-partition) BOOT_PARTITION="${2:-}"; shift 2 ;;
    --efi-partition) EFI_PARTITION="${2:-}"; shift 2 ;;
    --confirm-erase) CONFIRM_ERASE="${2:-}"; shift 2 ;;
    --confirm-root) CONFIRM_ROOT="${2:-}"; shift 2 ;;
    --expect-disk-size-bytes) EXPECT_DISK_SIZE_BYTES="${2:-}"; shift 2 ;;
    --expect-disk-devnum) EXPECT_DISK_DEVNUM="${2:-}"; shift 2 ;;
    --expect-disk-wwn) EXPECT_DISK_WWN="${2:-}"; shift 2 ;;
    --expect-disk-serial) EXPECT_DISK_SERIAL="${2:-}"; shift 2 ;;
    --expect-root-partuuid) EXPECT_ROOT_PARTUUID="${2:-}"; shift 2 ;;
    --expect-root-size-bytes) EXPECT_ROOT_SIZE_BYTES="${2:-}"; shift 2 ;;
    --expect-boot-partuuid) EXPECT_BOOT_PARTUUID="${2:-}"; shift 2 ;;
    --expect-boot-size-bytes) EXPECT_BOOT_SIZE_BYTES="${2:-}"; shift 2 ;;
    --expect-efi-partuuid) EXPECT_EFI_PARTUUID="${2:-}"; shift 2 ;;
    --expect-efi-size-bytes) EXPECT_EFI_SIZE_BYTES="${2:-}"; shift 2 ;;
    --free-start-bytes) FREE_START_BYTES="${2:-}"; shift 2 ;;
    --free-size-bytes) FREE_SIZE_BYTES="${2:-}"; shift 2 ;;
    --efi-start-bytes) EFI_START_BYTES="${2:-}"; shift 2 ;;
    --efi-size-bytes) EFI_SIZE_BYTES="${2:-}"; shift 2 ;;
    --boot-start-bytes) BOOT_START_BYTES="${2:-}"; shift 2 ;;
    --boot-size-bytes) BOOT_SIZE_BYTES="${2:-}"; shift 2 ;;
    --root-start-bytes) ROOT_START_BYTES="${2:-}"; shift 2 ;;
    --root-size-bytes) ROOT_SIZE_BYTES="${2:-}"; shift 2 ;;
    --expect-disk-ptuuid) EXPECT_DISK_PTUUID="${2:-}"; shift 2 ;;
    --expect-logical-sector-size) EXPECT_LOGICAL_SECTOR_SIZE="${2:-}"; shift 2 ;;
    --new-efi-partuuid) NEW_EFI_PARTUUID="${2:-}"; shift 2 ;;
    --new-boot-partuuid) NEW_BOOT_PARTUUID="${2:-}"; shift 2 ;;
    --new-root-partuuid) NEW_ROOT_PARTUUID="${2:-}"; shift 2 ;;
    --expect-partition) EXPECTED_PARTITIONS+=("${2:-}"); shift 2 ;;
    --confirm-free-space) CONFIRM_FREE_SPACE="${2:-}"; shift 2 ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    --internal-handoff) INTERNAL_HANDOFF="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,54p' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

# The signed target UKI always mounts TILO_BOOT. Every supported install mode
# must create that ext4 partition before promotion; reject any future caller
# that tries to revive a direct, unencrypted bootc path without its mount.
[ "$ENCRYPT" -eq 1 ] || die "the signed target UKI requires encrypted TILO_BOOT layout"

[ -n "$DISK" ] || die "missing --disk <device>"
[ -n "$USERNAME" ] || die "missing --user <name>"
case "$EXPECT_DISK_SIZE_BYTES" in
  ''|*[!0-9]*|0) die "missing or invalid --expect-disk-size-bytes" ;;
esac
[[ "$EXPECT_DISK_DEVNUM" =~ ^[0-9]+:[0-9]+$ ]] \
  || die "missing or invalid --expect-disk-devnum (expected MAJ:MIN)"
[ "${#EXPECT_DISK_WWN}" -le 256 ] || die "expected disk WWN is too long"
[ "${#EXPECT_DISK_SERIAL}" -le 256 ] || die "expected disk serial is too long"
[ -n "$EXPECT_DISK_WWN$EXPECT_DISK_SERIAL" ] \
  || die "missing stable disk identity (expected WWN or serial)"
if printf '%s%s' "$EXPECT_DISK_WWN" "$EXPECT_DISK_SERIAL" | LC_ALL=C grep -q '[[:cntrl:]]'; then
  die "expected disk identity contains control characters"
fi

ALONGSIDE_BOOTC_PODMAN_ARGS=()
ALONGSIDE_BOOTC_COMMAND=(bootc)
if [ "$ALONGSIDE" -eq 1 ]; then
  # Upstream bootc may choose the first ESP on the disk rather than the one
  # mounted at target /boot/efi. Check the corrected installer binary before
  # guided partition creation, formatting, or any other disk mutation.
  ALONGSIDE_BOOTC=/usr/libexec/tilo-bootc-alongside
  [ -f "$ALONGSIDE_BOOTC" ] && [ ! -L "$ALONGSIDE_BOOTC" ] \
    && [ -x "$ALONGSIDE_BOOTC" ] \
    && [ "$(stat -c '%u:%g' "$ALONGSIDE_BOOTC")" = 0:0 ] \
    && [ "$("$ALONGSIDE_BOOTC" --version)" = 'bootc 1.16.13' ] \
    || die "alongside install requires the pinned mounted-ESP bootc helper"
  # The pinned binary must be executable in the container; Podman may inherit
  # a noexec source mount from the sealed installer when :exec is omitted.
  ALONGSIDE_BOOTC_PODMAN_ARGS=(-v "$ALONGSIDE_BOOTC:/run/tilo-bootc-alongside:ro,exec" \
    --entrypoint /run/tilo-bootc-alongside)
  ALONGSIDE_BOOTC_COMMAND=()
  [ -z "$CONFIRM_ERASE" ] || die "--confirm-erase cannot be used with --alongside"
  if [ "$GUIDED_ALONGSIDE" -eq 1 ]; then
    [ -z "$ROOT_PARTITION$BOOT_PARTITION$EFI_PARTITION$CONFIRM_ROOT" ] \
      || die "guided alongside creates its own partitions; prepared partition arguments are not allowed"
    [ "$CONFIRM_FREE_SPACE" = "$DISK" ] \
      || die "guided alongside requires --confirm-free-space matching --disk"
    for value in FREE_START_BYTES FREE_SIZE_BYTES EFI_START_BYTES EFI_SIZE_BYTES ROOT_START_BYTES ROOT_SIZE_BYTES EXPECT_LOGICAL_SECTOR_SIZE; do
      case "${!value}" in ''|*[!0-9]*|0) die "missing or invalid guided value $value" ;; esac
    done
    [[ "$EXPECT_DISK_PTUUID" =~ ^[0-9A-Fa-f-]{8,64}$ ]] \
      || die "missing or invalid --expect-disk-ptuuid"
    [[ "$NEW_ROOT_PARTUUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
      || die "missing or invalid --new-root-partuuid"
    [[ "$NEW_EFI_PARTUUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
      || die "missing or invalid --new-efi-partuuid"
    if [ "$ENCRYPT" -eq 1 ]; then
      for value in BOOT_START_BYTES BOOT_SIZE_BYTES; do
        case "${!value}" in ''|*[!0-9]*|0) die "missing or invalid guided boot value $value" ;; esac
      done
      [[ "$NEW_BOOT_PARTUUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
        || die "encrypted guided alongside requires --new-boot-partuuid"
    else
      [ -z "$BOOT_START_BYTES$BOOT_SIZE_BYTES$NEW_BOOT_PARTUUID" ] \
        || die "boot partition arguments require encryption"
    fi
  else
    [ -n "$ROOT_PARTITION" ] && [ -n "$EFI_PARTITION" ] \
      || die "--alongside requires --root-partition and --efi-partition"
    [ "$CONFIRM_ROOT" = "$ROOT_PARTITION" ] \
      || die "alongside install requires --confirm-root matching --root-partition"
    case "$EXPECT_ROOT_SIZE_BYTES" in
      ''|*[!0-9]*|0) die "missing or invalid --expect-root-size-bytes" ;;
    esac
    case "$EXPECT_EFI_SIZE_BYTES" in
      ''|*[!0-9]*|0) die "missing or invalid --expect-efi-size-bytes" ;;
    esac
    [[ "$EXPECT_ROOT_PARTUUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
      || die "missing or invalid --expect-root-partuuid"
    [[ "$EXPECT_EFI_PARTUUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
      || die "missing or invalid --expect-efi-partuuid"
    if [ "$ENCRYPT" -eq 1 ]; then
      [ -n "$BOOT_PARTITION" ] || die "encrypted alongside requires --boot-partition"
      case "$EXPECT_BOOT_SIZE_BYTES" in ''|*[!0-9]*|0) die "missing or invalid --expect-boot-size-bytes" ;; esac
      [[ "$EXPECT_BOOT_PARTUUID" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
        || die "missing or invalid --expect-boot-partuuid"
    else
      [ -z "$BOOT_PARTITION$EXPECT_BOOT_PARTUUID$EXPECT_BOOT_SIZE_BYTES" ] \
        || die "boot partition arguments require encryption"
    fi
  fi
else
  [ -z "$ROOT_PARTITION" ] && [ -z "$BOOT_PARTITION" ] && [ -z "$EFI_PARTITION" ] \
    || die "partition arguments require --alongside"
  [ -z "$CONFIRM_ROOT" ] || die "--confirm-root requires --alongside"
  [ "$CONFIRM_ERASE" = "$DISK" ] \
    || die "whole-disk install requires --confirm-erase matching --disk"
  [ -z "$EXPECT_ROOT_PARTUUID$EXPECT_ROOT_SIZE_BYTES$EXPECT_BOOT_PARTUUID$EXPECT_BOOT_SIZE_BYTES$EXPECT_EFI_PARTUUID$EXPECT_EFI_SIZE_BYTES" ] \
    || die "expected partition identity arguments require --alongside"
  [ "$GUIDED_ALONGSIDE" -eq 0 ] && [ -z "$FREE_START_BYTES$FREE_SIZE_BYTES$EFI_START_BYTES$EFI_SIZE_BYTES$ROOT_START_BYTES$ROOT_SIZE_BYTES$EXPECT_DISK_PTUUID$EXPECT_LOGICAL_SECTOR_SIZE$NEW_EFI_PARTUUID$NEW_ROOT_PARTUUID$CONFIRM_FREE_SPACE" ] \
    && [ "${#EXPECTED_PARTITIONS[@]}" -eq 0 ] || die "guided partition arguments require --guided-alongside"
fi

# A staged (USB-free) installer lives on the disk it installs to. The only
# shape that can be safe there is appending Tilo inside the one extent Imager
# left free: erasing the disk or formatting a prepared partition could destroy
# the running installer or the retained OS, so both stay refused.
if [ -n "$INTERNAL_HANDOFF" ]; then
  [ "$GUIDED_ALONGSIDE" -eq 1 ] \
    || die "--internal-handoff accepts only --guided-alongside; whole-disk erase and prepared partitions are refused on the disk that holds the running installer"
  case "$INTERNAL_HANDOFF" in /*) : ;; *) die "--internal-handoff must be an absolute path" ;; esac
  [ -f "$INTERNAL_HANDOFF" ] && [ ! -L "$INTERNAL_HANDOFF" ] \
    || die "--internal-handoff is not a regular file"
fi

# Use the portable Linux login-name subset accepted consistently by useradd
# across the distributions Tilo targets. It also keeps the colon-delimited
# first-boot seed file unambiguous.
if [ "${#USERNAME}" -gt 32 ]; then
  die "invalid --user '$USERNAME' (use at most 32 characters)"
fi
case "${USERNAME:0:1}" in
  [a-z_]) : ;;
  *) die "invalid --user '$USERNAME' (start with a lowercase letter or _)" ;;
esac
case "$USERNAME" in
  *[!a-z0-9_-]*) die "invalid --user '$USERNAME' (use lowercase letters, digits, _ or -)" ;;
esac
case "$USERNAME" in
  root|bin|daemon|adm|lp|sync|shutdown|halt|mail|operator|games|ftp|nobody|dbus|polkitd|sshd|chrony|tss|greetd|tilo)
    die "reserved --user '$USERNAME'" ;;
esac

# Validate the filesystem against the set bootc accepts for to-disk.
case "$FILESYSTEM" in
  btrfs|ext4|xfs) : ;;
  *) die "unsupported --filesystem '$FILESYSTEM' (use btrfs, ext4 or xfs)" ;;
esac

# Encryption does NOT require a TPM. The volume is created with a recovery key
# and the TPM is one more slot on top of it, so a machine without one still gets
# an encrypted disk that it unlocks by typing a secret. See tilo-disk-encrypt.
# A startup secret is mandatory. Short-PIN mode requires TPM2 plus verified boot
# of both the live medium and installed target; otherwise the same input is a
# normal, stronger disk passphrase.
[ "$WANT_PIN" -eq 1 ] \
  || die "native Tilo requires --pin for its encrypted startup boundary"

# Validate hostname (RFC-1123 label: letters/digits/hyphens, no edge hyphen).
[ -n "$HOSTNAME_VAL" ] || die "missing --hostname <name>"
case "$HOSTNAME_VAL" in
  -*|*-) die "invalid hostname '$HOSTNAME_VAL'" ;;
  *[!A-Za-z0-9-]*) die "invalid hostname '$HOSTNAME_VAL' (letters, digits, hyphens only)" ;;
esac

# The human-readable account name is passed only to useradd's GECOS field.
# Keep the first-boot seed line-oriented and reject delimiters/control bytes.
[ "${#FULL_NAME}" -le 100 ] || die "full name is longer than 100 characters"
case "$FULL_NAME" in
  *:*) die "full name cannot contain ':'" ;;
esac
if printf '%s' "$FULL_NAME" | LC_ALL=C grep -q '[[:cntrl:]]'; then
  die "full name contains control characters"
fi

[ -n "$LOCALE_VAL" ] || die "missing --locale <locale>"
[ "${#LOCALE_VAL}" -le 64 ] || die "locale is too long"
case "$LOCALE_VAL" in
  *[!A-Za-z0-9_.@-]*) die "invalid --locale '$LOCALE_VAL'" ;;
esac
[ -f "$LOCALE_CATALOG" ] || die "installer locale catalog is missing"
grep -Fxq -- "$LOCALE_VAL" "$LOCALE_CATALOG" \
  || die "unsupported --locale '$LOCALE_VAL'"

# Validate timezone shape if provided (defends the symlink target below).
if [ -n "$TIMEZONE_VAL" ]; then
  case "$TIMEZONE_VAL" in
    */../*|/*|*..) die "invalid --timezone '$TIMEZONE_VAL'" ;;
    *[!A-Za-z0-9_/+-]*) die "invalid --timezone '$TIMEZONE_VAL'" ;;
  esac
  [ -f "/usr/share/zoneinfo/$TIMEZONE_VAL" ] \
    || die "unknown --timezone '$TIMEZONE_VAL'"
fi

# Keyboard layout: default to us, validate it's a plain xkb token (these
# values land verbatim in /etc/environment and /etc/vconsole.conf below).
[ -n "$KEYMAP_VAL" ] || KEYMAP_VAL="us"
case "$KEYMAP_VAL" in
  *[!a-z0-9]*) die "invalid --keymap '$KEYMAP_VAL' (lowercase letters/digits only)" ;;
esac
if [ -n "$KEYVARIANT_VAL" ]; then
  case "$KEYVARIANT_VAL" in
    *[!a-z0-9_-]*) die "invalid --keyvariant '$KEYVARIANT_VAL'" ;;
  esac
fi

# Accept either a bare name (vda) or a full path (/dev/vda), then collapse
# aliases such as /dev/disk/by-id before any destructive comparison.
case "$DISK" in
  /dev/*) : ;;
  *) DISK="/dev/$DISK" ;;
esac

# --- guards ------------------------------------------------------------------
# Refuse to do anything unless we are clearly on the Tilo installer live medium.
grep -qw 'tilo.install' /proc/cmdline 2>/dev/null \
  || die "refusing: 'tilo.install' not present on the kernel cmdline (not the installer medium)"

# Non-interactive: the UI must pass --yes. This is a destructive (wipe) op.
[ "$ASSUME_YES" -eq 1 ] \
  || die "refusing destructive install without --yes (pass --yes for non-interactive use)"

# Target must be a real, whole-disk block device.
[ -b "$DISK" ] || die "$DISK is not a block device"
DISK="$(readlink -f "$DISK")"
[ -b "$DISK" ] || die "target disk alias did not resolve to a block device"
DTYPE="$(lsblk -dno TYPE "$DISK" 2>/dev/null || true)"
[ "$DTYPE" = "disk" ] || die "$DISK is not a whole disk (type='$DTYPE'); pass the whole device, not a partition"
TARGET_MAJ_MIN="$(lsblk -dno MAJ:MIN "$DISK" 2>/dev/null || true)"
[ -n "$TARGET_MAJ_MIN" ] || die "could not resolve the target disk identity"

trim_identity() {
  sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

# Bind the privileged operation to exactly the block device the UI reviewed.
# Paths alone are insufficient: hotplug can reuse /dev/sdX while the person is
# reading the Review screen. Size + device number are always required, with
# immutable hardware identifiers layered on whenever the device exposes them.
validate_disk_identity() {
  local actual_size actual_devnum actual_wwn actual_serial
  actual_size="$(blockdev --getsize64 "$DISK" 2>/dev/null || true)"
  actual_devnum="$(lsblk -dno MAJ:MIN "$DISK" 2>/dev/null | trim_identity)"
  [ "$actual_size" = "$EXPECT_DISK_SIZE_BYTES" ] \
    || die "$DISK size changed after selection; refresh disks and review again"
  [ "$actual_devnum" = "$EXPECT_DISK_DEVNUM" ] \
    || die "$DISK device identity changed after selection; refresh disks and review again"
  if [ -n "$EXPECT_DISK_WWN" ]; then
    actual_wwn="$(lsblk -dno WWN "$DISK" 2>/dev/null | trim_identity)"
    [ "$actual_wwn" = "$EXPECT_DISK_WWN" ] \
      || die "$DISK WWN changed after selection; refusing destructive work"
  fi
  if [ -n "$EXPECT_DISK_SERIAL" ]; then
    actual_serial="$(lsblk -dno SERIAL "$DISK" 2>/dev/null | trim_identity)"
    [ "$actual_serial" = "$EXPECT_DISK_SERIAL" ] \
      || die "$DISK serial changed after selection; refusing destructive work"
  fi
}

validate_partition_identity() {
  local partition="$1" expected_uuid="$2" expected_size="$3" label="$4"
  local actual_uuid actual_size resolved
  resolved="$(readlink -f "$partition")"
  [ -b "$resolved" ] || die "$label device disappeared after selection"
  # A newly registered GPT partition can precede its uevent/udev metadata.
  # Read its partition entry directly instead of accepting a stale lsblk view.
  actual_uuid="$(blkid -p -s PART_ENTRY_UUID -o value "$resolved" 2>/dev/null || true)"
  actual_size="$(blockdev --getsize64 "$partition" 2>/dev/null || true)"
  [ "${actual_uuid,,}" = "${expected_uuid,,}" ] \
    || die "$label PARTUUID changed after selection; refresh disks and review again"
  [ "$actual_size" = "$expected_size" ] \
    || die "$label size changed after selection; refresh disks and review again"
}

validate_disk_identity

# Never target the disk the live medium itself is running from. The root may
# be overlayfs, so inspect every mounted block source and reduce partitions,
# dm-crypt and aliases to their whole-disk ancestor. Fail closed if the live
# medium cannot be identified; guessing here can erase the running installer.
LIVE_MAJ_MIN=""
while read -r SOURCE MOUNTPOINT; do
  SOURCE="${SOURCE%%\[*}"
  [ -b "$SOURCE" ] || continue
  case "$MOUNTPOINT" in
    /|/boot|/boot/*|/sysroot|/sysroot/*|/run/initramfs/live|/run/initramfs/live/*|/run/rootfsbase|/run/rootfsbase/*) ;;
    *) continue ;;
  esac
  # Raw output matters: normal lsblk tree output prefixes the parent with
  # `\u2514\u2500`, turning /dev/vda into the invalid path `\u2514\u2500/dev/vda`.
  LIVE_DISK="$(lsblk -srpno NAME,TYPE "$SOURCE" 2>/dev/null | awk '$2 == "disk" || $2 == "rom" { print $1; exit }')"
  [ -n "$LIVE_DISK" ] || continue
  OBSERVED_LIVE_MAJ_MIN="$(lsblk -dno MAJ:MIN "$LIVE_DISK" 2>/dev/null || true)"
  [ -n "$OBSERVED_LIVE_MAJ_MIN" ] || continue
  if [ -n "$LIVE_MAJ_MIN" ] && [ "$LIVE_MAJ_MIN" != "$OBSERVED_LIVE_MAJ_MIN" ]; then
    die "critical live mounts resolve to more than one physical disk"
  fi
  LIVE_MAJ_MIN="$OBSERVED_LIVE_MAJ_MIN"
done < <(findmnt -rn -o SOURCE,TARGET 2>/dev/null)
[ -n "$LIVE_MAJ_MIN" ] \
  || die "could not resolve the live medium's physical disk; refusing a destructive install"
# The UI's handoff copy is only a hint. tilo-staging-handoff re-reads the one
# on the ESP the firmware actually booted (LoaderDevicePartUUID) and requires
# that the live root and ESP are exactly the staged partitions, that the disk
# GUID and size match, and that the reviewed extent is exactly the staged
# target extent, still unallocated, ending where staging begins.
INTERNAL_MODE=0
if [ "$TARGET_MAJ_MIN" = "$LIVE_MAJ_MIN" ]; then
  [ -n "$INTERNAL_HANDOFF" ] \
    || die "$DISK is the live medium's own disk — refusing to install onto it"
  INTERNAL_FACTS="$("$STAGING_HANDOFF" check-install --handoff "$INTERNAL_HANDOFF" \
    --disk "$DISK" --mode guided \
    --free-start-bytes "$FREE_START_BYTES" --free-size-bytes "$FREE_SIZE_BYTES" \
    --efi-start-bytes "$EFI_START_BYTES" --efi-size-bytes "$EFI_SIZE_BYTES" \
    --boot-start-bytes "$BOOT_START_BYTES" --boot-size-bytes "$BOOT_SIZE_BYTES" \
    --root-start-bytes "$ROOT_START_BYTES" --root-size-bytes "$ROOT_SIZE_BYTES" \
    --sector-size "$EXPECT_LOGICAL_SECTOR_SIZE")" \
    || die "$DISK holds the running installer and the staged plan could not be verified — refusing to install onto it"
  INTERNAL_OWNED_BOOT_ENTRY="$(printf '%s\n' "$INTERNAL_FACTS" | sed -n 's/^INTERNAL_OWNED_BOOT_ENTRY=//p')"
  INTERNAL_HOST_OS="$(printf '%s\n' "$INTERNAL_FACTS" | sed -n 's/^INTERNAL_HOST_OS=//p')"
  [[ "$INTERNAL_OWNED_BOOT_ENTRY" =~ ^[0-9A-F]{4}$ ]] && [ -n "$INTERNAL_HOST_OS" ] \
    || die "staged plan verification did not report its facts"
  INTERNAL_MODE=1
  log "  staged install: $DISK also holds the running installer; the existing $INTERNAL_HOST_OS system stays untouched"
elif [ -n "$INTERNAL_HANDOFF" ]; then
  die "--internal-handoff requires the disk that holds the staged installer"
fi

validate_alongside() {
  local root_parent boot_parent efi_parent root_type boot_type efi_type efi_fs mountpoints signature_types tool
  local efi_mountpoints efi_probe efi_available other_tilo_roots
  for tool in blockdev blkid df fsck.fat lsblk wipefs "mkfs.$FILESYSTEM" mount umount sfdisk partx; do
    command -v "$tool" >/dev/null 2>&1 || die "missing required tool for alongside install: $tool"
  done
  [ -b "$ROOT_PARTITION" ] && [ "$(lsblk -dno TYPE "$ROOT_PARTITION" 2>/dev/null)" = part ] \
    || die "$ROOT_PARTITION is not a partition"
  [ -b "$EFI_PARTITION" ] && [ "$(lsblk -dno TYPE "$EFI_PARTITION" 2>/dev/null)" = part ] \
    || die "$EFI_PARTITION is not a partition"
  validate_partition_identity "$ROOT_PARTITION" "$EXPECT_ROOT_PARTUUID" "$EXPECT_ROOT_SIZE_BYTES" "Tilo root partition"
  validate_partition_identity "$EFI_PARTITION" "$EXPECT_EFI_PARTUUID" "$EXPECT_EFI_SIZE_BYTES" "EFI partition"
  if [ "$ENCRYPT" -eq 1 ]; then
    [ -b "$BOOT_PARTITION" ] && [ "$(lsblk -dno TYPE "$BOOT_PARTITION" 2>/dev/null)" = part ] \
      || die "$BOOT_PARTITION is not a partition"
    validate_partition_identity "$BOOT_PARTITION" "$EXPECT_BOOT_PARTUUID" "$EXPECT_BOOT_SIZE_BYTES" "Tilo boot partition"
    [ "$BOOT_PARTITION" != "$ROOT_PARTITION" ] && [ "$BOOT_PARTITION" != "$EFI_PARTITION" ] \
      || die "alongside boot partition must be distinct from root and EFI"
    boot_parent="$(lsblk -no PKNAME "$BOOT_PARTITION" 2>/dev/null | head -1)"
    [ -n "$boot_parent" ] && [ "$(readlink -f "/dev/$boot_parent")" = "$DISK" ] \
      || die "alongside boot partition must belong to $DISK"
    boot_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$BOOT_PARTITION" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    [ "$boot_type" = 0fc63daf-8483-4772-8e79-3d69d8477de4 ] \
      || die "$BOOT_PARTITION is not explicitly typed as a Linux boot partition"
    [ "$(blockdev --getsize64 "$BOOT_PARTITION")" -ge 1073741824 ] \
      || die "$BOOT_PARTITION is smaller than the 1 GiB boot minimum"
    mountpoints="$(lsblk -nro MOUNTPOINT "$BOOT_PARTITION")" \
      || die "could not inspect $BOOT_PARTITION mount state"
    [ -z "$(printf '%s' "$mountpoints" | tr -d '[:space:]')" ] \
      || die "$BOOT_PARTITION is mounted"
    signature_types="$(wipefs --noheadings --no-act --output TYPE "$BOOT_PARTITION")" \
      || die "could not inspect signatures on $BOOT_PARTITION"
    [ -z "$(printf '%s' "$signature_types" | tr -d '[:space:]')" ] \
      || die "$BOOT_PARTITION contains a filesystem or volume signature"
  fi
  root_parent="$(lsblk -no PKNAME "$ROOT_PARTITION" 2>/dev/null | head -1)"
  efi_parent="$(lsblk -no PKNAME "$EFI_PARTITION" 2>/dev/null | head -1)"
  [ -n "$root_parent" ] && [ -n "$efi_parent" ] \
    && [ "$(readlink -f "/dev/$root_parent")" = "$DISK" ] \
    && [ "$(readlink -f "/dev/$efi_parent")" = "$DISK" ] \
    || die "alongside root and EFI partitions must both belong to $DISK"
  root_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$ROOT_PARTITION" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  efi_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$EFI_PARTITION" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  case "$root_type" in
    0fc63daf-8483-4772-8e79-3d69d8477de4|7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab) : ;;
    *) die "$ROOT_PARTITION is not explicitly typed as a Linux/Tilo root partition" ;;
  esac
  # The installed UKI resolves root=tilo-auto to the one Tilo root on this disk
  # and refuses to boot beside a second (tilo-root-discover). A staged
  # installer's root has its own type and does not count.
  other_tilo_roots="$(lsblk -lnpo NAME,TYPE,PARTTYPE "$DISK" \
    | awk -v keep="$(readlink -f "$ROOT_PARTITION")" 'tolower($2)=="part" && tolower($3)=="7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab" && $1!=keep {print $1}')" \
    || die "could not list the partitions of $DISK"
  [ -z "$other_tilo_roots" ] \
    || die "$DISK already holds another Tilo root ($other_tilo_roots); a second one would make both unbootable"
  [ "$efi_type" = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ] \
    || die "$EFI_PARTITION is not an EFI System Partition"
  efi_fs="$(blkid -s TYPE -o value "$EFI_PARTITION" 2>/dev/null || true)"
  [ "$efi_fs" = vfat ] || die "$EFI_PARTITION is not a FAT EFI System Partition"
  [ "$(blockdev --getsize64 "$EFI_PARTITION")" -ge "$MIN_ALONGSIDE_ESP_BYTES" ] \
    || die "$EFI_PARTITION is smaller than the 2 GiB Tilo EFI minimum"
  fsck.fat -n "$EFI_PARTITION" >/dev/null 2>&1 \
    || die "$EFI_PARTITION is not a clean FAT filesystem; repair it before installing Tilo"
  efi_mountpoints="$(lsblk -nro MOUNTPOINT "$EFI_PARTITION")" \
    || die "could not inspect $EFI_PARTITION mount state"
  [ -z "$(printf '%s' "$efi_mountpoints" | tr -d '[:space:]')" ] \
    || die "$EFI_PARTITION is mounted"
  efi_probe="$(mktemp -d)"
  if ! mount -o ro,nosuid,nodev,noexec "$EFI_PARTITION" "$efi_probe"; then
    rmdir "$efi_probe"
    die "could not inspect available space on $EFI_PARTITION"
  fi
  efi_available="$(df -B1 --output=avail "$efi_probe" 2>/dev/null | tail -n 1 | tr -d '[:space:]')"
  umount "$efi_probe"
  rmdir "$efi_probe"
  case "$efi_available" in *[!0-9]*|'') die "could not read available space on $EFI_PARTITION" ;; esac
  [ "$efi_available" -ge "$MIN_ALONGSIDE_ESP_FREE_BYTES" ] \
    || die "$EFI_PARTITION has less than 1 GiB available for Tilo boot images"
  ALONGSIDE_EFI_AVAILABLE_BYTES="$efi_available"
  [ "$(blockdev --getsize64 "$ROOT_PARTITION")" -ge 34359738368 ] \
    || die "$ROOT_PARTITION is smaller than the 32 GiB alongside minimum"
  mountpoints="$(lsblk -nro MOUNTPOINT "$ROOT_PARTITION")" \
    || die "could not inspect $ROOT_PARTITION mount state"
  [ -z "$(printf '%s' "$mountpoints" | tr -d '[:space:]')" ] \
    || die "$ROOT_PARTITION is mounted"
  signature_types="$(wipefs --noheadings --no-act --output TYPE "$ROOT_PARTITION")" \
    || die "could not inspect signatures on $ROOT_PARTITION"
  [ -z "$(printf '%s' "$signature_types" | tr -d '[:space:]')" ] \
    || die "$ROOT_PARTITION contains a filesystem or volume signature; refusing to guess that its data is disposable"
}

mark_alongside_tilo_root() {
  local root_type part_number
  root_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$ROOT_PARTITION" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  [ "$root_type" != 7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab ] || return 0
  [ "$root_type" = 0fc63daf-8483-4772-8e79-3d69d8477de4 ] \
    || die "reviewed root partition type changed before Tilo ownership marking"
  part_number="$(cat "/sys/class/block/${ROOT_PARTITION##*/}/partition" 2>/dev/null || true)"
  case "$part_number" in ''|*[!0-9]*) die "could not identify reviewed root partition number" ;; esac
  # The user explicitly selected this empty partition for formatting. Change
  # only its GPT type to Tilo's discovery GUID, retaining its reviewed PARTUUID
  # and byte geometry; every sibling (Windows/Linux included) stays untouched.
  sfdisk --part-type "$DISK" "$part_number" 7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab \
    || die "could not mark the reviewed partition as the Tilo root"
  partx -u "$DISK" 2>/dev/null || true
  udevadm settle 2>/dev/null || true
  validate_partition_identity "$ROOT_PARTITION" "$EXPECT_ROOT_PARTUUID" \
    "$EXPECT_ROOT_SIZE_BYTES" "Tilo root partition"
  root_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$ROOT_PARTITION" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  [ "$root_type" = 7a2e8d75-3f01-4e5a-b2c9-51f6ed90b8ab ] \
    || die "Tilo root GPT type did not persist"
}

# Read-only UI preflight. It intentionally traverses the same disk/partition
# identity and live-medium checks above and the same prepared-partition
# validator used again immediately before destructive installation. The
# reviewed confirmation argument is still required, but this mode exits before
# reading credentials, staging an image, formatting, or changing firmware.
if [ "$PREFLIGHT_ALONGSIDE" -eq 1 ]; then
  [ "$GUIDED_ALONGSIDE" -eq 0 ] || die "prepared-storage preflight does not apply to guided alongside"
  validate_alongside
  log "Prepared storage check passed: the EFI partition is clean FAT32 with $ALONGSIDE_EFI_AVAILABLE_BYTES bytes free."
  exit 0
fi

# Bind the reviewed disk immediately before guided GPT mutation.
validate_disk_identity

if [ "$GUIDED_ALONGSIDE" -eq 1 ]; then
  step "Creating Tilo partitions in the reviewed unallocated space (existing partitions are preserved)"
  GUIDED_ARGS=(
    create --disk "$DISK"
    --expect-disk-size-bytes "$EXPECT_DISK_SIZE_BYTES"
    --expect-disk-devnum "$EXPECT_DISK_DEVNUM"
    --expect-disk-ptuuid "$EXPECT_DISK_PTUUID"
    --expect-logical-sector-size "$EXPECT_LOGICAL_SECTOR_SIZE"
    --free-start-bytes "$FREE_START_BYTES" --free-size-bytes "$FREE_SIZE_BYTES"
    --efi-start-bytes "$EFI_START_BYTES" --efi-size-bytes "$EFI_SIZE_BYTES"
    --root-start-bytes "$ROOT_START_BYTES" --root-size-bytes "$ROOT_SIZE_BYTES"
    --new-efi-partuuid "$NEW_EFI_PARTUUID" --new-root-partuuid "$NEW_ROOT_PARTUUID"
  )
  if [ "$ENCRYPT" -eq 1 ]; then
    GUIDED_ARGS+=(--boot-start-bytes "$BOOT_START_BYTES" --boot-size-bytes "$BOOT_SIZE_BYTES"
                  --new-boot-partuuid "$NEW_BOOT_PARTUUID")
  fi
  [ -z "$EXPECT_DISK_WWN" ] || GUIDED_ARGS+=(--expect-disk-wwn "$EXPECT_DISK_WWN")
  [ -z "$EXPECT_DISK_SERIAL" ] || GUIDED_ARGS+=(--expect-disk-serial "$EXPECT_DISK_SERIAL")
  # The staged installer's own partitions stay mounted, so the kernel cannot
  # reread the whole table; the helper registers the new partitions instead.
  [ "$INTERNAL_MODE" -eq 0 ] || GUIDED_ARGS+=(--in-use-disk)
  for expected_partition in "${EXPECTED_PARTITIONS[@]}"; do
    GUIDED_ARGS+=(--expect-partition "$expected_partition")
  done
  GUIDED_RESULT="$("$GUIDED_PARTITION" "${GUIDED_ARGS[@]}")"
  EFI_PARTITION="$(printf '%s\n' "$GUIDED_RESULT" | sed -n 's/^EFI_PARTITION=//p' | tail -n 1)"
  ROOT_PARTITION="$(printf '%s\n' "$GUIDED_RESULT" | sed -n 's/^ROOT_PARTITION=//p' | tail -n 1)"
  BOOT_PARTITION="$(printf '%s\n' "$GUIDED_RESULT" | sed -n 's/^BOOT_PARTITION=//p' | tail -n 1)"
  [ -n "$EFI_PARTITION" ] && [ -n "$ROOT_PARTITION" ] \
    || die "guided partition helper did not report the partitions it created"
  EXPECT_EFI_PARTUUID="$NEW_EFI_PARTUUID"
  EXPECT_EFI_SIZE_BYTES="$EFI_SIZE_BYTES"
  EXPECT_ROOT_PARTUUID="$NEW_ROOT_PARTUUID"
  EXPECT_ROOT_SIZE_BYTES="$ROOT_SIZE_BYTES"
  if [ "$ENCRYPT" -eq 1 ]; then
    [ -n "$BOOT_PARTITION" ] || die "guided partition helper did not report the boot partition"
    EXPECT_BOOT_PARTUUID="$NEW_BOOT_PARTUUID"
    EXPECT_BOOT_SIZE_BYTES="$BOOT_SIZE_BYTES"
    log "  created boot: $BOOT_PARTITION"
  fi
  log "  created EFI : $EFI_PARTITION"
  log "  created root: $ROOT_PARTITION"
fi

if [ "$ALONGSIDE" -eq 1 ]; then
  ROOT_PARTITION="$(readlink -f "$ROOT_PARTITION")"
  [ -z "$BOOT_PARTITION" ] || BOOT_PARTITION="$(readlink -f "$BOOT_PARTITION")"
  EFI_PARTITION="$(readlink -f "$EFI_PARTITION")"
  validate_alongside
  if [ "$GUIDED_ALONGSIDE" -eq 1 ]; then
    log "  alongside   : preserve existing partitions; format new EFI $EFI_PARTITION, boot $BOOT_PARTITION, and encrypted root $ROOT_PARTITION"
    log "  Tilo ESP    : $EFI_PARTITION (new; existing operating-system ESPs stay untouched)"
  else
    log "  alongside   : format prepared boot $BOOT_PARTITION and encrypted root $ROOT_PARTITION; preserve all other partitions"
    log "  shared ESP  : $EFI_PARTITION (preserved, not formatted)"
  fi
  FIRMWARE_STATE="$(mktemp)"
  "$BOOT_MENU" firmware-snapshot "$FIRMWARE_STATE"
  FIRMWARE_RESTORED=0
  restore_firmware_boot_state() {
    [ "$FIRMWARE_RESTORED" -eq 0 ] || return 0
    # Preserve evidence even if this function is invoked from a conditional
    # cleanup context where Bash suppresses errexit inside the whole function.
    "$BOOT_MENU" firmware-restore "$FIRMWARE_STATE" || return $?
    rm -f -- "$FIRMWARE_STATE"
    FIRMWARE_RESTORED=1
  }
  trap restore_firmware_boot_state EXIT
fi

# Refuse if the target disk (or any of its partitions) is currently mounted.
# A staged install necessarily runs from two partitions of this disk; nothing
# else on it may be in use.
if [ "$INTERNAL_MODE" -eq 1 ]; then
  "$STAGING_HANDOFF" check-mounts --handoff "$INTERNAL_HANDOFF" --disk "$DISK" \
    || die "$DISK has a mounted partition besides the staged installer — unmount it first"
elif lsblk -nro MOUNTPOINT "$DISK" 2>/dev/null | grep -q .; then
  die "$DISK (or one of its partitions) is currently mounted — unmount it first"
fi

# --- read the password (now that we are root) --------------------------------
IFS= read -r PASSWORD || true
[ -n "$PASSWORD" ] || die "no password received on stdin"
# Second stdin line is the disk-encryption passphrase (when the legacy --pin
# transport flag is present). Kept off argv so it never shows in process
# listings.
if [ "$WANT_PIN" -eq 1 ]; then
  IFS= read -r PIN || true
  [ -n "$PIN" ] || die "--pin set but no disk passphrase received on stdin (line 2)"
  SECRET_POLICY=/usr/libexec/tilo-startup-secret-policy
  [ -x "$SECRET_POLICY" ] || die "startup-secret policy helper is missing"
  POLICY_MODE=()
  REQUIRE_TPM_PREDICTION=0
  if [ -x /usr/libexec/tilo-verified-boot-install-preflight ] \
     && /usr/libexec/tilo-verified-boot-install-preflight >/dev/null 2>&1 \
     && { [ -c /dev/tpmrm0 ] || [ -c /dev/tpm0 ]; }; then
    POLICY_MODE=(--tpm-pin)
    REQUIRE_TPM_PREDICTION=1
  fi
  POLICY_ERROR="$(printf '%s\n' "$PIN" | "$SECRET_POLICY" "${POLICY_MODE[@]}" 2>&1)" \
    || die "$POLICY_ERROR"
fi

log "Tilo installer"
log "  target disk : $DISK"
log "  username    : $USERNAME"
log "  full name   : ${FULL_NAME:-<not set>}"
log "  filesystem  : $FILESYSTEM"
log "  hostname    : $HOSTNAME_VAL"
log "  locale      : $LOCALE_VAL"
log "  timezone    : ${TIMEZONE_VAL:-<system default>}"
log "  keymap      : $KEYMAP_VAL${KEYVARIANT_VAL:+ ($KEYVARIANT_VAL)}"
log "  update ref  : $TILO_TARGET_IMGREF"

# The sealed live UKI cannot be changed with bootc --karg-delete. Every mode
# must install the independently signed target variant on its selected ESP.
promote_target_uki() {
  local esp="$1" TARGET_UKI TARGET_VARIANT
  local -a target_digests installed_digests
  # CI development targets may use a board UKI or a generic split kernel.
  # Project the installed target UKI
  # only inside the already guarded development scenario, without modifying
  # its OCI image or borrowing boot bytes from the generic live medium.
  if [ "$OFFLINE_TARGET" -eq 2 ]; then
    local dev_image_root dev_result
    dev_image_root="$(podman image mount "$LOCAL_IMG")" \
      || die "could not mount the selected immutable development target"
    if [ ! -f "$dev_image_root/boot/tilo-target/tilo-target.efi" ]; then
      if dev_result="$(REQUIRE_TPM_PREDICTION="${REQUIRE_TPM_PREDICTION:-0}" \
          python3 /usr/libexec/tilo-installer-dev-target-uki.py promote \
          --image-root "$dev_image_root" --target-root "$ENC_MNT" --esp "$esp")"; then
        podman image unmount "$LOCAL_IMG" || die "could not unmount development target"
        [[ "$dev_result" =~ ^[0-9a-f]{128}$ ]] || die "development UKI returned an invalid digest"
        TARGET_COMPOSEFS_DIGEST="$dev_result"
        return
      else
        podman image unmount "$LOCAL_IMG" || true
        die "development target UKI failed verification"
      fi
    fi
    podman image unmount "$LOCAL_IMG" || die "could not unmount development target"
  fi
  # Promote the deterministic installed-target UKI. It was built over this
  # exact composefs tree and uses boot-ESP/same-disk Tilo root discovery, so no
  # per-machine bytes enter PCR 11.
  # bootc 1.16.4 copies recognized live UKIs, not arbitrary /boot sidecars.
  # Recover the authority-signed target bundle from the same offline image used
  # above, never from a network update tag or a mutable live ESP. This changes
  # only ESP files and therefore does not alter the sealed composefs digest.
  [ ! -e "$esp/tilo-target" ] \
    || die "target ESP already contains a target boot bundle"
  podman run --rm --pull=never --network=none --cap-drop=ALL \
    --security-opt label=type:unconfined_t \
    -v "$esp:/target-esp" \
    --entrypoint /usr/bin/cp "$LOCAL_IMG" -R /boot/tilo-target /target-esp/
  TARGET_VARIANT="$esp/tilo-target/tilo-target.efi"
  [ -f "$TARGET_VARIANT" ] || die "installed image has no deterministic target UKI"
  # The on-demand unsigned development medium has no PCR prediction. Permit
  # its passphrase-only self-install solely inside the disposable scenario VM
  # with the named proof port. A physical install and every offline signed
  # target still require the exact authority/prediction preflight.
  if [ -f /usr/share/tilo/unverified-vm-install ] \
     && [ "${REQUIRE_TPM_PREDICTION:-0}" -eq 0 ] \
     && [ -c /dev/virtio-ports/org.tilo.vm-install-proof ] \
     && systemd-detect-virt --vm --quiet; then
    log "development VM: unverified target boot bundle permitted for passphrase install"
  else
    TILO_PREFLIGHT_ROOT="$esp/tilo-target" \
      /usr/libexec/tilo-verified-boot-install-preflight --skip-platform \
      || die "target boot bundle failed authority/prediction verification"
  fi
  mapfile -t target_digests < <(/usr/libexec/tilo-uki-cmdline show "$TARGET_VARIANT" |
    tr ' ' '\n' | sed -n 's/^composefs=//p')
  [ "${#target_digests[@]}" -eq 1 ] && [[ "${target_digests[0]}" =~ ^[0-9a-f]{128}$ ]] \
    || die "signed target UKI must bind exactly one composefs digest"
  TARGET_UKI="$esp/EFI/Linux/bootc/bootc_composefs-${target_digests[0]}.efi"
  [ -f "$TARGET_UKI" ] && [ ! -L "$TARGET_UKI" ] \
    || die "installed target has no exact current bootc UKI on its ESP"
  mapfile -t installed_digests < <(/usr/libexec/tilo-uki-cmdline show "$TARGET_UKI" |
    tr ' ' '\n' | sed -n 's/^composefs=//p')
  [ "${#installed_digests[@]}" -eq 1 ] && [ "${installed_digests[0]}" = "${target_digests[0]}" ] \
    || die "installed entry differs from signed target composefs identity"
  TARGET_COMPOSEFS_DIGEST="${target_digests[0]}"
  /usr/libexec/tilo-uki-cmdline show "$TARGET_VARIANT" | grep -qw root=tilo-auto \
    || die "target UKI lacks Tilo root discovery"
  /usr/libexec/tilo-uki-cmdline show "$TARGET_VARIANT" \
    | grep -Fqw 'systemd.mount-extra=LABEL=TILO_BOOT:/boot:ext4:ro,nosuid,nodev,noexec' \
    || die "target UKI lacks the signed TILO_BOOT mount contract"
  ! /usr/libexec/tilo-uki-cmdline show "$TARGET_VARIANT" | grep -qw tilo.install \
    || die "target UKI still contains the live installer marker"
  # bootc stores SHA256(.linux + .initrd) in deployment origin metadata.
  # A command-line-only target variant preserves it; fail before replacing the
  # ESP entry if finalization accidentally rebuilt either payload differently.
  local installed_boot_digest target_boot_digest
  installed_boot_digest="$(/usr/libexec/tilo-uki-cmdline boot-digest "$TARGET_UKI")" \
    || die "cannot read installed UKI boot identity"
  target_boot_digest="$(/usr/libexec/tilo-uki-cmdline boot-digest "$TARGET_VARIANT")" \
    || die "cannot read target UKI boot identity"
  [[ "$installed_boot_digest" =~ ^[0-9a-f]{64}$ ]] \
    && [[ "$target_boot_digest" =~ ^[0-9a-f]{64}$ ]] \
    || die "UKI boot identity is not a SHA-256 digest"
  [ "$installed_boot_digest" = "$target_boot_digest" ] \
    || die "target UKI changes the bootc kernel/initramfs identity"
  install -m 0644 "$TARGET_VARIANT" "$TARGET_UKI.new"
  mv -f "$TARGET_UKI.new" "$TARGET_UKI"
  install -d -m 0755 "$esp/EFI/tilo/pcr-predictions"
  find "$esp/tilo-target/predictions" -maxdepth 1 -type f \
    \( -name '*.json' -o -name '*.json.uki.sig' \) \
    -exec install -m 0644 {} "$esp/EFI/tilo/pcr-predictions/" \;
}

# Reuse an exact VM-local cached copy when present. For an encrypted install,
# the newly formatted target also backs bootc's large temporary export.
MIN_BOOTC_SCRATCH_FREE_BYTES=25769803776
COPY_SCRATCH=""
COPY_SCRATCH_MOUNTED=0
release_copy_scratch() {
  if [ "$COPY_SCRATCH_MOUNTED" -eq 1 ]; then
    umount /var/tmp || return 1
    COPY_SCRATCH_MOUNTED=0
  fi
  if [ -n "$COPY_SCRATCH" ]; then
    [ "$COPY_SCRATCH" = "$ENC_MNT/.tilo-bootc-copy-tmp" ] || return 1
    [ ! -L "$COPY_SCRATCH" ] || return 1
    rm -rf --one-file-system -- "$COPY_SCRATCH" || return 1
    COPY_SCRATCH=""
  fi
}
use_encrypted_copy_scratch() {
  local scratch_available
  [ "$ENCRYPT" -eq 1 ] || return 0
  [ -d /var/tmp ] && [ ! -L /var/tmp ] || die "/var/tmp is not a real directory"
  ! mountpoint -q /var/tmp || die "/var/tmp is already a separate mount"
  [ -n "$ENC_MNT" ] && mountpoint -q "$ENC_MNT" \
    || die "encrypted target root is not mounted for bootc scratch"
  scratch_available="$(df -B1 --output=avail "$ENC_MNT" | tail -n 1 | tr -d '[:space:]')"
  case "$scratch_available" in ''|*[!0-9]*) die "cannot measure encrypted bootc scratch space" ;; esac
  [ "$scratch_available" -ge "$MIN_BOOTC_SCRATCH_FREE_BYTES" ] \
    || die "encrypted target has less than 24 GiB free for bootc export"
  COPY_SCRATCH="$ENC_MNT/.tilo-bootc-copy-tmp"
  [ ! -e "$COPY_SCRATCH" ] && [ ! -L "$COPY_SCRATCH" ] \
    || die "encrypted target already contains bootc scratch"
  install -d -m 1777 -- "$COPY_SCRATCH"
  chcon --reference=/var/tmp -- "$COPY_SCRATCH" \
    || die "could not give encrypted bootc scratch the /var/tmp SELinux label"
  [ "$(stat -c '%u:%a' -- "$COPY_SCRATCH")" = 0:1777 ] \
    || die "bootc scratch permissions are unsafe"
  [ "$(stat -c '%C' -- "$COPY_SCRATCH")" = "$(stat -c '%C' -- /var/tmp)" ] \
    || die "bootc scratch SELinux label is unsafe"
  if ! mount --bind -- "$COPY_SCRATCH" /var/tmp; then
    if mountpoint -q /var/tmp; then COPY_SCRATCH_MOUNTED=1; fi
    die "could not bind encrypted bootc scratch to /var/tmp"
  fi
  COPY_SCRATCH_MOUNTED=1
  [ "$(stat -c '%d:%i' -- /var/tmp)" = "$(stat -c '%d:%i' -- "$COPY_SCRATCH")" ] \
    || die "/var/tmp is not the reviewed encrypted scratch directory"
}
copy_booted_image() {
  if [ "$OFFLINE_TARGET" -ne 0 ]; then
    step "Importing the selected offline Tilo target"
    LOCAL_IMG="$(python3 /usr/libexec/tilo-installer-offline-target.py import)" \
      || die "offline target import or embedded update origin failed"
    [[ "$LOCAL_IMG" =~ ^(sha256:)?[0-9a-f]{64}$ ]] \
      || die "offline target did not resolve to an immutable image ID"
    validate_disk_identity
    return
  fi
  step "Copying the running Tilo image into local container storage"
  VM_COPY_CACHE=/usr/libexec/tilo-vm-bootc-copy-cache.py
  # VM development can bind-mount the backend and helper from its writable
  # overlay. The sealed /usr tree cannot gain a helper without an image rebuild.
  if [ ! -f "$VM_COPY_CACHE" ] \
      && [ -f /var/lib/tilo-installer/vm-cache-code/tilo-vm-bootc-copy-cache.py ]; then
    VM_COPY_CACHE=/var/lib/tilo-installer/vm-cache-code/tilo-vm-bootc-copy-cache.py
  fi
  VM_COPY_CACHE_MARKER=/run/tilo-installer/vm-bootc-copy-cache.enabled
  VM_CACHED_COPY=0
  if [ -e "$VM_COPY_CACHE_MARKER" ] \
      && python3 "$VM_COPY_CACHE" check; then
    log "  -> reusing the exact booted image from VM-local container storage"
    VM_CACHED_COPY=1
  else
    use_encrypted_copy_scratch
    TMPDIR=/var/tmp bootc image copy-to-storage
    release_copy_scratch || die "could not remove bootc scratch mount"
  fi
  LOCAL_IMG="$(podman image inspect --format '{{.Id}}' "$LOCAL_IMG")"
  [[ "$LOCAL_IMG" =~ ^(sha256:)?[0-9a-f]{64}$ ]] || die "offline image did not resolve to an immutable ID"
  log "  -> $LOCAL_IMG"
  if [ "$VM_CACHED_COPY" -eq 0 ] && [ -e "$VM_COPY_CACHE_MARKER" ]; then
    # Receipt creation only accelerates later VM retries; a failed write must
    # never change the completed export or the physical install path.
    python3 "$VM_COPY_CACHE" record \
      || log "  -> VM copy cache receipt unavailable; next run will copy again"
  fi

  validate_disk_identity
}

# A separately signed target is optional. Its metadata, OCI manifest, Cosign
# signature and CI provenance must be checked before any target-disk mutation.
# Absence retains the development self-install path; a partial or invalid
# offline target fails closed instead of falling back to the booted overlay.
OFFLINE_TARGET=0
if [ -e /var/lib/tilo-installer/target-oci ] \
    || [ -L /var/lib/tilo-installer/target-oci ]; then
  python3 /usr/libexec/tilo-installer-offline-target.py verify >/dev/null \
    || die "preloaded signed target failed verification"
  offline_origin="$(python3 -c 'import json; print(json.load(open("/run/tilo-installer/offline-target.json"))["update_origin"])')"
  # The live medium may be generic so it can boot QEMU virt, while the signed
  # installed image is Lenovo-specific. The helper authenticates this origin
  # against target SLSA and the target image's embedded hardware profile.
  TILO_TARGET_IMGREF="$offline_origin"
  OFFLINE_TARGET=1
  if python3 -c 'import json,sys; sys.exit(json.load(open("/run/tilo-installer/offline-target.json"))["schema"] != "tilo.installer-dev-target.v1")'; then
    OFFLINE_TARGET=2
  fi
fi

# Recheck the selected disk before preparing the encrypted target. The source
# copy now follows preparation so its scratch cannot fill the live staging root.
validate_disk_identity

# --- 2. install the base system ----------------------------------------------
# Unencrypted: `bootc install to-disk` owns the whole layout.
# Encrypted: we build the layout ourselves (tilo-disk-encrypt prepare) and hand
# bootc the mounted tree, because `--block-setup tpm2-luks` can only produce a
# TPM-sealed single-slot volume and refuses to run at all without a TPM.
ENC_MNT=""
ENC_LUKS=""
ENC_KEYFILE=""
STORE_PART=""
if [ "$ENCRYPT" -eq 1 ]; then
  if [ "$ALONGSIDE" -eq 1 ]; then
    step "Preparing encrypted Tilo root on $ROOT_PARTITION (existing OS partitions are preserved)"
  else
    step "Preparing an encrypted root on $DISK (this ERASES the disk)"
  fi
  # The helper reports the volume it made on stdout and its progress on stderr;
  # keep the report and let the progress through to the UI, which reads our
  # stdout. fd 3 is this script's stdout for the duration.
  exec 3>&1
  if [ "$ALONGSIDE" -eq 1 ]; then
    validate_alongside
    mark_alongside_tilo_root
    PREP="$("$DISK_ENCRYPT" prepare-partition "$ROOT_PARTITION" --boot "$BOOT_PARTITION" --efi "$EFI_PARTITION" --filesystem "$FILESYSTEM" 2>&3)"
  else
    PREP="$("$DISK_ENCRYPT" prepare "$DISK" --filesystem "$FILESYSTEM" 2>&3)"
  fi
  exec 3>&-
  ENC_MNT="$(printf '%s\n' "$PREP" | sed -n 's/^MNT=//p')"
  ENC_LUKS="$(printf '%s\n' "$PREP" | sed -n 's/^LUKS_PART=//p')"
  ENC_KEYFILE="$(printf '%s\n' "$PREP" | sed -n 's/^KEY_FILE=//p')"
  ENC_ROOT_UUID="$(printf '%s\n' "$PREP" | sed -n 's/^ROOT_FS_UUID=//p')"
  ENC_BOOT_PART="$(printf '%s\n' "$PREP" | sed -n 's/^BOOT_PART=//p')"
  ROOT_FS_UUID="$ENC_ROOT_UUID"
  ENC_KARGS="$(printf '%s\n' "$PREP" | sed -n 's/^KARGS=//p')"
  # Whole-disk installs on a large enough disk also get the room store
  # partition. Alongside installs have one reviewed partition to work with;
  # tilo-store-volume.service gives them an image-backed store on first boot.
  STORE_PART="$(printf '%s\n' "$PREP" | sed -n 's/^STORE_PART=//p')"
  STORE_LUKS_UUID="$(printf '%s\n' "$PREP" | sed -n 's/^STORE_LUKS_UUID=//p')"
  STORE_FS_UUID="$(printf '%s\n' "$PREP" | sed -n 's/^STORE_FS_UUID=//p')"
  STORE_KEY_FILE="$(printf '%s\n' "$PREP" | sed -n 's/^STORE_KEY_FILE=//p')"
  if [ -n "$STORE_PART" ]; then
    [ -n "$STORE_LUKS_UUID" ] && [ -n "$STORE_FS_UUID" ] && [ -n "$STORE_KEY_FILE" ] \
      || die "encryption: tilo-disk-encrypt prepare reported an incomplete store volume"
    log "  store volume: $STORE_PART (LUKS2 + Btrfs for the native data plane)"
  fi

  # From here the volume is open and the tree is mounted. If anything below fails
  # the installer exits without reaching `finish`, so close them on the way out —
  # otherwise a retry finds a mounted disk it refuses to touch. Key slots are
  # left alone; only `finish` removes the install key.
  # Alongside cleanup is intentionally scoped to the one Tilo root. Passing
  # the parent disk would make the helper inspect and try to close unrelated
  # sibling LUKS mappings belonging to the existing OS.
  ENC_CLEANUP_TARGET="$DISK"
  [ "$ALONGSIDE" -eq 0 ] || ENC_CLEANUP_TARGET="$ROOT_PARTITION"
  cleanup_encrypted_install() {
    if ! release_copy_scratch; then
      log "error: could not remove bootc scratch mount; leaving LUKS open for safe recovery"
      [ "$ALONGSIDE" -eq 0 ] || restore_firmware_boot_state
      return 1
    fi
    "$DISK_ENCRYPT" teardown "$ENC_CLEANUP_TARGET" --mnt "${ENC_MNT:-/run/tilo-install/target}" >/dev/null 2>&1 || true
    [ "$ALONGSIDE" -eq 0 ] || restore_firmware_boot_state
  }
  trap cleanup_encrypted_install EXIT
  # A failed export leaves its scratch mounted; never close LUKS beneath it.
  [ -n "$ENC_MNT" ] && [ -n "$ENC_LUKS" ] && [ -n "$ENC_KEYFILE" ] \
    && [ -n "$ENC_ROOT_UUID" ] && [ -n "$ENC_BOOT_PART" ] && [ -n "$ENC_KARGS" ] \
    || die "encryption: tilo-disk-encrypt prepare did not report the volume it made"
  ENC_BOOT_MOUNT_SPEC="$("$BOOT_MOUNT_CONTRACT" --disk "$DISK" --boot-part "$ENC_BOOT_PART" --target-root "$ENC_MNT")" \
    || die "encryption: invalid prepared /boot contract"
  expected_boot_uuid="$(blkid -s UUID -o value "$ENC_BOOT_PART" 2>/dev/null || true)"
  [ -n "$expected_boot_uuid" ] && [ "$ENC_BOOT_MOUNT_SPEC" = "UUID=${expected_boot_uuid,,}" ] \
    || die "encryption: prepared /boot UUID does not match the validated TILO_BOOT partition"
  copy_booted_image
  [ "$COPY_SCRATCH_MOUNTED" -eq 0 ] && [ -z "$COPY_SCRATCH" ] \
    || die "bootc scratch still occupies /var/tmp"
  [ -n "$ENC_MNT" ] && mountpoint -q "$ENC_MNT" \
    || die "prepared encrypted root is no longer mounted"
  prepared_root_source="$(findmnt -nro SOURCE --mountpoint "$ENC_MNT")"
  [ -n "$prepared_root_source" ] \
    && [ "$(blkid -s UUID -o value "$prepared_root_source")" = "$ENC_ROOT_UUID" ] \
    || die "prepared encrypted root UUID changed"
  [ "$(readlink -f "$(findmnt -nro SOURCE --mountpoint "$ENC_MNT/boot")")" = "$(readlink -f "$ENC_BOOT_PART")" ] \
    || die "prepared Tilo boot mount changed"
  if [ "$ALONGSIDE" -eq 1 ]; then
    validate_partition_identity "$ROOT_PARTITION" "$EXPECT_ROOT_PARTUUID" "$EXPECT_ROOT_SIZE_BYTES" "Tilo root partition"
    validate_partition_identity "$BOOT_PARTITION" "$EXPECT_BOOT_PARTUUID" "$EXPECT_BOOT_SIZE_BYTES" "Tilo boot partition"
    validate_partition_identity "$EFI_PARTITION" "$EXPECT_EFI_PARTUUID" "$EXPECT_EFI_SIZE_BYTES" "EFI partition"
    [ "$(readlink -f "$ENC_LUKS")" = "$ROOT_PARTITION" ] \
      && [ "$(readlink -f "$ENC_BOOT_PART")" = "$BOOT_PARTITION" ] \
      || die "prepared encrypted partitions differ from the reviewed target"
    [ "$(readlink -f "$(findmnt -nro SOURCE --mountpoint "$ENC_MNT/boot/efi")")" = "$EFI_PARTITION" ] \
      || die "prepared EFI mount differs from the reviewed target"
  fi

  # --skip-finalize because bootc's finalize step remounts the target READ-ONLY,
  # and the account/hostname/keyboard seeding below writes into the deployment's
  # /etc on that same mount. tilo-disk-encrypt finish unmounts and closes the
  # volume immediately afterwards, so the step bootc would have performed buys
  # nothing here.
  step "Installing Tilo into the encrypted root"
  podman run --rm --privileged --pid=host --ipc=host \
    -v /var/lib/containers:/var/lib/containers \
    -v /dev:/dev \
    -v "$ENC_MNT:/target" \
    --security-opt label=disable \
    "${ALONGSIDE_BOOTC_PODMAN_ARGS[@]}" \
    "$LOCAL_IMG" \
    "${ALONGSIDE_BOOTC_COMMAND[@]}" install to-filesystem \
      --composefs-backend \
      --boot-mount-spec "$ENC_BOOT_MOUNT_SPEC" \
      --target-imgref "$TILO_TARGET_IMGREF" \
      --skip-finalize \
      /target

  promote_target_uki "$ENC_MNT/boot/efi"
  BOOT_ESP_ROOT="$ENC_MNT/boot/efi"
elif [ "$ALONGSIDE" -eq 1 ]; then
  copy_booted_image
  validate_alongside
  mark_alongside_tilo_root
  step "Formatting only $ROOT_PARTITION for Tilo; preserving every other partition"
  case "$FILESYSTEM" in
    btrfs) mkfs.btrfs -f -L root "$ROOT_PARTITION" >/dev/null ;;
    ext4) mkfs.ext4 -q -F -O verity -L root "$ROOT_PARTITION" ;;
    xfs) mkfs.xfs -q -f -L root "$ROOT_PARTITION" >/dev/null ;;
  esac
  ROOT_FS_UUID="$(blkid -s UUID -o value "$ROOT_PARTITION")"
  [ -n "$ROOT_FS_UUID" ] || die "could not read the new Tilo root UUID"
  ALONGSIDE_MNT="$(mktemp -d)"
  mount "$ROOT_PARTITION" "$ALONGSIDE_MNT"
  install -d -m 0755 "$ALONGSIDE_MNT/boot/efi"
  mount "$EFI_PARTITION" "$ALONGSIDE_MNT/boot/efi"
  cleanup_alongside() {
    umount "$ALONGSIDE_MNT/boot/efi" 2>/dev/null || true
    umount "$ALONGSIDE_MNT" 2>/dev/null || true
    rmdir "$ALONGSIDE_MNT" 2>/dev/null || true
    restore_firmware_boot_state
  }
  trap cleanup_alongside EXIT
  podman run --rm --privileged --pid=host --ipc=host \
    -v /var/lib/containers:/var/lib/containers -v /dev:/dev \
    -v "$ALONGSIDE_MNT:/target" --security-opt label=disable \
    "${ALONGSIDE_BOOTC_PODMAN_ARGS[@]}" \
    "$LOCAL_IMG" "${ALONGSIDE_BOOTC_COMMAND[@]}" install to-filesystem \
      --root-mount-spec "UUID=$ROOT_FS_UUID" \
      --karg-delete tilo.install --target-imgref "$TILO_TARGET_IMGREF" \
      --skip-finalize /target
  promote_target_uki "$ALONGSIDE_MNT/boot/efi"
  BOOT_ESP_ROOT="$ALONGSIDE_MNT/boot/efi"
else
  copy_booted_image
  step "Installing Tilo onto $DISK (this ERASES the disk; unencrypted)"
  podman run --rm --privileged --pid=host --ipc=host \
    -v /var/lib/containers:/var/lib/containers \
    -v /dev:/dev \
    --security-opt label=type:unconfined_t \
    "$LOCAL_IMG" \
    bootc install to-disk \
      --wipe \
      --karg-delete tilo.install \
      --filesystem "$FILESYSTEM" \
      --block-setup direct \
      --target-imgref "$TILO_TARGET_IMGREF" \
      "$DISK"
  # Full-disk bootc chooses its partition layout. Select exactly one ESP on
  # that disk, mount it temporarily, and promote the same signed target UKI.
  (
    mapfile -t target_esps < <(lsblk -lnpo NAME,PARTTYPE "$DISK" |
      awk 'tolower($2)=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" {print $1}')
    [ "${#target_esps[@]}" -eq 1 ] || die "installed disk must have exactly one ESP"
    target_esp_mount="$(mktemp -d)"
    trap 'umount "$target_esp_mount" 2>/dev/null || true; rmdir "$target_esp_mount" 2>/dev/null || true' EXIT
    mount -o nosuid,nodev,noexec "${target_esps[0]}" "$target_esp_mount"
    promote_target_uki "$target_esp_mount"
  )
fi
[ "$ALONGSIDE" -eq 0 ] || restore_firmware_boot_state
if [ "$INTERNAL_MODE" -eq 1 ]; then
  # Chosen while the new ESP is still mounted; used only when bootc did not
  # leave a firmware entry for it and one has to be created for BootNext.
  case "$(uname -m)" in aarch64|arm64) EFI_SUFFIX=aa64; EFI_FALLBACK=BOOTAA64.EFI ;; *) EFI_SUFFIX=x64; EFI_FALLBACK=BOOTX64.EFI ;; esac
  if [ -f "$BOOT_ESP_ROOT/EFI/systemd/systemd-boot$EFI_SUFFIX.efi" ]; then
    TARGET_LOADER="\\EFI\\systemd\\systemd-boot$EFI_SUFFIX.efi"
  else
    TARGET_LOADER="\\EFI\\BOOT\\$EFI_FALLBACK"
  fi
fi
log "  base system installed."

# Make sure the kernel sees the freshly written partition table.
udevadm settle 2>/dev/null || true

# --- 2b. multi-factor LUKS enrollment ----------------------------------------
# The volume currently opens only with the throwaway install key. Layer the real
# factors on: always a recovery key, the supplied strong passphrase, and
# optionally FIDO2. On verified TPM2 systems the PIN is bound to the signed,
# measured Tilo artifact and this machine's PCR7 state. tilo-disk-encrypt aborts rather than leaving a volume
# whose only factor is one the user cannot reproduce.
if [ "$ENCRYPT" -eq 1 ]; then
  step "Enrolling disk-encryption factors"
  ENROL_ARGS=()
  [ "$WANT_FIDO2" -eq 1 ] && ENROL_ARGS+=(--fido2)
  ENROL_ARGS+=(--passphrase)
  [ -z "${STORE_PART:-}" ] || ENROL_ARGS+=(--store-part "$STORE_PART" --store-key-file "$STORE_KEY_FILE")
  if [ "$WANT_PIN" -eq 1 ]; then
    PIN_FILE=/run/tilo-install/pin
    install -d -m 0700 /run/tilo-install
    ( umask 0077; printf '%s' "$PIN" > "$PIN_FILE" )
    ENROL_ARGS+=(--pin-file "$PIN_FILE")
    TILO_GENERATION="$(cat /usr/lib/tilo/generation 2>/dev/null || true)"
    case "$TILO_GENERATION" in ''|*[!0-9]*) die "installed image has no valid generation" ;; esac
    ENROL_ARGS+=(--predictions "$ENC_MNT/boot/efi/tilo-target/predictions")
    ENROL_ARGS+=(--generation "$TILO_GENERATION")
    ENROL_ARGS+=(--rollback-state "$ENC_MNT/var/lib/tilo/rollback/state.json")
    [ "${REQUIRE_TPM_PREDICTION:-0}" -eq 0 ] || ENROL_ARGS+=(--require-tpm-prediction)
  fi
  # The helper logs to stderr; fold it into our stdout so the UI sees the
  # recovery key it has to show the user.
  "$DISK_ENCRYPT" enrol "$ENC_LUKS" --key-file "$ENC_KEYFILE" "${ENROL_ARGS[@]}" 2>&1
  [ -n "${PIN_FILE:-}" ] && { shred -u "$PIN_FILE" 2>/dev/null || rm -f "$PIN_FILE"; }
  unset PIN
fi
udevadm settle 2>/dev/null || true

# --- 3. seed the user account ------------------------------------------------
step "Preparing the '$USERNAME' account on the installed system"

# SHA-512 crypt the password (no colons in a crypt(3) hash, so the
# name:hash record below parses unambiguously).
HASH="$(printf '%s\n' "$PASSWORD" | tilo-crypto hash-password)"
[ -n "$HASH" ] || die "failed to hash password"

# Find the newly-installed root partition by probe-mounting each partition
# of the target and looking for an ostree deployment. The bootc btrfs layout
# is ESP(vfat) + /boot(ext4) + root(btrfs, subvol 'root'); the partition
# *numbers* aren't fixed, so we discover by content, not by index.
#
# The encrypted path skips the probe: the root is already open and mounted, and
# probing would find only the LUKS header on the raw partition anyway.
DEPLOY_ETC=""
MOUNTED=""
find_deploy_etc() {
  # composefs mutable state lives outside its immutable mounted root.
  if [ -d "$1/state/deploy" ]; then
    find "$1/state/deploy" -mindepth 2 -maxdepth 2 -type d -name etc -print -quit
  else
    find "$1" -regextype posix-extended \
      -regex '.*/ostree/deploy/[^/]+/deploy/[^/]+\.[0-9]+/etc' \
      -type d 2>/dev/null | head -1
  fi
}

if [ "$ENCRYPT" -eq 1 ]; then
  MNT="$ENC_MNT"
  DEPLOY_ETC="$(find_deploy_etc "$MNT")"
elif [ "$ALONGSIDE" -eq 1 ]; then
  MNT="$ALONGSIDE_MNT"
  DEPLOY_ETC="$(find_deploy_etc "$MNT")"
else
  MNT="$(mktemp -d)"
  cleanup() {
    [ -n "$MOUNTED" ] && umount "$MOUNTED" 2>/dev/null || true
    [ -d "$MNT" ] && rmdir "$MNT" 2>/dev/null || true
  }
  trap cleanup EXIT

  for part in $(lsblk -lnpo NAME,TYPE "$DISK" 2>/dev/null | awk '$2=="part"{print $1}'); do
    if mount "$part" "$MNT" 2>/dev/null; then
      MOUNTED="$MNT"
      # Is this the root fs (contains an ostree/deploy tree)? Works whether the
      # btrfs top-level (.../root/ostree/deploy) or the 'root' subvol
      # (.../ostree/deploy) got mounted — the regex below tolerates either.
      DEPLOY_ETC="$(find_deploy_etc "$MNT")"
      [ -n "$DEPLOY_ETC" ] && break
      umount "$MNT" 2>/dev/null || true
      MOUNTED=""
    fi
  done
fi

[ -n "$DEPLOY_ETC" ] || die "could not locate the installed deployment's writable /etc on $DISK"

# Publish a recovery receipt before adding any Tilo-owned chainloader shortcuts
# or target configuration. Both this provisional receipt and its final refresh
# are atomic, so an interrupted alongside install never leaves an empty/partial
# marker or boot-menu files which cannot be attributed to this exact root.
install -d -m 0755 "$DEPLOY_ETC/tilo"
# DEPLOY_ETC is mounted below /run while installing. New inodes otherwise
# inherit var_run_t, which the installed first-boot units cannot read. Resolve
# each final /etc path against the live image's matching SELinux policy before
# atomically publishing it in the deployment.
label_installed_tilo_path() {
  local staged="$1" installed="$2" context
  context="$(/usr/sbin/matchpathcon -n -- "$installed")" \
    || die "could not resolve SELinux label for $installed"
  chcon -- "$context" "$staged" \
    || die "could not label installed $installed"
}
label_installed_tilo_path "$DEPLOY_ETC/tilo" /etc/tilo
INSTALL_MARKER="$DEPLOY_ETC/tilo/install-marker"
write_install_marker() {
  local marker_tmp install_mode=full-disk root_partition_uuid=""
  [ "$ALONGSIDE" -eq 0 ] || install_mode=alongside
  if [ "$ALONGSIDE" -eq 1 ]; then
    root_partition_uuid="$(blkid -s UUID -o value "$ROOT_PARTITION" 2>/dev/null || true)"
    [ -n "$root_partition_uuid" ] || die "could not bind the recovery receipt to the Tilo root partition"
  fi
  marker_tmp="$(mktemp "$DEPLOY_ETC/tilo/.install-marker.XXXXXX")"
  chmod 0600 "$marker_tmp"
  {
    printf 'version=1\nmode=%s\nroot_partition_uuid=%s\nroot_filesystem_uuid=%s\n' \
      "$install_mode" "$root_partition_uuid" "${ROOT_FS_UUID:-}"
    if [ "$ALONGSIDE" -eq 1 ]; then
      EFI_UUID="$(blkid -s UUID -o value "$EFI_PARTITION" 2>/dev/null || true)"
      [ -n "$EFI_UUID" ] || die "could not bind the recovery receipt to the Tilo EFI partition"
      printf 'efi_uuid=%s\n' "$EFI_UUID"
      "$EFI_ARTIFACTS" "$MNT/boot/efi" "${ROOT_FS_UUID:-no-root-uuid}" \
        | sed 's/^/efi_artifact=/'
    fi
  } > "$marker_tmp"
  label_installed_tilo_path "$marker_tmp" /etc/tilo/install-marker
  mv -f -- "$marker_tmp" "$INSTALL_MARKER"
  sync -f "$DEPLOY_ETC/tilo" 2>/dev/null || sync
}
write_install_marker
log "  wrote provisional Tilo recovery ownership marker"

if [ "$ALONGSIDE" -eq 1 ]; then
  BOOT_MENU_RESULT="$("$BOOT_MENU" install "$BOOT_ESP_ROOT" "${ROOT_FS_UUID:-no-root-uuid}")"
  if [ -n "$BOOT_MENU_RESULT" ]; then
    log "  boot menu   : added safe shortcuts for existing operating systems on the Tilo ESP"
  elif [ "$GUIDED_ALONGSIDE" -eq 1 ]; then
    # systemd-boot intentionally operates on its own ESP. Copying Windows or a
    # distro shim from another ESP would break its update/BCD trust boundary;
    # preserve firmware entries/order and keep those systems in the firmware
    # picker instead of presenting a shortcut which cannot boot.
    log "  boot menu   : existing systems remain in the firmware boot picker (their ESPs were not changed)"
  else
    log "  boot menu   : no unambiguous existing loader was present on the selected ESP; firmware entries were preserved"
  fi
  write_install_marker
  log "  recorded Tilo-owned boot menu files in the recovery marker"
fi

# The payload is the offline installer image, so undo its two live-medium-only
# /etc changes in the installed deployment. The signed target UKI omits the live kernel argument; restoring greetd and removing the transient privilege drop-in
# completes the boundary between installer and target.
#
# The first installed boot launches the new account directly so its OOBE does
# not ask for a second secret after disk unlock.  That is deliberately a
# one-boot handoff: the marker is durable before the config is promoted, and
# tilo-firstboot-autologin-cleanup restores the normal greeter after greetd has
# read this initial_session.  A power loss can therefore at worst show the
# normal greeter; it cannot strand the installed account in permanent
# autologin.
install -d -m 0755 "$DEPLOY_ETC/greetd"
GREETD_CONFIG="$DEPLOY_ETC/greetd/config.toml"
GREETD_CONFIG_TMP="$(mktemp "$DEPLOY_ETC/greetd/.config.toml.XXXXXX")"
install -m 0644 /usr/share/tilo/greetd-config.toml "$GREETD_CONFIG_TMP"
printf '\n[initial_session]\ncommand = "/usr/libexec/tilo-session --backend drm"\nuser = "%s"\n' \
  "$USERNAME" >> "$GREETD_CONFIG_TMP"
# DEPLOY_ETC is reached through a transient /run mount. SELinux therefore
# cannot infer the eventual /etc pathname while we are offline and otherwise
# gives this file var_run_t. Enforcing greetd (xdm_t) then refuses to read its
# own configuration on the first installed boot. Copy the label from the
# correctly labelled live /etc counterpart; only the contents differ.
chcon --reference=/etc/greetd/config.toml "$GREETD_CONFIG_TMP"
AUTOLOGIN_PENDING="$DEPLOY_ETC/tilo/firstboot-autologin-pending"
AUTOLOGIN_PENDING_TMP="$(mktemp "$DEPLOY_ETC/tilo/.firstboot-autologin.XXXXXX")"
chmod 0600 "$AUTOLOGIN_PENDING_TMP"
printf 'version=1\n' > "$AUTOLOGIN_PENDING_TMP"
label_installed_tilo_path "$AUTOLOGIN_PENDING_TMP" /etc/tilo/firstboot-autologin-pending
mv -f -- "$AUTOLOGIN_PENDING_TMP" "$AUTOLOGIN_PENDING"
# Flush both the marker and its containing directory before publishing the
# initial_session.  If interrupted after this point, the cleanup unit has an
# unambiguous instruction to restore normal authentication on the next boot.
sync -f "$AUTOLOGIN_PENDING" 2>/dev/null || sync
sync -f "$DEPLOY_ETC/tilo" 2>/dev/null || sync
mv -f -- "$GREETD_CONFIG_TMP" "$GREETD_CONFIG"
sync -f "$DEPLOY_ETC/greetd" 2>/dev/null || sync
rm -f "$DEPLOY_ETC/sudoers.d/tilo-installer"
# Release media mask sshd, while an explicit diagnostic image may enable it.
# Neither live-only state belongs on the installed system; the base Tilo image
# leaves sshd disabled but unmasked.
rm -f "$DEPLOY_ETC/systemd/system/sshd.service" \
      "$DEPLOY_ETC/systemd/system/multi-user.target.wants/sshd.service"
log "  configured one-boot startup handoff to the '$USERNAME' session"

# NetworkManager creates user-selected Wi-Fi profiles as root-owned regular
# files in the live medium. Preserve those profiles so a connection made in
# the optional Network step also works on first boot. Never follow links, copy
# non-root-owned/hard-linked/permissive files, or copy subdirectories. A
# profile created by the live `greetd` user may contain
# `permissions=user:greetd:;`; remove that live-session restriction so the
# installed account can activate the machine connection.
LIVE_CONNECTIONS=/etc/NetworkManager/system-connections
TARGET_CONNECTIONS="$DEPLOY_ETC/NetworkManager/system-connections"
COPIED_CONNECTIONS=0
if [ -d "$LIVE_CONNECTIONS" ]; then
  install -d -m 0700 "$TARGET_CONNECTIONS"
  chcon --reference="$LIVE_CONNECTIONS" "$TARGET_CONNECTIONS" 2>/dev/null || true
  while IFS= read -r -d '' PROFILE; do
    TARGET_PROFILE="$TARGET_CONNECTIONS/$(basename "$PROFILE")"
    install -m 0600 "$PROFILE" "$TARGET_PROFILE"
    sed -i '/^[[:space:]]*permissions=/d' "$TARGET_PROFILE"
    chcon --reference="$PROFILE" "$TARGET_PROFILE" 2>/dev/null || true
    COPIED_CONNECTIONS=$((COPIED_CONNECTIONS + 1))
  done < <(find "$LIVE_CONNECTIONS" -mindepth 1 -maxdepth 1 -type f \
    -uid 0 -links 1 ! -perm /077 -print0)
fi
if [ "$COPIED_CONNECTIONS" -gt 0 ]; then
  log "  preserved $COPIED_CONNECTIONS NetworkManager connection profile(s) for first boot"
fi

# Leave a machine-readable ownership receipt for live-media recovery. Removal
# never infers ownership from a generic Linux partition type or filesystem
# label: it requires this receipt, verifies the selected filesystem UUID, and
# removes only EFI artifacts whose embedded command line names this exact root.
# A full-disk install is recorded too, but the recovery tool deliberately will
# not dismantle it partition-by-partition; whole disks belong in Disks.
# Refresh after target configuration as a final durable checkpoint. The
# contents normally match the post-menu receipt; rewriting atomically also
# heals a surviving provisional marker when an install is safely resumed.
write_install_marker
log "  finalized Tilo recovery ownership marker"
CONF="$DEPLOY_ETC/tilo/install-user.conf"
CONF_TMP="$(mktemp "$DEPLOY_ETC/tilo/.install-user.XXXXXX")"
chmod 0600 "$CONF_TMP"
printf '%s:%s\n' "$USERNAME" "$HASH" > "$CONF_TMP"
label_installed_tilo_path "$CONF_TMP" /etc/tilo/install-user.conf
mv -f "$CONF_TMP" "$CONF"
log "  wrote $CONF (consumed by tilo-firstboot-user.service on first boot)"
if [ -n "$FULL_NAME" ]; then
  FULL_NAME_CONF="$DEPLOY_ETC/tilo/install-user-full-name"
  FULL_NAME_TMP="$(mktemp "$DEPLOY_ETC/tilo/.install-user-full-name.XXXXXX")"
  chmod 0600 "$FULL_NAME_TMP"
  printf '%s\n' "$FULL_NAME" > "$FULL_NAME_TMP"
  label_installed_tilo_path "$FULL_NAME_TMP" /etc/tilo/install-user-full-name
  mv -f "$FULL_NAME_TMP" "$FULL_NAME_CONF"
fi

# --- 3b. room store volume ----------------------------------------------------
# The store's key file moves into the encrypted root, next to the crypttab and
# fstab lines that unlock and mount it at /var/lib/tilo/store on every boot.
# tilo-store-volume.service hands its rooms to this account on first boot, once
# the account exists.
if [ -n "$STORE_PART" ]; then
  step "Configuring the room store volume"
  "$STORE_VOLUME" install-config --etc "$DEPLOY_ETC" \
    --luks-uuid "$STORE_LUKS_UUID" --fs-uuid "$STORE_FS_UUID" \
    --key-file "$STORE_KEY_FILE" --owner "$USERNAME"
  shred -u "$STORE_KEY_FILE" 2>/dev/null || rm -f "$STORE_KEY_FILE"
fi

# --- 4. seed hostname + time zone into the installed deployment's /etc -------
# Same writable-/etc technique as the user file: write into the per-deployment
# /etc so the values land on the installed system without touching the
# read-only, hardlinked usr/etc base.
step "Setting hostname '$HOSTNAME_VAL' and time zone '${TIMEZONE_VAL:-<system default>}'"
printf '%s\n' "$HOSTNAME_VAL" > "$DEPLOY_ETC/hostname"
chmod 0644 "$DEPLOY_ETC/hostname"
log "  wrote $DEPLOY_ETC/hostname"

printf 'LANG=%s\n' "$LOCALE_VAL" > "$DEPLOY_ETC/locale.conf"
chmod 0644 "$DEPLOY_ETC/locale.conf"
log "  set locale to $LOCALE_VAL"

if [ -n "$TIMEZONE_VAL" ]; then
  # /etc/localtime is a relative symlink into zoneinfo; create it pointing at
  # the requested zone (resolved within the installed system at boot). We use
  # a relative target so it's valid regardless of the eventual mount layout.
  ln -sf "../usr/share/zoneinfo/$TIMEZONE_VAL" "$DEPLOY_ETC/localtime"
  printf '%s\n' "$TIMEZONE_VAL" > "$DEPLOY_ETC/timezone"
  log "  set time zone to $TIMEZONE_VAL"
fi

# Keyboard layout. Two consumers on the installed system:
#   * the Tilo Wayland session — the compositor builds its keymap with
#     smithay's add_keyboard(Default::default()), and xkbcommon honours
#     XKB_DEFAULT_LAYOUT/VARIANT from the environment when the supplied
#     config is empty. We append them to /etc/environment (PAM exports it
#     into every session, greetd's included).
#   * the text console — /etc/vconsole.conf KEYMAP, set to the kbd map that
#     best matches the chosen xkb layout.
step "Setting keyboard layout '$KEYMAP_VAL${KEYVARIANT_VAL:+/$KEYVARIANT_VAL}'"
ENV_FILE="$DEPLOY_ETC/environment"
# Drop any prior XKB_DEFAULT_* lines (idempotent on a re-run) then append.
if [ -f "$ENV_FILE" ]; then
  grep -v -E '^XKB_DEFAULT_(LAYOUT|VARIANT)=' "$ENV_FILE" > "$ENV_FILE.tmp" 2>/dev/null || true
  mv "$ENV_FILE.tmp" "$ENV_FILE"
fi
printf 'XKB_DEFAULT_LAYOUT=%s\n' "$KEYMAP_VAL" >> "$ENV_FILE"
if [ -n "$KEYVARIANT_VAL" ]; then
  printf 'XKB_DEFAULT_VARIANT=%s\n' "$KEYVARIANT_VAL" >> "$ENV_FILE"
fi
chmod 0644 "$ENV_FILE"
log "  wrote XKB_DEFAULT_LAYOUT=$KEYMAP_VAL${KEYVARIANT_VAL:+ / XKB_DEFAULT_VARIANT=$KEYVARIANT_VAL} to $ENV_FILE"

VCONSOLE_KEYMAP="$(xkb_to_vconsole "$KEYMAP_VAL" "$KEYVARIANT_VAL")"
printf 'KEYMAP=%s\n' "$VCONSOLE_KEYMAP" > "$DEPLOY_ETC/vconsole.conf"
chmod 0644 "$DEPLOY_ETC/vconsole.conf"
log "  wrote KEYMAP=$VCONSOLE_KEYMAP to $DEPLOY_ETC/vconsole.conf"

# A staged install leaves its two installer partitions behind the new root.
# The installed system reclaims them after its first session, but only by the
# exact identities recorded here (tilo-staging-reclaim revalidates each one).
if [ "$INTERNAL_MODE" -eq 1 ]; then
  mapfile -t TARGET_VARS < <(find "$MNT/state/os" "$MNT/ostree/deploy" -mindepth 2 -maxdepth 2 \
    -type d -name var 2>/dev/null)
  [ "${#TARGET_VARS[@]}" -eq 1 ] || die "could not locate the installed system's /var for the reclaim record"
  "$STAGING_HANDOFF" write-reclaim-record --handoff "$INTERNAL_HANDOFF" \
    --target-var "${TARGET_VARS[0]}" \
    --target-root-partuuid "$NEW_ROOT_PARTUUID" --target-esp-partuuid "$NEW_EFI_PARTUUID" \
    --target-root-start-bytes "$ROOT_START_BYTES" --target-root-size-bytes "$ROOT_SIZE_BYTES" \
    --sector-size "$EXPECT_LOGICAL_SECTOR_SIZE" \
    || die "could not record the staged installer space for reclaim"
  chcon --reference=/var/lib "${TARGET_VARS[0]}/lib/tilo" "${TARGET_VARS[0]}/lib/tilo/staging-reclaim.json" 2>/dev/null || true
fi

VM_INSTALL_PROOF=""
VM_INSTALL_PROOF_PORT=/dev/virtio-ports/org.tilo.vm-install-proof
if [ "$ALONGSIDE" -eq 1 ] && [ "$ENCRYPT" -eq 1 ] \
    && [ -e "$VM_INSTALL_PROOF_PORT" ]; then
  [ -c "$VM_INSTALL_PROOF_PORT" ] && systemd-detect-virt --vm --quiet \
    || die "VM install proof requires a named virtio character device inside a VM"
  VM_INSTALL_PROOF=/run/tilo-installer/vm-install-proof.json
  python3 /usr/libexec/tilo-vm-install-proof.py \
    --target-root "$MNT" --deploy-etc "$DEPLOY_ETC" \
    --efi-root "$BOOT_ESP_ROOT" \
    --target-uki "$BOOT_ESP_ROOT/EFI/Linux/bootc/bootc_composefs-${TARGET_COMPOSEFS_DIGEST}.efi" \
    --disk "$DISK" --efi-partition "$EFI_PARTITION" \
    --boot-partition "$BOOT_PARTITION" --root-partition "$ROOT_PARTITION" \
    --output "$VM_INSTALL_PROOF" \
    || die "VM installed image identity proof failed"
fi

# The owner's explicit opt-in to Tilo extensions (the media codecs, say). Only
# the choice is recorded; the installed system downloads the extension itself,
# from its publishers, once it is online. tilo-extension adopts each seed once
# into /var/lib/tilo/extensions/<id>/enabled, so removing it later sticks.
for EXTENSION_ID in $EXTENSIONS; do
  step "Recording the choice to turn on $EXTENSION_ID"
  SEED_DIR="$DEPLOY_ETC/tilo/extensions/opt-in"
  mkdir -p "$SEED_DIR"
  chmod 0755 "$DEPLOY_ETC/tilo/extensions" "$SEED_DIR"
  SEED_TMP="$(mktemp "$SEED_DIR/.$EXTENSION_ID.XXXXXX")"
  printf 'owner opted in during installation\n' > "$SEED_TMP"
  chmod 0644 "$SEED_TMP"
  mv -f "$SEED_TMP" "$SEED_DIR/$EXTENSION_ID"
  log "  wrote $SEED_DIR/$EXTENSION_ID (installed on first boot once online)"
done

if [ -d "${TILO_INSTALLER_PROFILE_OUT_DIR:-/run/tilo-installer}/setup-handoff" ]; then
  step "Copying Wi-Fi and identity from the setup machine"
  HANDOFF_SRC="${TILO_INSTALLER_PROFILE_OUT_DIR:-/run/tilo-installer}/setup-handoff"
  [ -n "$DEPLOY_ETC" ] || die "setup handoff is present but the installed /etc was not found"
  HANDOFF_VAR="$(find "$MNT/state/os" "$MNT/ostree/deploy" -mindepth 2 -maxdepth 2 -type d -name var -print -quit 2>/dev/null || true)"
  [ -n "$HANDOFF_VAR" ] || die "setup handoff is present but the installed /var was not found"
  if [ -d "$HANDOFF_SRC/etc" ]; then
    python3 /usr/libexec/tilo-install-handoff-copy.py "$HANDOFF_SRC/etc" "$DEPLOY_ETC"
  fi
  if [ -d "$HANDOFF_SRC/var" ]; then
    python3 /usr/libexec/tilo-install-handoff-copy.py "$HANDOFF_SRC/var" "$HANDOFF_VAR"
  fi
  key="$HANDOFF_VAR/lib/tilo/device-private/keypair.bin"
  if [ -f "$key" ]; then
    chgrp tilo-identity "$key" || die "tilo-identity group is missing; cannot install the device key"
    chmod 0640 "$key"
  fi
  if [ -d "$DEPLOY_ETC/NetworkManager/system-connections" ]; then
    find "$DEPLOY_ETC/NetworkManager/system-connections" -type f -name 'tilo-setup.nmconnection' -exec chmod 0600 {} +
    # Label new request files with their installed policy paths so
    # NetworkManager can read this profile before OOBE.
    label_installed_tilo_path "$DEPLOY_ETC/NetworkManager/system-connections" /etc/NetworkManager/system-connections
    if [ -f "$DEPLOY_ETC/NetworkManager/system-connections/tilo-setup.nmconnection" ]; then
      label_installed_tilo_path "$DEPLOY_ETC/NetworkManager/system-connections/tilo-setup.nmconnection" /etc/NetworkManager/system-connections/tilo-setup.nmconnection
    fi
  fi
  log "  applied the setup handoff"
  SSH_REQUEST="$HANDOFF_SRC/etc/tilo/bringup-ssh.pub"
  if [ -e "$SSH_REQUEST" ] || [ -L "$SSH_REQUEST" ]; then
    # A separately selected dev target was checked before disk mutation and
    # again during import. A production target never admits this handoff.
    { [ "$OFFLINE_TARGET" -eq 0 ] || [ "$OFFLINE_TARGET" -eq 2 ]; } \
      && [ "$(cat /usr/lib/tilo/image-flavour 2>/dev/null || true)" = dev ] \
      && [ -x /usr/sbin/sshd ] \
      && [ -f /usr/lib/systemd/system/sshd.service ] \
      || die "bring-up SSH requires a verified development target with OpenSSH"
    python3 /usr/libexec/tilo-install-dev-ssh.py --etc "$DEPLOY_ETC" \
      --username "$USERNAME" --key "$SSH_REQUEST" \
      || die "could not configure owner-key bring-up SSH"
    rm -f "$DEPLOY_ETC/tilo/bringup-ssh.pub"
    log "  enabled owner-key SSH independently of desktop onboarding"
  fi
fi

sync
if [ "$ENCRYPT" -eq 1 ]; then
  # Drops the throwaway install key slot (only once another factor exists),
  # unmounts the tree and closes the mapping.
  step "Closing the encrypted root"
  "$DISK_ENCRYPT" finish "$ENC_LUKS" --key-file "$ENC_KEYFILE" --mnt "$ENC_MNT" 2>&1
elif [ "$ALONGSIDE" -eq 1 ]; then
  cleanup_alongside
  trap - EXIT
else
  umount "$MOUNTED" 2>/dev/null || true
  MOUNTED=""
fi

# Only after every step above succeeded: hand the next restart to the new
# Tilo exactly once. The restored BootOrder keeps the existing system as the
# default; the owned staging entry is removed only while its bytes still name
# the staging ESP. A failure here leaves a complete installation, so report it
# instead of failing the install.
if [ -n "$VM_INSTALL_PROOF" ]; then
  # This line is emitted only after `finish` succeeded and the encrypted
  # target was closed. The dedicated virtio port carries no installer logs
  # or secrets. The host must compare the image identity to its signed CI pin.
  proof_version=V1
  if [ "$OFFLINE_TARGET" -eq 2 ]; then
    proof_version=V4
  elif [ "$OFFLINE_TARGET" -ne 0 ]; then
    proof_version=V2
  elif python3 -c 'import json,sys; sys.exit(json.load(open(sys.argv[1]))["schema"] != "tilo.vm-install-image-proof.v3")' "$VM_INSTALL_PROOF"; then
    proof_version=V3
  fi
  proof_line="TILO_VM_INSTALL_PROOF_${proof_version}=$(cat "$VM_INSTALL_PROOF")"
  [ -c "$VM_INSTALL_PROOF_PORT" ] \
    && printf '%s\n' "$proof_line" > "$VM_INSTALL_PROOF_PORT" \
    || die "VM install proof could not reach its dedicated virtio port"
fi
if [ "$INTERNAL_MODE" -eq 1 ]; then
  step "Pointing the next restart at the installed Tilo"
  TARGET_ESP_PARTNUM="$(lsblk -dno PARTN "$EFI_PARTITION" 2>/dev/null | tr -d '[:space:]')"
  if ! "$STAGING_HANDOFF" firmware-finalize --handoff "$INTERNAL_HANDOFF" \
      --target-esp-partuuid "$NEW_EFI_PARTUUID" --target-disk "$DISK" \
      --target-esp-partition-number "${TARGET_ESP_PARTNUM:-0}" --loader "$TARGET_LOADER" 2>&1; then
    log "warning: the firmware was not fully updated; if the existing system starts instead of Tilo, choose Tilo in the firmware boot menu"
  fi
  step "Install complete — restart to finish setting up Tilo."
  exit 0
fi

step "Install complete — you can reboot into Tilo now."
log "Remove the installer medium before rebooting."
exit 0
