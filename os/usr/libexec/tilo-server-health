#!/usr/bin/bash
# Whether this boot of a Tilo server is serving what it is for.
#
# tilo-boot-health.service judges the server by this unit (the host image's
# drop-in names it in TILO_BOOT_HEALTH_UNIT, the same boundary an always-on board
# uses for its own session): a oneshot that succeeds when the machine serves and
# fails when it does not. A failed update needs no rollback command — the boot
# loader keeps the try it spent and stops offering the entry after its tries —
# but the verdict has to be about the server, not about a sign-in screen a server
# does not have.
#
# A server that serves means, in order:
#
#   1. The server is serving: tilo-server.service is active, and its metrics
#      snapshot is one it wrote since this boot began. The daemon binds its
#      endpoint and opens every durable workspace before it serves anything, and
#      stops with its unit when either fails, so an active server with a fresh
#      snapshot is one peers can dial and whose store opened.
#
# A server that has not been paired yet has no server: tilo-server-firstboot waits
# on the console for the pairing token from the person's own device, and until
# then multi-user.target is everything the machine can do. That boot is judged by
# the target alone, as an always-on board with no account yet is, so a fresh
# server is never rolled back for waiting to be paired.
set -uo pipefail

log()  { printf 'tilo-server-health: %s\n' "$*"; }
warn() { printf 'tilo-server-health: WARNING: %s\n' "$*" >&2; }

CERT="${TILO_SERVER_HEALTH_CERT:-/var/lib/tilo/device/cert.bin}"
# Where the daemon keeps its profile, as tilo-server.service tells it: its native
# endpoint answers there from boot.
PROFILE="${TILO_SERVER_HEALTH_PROFILE:-${TILO_RUNTIME_PROFILE:-/var/lib/tilo-server}}"
# Where it keeps what a server keeps: the device's own state directory, as the
# login places it under the account's state home.
OWN="${TILO_SERVER_HEALTH_OWN:-${XDG_STATE_HOME:-/var/lib/tilo/state}/tilo/device/own}"
# How long a serving generation may take to come up: the server's own
# TimeoutStartSec plus firstboot's enrollment wait, which has already run by the
# time this unit is asked.
DEADLINE="${TILO_SERVER_HEALTH_TIMEOUT:-240}"
POLL="${TILO_SERVER_HEALTH_POLL:-2}"
# A metrics snapshot older than this is not evidence of a serving daemon: the
# daemon writes one every second while it runs.
FRESH="${TILO_SERVER_HEALTH_FRESH:-30}"

final_state() {
  systemctl status --no-pager --lines=20 tilo-server.service 2>&1 \
    | sed 's/^/tilo-server-health:   /' >&2
}

# Not paired yet: the machine is at its pairing prompt, and reaching
# multi-user.target is the whole of what it can prove.
if [ ! -e "$CERT" ]; then
  end=$(( $(date +%s) + DEADLINE ))
  while :; do
    if systemctl is-active --quiet multi-user.target; then
      log 'not paired yet (no device certificate); the server is waiting at its pairing prompt'
      log 'multi-user.target is active — this boot is good'
      exit 0
    fi
    [ "$(date +%s)" -ge "$end" ] && break
    sleep "$POLL"
  done
  warn "not paired yet, and multi-user.target did not become active within ${DEADLINE}s"
  final_state
  exit 1
fi

# The verdict written as one line per part, so a failed boot's journal says which
# part failed rather than only that the boot did.
serving() {
  local reason=
  if ! systemctl is-active --quiet tilo-server.service; then
    reason="tilo-server.service is not active"
  elif [ ! -S "$PROFILE/native.sock" ]; then
    reason="the daemon answers no native endpoint at $PROFILE/native.sock"
  elif [ ! -r "$OWN/metrics.json" ]; then
    reason="the server has written no metrics snapshot in $OWN"
  elif [ $(( $(date +%s) - $(stat -c %Y "$OWN/metrics.json") )) -gt "$FRESH" ]; then
    reason="the server's metrics snapshot in $OWN is older than ${FRESH}s: it is not serving now"
  fi
  if [ -n "$reason" ]; then
    warn "$reason"
    return 1
  fi
  log 'the server is serving, and its store opened'
  return 0
}

end=$(( $(date +%s) + DEADLINE ))
while :; do
  # A unit that has already failed will not start serving by waiting.
  if systemctl is-failed --quiet tilo-server.service; then
    warn 'tilo-server.service FAILED, so this boot does not count as a success and the'
    warn 'boot loader keeps its spent try'
    final_state
    exit 1
  fi
  if serving; then
    log 'this boot is good'
    exit 0
  fi
  [ "$(date +%s)" -ge "$end" ] && break
  sleep "$POLL"
done
warn "this boot does not count as a success: not serving within ${DEADLINE}s, so the"
warn 'boot loader keeps its spent try and goes back after its tries'
final_state
exit 1
