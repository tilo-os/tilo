#!/usr/bin/bash
# Boot into a staged OS update, once this generation has proved itself and the
# operator's window is open.
#
# A Tilo server stages an update and does not reboot into it by itself: the boot
# health check has to have judged the running generation good (a generation that
# is still on trial must not restart a machine that serves other people's
# workspaces), and the update window has to be open. This is the step that turns
# a staged update into the next boot, so a server follows its channel without
# anyone logging in to it, and a generation that fails its own health check is
# the boot loader's to take back, not this unit's.
#
# A paired server also waits its turn among its person's servers, which the
# daemon keeps: this unit asks the daemon over its own action dispatch, as the
# update service does. It takes the person's admin workspace's update lease,
# checks that every workspace the server holds keeps its copies on their other
# servers, and drains — hands its work off and suspends its Linux machines — and
# only then does this unit reboot. After the restart, once the generation passed
# its health check, the daemon is told which image booted and lets the lease go,
# and asks the person's other devices for its rollback floor to move.
set -uo pipefail

log()  { printf 'tilo-server-update-apply: %s\n' "$*"; }

BOOTC="${TILO_SERVER_UPDATE_BOOTC:-/usr/bin/bootc}"
FIELD="${TILO_SERVER_UPDATE_FIELD:-/usr/bin/tilo-image-trust}"
WINDOW="${TILO_SERVER_UPDATE_WINDOW:-/usr/libexec/tilo-server-update-window}"
HEALTH="${TILO_SERVER_UPDATE_HEALTH:-tilo-boot-health.service}"
TILO="${TILO_SERVER_UPDATE_CLI:-/usr/bin/tilo}"
CERTS="${TILO_SERVER_UPDATE_CERTS:-/var/lib/tilo/device/certs}"
ROLLBACK="${TILO_SERVER_UPDATE_ROLLBACK:-/usr/libexec/tilo/tilo-rollback}"
ROLLBACK_COMMON="${TILO_SERVER_UPDATE_ROLLBACK_COMMON:-/usr/libexec/tilo-rollback-common}"
UPDATES="${TILO_SERVER_UPDATE_UPDATES:-/usr/libexec/tilo-update-channel}"
FLOOR_AUTHORITY="${TILO_SERVER_UPDATE_FLOOR_AUTHORITY:-/usr/share/tilo/tpm2-pcr-signing.public.pem}"
APPROVALS="${TILO_SERVER_UPDATE_APPROVALS:-/var/lib/tilo/rollback/approvals}"
# Where the daemon keeps what the person's devices signed, for this root unit to
# carry into the approvals directory it alone may write: its own state, under the
# state home its profile (/var/lib/tilo/state) gives it.
STAGING="${TILO_SERVER_UPDATE_APPROVAL_STAGING:-/var/lib/tilo/state/state/tilo/device/own/approvals-next}"

status="$("$BOOTC" status --format json 2>/dev/null)" || true
field() { "$FIELD" bootc-status-field "$1" <<<"$status" 2>/dev/null || true; }
staged="$(field staged-image)"
paired=no
compgen -G "$CERTS/*.bin" >/dev/null && paired=yes

# The running generation's verdict. A boot the boot loader counts keeps
# tilo-boot-health, and only an active unit means the boot was judged good and
# blessed; rebooting before that verdict would spend a try of a generation nobody
# judged yet. A boot it does not count (the entry is already proven) never runs
# that unit, and the generation is not on trial, so there is nothing to wait for.
state="$(systemctl show -p ActiveState --value "$HEALTH" 2>/dev/null)"
if [ -e /sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f ] \
  && [ "$state" != active ]; then
  if [ "$state" = failed ]; then
    log "this generation failed $HEALTH; not restarting the machine on it"
  else
    log "$HEALTH has not judged this boot yet; not restarting the machine before it does"
  fi
  exit 0
fi

# This boot is judged good: an update this server restarted into under the
# lease is done, and the next server may take its turn.
if [ "$paired" = yes ]; then
  booted="$(field booted-digest)"
  [ -z "$booted" ] || log "$("$TILO" device rollout booted "$booted")"
fi

# Its rollback floor may move past older generations now, which takes an
# approval signed by the person's floor key: the daemon asks the person's other
# devices in their admin workspace, and keeps what they signed where
# `tilo-rollback confirm` looks. A machine nobody answers keeps its floor and
# unlocks as before (docs/security/rollback.md).
if [ "$paired" = yes ] && [ -n "${booted:-}" ] && [ -x "$ROLLBACK" ] && [ -r "$ROLLBACK_COMMON" ]; then
  # Read in a subshell: the helpers bring a log() of their own.
  # shellcheck source=/dev/null
  dev="$(. "$ROLLBACK_COMMON"; rollback_luks_device)"
  # shellcheck source=/dev/null
  generation="$(. "$ROLLBACK_COMMON"; rollback_running_generation)"
  if [ -n "$dev" ] && [ -n "$generation" ]; then
    request="$(mktemp)"
    if "$ROLLBACK" floor-request --device "$dev" --out "$request" >/dev/null 2>&1; then
      said="$("$TILO" device rollout floor "$generation" \
        --image "$booted" --updates "$("$UPDATES" current)" \
        --authority "$FLOOR_AUTHORITY" --request "$request")"
      code=$?
      log "$said"
      if [ "$code" -eq 0 ] && [ -d "$STAGING" ]; then
        mkdir -p "$APPROVALS"
        cp -f "$STAGING"/* "$APPROVALS"/ 2>/dev/null
        rm -rf "$STAGING"
        # Spend them now rather than at the next boot's confirmation.
        systemctl start --no-block tilo-rollback-confirm.service
      fi
    fi
    rm -f "$request"
  fi
fi

# No staged deployment: nothing to boot into.
if [ -z "$staged" ]; then
  log 'no staged deployment; nothing to apply'
  exit 0
fi

"$WINDOW" || exit 0

# Its turn among the person's servers: the daemon takes the update lease, drains
# this server only when every workspace keeps its copies elsewhere, and answers
# whether this unit may reboot.
if [ "$paired" = yes ]; then
  if ! decision="$("$TILO" device rollout prepare "$(field staged-digest)")"; then
    log 'the daemon did not answer whether this server may restart; not restarting it'
    exit 0
  fi
  log "$decision"
  case $decision in
    *'"answer":"restart"'*) ;;
    *) log "another of the person's servers has the update lease, or this one must not restart yet"
       exit 0 ;;
  esac
fi

log "booting into the staged $staged"
systemctl reboot
