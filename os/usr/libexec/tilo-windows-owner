#!/usr/bin/bash
# Narrow owner-side operations for Tilo's singleton Windows appliance.
#
# `import-iso` deliberately consumes fd 0.  The caller must duplicate the
# descriptor obtained from Tilo's file portal onto stdin before invoking pkexec;
# no pathname, URI, or file-picker result is accepted on this privileged
# boundary.  `recovery-start` starts only the known singleton and mints a
# root-owned, short-lived proof consumed by the unprivileged recovery viewer
# through a second, equally narrow pkexec action.
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
readonly ROOT='/var/lib/tilo/windows'
readonly PROVISION='/usr/libexec/tilo-windows-provision'
readonly VM_CONTROL='/usr/libexec/tilo-windows-vm-control'
readonly RECOVERY_ROOT='/run/tilo/windows-recovery'
# Windows installation media is normally much smaller.  This deliberately
# exceeds current media while bounding a malicious portal descriptor before it
# can consume the appliance state volume.
readonly MAX_ISO_BYTES=21474836480

die() { printf '%s\n' "tilo-windows-owner: $*" >&2; exit 1; }
usage() {
    cat >&2 <<'EOF'
Usage:
  tilo-windows-owner status
  tilo-windows-owner graphics-capabilities
  pkexec /usr/libexec/tilo-windows-owner import-iso < portal-selected-windows.iso
  pkexec /usr/libexec/tilo-windows-owner recovery-start
  pkexec /usr/libexec/tilo-windows-owner consume-recovery
  pkexec /usr/libexec/tilo-windows-owner lifecycle {status|start|shutdown|force-shutdown|restart|suspend|resume}
  pkexec /usr/libexec/tilo-windows-owner egress-open {activation|windows-update} [ttl-seconds]
  pkexec /usr/libexec/tilo-windows-owner egress-close <lease-id>
  pkexec /usr/libexec/tilo-windows-owner egress-revoke
  pkexec /usr/libexec/tilo-windows-owner graphics-attach {sriov-vf|mdev} <canonical-id>
  pkexec /usr/libexec/tilo-windows-owner graphics-detach

Mutating actions are separately authorised by polkit. The ISO is read from the
inherited portal descriptor on stdin; this command never accepts a host
pathname. `recovery-start` authorises only a one-time unprivileged viewer
attachment. Graphics attach accepts only a probe-proven VFIO partition and can
run only while the singleton is shut off.
EOF
}

require_root() { [ "${EUID}" -eq 0 ] || die 'must be invoked by pkexec'; }
ensure_vm_network() {
    systemctl start tilo-windows-vm-network.service \
        || die 'could not prepare the isolated Windows network'
}
require_exact_action() {
    [ "$#" -ge 1 ] || { usage; exit 2; }
    case "$1" in import-iso|recovery-start|consume-recovery) [ "$#" -eq 1 ] || { usage; exit 2; } ;;
        lifecycle) [ "$#" -eq 2 ] || { usage; exit 2; }; case "$2" in status|start|shutdown|force-shutdown|restart|suspend|resume) ;; *) usage; exit 2 ;; esac ;;
        egress-open) [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { usage; exit 2; }; case "$2" in activation|windows-update) ;; *) usage; exit 2; esac; [ "$#" -eq 2 ] || [[ "$3" =~ ^[0-9]+$ ]] || { usage; exit 2; } ;;
        egress-close) [ "$#" -eq 2 ] && [[ "$2" =~ ^egress-[A-Za-z0-9-]+$ ]] || { usage; exit 2; } ;;
        egress-revoke) [ "$#" -eq 1 ] || { usage; exit 2; } ;;
        graphics-attach)
            [ "$#" -eq 3 ] || { usage; exit 2; }
            case "$2" in
                sriov-vf) [[ "$3" =~ ^[0-9A-Fa-f]{4}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}\.[0-7]$ ]] || { usage; exit 2; } ;;
                mdev) [[ "$3" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] || { usage; exit 2; } ;;
                *) usage; exit 2 ;;
            esac
            ;;
        graphics-detach) [ "$#" -eq 1 ] || { usage; exit 2; } ;;
        *) usage; exit 2 ;; esac
}

# Return the pkexec caller only when it is an ordinary numeric account.  This
# is not the authorisation decision — polkit made that decision — it merely
# lets root hand the recovery proof back to the same unprivileged session.
pkexec_caller_uid() {
    local uid="${PKEXEC_UID:-}"
    [[ "$uid" =~ ^[1-9][0-9]*$ ]] || die 'recovery must be invoked through pkexec by an active owner'
    getent passwd "$uid" >/dev/null || die 'pkexec caller no longer exists'
    printf '%s\n' "$uid"
}

require_portal_regular_stdin() {
    [ ! -t 0 ] || die 'stdin must be an inherited portal file descriptor, not a terminal'
    local type mode size
    type="$(stat -Lc '%F' /proc/self/fd/0 2>/dev/null)" || die 'cannot inspect portal descriptor'
    [ "$type" = 'regular file' ] || die 'portal descriptor must name a regular file'
    mode="$(stat -Lc '%a' /proc/self/fd/0 2>/dev/null)" || die 'cannot inspect portal descriptor mode'
    # This is descriptive defence in depth: the Tilo portal gives us an open
    # descriptor, and the copy below never reopens a user supplied pathname.
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] || die 'portal descriptor has an invalid mode'
    size="$(stat -Lc '%s' /proc/self/fd/0 2>/dev/null)" || die 'cannot inspect portal descriptor size'
    [[ "$size" =~ ^[0-9]+$ ]] || die 'portal descriptor has an invalid size'
    [ "$size" -gt 0 ] || die 'Windows ISO is empty'
    [ "$size" -le "$MAX_ISO_BYTES" ] || die "Windows ISO exceeds the $MAX_ISO_BYTES byte limit"
    printf '%s\n' "$size"
}

validate_optical_image() {
    local image="$1"
    # `isoinfo` validates ISO9660 descriptors.  Windows media may instead use
    # UDF (or an ISO/UDF bridge), for which udfinfo is the authoritative parser.
    # Do not accept an arbitrary regular file merely because it has .iso in a
    # user-visible name.
    if isoinfo -d -i "$image" >/dev/null 2>&1; then
        return 0
    fi
    if udfinfo "$image" >/dev/null 2>&1; then
        return 0
    fi
    die 'portal file is neither a readable ISO9660 nor UDF optical image'
}

import_iso() {
    require_root
    ensure_vm_network
    [ -x "$PROVISION" ] || die 'singleton provisioning machinery is not installed'
    command -v isoinfo >/dev/null || die 'ISO9660 validator is not installed'
    command -v udfinfo >/dev/null || die 'UDF validator is not installed'
    local expected_size actual_size temporary staged digest
    expected_size="$(require_portal_regular_stdin)"

    # This directory is root-only until the established provisioner changes
    # the appliance state directory to its documented owner-readable mode.
    install -d -m 0700 -o root -g root "$ROOT"
    umask 077
    temporary="$(mktemp "$ROOT/.portal-iso.XXXXXX")"
    staged=''
    cleanup() {
        [ -z "${temporary:-}" ] || rm -f -- "$temporary"
        [ -z "${staged:-}" ] || rm -f -- "$staged"
    }
    trap cleanup EXIT HUP INT TERM

    # Read the descriptor directly.  `head` caps the write even if a file is
    # concurrently extended; comparing its original regular-file length also
    # rejects a nonzero inherited offset or truncated stream.
    head -c "$((MAX_ISO_BYTES + 1))" <&0 > "$temporary"
    actual_size="$(stat -Lc '%s' "$temporary")"
    [ "$actual_size" -eq "$expected_size" ] || die 'portal descriptor changed or was not read from its beginning'
    [ "$actual_size" -le "$MAX_ISO_BYTES" ] || die "Windows ISO exceeds the $MAX_ISO_BYTES byte limit"
    validate_optical_image "$temporary"
    sync -f "$temporary"
    digest="$(sha256sum "$temporary" | awk '{print $1}')"
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || die 'could not hash staged Windows ISO'
    staged="$ROOT/.portal-$digest.iso"
    [ ! -e "$staged" ] || die 'a prior portal import is still being handled; do not retry concurrently'
    # Same-directory rename makes only a complete, validated image visible to
    # the existing provisioner.  The user never gets a path to this file.
    mv -- "$temporary" "$staged"
    temporary=''
    "$PROVISION" prepare --iso "$staged"
    rm -f -- "$staged"
    staged=''
    trap - EXIT HUP INT TERM
    printf '%s\n' '{"result":"prepared","next":"open_setup"}'
}

recovery_start() {
    require_root
    ensure_vm_network
    [ -x "$VM_CONTROL" ] || die 'singleton VM controller is not installed'
    [ -f "$ROOT/system.qcow2" ] && [ -f "$ROOT/domain.uuid" ] \
        || die 'Windows is not provisioned; select installation media first'
    local uid token temporary expiry
    uid="$(pkexec_caller_uid)"
    "$VM_CONTROL" start
    # This directory is neither writable nor searchable by the desktop user.
    # A viewer has to ask the root helper to consume the proof, so it cannot
    # forge a file/flag or replay a previous owner authorisation.
    install -d -m 0700 -o root -g root "$RECOVERY_ROOT"
    token="$RECOVERY_ROOT/$uid"
    temporary="$RECOVERY_ROOT/.${uid}.$$.tmp"
    expiry="$(( $(date +%s) + 120 ))"
    umask 077
    printf '%s\n' "$expiry" > "$temporary"
    chown root:root "$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$token"
    printf '%s\n' '{"result":"recovery_started","next":"open_recovery_viewer"}'
}

consume_recovery() {
    require_root
    local uid token consumed expiry now
    uid="$(pkexec_caller_uid)"
    token="$RECOVERY_ROOT/$uid"
    consumed="$RECOVERY_ROOT/.${uid}.$$.consuming"
    # Same-directory rename is the single-use transition. Exactly one helper
    # can win it; every later attempt sees no token and is refused.
    mv -- "$token" "$consumed" 2>/dev/null \
        || die 'recovery authorisation has already been consumed or expired'
    trap 'rm -f -- "${consumed:-}"' EXIT HUP INT TERM
    [ "$(stat -c '%U:%G:%a' "$consumed" 2>/dev/null)" = 'root:root:600' ] \
        || die 'recovery authorisation has unsafe ownership'
    IFS= read -r expiry < "$consumed" || die 'recovery authorisation is malformed'
    [[ "$expiry" =~ ^[0-9]+$ ]] || die 'recovery authorisation is malformed'
    now="$(date +%s)"
    [ "$now" -le "$expiry" ] || die 'recovery authorisation has expired'
    rm -f -- "$consumed"
    consumed=''
    trap - EXIT HUP INT TERM
    printf '%s\n' '{"result":"recovery_authorisation_consumed"}'
}

lifecycle() {
    require_root
    case "$1" in status|start|shutdown|force-shutdown|restart|suspend|resume) ;; *) die 'invalid lifecycle action' ;; esac
    case "$1" in start|restart|resume) ensure_vm_network ;; esac
    exec "$VM_CONTROL" "$1"
}

egress_open() {
    require_root
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die 'invalid egress-open arguments'
    ensure_vm_network
    exec "$VM_CONTROL" egress-open "$@"
}

egress_close() {
    require_root
    exec "$VM_CONTROL" egress-close "$1"
}

egress_revoke() {
    require_root
    # The controller locates its one active lease.  UI never learns or submits
    # the opaque lease ID.
    exec "$VM_CONTROL" egress-revoke
}

graphics_attach() {
    require_root
    exec "$VM_CONTROL" graphics-attach "$1" "$2"
}

graphics_detach() {
    require_root
    exec "$VM_CONTROL" graphics-detach
}

status() {
    # Read-only status is intentionally usable without pkexec.  The appliance
    # state is group-readable by the normal Tilo owner; callers without that
    # ordinary read access receive a typed unavailable result, never a guess.
    exec "$VM_CONTROL" owner-status
}

case "${1:-}" in
    status)
        [ "$#" -eq 1 ] || { usage; exit 2; }
        status
        ;;
    graphics-capabilities)
        [ "$#" -eq 1 ] || { usage; exit 2; }
        exec "$VM_CONTROL" graphics-capabilities
        ;;
    import-iso|recovery-start|consume-recovery|lifecycle|egress-open|egress-close|egress-revoke|graphics-attach|graphics-detach)
        require_exact_action "$@"
        case "$1" in
            import-iso) import_iso ;;
            recovery-start) recovery_start ;;
            consume-recovery) consume_recovery ;;
            lifecycle) shift; lifecycle "$@" ;;
            egress-open) shift; egress_open "$@" ;;
            egress-close) shift; egress_close "$@" ;;
            egress-revoke) egress_revoke ;;
            graphics-attach) shift; graphics_attach "$@" ;;
            graphics-detach) graphics_detach ;;
        esac
        ;;
    -h|--help|'') usage ;;
    *) usage >&2; exit 2 ;;
esac
