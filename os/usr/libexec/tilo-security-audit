#!/usr/bin/bash
# Tilo security self-check (security plan §11). Oneshot at boot: logs which
# hardening features are actually ACTIVE to the journal, so "we think it's on"
# becomes "verified on". Read with: journalctl -u tilo-security-audit
# A failed audit marks this oneshot failed so health surfaces and agents can
# detect it. It is deliberately not a boot dependency, so a diagnostic failure
# never strands the user outside their session.
set -u

failures=0
ok()   { echo "[ OK ]   $*"; }
warn() { echo "[FAIL]   $*"; failures=$((failures + 1)); }
note() { echo "[info]   $*"; }

cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
has_karg() { case " $cmdline " in *" $1 "*) return 0;; *) return 1;; esac; }

echo "=== Tilo security audit ==="

# Installed packages. The unit runs this audit with NoNewPrivileges=, under
# which SELinux refuses rpm its rpm_t transition, so every `rpm -q` failed and
# read as "not installed". The unit lists the packages with privileges first
# (/run/tilo-security-audit.packages); a manual run as root asks rpm itself.
packages_file=/run/tilo-security-audit.packages
installed() {
  local package
  for package in "$@"; do
    if [ -r "$packages_file" ]; then
      grep -Fqx -- "$package" "$packages_file" || return 1
    else
      rpm -q "$package" >/dev/null 2>&1 || return 1
    fi
  done
}

if installed systemd-resolved; then
  warn "redundant OpenSSL-linked systemd-resolved package is installed"
else
  ok "systemd-resolved attack surface absent; NetworkManager owns DNS"
fi
if installed systemd-networkd \
   || systemctl is-active --quiet systemd-networkd.service 2>/dev/null; then
  warn "redundant systemd-networkd surface remains beside NetworkManager"
else
  ok "systemd-networkd absent; NetworkManager is the sole network authority"
fi
if systemctl is-active --quiet systemd-timesyncd.service 2>/dev/null; then
  warn "redundant systemd-timesyncd is active beside chronyd"
else
  ok "systemd-timesyncd inactive; chronyd is the sole time authority"
fi
chrony_config=/etc/chrony.conf
nts_sources="$(grep -Ec '^server [^ ]+ .*\bnts\b' "$chrony_config" 2>/dev/null || true)"
if grep -Fqx 'authselectmode require' "$chrony_config" 2>/dev/null \
   && [ "${nts_sources:-0}" -ge 3 ] \
   && ! grep -E '^server ' "$chrony_config" 2>/dev/null | grep -Ev '\bnts\b' >/dev/null \
   && ! grep -Eq '^[[:space:]]*(pool|peer|sourcedir|confdir)[[:space:]]' "$chrony_config" 2>/dev/null; then
  ok "trusted wall clock requires multiple authenticated NTS sources"
else
  warn "Chrony can select an unauthenticated or insufficiently diverse time source"
fi
pstore_storage="$(systemd-analyze cat-config systemd/pstore.conf 2>/dev/null \
  | sed -n 's/^Storage=//p' | tail -n 1)"
if systemctl is-enabled --quiet systemd-pstore.service 2>/dev/null \
   && [ "${pstore_storage:-external}" = external ]; then
  warn "systemd-pstore archives kernel crash records under /var/lib/systemd/pstore"
else
  ok "pstore crash records go only to the journal"
fi
if installed systemd-coredump \
   || systemctl is-enabled --quiet systemd-coredump.socket 2>/dev/null; then
  warn "systemd-coredump collector remains available to persist process memory"
else
  ok "systemd-coredump collector is absent and disabled"
fi

image_flavour="$(cat /usr/lib/tilo/image-flavour 2>/dev/null || true)"
avoidable_crypto_consumers=""
for package in pesign nss-tools git git-core openvpn NetworkManager-openvpn openssh-server; do
  if installed "$package"; then
    # A dev image (os/Containerfile.dev) adds these on purpose: tilo-vm reaches
    # it over SSH, and it builds components from git checkouts.
    case "$image_flavour:$package" in
      dev:git|dev:git-core|dev:openssh-server) note "dev image: $package installed for tilo-vm"; continue ;;
    esac
    avoidable_crypto_consumers="$avoidable_crypto_consumers $package"
  fi
done
if [ -n "$avoidable_crypto_consumers" ]; then
  warn "avoidable OpenSSL consumers remain installed:$avoidable_crypto_consumers"
else
  ok "unused signing tools, Git/OpenVPN and OpenSSH server absent from the immutable host"
fi
optional_crypto_module="$(find /usr/lib /usr/lib64 \
  \( -path '*/ossl-modules/legacy.so' -o -path '*/engines-3/*.so' \
     -o -name 'libshout.so*' \
     -o -name 'libevent_openssl.so*' \
     -o -path '*/gstreamer-1.0/libgstdtls.so' \
     -o -path '*/gstreamer-1.0/libgstcurl.so' \
     -o -path '*/gstreamer-1.0/libgstshout2.so' \
     -o -path '*/gstreamer-1.0/libgstwebrtc.so' \
     -o -path '*/gstreamer-1.0/libgstnice.so' \
     -o -path '*/gstreamer-1.0/libgstsrtp.so' \) \
  \( -type f -o -type l \) -print -quit 2>/dev/null || true)"
if [ -n "$optional_crypto_module" ]; then
  warn "optional crypto/network media plugin remains: $optional_crypto_module"
else
  ok "optional OpenSSL modules and unused network media plugins absent"
fi
# Fedora swtpm_localca needs certtool for fresh VM TPM provisioning; Fedora
# virt-viewer requires the SSH client package even for Tilo's local-only path.
# Report these distribution exceptions explicitly, never as absent tooling.
for pair in gnutls-utils:swtpm-tools openssh:virt-viewer openssh-clients:virt-viewer; do
  package="${pair%%:*}"
  parent="${pair#*:}"
  if installed "$package"; then
    if installed "$parent"; then
      note "reviewed Fedora VM dependency retained: $package ($parent)"
    else
      warn "unexpected VM dependency without its consumer: $package ($parent absent)"
    fi
  fi
done
case "$(readlink /etc/resolv.conf 2>/dev/null || true)" in
  ../run/NetworkManager/resolv.conf|/run/NetworkManager/resolv.conf)
    ok "/etc/resolv.conf follows NetworkManager"
    ;;
  *) warn "/etc/resolv.conf is not owned by NetworkManager" ;;
esac
if [ -r /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem ]; then
  ok "immutable Rustls trust bundle is readable"
else
  warn "immutable Rustls trust bundle is missing or unreadable"
fi

# SELinux
mode="$(getenforce 2>/dev/null || echo unknown)"
[ "$mode" = "Enforcing" ] && ok "SELinux: Enforcing" || warn "SELinux: $mode (expected Enforcing)"

# Kernel lockdown
lock="$(cat /sys/kernel/security/lockdown 2>/dev/null || echo 'n/a')"
case "$lock" in
  *'[integrity]'*|*'[confidentiality]'*) ok "kernel lockdown: $lock" ;;
  *) warn "kernel lockdown: $lock (expected [integrity]; needs Secure Boot to fully enforce)" ;;
esac

# Memory-init + heap hardening kargs
for k in init_on_alloc=1 slab_nomerge page_alloc.shuffle=1 vsyscall=none; do
  has_karg "$k" && ok "karg $k" || warn "karg $k MISSING"
done
# 01-hardening.toml leaves init_on_free out on purpose: it zeroes all RAM on one
# CPU at every boot and switches init_on_alloc's zeroing off. Someone may still
# add it to their own boot entry; say so, it is not a failure.
if has_karg init_on_free=1; then
  note "karg init_on_free=1 is set locally: freed memory is scrubbed, boot zeroes all RAM first"
fi
# A dev image (os/Containerfile.dev, /usr/lib/tilo/image-flavour = dev) drops
# this karg on purpose: tilo-vm hands the VM its SSH key as a credential.
if has_karg systemd.import_credentials=no; then
  ok "karg systemd.import_credentials=no"
elif [ "$image_flavour" = dev ]; then
  note "dev image: system credentials are imported (tilo-vm's SSH key)"
else
  warn "karg systemd.import_credentials=no MISSING"
fi
case " $cmdline " in *randomize_kstack_offset=on*|*randomize_kstack_offset=1*) ok "karg randomize_kstack_offset";; *) warn "karg randomize_kstack_offset MISSING";; esac

# Device and user signing keys are deliberately never written to persistent
# swap. Disk-backed swap would also turn memory pressure into storage-latency
# spikes; Tilo supports only its ephemeral LZ4 zram device.
active_swaps="$(swapon --noheadings --raw --show=NAME 2>/dev/null || true)"
if [ "$active_swaps" = /dev/zram0 ]; then
  ok "only ephemeral zram swap is active"
else
  warn "unexpected swap set (expected only /dev/zram0): ${active_swaps:-none}"
fi

device_key_dir=/var/lib/tilo/device-private
device_key="$device_key_dir/keypair.bin"
device_dir_meta="$(stat -c '%u:%G:%a' "$device_key_dir" 2>/dev/null || echo invalid)"
device_key_meta="$(stat -c '%u:%G:%a:%h:%s' "$device_key" 2>/dev/null || echo invalid)"
if [ "$device_dir_meta" = '0:tilo-identity:2750' ] && [ ! -L "$device_key_dir" ] \
   && [ "$device_key_meta" = '0:tilo-identity:640:1:32' ] \
   && [ -f "$device_key" ] && [ ! -L "$device_key" ]; then
  ok "device identity seed is root-owned, group-scoped, private, and unaliased"
else
  warn "device identity custody is unsafe (directory=$device_dir_meta key=$device_key_meta)"
fi

# The kargs above are what we ASKED for. This is what the kernel actually did:
# it reports the resolved zero-on-alloc / zero-on-free state once at boot, and
# that line is the only place the live setting is observable — there is no
# sysfs knob for either. A karg that was ignored (typo, unsupported build)
# shows up here and nowhere else.
meminit="$(journalctl --quiet --boot --dmesg --no-pager --output=cat 2>/dev/null \
  | grep -m1 'mem auto-init:' || true)"
# The image asks for zero-on-alloc only (01-hardening.toml says why free is
# off). A local init_on_free=1 makes the kernel zero on free instead and turn
# alloc zeroing off: allocations still reach their caller zeroed, so note it.
case "$meminit" in
  *'alloc:on'*) ok "${meminit#*mem auto-init: }(live, from the kernel's own report)" ;;
  *'free:on'*)  note "mem auto-init zeroes on free (local init_on_free=1): ${meminit#*mem auto-init: }" ;;
  '')           note "mem auto-init: kernel report not in the ring buffer (rotated out?)" ;;
  *)            warn "mem auto-init NOT on: ${meminit#*mem auto-init: }" ;;
esac

# Enforced module signatures. sig_enforce is the live value of
# CONFIG_MODULE_SIG_FORCE; with it set, no unsigned module enters the kernel
# even from root, with or without Secure Boot behind it.
sigenf="$(cat /sys/module/module/parameters/sig_enforce 2>/dev/null || echo '?')"
case "$sigenf" in
  Y) ok "module signatures enforced (sig_enforce=Y)" ;;
  N) warn "module signatures NOT enforced (sig_enforce=N; CONFIG_MODULE_SIG_FORCE lost?)" ;;
  *) warn "module signature enforcement unknown (no sig_enforce parameter)" ;;
esac

# Runtime tunables from /usr/lib/sysctl.d/60-tilo-hardening.conf. Reads the
# effective value, so an unapplied drop-in or an /etc override that relaxed
# something is visible rather than assumed.
check_sysctl() {
  key="$1"; want="$2"
  have="$(sysctl -n "$key" 2>/dev/null || echo '?')"
  # Some keys only CAP_SYS_ADMIN may read (net.core.bpf_jit_harden); the unit
  # snapshots those to /run/tilo-security-audit.<key> before the unprivileged audit.
  if [ "$have" = '?' ] && [ -r "/run/tilo-security-audit.$key" ]; then
    have="$(cat "/run/tilo-security-audit.$key")"
  fi
  if [ "$have" = "$want" ]; then ok "$key = $have"
  else warn "$key = $have (expected $want)"; fi
}
check_sysctl kernel.yama.ptrace_scope 3
check_sysctl kernel.kptr_restrict 2
check_sysctl kernel.dmesg_restrict 1
check_sysctl kernel.unprivileged_bpf_disabled 1
running_kernel_config="/usr/lib/modules/$(uname -r)/config"
# An option is compiled only when the config sets it (=y or =m). Kconfig writes
# "# CONFIG_X is not set" only for options visible on this architecture, so an
# option arm64 does not have at all (X86_*, removed ones like DEVKMEM) has no
# line, and is just as absent. An unreadable config proves nothing.
kconfig_off() {
  [ -r "$running_kernel_config" ] || return 1
  ! grep -Eq "^CONFIG_$1=(y|m)$" "$running_kernel_config"
}
[ -r "$running_kernel_config" ] \
  || warn "running kernel config $running_kernel_config is unreadable; kernel options unverified"
if kconfig_off KEXEC; then
  ok "kexec interfaces are not compiled"
else
  check_sysctl kernel.kexec_load_disabled 1
fi
if kconfig_off HIBERNATION; then
  ok "kernel hibernation image parser is not compiled"
else
  warn "kernel hibernation remains compiled despite zram-only swap"
fi
if kconfig_off MODULE_UNLOAD \
   && kconfig_off LIVEPATCH; then
  ok "running kernel cannot unload modules or install live patches"
else
  warn "running kernel retains module-unload or livepatch mutation paths"
fi
if kconfig_off ACPI_CUSTOM_METHOD \
   && kconfig_off ACPI_CONFIGFS \
   && kconfig_off EFI_CUSTOM_SSDT_OVERLAYS; then
  ok "running kernel accepts no runtime ACPI or SSDT injection"
else
  warn "running kernel retains a runtime ACPI or SSDT injection path"
fi
if kconfig_off DEBUG_FS; then
  ok "kernel debugfs control surface is not compiled"
else
  warn "kernel debugfs control surface remains compiled"
fi
if kconfig_off PROC_PAGE_MONITOR; then
  ok "procfs physical-page monitoring interfaces are not compiled"
else
  warn "procfs still exposes pagemap, smaps, or clear_refs interfaces"
fi
# systemd 259 requires BPF LSM plus BTF for its PID 1 filesystem restriction
# program. If either is absent systemd exits before it can start any service.
# `bpf` must also be in the live LSM stack; a compiled option alone is inert.
if grep -Fqx 'CONFIG_BPF_LSM=y' "$running_kernel_config" 2>/dev/null \
   && grep -Fqx 'CONFIG_DEBUG_INFO_BTF=y' "$running_kernel_config" 2>/dev/null; then
  ok "kernel includes BPF LSM and BTF for systemd filesystem restrictions"
else
  warn "kernel lacks BPF LSM or BTF required by systemd RestrictFileSystems="
fi
active_lsms="$(cat /sys/kernel/security/lsm 2>/dev/null || true)"
# /sys/kernel/security/lsm is comma-separated.
case ",$active_lsms," in
  *,bpf,*) ok "BPF LSM is active for systemd filesystem restrictions" ;;
  *)       warn "BPF LSM is absent from the active LSM stack: ${active_lsms:-unavailable}" ;;
esac
for interface in \
  DEVKMEM PROC_KCORE COREDUMP FW_LOADER_USER_HELPER FANOTIFY DNOTIFY \
  CUSE FUSE_PASSTHROUGH VIRTIO_FS FUSE_DAX FUSE_IO_URING \
  PM_TEST_SUSPEND PM_TRACE PM_TRACE_RTC PCIEAER_INJECT NET_DROP_MONITOR \
  DEBUG_SHIRQ MMIOTRACE X86_DECODER_SELFTEST \
  ATOMIC64_SELFTEST MEMTEST \
  PM_DEBUG PM_SLEEP_DEBUG ACPI_DEBUG FW_LOADER_DEBUG OVMF_DEBUG_LOG \
  SCSI_IPR_TRACE SCSI_IPR_DUMP DM_DEBUG MLX4_DEBUG ATH5K_DEBUG ATH6KL_DEBUG \
  IWLEGACY_DEBUG IWLWIFI_DEBUG USB_SERIAL_DEBUG DLM_DEBUG DYNAMIC_DEBUG \
  DYNAMIC_DEBUG_CORE SLUB_DEBUG DEBUG_MEMORY_INIT RCU_TRACE \
  TRACEFS_AUTOMOUNT_DEPRECATED IMA EVM \
  SECURITY_SELINUX_BOOTPARAM SECURITY_SELINUX_DEVELOP SECURITY_TOMOYO \
  SECURITY_IPE \
  PERSISTENT_KEYRINGS BIG_KEYS TRUSTED_KEYS ENCRYPTED_KEYS KEY_DH_OPERATIONS \
  KEY_NOTIFICATIONS SIGNED_PE_FILE_VERIFICATION SYSTEM_BLACKLIST_AUTH_UPDATE \
  SECURITY_SELINUX_AVC_STATS \
  CHECKPOINT_RESTORE MEM_SOFT_DIRTY \
  FW_LOADER_USER_HELPER_FALLBACK TLS CRYPTO_USER_API INET_PSP IP_VS \
  NET_PKTGEN GTP PFCP AMT BLK_DEV_NBD ISCSI_TCP \
  ISCSI_BOOT_SYSFS ISCSI_IBFT SCSI_QLA_ISCSI SCSI_BNX2_ISCSI \
  SCSI_CXGB3_ISCSI SCSI_CXGB4_ISCSI INFINIBAND_ISER BE2ISCSI QEDI FCOE \
  SCSI_ISCSI_ATTRS FCOE_FNIC QEDF SCSI_BNX2X_FCOE SCSI_CHELSIO_FCOE \
  LIBFCOE SCSI_FC_ATTRS NET_FC NVME_RDMA NVME_FC NVME_TCP NVME_TARGET NVME_HOST_AUTH NVME_AUTH \
  NVME_KEYRING BLK_DEV_RNBD_CLIENT BLK_DEV_RNBD_SERVER TARGET_CORE \
  INFINIBAND; do
  if kconfig_off "$interface"; then
    ok "unused privileged kernel interface $interface is not compiled"
  else
    warn "unused privileged kernel interface $interface remains compiled"
  fi
done
for protocol in \
  ATM CAN CAIF HAMRADIO 6LOWPAN AF_RXRPC IEEE802154 IP_DCCP IP_SCTP AF_KCM \
  LAPB L2TP MCTP MPLS NET_NSH NFC PHONET RDS SMC TIPC X25; do
  if kconfig_off "$protocol"; then
    ok "unused kernel protocol $protocol is not compiled"
  else
    warn "unused kernel protocol $protocol remains compiled"
  fi
done
check_sysctl kernel.perf_event_paranoid 3
if kconfig_off IO_URING; then
  ok "io_uring syscall and worker surface is not compiled"
else
  check_sysctl kernel.io_uring_disabled 2
fi
check_sysctl kernel.randomize_va_space 2
if kconfig_off USERFAULTFD; then
  ok "userfaultfd page-fault control surface is not compiled"
else
  check_sysctl vm.unprivileged_userfaultfd 0
fi
check_sysctl vm.mmap_min_addr 65536
check_sysctl fs.suid_dumpable 0
check_sysctl fs.protected_symlinks 1
check_sysctl fs.protected_hardlinks 1
check_sysctl fs.protected_fifos 2
check_sysctl fs.protected_regular 2
check_sysctl dev.tty.ldisc_autoload 0
check_sysctl net.core.bpf_jit_harden 2
check_sysctl net.ipv4.conf.all.accept_redirects 0
check_sysctl net.ipv4.conf.default.accept_redirects 0
check_sysctl net.ipv4.conf.all.secure_redirects 0
check_sysctl net.ipv4.conf.default.secure_redirects 0
check_sysctl net.ipv4.conf.all.send_redirects 0
check_sysctl net.ipv4.conf.default.send_redirects 0
check_sysctl net.ipv6.conf.all.accept_redirects 0
check_sysctl net.ipv6.conf.default.accept_redirects 0
check_sysctl net.ipv4.conf.all.accept_source_route 0
check_sysctl net.ipv4.conf.default.accept_source_route 0
check_sysctl net.ipv6.conf.all.accept_source_route 0
check_sysctl net.ipv6.conf.default.accept_source_route 0
check_sysctl net.ipv4.conf.all.rp_filter 2
check_sysctl net.ipv4.conf.default.rp_filter 2
check_sysctl net.ipv4.conf.all.log_martians 1
check_sysctl net.ipv4.conf.default.log_martians 1
check_sysctl net.ipv4.icmp_echo_ignore_broadcasts 1
check_sysctl net.ipv4.icmp_ignore_bogus_error_responses 1
check_sysctl net.ipv4.tcp_syncookies 1
check_sysctl net.ipv4.tcp_rfc1337 1

# Hardware shadow stacks. Every Tilo binary is marked compatible at link time,
# but glibc only switches them on for a process that also asks via
# GLIBC_TUNABLES, which is how they stay scoped to the processes proven to run
# under them. Report the CPU/kernel capability and who is actually using it.
if grep -qw user_shstk /proc/cpuinfo 2>/dev/null; then
  shstk_procs=""
  for st in /proc/[0-9]*/status; do
    grep -q '^x86_Thread_features:.*shstk' "$st" 2>/dev/null || continue
    p="${st%/status}"
    shstk_procs="$shstk_procs $(cat "$p/comm" 2>/dev/null)"
  done
  if [ -n "$shstk_procs" ]; then ok "shadow stacks active in:$shstk_procs"
  else note "CPU supports shadow stacks; no process has enabled them yet (they are opt-in per process)"; fi
else
  note "CPU/kernel report no user shadow-stack support (pre-Tiger Lake / pre-Zen 5); the ELF marking is inert here"
fi
# Secure Boot. Read firmware state directly; Tilo removes shim and mokutil, and
# its health result must not depend on a legacy command-line parser reappearing.
# Both indicators are five-byte efivarfs records: 0x6 boot-service/runtime
# attributes followed by one boolean byte. Rejecting lookalike files keeps a
# malformed mount or test fixture from impersonating firmware state.
security_efivars="${TILO_SECURITY_EFIVARS:-/sys/firmware/efi/efivars}"
efi_boolean() {
  local f="$security_efivars/$1-8be4df61-93ca-11d2-aa0d-00e098032b8c" attrs value
  if [ ! -e "$f" ]; then printf 'missing\n'; return; fi
  if [ ! -f "$f" ] || [ -L "$f" ] || [ "$(stat -c %s "$f" 2>/dev/null)" != 5 ]; then
    printf 'invalid\n'; return
  fi
  attrs="$(od -An -tx1 -N4 "$f" 2>/dev/null | tr -d ' \n')"
  value="$(od -An -tu1 -j4 -N1 "$f" 2>/dev/null | tr -d ' \n')"
  if [ "$attrs" != 06000000 ]; then printf 'invalid\n'; return; fi
  case "$value" in 0|1) printf '%s\n' "$value" ;; *) printf 'invalid\n' ;; esac
}
sb="$(efi_boolean SecureBoot)"
setup="$(efi_boolean SetupMode)"
case "$sb:$setup" in
  1:0) ok "Secure Boot enabled with firmware outside Setup Mode" ;;
  missing:missing)
    note "Secure Boot: no firmware variables (not UEFI, or no SB support) — native Tilo will not create a TPM short-PIN slot until verified boot and kernel lockdown are active (see /usr/share/doc/tilo/boot-chain.md)" ;;
  0:0) note "Secure Boot disabled; enrolled platform keys are not enforcing this boot" ;;
  0:1) note "Secure Boot disabled while firmware remains in Setup Mode" ;;
  *) warn "Secure Boot firmware state is malformed or contradictory: SecureBoot=$sb SetupMode=$setup" ;;
esac

# Owner-enrolled Secure Boot: are the keys there, and will the next deployment's
# kernel get signed? A machine with keys enrolled and no re-signing is one update
# away from not booting, so this is worth saying out loud on every boot.
secureboot_private_file_safe() {
  local metadata
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  metadata="$(stat -c '%u:%a:%h:%s' "$1" 2>/dev/null)" || return 1
  case "$metadata" in
    0:600:1:*|0:400:1:*) ;;
    *) return 1 ;;
  esac
  local size="${metadata##*:}"
  [ "$size" -gt 0 ] && [ "$size" -le 65536 ]
}
secureboot_public_file_safe() {
  local metadata
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  metadata="$(stat -c '%u:%a:%h:%s' "$1" 2>/dev/null)" || return 1
  case "$metadata" in
    0:600:1:*|0:400:1:*|0:644:1:*|0:444:1:*) ;;
    *) return 1 ;;
  esac
  local size="${metadata##*:}"
  [ "$size" -gt 0 ] && [ "$size" -le 65536 ]
}
secureboot_artifact_present() {
  [ -e "$1" ] || [ -L "$1" ]
}
secureboot_enrollment_boot_marker_safe() {
  local path="$1" metadata
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
  metadata="$(stat -c '%u:%a:%h:%s' "$path" 2>/dev/null)" || return 1
  [ "$metadata" = 0:600:1:37 ] \
    && grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' "$path"
}
secureboot_esl_matches_certificate() {
  secureboot_public_file_safe "$1" \
    && secureboot_public_file_safe "$2" \
    && command -v tilo-crypto >/dev/null 2>&1 \
    && tilo-crypto verify-exclusive-efi-signature-list "$1" "$2" >/dev/null 2>&1
}
secureboot_firmware_contains_certificate() {
  local variable="$1" certificate="$2" temporary_dir readback result=1
  temporary_dir="$(mktemp -d)" || return 1
  readback="$temporary_dir/$variable.esl"
  if secureboot_public_file_safe "$certificate" \
     && tilo-crypto firmware-read-esl /sys/firmware/efi/efivars \
          "$variable" "$readback" >/dev/null 2>&1 \
     && tilo-crypto verify-efi-signature-list "$certificate" "$readback" \
          >/dev/null 2>&1; then
    result=0
  fi
  rm -f "$readback"
  rmdir "$temporary_dir" 2>/dev/null || true
  return "$result"
}
if secureboot_artifact_present /var/lib/tilo/secureboot/db.key \
   || secureboot_artifact_present /var/lib/tilo/secureboot/db.key.cred \
   || secureboot_artifact_present /var/lib/tilo/secureboot/db.crt; then
  secureboot_dir_meta="$(stat -c '%u:%a' /var/lib/tilo/secureboot 2>/dev/null || echo invalid)"
  if [ "$secureboot_dir_meta" != 0:700 ] \
     || ! secureboot_public_file_safe /var/lib/tilo/secureboot/db.crt \
     || ! secureboot_esl_matches_certificate /var/lib/tilo/secureboot/db.crt \
          /var/lib/tilo/secureboot/db.esl \
     || { secureboot_artifact_present /var/lib/tilo/secureboot/db.key \
          && secureboot_artifact_present /var/lib/tilo/secureboot/db.key.cred; }; then
    warn "owner Secure Boot db key custody is unsafe or ambiguous"
  elif systemctl is-enabled tilo-secureboot-sign.path >/dev/null 2>&1 \
     && systemctl is-enabled tilo-secureboot-sign.timer >/dev/null 2>&1 \
     && systemctl is-enabled tilo-secureboot-sign-shutdown.service >/dev/null 2>&1; then
    if secureboot_private_file_safe /var/lib/tilo/secureboot/db.key.cred; then
      ok "owner Secure Boot db key TPM-sealed, re-signing armed"
    elif secureboot_private_file_safe /var/lib/tilo/secureboot/db.key; then
      ok "owner Secure Boot plaintext db key present, re-signing armed"
    else
      warn "owner Secure Boot db key artifact has unsafe ownership, mode, links, or size"
    fi
  else
    warn "owner Secure Boot keys present but re-signing is NOT armed — the next update stages an unsigned kernel"
  fi
else
  note "no owner Secure Boot keys (tilo-secureboot generate-keys)"
fi

if secureboot_artifact_present /var/lib/tilo/secureboot/db.crt; then
  if secureboot_firmware_contains_certificate db /var/lib/tilo/secureboot/db.crt \
     && secureboot_firmware_contains_certificate KEK /var/lib/tilo/secureboot/KEK.crt \
     && secureboot_firmware_contains_certificate PK /var/lib/tilo/secureboot/PK.crt; then
    ok "live firmware db/KEK/PK contain the retained owner trust chain"
  else
    warn "live firmware db/KEK/PK no longer contain the retained owner trust chain"
  fi
fi

pk_present=0
kek_present=0
retired_present=0
secureboot_artifact_present /var/lib/tilo/secureboot/PK.key && pk_present=1
secureboot_artifact_present /var/lib/tilo/secureboot/KEK.key && kek_present=1
secureboot_artifact_present /var/lib/tilo/secureboot/enrollment-keys-retired \
  && retired_present=1
if [ "$pk_present" -eq 1 ] || [ "$kek_present" -eq 1 ]; then
  if [ "$pk_present" -eq 1 ] && [ "$kek_present" -eq 1 ] \
     && [ "$retired_present" -eq 0 ] \
     && secureboot_private_file_safe /var/lib/tilo/secureboot/PK.key \
     && secureboot_private_file_safe /var/lib/tilo/secureboot/KEK.key \
     && secureboot_esl_matches_certificate /var/lib/tilo/secureboot/PK.crt \
          /var/lib/tilo/secureboot/PK.esl \
     && secureboot_esl_matches_certificate /var/lib/tilo/secureboot/KEK.crt \
          /var/lib/tilo/secureboot/KEK.esl \
     && tilo-crypto key-matches-certificate /var/lib/tilo/secureboot/PK.key \
          /var/lib/tilo/secureboot/PK.crt >/dev/null 2>&1 \
     && tilo-crypto key-matches-certificate /var/lib/tilo/secureboot/KEK.key \
          /var/lib/tilo/secureboot/KEK.crt >/dev/null 2>&1; then
    note "Secure Boot PK/KEK enrollment authority remains online; retire it after verified enrollment and offline backup"
  else
    warn "Secure Boot PK/KEK retirement state is incomplete, unsafe, or ambiguous"
  fi
  enrollment_boot_marker=/var/lib/tilo/secureboot/enrollment-boot-id
  if secureboot_artifact_present "$enrollment_boot_marker"; then
    if ! secureboot_enrollment_boot_marker_safe "$enrollment_boot_marker"; then
      warn "Secure Boot enrollment boot identity is unsafe or malformed"
    elif [ "$(cat "$enrollment_boot_marker")" = "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" ]; then
      note "Secure Boot enrollment occurred this boot; reboot before retiring PK/KEK"
    elif [ "$sb:$setup" = 1:0 ]; then
      ok "Secure Boot enrollment crossed a verified reboot boundary"
    else
      note "Secure Boot enrollment crossed a reboot, but firmware enforcement is not active"
    fi
  fi
elif [ "$retired_present" -eq 1 ]; then
  if secureboot_private_file_safe /var/lib/tilo/secureboot/enrollment-keys-retired \
     && secureboot_esl_matches_certificate /var/lib/tilo/secureboot/PK.crt \
          /var/lib/tilo/secureboot/PK.esl \
     && secureboot_esl_matches_certificate /var/lib/tilo/secureboot/KEK.crt \
          /var/lib/tilo/secureboot/KEK.esl; then
    ok "Secure Boot PK/KEK online enrollment authority is retired"
  else
    warn "Secure Boot retired enrollment authority has an unsafe marker or mismatched public artifacts"
  fi
fi

if [ -x /usr/libexec/tilo-verified-boot-install-preflight ]; then
  if /usr/libexec/tilo-verified-boot-install-preflight >/dev/null 2>&1; then
    ok "TPM short-PIN authority: exact target UKI and generation PCR11 policy verified"
  else
    note "TPM short-PIN authority is unavailable for this boot; installation uses an independent strong passphrase"
  fi
else
  note "no TPM short-PIN authority verifier is installed; installation uses an independent strong passphrase"
fi

# Root filesystem encryption. Walk from the physical root (/sysroot; / is
# composefs, which no block device backs) to its backing device by number and
# ask whether a dm-crypt layer is under it.
rootsrc="$(findmnt -nro SOURCE /sysroot 2>/dev/null | sed 's/\[.*//' | head -1)"
rootdev="$(findmnt -nro MAJ:MIN /sysroot 2>/dev/null | head -1)"
if [ -z "$rootdev" ]; then
  rootsrc="$(findmnt -nro SOURCE / 2>/dev/null | sed 's/\[.*//')"
  rootdev="$(findmnt -nro MAJ:MIN / 2>/dev/null | head -1)"
fi
roottype="$(lsblk -nro MAJ:MIN,TYPE 2>/dev/null | awk -v d="$rootdev" '$1==d {print $2; exit}')"
case "${roottype:-}" in
  crypt) ok "root filesystem is encrypted ($rootsrc)" ;;
  "")    note "root filesystem is not backed by a block device (${rootsrc:-unknown}); encryption state undetermined" ;;
  *)     note "root filesystem is NOT encrypted ($rootsrc, $roottype) — install with --encrypt to change that" ;;
esac

# Long-running services under their own users see only their own processes
# (ProtectProc=invisible). /proc is not remounted hidepid globally: that hides
# PID 1 from every unprivileged process, which breaks libsystemd's unit
# lookups (the AT-SPI bus cannot start); secret holders are non-dumpable.
for unit in tilo-relay.service tilo-fs-replica.service tilo-local-model.service; do
  if [ "$(systemctl show -p ProtectProc --value "$unit" 2>/dev/null)" = invisible ]; then
    ok "$unit sees only its own processes (ProtectProc=invisible)"
  else
    warn "$unit can see other users' processes (ProtectProc is not invisible)"
  fi
done

# Hardened userspace allocator (scudo) on the base daemons. Query systemd's
# effective unit environment rather than acquiring ptrace authority merely to
# inspect a differently-owned process map.
fsenv="$(systemctl show -p Environment --value fs.service 2>/dev/null || true)"
if case " $fsenv " in
     *' LD_PRELOAD=/usr/lib/tilo/libclang_rt.scudo_standalone.so '*) true ;;
     *) false ;;
   esac \
   && [ -r /usr/lib/tilo/libclang_rt.scudo_standalone.so ]; then
  ok "scudo hardened allocator configured for fs.service"
else
  warn "scudo allocator NOT configured for fs.service"
fi

# fs daemon SELinux confinement (its own domain, not unconfined_service_t)
fsctx="$(ps -eo label,comm 2>/dev/null | awk '$2=="fs"{print $1; exit}')"
case "$fsctx" in
  *tilo_fs_t*) ok "fs.service confined: $fsctx" ;;
  *unconfined_service_t*) warn "fs.service is unconfined_service_t (tilo_fs_t not applied)" ;;
  "" ) note "fs.service not running; SELinux domain unknown" ;;
  *) note "fs.service domain: $fsctx" ;;
esac

# Image signature enforcement (verify-before-update). Parsed, not grepped:
# tilo-image-policy-check proves each Tilo image scope itself requires a
# Rekor-logged sigstore signature from the installed release trust (the pinned
# key, or the offline root once /usr/share/tilo/release/root.crt exists), so a
# signed sibling scope cannot stand in for a weakened Tilo scope, and an
# unreadable or malformed policy fails rather than passes.
policy=/etc/containers/policy.json
image_policy_check=/usr/libexec/tilo-image-policy-check

legacy_crypto_tools=""
for tool in openssl sbsign sbverify efi-updatevar cert-to-efi-sig-list mokutil pesign efikeygen certutil pk12util; do
  command -v "$tool" >/dev/null 2>&1 && legacy_crypto_tools="$legacy_crypto_tools $tool"
done
if [ -z "$legacy_crypto_tools" ]; then
  ok "OpenSSL and legacy EFI/NSS signing CLIs are absent"
else
  warn "unapproved cryptographic command-line tools remain:$legacy_crypto_tools"
fi

for tool in p11tool gnutls-cli; do
  if command -v "$tool" >/dev/null 2>&1; then
    if installed gnutls-utils swtpm-tools; then
      note "Fedora gnutls-utils companion retained with required TPM certtool: $tool"
    else
      warn "unapproved cryptographic command-line tool remains: $tool"
    fi
  fi
done

if ! policy_report="$("$image_policy_check" "$policy" 2>&1)"; then
  warn "Tilo image signature policy does not require the pinned signature: ${policy_report:-$image_policy_check produced no verdict}"
elif [ ! -s /usr/share/tilo/release/rekor.pub ]; then
  warn "Tilo image signature policy requires a transparency-log entry, but /usr/share/tilo/release/rekor.pub is missing or empty"
elif [ -e /usr/share/tilo/release/root.crt ] && [ ! -s /usr/share/tilo/release/root.crt ]; then
  warn "Tilo image signature policy chains to /usr/share/tilo/release/root.crt, but that root certificate is empty"
elif [ ! -e /usr/share/tilo/release/root.crt ] && [ ! -s /usr/share/tilo/cosign.pub ]; then
  warn "Tilo image signature policy pins /usr/share/tilo/cosign.pub, but that verification key is missing or empty"
else
  ok "container signature policy pins signed Tilo images to the installed release trust: ${policy_report#*: }"
fi

if [ -e /var/lib/tilo/image-trust/required ]; then
  trust_meta="$(stat -c '%u:%a' /var/lib/tilo/image-trust 2>/dev/null || echo invalid)"
  if [ "$trust_meta" = 0:700 ] \
     && [ -s /var/lib/tilo/image-trust/root.pub ] \
     && [ -s /var/lib/tilo/image-trust/revocations.bin ] \
     && [ -s /var/lib/tilo/image-trust/endorsement.bin ] \
     && [ -s /var/lib/tilo/image-trust/time.state ] \
     && systemctl cat bootc-fetch-apply-updates.service 2>/dev/null \
          | grep -Fq 'ExecStart=/usr/libexec/tilo-verified-update --quiet'; then
    ok "owner identity image-endorsement gate is armed for automatic updates"
  else
    warn "owner image trust is required but its root-owned artifacts or update gate are incomplete"
  fi
else
  note "owner identity image-endorsement gate is not enabled; official Cosign policy remains mandatory"
fi

# systemd-homed available (per-user encrypted homes; homed users get a
# LUKS-backed home unlocked at login). The default account is traditional;
# additional users created with `homectl` are per-user-encrypted.
if systemctl is-active systemd-homed >/dev/null 2>&1; then
  ok "systemd-homed active (per-user encrypted homes available)"
else
  note "systemd-homed not active (per-user encrypted homes unavailable)"
fi

# Display server is Wayland (no X11 keylogging surface)
note "display server: Wayland (compositor: shell --backend drm)"

# Unprivileged userns is intentionally ALLOWED — bubblewrap creates one before
# it can drop anything, so switching them off would delete the app sandbox
# rather than harden it. See the header of
# /usr/lib/sysctl.d/60-tilo-hardening.conf. Checked, not just noted: a zero here
# means the sandbox cannot start.
maxns="$(sysctl -n user.max_user_namespaces 2>/dev/null || echo '?')"
if [ "$maxns" = "0" ]; then
  warn "user.max_user_namespaces=0 — the app sandbox CANNOT start; something 'hardened' this"
else
  ok "unprivileged user namespaces available (bwrap requires them); max=$maxns"
fi

echo "=== end Tilo security audit ==="
if [ "$failures" -ne 0 ]; then
  echo "Tilo security audit failed: $failures required invariant(s) are inactive" >&2
  exit 1
fi
exit 0
