#!/usr/bin/bash
# Confirm the running OS generation, and only then raise the rollback floor.
#
# Runs some time after boot, not at update time. The ordering is the whole point:
# raising the floor when an update is *installed* destroys the ability to fall
# back from it before anyone knows whether it boots. So the floor moves here,
# after the machine has been up long enough and healthy enough to be believed.
#
# Exits 0 whenever there is legitimately nothing to do — no encryption, no
# enrollment, no generation number — so a machine that does not use this feature
# does not accumulate failed units. It exits non-zero only when something is
# actually wrong, because that is worth a journal entry someone will look at.
set -uo pipefail
# shellcheck source=/dev/null
. /usr/libexec/tilo-rollback-common

DEV="$(rollback_luks_device)"
if [ -z "$DEV" ]; then
  log "root is not on LUKS — nothing to confirm"
  exit 0
fi

GEN="$(rollback_running_generation)"
if [ -z "$GEN" ]; then
  # Without a generation number on the sealed command line there is nothing to
  # bind the floor to, and inventing one would be worse than doing nothing.
  log "no tilo.generation= on the kernel command line — rollback protection is not in use"
  exit 0
fi

if [ ! -e /dev/tpmrm0 ] && [ ! -e /dev/tpm0 ]; then
  log "no TPM on this machine — rollback binding is unavailable by design"
  exit 0
fi

if ! /usr/libexec/tilo/tilo-rollback status --device "$DEV" --json 2>/dev/null | grep -q '"counter":[0-9]'; then
  log "no rollback enrollment on $DEV yet — run 'tilo-rollback enroll' first"
  exit 0
fi

rollback_system_is_healthy || exit 0

log "confirming generation $GEN on $DEV"
# --unattended: after a reboot nothing here knows the recovery key, so the
# independent-unlock-path check falls back to "the keyslots that were independent
# at enrollment are still present". The authorisation for the keyslot changes is
# the secret this boot actually unlocked with, which `tilo-rollback unlock` left in
# /run — a better proof than a fresh unseal, since the machine booted on it.
exec /usr/libexec/tilo/tilo-rollback confirm --device "$DEV" --generation "$GEN" --unattended
