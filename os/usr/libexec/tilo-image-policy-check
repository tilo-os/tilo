#!/usr/bin/python3
"""Prove that containers-policy.json requires Tilo's pinned Cosign signature.

Usage: tilo-image-policy-check [POLICY]   (default /etc/containers/policy.json)

Exits 0 only when the parsed policy makes every Tilo-published image scope
require a sigstore signature from /usr/share/tilo/cosign.pub. Anything this
check cannot prove -- an unreadable file, malformed JSON, a duplicate key, an
unknown requirement field -- is a failure, never a pass. The boot security
audit (tilo-security-audit) runs it; it only reads, never repairs.

The rules mirror containers-policy.json(5): requirements in a scope's list are
ANDed, and the most specific docker scope wins. So every required scope must
exist and hold only pinned-key sigstoreSigned requirements, and no scope at or
beneath a Tilo namespace (a tag, a digest, a sibling repository, the namespace
itself) may accept anything less than that or an outright reject.

The repositories Tilo publishes but a machine must never run unsigned -- the
legacy guest and the development and CI images -- are checked by their
effective rule, not by their own scope's presence: removing a repository's
scope hands it to the nearest namespace scope or the default, and a default of
insecureAcceptAnything would then accept it unsigned.
"""

import json
import sys

DEFAULT_POLICY = "/etc/containers/policy.json"
PINNED_KEY = "/usr/share/tilo/cosign.pub"
# The scopes Tilo OS images are pulled and updated from.
REQUIRED_SCOPES = ("registry.tilo.so/tilo/tilo", "code.tilo.so/tilo/tilo")
# Every scope under these namespaces is Tilo-published: it may be refused
# outright, or it must require the pinned signature.
TILO_NAMESPACES = ("registry.tilo.so/tilo/", "code.tilo.so/tilo/")
# Broader scopes that would also govern a Tilo repository with no scope of its
# own. Unrelated registries keep the policy's default.
TILO_NAMESPACE_ROOTS = ("registry.tilo.so", "registry.tilo.so/tilo", "code.tilo.so", "code.tilo.so/tilo")
# Tilo repositories whose effective rule must be the pinned signature or a
# reject, whichever scope supplies it.
GUARDED_REPOSITORIES = ("registry.tilo.so/tilo/legacy-guest",) + tuple(
    f"{registry}/tilo/{name}"
    for registry in ("registry.tilo.so", "code.tilo.so")
    for name in ("tilo-vm", "tilo-ci", "tilo-dev")
)
# Identities that bind a signature to the image's own repository. remapIdentity,
# exactReference and exactRepository can accept a signature made for some other
# image, so they do not prove the requirement.
ACCEPTED_IDENTITIES = frozenset({"matchRepository", "matchExact", "matchRepoDigestOrExact"})
SIGNED_FIELDS = frozenset({"type", "keyPath", "signedIdentity"})


class PolicyError(Exception):
    pass


def reject_duplicates(pairs):
    seen = {}
    for key, value in pairs:
        if key in seen:
            raise PolicyError(f"duplicate key {key!r}; the effective rule is ambiguous")
        seen[key] = value
    return seen


def signed_requirement_problem(requirement):
    """Return why a requirement is not the pinned sigstore signature, or None."""
    if not isinstance(requirement, dict):
        return "requirement is not an object"
    kind = requirement.get("type")
    if kind != "sigstoreSigned":
        return f"requirement type is {kind!r}, not 'sigstoreSigned'"
    extra = sorted(set(requirement) - SIGNED_FIELDS)
    if extra:
        return f"sigstoreSigned carries unexpected fields {extra}"
    if requirement.get("keyPath") != PINNED_KEY:
        return f"keyPath is {requirement.get('keyPath')!r}, not {PINNED_KEY!r}"
    identity = requirement.get("signedIdentity")
    if not isinstance(identity, dict) or set(identity) != {"type"}:
        return "signedIdentity must be an object naming only its type"
    if identity["type"] not in ACCEPTED_IDENTITIES:
        return f"signedIdentity type {identity['type']!r} does not bind the image's own repository"
    return None


def scope_problem(requirements, *, allow_reject):
    if not isinstance(requirements, list) or not requirements:
        return "requirement list is missing or empty"
    if allow_reject and all(
        isinstance(item, dict) and item == {"type": "reject"} for item in requirements
    ):
        return None
    for requirement in requirements:
        problem = signed_requirement_problem(requirement)
        if problem:
            return problem
    return None


def check(text):
    try:
        policy = json.loads(text, object_pairs_hook=reject_duplicates)
    except ValueError as error:
        raise PolicyError(f"policy is not valid JSON: {error}") from error
    if not isinstance(policy, dict):
        raise PolicyError("policy is not a JSON object")
    transports = policy.get("transports")
    if not isinstance(transports, dict):
        raise PolicyError("policy has no transports object")
    docker = transports.get("docker")
    if not isinstance(docker, dict):
        raise PolicyError("policy has no transports.docker object")
    for scope in REQUIRED_SCOPES:
        if scope not in docker:
            raise PolicyError(f"{scope}: no docker scope, so the default rule applies")
        problem = scope_problem(docker[scope], allow_reject=False)
        if problem:
            raise PolicyError(f"{scope}: {problem}")
    for scope, requirements in docker.items():
        if scope in REQUIRED_SCOPES:
            continue
        if not (scope.startswith(TILO_NAMESPACES) or scope in TILO_NAMESPACE_ROOTS):
            continue
        problem = scope_problem(requirements, allow_reject=True)
        if problem:
            raise PolicyError(f"{scope}: {problem}")
    for repository in GUARDED_REPOSITORIES:
        scope, requirements = effective_rule(policy, docker, repository)
        problem = scope_problem(requirements, allow_reject=True)
        if problem:
            raise PolicyError(f"{repository}: governed by {scope}: {problem}")


def effective_rule(policy, docker, repository):
    """The scope name and requirements containers/image applies to REPOSITORY.

    The repository's own scope, else the nearest enclosing namespace scope,
    else the host's, else the policy default.
    """
    candidate = repository
    while True:
        if candidate in docker:
            return candidate, docker[candidate]
        if "/" not in candidate:
            break
        candidate = candidate.rsplit("/", 1)[0]
    return "the default rule", policy.get("default")


def main(argv):
    if len(argv) > 2:
        print("usage: tilo-image-policy-check [POLICY]", file=sys.stderr)
        return 2
    path = argv[1] if len(argv) == 2 else DEFAULT_POLICY
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
        check(text)
    except (OSError, UnicodeDecodeError) as error:
        print(f"{path}: cannot read policy: {error}")
        return 1
    except PolicyError as error:
        print(f"{path}: {error}")
        return 1
    print(f"{path}: Tilo image scopes require the {PINNED_KEY} sigstore signature")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
