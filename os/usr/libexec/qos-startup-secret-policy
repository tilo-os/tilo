#!/usr/bin/env bash
# Validate the human-entered LUKS startup secret. The secret is read from one
# stdin line so it never appears in argv or a process listing.
set -euo pipefail

IFS= read -r secret || true

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

# Leading/trailing whitespace is almost invisible in a password field and is
# especially easy to omit at the initramfs prompt.
case "$secret" in
  ''|[[:space:]]*|*[[:space:]])
    fail "disk passphrase cannot begin or end with whitespace" ;;
esac

[ "${#secret}" -ge 15 ] \
  || fail "disk passphrase must contain at least 15 characters"

lower="${secret,,}"
# Block the small set of extremely common bases even when padded with digits or
# punctuation. Length alone otherwise accepts password1234 and qwerty123456.
if [[ "$lower" =~ ^(password|qwerty|letmein|welcome|administrator|admin|quickdesktop|quickdesk|qos)[^[:alpha:]]*$ ]]; then
  fail "disk passphrase is too easy to guess; use several unrelated words"
fi

# Long numeric secrets can be defensible, but twelve decimal digits have only
# about 40 bits before human choice bias and are not suitable without TPM rate
# limiting.
if [[ "$secret" =~ ^[0-9]+$ ]] && [ "${#secret}" -lt 20 ]; then
  fail "numeric disk passphrases must contain at least 20 digits"
fi

# Catch repeated/pattern padding such as aaaaaaaaaaaa and abcabcabcabc. This is
# deliberately a narrow rejection rule rather than a brittle composition rule:
# Diceware-style phrases remain valid without requiring arbitrary punctuation.
unique="$(printf '%s' "$secret" | fold -w1 | LC_ALL=C sort -u | wc -l)"
unique="${unique//[[:space:]]/}"
[ "${unique:-0}" -ge 5 ] \
  || fail "disk passphrase is too repetitive; use several unrelated words"

for period in 1 2 3 4; do
  [ $(( ${#secret} % period )) -eq 0 ] || continue
  unit="${secret:0:period}"
  repeated=""
  for ((i=0; i<${#secret}/period; i++)); do repeated+="$unit"; done
  [ "$repeated" != "$secret" ] \
    || fail "disk passphrase is a repeated pattern; use several unrelated words"
done

exit 0
