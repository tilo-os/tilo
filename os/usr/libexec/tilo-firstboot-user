#!/bin/bash
# tilo-firstboot-user — turn the installer-seeded credential file into a real
# account on the installed system's first boot.
#
# The custom installer cannot create users at install time (bootc install
# makes no users), so it drops `<name>:<sha512-crypt-hash>` into the new
# deployment's /etc/tilo/install-user.conf. On first boot, tilo-firstboot-user.service
# runs this once: it creates the user (in wheel for sudo) locked and expired,
# installs the supplied pre-hashed password through stdin,
# then SHREDS the file so the hash does not linger or appear in process argv.
set -euo pipefail

# This advertises the implemented seed API without creating an account.
home_seed_capability() {
  [ "$#" -eq 0 ] || return 2
  printf '{"schema":1,"seed_protocol":1}\n'
}

valid_sha512_crypt() {
  local candidate="$1" rounds

  # crypt(5) SHA-512 hashes have an optional rounds field, a 1-16 byte
  # crypt-base64 salt, and an exact 86 byte crypt-base64 digest. Keep this
  # parser strict: this value is installed directly through chpasswd --encrypted.
  if [[ "$candidate" =~ ^\$6\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}$ ]]; then
    return 0
  fi
  if [[ "$candidate" =~ ^\$6\$rounds=([1-9][0-9]{3,8})\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}$ ]]; then
    rounds="${BASH_REMATCH[1]}"
    (( 10#$rounds >= 1000 && 10#$rounds <= 999999999 ))
    return
  fi
  return 1
}

# greetd must never turn an unfulfilled first-boot handoff into USER_UNKNOWN
# retries. This check also covers a lost credential seed or a skipped oneshot.
check_firstboot_session_user() {
  local config="$1" line initial=0 seen=0 user=""
  [ -f "$config" ] && [ ! -L "$config" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^[[:space:]]*\[initial_session\][[:space:]]*$ ]]; then
      initial=1
      seen=1
    elif [[ "$line" =~ ^[[:space:]]*\[ ]]; then
      initial=0
    elif [ "$initial" -eq 1 ] \
      && [[ "$line" =~ ^[[:space:]]*user[[:space:]]*=[[:space:]]*\"([a-z_][a-z0-9_-]{0,31})\"[[:space:]]*$ ]]; then
      user="${BASH_REMATCH[1]}"
    fi
  done < "$config"
  [ "$seen" -eq 1 ] || return 0
  if [ -z "$user" ] || ! getent passwd "$user" >/dev/null; then
    echo "tilo-firstboot-user: initial graphical session account is unavailable; refusing to start greetd" >&2
    return 1
  fi
}

# Unit tests source this file to exercise the exact production parser without
# running account-management side effects.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

if [ "${1:-}" = --check-session ]; then
  check_firstboot_session_user /etc/greetd/config.toml
  exit $?
fi

CONF=/etc/tilo/install-user.conf
FULL_NAME_CONF=/etc/tilo/install-user-full-name
[ -e "$CONF" ] || [ -L "$CONF" ] || exit 0

valid_seed_file() {
  path="$1" max_bytes="$2"
  [ -f "$path" ] && [ ! -L "$path" ] \
    && [ "$(stat -c '%u:%a:%h' -- "$path" 2>/dev/null)" = '0:600:1' ] \
    && [ "$(stat -c '%s' -- "$path" 2>/dev/null)" -le "$max_bytes" ]
}

# These bytes cross from installer-controlled writable /etc into root account
# management. Revalidate the handoff independently; never follow or shred a
# link/hardlink supplied in place of the one-use credential.
if ! valid_seed_file "$CONF" 1024; then
  echo "tilo-firstboot-user: refusing unsafe credential seed $CONF" >&2
  rm -f -- "$CONF"
  exit 1
fi
if { [ -e "$FULL_NAME_CONF" ] || [ -L "$FULL_NAME_CONF" ]; } \
  && ! valid_seed_file "$FULL_NAME_CONF" 256; then
  echo "tilo-firstboot-user: refusing unsafe full-name seed $FULL_NAME_CONF" >&2
  rm -f -- "$FULL_NAME_CONF"
  shred -u -- "$CONF" 2>/dev/null || rm -f -- "$CONF"
  exit 1
fi

IFS= read -r line < "$CONF" || true
user="${line%%:*}"
hash="${line#*:}"
full_name=""
if [ -f "$FULL_NAME_CONF" ]; then
  IFS= read -r full_name < "$FULL_NAME_CONF" || true
fi

case "$user" in
  ''|*[!a-z0-9_-]*|root|bin|daemon|adm|lp|sync|shutdown|halt|mail|operator|games|ftp|nobody|dbus|polkitd|sshd|chrony|tss|greetd|tilo)
    valid_user=0 ;;
  [a-z_]* ) valid_user=1 ;;
  *) valid_user=0 ;;
esac
[ "${#user}" -le 32 ] || valid_user=0
if valid_sha512_crypt "$hash"; then
  valid_hash=1
else
  valid_hash=0
fi

if [ "$valid_user" -ne 1 ] || [ "$valid_hash" -ne 1 ]; then
  echo "tilo-firstboot-user: malformed $CONF (expected name:hash)" >&2
  # Don't leave a bad credential file lying around.
  shred -u -- "$CONF" 2>/dev/null || rm -f -- "$CONF"
  exit 1
fi

# The installer copies the enrolled device key before this machine's
# `tilo-identity` group exists, so the stored group id can be wrong. The
# session reads that key as a member of this machine's group.
repair_enrolled_device_key() {
  local key key_dir key_meta key_owner key_mode key_links
  key=/var/lib/tilo/device-private/keypair.bin
  if [ -e "$key" ] || [ -L "$key" ]; then
    [ -f "$key" ] && [ ! -L "$key" ] || return 1
    key_dir="${key%/*}"
    [ -d "$key_dir" ] && [ ! -L "$key_dir" ] || return 1
    case "$(stat -c '%u:%a' -- "$key_dir")" in
      0:700|0:750|0:2700|0:2750) ;;
      *) return 1 ;;
    esac
    key_meta="$(stat -c '%u:%a:%h' -- "$key")" || return 1
    IFS=: read -r key_owner key_mode key_links <<<"$key_meta"
    [ "$key_owner" = 0 ] && [ "$key_links" = 1 ] \
      && { [ "$key_mode" = 600 ] || [ "$key_mode" = 640 ]; } || return 1
    chgrp tilo-identity "$key_dir"
    chmod 2750 "$key_dir"
    chgrp tilo-identity "$key"
    chmod 0640 "$key"
  fi
}

# The private intent's random locked shadow value proves transaction ownership.
TRANSACTION=/etc/tilo/install-user.transaction
FILES_HELPER="$(dirname -- "${BASH_SOURCE[0]}")/tilo-firstboot-files"
retry=0
lock_value=""
if [ -e "$TRANSACTION" ] || [ -L "$TRANSACTION" ]; then
  valid_seed_file "$TRANSACTION" 1024 || exit 1
  IFS=: read -r transaction_user lock_value < "$TRANSACTION" || true
  [ "$transaction_user" = "$user" ] \
    && [[ "$lock_value" =~ ^!tilo-firstboot-[a-f0-9]{32}$ ]] || exit 1
  if id "$user" >/dev/null 2>&1; then
    shadow="$(getent shadow "$user")" || exit 1
    shadow="${shadow#*:}"
    shadow="${shadow%%:*}"
    # A crash after release may leave the intent. Expire before retry: a
    # password lock alone does not block SSH public-key authentication.
    [ "$shadow" = "$lock_value" ] || [ "$shadow" = "$hash" ] || exit 1
    chage -E 1970-01-02 "$user"
    printf '%s:%s\n' "$user" "$lock_value" | chpasswd --encrypted
    retry=1
  fi
elif id "$user" >/dev/null 2>&1; then
  echo "tilo-firstboot-user: refusing to modify pre-existing account '$user'; preserving credential seed" >&2
  exit 1
fi

# Writable shared originals depend on preserving their original Linux UID.
# The strict root helper validates the private plan, regular-account policy and
# both username/UID availability before any account creation side effect.
uid_args=()
online_accounts=0
if [ -e /etc/tilo/online-accounts ] || [ -L /etc/tilo/online-accounts ]; then
  online_accounts=1
  uid_args=(-u 1000)
fi
if [ "$retry" -eq 0 ] && { [ -e /var/lib/tilo/migration-plan.json ] || [ -L /var/lib/tilo/migration-plan.json ]; }; then
  required_uid="$(/usr/libexec/tilo-staging-handoff required-user-id --username "$user")" || {
    echo "tilo-firstboot-user: migration ownership validation failed; preserving credential seed" >&2
    exit 1
  }
  if [ -n "$required_uid" ]; then
    if [[ ! "$required_uid" =~ ^[1-9][0-9]{0,9}$ ]]; then
      echo "tilo-firstboot-user: migration user-ID response is malformed" >&2
      exit 1
    fi
    if [ "$online_accounts" -eq 1 ] && [ "$required_uid" != 1000 ]; then
      echo "tilo-firstboot-user: migration UID conflicts with selected account destination" >&2
      exit 1
    fi
    uid_args=(-u "$required_uid")
  fi
fi

if [ -z "$lock_value" ]; then
  lock_value="!tilo-firstboot-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  # Do not replace an unexpected intent; create it before useradd can succeed.
  printf '%s:%s\n' "$user" "$lock_value" | "$FILES_HELPER" intent "$TRANSACTION"
fi
# Persist both the intent and its directory entry before account creation.
# A power loss must not leave an account with no durable ownership witness.
sync -f -- "$TRANSACTION"

native_home="/var/home/$user"
if [ "$retry" -eq 0 ]; then
  # `tilo-identity` is read access to the machine's device key. The
  # compositor runs in this user's session and presents the device
  # identity on the network — the same identity fs.service presents as
  # root — so without this the session has no network identity at all.
  #
  # `video` is write access to the backlight: 90-tilo-backlight.rules
  # hands the group `/sys/class/backlight/*/brightness`, which is what
  # the brightness keys and the quick-settings slider write. Without it
  # brightness silently does nothing.
  #
  # The setup handoff may already have seeded this home with the enrolled
  # identity. `useradd -m` refuses an existing home, which would leave the
  # account uncreated and the device key unreadable.
  seeded_home=""
  for candidate in "$native_home" "/home/$user"; do
    if [ -d "$candidate" ] && [ ! -L "$candidate" ]; then
      seeded_home="$candidate"
      break
    fi
  done
  if [ -n "$seeded_home" ]; then
    if [ -n "$full_name" ]; then
      useradd "${uid_args[@]}" -M -e 1970-01-02 -d "$seeded_home" -p "$lock_value" -c "$full_name" -G wheel,tilo-identity,video "$user"
    else
      useradd "${uid_args[@]}" -M -e 1970-01-02 -d "$seeded_home" -p "$lock_value" -G wheel,tilo-identity,video "$user"
    fi
  elif [ -n "$full_name" ]; then
    useradd "${uid_args[@]}" -M -e 1970-01-02 -d "$native_home" -p "$lock_value" -c "$full_name" -G wheel,tilo-identity,video "$user"
  else
    useradd "${uid_args[@]}" -M -e 1970-01-02 -d "$native_home" -p "$lock_value" -G wheel,tilo-identity,video "$user"
  fi
fi

# Provision the exact passwd home even after useradd committed only the account.
# Defaults remain the attesting helper's responsibility, never an untracked copy.
passwd_entry="$(getent passwd "$user")" || exit 1
IFS=: read -r passwd_user _ account_uid account_gid _ account_home _ <<< "$passwd_entry"
[ "$passwd_user" = "$user" ] && [[ "$account_uid:$account_gid" =~ ^[0-9]+:[0-9]+$ ]] || exit 1
case "$account_home" in
  "/home/$user"|"/var/home/$user") ;;
  *) echo "tilo-firstboot-user: refusing unexpected account home" >&2; exit 1 ;;
esac
"$FILES_HELPER" home "$account_home" "$account_uid" "$account_gid"

seed_helper=/etc/tilo/firstboot-home-seeds
if [ ! -e "$seed_helper" ] && [ ! -L "$seed_helper" ]; then
  seed_helper=/usr/libexec/tilo-firstboot-home-seeds
fi
if [ ! -f "$seed_helper" ] || [ -L "$seed_helper" ] || [ ! -x "$seed_helper" ] \
    || ! "$seed_helper" "$user"; then
  echo "tilo-firstboot-user: home defaults could not be attested; account remains locked" >&2
  exit 1
fi

# Import as the actual destination user, while expiration still prevents every
# login path. Root only opens the private transport and records completion.
if [ "$online_accounts" -eq 1 ]; then
  [ "$account_uid" = 1000 ] || exit 1
  if ! "$seed_helper" --accounts-adopt "$user"; then
    echo "tilo-firstboot-user: selected account import failed; account remains locked" >&2
    exit 1
  fi
fi

repair_enrolled_device_key

# This only delivers bounded metadata. Source mounts, data copies and final
# promotion require an explicit first-login migration action by this account.
if [ -f /var/lib/tilo/migration-plan.json ]; then
  if ! /usr/libexec/tilo-staging-handoff deliver-user-plan --username "$user"; then
    # Do not permit a first login that silently loses reviewed migration.
    # Preserve both root metadata and the private credential seed for repair.
    echo "tilo-firstboot-user: migration metadata delivery failed; account remains locked" >&2
    exit 1
  fi
fi

# Keep prepared setup encrypted through firstboot. Only the actual account's
# explicit import action may authenticate and adopt its contents later.
if [ -e /var/lib/tilo/prepared-setup ] || [ -L /var/lib/tilo/prepared-setup ]; then
  if ! /etc/tilo/prepared-setup-transport deliver-user --username "$user"; then
    echo "tilo-firstboot-user: encrypted prepared setup delivery failed; account remains locked" >&2
    exit 1
  fi
fi

# Selected encrypted data changes custody without a second archive allocation.
# Failure retains the root metadata and account seed, as for prepared setup.
if [ -e /var/lib/tilo/prepared-home ] || [ -L /var/lib/tilo/prepared-home ] \
    || [ -e /var/lib/tilo/prepared-applications ] || [ -L /var/lib/tilo/prepared-applications ] \
    || [ -e /var/lib/tilo/prepared-browser ] || [ -L /var/lib/tilo/prepared-browser ]; then
  if ! /etc/tilo/prepared-setup-transport deliver-home-user --username "$user"; then
    echo "tilo-firstboot-user: portable data custody delivery failed; account remains locked" >&2
    exit 1
  fi
fi

# All fallible migration runs while the account is expired and password locked.
# Expiration also blocks SSH public-key authentication until final release.
# Credential bytes travel only through stdin, never process arguments.
printf '%s:%s\n' "$user" "$hash" | chpasswd --encrypted
chage -E -1 "$user"

# Remove the seed file (best-effort shred; fall back to rm).
shred -u -- "$CONF" 2>/dev/null || rm -f -- "$CONF"
[ ! -f "$FULL_NAME_CONF" ] || shred -u -- "$FULL_NAME_CONF" 2>/dev/null || rm -f -- "$FULL_NAME_CONF"

rm -f -- "$TRANSACTION"

echo "tilo-firstboot-user: created account '$user'"
