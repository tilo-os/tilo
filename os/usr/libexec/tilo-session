#!/bin/bash
# Tilo graphical-session entry point. Greetd runs this in the authenticated
# user's PAM session; it owns the corresponding systemd --user target for
# exactly as long as the compositor lives.
set -euo pipefail
ulimit -c 0

readonly SYSTEMCTL=/usr/bin/systemctl
readonly DBUS_UPDATE=/usr/bin/dbus-update-activation-environment
readonly SHELL_BIN=/usr/bin/shell
readonly MKDTEMP=/usr/bin/mktemp
readonly RM=/usr/bin/rm
readonly RMDIR=/usr/bin/rmdir
readonly MKDIR=/usr/bin/mkdir
readonly MKFIFO=/usr/bin/mkfifo
readonly CHMOD=/usr/bin/chmod
readonly MV=/usr/bin/mv
readonly CP=/usr/bin/cp
readonly TAIL=/usr/bin/tail
readonly DATE=/usr/bin/date
readonly FLIGHT_RECORDER=/usr/libexec/tilo-flight-recorder
readonly SESSION_TARGET=tilo-graphical-session.target

# The desktop uses Mesa too. The greeter's separate cage process cannot pass
# its LLVM CPU workaround through greetd into this authenticated session.
# Restrict baseline JIT codegen to ARM guests with the 2D PCI virtio GPU;
# physical GPUs retain their normal CPU selection.
if [[ $(uname -m) == aarch64 ]]; then
  for card in /sys/class/drm/card[0-9]*; do
    if [[ -f $card/device/uevent ]] && grep -qx 'PCI_ID=1AF4:1050' "$card/device/uevent"; then
      cpu_shim=/usr/lib/tilo/virtio-gallivm-cpu.so
      [[ -s $cpu_shim ]] || { echo 'missing ARM virtual graphics CPU shim' >&2; exit 1; }
      export LD_PRELOAD="$cpu_shim${LD_PRELOAD:+:$LD_PRELOAD}"
      break
    fi
  done
fi

target_started=0
environment_imported=0
shell_pid=""
flight_pipe=""
flight_relay_pid=""
logout_request_dir=""
logout_request_path=""

# The compositor cannot safely ask the display-manager wrapper to log out by
# shelling out to logind: the wrapper owns the user target and must stop it
# before returning control to the greeter. Give the compositor a private,
# absolute, one-shot request file for that hand-off. A graphical login must
# provide the user-owned runtime directory; falling back to shared /tmp would
# turn a security-sensitive control channel into a best-effort convention.
runtime_dir="${XDG_RUNTIME_DIR:-}"
case "$runtime_dir" in
  /*) ;;
  *) printf '%s\n' 'tilo-session: XDG_RUNTIME_DIR must be an absolute path' >&2; exit 1 ;;
esac
[ -d "$runtime_dir" ] || { printf 'tilo-session: runtime directory does not exist: %s\n' "$runtime_dir" >&2; exit 1; }
logout_request_dir="$($MKDTEMP -d "$runtime_dir/tilo-session.XXXXXX")"
logout_request_path="$logout_request_dir/logout-request"
export TILO_SESSION_LOGOUT_REQUEST="$logout_request_path"

# greetd supplies these only to the compositor process.  D-Bus activation and
# the already-running systemd user manager need their own copy or
# xdg-desktop-portal cannot select Tilo's backend.  The compositor adds
# WAYLAND_DISPLAY itself once its socket is up; stop_target clears all of them
# (and any stale DISPLAY/XAUTHORITY) on logout.
XDG_CURRENT_DESKTOP=tilo
XDG_SESSION_DESKTOP=tilo
XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE

stop_target() {
  if [ "$target_started" = 1 ]; then
    "$SYSTEMCTL" --user stop "$SESSION_TARGET" >/dev/null 2>&1 || true
    target_started=0
  fi
  if [ "$environment_imported" = 1 ]; then
    "$DBUS_UPDATE" --systemd \
      WAYLAND_DISPLAY= DISPLAY= XAUTHORITY= XDG_CURRENT_DESKTOP= \
      XDG_SESSION_DESKTOP= XDG_SESSION_TYPE= >/dev/null 2>&1 || true
    "$SYSTEMCTL" --user unset-environment \
      DISPLAY WAYLAND_DISPLAY XAUTHORITY DESKTOP_SESSION GDMSESSION \
      XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
      >/dev/null 2>&1 || true
    environment_imported=0
  fi
}

cleanup_logout_channel() {
  if [ -n "$logout_request_path" ]; then
    "$RM" -f -- "$logout_request_path" 2>/dev/null || true
  fi
  if [ -n "$flight_pipe" ]; then
    "$RM" -f -- "$flight_pipe" 2>/dev/null || true
  fi
  if [ -n "$logout_request_dir" ]; then
    "$RMDIR" -- "$logout_request_dir" 2>/dev/null || true
  fi
}

terminate_session() {
  local signal="$1" status="$2"
  trap - HUP INT TERM
  if [ -n "$shell_pid" ] && kill -0 "$shell_pid" 2>/dev/null; then
    kill "-$signal" "$shell_pid" 2>/dev/null || true
    wait "$shell_pid" 2>/dev/null || true
  fi
  exit "$status"
}

trap 'stop_target; cleanup_logout_channel' EXIT
trap 'terminate_session HUP 129' HUP
trap 'terminate_session INT 130' INT
trap 'terminate_session TERM 143' TERM

run_managed() {
  "$@" &
  shell_pid=$!
  local status
  if wait "$shell_pid"; then
    status=0
  else
    status=$?
  fi
  shell_pid=""
  return "$status"
}

# This blocks until graphical-session-pre.target and graphical-session.target
# complete. Identity is not handled here: the native compositor verifies and
# repairs an existing identity at startup and owns first-login OOBE because it
# is the first trusted display surface. Starting the Tilo-owned
# target is necessary because the standard graphical targets carry
# RefuseManualStart=yes.
if [ ! -x "$DBUS_UPDATE" ]; then
  echo "tilo-session: $DBUS_UPDATE is missing or not executable" >&2
  exit 1
fi
if [ ! -x "$FLIGHT_RECORDER" ]; then
  echo "tilo-session: $FLIGHT_RECORDER is missing or not executable" >&2
  exit 1
fi

# A user manager survives desktop sessions.  Keep its activation environment
# synchronized with greetd's selected desktop before portal services start,
# then clear it on logout so the next desktop cannot inherit Tilo's backend.
"$SYSTEMCTL" --user unset-environment \
  DISPLAY WAYLAND_DISPLAY XAUTHORITY DESKTOP_SESSION GDMSESSION \
  XDG_SESSION_DESKTOP >/dev/null 2>&1 || true
environment_imported=1
"$DBUS_UPDATE" --systemd XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
"$SYSTEMCTL" --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
"$SYSTEMCTL" --user start "$SESSION_TARGET"
target_started=1

# Keep a small persistent flight recorder beside the journal, as the host
# package's session runner does: an abrupt reset or journal vacuuming must not
# erase the only evidence from a failed login, and tilo-session-report reads
# these files. The recorder passes every byte on to this wrapper's stdout, so
# the journal still gets it all, and keeps only the latest 4 MiB. One previous
# login is retained, with its per-frame trace.
flight_dir="${XDG_STATE_HOME:-${HOME:?}/.local/state}/tilo/session-logs"
"$MKDIR" -p -- "$flight_dir"
"$CHMOD" 0700 "$flight_dir"
if [ -f "$flight_dir/latest.log" ]; then
  "$TAIL" -c 4194304 -- "$flight_dir/latest.log" >"$flight_dir/previous.log.tmp" || true
  "$CHMOD" 0600 "$flight_dir/previous.log.tmp"
  "$MV" -f -- "$flight_dir/previous.log.tmp" "$flight_dir/previous.log"
fi
if [ -f "$flight_dir/frame-trace.csv" ]; then
  "$CP" -- "$flight_dir/frame-trace.csv" "$flight_dir/previous-frame-trace.csv.tmp"
  "$CHMOD" 0600 "$flight_dir/previous-frame-trace.csv.tmp"
  "$MV" -f -- "$flight_dir/previous-frame-trace.csv.tmp" "$flight_dir/previous-frame-trace.csv"
fi
flight_log="$flight_dir/latest.log"
: >"$flight_log"
"$CHMOD" 0600 "$flight_log"
TILO_FRAME_TRACE="$flight_dir/frame-trace.csv"
: >"$TILO_FRAME_TRACE"
"$CHMOD" 0600 "$TILO_FRAME_TRACE"
export TILO_FRAME_TRACE
export TILO_PAINT_STATS=1
export TILO_LOOP_TIMING=1
flight_pipe="$logout_request_dir/flight-record.pipe"
"$MKFIFO" -m 0600 -- "$flight_pipe"
"$FLIGHT_RECORDER" "$flight_log" "$("$DATE" --iso-8601=seconds)" "$$" "$SHELL_BIN" <"$flight_pipe" &
flight_relay_pid=$!

set +e
run_managed "$SHELL_BIN" "$@" >"$flight_pipe" 2>&1
status=$?
wait "$flight_relay_pid" 2>/dev/null
flight_relay_pid=""
printf 'tilo-flight-record-v1 end=%s status=%s logout_request=%s\n' \
  "$("$DATE" --iso-8601=seconds)" "$status" \
  "$([ -e "$logout_request_path" ] && printf yes || printf no)" >>"$flight_log"
set -e
exit "$status"
