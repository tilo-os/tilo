#!/bin/bash
# qos-install — the privileged backend for the qOS custom (self-install)
# installer. The qos-installer UI (a ui::App, run under cage on the live
# medium) shells out to this with:
#
#     /usr/libexec/qos-install --disk <dev> --user <name> --yes
#
# and the account password on **stdin** (a single line). Optional flags:
#
#     --filesystem <btrfs|ext4|xfs>   root filesystem (default: btrfs)
#     --hostname <name>               hostname for the installed system (default: qos)
#     --timezone <Area/City>          IANA time zone (default: system default / UTC)
#     --keymap <xkb-layout>           keyboard layout, e.g. us, de (default: us)
#     --keyvariant <xkb-variant>      keyboard variant, e.g. dvorak (default: none)
#     --encrypt                       accepted for UI compatibility; native qOS
#                                     always uses LUKS2 full-disk encryption
#     --pin                           required unlock secret on stdin line 2: a TPM2 PIN
#                                     only with verified boot + kernel lockdown,
#                                     otherwise the boot passphrase (requires --encrypt)
#     --fido2                         also enrol a FIDO2 token (requires --encrypt)
#     --alongside --root-partition P --efi-partition P
#                                     preserve the disk's partition table;
#                                     format only a prepared empty Linux root
#                                     and reuse (never format) its existing ESP
#
# An older UI may omit `--encrypt`, but the backend still encrypts. It must
# provide `--pin`; otherwise installation fails closed. We:
#
#   1. copy the currently-booted bootc image into local container storage
#      (`bootc image copy-to-storage` -> containers-storage:localhost/bootc),
#   2. install from that copied image, in a privileged podman container, onto
#      the target disk (wipes it, --filesystem layout). qos-disk-encrypt builds
#      the GPT + LUKS2 layout and bootc installs `to-filesystem` into the opened
#      mapping — see that script for why the volume is not created by
#      `--block-setup tpm2-luks`,
#   3. create the user account: `bootc install` does NOT make users, so we
#      hash the password and drop `<name>:<hash>` into the freshly-installed
#      deployment's WRITABLE /etc/qos/install-user.conf, which a baked
#      first-boot oneshot (qos-firstboot-user.service) turns into a real
#      account on the installed system's first boot.
#   4. seed the hostname (/etc/hostname), the time zone (/etc/localtime
#      symlink + /etc/timezone) and the keyboard layout into the same
#      writable /etc: XKB_DEFAULT_LAYOUT/VARIANT in /etc/environment (the
#      qOS Wayland compositor reads these via xkbcommon when its own xkb
#      config is empty) and KEYMAP in /etc/vconsole.conf for the console.
#
# Everything human-readable goes to stdout (the UI tails it line by line);
# exit 0 == success, non-zero == failure.
#
# This is intentionally an OFFLINE, self-install model: the live system
# installs *itself* onto the disk — no network pull needed for the OS bits.
# The target image *reference* recorded in the install (so future
# `bootc upgrade` knows where to pull from) defaults to
# code.podesta.ai/qos/qos:latest and is overridable via $QOS_TARGET_IMGREF.
set -euo pipefail

# Where the installed system will look for updates (the "origin" imgref
# baked into the deployment). NOT where the bits come from now — those come
# from the booted image we copy to storage. Override via the environment;
# the sudoers drop-in env_keep's this name so it survives the sudo re-exec.
QOS_TARGET_IMGREF="${QOS_TARGET_IMGREF:-code.podesta.ai/qos/qos:latest}"

# The local-storage tag `bootc image copy-to-storage` writes to by default.
LOCAL_IMG="localhost/bootc"

# The block-level half of an encrypted install (partitioning, LUKS2, factor
# enrolment). Overridable so it can be driven directly in a test VM.
DISK_ENCRYPT="${QOS_DISK_ENCRYPT:-/usr/libexec/qos-disk-encrypt}"

log()  { printf '%s\n' "$*"; }
step() { printf '\n==> %s\n' "$*"; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

secure_boot_enabled() {
  local variable value
  for variable in /sys/firmware/efi/efivars/SecureBoot-*; do
    [ -f "$variable" ] || continue
    value="$(od -An -tu1 -j4 -N1 "$variable" 2>/dev/null | tr -d ' \n')"
    [ "$value" = "1" ] && return 0
  done
  return 1
}

kernel_lockdown_active() {
  local state
  state="$(cat /sys/kernel/security/lockdown 2>/dev/null || true)"
  case "$state" in
    *'[integrity]'*|*'[confidentiality]'*) return 0 ;;
    *) return 1 ;;
  esac
}

# Securely booting the live medium does not prove that the freshly installed
# target will boot an equally sealed and trusted UKI. Short-PIN mode is enabled
# only when a dedicated target-chain preflight exists and verifies that full
# handoff. It is deliberately absent until installation-time UKI signing,
# firmware trust enrollment and measured-target validation are integrated.
target_verified_boot_ready() {
  local preflight=/usr/libexec/qos-verified-boot-install-preflight
  [ -x "$preflight" ] && "$preflight"
}

verified_tpm() {
  { [ -e /dev/tpmrm0 ] || [ -e /dev/tpm0 ]; } \
    && secure_boot_enabled \
    && kernel_lockdown_active \
    && target_verified_boot_ready
}

# Updates are signature-required only for the official qOS repository in the
# shipped containers policy. Do not let a live-session environment override
# silently turn the installed system onto an unsigned update origin.
case "$QOS_TARGET_IMGREF" in
  code.podesta.ai/qos/qos:*|code.podesta.ai/qos/qos@sha256:*) : ;;
  *) die "untrusted QOS_TARGET_IMGREF '$QOS_TARGET_IMGREF' (must use the signature-required code.podesta.ai/qos/qos repository)" ;;
esac

# Map an xkb layout (+optional variant) to a Linux console (kbd) keymap
# name for /etc/vconsole.conf. The console map set doesn't line up 1:1 with
# xkb, so this is a curated table for the layouts the installer offers;
# anything unknown falls back to "us" so the TTY is always usable.
xkb_to_vconsole() {
  local layout="$1" variant="$2"
  # Variants first (e.g. us/dvorak → dvorak; us/colemak has no stock kbd
  # map, so it falls back to us).
  case "${layout}/${variant}" in
    us/dvorak) printf 'dvorak'; return ;;
  esac
  case "$layout" in
    us)  printf 'us' ;;
    gb)  printf 'uk' ;;
    de)  printf 'de' ;;
    fr)  printf 'fr' ;;
    es)  printf 'es' ;;
    it)  printf 'it' ;;
    pt)  printf 'pt-latin1' ;;
    br)  printf 'br-abnt2' ;;
    ru)  printf 'ru' ;;
    se)  printf 'se-latin1' ;;
    no)  printf 'no' ;;
    dk)  printf 'dk' ;;
    ch)  printf 'sg' ;;
    pl)  printf 'pl' ;;
    *)   printf 'us' ;;
  esac
}

# --- self-escalate -----------------------------------------------------------
# The UI runs as the unprivileged greetd session user; re-exec ourselves as
# root via passwordless sudo (the live-medium-only sudoers drop-in installed
# by qos-installer-setup.service permits exactly this command). sudo passes
# our stdin (the password) straight through to the re-exec'd copy, so we read
# it only once we are root.
if [ "$(id -u)" -ne 0 ]; then
  exec sudo -n "$0" "$@"
fi

# --- run the privileged work as a TRANSIENT SYSTEM UNIT ----------------------
# Even as root, this script is still in the greeter session's SELinux domain
# (xdm_t) — the UI runs under cage in the greetd session, and a plain `sudo`
# does not change the SELinux domain. xdm_t is denied the privileged
# container/install operations: `bootc image copy-to-storage` returns EACCES
# ("Permission denied (os error 13)") under SELinux enforcing. This is the one
# thing that historically forced the live medium to boot `enforcing=0`.
#
# Fix: re-launch ourselves as a TRANSIENT systemd unit. systemd (PID 1, the
# `init_t` domain) spawns the unit, so the real work runs in a system-service
# domain — NOT xdm_t — which the targeted policy already permits to drive
# podman/bootc (the normal "systemd runs a container service" path). This is
# what lets the installer live medium stay SELinux-ENFORCING (no enforcing=0).
#
# We are already root here (via the sudoers drop-in), so `systemd-run` talks to
# the system manager directly — no second sudo, and the existing sudoers rule
# is unchanged. `--pipe` forwards our stdin (the password) and stdout/stderr
# (progress) straight through to the unit; `--wait` blocks and propagates the
# unit's exit code; `--collect` reaps the unit afterwards; `--quiet` suppresses
# systemd-run's own "Running as unit:" chatter so it never leaks into the log.
# The QOS_INSTALL_TRANSIENT guard breaks the re-exec recursion: the unit runs
# this same script again, already in the system domain, and falls through to
# the real work below.
#
# If `systemd-run` is somehow unavailable we fall through and run in-process
# (the historical behaviour) — correct on a permissive medium, and the live
# medium also carries a scoped SELinux module (qos-installer.cil) as a backstop.
if [ -z "${QOS_INSTALL_TRANSIENT:-}" ] && command -v systemd-run >/dev/null 2>&1; then
  exec systemd-run \
    --pipe --collect --quiet --wait \
    --unit="qos-install-$$" \
    --setenv=QOS_INSTALL_TRANSIENT=1 \
    --setenv=QOS_TARGET_IMGREF="$QOS_TARGET_IMGREF" \
    -- "$0" "$@"
fi

# --- parse args --------------------------------------------------------------
DISK=""
USERNAME=""
ASSUME_YES=0
# New, optional options (UI passes these; older UIs omit them → defaults).
FILESYSTEM="btrfs"   # btrfs | ext4 | xfs
HOSTNAME_VAL="qos"
TIMEZONE_VAL=""      # empty → leave system default (UTC)
KEYMAP_VAL="us"      # xkb layout (default us)
KEYVARIANT_VAL=""    # xkb variant (empty → none)
ENCRYPT=1            # Native qOS is always installed into a LUKS2 root.
WANT_PIN=0           # --pin is mandatory; secret arrives on stdin line 2.
WANT_FIDO2=0         # --fido2 → also enroll a FIDO2 security key if present
ALONGSIDE=0
ROOT_PARTITION=""
EFI_PARTITION=""
PIN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --disk) DISK="${2:-}"; shift 2 ;;
    --user) USERNAME="${2:-}"; shift 2 ;;
    --filesystem) FILESYSTEM="${2:-}"; shift 2 ;;
    --hostname) HOSTNAME_VAL="${2:-}"; shift 2 ;;
    --timezone) TIMEZONE_VAL="${2:-}"; shift 2 ;;
    --keymap) KEYMAP_VAL="${2:-}"; shift 2 ;;
    --keyvariant) KEYVARIANT_VAL="${2:-}"; shift 2 ;;
    --encrypt) ENCRYPT=1; shift ;;
    --pin) WANT_PIN=1; shift ;;
    --fido2) WANT_FIDO2=1; shift ;;
    --alongside) ALONGSIDE=1; shift ;;
    --root-partition) ROOT_PARTITION="${2:-}"; shift 2 ;;
    --efi-partition) EFI_PARTITION="${2:-}"; shift 2 ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    -h|--help) sed -n '2,49p' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -n "$DISK" ] || die "missing --disk <device>"
[ -n "$USERNAME" ] || die "missing --user <name>"

if [ "$ALONGSIDE" -eq 1 ]; then
  [ -n "$ROOT_PARTITION" ] && [ -n "$EFI_PARTITION" ] \
    || die "--alongside requires --root-partition and --efi-partition"
else
  [ -z "$ROOT_PARTITION" ] && [ -z "$EFI_PARTITION" ] \
    || die "partition arguments require --alongside"
fi

# Use the portable Linux login-name subset accepted consistently by useradd
# across the distributions qOS targets. It also keeps the colon-delimited
# first-boot seed file unambiguous.
if [ "${#USERNAME}" -gt 32 ]; then
  die "invalid --user '$USERNAME' (use at most 32 characters)"
fi
case "${USERNAME:0:1}" in
  [a-z_]) : ;;
  *) die "invalid --user '$USERNAME' (start with a lowercase letter or _)" ;;
esac
case "$USERNAME" in
  *[!a-z0-9_-]*) die "invalid --user '$USERNAME' (use lowercase letters, digits, _ or -)" ;;
esac
case "$USERNAME" in
  root|bin|daemon|adm|lp|sync|shutdown|halt|mail|operator|games|ftp|nobody|dbus|polkitd|sshd|chrony|tss|greetd|qos)
    die "reserved --user '$USERNAME'" ;;
esac

# Validate the filesystem against the set bootc accepts for to-disk.
case "$FILESYSTEM" in
  btrfs|ext4|xfs) : ;;
  *) die "unsupported --filesystem '$FILESYSTEM' (use btrfs, ext4 or xfs)" ;;
esac

# Encryption does NOT require a TPM. The volume is created with a recovery key
# and the TPM is one more slot on top of it, so a machine without one still gets
# an encrypted disk that it unlocks by typing a secret. See qos-disk-encrypt.
# A startup secret is mandatory. Short-PIN mode requires TPM2 plus verified boot
# of both the live medium and installed target; otherwise the same input is a
# normal, stronger disk passphrase.
[ "$WANT_PIN" -eq 1 ] \
  || die "native qOS requires --pin for its encrypted startup boundary"

# Validate hostname (RFC-1123 label: letters/digits/hyphens, no edge hyphen).
[ -n "$HOSTNAME_VAL" ] || die "missing --hostname <name>"
case "$HOSTNAME_VAL" in
  -*|*-) die "invalid hostname '$HOSTNAME_VAL'" ;;
  *[!A-Za-z0-9-]*) die "invalid hostname '$HOSTNAME_VAL' (letters, digits, hyphens only)" ;;
esac

# Validate timezone shape if provided (defends the symlink target below).
if [ -n "$TIMEZONE_VAL" ]; then
  case "$TIMEZONE_VAL" in
    */../*|/*|*..) die "invalid --timezone '$TIMEZONE_VAL'" ;;
    *[!A-Za-z0-9_/+-]*) die "invalid --timezone '$TIMEZONE_VAL'" ;;
  esac
  [ -f "/usr/share/zoneinfo/$TIMEZONE_VAL" ] \
    || die "unknown --timezone '$TIMEZONE_VAL'"
fi

# Keyboard layout: default to us, validate it's a plain xkb token (these
# values land verbatim in /etc/environment and /etc/vconsole.conf below).
[ -n "$KEYMAP_VAL" ] || KEYMAP_VAL="us"
case "$KEYMAP_VAL" in
  *[!a-z0-9]*) die "invalid --keymap '$KEYMAP_VAL' (lowercase letters/digits only)" ;;
esac
if [ -n "$KEYVARIANT_VAL" ]; then
  case "$KEYVARIANT_VAL" in
    *[!a-z0-9_-]*) die "invalid --keyvariant '$KEYVARIANT_VAL'" ;;
  esac
fi

# Accept either a bare name (vda) or a full path (/dev/vda), then collapse
# aliases such as /dev/disk/by-id before any destructive comparison.
case "$DISK" in
  /dev/*) : ;;
  *) DISK="/dev/$DISK" ;;
esac

# --- guards ------------------------------------------------------------------
# Refuse to do anything unless we are clearly on the qOS installer live medium.
grep -qw 'qos.installer' /proc/cmdline 2>/dev/null \
  || grep -q 'qos.installer=1' /proc/cmdline 2>/dev/null \
  || die "refusing: 'qos.installer' not present on the kernel cmdline (not the installer medium)"

# Non-interactive: the UI must pass --yes. This is a destructive (wipe) op.
[ "$ASSUME_YES" -eq 1 ] \
  || die "refusing destructive install without --yes (pass --yes for non-interactive use)"

# Target must be a real, whole-disk block device.
[ -b "$DISK" ] || die "$DISK is not a block device"
DISK="$(readlink -f "$DISK")"
[ -b "$DISK" ] || die "target disk alias did not resolve to a block device"
DTYPE="$(lsblk -dno TYPE "$DISK" 2>/dev/null || true)"
[ "$DTYPE" = "disk" ] || die "$DISK is not a whole disk (type='$DTYPE'); pass the whole device, not a partition"
TARGET_MAJ_MIN="$(lsblk -dno MAJ:MIN "$DISK" 2>/dev/null || true)"
[ -n "$TARGET_MAJ_MIN" ] || die "could not resolve the target disk identity"

# Never target the disk the live medium itself is running from. The root may
# be overlayfs, so inspect every mounted block source and reduce partitions,
# dm-crypt and aliases to their whole-disk ancestor. Fail closed if the live
# medium cannot be identified; guessing here can erase the running installer.
LIVE_MAJ_MIN=""
while read -r SOURCE MOUNTPOINT; do
  SOURCE="${SOURCE%%\[*}"
  [ -b "$SOURCE" ] || continue
  case "$MOUNTPOINT" in
    /|/boot|/boot/*|/sysroot|/sysroot/*|/run/initramfs/live|/run/initramfs/live/*|/run/rootfsbase|/run/rootfsbase/*) ;;
    *) continue ;;
  esac
  LIVE_DISK="$(lsblk -spno NAME,TYPE "$SOURCE" 2>/dev/null | awk '$2 == "disk" || $2 == "rom" { print $1; exit }')"
  [ -n "$LIVE_DISK" ] || continue
  LIVE_MAJ_MIN="$(lsblk -dno MAJ:MIN "$LIVE_DISK" 2>/dev/null || true)"
  [ -n "$LIVE_MAJ_MIN" ] && break
done < <(findmnt -rn -o SOURCE,TARGET 2>/dev/null)
[ -n "$LIVE_MAJ_MIN" ] \
  || die "could not resolve the live medium's physical disk; refusing a destructive install"
[ "$TARGET_MAJ_MIN" != "$LIVE_MAJ_MIN" ] \
  || die "$DISK is the live medium's own disk — refusing to install onto it"

validate_alongside() {
  local root_parent efi_parent root_type efi_type efi_fs mountpoints signature_types tool
  for tool in blockdev blkid lsblk wipefs "mkfs.$FILESYSTEM" mount; do
    command -v "$tool" >/dev/null 2>&1 || die "missing required tool for alongside install: $tool"
  done
  [ -b "$ROOT_PARTITION" ] && [ "$(lsblk -dno TYPE "$ROOT_PARTITION" 2>/dev/null)" = part ] \
    || die "$ROOT_PARTITION is not a partition"
  [ -b "$EFI_PARTITION" ] && [ "$(lsblk -dno TYPE "$EFI_PARTITION" 2>/dev/null)" = part ] \
    || die "$EFI_PARTITION is not a partition"
  root_parent="$(lsblk -no PKNAME "$ROOT_PARTITION" 2>/dev/null | head -1)"
  efi_parent="$(lsblk -no PKNAME "$EFI_PARTITION" 2>/dev/null | head -1)"
  [ -n "$root_parent" ] && [ -n "$efi_parent" ] \
    && [ "$(readlink -f "/dev/$root_parent")" = "$DISK" ] \
    && [ "$(readlink -f "/dev/$efi_parent")" = "$DISK" ] \
    || die "alongside root and EFI partitions must both belong to $DISK"
  root_type="$(lsblk -dno PARTTYPE "$ROOT_PARTITION" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  efi_type="$(lsblk -dno PARTTYPE "$EFI_PARTITION" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  [ "$root_type" = "0fc63daf-8483-4772-8e79-3d69d8477de4" ] \
    || die "$ROOT_PARTITION is not explicitly typed as a Linux filesystem partition"
  [ "$efi_type" = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ] \
    || die "$EFI_PARTITION is not an EFI System Partition"
  efi_fs="$(blkid -s TYPE -o value "$EFI_PARTITION" 2>/dev/null || true)"
  [ "$efi_fs" = vfat ] || die "$EFI_PARTITION is not a FAT EFI System Partition"
  [ "$(blockdev --getsize64 "$ROOT_PARTITION")" -ge 34359738368 ] \
    || die "$ROOT_PARTITION is smaller than the 32 GiB alongside minimum"
  mountpoints="$(lsblk -nro MOUNTPOINT "$ROOT_PARTITION")" \
    || die "could not inspect $ROOT_PARTITION mount state"
  [ -z "$(printf '%s' "$mountpoints" | tr -d '[:space:]')" ] \
    || die "$ROOT_PARTITION is mounted"
  signature_types="$(wipefs --noheadings --no-act --output TYPE "$ROOT_PARTITION")" \
    || die "could not inspect signatures on $ROOT_PARTITION"
  [ -z "$(printf '%s' "$signature_types" | tr -d '[:space:]')" ] \
    || die "$ROOT_PARTITION contains a filesystem or volume signature; refusing to guess that its data is disposable"
}

if [ "$ALONGSIDE" -eq 1 ]; then
  ROOT_PARTITION="$(readlink -f "$ROOT_PARTITION")"
  EFI_PARTITION="$(readlink -f "$EFI_PARTITION")"
  validate_alongside
  log "  alongside   : preserve partition table; format only $ROOT_PARTITION"
  log "  shared ESP  : $EFI_PARTITION (preserved, not formatted)"
fi

# Refuse if the target disk (or any of its partitions) is currently mounted.
if lsblk -nro MOUNTPOINT "$DISK" 2>/dev/null | grep -q .; then
  die "$DISK (or one of its partitions) is currently mounted — unmount it first"
fi

# --- read the password (now that we are root) --------------------------------
IFS= read -r PASSWORD || true
[ -n "$PASSWORD" ] || die "no password received on stdin"
# Second stdin line is the disk-encryption PIN (only when --pin). Kept off argv
# so it never shows in process listings.
if [ "$WANT_PIN" -eq 1 ]; then
  IFS= read -r PIN || true
  [ -n "$PIN" ] || die "--pin set but no PIN received on stdin (line 2)"
  if verified_tpm; then
    case "$PIN" in
      *[!0-9]*) die "startup PIN must contain only digits" ;;
    esac
    [ "${#PIN}" -ge 6 ] && [ "${#PIN}" -le 12 ] \
      || die "startup PIN must be 6 to 12 digits"
  else
    [ "${#PIN}" -ge 12 ] \
      || die "disk passphrase must contain at least 12 characters without verified TPM2 boot"
  fi
fi

log "qOS installer"
log "  target disk : $DISK"
log "  username    : $USERNAME"
log "  filesystem  : $FILESYSTEM"
log "  hostname    : $HOSTNAME_VAL"
log "  timezone    : ${TIMEZONE_VAL:-<system default>}"
log "  keymap      : $KEYMAP_VAL${KEYVARIANT_VAL:+ ($KEYVARIANT_VAL)}"
log "  update ref  : $QOS_TARGET_IMGREF"

# --- 1. copy booted image into local container storage -----------------------
step "Copying the running qOS image into local container storage"
bootc image copy-to-storage
log "  -> $LOCAL_IMG"

# --- 2. install the base system ----------------------------------------------
# Unencrypted: `bootc install to-disk` owns the whole layout.
# Encrypted: we build the layout ourselves (qos-disk-encrypt prepare) and hand
# bootc the mounted tree, because `--block-setup tpm2-luks` can only produce a
# TPM-sealed single-slot volume and refuses to run at all without a TPM.
ENC_MNT=""
ENC_LUKS=""
ENC_KEYFILE=""
if [ "$ENCRYPT" -eq 1 ]; then
  if [ "$ALONGSIDE" -eq 1 ]; then
    step "Preparing encrypted qOS root on $ROOT_PARTITION (existing OS partitions are preserved)"
  else
    step "Preparing an encrypted root on $DISK (this ERASES the disk)"
  fi
  # The helper reports the volume it made on stdout and its progress on stderr;
  # keep the report and let the progress through to the UI, which reads our
  # stdout. fd 3 is this script's stdout for the duration.
  exec 3>&1
  if [ "$ALONGSIDE" -eq 1 ]; then
    validate_alongside
    PREP="$("$DISK_ENCRYPT" prepare-partition "$ROOT_PARTITION" --efi "$EFI_PARTITION" --filesystem "$FILESYSTEM" 2>&3)"
  else
    PREP="$("$DISK_ENCRYPT" prepare "$DISK" --filesystem "$FILESYSTEM" 2>&3)"
  fi
  exec 3>&-
  ENC_MNT="$(printf '%s\n' "$PREP" | sed -n 's/^MNT=//p')"
  ENC_LUKS="$(printf '%s\n' "$PREP" | sed -n 's/^LUKS_PART=//p')"
  ENC_KEYFILE="$(printf '%s\n' "$PREP" | sed -n 's/^KEY_FILE=//p')"
  ENC_ROOT_UUID="$(printf '%s\n' "$PREP" | sed -n 's/^ROOT_FS_UUID=//p')"
  ENC_KARGS="$(printf '%s\n' "$PREP" | sed -n 's/^KARGS=//p')"
  [ -n "$ENC_MNT" ] && [ -n "$ENC_LUKS" ] && [ -n "$ENC_ROOT_UUID" ] && [ -n "$ENC_KARGS" ] \
    || die "encryption: qos-disk-encrypt prepare did not report the volume it made"

  # From here the volume is open and the tree is mounted. If anything below fails
  # the installer exits without reaching `finish`, so close them on the way out —
  # otherwise a retry finds a mounted disk it refuses to touch. Key slots are
  # left alone; only `finish` removes the install key.
  trap '"$DISK_ENCRYPT" teardown "$DISK" --mnt "$ENC_MNT" >/dev/null 2>&1 || true' EXIT

  # Every karg the volume needs becomes a --karg; word-splitting KARGS is
  # intentional (it is a space-separated list this script produced).
  KARG_ARGS=()
  for k in $ENC_KARGS; do KARG_ARGS+=(--karg "$k"); done

  # --skip-finalize because bootc's finalize step remounts the target READ-ONLY,
  # and the account/hostname/keyboard seeding below writes into the deployment's
  # /etc on that same mount. qos-disk-encrypt finish unmounts and closes the
  # volume immediately afterwards, so the step bootc would have performed buys
  # nothing here.
  step "Installing qOS into the encrypted root"
  podman run --rm --privileged --pid=host --ipc=host \
    -v /var/lib/containers:/var/lib/containers \
    -v /dev:/dev \
    -v "$ENC_MNT:/target" \
    --security-opt label=type:unconfined_t \
    "$LOCAL_IMG" \
    bootc install to-filesystem \
      --root-mount-spec "UUID=$ENC_ROOT_UUID" \
      --karg-delete qos.installer=1 \
      "${KARG_ARGS[@]}" \
      --target-imgref "$QOS_TARGET_IMGREF" \
      --skip-finalize \
      /target
elif [ "$ALONGSIDE" -eq 1 ]; then
  validate_alongside
  step "Formatting only $ROOT_PARTITION for qOS; preserving every other partition"
  case "$FILESYSTEM" in
    btrfs) mkfs.btrfs -f -L root "$ROOT_PARTITION" >/dev/null ;;
    ext4) mkfs.ext4 -q -F -L root "$ROOT_PARTITION" ;;
    xfs) mkfs.xfs -q -f -L root "$ROOT_PARTITION" >/dev/null ;;
  esac
  ROOT_FS_UUID="$(blkid -s UUID -o value "$ROOT_PARTITION")"
  [ -n "$ROOT_FS_UUID" ] || die "could not read the new qOS root UUID"
  ALONGSIDE_MNT="$(mktemp -d)"
  mount "$ROOT_PARTITION" "$ALONGSIDE_MNT"
  install -d -m 0755 "$ALONGSIDE_MNT/boot/efi"
  mount "$EFI_PARTITION" "$ALONGSIDE_MNT/boot/efi"
  cleanup_alongside() {
    umount "$ALONGSIDE_MNT/boot/efi" 2>/dev/null || true
    umount "$ALONGSIDE_MNT" 2>/dev/null || true
    rmdir "$ALONGSIDE_MNT" 2>/dev/null || true
  }
  trap cleanup_alongside EXIT
  podman run --rm --privileged --pid=host --ipc=host \
    -v /var/lib/containers:/var/lib/containers -v /dev:/dev \
    -v "$ALONGSIDE_MNT:/target" --security-opt label=type:unconfined_t \
    "$LOCAL_IMG" bootc install to-filesystem \
      --root-mount-spec "UUID=$ROOT_FS_UUID" \
      --karg-delete qos.installer=1 --target-imgref "$QOS_TARGET_IMGREF" \
      --skip-finalize /target
else
  step "Installing qOS onto $DISK (this ERASES the disk; unencrypted)"
  podman run --rm --privileged --pid=host --ipc=host \
    -v /var/lib/containers:/var/lib/containers \
    -v /dev:/dev \
    --security-opt label=type:unconfined_t \
    "$LOCAL_IMG" \
    bootc install to-disk \
      --wipe \
      --karg-delete qos.installer=1 \
      --filesystem "$FILESYSTEM" \
      --block-setup direct \
      --target-imgref "$QOS_TARGET_IMGREF" \
      "$DISK"
fi
log "  base system installed."

# Make sure the kernel sees the freshly written partition table.
udevadm settle 2>/dev/null || true

# --- 2b. multi-factor LUKS enrollment ----------------------------------------
# The volume currently opens only with the throwaway install key. Layer the real
# factors on: always a recovery key, then FIDO2 / TPM2(+PIN) or — with no TPM —
# the supplied passphrase. qos-disk-encrypt aborts rather than leaving a volume
# whose only factor is one the user cannot reproduce.
if [ "$ENCRYPT" -eq 1 ]; then
  step "Enrolling disk-encryption factors"
  ENROL_ARGS=()
  [ "$WANT_FIDO2" -eq 1 ] && ENROL_ARGS+=(--fido2)
  verified_tpm || ENROL_ARGS+=(--passphrase)
  if [ "$WANT_PIN" -eq 1 ]; then
    PIN_FILE=/run/qos-install/pin
    install -d -m 0700 /run/qos-install
    ( umask 0077; printf '%s' "$PIN" > "$PIN_FILE" )
    ENROL_ARGS+=(--pin-file "$PIN_FILE")
  fi
  # The helper logs to stderr; fold it into our stdout so the UI sees the
  # recovery key it has to show the user.
  "$DISK_ENCRYPT" enrol "$ENC_LUKS" --key-file "$ENC_KEYFILE" "${ENROL_ARGS[@]}" 2>&1
  [ -n "${PIN_FILE:-}" ] && { shred -u "$PIN_FILE" 2>/dev/null || rm -f "$PIN_FILE"; }
  unset PIN
fi
udevadm settle 2>/dev/null || true

# --- 3. seed the user account ------------------------------------------------
step "Preparing the '$USERNAME' account on the installed system"

# SHA-512 crypt the password (no colons in a crypt(3) hash, so the
# name:hash record below parses unambiguously).
HASH="$(printf '%s\n' "$PASSWORD" | openssl passwd -6 -stdin)"
[ -n "$HASH" ] || die "failed to hash password"

# Find the newly-installed root partition by probe-mounting each partition
# of the target and looking for an ostree deployment. The bootc btrfs layout
# is ESP(vfat) + /boot(ext4) + root(btrfs, subvol 'root'); the partition
# *numbers* aren't fixed, so we discover by content, not by index.
#
# The encrypted path skips the probe: the root is already open and mounted, and
# probing would find only the LUKS header on the raw partition anyway.
DEPLOY_ETC=""
MOUNTED=""
find_deploy_etc() {
  # The WRITABLE per-deployment /etc — NOT the read-only, hardlinked
  # <csum>.0/usr/etc (writing there corrupts the shared ostree repo).
  find "$1" -regextype posix-extended \
    -regex '.*/ostree/deploy/[^/]+/deploy/[^/]+\.[0-9]+/etc' \
    -type d 2>/dev/null | head -1
}

if [ "$ENCRYPT" -eq 1 ]; then
  MNT="$ENC_MNT"
  DEPLOY_ETC="$(find_deploy_etc "$MNT")"
elif [ "$ALONGSIDE" -eq 1 ]; then
  MNT="$ALONGSIDE_MNT"
  DEPLOY_ETC="$(find_deploy_etc "$MNT")"
else
  MNT="$(mktemp -d)"
  cleanup() {
    [ -n "$MOUNTED" ] && umount "$MOUNTED" 2>/dev/null || true
    [ -d "$MNT" ] && rmdir "$MNT" 2>/dev/null || true
  }
  trap cleanup EXIT

  for part in $(lsblk -lnpo NAME,TYPE "$DISK" 2>/dev/null | awk '$2=="part"{print $1}'); do
    if mount "$part" "$MNT" 2>/dev/null; then
      MOUNTED="$MNT"
      # Is this the root fs (contains an ostree/deploy tree)? Works whether the
      # btrfs top-level (.../root/ostree/deploy) or the 'root' subvol
      # (.../ostree/deploy) got mounted — the regex below tolerates either.
      if find "$MNT" -maxdepth 6 -type d -path '*/ostree/deploy' 2>/dev/null | grep -q .; then
        DEPLOY_ETC="$(find_deploy_etc "$MNT")"
        [ -n "$DEPLOY_ETC" ] && break
      fi
      umount "$MNT" 2>/dev/null || true
      MOUNTED=""
    fi
  done
fi

[ -n "$DEPLOY_ETC" ] || die "could not locate the installed deployment's writable /etc on $DISK"

# The payload is the offline installer image, so undo its two live-medium-only
# /etc changes in the installed deployment. The kernel argument is removed by
# bootc above; restoring greetd and removing the transient privilege drop-in
# completes the boundary between installer and target.
install -D -m 0644 /usr/share/qos/greetd-config.toml "$DEPLOY_ETC/greetd/config.toml"
printf '\n[initial_session]\ncommand = "/usr/bin/shell --backend drm"\nuser = "%s"\n' \
  "$USERNAME" >> "$DEPLOY_ETC/greetd/config.toml"
rm -f "$DEPLOY_ETC/sudoers.d/qos-installer"
# Release media mask sshd, while an explicit diagnostic image may enable it.
# Neither live-only state belongs on the installed system; the base qOS image
# leaves sshd disabled but unmasked.
rm -f "$DEPLOY_ETC/systemd/system/sshd.service" \
      "$DEPLOY_ETC/systemd/system/multi-user.target.wants/sshd.service"
log "  configured encrypted-startup handoff to the '$USERNAME' session"

# NetworkManager creates user-selected Wi-Fi profiles as root-owned regular
# files in the live medium. Preserve those profiles so a connection made in
# the optional Network step also works on first boot. Never follow links, copy
# non-root-owned/hard-linked/permissive files, or copy subdirectories. A
# profile created by the live `greetd` user may contain
# `permissions=user:greetd:;`; remove that live-session restriction so the
# installed account can activate the machine connection.
LIVE_CONNECTIONS=/etc/NetworkManager/system-connections
TARGET_CONNECTIONS="$DEPLOY_ETC/NetworkManager/system-connections"
COPIED_CONNECTIONS=0
if [ -d "$LIVE_CONNECTIONS" ]; then
  install -d -m 0700 "$TARGET_CONNECTIONS"
  chcon --reference="$LIVE_CONNECTIONS" "$TARGET_CONNECTIONS" 2>/dev/null || true
  while IFS= read -r -d '' PROFILE; do
    TARGET_PROFILE="$TARGET_CONNECTIONS/$(basename "$PROFILE")"
    install -m 0600 "$PROFILE" "$TARGET_PROFILE"
    sed -i '/^[[:space:]]*permissions=/d' "$TARGET_PROFILE"
    chcon --reference="$PROFILE" "$TARGET_PROFILE" 2>/dev/null || true
    COPIED_CONNECTIONS=$((COPIED_CONNECTIONS + 1))
  done < <(find "$LIVE_CONNECTIONS" -mindepth 1 -maxdepth 1 -type f \
    -uid 0 -links 1 ! -perm /077 -print0)
fi
if [ "$COPIED_CONNECTIONS" -gt 0 ]; then
  log "  preserved $COPIED_CONNECTIONS NetworkManager connection profile(s) for first boot"
fi

install -d -m 0755 "$DEPLOY_ETC/qos"
CONF="$DEPLOY_ETC/qos/install-user.conf"
CONF_TMP="$(mktemp "$DEPLOY_ETC/qos/.install-user.XXXXXX")"
chmod 0600 "$CONF_TMP"
printf '%s:%s\n' "$USERNAME" "$HASH" > "$CONF_TMP"
mv -f "$CONF_TMP" "$CONF"
log "  wrote $CONF (consumed by qos-firstboot-user.service on first boot)"

# --- 4. seed hostname + time zone into the installed deployment's /etc -------
# Same writable-/etc technique as the user file: write into the per-deployment
# /etc so the values land on the installed system without touching the
# read-only, hardlinked usr/etc base.
step "Setting hostname '$HOSTNAME_VAL' and time zone '${TIMEZONE_VAL:-<system default>}'"
printf '%s\n' "$HOSTNAME_VAL" > "$DEPLOY_ETC/hostname"
chmod 0644 "$DEPLOY_ETC/hostname"
log "  wrote $DEPLOY_ETC/hostname"

if [ -n "$TIMEZONE_VAL" ]; then
  # /etc/localtime is a relative symlink into zoneinfo; create it pointing at
  # the requested zone (resolved within the installed system at boot). We use
  # a relative target so it's valid regardless of the eventual mount layout.
  ln -sf "../usr/share/zoneinfo/$TIMEZONE_VAL" "$DEPLOY_ETC/localtime"
  printf '%s\n' "$TIMEZONE_VAL" > "$DEPLOY_ETC/timezone"
  log "  set time zone to $TIMEZONE_VAL"
fi

# Keyboard layout. Two consumers on the installed system:
#   * the qOS Wayland session — the compositor builds its keymap with
#     smithay's add_keyboard(Default::default()), and xkbcommon honours
#     XKB_DEFAULT_LAYOUT/VARIANT from the environment when the supplied
#     config is empty. We append them to /etc/environment (PAM exports it
#     into every session, greetd's included).
#   * the text console — /etc/vconsole.conf KEYMAP, set to the kbd map that
#     best matches the chosen xkb layout.
step "Setting keyboard layout '$KEYMAP_VAL${KEYVARIANT_VAL:+/$KEYVARIANT_VAL}'"
ENV_FILE="$DEPLOY_ETC/environment"
# Drop any prior XKB_DEFAULT_* lines (idempotent on a re-run) then append.
if [ -f "$ENV_FILE" ]; then
  grep -v -E '^XKB_DEFAULT_(LAYOUT|VARIANT)=' "$ENV_FILE" > "$ENV_FILE.tmp" 2>/dev/null || true
  mv "$ENV_FILE.tmp" "$ENV_FILE"
fi
printf 'XKB_DEFAULT_LAYOUT=%s\n' "$KEYMAP_VAL" >> "$ENV_FILE"
if [ -n "$KEYVARIANT_VAL" ]; then
  printf 'XKB_DEFAULT_VARIANT=%s\n' "$KEYVARIANT_VAL" >> "$ENV_FILE"
fi
chmod 0644 "$ENV_FILE"
log "  wrote XKB_DEFAULT_LAYOUT=$KEYMAP_VAL${KEYVARIANT_VAL:+ / XKB_DEFAULT_VARIANT=$KEYVARIANT_VAL} to $ENV_FILE"

VCONSOLE_KEYMAP="$(xkb_to_vconsole "$KEYMAP_VAL" "$KEYVARIANT_VAL")"
printf 'KEYMAP=%s\n' "$VCONSOLE_KEYMAP" > "$DEPLOY_ETC/vconsole.conf"
chmod 0644 "$DEPLOY_ETC/vconsole.conf"
log "  wrote KEYMAP=$VCONSOLE_KEYMAP to $DEPLOY_ETC/vconsole.conf"

sync
if [ "$ENCRYPT" -eq 1 ]; then
  # Drops the throwaway install key slot (only once another factor exists),
  # unmounts the tree and closes the mapping.
  step "Closing the encrypted root"
  "$DISK_ENCRYPT" finish "$ENC_LUKS" --key-file "$ENC_KEYFILE" --mnt "$ENC_MNT" 2>&1
elif [ "$ALONGSIDE" -eq 1 ]; then
  cleanup_alongside
  trap - EXIT
else
  umount "$MOUNTED" 2>/dev/null || true
  MOUNTED=""
fi

step "Install complete — you can reboot into qOS now."
log "Remove the installer medium before rebooting."
exit 0
