#!/bin/bash
# tilo-disk-encrypt — build an encrypted root for a Tilo install, and enrol the
# unlock factors on it.
#
# Split out of tilo-install so the destructive block work is one testable unit:
#
#   tilo-disk-encrypt prepare  <disk> [--filesystem btrfs|ext4|xfs] [--mnt DIR]
#   tilo-disk-encrypt prepare-partition <root-part> --efi <esp> [...]
#   tilo-disk-encrypt enrol    <luks-part> [--key-file F] [--pin-file F] [--fido2] [--passphrase]
#                              [--store-part P --store-key-file F]
#   tilo-disk-encrypt enrol    <luks-part> --reseal   # currently fails closed
#   tilo-disk-encrypt finish   <luks-part> [--key-file F] [--mnt DIR]
#   tilo-disk-encrypt teardown <disk> [--mnt DIR]
#
# `prepare` writes a GPT with ESP + /boot + a LUKS2 root, opens the mapping with
# a throwaway key file, makes the filesystem, mounts the tree under --mnt and
# prints the facts the caller needs on stdout as `key=value` lines:
#
#   MNT=… ESP=… BOOT_PART=… LUKS_PART=… LUKS_UUID=… ROOT_FS_UUID=…
#   KEY_FILE=… KARGS=…
#
# When the disk is large enough (tilo-store-volume plan), the root is followed
# by the room store: a LUKS2 + Btrfs partition of its own, which the storage
# daemon's native data plane needs (docs/architecture/storage.md §6.2). Its
# key file is persistent — the installer moves it into the encrypted root,
# from where the store unlocks without a second prompt — and `enrol
# --store-part` adds the recovery key to it. `prepare` then also prints:
#
#   STORE_PART=… STORE_LUKS_UUID=… STORE_FS_UUID=… STORE_KEY_FILE=…
#
# KARGS is what the install has to bake into the boot entry for early userspace
# to find and open the volume. `enrol` adds the real unlock factors, `finish`
# drops the throwaway key slot and tears the tree down, and `teardown` is the
# same tear-down without touching key slots — what an aborted install wants.
#
# ## Why the volume is not created by `bootc install --block-setup tpm2-luks`
#
# That option seals the one and only key slot to a TPM, and refuses outright on
# a machine that has no TPM — so hardware absence turns into no encryption at
# all, which is the opposite of what it should do. Here the volume is always
# created with a recovery key, and the TPM (with or without a PIN) and a FIDO2
# token are *additional* slots layered on top. A machine with no TPM gets the
# same volume with one fewer convenience factor, and the recovery key is what
# every configuration falls back to.
set -euo pipefail

# Progress goes to STDERR throughout: `prepare` reports the volume it made on
# stdout as key=value lines, and mixing prose into that would make the caller
# parse around it.
log()  { printf '%s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

# GUIDs, not sfdisk's short aliases, so the partition types do not depend on the
# util-linux version.
GUID_ESP=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
GUID_LINUX=0FC63DAF-8483-4772-8E79-3D69D8477DE4
GUID_TILO_ROOT=7A2E8D75-3F01-4E5A-B2C9-51F6ED90B8AB
# Tilo's own type for the store, so neither root discovery (which requires
# exactly one GUID_TILO_ROOT) nor systemd-gpt-auto-generator (which would
# mount a discoverable /srv or /home type) ever claims it.
GUID_TILO_STORE=0B6C5D38-8BA9-40AA-A1F6-DCC035F5438D

# Finalization temporarily holds bootc's live UKI, the target boot bundle,
# and a replacement UKI. A 512 MiB ESP cannot hold all three on ARM64.
ESP_SIZE=${TILO_ESP_SIZE:-2G}
BOOT_SIZE=${TILO_BOOT_SIZE:-1G}
STORE_VOLUME="${TILO_STORE_VOLUME:-/usr/libexec/tilo-store-volume}"
MIN_ALONGSIDE_ESP_BYTES=2147483648
MIN_ALONGSIDE_ESP_FREE_BYTES=1073741824

# `enrol`/`prepare` both need a place for the throwaway key. It is 0600 in a
# 0700 dir on the installer's tmpfs, never on the target disk, and `finish`
# removes both it and its key slot.
default_key_file() { printf '/run/tilo-install/luks.key'; }
# The store's key sits next to it until the installer moves it into the root.
store_key_file() { printf '%s/store.key' "$(dirname "$1")"; }

# Bytes of an sfdisk-style size (512M, 1G, or plain bytes).
size_bytes() {
  case "$1" in
    *[!0-9KMGT]*|'') die "invalid size '$1'" ;;
    *K) printf '%s' $(( ${1%K} * 1024 )) ;;
    *M) printf '%s' $(( ${1%M} * 1024 * 1024 )) ;;
    *G) printf '%s' $(( ${1%G} * 1024 * 1024 * 1024 )) ;;
    *T) printf '%s' $(( ${1%T} * 1024 * 1024 * 1024 * 1024 )) ;;
    *) printf '%s' "$1" ;;
  esac
}

need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }

# Partitions of $1, in on-disk order, as absolute paths.
parts_of() {
  lsblk -lnpo NAME,TYPE "$1" 2>/dev/null | awk '$2=="part"{print $1}'
}

# Unmount the install tree under $1 and close any LUKS mapping backed by a
# partition of $2. Deepest mount first, and every step tolerant of "not there",
# so this is usable both as a pre-clean and as a failure path.
teardown() {
  local mnt="$1" disk="$2" p uuid
  umount "$mnt/boot/efi" 2>/dev/null || true
  umount "$mnt/boot" 2>/dev/null || true
  umount "$mnt" 2>/dev/null || true
  for p in "$disk" $(parts_of "$disk"); do
    uuid="$(cryptsetup luksUUID "$p" 2>/dev/null || true)"
    [ -n "$uuid" ] || continue
    cryptsetup close "luks-$uuid" 2>/dev/null || true
  done
}

# Prepare an encrypted Tilo root and a separate plain /boot inside two
# explicitly prepared partitions. The surrounding partition table and ESP are
# preserved. Unlike `prepare`, this never invokes sfdisk or mkfs on the ESP.
cmd_prepare_partition() {
  local part="" esp="" boot="" fs=btrfs mnt=/run/tilo-install/target key=""
  local part_parent esp_parent boot_parent part_type esp_type boot_type esp_fs mountpoints signature_types
  local esp_mountpoints esp_probe esp_available boot_mountpoints boot_signature
  while [ $# -gt 0 ]; do
    case "$1" in
      --efi) esp="${2:-}"; shift 2 ;;
      --boot) boot="${2:-}"; shift 2 ;;
      --filesystem) fs="${2:-}"; shift 2 ;;
      --mnt) mnt="${2:-}"; shift 2 ;;
      --key-file) key="${2:-}"; shift 2 ;;
      -*) die "prepare-partition: unknown option $1" ;;
      *) [ -z "$part" ] || die "prepare-partition: unexpected argument $1"; part="$1"; shift ;;
    esac
  done
  [ -n "$part" ] && [ -n "$esp" ] && [ -n "$boot" ] \
    || die "prepare-partition: missing root partition, --boot, or --efi"
  [ -n "$key" ] || key="$(default_key_file)"
  case "$fs" in btrfs|ext4|xfs) : ;; *) die "prepare-partition: unsupported filesystem '$fs'" ;; esac
  for t in blockdev cryptsetup df fsck.fat wipefs blkid lsblk mount umount mkfs.ext4 "mkfs.$fs"; do need "$t"; done
  part="$(readlink -f "$part")"
  esp="$(readlink -f "$esp")"
  boot="$(readlink -f "$boot")"
  [ "$part" != "$esp" ] && [ "$part" != "$boot" ] && [ "$esp" != "$boot" ] \
    || die "prepare-partition: root, boot, and EFI must be distinct partitions"
  [ -b "$part" ] && [ "$(lsblk -dno TYPE "$part" 2>/dev/null)" = part ] \
    || die "prepare-partition: $part is not a partition"
  [ -b "$esp" ] && [ "$(lsblk -dno TYPE "$esp" 2>/dev/null)" = part ] \
    || die "prepare-partition: $esp is not an EFI partition"
  [ -b "$boot" ] && [ "$(lsblk -dno TYPE "$boot" 2>/dev/null)" = part ] \
    || die "prepare-partition: $boot is not a boot partition"
  part_parent="$(lsblk -no PKNAME "$part" 2>/dev/null | head -1)"
  esp_parent="$(lsblk -no PKNAME "$esp" 2>/dev/null | head -1)"
  boot_parent="$(lsblk -no PKNAME "$boot" 2>/dev/null | head -1)"
  [ -n "$part_parent" ] && [ "$part_parent" = "$esp_parent" ] && [ "$part_parent" = "$boot_parent" ] \
    || die "prepare-partition: root, boot, and EFI partitions are not on the same disk"
  part_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$part" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  esp_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$esp" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  boot_type="$(blkid -p -s PART_ENTRY_TYPE -o value "$boot" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  [ "$part_type" = "${GUID_TILO_ROOT,,}" ] \
    || die "prepare-partition: $part is not typed as a Tilo root partition"
  [ "$esp_type" = "${GUID_ESP,,}" ] \
    || die "prepare-partition: $esp is not an EFI System Partition"
  [ "$boot_type" = "${GUID_LINUX,,}" ] \
    || die "prepare-partition: $boot is not typed as a Linux boot partition"
  [ "$(blockdev --getsize64 "$boot")" -ge 1073741824 ] \
    || die "prepare-partition: boot partition is smaller than 1 GiB"
  boot_mountpoints="$(lsblk -nro MOUNTPOINT "$boot")" \
    || die "prepare-partition: could not inspect boot mount state"
  [ -z "$(printf '%s' "$boot_mountpoints" | tr -d '[:space:]')" ] \
    || die "prepare-partition: boot partition is mounted"
  boot_signature="$(wipefs --noheadings --no-act --output TYPE "$boot")" \
    || die "prepare-partition: could not inspect boot signatures"
  [ -z "$(printf '%s' "$boot_signature" | tr -d '[:space:]')" ] \
    || die "prepare-partition: boot partition already contains a signature"
  esp_fs="$(blkid -s TYPE -o value "$esp" 2>/dev/null || true)"
  [ "$esp_fs" = vfat ] || die "prepare-partition: $esp is not FAT"
  [ "$(blockdev --getsize64 "$esp")" -ge "$MIN_ALONGSIDE_ESP_BYTES" ] \
    || die "prepare-partition: $esp is smaller than the 2 GiB Tilo EFI minimum"
  fsck.fat -n "$esp" >/dev/null 2>&1 \
    || die "prepare-partition: $esp is not a clean FAT filesystem; repair it before installing Tilo"
  esp_mountpoints="$(lsblk -nro MOUNTPOINT "$esp")" \
    || die "prepare-partition: could not inspect $esp mount state"
  [ -z "$(printf '%s' "$esp_mountpoints" | tr -d '[:space:]')" ] \
    || die "prepare-partition: $esp is mounted"
  esp_probe="$(mktemp -d)"
  if ! mount -o ro,nosuid,nodev,noexec "$esp" "$esp_probe"; then
    rmdir "$esp_probe"
    die "prepare-partition: could not inspect available space on $esp"
  fi
  esp_available="$(df -B1 --output=avail "$esp_probe" 2>/dev/null | tail -n 1 | tr -d '[:space:]')"
  umount "$esp_probe"
  rmdir "$esp_probe"
  case "$esp_available" in *[!0-9]*|'') die "prepare-partition: could not read available space on $esp" ;; esac
  [ "$esp_available" -ge "$MIN_ALONGSIDE_ESP_FREE_BYTES" ] \
    || die "prepare-partition: $esp has less than 1 GiB available for Tilo boot images"
  [ "$(blockdev --getsize64 "$part")" -ge 34359738368 ] \
    || die "prepare-partition: $part is smaller than 32 GiB"
  mountpoints="$(lsblk -nro MOUNTPOINT "$part")" \
    || die "prepare-partition: could not inspect $part mount state"
  [ -z "$(printf '%s' "$mountpoints" | tr -d '[:space:]')" ] \
    || die "prepare-partition: $part is mounted"
  signature_types="$(wipefs --noheadings --no-act --output TYPE "$part")" \
    || die "prepare-partition: could not inspect signatures on $part"
  [ -z "$(printf '%s' "$signature_types" | tr -d '[:space:]')" ] \
    || die "prepare-partition: $part contains a signature; refusing to erase it"

  teardown "$mnt" "$part"
  trap 'teardown "$mnt" "$part"' ERR
  install -d -m 0700 "$(dirname "$key")"
  ( umask 0077; head -c 64 /dev/urandom > "$key" )
  log "  formatting LUKS2 only on $part; preserving the shared ESP $esp"
  cryptsetup luksFormat --type luks2 --batch-mode --key-file "$key" "$part"
  local luks_uuid mapper root_fs_uuid
  luks_uuid="$(cryptsetup luksUUID "$part")"
  mapper="luks-$luks_uuid"
  cryptsetup open --key-file "$key" "$part" "$mapper"
  case "$fs" in
    btrfs) mkfs.btrfs -f -L root "/dev/mapper/$mapper" >/dev/null ;;
    ext4) mkfs.ext4 -q -F -L root "/dev/mapper/$mapper" ;;
    xfs) mkfs.xfs -q -f -L root "/dev/mapper/$mapper" >/dev/null ;;
  esac
  root_fs_uuid="$(blkid -s UUID -o value "/dev/mapper/$mapper")"
  [ -n "$root_fs_uuid" ] || die "prepare-partition: could not read root UUID"
  install -d -m 0700 "$mnt"
  mount "/dev/mapper/$mapper" "$mnt"
  chmod 0700 "$mnt"
  find "$mnt" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  mkfs.ext4 -q -L TILO_BOOT "$boot"
  install -d -m 0755 "$mnt/boot"
  mount "$boot" "$mnt/boot"
  install -d -m 0755 "$mnt/boot/efi"
  mount "$esp" "$mnt/boot/efi"
  printf 'MNT=%s\nESP=%s\nBOOT_PART=%s\nLUKS_PART=%s\nLUKS_UUID=%s\nMAPPER=%s\nROOT_FS_UUID=%s\nKEY_FILE=%s\n' \
    "$mnt" "$esp" "$boot" "$part" "$luks_uuid" "$mapper" "$root_fs_uuid" "$key"
  printf 'KARGS=rd.luks.uuid=%s rd.luks.options=%s=tpm2-device=auto,fido2-device=auto\n' \
    "$luks_uuid" "$luks_uuid"
}

cmd_prepare() {
  local disk="" fs=btrfs mnt=/run/tilo-install/target key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --filesystem) fs="${2:-}"; shift 2 ;;
      --mnt) mnt="${2:-}"; shift 2 ;;
      --key-file) key="${2:-}"; shift 2 ;;
      -*) die "prepare: unknown option $1" ;;
      *) [ -z "$disk" ] || die "prepare: unexpected argument $1"; disk="$1"; shift ;;
    esac
  done
  [ -n "$disk" ] || die "prepare: missing <disk>"
  [ -n "$key" ] || key="$(default_key_file)"
  case "$fs" in btrfs|ext4|xfs) : ;; *) die "prepare: unsupported filesystem '$fs'" ;; esac

  for t in blockdev sfdisk cryptsetup wipefs blkid lsblk "mkfs.$fs" mkfs.vfat mkfs.ext4 "$STORE_VOLUME"; do need "$t"; done

  [ -b "$disk" ] || die "prepare: $disk is not a block device"
  [ "$(lsblk -dno TYPE "$disk" 2>/dev/null)" = "disk" ] \
    || die "prepare: $disk is not a whole disk"

  # A previous attempt that died partway leaves the tree mounted and the mapping
  # open, and every check below would then refuse. Since this command's whole job
  # is to overwrite the disk, undoing that state is safe and makes a retry work.
  teardown "$mnt" "$disk"

  lsblk -nro MOUNTPOINT "$disk" 2>/dev/null | grep -q . \
    && die "prepare: $disk (or a partition of it) is mounted"
  # From here on the disk is being rewritten, so a failure must not leave the
  # mapping open — otherwise the retry cannot wipe the partition table.
  trap 'teardown "$mnt" "$disk"' ERR

  # The root/store split. Reserved: the 1 MiB lead-in, ESP, /boot, and 1 MiB
  # for the backup GPT at the end of the disk.
  local disk_bytes reserved plan root_bytes store_bytes
  disk_bytes="$(blockdev --getsize64 "$disk")"
  reserved=$(( 2 * 1024 * 1024 + $(size_bytes "$ESP_SIZE") + $(size_bytes "$BOOT_SIZE") ))
  plan="$("$STORE_VOLUME" plan --disk-bytes "$disk_bytes" --reserved-bytes "$reserved")" \
    || die "prepare: could not plan the store volume"
  root_bytes="$(printf '%s\n' "$plan" | sed -n 's/^ROOT_BYTES=//p')"
  store_bytes="$(printf '%s\n' "$plan" | sed -n 's/^STORE_BYTES=//p')"
  case "$root_bytes$store_bytes" in ''|*[!0-9]*) die "prepare: malformed store plan: $plan" ;; esac

  wipefs -a "$disk" >/dev/null
  if [ "$store_bytes" -gt 0 ]; then
    log "  wiping $disk and writing a GPT (ESP $ESP_SIZE + /boot $BOOT_SIZE + LUKS root $((root_bytes / 1048576)) MiB + LUKS store)"
    sfdisk --quiet --wipe always --wipe-partitions always "$disk" <<EOF
label: gpt
start=1M, size=$ESP_SIZE, type=$GUID_ESP, name="EFI-SYSTEM"
size=$BOOT_SIZE, type=$GUID_LINUX, name="boot"
size=$((root_bytes / 1048576))MiB, type=$GUID_TILO_ROOT, name="Tilo root"
type=$GUID_TILO_STORE, name="Tilo store"
EOF
  else
    log "  wiping $disk and writing a GPT (ESP $ESP_SIZE + /boot $BOOT_SIZE + LUKS root; too small for a store partition)"
    sfdisk --quiet --wipe always --wipe-partitions always "$disk" <<EOF
label: gpt
start=1M, size=$ESP_SIZE, type=$GUID_ESP, name="EFI-SYSTEM"
size=$BOOT_SIZE, type=$GUID_LINUX, name="boot"
type=$GUID_TILO_ROOT, name="Tilo root"
EOF
  fi
  udevadm settle 2>/dev/null || true

  local esp boot_part luks_part store_part="" want_parts=3
  [ "$store_bytes" -eq 0 ] || want_parts=4
  esp="$(parts_of "$disk" | sed -n 1p)"
  boot_part="$(parts_of "$disk" | sed -n 2p)"
  luks_part="$(parts_of "$disk" | sed -n 3p)"
  [ "$want_parts" -eq 3 ] || store_part="$(parts_of "$disk" | sed -n 4p)"
  [ -b "$esp" ] && [ -b "$boot_part" ] && [ -b "$luks_part" ] \
    && { [ "$want_parts" -eq 3 ] || [ -b "$store_part" ]; } \
    || die "prepare: expected $want_parts partitions on $disk, got: $(parts_of "$disk" | tr '\n' ' ')"

  log "  ESP=$esp  boot=$boot_part  root(LUKS)=$luks_part"
  mkfs.vfat -n EFI-SYSTEM "$esp" >/dev/null
  # The signed target UKI mounts this exact installer-owned label at /boot.
  # It must remain deterministic because its command line is covered by the
  # release signature and PCR prediction.
  mkfs.ext4 -q -L TILO_BOOT "$boot_part"

  # The throwaway key authorises every enrolment below and is removed by
  # `finish`. 64 random bytes, so it is never the weakest slot while it exists.
  install -d -m 0700 "$(dirname "$key")"
  ( umask 0077; head -c 64 /dev/urandom > "$key" )

  log "  formatting LUKS2 on $luks_part"
  cryptsetup luksFormat --type luks2 --batch-mode --key-file "$key" "$luks_part"
  local luks_uuid mapper
  luks_uuid="$(cryptsetup luksUUID "$luks_part")"
  [ -n "$luks_uuid" ] || die "prepare: could not read the LUKS UUID"
  # dracut's own naming for a volume it opens from rd.luks.uuid; using it here
  # keeps the installer's view and the boot-time view of the mapping identical.
  mapper="luks-$luks_uuid"
  cryptsetup open --key-file "$key" "$luks_part" "$mapper"
  udevadm settle 2>/dev/null || true

  log "  making the $fs root filesystem"
  case "$fs" in
    btrfs) mkfs.btrfs -f -L root "/dev/mapper/$mapper" >/dev/null ;;
    ext4)  mkfs.ext4 -q -L root "/dev/mapper/$mapper" ;;
    xfs)   mkfs.xfs -q -f -L root "/dev/mapper/$mapper" >/dev/null ;;
  esac
  local root_fs_uuid
  root_fs_uuid="$(blkid -s UUID -o value "/dev/mapper/$mapper")"
  [ -n "$root_fs_uuid" ] || die "prepare: could not read the root filesystem UUID"

  # The store has its own persistent random key: the installer moves it into
  # the root, which is what unlocks the store on every boot.
  local store_key="" store_luks_uuid="" store_fs_uuid="" store_report
  if [ -n "$store_part" ]; then
    store_key="$(store_key_file "$key")"
    ( umask 0077; head -c 64 /dev/urandom > "$store_key" )
    store_report="$("$STORE_VOLUME" format "$store_part" --key-file "$store_key")" \
      || die "prepare: could not format the store volume on $store_part"
    store_luks_uuid="$(printf '%s\n' "$store_report" | sed -n 's/^LUKS_UUID=//p')"
    store_fs_uuid="$(printf '%s\n' "$store_report" | sed -n 's/^FS_UUID=//p')"
    [ -n "$store_luks_uuid" ] && [ -n "$store_fs_uuid" ] \
      || die "prepare: the store volume helper did not report the volume it made"
  fi

  install -d -m 0700 "$mnt"
  mount "/dev/mapper/$mapper" "$mnt"
  chmod 0700 "$mnt"
  # `bootc install to-filesystem` wants an empty root; ext4 arrives with a
  # lost+found, so clear whatever mkfs left rather than special-casing it.
  find "$mnt" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  install -d -m 0755 "$mnt/boot"
  mount "$boot_part" "$mnt/boot"
  install -d -m 0755 "$mnt/boot/efi"
  mount "$esp" "$mnt/boot/efi"

  # Early userspace needs to be told which volume to open and which enrolled
  # hardware-token handlers to try. Both options are harmless when their token
  # type is absent from the LUKS2 JSON metadata: systemd-cryptsetup falls back to
  # asking for a passphrase. Keeping both here means an optional FIDO2 factor is
  # usable at boot, rather than merely present in the LUKS header.
  printf 'MNT=%s\n'          "$mnt"
  printf 'ESP=%s\n'          "$esp"
  printf 'BOOT_PART=%s\n'    "$boot_part"
  printf 'LUKS_PART=%s\n'    "$luks_part"
  printf 'LUKS_UUID=%s\n'    "$luks_uuid"
  printf 'MAPPER=%s\n'       "$mapper"
  printf 'ROOT_FS_UUID=%s\n' "$root_fs_uuid"
  printf 'KEY_FILE=%s\n'     "$key"
  if [ -n "$store_part" ]; then
    printf 'STORE_PART=%s\n'      "$store_part"
    printf 'STORE_LUKS_UUID=%s\n' "$store_luks_uuid"
    printf 'STORE_FS_UUID=%s\n'   "$store_fs_uuid"
    printf 'STORE_KEY_FILE=%s\n'  "$store_key"
  fi
  printf 'KARGS=rd.luks.uuid=%s rd.luks.options=%s=tpm2-device=auto,fido2-device=auto\n' \
      "$luks_uuid" "$luks_uuid"
}

cmd_enrol() {
  local dev="" key="" pin_file="" want_fido2=0 reseal=0 predictions="" generation="" rollback_state=""
  local require_tpm_prediction=0 store_part="" store_key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --key-file) key="${2:-}"; shift 2 ;;
      --store-part) store_part="${2:-}"; shift 2 ;;
      --store-key-file) store_key="${2:-}"; shift 2 ;;
      --pin-file) pin_file="${2:-}"; shift 2 ;;
      --predictions) predictions="${2:-}"; shift 2 ;;
      --generation) generation="${2:-}"; shift 2 ;;
      --rollback-state) rollback_state="${2:-}"; shift 2 ;;
      --require-tpm-prediction) require_tpm_prediction=1; shift ;;
      --fido2) want_fido2=1; shift ;;
      # Compatibility flag for callers; passphrase mode is also the default.
      --passphrase) shift ;;
      # Re-bind an already-installed volume to a TPM: after a cleared or replaced
      # chip, or after turning Secure Boot on or off (PCR 7 changes either way).
      # No new recovery key — the existing one is what authorises this — and the
      # stale TPM slot is replaced rather than added to.
      --reseal) reseal=1; shift ;;
      -*) die "enrol: unknown option $1" ;;
      *) [ -z "$dev" ] || die "enrol: unexpected argument $1"; dev="$1"; shift ;;
    esac
  done
  [ -n "$dev" ] || die "enrol: missing <luks-part>"
  [ -n "$key" ] || key="$(default_key_file)"
  if [ -n "$store_part$store_key" ]; then
    [ -b "$store_part" ] && [ -f "$store_key" ] \
      || die "enrol: --store-part and --store-key-file go together"
  fi
  need systemd-cryptenroll
  need cryptsetup

  # During an install the throwaway key authorises every enrolment. Afterwards it
  # is gone, so systemd-cryptenroll asks for an existing passphrase instead —
  # which is the recovery key. That is what makes --reseal usable on a machine
  # that is already running.
  local unlock=()
  if [ -f "$key" ]; then
    unlock=(--unlock-key-file="$key")
  elif [ "$reseal" -eq 1 ]; then
    log "  no install key; systemd-cryptenroll will ask for an existing"
    log "  passphrase (your recovery key)."
  else
    die "enrol: no unlock key file at $key (pass --reseal to authorise with the recovery key instead)"
  fi

  if [ "$reseal" -eq 1 ]; then
    die "enrol --reseal: no replacement-TPM recovery ceremony is available; use the verified recovery key and do not create a weaker slot"
  fi

  # A private scratch dir for the secrets this function has to hand to
  # cryptsetup as files. 0700 from mktemp, removed on every exit path.
  local scratch
  scratch="$(mktemp -d)" || die "enrol: could not create a scratch directory"
  # shellcheck disable=SC2064  # $scratch must expand now, not at trap time
  trap "rm -rf '$scratch'" EXIT

  # (1) The recovery key, first and mandatory. Every other factor is a
  # convenience that can be lost with the hardware; this one is the guarantee,
  # so a failure here aborts rather than leaving a disk only a TPM can open.
  log "  enrolling the recovery key…"
  local rec_key=""
  # systemd-cryptenroll prints the key, and nothing but the key, on stdout; the
  # prose around it and any failure go to stderr. Reading the two apart is what
  # makes the key recoverable without matching it against a shape it may not
  # have — how the modhex is grouped is systemd's business, not ours. Matching
  # a shape here is what once aborted the whole enrolment: the pattern expected
  # eight groups of six characters, systemd emits eight groups of eight, and
  # under `set -e` the failed match took the remaining factors down with it.
  if ! rec_key="$(systemd-cryptenroll "${unlock[@]}" --recovery-key "$dev" 2>"$scratch/rec.err")"; then
    die "recovery-key enrolment failed; aborting rather than shipping a disk with no recoverable factor:"$'\n'"$(cat "$scratch/rec.err")"
  fi
  # Last non-blank line. The temporary install key still exists at this point,
  # so an unreadable recovery key is a safe installation failure rather than a
  # reason to finish a system whose owner has no usable hardware-loss fallback.
  rec_key="$(printf '%s\n' "$rec_key" | sed -e 's/[[:space:]]*$//' -e '/^$/d' | tail -1 || true)"

  if [ -n "$rec_key" ]; then
    log ""
    log "  ============================================================"
    log "   RECOVERY KEY — write this down / save it off-device NOW."
    log "   It unlocks the disk when no other factor can."
    log ""
    log "       $rec_key"
    # The graphical installer consumes this into a persistent recovery-key
    # card, so verbose image-copy output cannot scroll the only backup away.
    log "::tilo-recovery-key::$rec_key"
    log ""
    if command -v qrencode >/dev/null 2>&1; then
      qrencode -t ANSIUTF8 "$rec_key" 2>/dev/null || true
    fi
    log "  ============================================================"
    log ""
    # Prove the string just shown actually opens the volume. A recovery key that
    # was displayed but does not work is indistinguishable, to its owner, from
    # no recovery key at all — so read it back through cryptsetup rather than
    # trusting that what we parsed is what was enrolled.
    ( umask 0077; printf '%s' "$rec_key" > "$scratch/recovery" )
    if cryptsetup open --test-passphrase --key-file "$scratch/recovery" "$dev" 2>/dev/null; then
      log "  recovery key verified: it opens the volume."
    else
      die "the recovery key just enrolled did not open $dev; refusing to finish without a verified recovery factor"
    fi
  else
    die "a recovery key slot was enrolled but its value could not be read back; refusing to finish without showing a usable recovery key"
  fi

  # The store unlocks from its key file inside the root. Should the root ever
  # be unreadable, the same recovery key opens the store from any rescue
  # system, so the person's rooms are never behind a factor they were not
  # shown. A passphrase slot, so it gets cryptsetup's default Argon2 cost.
  if [ -n "$store_part" ]; then
    log "  adding the recovery key to the store volume…"
    cryptsetup luksAddKey --batch-mode --key-file "$store_key" \
      --new-keyfile "$scratch/recovery" "$store_part" \
      || die "could not add the recovery key to the store volume $store_part"
    cryptsetup open --test-passphrase --key-file "$scratch/recovery" "$store_part" 2>/dev/null \
      || die "the recovery key was added to $store_part but does not open it"
    log "  recovery key verified: it opens the store volume."
  fi

  # (2) FIDO2, if a token was asked for. An explicit installer choice is a
  # configuration requirement, not a best-effort hint: while the temporary key
  # still exists, stop and let the UI ask the owner to insert/touch the token.
  if [ "$want_fido2" -eq 1 ]; then
    log "  enrolling a FIDO2 security key (touch it now if prompted)…"
    systemd-cryptenroll "${unlock[@]}" --fido2-device=auto "$dev" \
      || die "FIDO2 enrolment failed; insert a compatible key, make sure it supports hmac-secret, and retry"
    log "  FIDO2 key enrolled."
  fi

  # (3) The startup factor. Use the generation-bound TPM policy only when the
  # exact release-signed prediction sidecar is present. Otherwise retain the
  # strong ordinary passphrase path; never silently create a PCR7-only token.
  if [ -n "$pin_file" ]; then
    # A key file's bytes are the passphrase verbatim, trailing newline included
    # — and a newline is exactly what the boot prompt cannot send. A file
    # written with `echo` would otherwise enrol a secret that nobody can type,
    # so normalise to the bytes the user will actually enter.
    ( umask 0077; printf '%s' "$(cat "$pin_file")" > "$scratch/pin" )
    [ -s "$scratch/pin" ] || die "enrol: the pin file $pin_file is empty"
    if [ -n "$predictions" ] && [ -n "$generation" ] \
       && compgen -G "$predictions/generation-$generation*.json" >/dev/null \
       && { [ -c /dev/tpmrm0 ] || [ -c /dev/tpm0 ]; }; then
      need tilo-rollback
      log "  enrolling TPM2 + startup PIN against the signed generation $generation prediction…"
      rollback_args=(--predictions "$predictions")
      [ -z "$rollback_state" ] || rollback_args+=(--state "$rollback_state")
      tilo-rollback "${rollback_args[@]}" enroll --device "$dev" \
        --generation "$generation" --recovery-key-file "$scratch/recovery" \
        --pin-file "$scratch/pin" \
        || die "signed measured-boot TPM enrollment failed; the recovery key remains valid"
      log "  TPM2 + PIN enrolled and verified."
      return 0
    fi
    [ "$require_tpm_prediction" -eq 0 ] \
      || die "verified TPM enrollment prerequisites changed after review; refusing to turn the startup PIN into an ordinary LUKS passphrase"
    log "  no exact signed target prediction/TPM is available; enrolling the supplied strong passphrase as a LUKS key slot."
    # cryptsetup takes the authorising key as --key-file and the new one as
    # --new-keyfile; with no install key it prompts for the existing secret.
    local addkey=()
    [ -f "$key" ] && addkey=(--key-file "$key")
    cryptsetup luksAddKey --batch-mode \
      "${addkey[@]}" --new-keyfile "$scratch/pin" "$dev" \
      || die "passphrase enrolment failed"
    # Prove that the exact secret its owner was told to remember opens the disk.
    cryptsetup open --test-passphrase --key-file "$scratch/pin" "$dev" 2>/dev/null \
      || die "the passphrase was added but does not open $dev — refusing to call this enrolled"
    log "  passphrase enrolled and verified to open the volume."
  else
    log "  no passphrase was supplied, so the RECOVERY KEY above is the boot"
    log "  passphrase. Keep it; there is no other way in."
  fi
}

cmd_finish() {
  local dev="" key="" mnt=/run/tilo-install/target
  while [ $# -gt 0 ]; do
    case "$1" in
      --key-file) key="${2:-}"; shift 2 ;;
      --mnt) mnt="${2:-}"; shift 2 ;;
      -*) die "finish: unknown option $1" ;;
      *) [ -z "$dev" ] || die "finish: unexpected argument $1"; dev="$1"; shift ;;
    esac
  done
  [ -n "$dev" ] || die "finish: missing <luks-part>"
  [ -n "$key" ] || key="$(default_key_file)"

  # Refuse to drop the throwaway slot unless a real factor took its place —
  # otherwise this step is what destroys the data.
  local slots
  slots="$(cryptsetup luksDump "$dev" | grep -cE '^[[:space:]]*[0-9]+: luks2$' || true)"
  [ "${slots:-0}" -ge 2 ] \
    || die "finish: $dev has $slots key slot(s); refusing to remove the install key before another factor is enrolled"

  if [ -f "$key" ]; then
    log "  removing the throwaway install key slot"
    cryptsetup luksRemoveKey "$dev" --key-file "$key" \
      || die "finish: could not remove the install key slot"
    shred -u "$key" 2>/dev/null || rm -f "$key"
  fi
  # The installer has copied the store's key into the root by now; the live
  # medium's copy has no further use.
  local store_key
  store_key="$(store_key_file "$key")"
  [ ! -f "$store_key" ] || shred -u "$store_key" 2>/dev/null || rm -f "$store_key"

  # Unmount deepest-first; the tree is ESP under /boot under the root.
  umount "$mnt/boot/efi" 2>/dev/null || true
  umount "$mnt/boot" 2>/dev/null || true
  umount "$mnt" 2>/dev/null || true
  local mapper
  mapper="luks-$(cryptsetup luksUUID "$dev")"
  cryptsetup close "$mapper" 2>/dev/null || true
  log "  encrypted root closed."
}

# Public, idempotent cleanup: unmount the tree and close the mapping, leaving the
# key slots alone. This is what an aborted install wants — `finish` is for the
# successful path and additionally drops the throwaway slot.
cmd_teardown() {
  local disk="" mnt=/run/tilo-install/target
  while [ $# -gt 0 ]; do
    case "$1" in
      --mnt) mnt="${2:-}"; shift 2 ;;
      -*) die "teardown: unknown option $1" ;;
      *) [ -z "$disk" ] || die "teardown: unexpected argument $1"; disk="$1"; shift ;;
    esac
  done
  [ -n "$disk" ] || die "teardown: missing <disk>"
  teardown "$mnt" "$disk"
}

sub="${1:-}"; shift || true
case "$sub" in
  prepare) cmd_prepare "$@" ;;
  prepare-partition) cmd_prepare_partition "$@" ;;
  enrol|enroll) cmd_enrol "$@" ;;
  finish) cmd_finish "$@" ;;
  teardown) cmd_teardown "$@" ;;
  -h|--help|"") sed -n '2,44p' "$0" ;;
  *) die "unknown subcommand: $sub (try --help)" ;;
esac
