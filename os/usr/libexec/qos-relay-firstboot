#!/usr/bin/env bash
# Complete host enrollment and provisioning with the trusted nearby qOS device.
set -euo pipefail

token=/etc/qos/enrollment-token.txt
cert=/var/lib/qos/device/cert.bin
home_peer=/etc/qos/home-peer.toml

if [[ -s "$cert" && -s "$home_peer" ]]; then
    exit 0
fi
if [[ ! -s "$token" ]] || grep -q '^# Replace' "$token"; then
    echo "qos-relay-firstboot: add a home-server enrollment token at $token"
    exit 1
fi

label="$(hostnamectl --static 2>/dev/null || hostname 2>/dev/null || echo 'Home server')"
/usr/bin/qos-enroll join --token-file "$token" --identity-root /var/lib/qos \
    --home-peer-output /etc/qos/home-peer.toml --label "$label" --timeout 270
rm -f "$token"
echo "qos-relay-firstboot: enrollment and full-sync setup complete"
