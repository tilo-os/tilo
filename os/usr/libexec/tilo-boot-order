#!/usr/bin/python3
"""Enlist a successfully booted Tilo after Windows without changing the default.

Run manually after checking the first Tilo boot. The supplied identities come
from the physical install readback and its armed-boot receipt, not discovery by
label. This command never creates or replaces an EFI boot option.
"""

import argparse
import os
import re
import stat
import struct
import subprocess
import sys
import uuid

EFI_GLOBAL = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
LOADER_VENDOR = "4a67b082-0a4c-41cf-b6c7-440b29bb8c4f"
GUID = re.compile(r"^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")
BOOT_ID = re.compile(r"^[0-9a-fA-F]{4}$")
LOADERS = {r"\EFI\systemd\systemd-bootaa64.efi", r"\EFI\BOOT\BOOTAA64.EFI"}
WINDOWS_LOADER = r"\EFI\Microsoft\Boot\bootmgfw.efi"


class Refusal(Exception):
    pass


def var(name, vendor=EFI_GLOBAL):
    path = os.path.join(os.environ.get("TILO_BOOT_ORDER_EFIVARS", "/sys/firmware/efi/efivars"),
                        f"{name}-{vendor}")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0))
    except FileNotFoundError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Refusal(f"{name} is not a regular EFI variable")
        data = os.read(fd, 65537)
    finally:
        os.close(fd)
    if len(data) < 4 or len(data) > 65536:
        raise Refusal(f"{name} is truncated or too large")
    return data[4:]


def ids(name):
    raw = var(name)
    if raw is None:
        return None
    if len(raw) % 2:
        raise Refusal(f"{name} has odd length")
    return [f"{number:04X}" for (number,) in struct.iter_unpack("<H", raw)]


def option(boot_id):
    raw = var(f"Boot{boot_id}")
    if raw is None or len(raw) < 10:
        raise Refusal(f"Boot{boot_id} is absent or truncated")
    attributes, length = struct.unpack_from("<IH", raw)
    if not attributes & 1:
        raise Refusal(f"Boot{boot_id} is inactive")
    cursor = 6
    while cursor + 1 < len(raw) and raw[cursor:cursor + 2] != b"\0\0":
        cursor += 2
    if cursor + 2 > len(raw):
        raise Refusal(f"Boot{boot_id} has no description terminator")
    try:
        description = raw[6:cursor].decode("utf-16-le")
    except UnicodeDecodeError as error:
        raise Refusal(f"Boot{boot_id} description is invalid") from error
    cursor += 2
    path = raw[cursor:cursor + length]
    if len(path) != length:
        raise Refusal(f"Boot{boot_id} device path is truncated")
    nodes = []
    cursor = 0
    while cursor + 4 <= len(path):
        kind, subtype, size = struct.unpack_from("<BBH", path, cursor)
        if size < 4 or cursor + size > len(path):
            raise Refusal(f"Boot{boot_id} has malformed device-path node")
        nodes.append((kind, subtype, path[cursor + 4:cursor + size], size))
        cursor += size
    if cursor != len(path) or len(nodes) != 3 or [(k, s) for k, s, _, _ in nodes] != [
            (4, 1), (4, 4), (0x7f, 0xff)]:
        raise Refusal(f"Boot{boot_id} is not a single GPT partition and EFI file")
    hd, file_node, end = nodes
    if hd[3] != 42 or end[3] != 4 or hd[2][36:] != b"\x02\x02":
        raise Refusal(f"Boot{boot_id} does not name a GPT partition")
    partuuid = str(uuid.UUID(bytes_le=hd[2][20:36]))
    try:
        loader = file_node[2].decode("utf-16-le").rstrip("\0")
    except UnicodeDecodeError as error:
        raise Refusal(f"Boot{boot_id} EFI path is invalid") from error
    if not loader.startswith("\\") or "\0" in loader:
        raise Refusal(f"Boot{boot_id} EFI path is malformed")
    return (description, partuuid, loader)


def checked_state(boot_id, esp, loader):
    order = ids("BootOrder")
    current = ids("BootCurrent")
    next_boot = ids("BootNext")
    if not order or len(order) != len(set(order)):
        raise Refusal("BootOrder is absent, empty or duplicated")
    if current != [boot_id]:
        raise Refusal("Tilo is not the current Boot####; boot Tilo first")
    if next_boot is not None:
        raise Refusal("BootNext is occupied; refusing to change persistent order")
    first = option(order[0])
    if first[2].casefold() != WINDOWS_LOADER.casefold() or first[1] == esp:
        raise Refusal("Windows Boot Manager is not the first BootOrder entry on a separate ESP")
    originals = {}
    for entry in set(order + [boot_id]):
        originals[entry] = var(f"Boot{entry}")
        option(entry)
    target = option(boot_id)
    if target[0] != "Tilo" or target[1] != esp or target[2].casefold() != loader.casefold():
        raise Refusal("Tilo Boot#### does not match its expected ESP, label and loader")
    reported = var("LoaderDevicePartUUID", LOADER_VENDOR)
    if reported is None:
        raise Refusal("systemd-boot did not report its loaded ESP")
    try:
        loaded = reported.decode("utf-16-le").rstrip("\0").lower()
    except UnicodeDecodeError as error:
        raise Refusal("LoaderDevicePartUUID is malformed") from error
    if loaded != esp:
        raise Refusal("the running systemd-boot loaded from another ESP")
    return order, originals


def enlist(boot_id, esp, loader):
    order, originals = checked_state(boot_id, esp, loader)
    if boot_id in order:
        print(f"Boot{boot_id} is already in BootOrder; Windows remains first")
        return
    # Detect changes between validation and the only mutation.
    if checked_state(boot_id, esp, loader) != (order, originals):
        raise Refusal("firmware changed before BootOrder update")
    wanted = order + [boot_id]
    result = subprocess.run([os.environ.get("TILO_BOOT_ORDER_EFIBOOTMGR", "efibootmgr"),
                             "-q", "-o", ",".join(wanted)], capture_output=True, text=True)
    if result.returncode:
        raise Refusal("efibootmgr failed: " + result.stderr.strip())
    if ids("BootOrder") != wanted or ids("BootNext") is not None or ids("BootCurrent") != [boot_id] \
            or any(var(f"Boot{entry}") != raw for entry, raw in originals.items()):
        raise Refusal("firmware readback differs; inspect efibootmgr -v before further changes")
    print(f"Boot{boot_id} appended to BootOrder; Windows remains first")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("enlist", choices=["enlist"])
    parser.add_argument("--esp-partuuid", required=True)
    parser.add_argument("--boot-id", required=True)
    parser.add_argument("--loader", required=True)
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise Refusal("run as root after validating Tilo's first boot")
    if not GUID.fullmatch(args.esp_partuuid) or not BOOT_ID.fullmatch(args.boot_id):
        raise Refusal("expected a canonical ESP GUID and four-digit Boot ID")
    if args.loader.casefold() not in {path.casefold() for path in LOADERS}:
        raise Refusal("loader must be the ARM64 systemd-boot primary or fallback path")
    enlist(args.boot_id.upper(), args.esp_partuuid.lower(), args.loader)


if __name__ == "__main__":
    try:
        main()
    except (Refusal, OSError) as error:
        print(f"tilo-boot-order: {error}", file=sys.stderr)
        sys.exit(1)
