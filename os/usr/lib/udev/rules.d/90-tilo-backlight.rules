# Backlight and keyboard-LED brightness, writable by the session user.
#
# The kernel creates /sys/class/backlight/<dev>/brightness owned by
# root:root 0644, so an unprivileged compositor cannot dim the screen.
# Every desktop solves this the same way — hand the attribute to a group
# the session user is in — and Tilo carries its own copy of that rule
# rather than pulling in `brightnessctl` for the rule it happens to ship
# alongside a binary we do not otherwise need. See the design note at the
# top of crates/system/os-actions/src/display.rs.
#
# The session user joins `video` in tilo-firstboot-user. `greetd` is
# already in it (see os/Containerfile), so the greeter can dim too.
#
# `chgrp`/`chmod` run through RUN+= rather than MODE=/GROUP= because the
# attribute file is created by the driver after the device node, and the
# device-node assignments do not propagate to it.
ACTION=="add", SUBSYSTEM=="backlight", \
  RUN+="/usr/bin/chgrp video /sys/class/backlight/%k/brightness", \
  RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness"

ACTION=="add", SUBSYSTEM=="leds", KERNEL=="*::kbd_backlight", \
  RUN+="/usr/bin/chgrp video /sys/class/leds/%k/brightness", \
  RUN+="/usr/bin/chmod g+w /sys/class/leds/%k/brightness"
