# /dev/uinput for the seat's active user.
#
# A game controller another of the person's devices sends here plays through a
# virtual pad the session creates on /dev/uinput (os-actions'
# UinputGamepadDeviceProvider), as the person, not as root. `uaccess` grants
# the active local session rather than a group, and must be tagged before
# 73-seat-late.rules applies it. static_node lets the ACL apply to the node
# systemd creates before the module loads.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
