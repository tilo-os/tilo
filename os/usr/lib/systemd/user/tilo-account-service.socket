[Unit]
Description=Tilo accounts service activation socket
PartOf=tilo-graphical-session.target

[Socket]
ListenStream=%t/tilo/services/accounts.sock
SocketMode=0600
DirectoryMode=0700
Backlog=16
RemoveOnStop=yes
Service=tilo-account-service.service

[Install]
WantedBy=tilo-graphical-session.target
