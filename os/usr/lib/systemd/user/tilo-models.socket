[Unit]
Description=Tilo local-model manager activation socket
Documentation=file:///usr/share/doc/tilo/system-extensions.md
PartOf=tilo-graphical-session.target

[Socket]
ListenStream=%t/tilo/services/models.sock
SocketMode=0600
DirectoryMode=0700
Backlog=16
RemoveOnStop=yes
Service=tilo-models.service

[Install]
WantedBy=tilo-graphical-session.target
