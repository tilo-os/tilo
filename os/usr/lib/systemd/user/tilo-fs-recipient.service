[Unit]
Description=Tilo received collaborative files service
Documentation=https://github.com/tilo/tilo
PartOf=graphical-session.target

[Service]
Type=simple
# The launcher connects to this per-user socket and passes only the connected
# descriptor into sandboxed Files. Bearer URIs never enter process arguments.
# Create the FUSE and cache roots before the sandbox treats a missing
# `-%h/...` path as absent and then refuses create_dir_all on a read-only home.
ExecStartPre=-/usr/bin/mkdir -p %h/Shared %h/.cache/tilo/received-files
ExecStart=/usr/bin/fs recipient-service --socket %t/tilo/services/tilo-fs.sock --mounts-root %h/Shared --cache-root %h/.cache/tilo/received-files
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s

# Recipient mounts require `fusermount3`'s privilege transition in supervised
# children, so NoNewPrivileges must remain off. A nested user session cannot
# remount /dev/mqueue; ProtectSystem/ProtectHome/ProtectKernel* exit 226
# before the binary starts, which is why #1927's idle wrap never ran.
PrivateTmp=yes
PrivateIPC=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
# Activated by tilo-fs-recipient.socket only when Files first requests it.
