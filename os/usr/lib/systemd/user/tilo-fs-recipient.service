[Unit]
Description=Tilo received collaborative files service
Documentation=https://github.com/tilo/tilo
PartOf=graphical-session.target

[Service]
# Session-critical: file access the person is waiting on (see
# os/etc/systemd/user/session.slice.d).
Slice=session.slice
Type=simple
# The launcher connects to this per-user socket and passes only the connected
# descriptor into sandboxed Files. Bearer URIs never enter process arguments.
# The FUSE and cache roots come from user-tmpfiles.d/tilo-fs.conf: the home
# is read-only in the sandbox, and a user unit with PrivateIPC=yes cannot
# run a second sandboxed process such as an ExecStartPre (systemd 259:
# 226/NAMESPACE).
ExecStart=/usr/bin/fs recipient-service --socket %t/tilo/services/tilo-fs.sock --mounts-root %h/Shared --cache-root %h/.cache/tilo/received-files
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s

# The sandbox below runs in a user namespace that maps only this account, so
# the root-owned device key would read as owned by nobody and be refused. The
# service manager, a member of tilo-identity, reads it and passes the service
# its own copy. Before enrollment there is no key: the placeholder is no key,
# and the service waits idle instead of failing to start.
LoadCredential=device-key:/var/lib/tilo/device-private/keypair.bin
SetCredential=device-key:absent

# Recipient mounts require `fusermount3`'s privilege transition in supervised
# children, so NoNewPrivileges must remain off. Other kernel-facing surfaces
# stay restricted.
PrivateTmp=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Shared %h/.cache/tilo %h/.cache/tilo/received-files %t/tilo
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
# Activated by tilo-fs-recipient.socket only when Files first requests it.
