[Unit]
Description=Prepare Tilo per-user model and provider storage
Documentation=file:///usr/share/doc/tilo/system-extensions.md
Before=tilo-models.service tilo-model-gateway.service
PartOf=tilo-graphical-session.target

[Service]
Type=oneshot
UMask=0077
# Writable-path allow-lists are applied before ExecStart. Prepare the paths in
# an unconstrained one-shot before either confined model namespace is built.
ExecStart=/usr/bin/systemd-tmpfiles --user --create /usr/lib/user-tmpfiles.d/tilo-model-manager.conf
RemainAfterExit=yes
