[Unit]
Description=Remove your test fixture caches nothing has used lately

[Service]
# Nothing here is a person waiting: the work yields to the desktop while it
# runs, and is what systemd-oomd takes memory back from first
# (os/etc/systemd/user/background.slice.d/50-tilo-batch.conf).
Slice=background.slice
Type=oneshot
# Policy: ~/.config/tilo/cache-gc.toml, else /etc/tilo/cache-gc.toml. Without a
# test cache (~/.cache/tilo/test-env) it does nothing and records nothing.
ExecStart=/usr/bin/tilo os clean
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
NoNewPrivileges=yes
