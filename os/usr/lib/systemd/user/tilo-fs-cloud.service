[Unit]
Description=Tilo cloud account folders
Documentation=https://github.com/qos/qos
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Sync is batch work: it yields to everything the person is using and is the
# first thing the OOM policy reclaims (see os/etc/systemd/user/background.slice.d).
Slice=background.slice
Type=simple
# One mount per enabled cloud storage account (WebDAV, Nextcloud, Google
# Drive, OneDrive, Dropbox, iCloud Drive) under ~/Remote. The service reads
# the account store and each account's short-lived credential from the
# handoff store; it never opens the account vault. When a credential is
# missing, expired or rejected it runs Settings' credential helper, which
# alone opens the vault for that call and publishes a fresh short-lived
# credential. Each `fs mount-cloud` child receives only its own account's
# credential on stdin. Per-account metadata, queued uploads and the content
# cache live under the state dir: queued edits are not a cache and must
# survive cache cleaning.
# The sandbox below makes the home read-only, so the mounts root comes from
# user-tmpfiles.d/tilo-fs.conf (in /usr/share) and the accounts directory from
# ConfigurationDirectory=. No ExecStartPre: under systemd 259 a user unit
# with PrivateIPC=yes cannot start a second sandboxed process (its IPC
# namespace setup fails with EPERM and the next exec exits 226/NAMESPACE).
Environment=TILO_ACCOUNT_CREDENTIAL_HELPER=/usr/libexec/tilo-account-credential
# Two control sockets, each the user's alone and carrying no credential.
# Settings' sandbox is granted tilo-fs-cloud/, whose account socket lists the
# mounts and syncs, pauses and resumes them, and refuses file requests.
# File requests (revisions, restore, share links) are served only on the file
# socket in a sibling directory, so that grant never reaches them.
ExecStart=/usr/bin/fs cloud-service --mounts-root %h/Remote --state-root %S/tilo/cloud --control-socket %t/tilo-fs-cloud/control.sock --file-socket %t/tilo-fs-cloud-files/files.sock
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s

# Mounts need `fusermount3`'s privilege transition in the children, so
# NoNewPrivileges must remain off. Settings' account store and the handoff
# store are read through the read-only home; the handoff key comes from the
# session's Secret Service. The accounts directory stays writable for the
# account status store and for the credential helper this service runs,
# which seals rotated grants back into the vault and publishes handoff
# credentials; nothing else under the config directory is.
PrivateTmp=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Remote %S/tilo %E/tilo %E/tilo/accounts
ConfigurationDirectory=tilo/accounts
StateDirectory=tilo/cloud
# Kept across restarts (and created at login by user-tmpfiles.d): Settings'
# sandbox binds tilo-fs-cloud, so a restarted service's socket shows through.
# tilo-fs-cloud-files holds the file socket, outside that grant.
RuntimeDirectory=tilo-fs-cloud tilo-fs-cloud-files
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=graphical-session.target
