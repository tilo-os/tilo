[Unit]
Description=Tilo cloud account folders
Documentation=https://github.com/qos/qos
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# One mount per enabled cloud storage account (WebDAV, Nextcloud, Google
# Drive, OneDrive, Dropbox, iCloud Drive) under ~/Remote. The service reads
# the account store and each account's short-lived credential from the
# handoff store; it never opens the account vault. When a credential is
# missing, expired or rejected it runs Settings' credential helper, which
# alone opens the vault for that call and publishes a fresh short-lived
# credential. Each `fs mount-cloud` child receives only its own account's
# credential on stdin. Per-account metadata, queued uploads and the content
# cache live under the state dir: queued edits are not a cache and must
# survive cache cleaning.
# Create the mounts root and the accounts directory first so an
# unconfigured session does not fail on a missing parent.
ExecStartPre=+/usr/bin/mkdir -p %h/Remote
ExecStartPre=-/usr/bin/mkdir -p %E/tilo/accounts
Environment=TILO_ACCOUNT_CREDENTIAL_HELPER=/usr/libexec/tilo-account-credential
ExecStart=/usr/bin/fs cloud-service --mounts-root %h/Remote --state-root %S/tilo/cloud
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s

# Mounts need `fusermount3`'s privilege transition in the children, so
# NoNewPrivileges must remain off. The session user manager cannot set up
# a systemd mount namespace (`/dev/mqueue`: EPERM → 226/NAMESPACE), so
# ProtectSystem/ProtectHome/ProtectKernel* — the directives that remount
# those — stay off, as on tilo-ush. The slot is already the sandbox.
PrivateTmp=yes
PrivateIPC=yes
ConfigurationDirectory=tilo/accounts
StateDirectory=tilo/cloud
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=graphical-session.target
