[Unit]
Description=Tilo per-user hosted model gateway
Documentation=file:///usr/share/doc/tilo/model-gateway.md
After=network-online.target
Wants=network-online.target
PartOf=tilo-graphical-session.target
Requires=tilo-model-storage.service
After=tilo-model-storage.service

[Service]
Type=simple
ExecStart=/usr/bin/tilo-model-gateway serve --socket %t/tilo/services/model-gateway.sock
Restart=on-failure
RestartSec=2
UMask=0077
RuntimeDirectory=tilo
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/tilo %t/tilo
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
