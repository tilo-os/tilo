[Unit]
Description=qOS Iroh peer-sync (opt-in)
Documentation=file:///usr/share/doc/qos/peer-sync.md
# Peer-sync is privacy-sensitive because it makes the device reachable to
# invited peers. We deliberately do NOT bind this to
# graphical-session.target so a `systemctl --user enable` only takes
# effect on the *next* session — preventing a silent enable from being
# the user's first surprise at login.
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
# This unit is the **opt-in mechanism**, not the runtime carrier:
# enabling it sets a marker file that the next `shell` invocation
# can consult (via the wayland-sessions menu — pick the "nirios
# (peer-sync)" entry, or wire your own login script). The unit itself
# touches the marker on start and removes it on stop, so
# `systemctl --user start shell-peer-sync` is the supported way
# to enable peer-sync until the compositor grows a real config file.
Type=oneshot
RemainAfterExit=yes
# Marker path mirrors what the `shell` binary actually reads
# (see `shell/src/compositor/mod.rs::XdgConfigMarkerSource`):
# `$XDG_CONFIG_HOME/quick-desktop/peer-sync.enabled` with a fallback
# to `~/.config/quick-desktop/peer-sync.enabled`. Persistent across
# reboots — matches "opt in until I turn it off."
ExecStart=/usr/bin/sh -c 'XDG="${XDG_CONFIG_HOME:-$HOME/.config}"; mkdir -p "$XDG/quick-desktop" && touch "$XDG/quick-desktop/peer-sync.enabled"'
ExecStop=/usr/bin/sh -c 'XDG="${XDG_CONFIG_HOME:-$HOME/.config}"; rm -f "$XDG/quick-desktop/peer-sync.enabled"'

[Install]
# NOT WantedBy=graphical-session.target on purpose — users opt in
# explicitly via `systemctl --user enable shell-peer-sync`.
WantedBy=default.target
