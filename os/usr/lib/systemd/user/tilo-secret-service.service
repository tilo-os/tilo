[Unit]
Description=Tilo Secret Service (org.freedesktop.secrets)
Documentation=file:///usr/share/doc/tilo/secret-service.md
# Started by D-Bus activation the first time a libsecret client or the
# desktop portal asks for org.freedesktop.secrets. The store opens with the
# device identity, so no login method matters and nothing asks for a password.

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/libexec/tilo/tilo-secret-service serve
# The import of an older login keyring waits for GNOME Keyring's daemon, which
# the PAM session exported through GNOME_KEYRING_CONTROL (tilo-session hands it
# to the user manager).
Restart=on-failure
RestartSec=2
UMask=0077
# The device key is readable through the tilo-identity group the user manager
# holds; the vault lives in ~/.local/share/tilo/secrets.
#
# Identifying a caller reads /proc/<pid>/{exe,cgroup,root} of the person's own
# processes, which the kernel allows only from the same user namespace. A user
# manager gives a unit a namespace of its own (PrivateUsers) for any mount or
# kernel protection (ProtectSystem, ProtectHome, ReadWritePaths, Private*,
# ProtectKernel*, ProtectControlGroups, ProtectClock, ProtectHostname), and
# from there no caller could be named. So the unit sandboxes only with what
# needs no namespace, and ProtectProc stays off. Without one it cannot drop a
# capability bounding set either; the person's processes hold no capabilities,
# and NoNewPrivileges keeps it so.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
