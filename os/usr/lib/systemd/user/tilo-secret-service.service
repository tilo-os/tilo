[Unit]
Description=Tilo Secret Service (org.freedesktop.secrets)
Documentation=file:///usr/share/doc/tilo/secret-service.md
# Started by D-Bus activation the first time a libsecret client or the
# desktop portal asks for org.freedesktop.secrets. The store opens with the
# device identity, so no login method matters and nothing asks for a password.

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/bin/tilo-secret-service serve
# The import of an older login keyring waits for GNOME Keyring's daemon, which
# the PAM session exported through GNOME_KEYRING_CONTROL (tilo-session hands it
# to the user manager).
Restart=on-failure
RestartSec=2
UMask=0077
# The device key is readable through the tilo-identity group the user manager
# holds; the vault lives in ~/.local/share/tilo/secrets.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/tilo/secrets
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
# Identifying a caller reads /proc/<pid>/{exe,cgroup,root} of the person's
# own processes; ProtectProc would hide them.
