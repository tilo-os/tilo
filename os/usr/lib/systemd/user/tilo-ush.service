[Unit]
Description=Tilo confined shell runtime supervisor
PartOf=tilo-graphical-session.target
# Every packaged app that declares `ush = "required@<v>"` in its manifest is
# refused at launch when this socket is absent — tilo-launcher's
# resolve_service_binds returns RequiredMissing rather than starting an app
# whose shell would be unconfined. apps/terminal declares exactly that, so
# without this unit the Terminal cannot start at all.
#
# Socket-activated: the endpoint exists before an app can launch while the
# supervisor process, store discovery, and guest machinery stay off the login
# path until the first terminal actually connects.

[Service]
Type=simple
# Serves on $XDG_RUNTIME_DIR/tilo/services/ush.sock and brokers management
# commands to the running root — both are the defaults, spelled out here
# because they are the contract with tilo-launcher rather than an
# implementation detail.
ExecStart=/usr/libexec/tilo-ush serve --socket %t/tilo/services/ush.sock --host-root /
Restart=on-failure
RestartSec=1s
TimeoutStopSec=10s

# The supervisor must retain user-namespace/mount functionality for bubblewrap
# and must reach the environment records, its store and the images, but it has
# no reason to mutate host kernel state or share IPC/keyring state with the
# desktop session.
PrivateTmp=yes
PrivateIPC=yes
# These directives create a systemd mount namespace that prevents this trusted
# supervisor from constructing the nested Bubblewrap guest: `/proc` mounts fail
# with EPERM and the `/usr` OverlayFS mount fails with EINVAL. The app never
# receives those powers; Bubblewrap unshares the guest and ush immediately
# installs seccomp and Landlock before starting its shell.
ProtectControlGroups=yes
ProtectClock=yes
# Keep the supervisor out of the host UTS namespace while allowing Bubblewrap
# to name its nested guest. `yes` also denies sethostname(2) to descendants and
# makes ush exit before Terminal receives its first prompt.
ProtectHostname=private
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
