[Unit]
Description=Tilo confined shell runtime supervisor
PartOf=tilo-graphical-session.target
# Every packaged app that declares `ush = "required@<v>"` in its manifest is
# refused at launch when this socket is absent — tilo-launcher's
# resolve_service_binds returns RequiredMissing rather than starting an app
# whose shell would be unconfined. apps/terminal declares exactly that, so
# without this unit the Terminal cannot start at all.
#
# Socket-activated: the endpoint exists before an app can launch while the
# supervisor process, store discovery, and guest machinery stay off the login
# path until the first terminal actually connects.

[Service]
Type=simple
# Serves on $XDG_RUNTIME_DIR/tilo/services/ush.sock and brokers management
# commands to the running root — both are the defaults, spelled out here
# because they are the contract with tilo-launcher rather than an
# implementation detail.
ExecStart=/usr/libexec/tilo-ush serve --socket %t/tilo/services/ush.sock --host-root /
# systemd-sysext can report current_exe as /libexec/tilo-ush, a dentry
# relative to its /usr overlay rather than a usable path. The supervisor and
# guest helper must re-exec the same image-owned binary used by this unit.
Environment=TILO_USH_BIN=/usr/libexec/tilo-ush
Restart=on-failure
RestartSec=1s
TimeoutStopSec=10s

# The supervisor reads the machine's device key, root-owned and shared through
# the tilo-identity group, and proves it to the session. A user manager gives a
# unit a user namespace of its own (PrivateUsers) for any mount, IPC, clock,
# hostname or control-group protection, and in it root is unmapped: the key's
# owner reads as 65534, the key reader refuses it, and the Terminal gets no
# shell. So the unit sets no namespace directive: the supervisor runs as the
# person with no capabilities and reaches nothing more without them. The guest
# is confined by Bubblewrap, then ush's seccomp and Landlock, before its shell.
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
