[Unit]
Description=Tilo per-user verified local model manager
Documentation=file:///usr/share/doc/tilo/system-extensions.md
After=network-online.target
Wants=network-online.target
PartOf=tilo-graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/tilo-model-manager serve --socket %t/tilo/services/models.sock
Restart=on-failure
RestartSec=2
UMask=0077
# Creates `%t/tilo` before the daemon binds `services/models.sock`; user
# tmpfiles creates the persistent model and rootless-Container directories.
RuntimeDirectory=tilo
RuntimeDirectoryMode=0700
# User tmpfiles normally runs when the user manager starts. Run this narrowly
# scoped definition here too, so a first Settings launch has writable model
# and rootless-Podman state even before that normal timer has fired.
ExecStartPre=/usr/bin/systemd-tmpfiles --user --create /usr/lib/user-tmpfiles.d/tilo-model-manager.conf

# Settings receives only the connected models@1 descriptor. This service owns
# network transfers, the content-addressed user store, and Podman supervision.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/tilo %h/.local/share/containers %t/tilo
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
