[Unit]
Description=Update your apps to their newest builds

[Service]
Type=oneshot
# Same rule as the system update: nothing is fetched over a connection the
# owner asked to spare (os/usr/libexec/tilo-update-policy-check).
ExecCondition=/usr/libexec/tilo-update-policy-check
# Every installed app to the newest build this system can run; a build for
# other interface versions is never offered (docs/architecture/compatibility.md).
ExecStart=/usr/bin/app update
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
NoNewPrivileges=yes
