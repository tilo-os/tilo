[Unit]
Description=qOS per-user hosted model gateway
Documentation=file:///usr/share/doc/qos/model-gateway.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/qos-model-gateway serve --socket %t/qos/services/model-gateway.sock
Restart=on-failure
RestartSec=2
UMask=0077
RuntimeDirectory=qos
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/qos %t/qos
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
