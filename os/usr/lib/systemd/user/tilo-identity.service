[Unit]
Description=Tilo identity-chain migration and repair for this user
Documentation=man:shell(1)
# This is deliberately not the first-login identity ceremony. The compositor
# OOBE creates a missing personal identity after the user acknowledges it.
# When an identity already exists, this unit idempotently repairs or
# migrates its certified shared device-key chain.
Before=graphical-session-pre.target
PartOf=graphical-session.target
# This helper is a versioned migration/repair, not a session daemon. A marker
# is published only by ExecStartPost after successful validation; failures are
# retried next login. Bump the marker name when the repair schema changes.
ConditionPathExists=%E/tilo/identity/primary.json
ConditionPathExists=!%E/tilo/identity/.chain-v1-repaired

[Service]
Type=oneshot
RemainAfterExit=yes
# Resolver-aware, idempotent migration/repair. A missing identity is a clean
# no-op; only trusted compositor chrome may run the interactive OOBE.
ExecStart=/usr/bin/shell --provision-identity
ExecStartPost=/usr/bin/mkdir -p %E/tilo/identity
ExecStartPost=/usr/bin/touch %E/tilo/identity/.chain-v1-repaired
UMask=0077
LimitCORE=0

# The identity file is the most sensitive thing this user owns. Keep the
# minting process away from everything it does not need.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=read-only
# Repair may update the selected personal identity record and publish only the
# root/certificate portions of the shared machine chain. The protected device
# key remains readable through its tilo-identity group permission, never writable.
ReadWritePaths=-%E/tilo/identity /var/lib/tilo/user-identity /var/lib/tilo/device
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RemoveIPC=yes
KeyringMode=private
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Repair is local key/certificate work. It has no reason to touch the network.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical-session-pre.target
