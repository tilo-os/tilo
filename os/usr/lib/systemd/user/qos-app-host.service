[Unit]
Description=qOS app host (verified package store and launch broker)
After=qos-graphical-session.target
PartOf=qos-graphical-session.target

[Service]
Type=notify
ExecStart=/usr/libexec/qos-app-host --socket %t/qos/services/app-host.sock --store %S/qos-app-host
Restart=on-failure
RestartSec=1
RuntimeDirectory=qos/services
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=qos-app-host
StateDirectoryMode=0700
ReadWritePaths=%S/qos-app-host

[Install]
WantedBy=qos-graphical-session.target
