[Unit]
Description=Tilo: harden /proc with hidepid (hide other users' processes)
Documentation=https://github.com/nirios/quickdesktop
# The global remount is quick, but must finish before any untrusted login
# process can inspect another user's /proc entries.
After=local-fs.target
Before=systemd-user-sessions.service greetd.service

[Service]
Type=oneshot
# hidepid=invisible (2): non-root users see only their own processes. root
# (systemd, logind, polkit) is exempt, so privileged services are unaffected.
ExecStart=/usr/bin/mount -o remount,hidepid=invisible /proc
RemainAfterExit=yes
TimeoutStartSec=5
UMask=0077
NoNewPrivileges=yes
# A global remount inherently needs CAP_SYS_ADMIN. Drop every unrelated
# capability and constrain the helper around that single operation. Do not use
# PrivateMounts/ProtectSystem/ProtectProc here: each creates a private mount
# namespace and would make the hardening invisible to the rest of the system.
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallFilter=~@debug @keyring @network-io @obsolete @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
