[Unit]
Description=Keep the shared app runtime's libraries in memory
# Every Tilo app maps the same runtime library (libruntime_dylib.so, with
# libstd and the C library of its bundle). Cold, paging it in was most of a
# cold app start. This maps those libraries of every runtime the system
# registry names, read-only, and locks them, so the page cache holds them
# once for every app of every person (crates/packaging/launcher/src/
# runtime_resident.rs). It runs no app code and starts no app.
# After an extension merge replaces /usr, tilo-extension-activate.service
# restarts it so it holds the new files.
After=local-fs.target tilo-extension-activate.service

[Service]
Type=exec
ExecStart=/usr/bin/tilo-launcher runtime-resident
# Locking ~150 MB of file pages needs the limit raised; no capability does it.
LimitMEMLOCK=infinity
# Read once at boot, behind everything that is waiting on the disk.
IOSchedulingClass=idle
Nice=19
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=graphical.target
