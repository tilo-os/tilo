[Unit]
Description=Handle one fixed qOS system-extension request
Documentation=file:///usr/share/doc/qos/system-extensions.md
After=local-fs.target

[Service]
Type=oneshot
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=/usr/libexec/qos-system-extension-dispatch

# The peer can select only a literal activation class. It cannot supply an
# artifact, a model manager override path, a command, or a reboot request.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @obsolete @cpu-emulation @module @clock @debug @pkey
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/qos/system-extension-api /run/qos/system-extensions /var/lib/qos/system-extensions
ReadOnlyPaths=/usr/share/qos/system-extensions
