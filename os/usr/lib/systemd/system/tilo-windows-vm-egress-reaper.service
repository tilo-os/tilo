[Unit]
Description=Tilo Windows temporary egress lease reaper
Documentation=file:///usr/share/doc/tilo/windows-vm.md
After=virtqemud.service virtnetworkd.service
# No Windows VM may own an egress lease on the disposable installer. Avoid a
# guaranteed controller failure; the installed UKI does not carry this marker.
ConditionKernelCommandLine=!tilo.install

[Service]
# Started by tilo-windows-vm-egress-lease.path while a lease record exists and
# by tilo-windows-vm-egress-reaper.timer on a provisioned machine. One pass
# retires expired leases and refreshes the status summary; with a lease left
# it sleeps until that lease expires and exits once none remains.
Type=exec
ExecStart=/usr/libexec/tilo-windows-vm-control egress-reap --until-idle
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# The controller lock, lease records and published summaries live here; the
# rest of /run stays read-only under ProtectSystem=strict.
ReadWritePaths=/run/tilo/windows-egress
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
# The controller repairs /run/tilo/windows-egress to mode 2750 before publishing
# status for the tilo-identity group. RestrictSUIDSGID would make that defensive
# chmod fail with EPERM even though tmpfiles normally creates the directory with
# the same setgid mode.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @obsolete @cpu-emulation @module @clock @debug @pkey
SystemCallErrorNumber=EPERM
