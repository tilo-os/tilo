[Unit]
Description=Provision the Tilo machine device identity
# Early boot, before sysinit.target: tilo-device-branch.service records which
# machine the key belongs to right after this mints it, and both precede
# everything that uses the key. Ordered after sysinit.target, as its default
# dependencies had it, the two closed a cycle and systemd dropped the branch
# unit from every boot.
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target
Before=tilo-firstboot.service greetd.service fs.service
Conflicts=shutdown.target
Before=shutdown.target
# Every boot, not only the first: the key is the device daemon's, which runs as
# `tilo`, so this gives the key and its directory that account, 0600 and 0700,
# each time. A re-key, an installer's copy or an install from before this rule
# can have left another owner or mode, and the daemon reads just the one.

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo/tilo-device-key-init
RemainAfterExit=yes
UMask=0027
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tilo/device-private
# Provisioning creates the public certificate directory beside the key.
ReadWritePaths=/var/lib/tilo/device
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# The key is the daemon account's file inside that account's 0700 directory.
# CAP_DAC_OVERRIDE reaches it and, on a computer with no key yet, creates it
# (a write; reading alone would take CAP_DAC_READ_SEARCH). CAP_CHOWN gives both
# to `tilo`, CAP_FOWNER their modes.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @network-io @privileged @resources @obsolete @debug @swap
# `@chown` is part of `@privileged`, which the line above denies. The first allow
# list fixes the default action and a later allow list adds back what it names:
# the one call that gives the key its owner. It is `chown(2)` on x86_64 and
# `fchownat(2)` on the generic syscall table (arm64), where the kernel has no
# `chown`; systemd logs a name it does not know for that architecture and goes on.
SystemCallFilter=chown fchownat

[Install]
WantedBy=sysinit.target
