[Unit]
Description=Provision the root-owned Tilo machine device identity
# Early boot, before sysinit.target: tilo-device-branch.service records which
# machine the key belongs to right after this mints it, and both precede
# everything that reads the key. Ordered after sysinit.target, as its default
# dependencies had it, the two closed a cycle and systemd dropped the branch
# unit from every boot.
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target
Before=tilo-firstboot.service greetd.service fs.service
Conflicts=shutdown.target
Before=shutdown.target
# This unit is ordered before login to mint the key, but an established
# machine should not start a process merely to read the same persistent key on
# every boot.
ConditionPathExists=!/var/lib/tilo/device-private/keypair.bin

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo/tilo-device-key-init
RemainAfterExit=yes
UMask=0027
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tilo/device-private
# Provisioning creates the public certificate directory beside the key.
ReadWritePaths=/var/lib/tilo/device
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @network-io @privileged @resources @obsolete @debug @swap

[Install]
WantedBy=sysinit.target
