[Unit]
Description=Confirm this OS generation and raise the rollback floor
Documentation=man:tilo-rollback(8)
# Everything the health gate inspects has to have had its chance to fail first.
After=multi-user.target greetd.service fs.service
# Never block or delay the boot: this is deliberately late and deliberately
# optional. A machine that never reaches it simply keeps its fallback, which is
# the safe direction.
ConditionPathExists=/usr/bin/tilo-rollback

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-rollback-confirm
RemainAfterExit=no
# The NV counter and the LUKS header both need real privilege; everything else is
# taken away.
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Writes the bookkeeping file and reads the proof secret from /run.
ReadWritePaths=/var/lib/tilo /run/tilo-rollback
