[Unit]
Description=Sign a newly staged deployment's kernel
Documentation=file:///usr/share/doc/qos/secure-boot.md
# A `bootc upgrade` writes a new deployment directory under /boot/ostree with a
# kernel nothing has signed. Waiting for the next boot to sign it is too late —
# that boot is the one the firmware would refuse. Signing on the directory change
# closes the window whether the update came from the timer or from a hand-run
# upgrade about to be followed by a reboot.
ConditionPathExists=/var/lib/qos/secureboot/db.key

[Path]
PathChanged=/boot/ostree
# The ESP loaders are the other half, and the one with no natural second chance.
# `bootupctl update` replaces systemd-bootx64.efi and BOOTX64.EFI with unsigned
# copies, and the boot that would notice is the boot the firmware refuses — so
# unlike a staged kernel, there is no later opportunity to fix it. Nothing else
# watches the ESP, so watch it here.
PathChanged=/boot/efi/EFI/systemd
PathChanged=/boot/efi/EFI/BOOT
# PathChanged on a directory fires when entries appear or vanish; PathModified
# also fires when a file inside is written in place, which is what an updater
# that rewrites rather than renames does.
PathModified=/boot/efi/EFI/systemd
PathModified=/boot/efi/EFI/BOOT
Unit=qos-secureboot-sign.service

[Install]
WantedBy=paths.target
