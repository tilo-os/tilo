[Unit]
Description=Tilo verified local-model runtime
Documentation=file:///usr/share/doc/tilo/system-extensions.md
After=tilo-system-extension-userspace.service network.target
Wants=tilo-system-extension-userspace.service
ConditionPathExists=/usr/libexec/tilo-local-model-service
ConditionPathExists=/run/tilo/system-extensions/userspace-ready

[Service]
Type=notify
# Stable service contract for the local-model service crate. The binary is
# intentionally not shipped until that crate exists; Conditions make this a
# clean skip rather than a failed boot. Request data is root-owned verified
# state, never command-line text from a desktop, MCP tool, or agent.
ExecStart=/usr/libexec/tilo-local-model-service --contract-version 1 --state /var/lib/tilo/system-extensions/state.json --catalog /usr/share/tilo/system-extensions/catalog.d --runtime-root /var/lib/tilo/local-models/verified --activation /var/lib/tilo/local-models/activation.json --listen 127.0.0.1
User=tilo-local-model
Group=tilo-local-model
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

# The runtime reads verified packs but cannot replace them. It has no home or
# capabilities. It deliberately shares the host network namespace so its
# approved loopback endpoint is reachable by the desktop gateway; IP policy
# denies every non-loopback address, so this is not ambient network access.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
IPAddressAllow=::1/128
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @obsolete @cpu-emulation @module @clock @debug @pkey
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/var/lib/tilo/system-extensions /var/lib/tilo/local-models /usr/share/tilo/system-extensions
