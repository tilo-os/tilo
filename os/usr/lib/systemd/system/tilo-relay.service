[Unit]
Description=Tilo host + relay daemon (iroh WAN transport, workspace CRDT fan-out, store-and-forward)
Documentation=file:///usr/share/doc/tilo/relay.md
After=network-online.target tilo-relay-firstboot.service
Wants=network-online.target
Requires=tilo-relay-firstboot.service
Requires=tilo-relay-state-migrate.service
After=tilo-relay-state-migrate.service
# The relay reads /var/lib/tilo/user-identity/pubkey.bin + the device
# cert + secret written at first-boot enrollment. Those live under
# /var, so start after local filesystems are up.
After=var-lib-tilo.mount
ConditionPathExists=!/var/lib/tilo-relay/decommissioned

[Service]
Type=notify
NotifyAccess=all
User=tilo-relay
Group=tilo-relay
SupplementaryGroups=tilo-identity
# `run` blocks until SIGTERM. sd_notify(READY=1) is emitted from
# main.rs once the iroh endpoint is bound + accepting.
ExecStart=/usr/bin/tilo-relay --config /etc/tilo/relay.toml run
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
LimitCORE=0

# `/var/lib/tilo-relay` is pre-created by tmpfiles.d (see
# os/usr/lib/tmpfiles.d/tilo-host.conf) — the daemon writes there
# and requires ReadWritePaths= to punch through ProtectSystem=strict.
#
# Deliberately NOT using `DynamicUser=yes + StateDirectory=tilo-relay`:
# under SELinux enforcing on bootc, systemd's DynamicUser handling
# tries to rename the state dir at unit start (to reassign ownership
# to the runtime-allocated uid). That rename runs in the `init_t`
# domain against a target labeled `var_lib_t`, which the base policy
# refuses (avc: denied { rename }). The unit crash-loops.
# A static, unprivileged tilo-relay account removes the rename while ensuring a
# network parser is not uid 0. Its tilo-identity supplementary group grants only
# the certified device-key read boundary required for authenticated transport.

# Hardening: the relay is a network-facing daemon on an always-on
# device, so it stays behind a paranoid sandbox.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ReadWritePaths=/var/lib/tilo-relay
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_NETLINK is how the iroh endpoint enumerates its own interfaces and
# addresses. Without it the daemon reports ready with an empty address set
# and no peer can dial the host directly.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# The daemon needs to read the user's cert + relay device secret
# from the shared identity tree, so grant read access there.
ReadOnlyPaths=/etc/tilo /var/lib/tilo

[Install]
WantedBy=multi-user.target
