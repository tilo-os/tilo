[Unit]
Description=Start QuickFS when the certified device identity is created
Documentation=https://github.com/nirios/quickdesktop
ConditionPathExists=/dev/fuse
# The live installer intentionally has no durable identity. qos-install removes
# this sealed marker from the installed target before its first boot.
ConditionKernelCommandLine=!qos.install

[Path]
# Watch for creation/change rather than a permanently true PathExists predicate.
# Once fs.service starts, genuine daemon failures remain governed by its
# RestartSec backoff instead of being immediately retriggered by this path unit.
PathChanged=/var/lib/qos/device/cert.bin
Unit=fs.service

[Install]
WantedBy=multi-user.target
