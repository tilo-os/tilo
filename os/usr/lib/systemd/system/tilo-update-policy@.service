[Unit]
Description=Apply validated Tilo update policy (%i)

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-update-policy-set %i
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tilo /etc/systemd/system/bootc-fetch-apply-updates.timer.d
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
