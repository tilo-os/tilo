# The NTFS mount service starts when the shell or Settings first asks about a
# drive, never at boot: a machine that never sees an NTFS drive never runs it.
[Unit]
Description=Consent-gated NTFS mount service socket

[Socket]
ListenStream=/run/tilo-ntfs-mount/control.sock
# Open to every local process; the service decides per connection, from the
# kernel's account of the caller, who may ask what.
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
