[Unit]
Description=Tilo extension %i
Documentation=file:///usr/share/tilo/system-extensions/README.md
# The instance is <verb>:<id>. Settings and first-login setup start exactly
# install, remove or refresh (see /etc/polkit-1/rules.d/49-tilo-extension.rules);
# the helper rejects anything else and any id without an image catalogue entry.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-extension %i
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# The helper downloads pinned artifacts, verifies them and unpacks them into
# fixed trees. It never installs into /usr: merging is systemd-sysext's job,
# which the helper asks PID 1 to (re)run, so the merge happens in the host's
# mount namespace and not in this unit's private one.
ProtectSystem=strict
ReadWritePaths=/var/lib/extensions
StateDirectory=tilo/extensions
StateDirectoryMode=0755
CacheDirectory=tilo-extension
CacheDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @obsolete @cpu-emulation @module @clock @debug
SystemCallErrorNumber=EPERM
