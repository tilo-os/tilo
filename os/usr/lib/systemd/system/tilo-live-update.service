[Unit]
Description=Apply the staged system update now, without a restart
Documentation=file:///usr/share/tilo/system-extensions/README.md
# The update service stages the newest verified image (bootc, the containers
# policy's Cosign gate and, when armed, the owner's endorsement). This applies
# its changed components at once, by scope: system services restart, apps and
# the runtime are new at their next start, and what needs the desktop
# restarted waits for the desktop to ask (tilo-live-update-session.service).
# Only a kernel, bootloader or initramfs change waits for a restart of the
# machine. A failure rolls back and leaves the update to the next restart.
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-extension live:system
# The merge makes /usr new; the sandbox system view still binds the old one
# until it restarts (the helper asks for that itself).
TimeoutStartSec=30min
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
# systemd-sysext must mount over /usr in the host's mount namespace, and the
# staged image is mounted there to be read, so this unit takes no
# namespace-based sandboxing (ProtectSystem=, PrivateTmp=, ...).
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
