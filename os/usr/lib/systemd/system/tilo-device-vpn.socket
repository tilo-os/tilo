# The device VPN helper starts when the shell first asks for a tunnel, never at
# boot: a device that never routes through, or for, another of the person's
# devices never runs it.
[Unit]
Description=Device VPN helper socket

[Socket]
ListenStream=/run/tilo-device-vpn/control.sock
# Open to every local process; the helper answers only the seat's shell,
# decided per connection from the kernel's account of the caller.
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
