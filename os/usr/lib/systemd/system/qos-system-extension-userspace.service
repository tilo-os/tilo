[Unit]
Description=Authorize verified userspace system extensions for this deployment
Documentation=file:///usr/share/doc/qos/system-extensions.md
After=local-fs.target
ConditionPathExists=/var/lib/qos/system-extensions/state.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/qos-system-extension-activate userspace
RemainAfterExit=no

# This root-owned gate reads desired state and writes a runtime marker. It
# cannot install anything; the local-model service is a separate unprivileged
# process. Private networking makes the no-download invariant enforceable.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @obsolete @cpu-emulation @module @clock @debug @pkey
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/qos/system-extensions
ReadOnlyPaths=/var/lib/qos/system-extensions /usr/share/qos/system-extensions

