[Unit]
Description=Rebuild and merge the Tilo extensions turned on
Documentation=file:///usr/share/tilo/system-extensions/README.md
# The sealed image never merges what /var holds by itself: systemd-sysext's
# own service stays masked (docs/security/boot-chain.md). This unit does it on
# purpose, at every boot and after every install, refresh or removal: it checks
# each kept manifest's signature against the extension-manifest key again, checks
# every kept artifact against the manifest, rebuilds each part for the booted
# base from those bytes alone, refuses to merge if anything else is in the
# sysext search path, and then runs `systemd-sysext refresh`. Nothing written to
# /var since the last activation survives it unverified.
#
# It runs offline and alongside the rest of boot, before the graphical target.
# A part needing a new download for an updated base waits for
# tilo-extension-refresh.timer.
# Without anything turned on it returns at once; it has no start condition,
# because a removal relies on it to unmerge.
After=local-fs.target
Before=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-extension activate
# systemd-sysext must mount over /usr in the host's mount namespace, so this
# unit takes no namespace-based sandboxing (ProtectSystem=, PrivateTmp=, ...):
# any of them would give it a private namespace the merge would vanish into.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
