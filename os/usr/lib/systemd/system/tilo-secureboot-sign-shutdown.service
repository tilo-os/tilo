[Unit]
Description=Sign boot artefacts on the way down
Documentation=file:///usr/share/doc/tilo/boot-chain.md
# The last net before a reboot that the firmware might refuse.
#
# The path unit catches the two known ways artefacts go stale — a staged
# deployment, and an ESP the bootloader updater rewrote — but both depend on
# inotify firing and on the change happening somewhere we thought to watch. This
# unit needs neither: whatever touched the boot artefacts and however it did it,
# signing runs once more before the machine goes down, while there is still a
# running system to do it with. On the next boot it is far too late.
#
# Nothing to do on a machine that never generated keys.
ConditionPathExists=/var/lib/tilo/secureboot/db.key

[Service]
# The start is a no-op that exists only so systemd has something to stop; the
# work is in ExecStop, which runs during shutdown.
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/libexec/tilo-secureboot sign-at-shutdown
# Signing a handful of PE binaries is fast; do not let a wedged run hold the
# shutdown open indefinitely.
TimeoutStopSec=90
UMask=0077
LimitCORE=0
RuntimeDirectory=tilo-secureboot
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The key is unsealed only inside ExecStop. Permit exactly the TPM character
# devices while keeping every other non-pseudo device closed.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/tpm0 rw
PrivateIPC=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/var/lib/tilo/secureboot
ReadWritePaths=/boot
# The ESP is mounted read-only: signed copies are staged here and
# tilo-esp-write@secureboot-sign.service installs them.
StateDirectory=tilo/esp-plan/secureboot-sign
StateDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal+console

[Install]
WantedBy=multi-user.target
