[Unit]
Description=Fetch and stage the current image
Documentation=file:///usr/share/doc/tilo/recovery.md
RequiresMountsFor=/boot /boot/efi
After=local-fs.target network.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-deployment update --yes
# Something needs the newer system now (an app build, a member): apply
# what can apply live before this returns, so the caller sees the result
# (tilo-live-update.service).
ExecStartPost=-/usr/bin/systemctl start tilo-live-update.service
# Collect the image the update superseded (tilo-os-image-gc.service).
ExecStartPost=-/usr/bin/systemctl start --no-block tilo-os-image-gc.service
RemainAfterExit=no
# Registry download, unpacking, and deployment writes must not monopolize a
# machine whose user explicitly started an update while a game is still live.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# No RestrictSUIDSGID=: systemd's filter for it fails openat2() with ENOSYS, and
# bootc opens the registry credentials that way without falling back, so every
# fetch ended before it reached the registry:
#
#   Switching: Composefs Switching: Loading global authfile: Opening runtime
#   auth file: Function not implemented (os error 38)
#
# os/tests/os_image_gc_sandbox.sh holds this unit and the collection's to it.
RemoveIPC=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal+console
