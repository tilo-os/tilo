[Unit]
Description=Fetch and stage the current image
Documentation=file:///usr/share/doc/tilo/recovery.md
RequiresMountsFor=/boot
After=local-fs.target network.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-deployment update --yes
RemainAfterExit=no
StandardOutput=journal
StandardError=journal+console
