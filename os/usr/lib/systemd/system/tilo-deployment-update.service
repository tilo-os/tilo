[Unit]
Description=Fetch and stage the current image
Documentation=file:///usr/share/doc/tilo/recovery.md
RequiresMountsFor=/boot /boot/efi
After=local-fs.target network.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-deployment update --yes
# Something needs the newer system now (an app build, a collaborator): apply
# what can apply live before this returns, so the caller sees the result
# (tilo-live-update.service).
ExecStartPost=-/usr/bin/systemctl start tilo-live-update.service
RemainAfterExit=no
# Registry download, unpacking, and deployment writes must not monopolize a
# machine whose user explicitly started an update while a game is still live.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal+console
