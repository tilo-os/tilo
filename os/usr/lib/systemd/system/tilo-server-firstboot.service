[Unit]
Description=Tilo host first-boot — consume enrollment token and mint device cert
Documentation=file:///usr/share/doc/tilo/server.md
After=network-online.target
Wants=network-online.target
Before=tilo-server.service tilo-fs-replica.service
# Runs until both the signed device certificate and home-peer bundle
# are durable, then becomes an immediate no-op on later service starts.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tilo-server-firstboot
# Give the LAN mdns handshake generous time but do not block
# forever — a headless host may boot at 2AM with no primary device
# on the LAN. In that case the script prints its pairing token to
# the console and returns non-zero; systemd will retry on next
# boot after the operator finishes the OOB handshake.
#
# The bound also covers the sibling-slot enrolment that follows a
# successful enrollment (up to four minutes waiting for one of the
# person's devices to answer).
TimeoutStartSec=600
Restart=on-failure
RestartSec=10
StandardOutput=journal+console
StandardError=journal+console
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# A server whose planned unlock is another of the owner's devices enrols that
# LUKS2 slot here, once the enrollment above gave it the person's device
# store: that writes the volume's header and, where the machine has one,
# seals the token to the TPM. Both need the real device nodes.
PrivateDevices=no
PrivateIPC=yes
ReadWritePaths=/etc/tilo /var/lib/tilo /var/lib/tilo-server
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
