[Unit]
Description=QuickFS Collaborative Filesystem (Iroh-backed FUSE3 mount)
Documentation=https://github.com/nirios/quickdesktop
After=network-online.target
Wants=network-online.target
# The compositor session reads under /var/workspace via per-cluster
# bridge sockets in /run/user/<uid>/nirios/. Greetd brings up the
# Wayland session at graphical.target, so quick-fs must be online
# before then — otherwise the first read inside the session sees an
# empty directory.
Before=greetd.service graphical.target
DefaultDependencies=no
# Hard-fail the unit when the FUSE module isn't loadable so we don't
# silently boot the compositor with an empty mount.
ConditionPathExists=/dev/fuse
# The disposable installer has no durable device certificate. Starting the
# collaborative mount there can only enter a restart loop; qos-install removes
# this kernel marker from the target UKI, so installed systems remain enabled.
ConditionKernelCommandLine=!qos.install

[Service]
Type=simple
# /var is writable under bootc but the dirs themselves don't exist on
# a fresh image. tmpfiles.d below pre-creates them with the right perms;
# the ExecStartPre's are a belt-and-suspenders fallback for the case
# where systemd-tmpfiles-setup hasn't run yet.
ExecStartPre=/usr/bin/mkdir -p /var/workspace
ExecStartPre=/usr/bin/mkdir -p /var/cache/quick-fs
ExecStartPre=/usr/bin/install -d -m 2770 -o root -g qos-identity /run/qos
# The capability list the mount enforces. tmpfiles.d seeds it from
# /usr/share/qos/fs-capabilities.json on first boot; this is the same
# belt-and-suspenders fallback as the mkdirs above, for the case where
# systemd-tmpfiles-setup hasn't run. `-n` copies without clobbering an
# existing (possibly edited) list, and the leading `-` tolerates the
# whole step failing rather than blocking the mount on it.
ExecStartPre=/usr/bin/mkdir -p /var/lib/qos
ExecStartPre=-/usr/bin/cp -n /usr/share/qos/fs-capabilities.json /var/lib/qos/fs-capabilities.json
# The collaborative `fs` binary is subcommand-based: `serve` hosts a workspace
# and mounts it locally (what a fresh boot needs — no peer ticket); `mount`
# joins a peer's workspace via a ticket. `--cache-dir` is the persistent
# iroh-blobs content store so hydrated content survives reboots (the root stays
# read-only under bootc; the cache lives on writable /var).
# (Earlier the CLI was a flat `fs --mount-point`; it has since moved to
# `fs serve --mount-point --cache-dir`. Verified live: mounts /var/workspace,
# Iroh endpoint up, workspace hosted.)
#
# `--acl` is what makes the mount an enforcement point rather than a
# plain FUSE passthrough. Without it every open/read/write short-circuits
# to "allowed" and the capability model stops at the compositor — a path
# the permissions UI shows as revoked stays readable through
# /var/workspace. The list is re-read while the mount is up (see
# --acl-reload-secs), so a grant or a revocation takes effect without a
# remount; /var/workspace is mounted once at boot and never again during
# a session, which is why reading it only at mount time was equivalent to
# not reading it at all.
#
# `--principal person:local` is the subject the shipped list grants to.
# The shipped default uses a human-readable local principal. The mount also
# has the machine's durable certified device key, shared with the shell, so
# remote policies can name a stable cryptographic subject when required.
#
# The shipped list grants that principal read+write on the whole
# workspace — i.e. exactly the access an unenforced mount gave. This
# change does not narrow the single-user desktop; it makes the
# enforcement point live so that a restriction added to
# /var/lib/qos/fs-capabilities.json actually bites, and so a mount joined
# from a peer's ticket has somewhere to put a narrower policy.
ExecStart=/usr/bin/fs serve --mount-point /var/workspace --cache-dir /var/cache/quick-fs \
    --storage-sock /run/qos/fs-storage.sock \
    --acl /var/lib/qos/fs-capabilities.json --principal person:local
# `fusermount -u` is preferable to plain `umount` because it doesn't
# need CAP_SYS_ADMIN. `-z` makes the unmount lazy so a hung client
# can't block shutdown.
ExecStop=/usr/bin/fusermount3 -u -z /var/workspace
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
