[Unit]
Description=QuickFS Collaborative Filesystem (native store volume or Iroh-backed FUSE3 mount)
Documentation=https://code.tilo.so/tilo/tilo
After=local-fs.target network.target systemd-tmpfiles-setup.service
Wants=network.target
# The store volume (/var/lib/tilo/store) is mounted `nofail`, so local-fs.target
# does not wait for it; wait here instead. tilo-store-volume.service prepares
# it for the local person (creating an image-backed store on installs without
# a store partition) and writes the data-plane arguments below.
Wants=tilo-store-volume.service var-lib-tilo-store.mount
After=tilo-store-volume.service var-lib-tilo-store.mount
# Iroh reconnects as interfaces become usable, so waiting for
# network-online.target only stalls offline boots and does not establish a
# stronger readiness condition. Start concurrently with the greeter; the mount
# process does not need to be on graphical.target's critical path.
# Hard-fail the unit when the FUSE module isn't loadable so we don't
# silently boot the compositor with an empty mount.
ConditionPathExists=/dev/fuse
# A fresh user's certified device identity is created by the graphical OOBE.
# Starting before that ceremony is expected to fail, so skip cleanly here;
# fs-identity.path starts us as soon as cert.bin is created. Keeping this unit
# enabled starts the mount on later boots, when it exists.
ConditionPathExists=/var/lib/tilo/device/cert.bin
# The disposable installer has no durable device certificate. Starting the
# collaborative mount there can only enter a restart loop; tilo-install removes
# this kernel marker from the target UKI, so installed systems remain enabled.
ConditionKernelCommandLine=!tilo.install

[Service]
Type=simple
# `/run/tilo` has security-significant group ownership and is created by
# systemd-tmpfiles-setup, which this unit is ordered after. Do not repair it
# here: doing so would require CAP_CHOWN for the lifetime of the network daemon.
# tmpfiles creates the mountpoint, cache, state root, and initial capability
# list before local-fs.target. Do not fork redundant mkdir/cp helpers on every
# daemon start or repair security-sensitive ownership from this service.
# The collaborative `fs` binary is subcommand-based: `serve` hosts a workspace
# and mounts it locally (what a fresh boot needs — no peer ticket); `mount`
# joins a peer's workspace via a ticket. `--cache-dir` is the persistent
# iroh-blobs content store so hydrated content survives reboots (the root stays
# read-only under bootc; the cache lives on writable /var).
# (Earlier the CLI was a flat `fs --mount-point`; it has since moved to
# `fs serve --mount-point --cache-dir`. Verified live: mounts /var/workspace,
# Iroh endpoint up, workspace hosted.)
#
# `--acl` is what makes the mount an enforcement point rather than a
# plain FUSE passthrough. Without it every open/read/write short-circuits
# to "allowed" and the capability model stops at the compositor — a path
# the permissions UI shows as revoked stays readable through
# /var/workspace. The list is re-read while the mount is up, on every
# change the kernel reports for it (inotify), and polled every
# --acl-reload-secs only if it cannot be watched, so a grant or a
# revocation takes effect without a remount; /var/workspace is mounted once at boot and never again during
# a session, which is why reading it only at mount time was equivalent to
# not reading it at all.
#
# `--blob-sock` serves document media (images in notes, chat, photos, …)
# from the same content store. The launcher connects to it for each app and
# names the app and room before the app receives the descriptor, so apps only
# ever hold a scoped capability; the socket is group-connectable like the
# storage socket and never bound into a sandbox.
#
# `--principal person:local` is the subject the shipped list grants to.
# The shipped default uses a human-readable local principal. The mount also
# has the machine's durable certified device key, shared with the shell, so
# remote policies can name a stable cryptographic subject when required.
#
# The shipped list grants that principal read+write on the whole
# workspace — i.e. exactly the access an unenforced mount gave. This
# change does not narrow the single-user desktop; it makes the
# enforcement point live so that a restriction added to
# /var/lib/tilo/fs-capabilities.json actually bites, and so a mount joined
# from a peer's ticket has somewhere to put a narrower policy.
#
# The data plane. With a store volume mounted, tilo-store-volume.service
# writes `--data-plane=auto --store=/var/lib/tilo/store --native-owner=UID:GID`
# to /run/tilo-store/fs.env on every boot: the daemon then serves the native
# tree when the volume is dedicated and the kernel probes hold, and FUSE
# otherwise, logging why. `--native-owner` is the local person, who owns every
# file the native plane materialises. Without that file (no store, no local
# person yet, or the preparation failed) the daemon serves FUSE.
Environment=TILO_FS_DATA_PLANE_ARGS=--data-plane=fuse
EnvironmentFile=-/run/tilo-store/fs.env
ExecStart=/usr/bin/fs serve --mount-point /var/workspace --cache-dir /var/cache/quick-fs \
    --storage-sock /run/tilo/fs-storage.sock --blob-sock /run/tilo/fs-blobs.sock \
    --acl /var/lib/tilo/fs-capabilities.json --principal person:local \
    $TILO_FS_DATA_PLANE_ARGS
# No ExecStop=: the daemon ends its own mount. systemd's SIGTERM takes the
# daemon's stop path, which unmounts and then makes the final namespace save.
# On the FUSE data plane the mount is held by fusermount3's auto_unmount
# helper, which blocks every signal and lazily detaches /var/workspace (what
# `fusermount3 -u -z` did) as soon as the daemon releases the session or
# exits, so a hung client cannot block the stop. An `ExecStop=` naming
# fusermount3 cannot run at all: systemd checks the executable while its exec
# child is still init_t, which may not execute fusermount_exec_t, so every
# stop ended in 203/EXEC. Do not grant init_t that instead.
#
# On a machine with a dedicated store volume at /var/lib/tilo/store
# (`--store`) the daemon serves the Tier 1 data plane instead: the
# room's native tree is bind-mounted at /var/workspace and fanotify fills
# placeholders on first access. Placeholders read as holes once the daemon's
# fanotify group is gone, so the bind must never outlive the process. The
# daemon detaches it on a clean stop. This lazy umount is the backstop for
# both planes when the daemon could not: a crash, or the SIGKILL after
# TimeoutStopSec= (which also kills fusermount3's helper). It is a no-op
# after a clean stop. umount is mount_exec_t, which init_t may execute.
ExecStopPost=-/usr/bin/umount --lazy /var/workspace
Restart=always
RestartSec=5
# The FUSE mount must propagate into the host namespace, so filesystem
# namespacing directives such as ProtectSystem=/PrivateDevices= are unsafe here:
# they would produce a healthy-looking mount visible only to this service.
# Constrain the process without creating a private mount namespace instead.
# That rules out PrivateIPC= too: it mounts a fresh /dev/mqueue, so it needs a
# mount namespace, and the FUSE mount then never reaches the host.
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
KeyringMode=private
# CAP_SYS_ADMIN: the FUSE mount, or on Tier 1 the fanotify filesystem mark,
# pre-content group, Btrfs snapshots and the bind mount. CAP_DAC_READ_SEARCH:
# open_by_handle_at, which turns fanotify's directory handles into paths.
# CAP_CHOWN, CAP_FOWNER, CAP_DAC_OVERRIDE: on Tier 1 the room and every file
# in it belong to the local person, not to the daemon, yet the daemon creates
# remote files there and hands them to that person (chown), fills
# placeholders and restores their mtime and residency xattr (owner-only
# operations), and writes into directories the person owns. FUSE never needed
# them because it presents ownership instead of storing it.
# CAP_SYS_PTRACE: on Tier 1, reading /proc/<tid>/syscall and fdinfo of the
# process a leased file's permission event blocked, which tells its reads
# from its writes; without it the daemon cannot see the call and a writer
# owned by another user passes as a reader.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SYS_PTRACE
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/fuse rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallFilter=fanotify_init fanotify_mark name_to_handle_at open_by_handle_at
# The qdoc conflict merge decodes peer versions only in Automerge workers
# (tilo-automerge-isolate): re-executions of this binary that confine
# themselves with Landlock and a seccomp allow-list before reading any input.
# A worker that cannot confine itself never starts, and the merge is refused.
SystemCallFilter=seccomp landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
