[Unit]
Description=Tilo Repair Mode
Documentation=file:///usr/share/doc/tilo/repair-mode.md
# basic.target, not multi-user.target: sockets, paths, slices, the local
# filesystems and /var — everything a repair console needs to look at the machine
# — without starting the session, the compositor, the collaborative filesystem or
# the update timer. A repair mode that starts the thing that is broken is not one.
Requires=basic.target
After=basic.target
# Named individually rather than via network-online.target, which is masked in
# this image. Re-pulling the image needs a route; the other verbs do not, so
# nothing here waits for one.
Wants=network.target NetworkManager.service
After=network.target
Conflicts=rescue.service rescue.target
# Two consoles, because the machine that needs repairing decides which one a
# person can see. tty1 is the screen on a desktop; ttyS0 is the serial line on a
# server and in the VM the boot evidence is captured from. Each instance carries
# ConditionPathExists=/dev/%I, so the one that is not there is skipped rather
# than failed.
Wants=tilo-repair@tty1.service tilo-repair@ttyS0.service
AllowIsolate=yes
