[Unit]
Description=Set the TPM dictionary-attack reset authorisation and tighten its parameters
Documentation=man:tilo-rollback(8)
After=local-fs.target
ConditionPathExists=/usr/bin/tilo-rollback
# TPM character devices are alternatives. Mark both as trigger conditions so
# systemd skips this oneshot cleanly unless at least one exists; the helper
# keeps the same check as defense in depth for device-removal races.
ConditionPathExists=|/dev/tpmrm0
ConditionPathExists=|/dev/tpm0
# Never mutate the device TPM from a disposable installer environment. The
# authorisation is useful only when it is durably recorded on the installed,
# encrypted root; doing this from the live medium strands the secret there and
# makes the installed system unable to administer its own lockout policy.
ConditionKernelCommandLine=!tilo.install
# Once the authorisation has been recorded there is nothing left to do.
ConditionPathExists=!/var/lib/tilo/rollback/lockout-auth

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-rollback-harden
RemainAfterExit=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectKernelModules=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/tilo

[Install]
WantedBy=multi-user.target
