# A node's server for account %i's session: the device's one daemon, keeping the
# person's workspaces and serving them to their pages, beside the session that
# runs their apps. Enable together with tilo-node-session@%i.path.
[Unit]
Description=Tilo node server for %i's session
After=network-online.target var-lib-tilo.mount tilo-node-session-key@%i.service
Wants=network-online.target
Requires=tilo-node-session-key@%i.service
Conflicts=tilo-server.service
ConditionPathExists=/etc/tilo/node/install-token

[Service]
Type=exec
User=tilo-server
Group=tilo-server
SupplementaryGroups=tilo-identity
EnvironmentFile=/var/lib/tilo-node/%i/session.env
# The node's own device identity, installed by the person's page, and the
# workspaces it keeps for their pages.
Environment=TILO_IDENTITY_ROOT=/var/lib/tilo-node/server/identity
Environment=XDG_STATE_HOME=/var/lib/tilo-node/server/state
Environment=HOME=/var/lib/tilo-node/server TILO_RUNTIME_PROFILE=/var/lib/tilo-node/server
Environment=TILO_SERVER_CONFIG=/usr/lib/tilo/node-server.toml
StateDirectory=tilo-node/server
StateDirectoryMode=0700
RuntimeDirectory=tilo-node/%i
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/libexec/tilo/tilo-runtime
Restart=on-failure
RestartSec=5
LimitCORE=0

# The same sandbox as tilo-server.service: a network-facing daemon.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ReadWritePaths=/var/lib/tilo-node/server /var/lib/tilo-node/%i/session/device /var/lib/tilo-node/%i/session/user-identity /run/tilo-node/%i
ReadOnlyPaths=/etc/tilo /usr/lib/tilo
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
