[Unit]
Description=This server's Tilo daemon: the device's one daemon, keeping the workspaces placed on it
Documentation=file:///usr/share/doc/tilo/server.md
After=network-online.target tilo-server-firstboot.service
Wants=network-online.target
Requires=tilo-server-firstboot.service
Requires=tilo-server-state-migrate.service
After=tilo-server-state-migrate.service
# The server reads /var/lib/tilo/user-identity/pubkey.bin + the device
# cert + secret written at first-boot enrollment. Those live under
# /var, so start after local filesystems are up.
After=var-lib-tilo.mount
ConditionPathExists=!/var/lib/tilo-server/decommissioned

[Service]
Type=exec
User=tilo-server
Group=tilo-server
SupplementaryGroups=tilo-identity
# The volume's identity and the login beside it, which first boot wrote: the daemon reads the
# certificate and login here, and serves as the device they name. The server configuration
# makes it keep what a server keeps, in its own state below /var/lib/tilo-server.
Environment=TILO_IDENTITY_ROOT=/var/lib/tilo XDG_STATE_HOME=/var/lib/tilo/state
Environment=HOME=/var/lib/tilo-server TILO_RUNTIME_PROFILE=/var/lib/tilo-server
Environment=TILO_SERVER_CONFIG=/etc/tilo/server.toml
ExecStart=/usr/libexec/tilo/tilo-runtime
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
LimitCORE=0

# `/var/lib/tilo-server` is pre-created by tmpfiles.d (see
# os/usr/lib/tmpfiles.d/tilo-host.conf) — the daemon writes there
# and requires ReadWritePaths= to punch through ProtectSystem=strict.
#
# Deliberately NOT using `DynamicUser=yes + StateDirectory=tilo-server`:
# under SELinux enforcing on bootc, systemd's DynamicUser handling
# tries to rename the state dir at unit start (to reassign ownership
# to the runtime-allocated uid). That rename runs in the `init_t`
# domain against a target labeled `var_lib_t`, which the base policy
# refuses (avc: denied { rename }). The unit crash-loops.
# A static, unprivileged tilo-server account removes the rename while ensuring a
# network parser is not uid 0. Its tilo-identity supplementary group grants only
# the certified device-key read boundary required for authenticated transport.

# Hardening: the server is a network-facing daemon on an always-on
# device, so it stays behind a paranoid sandbox.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ReadWritePaths=/var/lib/tilo-server
# The device's directory beside its login, where its workspace service is kept, and where the
# certificates its person gives it are filed.
ReadWritePaths=/var/lib/tilo/state /var/lib/tilo/device
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_NETLINK is how the iroh endpoint enumerates its own interfaces and
# addresses. Without it the daemon reports ready with an empty address set
# and no peer can dial the host directly.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# The server configuration, and the device key in the shared identity tree.
ReadOnlyPaths=/etc/tilo /var/lib/tilo

[Install]
WantedBy=multi-user.target
