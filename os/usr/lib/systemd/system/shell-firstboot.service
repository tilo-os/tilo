[Unit]
Description=Tilo Desktop First Boot Setup
# Machine-wide first-boot setup only. This runs as root before anyone has
# logged in and only creates idempotent configuration directories. Personal
# identity creation is an acknowledged compositor OOBE, never a system unit.
ConditionPathExists=!/etc/tilo/.firstboot-done
# The live medium is disposable and has no installed user's home. Running the
# machine first-boot hook there both wastes startup time and can consume the
# one-shot marker before the real installation exists.
ConditionKernelCommandLine=!tilo.install
After=tilo-firstboot-user.service
[Service]
Type=oneshot
# `--firstboot-only` must exit after setup. `--firstboot` intentionally falls
# through into a compositor for the host-package session wrapper.
ExecStart=/usr/bin/shell --firstboot-only
ExecStartPost=/usr/bin/touch /etc/tilo/.firstboot-done
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
