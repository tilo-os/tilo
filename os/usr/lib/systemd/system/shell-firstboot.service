[Unit]
Description=QuickDesktop First Boot Setup
# Machine-wide first-boot setup only. This runs as root before anyone has
# logged in and only creates idempotent configuration directories. Personal
# identity creation is an acknowledged compositor OOBE, never a system unit.
ConditionPathExists=!/etc/qos/.firstboot-done
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# `--firstboot-only` must exit after setup. `--firstboot` intentionally falls
# through into a compositor for the host-package session wrapper.
ExecStart=/usr/bin/shell --firstboot-only
ExecStartPost=/usr/bin/touch /etc/qos/.firstboot-done
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
