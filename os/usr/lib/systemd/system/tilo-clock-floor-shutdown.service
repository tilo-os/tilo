[Unit]
Description=Record the authenticated wall time as the clock floor at shutdown
Documentation=man:systemd(1)
# Ordered after chronyd and /var, so it is stopped before either and its
# ExecStop still has both.
RequiresMountsFor=/var/lib/systemd
After=chronyd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/usr/libexec/tilo-clock-floor

[Install]
WantedBy=multi-user.target
