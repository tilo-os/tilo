[Unit]
Description=Drop revoked devices from this machine's direct peers
Documentation=file:///usr/share/doc/tilo/headless-devices.md
ConditionPathExists=/var/lib/tilo/device-revocations

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-home-peer-control prune-revoked
UMask=0022
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ReadWritePaths=/var/lib/tilo
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private
# Revocations dropped by a session are owned by its account; reading them
# needs no other privilege.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
