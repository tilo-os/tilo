[Unit]
Description=Sign a newly staged deployment's kernel
Documentation=file:///usr/share/doc/tilo/boot-chain.md
# A `bootc upgrade` writes a kernel that nothing on this machine has signed.
# Waiting for the next boot to sign it is too late — that boot is the one the
# firmware would refuse. Signing on the directory change closes the window
# whether the update came from the timer or from a hand-run upgrade about to be
# followed by a reboot.
ConditionPathExists=/var/lib/tilo/secureboot/db.key

[Path]
# Where the new kernel lands depends on the backend, and both are watched
# because a machine can be either:
#
#   ostree backend      a per-deployment directory under /boot/ostree holding a
#                       bare vmlinuz.
#   composefs + UKI     a Unified Kernel Image on the ESP: the image build's
#                       EFI/Linux/<kver>.efi, and the one `bootc upgrade`
#                       stages at EFI/Linux/bootc/<name>.efi. The ESP is
#                       mounted at /boot on the sealed disk, and at /boot/efi
#                       on an installed system, whose /boot is a separate
#                       partition (tilo-esp-generator).
# A path watch is not recursive: a new file in the existing bootc
# subdirectory changes only that directory, so it is watched on its own.
PathChanged=/boot/ostree
PathChanged=/boot/EFI/Linux
PathModified=/boot/EFI/Linux
PathChanged=/boot/EFI/Linux/bootc
PathModified=/boot/EFI/Linux/bootc
PathChanged=/boot/efi/EFI/Linux
PathModified=/boot/efi/EFI/Linux
PathChanged=/boot/efi/EFI/Linux/bootc
PathModified=/boot/efi/EFI/Linux/bootc
# The ESP loaders are the other half, and the one with no natural second chance:
# whatever replaces systemd-bootx64.efi and BOOTX64.EFI leaves them unsigned,
# and the boot that would notice is the boot the firmware refuses. Nothing else
# watches the ESP, so watch it here — under both mount points.
PathChanged=/boot/efi/EFI/systemd
PathChanged=/boot/efi/EFI/BOOT
PathChanged=/boot/EFI/systemd
PathChanged=/boot/EFI/BOOT
# PathChanged on a directory fires when entries appear or vanish; PathModified
# also fires when a file inside is written in place, which is what an updater
# that rewrites rather than renames does.
PathModified=/boot/efi/EFI/systemd
PathModified=/boot/efi/EFI/BOOT
PathModified=/boot/EFI/systemd
PathModified=/boot/EFI/BOOT
Unit=tilo-secureboot-sign.service

[Install]
WantedBy=paths.target
