[Unit]
Description=Put the boot that just proved itself back on trial for the next boot
Documentation=file:///usr/share/doc/tilo/recovery.md
# systemd-bless-boot removes the counter from the entry this boot was counted
# on, and every boot is counted (tilo-deployment entries), so the entry gets
# a fresh counter as soon as it is blessed: the next boot of this deployment
# is judged like this one was. Pulled in by systemd-bless-boot.service.
After=systemd-bless-boot.service
RequiresMountsFor=/boot /boot/efi
ConditionKernelCommandLine=!tilo.mode=repair

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tilo-deployment entries
# ESP maintenance must yield to the compositor, games, and application launch.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# This boot-time action only reads the deployment/key state and atomically
# updates the ESP. It does not need the network, hardware devices, host process
# tree, kernel mutation, or any root capability.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
# /boot stays read-only: this unit stages its changes in its state directory
# and tilo-esp-write@boot-entries.service applies them.
StateDirectory=tilo/esp-plan/boot-entries
StateDirectoryMode=0700
ReadOnlyPaths=/var/lib/tilo/secureboot
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# A machine whose repair entry could not be made still boots and still rolls
# back; it just has one fewer way out. Saying so on the console beats failing the
# boot for it.
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal+console
