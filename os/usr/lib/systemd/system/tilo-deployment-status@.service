[Unit]
Description=Answer one tilo status request
Documentation=file:///usr/share/doc/tilo/recovery.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-deployment serve-status
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=60
# An ESP this has to mount for itself (tilo-deployment's esp_mount_on_demand)
# stays in this service's namespace and goes away with it.
PrivateMounts=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
