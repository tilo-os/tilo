[Unit]
Description=Run the Tilo Windows egress lease reaper while a lease exists
Documentation=file:///usr/share/doc/tilo/windows-vm.md
ConditionKernelCommandLine=!tilo.install

[Path]
# tilo-windows-vm-control writes a root-only lease record before it attaches
# the egress NIC, so the reaper is armed before the lease can be used. The
# reaper exits successfully only once this directory is empty (it moves a
# record it cannot retire to ../unretired), so this level trigger never
# restarts it in a loop; a failed reaper is restarted by its own unit.
DirectoryNotEmpty=/run/tilo/windows-egress/leases
Unit=tilo-windows-vm-egress-reaper.service

[Install]
WantedBy=paths.target
