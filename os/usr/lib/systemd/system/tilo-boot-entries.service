[Unit]
Description=Maintain the boot counters and the repair-mode boot entry
Documentation=file:///usr/share/doc/tilo/recovery.md
# The ESP has to be mounted, and on the sealed layout it is an autofs mount that
# only appears when something touches it.
RequiresMountsFor=/boot
After=local-fs.target
# Repair mode must not rewrite the ESP it may be about to be used to repair.
ConditionKernelCommandLine=!tilo.mode=repair

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tilo-deployment entries
# A machine whose repair entry could not be made still boots and still rolls
# back; it just has one fewer way out. Saying so on the console beats failing the
# boot for it.
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal+console

[Install]
WantedBy=multi-user.target
