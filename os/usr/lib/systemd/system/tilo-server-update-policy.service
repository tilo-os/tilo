[Unit]
Description=Apply the update settings a server's document asks for

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-server-update-policy
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectHome=yes
ProtectSystem=strict
# The request the server writes, and the policy the helper rewrites beside the
# timer it configures. The request is in the daemon's own 0700 state root.
ReadWritePaths=/var/lib/tilo/state /var/lib/tilo /etc/systemd/system/bootc-fetch-apply-updates.timer.d
# "-": a key directory that does not exist yet has nothing to hide, and without
# the prefix systemd refuses to start the unit at all on a machine that has not
# created every one of them.
InaccessiblePaths=-/var/lib/tilo/device-private -/var/lib/tilo/secureboot -/var/lib/tilo/image-trust -/var/lib/tilo/rollback
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# The request it reads is inside the daemon's 0700 state root.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
