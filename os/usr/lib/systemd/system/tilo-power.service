[Unit]
Description=Tilo CPU governor policy (AC/battery-aware)
DefaultDependencies=no
After=basic.target
Before=multi-user.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/tilo-power
Restart=on-failure
RestartSec=5
# Read-only /: the daemon writes only to /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor.
ProtectSystem=strict
ProtectHome=yes
# The /sys writes need to bypass ProtectKernelTunables.
ProtectKernelTunables=no
# No new caps needed beyond default; the sysfs writes go through the
# capability-carrying init-owned inode.
NoNewPrivileges=yes
CapabilityBoundingSet=
# Sysfs writes need write access to /sys/devices/system/cpu/…
ReadWritePaths=/sys/devices/system/cpu

[Install]
WantedBy=multi-user.target
