# Opens NTFS drives after the person agreed in the shell's prompt: loads and
# mounts the kernel driver for "Open", or starts the confined userspace driver
# for "Open safely". It exits after a minute without requests while no drive
# is open.
[Unit]
Description=Consent-gated NTFS mount service
Requires=tilo-ntfs-mount.socket
After=tilo-ntfs-mount.socket tilo-ntfs-boot-disks.service

[Service]
ExecStart=/usr/libexec/tilo-ntfs-mount serve
# The drives it mounts must appear in the person's session, so the service
# runs in the host's mount namespace: none of the options that give a unit a
# mount namespace of its own (ProtectSystem=, PrivateTmp=, ProtectHome=,
# PrivateDevices=, ReadWritePaths= ...) may be set here. Its helpers confine
# themselves (namespaces, Landlock, seccomp, their own account) before they
# read a byte of a volume.
NoNewPrivileges=yes
# Mounting and unmounting; loading ntfs3; the helpers' device nodes,
# namespaces and account switch; the media directories; stopping helpers;
# reading a caller's executable and namespaces under /proc and checking
# through its pidfd that it is still the process that connected.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE CAP_MKNOD CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_KILL CAP_SYS_PTRACE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
