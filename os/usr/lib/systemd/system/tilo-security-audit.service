[Unit]
Description=Tilo security self-check (logs active hardening to the journal)
Documentation=https://github.com/tilo/tilo
# After the bits it inspects are up (SELinux, mounts, fs.service).
After=local-fs.target fs.service
Wants=fs.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-security-audit
RemainAfterExit=yes
# WantedBy (rather than RequiredBy) keeps diagnostics from blocking boot. A
# non-zero result intentionally remains visible as a failed health unit.

[Install]
WantedBy=multi-user.target
