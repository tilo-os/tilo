[Unit]
Description=Tilo security self-check (logs active hardening to the journal)
Documentation=https://github.com/tilo/tilo
# After the bits it inspects are up (SELinux, mounts, fs.service).
After=local-fs.target fs.service
Wants=fs.service

[Service]
Type=oneshot
# What the unprivileged audit cannot read itself, handed over by a privileged
# snapshot: net.core.bpf_jit_harden reads back only with CAP_SYS_ADMIN, and
# rpm cannot run under NoNewPrivileges= (SELinux refuses its rpm_t transition).
ExecStartPre=+/usr/bin/sh -c 'umask 077 && sysctl -n net.core.bpf_jit_harden > /run/tilo-security-audit.net.core.bpf_jit_harden && rpm -qa --qf "%%{NAME}\n" > /run/tilo-security-audit.packages'
# The development posture's facts the observer cannot read itself: listening
# sockets with their processes (netlink and other processes' fds), sudoers
# files that grant NOPASSWD, and the booted image's reference (bootc).
ExecStartPre=+/usr/bin/sh -c 'umask 077 && { ss -Hltnp | sed "s/^/listen /"; grep -lsE "^[^#]*NOPASSWD" /etc/sudoers /etc/sudoers.d/* | sed "s/^/nopasswd /"; } > /run/tilo-security-audit.posture; bootc status --json > /run/tilo-security-audit.bootc.json 2>/dev/null || true'
ExecStopPost=+/usr/bin/rm -f /run/tilo-security-audit.net.core.bpf_jit_harden /run/tilo-security-audit.packages /run/tilo-security-audit.posture /run/tilo-security-audit.bootc.json
ExecStart=/usr/libexec/tilo-security-audit
TimeoutStartSec=2min
# The audit is important but not latency-sensitive; its result remains loud
# in the journal and failed-unit state while recurring successful runs return
# inactive so the timer can activate them again. Scans yield to the session.
Nice=19
CPUSchedulingPolicy=idle
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
# This process observes security state; it never repairs it. Keep the host
# filesystem immutable and expose only TPM devices needed by the verified-boot
# preflight it invokes. Kernel diagnostics come from the journal and daemon
# configuration comes from systemd, so this observer needs no capabilities.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No PrivateNetwork=: the audit checks the host's network sysctls, and a
# private namespace has its own defaults (and no net.core.bpf_jit_harden).
# RestrictAddressFamilies=AF_UNIX keeps it off the network.
PrivateIPC=yes
ProtectKernelTunables=yes
# No ProtectKernelModules=: it hides /usr/lib/modules, and with it the running
# kernel's config, so every compiled-option check failed. Loading a module
# stays impossible: the capability bounding set is empty and @module is
# filtered below.
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/tpm0 rw
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
# WantedBy (rather than RequiredBy) keeps diagnostics from blocking boot. A
# non-zero result intentionally remains visible as a failed health unit.
