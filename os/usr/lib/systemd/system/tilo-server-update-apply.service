[Unit]
Description=Boot into a staged OS update when this generation is good and the window is open
Documentation=file:///usr/share/doc/tilo/recovery.md
# A server stages an update and nothing reboots into it blindly: the running
# generation has to have passed its own health check, and the operator's update
# window has to be open (tilo-server-update-apply). Started by the timer below.
After=multi-user.target tilo-boot-health.service

[Service]
Type=oneshot
# The daemon's identity, login and sockets, so `tilo device rollout` reaches it
# as the person the machine is signed in as.
Environment=TILO_IDENTITY_ROOT=/var/lib/tilo XDG_STATE_HOME=/var/lib/tilo/state
ExecStart=/usr/libexec/tilo-server-update-apply
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RemoveIPC=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal+console
