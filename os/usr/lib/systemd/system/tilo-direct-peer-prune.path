[Unit]
Description=Drop revoked devices from this machine's direct peers
Documentation=file:///usr/share/doc/tilo/headless-devices.md
ConditionKernelCommandLine=!tilo.install

[Path]
# A session or `tilo-identity revoke` drops a root-signed revocation here; the
# service removes the device from personal-device-peers.json, but only an
# entry recorded under the identity that signed the revocation. Entries stay
# in the directory, so the trigger is a change, never "not empty" (which would
# start the service again after every run). The boot run is the service's own
# multi-user.target hook.
PathChanged=/var/lib/tilo/device-revocations
PathModified=/var/lib/tilo/device-revocations
Unit=tilo-direct-peer-prune.service

[Install]
WantedBy=multi-user.target
