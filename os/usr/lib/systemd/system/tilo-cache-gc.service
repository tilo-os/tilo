[Unit]
Description=Remove unused Flatpak runtimes and the stale developer image copy
Documentation=man:flatpak-uninstall(1)
ConditionKernelCommandLine=!tilo.install
ConditionKernelCommandLine=!tilo.mode=repair
After=local-fs.target

[Service]
Type=oneshot
# Policy: /etc/tilo/cache-gc.toml. The record `tilo os status` reads goes to
# /var/lib/tilo-cache-gc/record.json.
ExecStart=/usr/bin/tilo os clean
StateDirectory=tilo-cache-gc
StateDirectoryMode=0755
# Background work: it yields to the session.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
UMask=0022
# Writes only what it cleans and its record. The VM state root exists only on
# development images.
ProtectSystem=strict
ReadWritePaths=-/var/lib/flatpak -/var/lib/tilo-vm
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
# Root's file access, and nothing else.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
