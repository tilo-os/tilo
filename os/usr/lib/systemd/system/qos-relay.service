[Unit]
Description=qOS host + relay daemon (iroh WAN transport, workspace CRDT fan-out, store-and-forward)
Documentation=file:///usr/share/doc/qos/relay.md
After=network-online.target qos-relay-firstboot.service
Wants=network-online.target
Requires=qos-relay-firstboot.service
# The relay reads /var/lib/qos/user-identity/pubkey.bin + the device
# cert + secret written at first-boot enrollment. Those live under
# /var, so start after local filesystems are up.
After=var-lib-qos.mount
ConditionPathExists=!/var/lib/qos-relay/decommissioned

[Service]
Type=notify
NotifyAccess=all
# `run` blocks until SIGTERM. sd_notify(READY=1) is emitted from
# main.rs once the iroh endpoint is bound + accepting.
ExecStart=/usr/bin/qos-relay --config /etc/qos/relay.toml run
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# `/var/lib/qos-relay` is pre-created by tmpfiles.d (see
# os/usr/lib/tmpfiles.d/qos-host.conf) — the daemon writes there
# and requires ReadWritePaths= to punch through ProtectSystem=strict.
#
# Deliberately NOT using `DynamicUser=yes + StateDirectory=qos-relay`:
# under SELinux enforcing on bootc, systemd's DynamicUser handling
# tries to rename the state dir at unit start (to reassign ownership
# to the runtime-allocated uid). That rename runs in the `init_t`
# domain against a target labeled `var_lib_t`, which the base policy
# refuses (avc: denied { rename }). The unit crash-loops. Dropping
# DynamicUser + StateDirectory removes the rename, and the sandbox
# below (CapabilityBoundingSet= + syscall filter + ProtectSystem)
# still gives us equivalent isolation for a daemon this narrow.

# Hardening: the relay is a network-facing daemon on an always-on
# device, so it stays behind a paranoid sandbox.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/qos-relay
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# The daemon needs to read the user's cert + relay device secret
# from the shared identity tree, so grant read access there.
ReadOnlyPaths=/etc/qos /var/lib/qos

[Install]
WantedBy=multi-user.target
