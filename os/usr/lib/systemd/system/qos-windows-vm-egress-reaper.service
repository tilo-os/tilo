[Unit]
Description=qOS Windows temporary egress lease reaper
Documentation=file:///usr/share/doc/qos/windows-vm.md
After=virtqemud.service virtnetworkd.service
# No Windows VM may own an egress lease on the disposable installer. Avoid a
# guaranteed controller failure; the installed UKI does not carry this marker.
ConditionKernelCommandLine=!qos.install

[Service]
Type=oneshot
ExecStart=/usr/libexec/qos-windows-vm-control egress-reap
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
# The controller repairs /run/qos/windows-egress to mode 2750 before publishing
# status for the qos-identity group. RestrictSUIDSGID would make that defensive
# chmod fail with EPERM even though tmpfiles normally creates the directory with
# the same setgid mode.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @obsolete @cpu-emulation @module @clock @debug @pkey
SystemCallErrorNumber=EPERM
