[Unit]
Description=Re-resolve the additional codecs pack for the booted image
Documentation=file:///usr/share/doc/tilo/codec-pack.md

# After every boot (a new deployment may run a new Mesa or GStreamer) and daily,
# so a Mesa part waiting for a matching RPM Fusion build is retried. The helper
# does nothing unless the owner opted in. The update check also starts it (see
# bootc-fetch-apply-updates.service.d/40-tilo-codec-pack.conf).
[Timer]
OnBootSec=5min
OnUnitActiveSec=1d
RandomizedDelaySec=30min
Unit=tilo-codec-pack@refresh.service

[Install]
WantedBy=timers.target
