[Unit]
Description=Additional codecs pack: %i
Documentation=file:///usr/share/doc/tilo/codec-pack.md
# Settings starts exactly install, remove or refresh (see
# /etc/polkit-1/rules.d/49-tilo-codec-pack.rules); the helper rejects anything
# else as well.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-codec-pack %i
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# The helper downloads, verifies and unpacks RPMs into three fixed trees. It
# never installs into /usr: merging is systemd-sysext's job, which the helper
# asks PID 1 to (re)run, so the merge happens in the host's mount namespace and
# not in this unit's private one.
ProtectSystem=strict
ReadWritePaths=/var/lib/extensions
StateDirectory=tilo/codec-pack
CacheDirectory=tilo-codec-pack
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @obsolete @cpu-emulation @module @clock @debug
SystemCallErrorNumber=EPERM
