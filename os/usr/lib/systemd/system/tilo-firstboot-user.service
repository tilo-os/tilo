[Unit]
Description=Tilo first-boot user creation (from custom installer)
# Only runs if the custom installer seeded a credential file.
ConditionPathExists=/etc/tilo/install-user.conf
After=local-fs.target systemd-sysusers.service systemd-tmpfiles-setup.service
# Must finish before the login greeter so the new account is loginable,
# and before shell first-boot reads the enrolled device key.
Before=greetd.service shell-firstboot.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tilo-firstboot-user
# Encrypted custody handoff may verify arbitrarily large selected archives.
# Never kill a healthy transfer because it exceeds a fixed boot deadline.
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private
# useradd needs to create and own the home and atomically update the local
# account databases. shadow-utils also reports the account creation through
# Linux audit, which requires CAP_AUDIT_WRITE and a NETLINK_AUDIT socket. It
# does not need audit-control, mount, module, raw-I/O, or reboot authority.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_AUDIT_WRITE CAP_SETGID CAP_SETUID
AmbientCapabilities=
# PrivateNetwork and this allowlist keep the audit socket from granting IP
# network access.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
