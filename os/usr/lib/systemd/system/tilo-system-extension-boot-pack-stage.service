[Unit]
Description=Stage one signed Tilo BootPack as a future bootc deployment
Documentation=file:///usr/share/doc/tilo/system-extensions.md
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/boot /sysroot /var/lib/containers
ConditionPathExists=/var/lib/tilo/system-extensions/boot-pack-request

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-system-extension-manager stage-pending
# A request can survive a reboot and activate as the greeter starts. Pulling,
# unpacking, and composing a deployment must yield to login and game workloads;
# correctness is enforced by signatures/state transitions, not completion
# latency.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# This is the sole networked BootPack boundary. Its input is the root-owned,
# fixed queue file written by the socket dispatcher; the manager independently
# re-verifies the signed image-owned catalogue before its one bootc switch.
# bootc deploys an OSTree/composefs boot entry, which needs the mount namespace,
# image-store/OSTree/ESP write paths, and the narrow capabilities below. This is
# intentionally unlike the marker-only activation units: denying @mount or all
# capabilities here would make a security-looking but nonfunctional service.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_MKNOD CAP_SETFCAP
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@swap @reboot @raw-io @obsolete @cpu-emulation @module @clock @debug @pkey
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/tilo/system-extensions /run/tilo/system-extension-api /var/lib/containers /var/lib/bootc /ostree /sysroot /boot
ReadOnlyPaths=/usr/share/tilo/system-extensions
