[Unit]
Description=Tilo repair console on %I
Documentation=file:///usr/share/doc/tilo/repair-mode.md
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
After=basic.target systemd-user-sessions.service
# A terminal that does not exist is not a failure, it is a machine without a
# serial port. Without this the unit fails on every laptop and the failure is the
# first thing a person in repair mode sees.
ConditionPathExists=/dev/%I

[Service]
Environment=HOME=/root
WorkingDirectory=-/root
ExecStart=/usr/libexec/tilo-repair
Type=idle
StandardInput=tty-force
StandardOutput=tty
StandardError=journal+console
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes
# The console has to survive its own failures: exiting would leave a machine in
# repair mode with nothing on the screen and no way to ask for anything.
Restart=always
RestartSec=1s
