[Unit]
Description=Set aside a codec-pack Mesa extension built for another base
Documentation=file:///usr/share/doc/tilo/codec-pack.md
# The freeworld Mesa drivers bring their own libgallium, which serves every Mesa
# client once merged. After an image update the booted base may run a different
# Mesa; merging the old drivers then would mix two Mesa builds. This runs
# offline, before systemd-sysext merges anything, and parks such an extension
# (or restores a parked one after a rollback). The refresh unit rebuilds it for
# the new base once a matching RPM Fusion build exists.
# systemd-sysext runs before systemd-tmpfiles-setup, so nothing here may be
# ordered after tmpfiles: that closes a cycle systemd breaks by dropping one of
# them. PrivateTmp=disconnected keeps a private /tmp without the implicit
# After=systemd-tmpfiles-setup.service that PrivateTmp=yes adds.
DefaultDependencies=no
After=local-fs.target
Before=systemd-sysext.service sysinit.target
ConditionPathExists=/var/lib/tilo/codec-pack/enabled

[Service]
Type=oneshot
ExecStart=/usr/libexec/tilo-codec-pack guard
ProtectSystem=strict
ReadWritePaths=/var/lib/tilo/codec-pack /var/lib/extensions
ProtectHome=yes
PrivateTmp=disconnected
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=sysinit.target
