[Unit]
Description=Keep the deployment the boot loader went back to
Documentation=file:///usr/share/doc/tilo/recovery.md
# After a deployment spends its tries, sd-boot starts the previous one, but
# bootc still queues the failed one as the default. This makes the running
# deployment bootc's default again and writes what the failed tries left
# behind to /var/lib/tilo/boot-fallback, where the session's
# tilo-boot-fallback-notice tells the person. On every other boot it reads
# bootc's status and exits.
RequiresMountsFor=/boot /boot/efi /var/lib/tilo
After=local-fs.target systemd-pstore.service
# The running deployment is made the default only once it proved itself. On a
# boot the boot loader counts (it was on trial too), that is when the boot was
# judged good and blessed; on any other boot neither unit is queued and this
# runs as soon as multi-user.target is reached.
After=boot-complete.target systemd-bless-boot.service
# tilo-boot-health, and with it boot-complete.target, starts after
# multi-user.target, so this must not be one of the units multi-user.target
# waits for: that closes an ordering cycle on every counted boot, and systemd
# breaks it by dropping one of these jobs, possibly the health check itself.
# Ordering after the target keeps systemd from adding the implicit
# multi-user.target-after-this ordering that WantedBy= would otherwise bring.
After=multi-user.target
ConditionKernelCommandLine=!tilo.mode=repair

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tilo-deployment fallback
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# bootc mounts the ESP itself; a dev disk's ESP superblock is read-only, so the
# script makes it writable for bootc in this unit's own mount namespace.
PrivateMounts=yes
UMask=0022
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal+console

[Install]
WantedBy=multi-user.target
