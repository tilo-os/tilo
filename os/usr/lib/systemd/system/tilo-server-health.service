[Unit]
Description=Decide whether this boot of the server is serving
Documentation=file:///usr/share/doc/tilo/recovery.md
# tilo-boot-health judges a server by this unit (its drop-in names it in
# TILO_BOOT_HEALTH_UNIT): a oneshot that succeeds when the machine serves — the
# server answers and its store opens, and the filesystem replica publishes
# complete content when this machine runs one — and fails when it does not. A
# boot that fails spends the try the boot loader gave it, and the previous
# deployment comes back by itself after its tries.
#
# A machine waiting to be paired has no server yet; it is judged by
# multi-user.target alone, so it is never rolled back for waiting on a person.
After=multi-user.target tilo-server.service
# Above tilo-server-health's own wait (240 s), so the verdict is its own.
TimeoutStartSec=360

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tilo-server-health
# The verdict has to be readable from the serial console of a machine whose
# server never came up, which is precisely the machine this is about.
StandardOutput=journal+console
StandardError=journal+console
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# `tilo-server status` opens every durable workspace store, and opening one
# recovers its journal: that is the "store opens" half of the verdict, so the
# probe needs the state root writable exactly as the server does.
ReadWritePaths=/var/lib/tilo-server
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# systemctl reads the units' state over D-Bus (a socket), and reads the server's
# state root and config; nothing here writes.
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
