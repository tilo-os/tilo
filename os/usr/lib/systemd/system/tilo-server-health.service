[Unit]
Description=Decide whether this boot of the server is serving
Documentation=file:///usr/share/doc/tilo/recovery.md
# tilo-boot-health judges a server by this unit (its drop-in names it in
# TILO_BOOT_HEALTH_UNIT): a oneshot that succeeds when the machine serves — the
# server answers and its store opens, and the filesystem replica publishes
# complete content when this machine runs one — and fails when it does not. A
# boot that fails spends the try the boot loader gave it, and the previous
# deployment comes back by itself after its tries.
#
# A machine waiting to be paired has no server yet; it is judged by
# multi-user.target alone, so it is never rolled back for waiting on a person.
After=multi-user.target tilo-server.service
# Above tilo-server-health's own wait (240 s), so the verdict is its own.
TimeoutStartSec=360

[Service]
Type=oneshot
RemainAfterExit=yes
# The daemon's own state and environment, as tilo-server.service tells it: the check asks the
# daemon a status call, and a daemon's sockets are its own account's, so the check runs as that
# account in that environment and names no directory itself. It only reads.
User=tilo-server
Group=tilo-server
SupplementaryGroups=tilo-identity
Environment=HOME=/var/lib/tilo-server TILO_IDENTITY_ROOT=/var/lib/tilo
Environment=XDG_STATE_HOME=/var/lib/tilo/state TILO_RUNTIME_PROFILE=/var/lib/tilo-server
Environment=XDG_RUNTIME_DIR=/run/tilo-server
ExecStart=/usr/libexec/tilo-server-health
# The verdict has to be readable from the serial console of a machine whose
# server never came up, which is precisely the machine this is about.
StandardOutput=journal+console
StandardError=journal+console
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# systemctl reads the units' state over D-Bus (a socket), and reads the server's
# state root and config; nothing here writes.
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
