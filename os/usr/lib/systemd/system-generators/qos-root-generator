#!/usr/bin/bash
# Generate the fixed target-independent qOS root discovery path in the initrd.
set -eu
out="${1:-/run/systemd/generator}"
grep -qw 'root=qos-auto' "${QOS_ROOT_CMDLINE_FILE:-/proc/cmdline}" 2>/dev/null || exit 0
install -d -m 0755 "$out"
cat >"$out/qos-root-discover.service" <<'EOF'
[Unit]
Description=Discover the qOS root on the boot ESP's disk
DefaultDependencies=no
After=systemd-udev-trigger.service
Before=initrd-root-device.target sysroot.mount

[Service]
Type=oneshot
ExecStart=/usr/libexec/qos-root-discover
EOF
cat >"$out/sysroot.mount" <<'EOF'
[Unit]
DefaultDependencies=no
Requires=qos-root-discover.service
After=qos-root-discover.service
Before=initrd-root-fs.target

[Mount]
What=/run/qos-root/device
Where=/sysroot
Type=auto
Options=rw
EOF
install -d -m 0755 "$out/initrd-root-device.target.wants"
ln -s ../qos-root-discover.service "$out/initrd-root-device.target.wants/qos-root-discover.service"
