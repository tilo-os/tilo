#!/usr/bin/bash
# Generate the fixed target-independent Tilo root discovery path in the initrd.
set -eu
# systemd runs every generator at once, and systemd-fstab-generator, which
# always honours root= in the initrd, writes a sysroot.mount of its own for
# root=tilo-auto (What=tilo-auto) into the normal directory, the first
# argument. Sharing that file was a race: its content depended on which
# generator wrote last, and when this one wrote first, systemd-fstab-generator
# failed on the existing file. These units go to the early directory (the
# second argument) instead, which comes before the normal one on systemd's unit
# path, so they replace systemd's whatever the order, and no file is written by
# both.
out="${2:-/run/systemd/generator.early}"
# Only the initrd finds and mounts the root. The booted system's systemd runs
# its generators too, with the same command line; there these units would
# rediscover a root that is already mounted, and fail at every boot.
[ -e "${TILO_ROOT_INITRD_RELEASE:-/etc/initrd-release}" ] || exit 0
grep -qw 'root=tilo-auto' "${TILO_ROOT_CMDLINE_FILE:-/proc/cmdline}" 2>/dev/null || exit 0
install -d -m 0755 "$out"
cat >"$out/tilo-root-discover.service" <<'EOF'
[Unit]
Description=Discover the Tilo root on the boot ESP's disk
DefaultDependencies=no
After=systemd-udev-trigger.service
Before=initrd-root-device.target sysroot.mount

[Service]
Type=oneshot
# sysroot.mount Requires= this unit. Without RemainAfterExit= a finished run
# goes inactive, and the next job on sysroot.mount (at initrd-switch-root)
# starts discovery again after the root is already mounted, and it fails.
RemainAfterExit=yes
ExecStart=/usr/libexec/tilo-root-discover
EOF
cat >"$out/sysroot.mount" <<'EOF'
[Unit]
DefaultDependencies=no
Requires=tilo-root-discover.service
After=tilo-root-discover.service
Before=initrd-root-fs.target

[Mount]
What=/run/tilo-root/device
Where=/sysroot
Type=auto
Options=rw
EOF
install -d -m 0755 "$out/initrd-root-device.target.wants"
ln -s ../tilo-root-discover.service "$out/initrd-root-device.target.wants/tilo-root-discover.service"
