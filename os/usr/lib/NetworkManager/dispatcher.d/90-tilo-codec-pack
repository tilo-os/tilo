#!/bin/sh
# Install the additional codecs pack the moment the device is online, when the
# owner opted in while it was offline (during setup, in the installer, or in
# Settings). NetworkManager runs this as root on network events, so nothing
# polls: a connection coming up, or connectivity reaching the internet, starts
# one refresh of the pack. The helper checks connectivity again itself and
# keeps waiting if there is still no internet.
#
# It does nothing unless the owner opted in and the pack is not installed yet;
# an installed pack is refreshed by its boot/daily timer and the update check.
# See /usr/share/doc/tilo/codec-pack.md.

STATE_DIR=/var/lib/tilo/codec-pack
INSTALLER_SEED=/etc/tilo/codec-pack-opt-in

case "$2" in
  up) ;;
  connectivity-change) [ "${CONNECTIVITY_STATE:-}" = FULL ] || exit 0 ;;
  *) exit 0 ;;
esac

if [ ! -e "$STATE_DIR/enabled" ]; then
  # The installer's opt-in counts until the helper adopts it (once).
  [ -e "$INSTALLER_SEED" ] && [ ! -e "$STATE_DIR/installer-seed-adopted" ] || exit 0
fi

# status.json is the helper's own world-readable report (json.dump, indent 2).
if grep -q '"state": "installed"' "$STATE_DIR/status.json" 2>/dev/null; then
  exit 0
fi

exec systemctl start --no-block tilo-codec-pack@refresh.service
