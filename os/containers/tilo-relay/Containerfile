# syntax=docker/dockerfile:1.7
# ============================================================================
# tilo-relay standalone container image
# ----------------------------------------------------------------------------
# Ships the relay daemon + its systemd unit as a small OCI image
# usable outside of the full bootc host mode. Two use cases:
#
#   1. Home users who want a relay container next to another home
#      service (Nextcloud, Home Assistant, ...) on an existing
#      Debian/Fedora/Podman-quadlet setup.
#   2. Enterprise cloud tier: the relay image is the deployable
#      unit; instances get provisioned per-tenant via k8s or a
#      podman-quadlet fleet.
#
# Build from the repo root:
#
#     podman build -f os/containers/tilo-relay/Containerfile \
#         -t registry.tilo.so/tilo/tilo-relay:latest .
#
# Publish via the existing forgejo CI workflow — see
# `.forgejo/workflows/release-relay.yml` (companion to the OS image job).
# ============================================================================

# ---- Frozen RPM repo + mirrored base (cross-time reproducibility) ----------
# Digest-pinned snapshot and base shared with the desktop + host bootc images.
# RPMS_REF comes from resolve-rpm-snapshot.sh and BASE_REF from
# os/base-snapshot.env — see os/dev/build-image.sh and the
# .forgejo/workflows/release-relay.yml build. Declared before the first FROM so
# both are global rather than scoped to the preceding stage.
ARG BASE_REF
ARG RPMS_REF
FROM ${RPMS_REF} AS rpms

FROM scratch AS external-assets
COPY --from=github-assets / /

# ---- Stage 1: builder --------------------------------------------------------
FROM ${BASE_REF} AS builder

RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        rust cargo capnproto \
        gcc gcc-c++ make cmake perl perl-FindBin python3 git \
        clang clang-devel pkgconf-pkg-config \
    && dnf clean all

# Fedora's sccache RPM omits the GHA backend. Install the same checksum-pinned,
# full-feature static client as the canonical OS builder.
ARG SCCACHE_VERSION=0.17.0
ARG SCCACHE_SHA256_X86_64=67c4a96dd237c1f518f6b36083f270f9976d516f1e57fce891755ea782e50006
ARG SCCACHE_SHA256_AARCH64=821a86343191aa1cbab74bd42f9e93c9a63bf85e4742945f40d3ae84193c1c77
RUN --mount=type=bind,from=external-assets,source=/,target=/tilo-assets,ro \
    case "$(uname -m)" in \
      x86_64) sccache_arch=x86_64; sccache_sha="$SCCACHE_SHA256_X86_64" ;; \
      aarch64) sccache_arch=aarch64; sccache_sha="$SCCACHE_SHA256_AARCH64" ;; \
      *) echo "unsupported sccache architecture: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && archive="sccache-v${SCCACHE_VERSION}-${sccache_arch}-unknown-linux-musl.tar.gz" \
    && echo "${sccache_sha}  /tilo-assets/${archive}" | sha256sum -c - \
    && tar -xzf "/tilo-assets/${archive}" -C /tmp \
    && install -m 0755 \
       "/tmp/sccache-v${SCCACHE_VERSION}-${sccache_arch}-unknown-linux-musl/sccache" \
       /usr/local/bin/sccache \
    && rm -rf "/tmp/sccache-v${SCCACHE_VERSION}-${sccache_arch}-unknown-linux-musl" \
    && /usr/local/bin/sccache --version

WORKDIR /build

# This build uses a repository-root context. Prove the Dockerfile-specific
# ignore file removed checkout credentials and unrelated CI metadata before any
# source enters an image layer. The bind is read-only and its contents are never
# printed or copied by this check.
RUN --mount=type=bind,source=.,target=/context,ro \
    test ! -e /context/.git/config \
    && test ! -e /context/.forgejo \
    && test -f /context/Cargo.lock \
    && test -f /context/crates/hosting/tilo-relay/Cargo.toml

COPY . /build

# BuildKit's default RUN env doesn't include a writable HOME, so cargo
# tries `/root/.cargo` and fails to create it. Same fix as
# os/Containerfile.host — pin CARGO_HOME + SCCACHE_DIR into the
# repo-mounted /build.
ARG SOURCE_DATE_EPOCH=0
ARG TILO_COMPILER_CACHE_CONFIGURED=0
ARG TILO_REQUIRE_COMPILER_CACHE=0
ARG TILO_CACHE_PROBE_NONCE=""
# No RUSTFLAGS here, deliberately. The variable REPLACES `build.rustflags`
# from .cargo/config.toml rather than appending to it, so setting it for the
# `--remap-path-prefix` alone silently drops target-cpu=x86-64-v3 and every
# link-time hardening flag (full RELRO, BIND_NOW, noexecstack, and the
# GNU_PROPERTY shadow-stack mark) from everything this image builds. That
# exact regression is why the remap now lives in .cargo/config.toml instead,
# alongside the flags it used to displace -- it still applies here, because
# cargo reads that config from /build.
ENV CARGO_HOME=/build/.cargo-home \
    SCCACHE_DIR=/build/.sccache \
    SCCACHE_GHA_VERSION=tilo-relay-v1 \
    SCCACHE_IDLE_TIMEOUT=0 \
    SCCACHE_IGNORE_SERVER_IO_ERROR=1 \
    TILO_CACHE_PROBE_NONCE=${TILO_CACHE_PROBE_NONCE} \
    RUSTC_WRAPPER=/usr/local/bin/sccache \
    CARGO_BUILD_JOBS=2 \
    CARGO_PROFILE_RELEASE_LTO=thin \
    CARGO_INCREMENTAL=0 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    LC_ALL=C.UTF-8 \
    TZ=UTC

# Build the relay and authenticated filesystem replica in one feature-resolution
# graph. Separate Cargo invocations recompile shared dependencies whose selected
# features differ by package root. Match os/Containerfile.host's cache mounts so
# subsequent builds can reuse compiler results as well.
RUN --mount=type=cache,target=/build/.cargo-home \
    --mount=type=cache,target=/build/target \
    --mount=type=cache,target=/build/.sccache \
    --mount=type=secret,id=actions_cache_url \
    --mount=type=secret,id=actions_runtime_token \
    export ACTIONS_CACHE_URL="$(cat /run/secrets/actions_cache_url 2>/dev/null || true)" \
    && export ACTIONS_RUNTIME_TOKEN="$(cat /run/secrets/actions_runtime_token 2>/dev/null || true)" \
    && if [ -n "$ACTIONS_CACHE_URL" ] && [ -n "$ACTIONS_RUNTIME_TOKEN" ]; then \
         export SCCACHE_GHA_ENABLED=on; \
       else \
         TILO_COMPILER_CACHE_CONFIGURED=0; \
       fi \
    && if [ "$TILO_REQUIRE_COMPILER_CACHE" = 1 ]; then \
         test "$TILO_COMPILER_CACHE_CONFIGURED" = 1 || { \
           printf '%s\n' 'required compiler cache configuration is unavailable' >&2; exit 1; \
         }; \
         SCCACHE_IGNORE_SERVER_IO_ERROR=0 python3 /build/os/containers/tilo-relay/probe-sccache.py; \
       elif [ "$TILO_COMPILER_CACHE_CONFIGURED" != 1 ] || ! sccache --start-server; then \
         export RUSTC_WRAPPER=; \
         printf '%s\n' 'sccache backend unavailable; compiling normally' >&2; \
       fi \
    && { sccache --zero-stats 2>/dev/null || true; } \
    && cargo build --locked --release -p tilo-relay -p tilo-fs --bins \
    && { sccache --show-stats 2>/dev/null || true; } \
    && mkdir -p /out \
    && cp target/release/tilo-relay \
          target/release/tilo-relay-admin \
          target/release/tilo-enroll \
          target/release/fs \
          /out/ \
    && /build/os/scripts/verify-elf-hardening.sh /out

# ---- Stage 2: runtime --------------------------------------------------------
FROM quay.io/fedora/fedora-minimal:44

# Runtime dependency: CA roots for rustls connections to hosted Iroh relay
# endpoints. Iroh does not use the system OpenSSL ABI. BusyBox is statically
# linked, so it remains usable after removing the package manager, coreutils,
# and their otherwise inherited OpenSSL dependency closure.
# Minimal bases can contain the CA package without its generated bundle; an
# already-installed package will not rerun its installation scriptlet. Extract
# the same server-auth anchors as update-ca-trust before removing its tools.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    microdnf install -y --setopt=reposdir=/repo --disablerepo='*' --enablerepo=frozen \
        ca-certificates busybox \
    && P11_KIT_NO_USER_CONFIG=1 /usr/bin/trust extract --format=pem-bundle \
        --filter=ca-anchors --overwrite --comment --purpose server-auth /ca-bundle.crt \
    && /usr/bin/busybox grep -q '^-----BEGIN CERTIFICATE-----$' /ca-bundle.crt \
    && microdnf remove -y --setopt=protected_packages= openssl-libs coreutils dnf5 \
    && /usr/bin/busybox mkdir -p /etc/pki/ca-trust/extracted/pem \
    && /usr/bin/busybox mv /ca-bundle.crt /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && /usr/bin/busybox test -s /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && ! /usr/bin/busybox find / -xdev \
        \( -name 'libssl.so*' -o -name 'libcrypto.so*' -o -name openssl \) \
        -print -quit | /usr/bin/busybox grep -q .

COPY --from=builder /out/tilo-relay /usr/bin/tilo-relay
COPY --from=builder /out/tilo-relay-admin /usr/bin/tilo-relay-admin
COPY --from=builder /out/tilo-enroll /usr/bin/tilo-enroll
COPY --from=builder /out/fs /usr/bin/fs
COPY os/containers/tilo-relay/tilo-home-peer /usr/bin/tilo-home-peer
RUN /usr/bin/busybox chmod 0755 /usr/bin/tilo-home-peer
COPY os/usr/lib/systemd/system/tilo-relay.service /usr/lib/systemd/system/tilo-relay.service

# Where the daemon writes state + reads config. The container
# operator mounts a volume here for persistence.
VOLUME ["/var/lib/tilo-relay", "/var/lib/tilo", "/etc/tilo"]

# Iroh uses UDP + hole-punching, but for a public-relay deployment
# a stable UDP port is nice to have. iroh's default bind is
# ephemeral; the config file lets an operator pin a fixed port.
EXPOSE 4433/udp

# Default command: daemon. Operator can override with `admin`.
ENTRYPOINT ["/usr/bin/tilo-home-peer"]
CMD ["--config", "/etc/tilo/relay.toml", "run"]
