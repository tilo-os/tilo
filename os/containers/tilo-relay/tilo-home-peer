#!/usr/bin/busybox sh
set -eu

bb=/usr/bin/busybox

# A room host (TILO_HOST_KIND=room-host) serves an identity's collaboration
# rooms — such as the Tilo community room it was delegated — and nothing
# else: no Files replica, no home-peer bundle, any certified device may
# connect and every room stays gated by its own membership. Its whole
# configuration is derived here on every start, so the deployment, not the
# volume, says what it serves:
#
#   TILO_IDENTITY_SOURCE  directory holding device-keypair.bin, device-cert.bin
#                         and user-pubkey.bin (a mounted secret): the host's
#                         paired identity, installed into /var/lib/tilo. Unset:
#                         pair over the LAN on first start (pair-room-host).
#   TILO_COMMUNITY_RECORDS directory of hosted-room records
#                         (`tilo-relay-admin community export`), each
#                         installed before serving. Default /etc/tilo-community.
#   TILO_RELAY_PORT       UDP port for Iroh (default 4433).
#   TILO_METRICS_LISTEN   ADDR:PORT for Prometheus `GET /metrics` (unset: none).
room_host() {
    config=/etc/tilo/relay.toml
    identity=/var/lib/tilo
    source="${TILO_IDENTITY_SOURCE:-}"
    umask 077
    if [ -n "$source" ]; then
        for file in device-keypair.bin device-cert.bin user-pubkey.bin; do
            [ -s "$source/$file" ] || {
                echo "room host: $source/$file is missing; mount the host identity (see README.md)" >&2
                exit 64
            }
        done
        $bb mkdir -p "$identity/device-private" "$identity/device" "$identity/user-identity"
        $bb cp "$source/device-keypair.bin" "$identity/device-private/keypair.bin.new"
        $bb chmod 0600 "$identity/device-private/keypair.bin.new"
        $bb mv -f "$identity/device-private/keypair.bin.new" "$identity/device-private/keypair.bin"
        for pair in device-cert.bin:device/cert.bin user-pubkey.bin:user-identity/pubkey.bin; do
            $bb cp "$source/${pair%%:*}" "$identity/${pair#*:}.new"
            $bb chmod 0644 "$identity/${pair#*:}.new"
            $bb mv -f "$identity/${pair#*:}.new" "$identity/${pair#*:}"
        done
    elif [ ! -s "$identity/device/cert.bin" ]; then
        /usr/bin/tilo-enroll pair-room-host --identity-root "$identity" \
            --label "${TILO_DEVICE_NAME:-Room host}" --timeout 270
    fi

    umask 022
    $bb mkdir -p /etc/tilo /var/lib/tilo-relay
    {
        echo "identity_root = \"$identity\""
        echo 'state_root = "/var/lib/tilo-relay"'
        echo 'full_replica_status = "/var/lib/tilo-relay/full-replica-status.json"'
        echo 'home_peer_bundle = "/var/lib/tilo-relay/no-home-peer.toml"'
        echo "iroh_listen = \"0.0.0.0:${TILO_RELAY_PORT:-4433}\""
        [ -z "${TILO_METRICS_LISTEN:-}" ] || echo "metrics_listen = \"$TILO_METRICS_LISTEN\""
        echo 'device_role = "always_on_server"'
        echo 'trust_policy = { kind = "allow_any" }'
    } > "$config.new"
    $bb mv -f "$config.new" "$config"

    records="${TILO_COMMUNITY_RECORDS:-/etc/tilo-community}"
    for record in "$records"/*.json; do
        [ -e "$record" ] || continue
        /usr/bin/tilo-relay-admin --config "$config" community install --record "$record"
    done
    /usr/bin/tilo-relay-admin --config "$config" endpoint
    exec /usr/bin/tilo-relay --config "$config" run
}

if [ "${TILO_HOST_KIND:-home-peer}" = room-host ]; then
    room_host
fi

if [ -e /var/lib/tilo-relay/decommissioned ]; then
    echo "Tilo home peer is decommissioned; services remain stopped"
    exec /usr/bin/busybox sleep infinity
fi

if [ ! -s /var/lib/tilo/device/cert.bin ]; then
    enrollment_source="${TILO_ENROLLMENT_TOKEN_FILE:-/run/secrets/tilo-enrollment-token}"
    if [ -s "$enrollment_source" ]; then
        token_file=/var/lib/tilo/enrollment-token.txt
        umask 077
        /usr/bin/busybox tr -d '[:space:]' < "$enrollment_source" > "$token_file"
        /usr/bin/tilo-enroll join --token-file "$token_file" \
            --identity-root /var/lib/tilo --home-peer-output /etc/tilo/home-peer.toml \
            --label "${TILO_DEVICE_NAME:-Home server}" --timeout 270
        /usr/bin/busybox rm -f "$token_file"
    else
        /usr/bin/tilo-enroll pair --identity-root /var/lib/tilo \
            --home-peer-output /etc/tilo/home-peer.toml \
            --label "${TILO_DEVICE_NAME:-Home server}" --timeout 270
    fi
fi

if [ ! -s /etc/tilo/relay.toml ]; then
    umask 022
    printf '%s\n' \
        'identity_root = "/var/lib/tilo"' \
        'state_root = "/var/lib/tilo-relay"' \
        'full_replica_status = "/var/lib/tilo/full-replica/status.json"' \
        'home_peer_bundle = "/etc/tilo/home-peer.toml"' \
        'iroh_listen = "0.0.0.0:4433"' \
        'trust_policy = { kind = "allow_matching_user" }' \
        'device_role = "always_on_server"' \
        > /etc/tilo/relay.toml
fi

/usr/bin/fs replica --config /etc/tilo/home-peer.toml &
replica_pid=$!
/usr/bin/tilo-relay "$@" &
relay_pid=$!

shutdown() {
    trap - EXIT INT TERM
    kill "$replica_pid" "$relay_pid" 2>/dev/null || true
    wait "$replica_pid" 2>/dev/null || true
    wait "$relay_pid" 2>/dev/null || true
}
trap 'shutdown; exit 143' INT TERM
trap shutdown EXIT

# The container is one service: if either half exits, stop the other so the
# restart policy brings the complete home peer back together.
set +e
wait -n "$replica_pid" "$relay_pid"
status=$?
set -e
exit "$status"
