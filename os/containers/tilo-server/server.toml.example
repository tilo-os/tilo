# Tilo server configuration.
#
# The device's one daemon reads it and keeps what a server keeps: the workspaces
# placed on it, governed here, and what their members send while others are away.
# Its identity is the login its ticket left; its state is the daemon's own.

# Compose exposes this UDP port. Iroh still uses encrypted relay fallback and
# NAT traversal when a direct path is unavailable.
iroh_listen = "0.0.0.0:4433"

# Safe default: accept only device certificates chained to this owner's root.
# See README.md before changing this for a cross-user workspace.
trust_policy = { kind = "allow_matching_user" }

# The server serves its own web UI, on by default: the pages its members open in a browser.
# It is on unless its person turns it off from one of their devices, so nothing here
# switches it; this names where it answers, and the certificate it answers with.
web_listen = "0.0.0.0:8443"
# The certificate is one its person's local CA issues, kept on the server's volume, which
# their own devices trust, until the deployment names a PEM chain and key:
# web_tls = { files = { chain = "/run/secrets/tls-chain.pem", key = "/run/secrets/tls-key.pem", host = "server.example" } }
web_tls = "local"

# `allow_matching_user` hosts open an owner workspace when it first subscribes.
# Any other workspace is held here because its governor made this server one of
# the workspace's hosts; nothing in this file names workspaces.

# A workspace this server founds and keeps of its own, for a deployment that
# serves one: named once, made on the first start, kept from then on. Repeat the
# table for more.
#
# [[kept]]
# id = "6f1c2b9e-1c1f-4f0e-9a51-3c4d5e6f7a8b"
# name = "Lounge"

# The key Apple gave whoever publishes the iOS app, for its push service: what tells a
# person's closed app that something waits for them. Without it a closed app is told
# nothing. The key file is readable by the server's user alone.
#
# [apple_push]
# key_file = "/var/lib/tilo/apple-push.p8"
# key_id = "ABC123DEFG"
# team_id = "TEAM123456"
# topics = ["so.tilo.phone"]
