#!/usr/bin/busybox sh
set -eu

if [ -e /var/lib/tilo-server/decommissioned ]; then
    echo "This Tilo server is decommissioned; services remain stopped"
    exec /usr/bin/busybox sleep infinity
fi

# This machine's identity and the login that joins it live on the volume an operator persists,
# so one ticket is spent once per volume, never once per start.
TILO_IDENTITY_ROOT=${TILO_IDENTITY_ROOT:-/var/lib/tilo}
XDG_STATE_HOME=${XDG_STATE_HOME:-$TILO_IDENTITY_ROOT/state}
export TILO_IDENTITY_ROOT XDG_STATE_HOME

# A volume that already holds its device key, certificate and login is one of the person's
# devices: a ticket handed to it is left unspent. An empty volume is a machine joining an
# existing owner, and the one secret that does it is the ticket `tilo device add` printed on an
# owner device.
if [ ! -s "$TILO_IDENTITY_ROOT/device/cert.bin" ] \
    || [ ! -s "$XDG_STATE_HOME/tilo/device/login.json" ]; then
    no_identity='no identity on this volume: make a ticket with `tilo device add` and pass it as TILO_TICKET'
    if [ -z "${TILO_TICKET:-}" ]; then
        echo "$no_identity" >&2
        exit 1
    fi
    /usr/bin/tilo login "$TILO_TICKET" --label "${TILO_DEVICE_NAME:-Home server}" || {
        echo "$no_identity" >&2
        exit 1
    }
fi

if [ ! -s /etc/tilo/server.toml ]; then
    umask 022
    printf '%s\n' \
        'identity_root = "/var/lib/tilo"' \
        'state_root = "/var/lib/tilo-server"' \
        'iroh_listen = "0.0.0.0:4433"' \
        'trust_policy = { kind = "allow_matching_user" }' \
        'work = { from = "own_devices" }' \
        > /etc/tilo/server.toml
fi

exec /usr/libexec/tilo/tilo-server "$@"
