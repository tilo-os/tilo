# syntax=docker/dockerfile:1.7
# ============================================================================
# tilo-runtime agent host image
# ----------------------------------------------------------------------------
# The MCP sidecar of the relay's Compose recipe (os/containers/tilo-agent-host):
# the headless runtime with loopback MCP HTTP, its enroll CLI, and the
# entrypoint that mints the token and pairs the device. It runs beside a
# tilo-relay home peer on an existing Linux host.
#
# Nothing here compiles: t builds the runtime and the enroll CLI
# (tools/ci/publish/server-binaries.sh, the check agent-host-binaries) and this
# build lays them out with the base and the packages they run against, from the
# same frozen snapshot and mirrored base as the relay
# (tools/ci/publish/agent-host-build.sh). Its context is the binaries and the
# entrypoint beside this file.
# ============================================================================

# ---- Frozen RPM repo (cross-time reproducibility) --------------------------
# Digest-pinned snapshot and base shared with the desktop + host bootc images.
# RPMS_REF comes from rpm-snapshot-ref.sh — see os/dev/build-image.sh and
# tools/ci/publish/agent-host-build.sh. Declared before the first FROM so it is
# global rather than scoped to the preceding stage.
ARG RPMS_REF
FROM ${RPMS_REF} AS rpms

# ---- Runtime -----------------------------------------------------------------
# Fedora's minimal base, pinned by digest on registry.fedoraproject.org, which keeps
# superseded digests; quay.io prunes them, so a pin there stops resolving.
FROM registry.fedoraproject.org/fedora-minimal:44@sha256:694cfd38a85e4c48bae777d37e4ca8d5f0ee0dd36ace04294f23b72bf9bd3475

# Buildah leaves the rpms mount out of the layer cache key; this ARG keys it on RPMS_REF.
ARG RPMS_REF
# Runtime dependency: CA roots for rustls connections to hosted Iroh relay
# endpoints. Iroh does not use the system OpenSSL ABI. BusyBox is statically
# linked, so it remains usable after removing the package manager, coreutils,
# and their otherwise inherited OpenSSL dependency closure.
# Minimal bases can contain the CA package without its generated bundle; an
# already-installed package will not rerun its installation scriptlet. Extract
# the same server-auth anchors as update-ca-trust before removing its tools.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    microdnf install -y --setopt=reposdir=/repo --disablerepo='*' --enablerepo=frozen \
        ca-certificates busybox \
    && P11_KIT_NO_USER_CONFIG=1 /usr/bin/trust extract --format=pem-bundle \
        --filter=ca-anchors --overwrite --comment --purpose server-auth /ca-bundle.crt \
    && /usr/bin/busybox grep -q '^-----BEGIN CERTIFICATE-----$' /ca-bundle.crt \
    && microdnf remove -y --setopt=protected_packages= openssl-libs coreutils dnf5 \
    && /usr/bin/busybox mkdir -p /etc/pki/ca-trust/extracted/pem \
    && /usr/bin/busybox mv /ca-bundle.crt /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && /usr/bin/busybox test -s /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && ! /usr/bin/busybox find / -xdev \
        \( -name 'libssl.so*' -o -name 'libcrypto.so*' -o -name openssl \) \
        -print -quit | /usr/bin/busybox grep -q .

COPY bin/tilo-runtime /usr/bin/tilo-runtime
COPY bin/tilo-enroll /usr/libexec/tilo/tilo-enroll
COPY os/containers/tilo-agent-host/tilo-agent-mcp /usr/bin/tilo-agent-mcp
RUN /usr/bin/busybox chmod 0755 /usr/bin/tilo-agent-mcp \
    && /usr/bin/busybox ln -s ../libexec/tilo/tilo-enroll /usr/bin/tilo-enroll

# Runtime profile (identity, sockets, joined workspaces) and MCP token dir.
VOLUME ["/var/lib/tilo-runtime", "/run/tilo"]

# Loopback MCP HTTP (Streamable). Token required on every listen address.
EXPOSE 7391/tcp

ENTRYPOINT ["/usr/bin/tilo-agent-mcp"]
