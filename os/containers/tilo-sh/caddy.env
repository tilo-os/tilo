# Production's Caddy: the tls container and the web entry image both run it
# (tilo/infra apps/tilo-sh-relay/deployment.yaml pins it by digest). The local
# stack serves its relay's and site's TLS with it, so it wants the same one.
#
# One pin, read by both the stack (stack.sh, which uses the Caddy on PATH, else
# TILO_SH_CADDY, else fetches this release once) and the check that hands the
# stack a built one (tools/ci/publish/tilo-sh-caddy.sh, t's tilo-sh-caddy).
# Move it by changing these two lines: they are a release's version and its
# published archive's SHA-512, so a fetched Caddy is never a guess.
CADDY_VERSION=2.11.7
CADDY_SHA512=a7a433a1b133efc3c8d10eb0b99d52a24b5ef5c322dc77f5282182b1c0402139ab83f3a99f0c52409df77d20123fb0b523edad8a66d8f5e49136197bf61ef0e7
