# syntax=docker/dockerfile:1.7
# The Tilo API server (crates/hosting/tilo-api): the MCP
# endpoint an agent adds with `claude mcp add --transport http tilo
# https://mcp.tilo.sh`. It runs beside the relay, behind the relay's Caddy,
# which terminates TLS; the server itself serves plain HTTP.
#
# Everything it is configured with comes from the environment (README.md), so
# a deployment changes how the server runs without a new image. It keeps its
# clients and grants in one file on a volume and writes nothing else, so the
# container runs as a non-root user on a read-only root filesystem.
#
# Nothing here compiles: t builds the server (tools/ci/publish/server-binaries.sh,
# the check api-binaries) and this build lays the binary out with the
# base and the packages it runs against, from the same frozen snapshot and
# mirrored base as the relay (tools/ci/publish/api-build.sh).

# ---- Frozen RPM repo (cross-time reproducibility) ---------------------------
# The package set every Tilo server image installs from, as
# tools/ci/publish/api-build.sh resolves it. Declared before the first
# FROM so it is global rather than scoped to the preceding stage.
ARG RPMS_REF
FROM ${RPMS_REF} AS rpms

# ---- Runtime -----------------------------------------------------------------
# Fedora's minimal base, the same runtime base as the relay: a C library, the
# certificates, and the server, with no package manager to run in its place. Pinned
# by digest on registry.fedoraproject.org, which keeps superseded digests;
# quay.io prunes them, so a pin there stops resolving.
FROM registry.fedoraproject.org/fedora-minimal:44@sha256:694cfd38a85e4c48bae777d37e4ca8d5f0ee0dd36ace04294f23b72bf9bd3475

# Buildah leaves the rpms mount out of the layer cache key; this ARG keys it on RPMS_REF.
ARG RPMS_REF
# Runtime dependency: CA roots for the hosts the server dials, which Tilo's
# binaries read from one fixed path (crates/system/tilo-native-certs). The server
# speaks rustls, not the system OpenSSL ABI. BusyBox is statically linked, so it
# remains usable after removing the package manager, coreutils, and their
# otherwise inherited OpenSSL dependency closure.
# Minimal bases can contain the CA package without its generated bundle; an
# already-installed package will not rerun its installation scriptlet. Extract
# the same server-auth anchors as update-ca-trust before removing its tools.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    microdnf install -y --setopt=reposdir=/repo --disablerepo='*' --enablerepo=frozen \
        ca-certificates busybox \
    && P11_KIT_NO_USER_CONFIG=1 /usr/bin/trust extract --format=pem-bundle \
        --filter=ca-anchors --overwrite --comment --purpose server-auth /ca-bundle.crt \
    && /usr/bin/busybox grep -q '^-----BEGIN CERTIFICATE-----$' /ca-bundle.crt \
    && microdnf remove -y --setopt=protected_packages= openssl-libs coreutils dnf5 \
    && /usr/bin/busybox mkdir -p /etc/pki/ca-trust/extracted/pem \
    && /usr/bin/busybox mv /ca-bundle.crt /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && /usr/bin/busybox test -s /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && /usr/bin/busybox mkdir -p /state \
    && /usr/bin/busybox chown 65532:65532 /state \
    && /usr/bin/busybox chmod 0700 /state \
    && ! /usr/bin/busybox find / -xdev \
        \( -name 'libssl.so*' -o -name 'libcrypto.so*' -o -name openssl \) \
        -print -quit | /usr/bin/busybox grep -q .

ARG SOURCE_REVISION
LABEL org.opencontainers.image.title="Tilo API server" \
      org.opencontainers.image.description="The Tilo API server: OAuth for agents and routing to their workspaces" \
      org.opencontainers.image.source="https://code.tilo.so/tilo/tilo" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"

COPY --chown=65532:65532 bin/tilo-api /usr/local/bin/tilo-api

USER 65532:65532
# The clients and grants, and nothing else: a read-only root filesystem needs
# no writable path beside it.
VOLUME ["/state"]
# Plain HTTP. TLS ends at Cloudflare and at the Caddy in front of the server.
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/tilo-api"]
