# syntax=docker/dockerfile:1.7
# A host of hosted workspace VMs (crates/runtime/legacy-vm/src/hosted): the
# service that owns every VM on its machine, the privileged helper that jails
# each one, Firecracker and its jailer, pasta for their network, and skopeo to
# fetch the signed guest. One runs per VM-host node, privileged (KVM, a
# writable cgroup tree, user namespaces), as README.md describes.
#
# Nothing here compiles: t builds the service, the jail helper and the member
# (tools/ci/publish/server-binaries.sh, the check vm-host-binaries) and this
# build lays them out with the base and the packages they run against, from the
# same frozen snapshot and mirrored base as the relay
# (tools/ci/publish/vm-host-build.sh).

# ---- Frozen RPM repo (cross-time reproducibility) ---------------------------
# The package set every Tilo server image installs from, as
# tools/ci/publish/vm-host-build.sh resolves it. Declared before the first
# FROM so it is global rather than scoped to the preceding stage.
ARG RPMS_REF
FROM ${RPMS_REF} AS rpms

# Firecracker and its jailer, from the release os/external-assets pins.
FROM scratch AS external-assets
COPY --from=github-assets / /

# ---- Runtime -----------------------------------------------------------------
# Fedora's minimal base, the same runtime base as the relay, pinned by digest on
# registry.fedoraproject.org, which keeps superseded digests; quay.io prunes
# them, so a pin there stops resolving.
FROM registry.fedoraproject.org/fedora-minimal:44@sha256:694cfd38a85e4c48bae777d37e4ca8d5f0ee0dd36ace04294f23b72bf9bd3475

# Buildah leaves the rpms mount out of the layer cache key; this ARG keys it on RPMS_REF.
ARG RPMS_REF
# Every program the start and the service run, from the frozen snapshot:
# passt is pasta (each VM's network), skopeo fetches the guest, xfsprogs makes
# the state disk's filesystem, libcap gives the helper its capabilities,
# util-linux's setpriv drops to the service's uid and mounts the state disk,
# curl lets the placer (`tilo-legacy hosted place`) scale the hosts through the
# Kubernetes API, tar unpacks the member identity, and gzip unpacks the
# Firecracker release below, which is a tarball. The package manager goes once
# they are installed: this host installs nothing at run time.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo \
    microdnf install -y --setopt=reposdir=/repo --disablerepo='*' --enablerepo=frozen \
        ca-certificates curl grep gzip libcap passt sed shadow-utils skopeo tar util-linux xfsprogs \
    && microdnf clean all \
    && microdnf remove -y --setopt=protected_packages= dnf5 \
    && ! command -v dnf5 >/dev/null

ARG SOURCE_REVISION
LABEL org.opencontainers.image.title="Tilo hosted VM host" \
      org.opencontainers.image.description="Runs tilo.sh workspaces' Linux programs in jailed Firecracker VMs" \
      org.opencontainers.image.source="https://code.tilo.so/tilo/tilo" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"

ARG FIRECRACKER_ASSET=firecracker-v1.17.0-x86_64.tgz
RUN --mount=type=bind,from=external-assets,source=/,target=/assets,ro \
    mkdir /tmp/fc \
    && tar -xzf "/assets/${FIRECRACKER_ASSET}" -C /tmp/fc \
    && install -m 0755 /tmp/fc/release-v1.17.0-x86_64/firecracker-v1.17.0-x86_64 /usr/local/bin/firecracker \
    && install -m 0755 /tmp/fc/release-v1.17.0-x86_64/jailer-v1.17.0-x86_64 /usr/local/bin/jailer \
    && rm -rf /tmp/fc \
    && firecracker --version | head -1 | grep -qx 'Firecracker v1.17.0'

# The service runs as tilo-hosted (10001). The helper is root-owned, runnable
# only by the service's group, and may become root (cap_setuid, cap_setgid);
# its configuration is root-owned in a root-owned directory, as it requires.
# The capabilities are given at start (entrypoint.sh), not here: set in a
# user-namespaced build they name that namespace's root, and no host's.
RUN groupadd --system --gid 10001 tilo-hosted \
    && useradd --system --uid 10001 --gid 10001 --home-dir /var/lib/tilo-hosted --shell /usr/sbin/nologin tilo-hosted
COPY bin/tilo-legacy /usr/local/bin/tilo-legacy
# The member that takes the relay's runs for the workspaces on this host.
COPY bin/tilo-runtime /usr/local/bin/tilo-runtime
COPY bin/tilo-hosted-jail /usr/libexec/tilo/tilo-hosted-jail
RUN chown root:tilo-hosted /usr/libexec/tilo/tilo-hosted-jail \
    && chmod 0750 /usr/libexec/tilo/tilo-hosted-jail
COPY --chmod=0644 os/containers/tilo-vm-host/hosted-jail.json /etc/tilo/hosted-jail.json

# fetch-guest accepts only the guest the release key signed
# (/etc/containers/policy.json's scope for registry.tilo.so/tilo/hosted-guest).
COPY --chmod=0644 os/etc/containers/policy.json /etc/containers/policy.json
# Where the signatures are: cosign keeps them as sigstore attachments in the
# same repository, which skopeo looks at only when told to.
COPY --chmod=0644 os/etc/containers/registries.d/registry.tilo.so.yaml /etc/containers/registries.d/registry.tilo.so.yaml
COPY --chmod=0644 keys/cosign.pub /usr/share/tilo/cosign.pub
COPY --chmod=0644 keys/release/rekor.pub /usr/share/tilo/release/rekor.pub

COPY --chmod=0755 os/containers/tilo-vm-host/entrypoint.sh /usr/local/bin/tilo-vm-host
ENTRYPOINT ["/usr/local/bin/tilo-vm-host"]
