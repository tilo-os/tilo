{
  "about": "Every budget the user stories are held to, in one place, so whoever owns a part tightens its number here. `web` are the targets every story that uses the web page is measured against (recorder.mjs's `story.web`): a measurement over its target makes the story red, as a step over its budget does. `measures` are a story's own costs with their targets (a target with `atLeast` is a floor, such as a rate). `steps` are each story's step budgets, in ms, by the step's own words. Numbers are what a person would accept on the local stack.",
  "web": {
    "cold-load-ms": {
      "target": 2000,
      "what": "A browser that has never seen the site opening it, to first content (first-contentful-paint)."
    },
    "warm-load-ms": {
      "target": 500,
      "what": "The same browser opening it again, to first content."
    },
    "sign-in-ms": {
      "target": 2000,
      "what": "Signing in to a workspace: from the press that asks to join to the workspace on screen."
    },
    "open-app-ms": {
      "target": 1000,
      "what": "Opening an app: from Enter on it to its window on screen."
    },
    "action-ms": {
      "target": 100,
      "what": "An action's round trip, such as creating a note: from the press until the change shows."
    },
    "key-to-paint-p50-ms": {
      "target": 16,
      "what": "Typing: from a key to the frame that shows it, the median over a typed line."
    },
    "key-to-paint-p90-ms": {
      "target": 33,
      "what": "Typing: from a key to the frame that shows it, the 90th percentile."
    },
    "script-kb": {
      "target": 100,
      "what": "The page's script, in compressed kilobytes transferred on a cold load (JavaScript; WebAssembly is reported beside it)."
    }
  },
  "steps": {
