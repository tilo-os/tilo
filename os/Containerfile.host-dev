# syntax=docker/dockerfile:1.7
# ============================================================================
# Tilo development server image: the server image plus what the device's steps need
# ----------------------------------------------------------------------------
# NEVER A RELEASE. It merges system extensions at boot, which the server image
# masks (os/Containerfile.host): a component layer under /var/lib/extensions
# overlays /usr on the next boot, which is what lets a test swap a rebuilt
# program into an installed server instead of rebuilding the image and its
# installer. tools/policy/check_dev_image_contract.py keeps every check that
# signs or publishes away from it, and os/tests/sealed_extensions.sh keeps the
# unmask here and in os/Containerfile.dev alone.
#
# This file is not a build of its own: tools/ci/publish/host-build.sh --dev
# appends it to os/Containerfile.host and os/image/boot.Containerfile, so its
# stages build on `final`, the server image's own last stage of the same base,
# programs and units, and it is sealed after (seal-host-dev). It adds:
#
#   * the device's daemon and its steps (os/components.toml's
#     `native-runtime-host` and `device-steps`, with the component manifest
#     the steps read) and the
#     CLI (`vm-cli`, which applies the layers an
#     installation leaves for the first boot), placed by
#     os/scripts/install-components.py as the dev image places them, from the
#     programs t's host-binaries-dev check compiled without LTO
#     (tools/ci/publish/server-binaries.sh `host host-dev`);
#   * the device steps' boot units from crates/os/tilo-device-steps/data, the ones
#     TILO_VM_UNITS names (tools/ci/publish/host-build.sh chooses them), and the
#     step units, polkit rule and directories every image with tilo-runtime has;
#   * /usr/share/tilo-vm/base.json, what the device checks every layer against:
#     the target and toolchain read off the server's own programs, the check
#     image that compiled them and the Cargo.lock they were built from
#     (os/scripts/finalize-dev-image.py --base-only);
#   * systemd-sysext.service, unmasked and enabled.
#
# Build context: what tools/ci/publish/host-build.sh stages, nothing else.
# ============================================================================

# The inputs the stages below run, staged through a scratch stage and
# bind-mounted from it, as os/Containerfile.dev does.
FROM scratch AS dev-inputs
COPY os/components.toml /tilo/os/
# The node files the manifest places beside the daemon (`@manifest/...`).
COPY os/usr/lib/tilo/node-server.toml /tilo/os/usr/lib/tilo/
COPY os/usr/lib/sysusers.d/tilo-server.conf /tilo/os/usr/lib/sysusers.d/
COPY os/usr/lib/systemd/system/tilo-node-server@.service \
     os/usr/lib/systemd/system/tilo-node-session-key@.service \
     os/usr/lib/systemd/system/tilo-node-session@.service \
     os/usr/lib/systemd/system/tilo-node-session@.path /tilo/os/usr/lib/systemd/system/
COPY os/scripts/install-components.py os/scripts/finalize-dev-image.py /tilo/os/scripts/
COPY Cargo.lock /tilo/

FROM scratch AS dev-builder
COPY bin/ /out/

# ---- Dev components, placed by the manifest ---------------------------------
FROM final AS dev-component-files
RUN --network=none \
    --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    --mount=type=bind,from=dev-builder,source=/out,target=/out,ro \
    python3 /run/tilo-dev/os/scripts/install-components.py \
      --manifest /run/tilo-dev/os/components.toml \
      --from /out --dest /image native-runtime-host device-steps vm-cli

# ---- The development server image -------------------------------------------
FROM final AS dev-server

# A server image, and not already a development one.
RUN test "$(cat /usr/lib/tilo/image-flavour)" = server \
      || { echo "the image is not the server image: its flavour is $(cat /usr/lib/tilo/image-flavour)" >&2; exit 1; } \
    && if [ -e /usr/share/tilo-vm/base.json ]; then \
         echo "the image is already a development server image" >&2; exit 1; \
       fi

COPY --from=dev-component-files /image/ /
# The manifest links the CLI's PATH name to `tilo`, the multicall that runs a
# moved program from /usr/libexec/tilo. The server links its own programs'
# names straight to them (os/Containerfile.host), and its `tilo` is the command
# line its first boot logs in with, so this one is linked the server's way.
RUN test "$(readlink /usr/bin/tilo-vm)" = tilo \
    && ln -sfn ../libexec/tilo/tilo-vm /usr/bin/tilo-vm
COPY vm-units/ /usr/lib/systemd/system/
COPY device-steps/49-tilo-device-steps.rules /etc/polkit-1/rules.d/49-tilo-device-steps.rules
COPY device-steps/tilo-device-control.conf /usr/lib/tmpfiles.d/tilo-device-control.conf

# The base the development image is built on: the server image's own base, in
# the store as host-build.sh loaded it, and the builder image t's check
# compiled the programs in.
ARG TILO_BASE_IMAGE
ARG TILO_BASE_DIGEST
ARG TILO_BASE_CREATED
ARG TILO_BUILDER_IMAGE
ARG TILO_VM_UNITS
RUN --network=none \
    --mount=type=bind,from=dev-inputs,source=/tilo,target=/run/tilo-dev \
    python3 /run/tilo-dev/os/scripts/finalize-dev-image.py --base-only \
      --base-image "$TILO_BASE_IMAGE" --base-digest "$TILO_BASE_DIGEST" \
      --base-created "$TILO_BASE_CREATED" \
      --builder-image "$TILO_BUILDER_IMAGE" \
      --built-binary /usr/libexec/tilo/tilo-runtime \
      --built-binary /usr/libexec/tilo/tilo-vm \
      --cargo-lock /run/tilo-dev/Cargo.lock \
    && systemctl unmask systemd-sysext.service \
    && systemctl enable systemd-sysext.service ${TILO_VM_UNITS} \
    && test "$(readlink /etc/systemd/system/systemd-confext.service)" = /dev/null \
    && test "$(readlink /etc/systemd/system/systemd-sysext.socket)" = /dev/null \
    && /usr/bin/tilo-vm --version \
    && test "$(sha256sum < /run/tilo-dev/os/components.toml)" = "$(sha256sum < /usr/share/tilo/components.toml)" \
    && systemd-sysext --version >/dev/null \
    && bootc container lint

# The flavour stays the server's: the installer admits a preloaded server target
# by it, and what the image does is the server's. This label says it is the
# development one.
LABEL sh.tilo.image.development="true" \
      org.opencontainers.image.title="Tilo development server (not for release)"
