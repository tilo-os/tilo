# syntax=docker/dockerfile:1.7
# The published tool catalog: every tool image .forgejo/workflows/
# build-env-tools.yml built for one env-runtime, for both architectures,
# with each architecture's catalog-<arch>.json (cache key -> tool id),
# report-<arch>.json (sizes, build times) and SHA256SUMS. Passed in as the
# `sealed` build context; identical for every platform.
FROM scratch
COPY --from=sealed / /env-tools/
