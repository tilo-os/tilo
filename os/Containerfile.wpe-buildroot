# syntax=docker/dockerfile:1.7
# WPE WebKit build dependencies resolved once against Fedora's signed repos.
# Production OS builds consume this image only through a committed digest pin.
ARG BASE_REF
FROM ${BASE_REF}

# webkitgtk6.0 and WPE WebKit share the WebKit source tree, so Fedora's source
# BuildRequires provide the maintained compiler/library closure. The explicit
# packages are WPE-port additions not required by Fedora's GTK port.
RUN dnf install -y 'dnf5-command(builddep)' \
 && dnf builddep -y webkitgtk6.0 \
 && dnf install -y \
      meson ninja-build gperf unifdef libgbm-devel curl xz \
      wayland-devel wayland-protocols-devel libepoxy-devel \
      libinput-devel systemd-devel \
 && install -d -m 0755 /usr/lib/qos \
 && rpm -qa --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' \
      | LC_ALL=C sort > /usr/lib/qos/wpe-buildroot-packages.txt \
 && uname -m > /usr/lib/qos/wpe-buildroot-arch \
 && test -s /usr/lib/qos/wpe-buildroot-packages.txt \
 && dnf clean all \
 && find /etc/yum.repos.d -type f -delete \
 && rm -rf /var/cache/dnf /var/cache/libdnf5
