# Lightweight control jobs keep the qualified lint environment and add only
# the Docker client/buildx. The runner owns a separate per-job Docker daemon.
# Built by .forgejo/workflows/build-ci-fast-images.yml, which passes the
# ci-fast image it has just built; the default is the currently pinned ci-fast.
ARG CI_FAST_IMAGE=registry.tilo.so/tilo/ci-fast@sha256:4974765531ae306e2c33265f0d7d33624c09579279dbf7ed0d519ca5ed0efa89
FROM docker.io/library/docker@sha256:f56779b4e86550493153cc8642c9c8e40b5d934e43cb5b4ea463aea5245c5c01 AS docker-cli
FROM ${CI_FAST_IMAGE}

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
RUN test -x /usr/local/bin/docker \
    && test -x /usr/local/libexec/docker/cli-plugins/docker-buildx

# Native qualification must run os/tests/named_public_trust_context.sh docker
# against the runner's isolated daemon before this image replaces a CI lane.
