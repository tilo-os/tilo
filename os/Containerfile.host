# syntax=docker/dockerfile:1.7
# ============================================================================
# qOS host-mode bootc image — headless always-on host / relay.
# ----------------------------------------------------------------------------
# Ships a minimal bootc image that boots straight into
# `qos-relay.service`. No compositor, no greetd, no session. Users
# reach it via their own workspaces once the enrollment token in
# /etc/qos/enrollment-token.txt is consumed on first boot.
#
#     podman build -f os/Containerfile.host -t localhost/qos-host:latest .
#
# The disk-image step is the same as the desktop image:
# `os/build-host.sh` writes a qcow2 the operator installs onto
# a target machine. See os/build-host.sh.
# ============================================================================

# ---- Frozen RPM repo + mirrored base (cross-time reproducibility) ----------
# Same digest-pinned snapshot and same mirrored Fedora bootc base the desktop
# image uses (see os/Containerfile's comment, os/rpms-snapshot.env and
# os/base-snapshot.env). Every `dnf install` in this file pulls from the frozen
# repo, never live Fedora mirrors. Both ARGs go before the first FROM so
# they're global — an ARG between two FROMs belongs to the previous stage.
ARG BASE_REF
ARG RPMS_REF
FROM ${RPMS_REF} AS rpms

# ---- Stage 1: builder (same base + toolchain as the desktop image) ---------
FROM ${BASE_REF} AS builder

RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        rust cargo sccache \
        gcc gcc-c++ make cmake perl perl-FindBin python3 git \
        clang clang-devel pkgconf-pkg-config \
        openssl-devel sqlite-devel zlib-ng-compat-devel \
    && dnf clean all

WORKDIR /build
COPY . /build

ARG SOURCE_DATE_EPOCH=0
# No RUSTFLAGS here, deliberately. The variable REPLACES `build.rustflags`
# from .cargo/config.toml rather than appending to it, so setting it for the
# `--remap-path-prefix` alone silently drops target-cpu=x86-64-v3 and every
# link-time hardening flag (full RELRO, BIND_NOW, noexecstack, and the
# GNU_PROPERTY shadow-stack mark) from everything this image builds. That
# exact regression is why the remap now lives in .cargo/config.toml instead,
# alongside the flags it used to displace -- it still applies here, because
# cargo reads that config from /build.
ENV CARGO_HOME=/build/.cargo-home \
    SCCACHE_DIR=/build/.sccache \
    CARGO_INCREMENTAL=0 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    LC_ALL=C.UTF-8 \
    TZ=UTC

# Host image currently ships qos-relay plus the fs binary for future composite
# host work. It does not install or enable an fs host service, so this image is
# CRDT/store-and-forward only and must not be described as full file residency.
# Drop the browser member (Servo) before resolving.
RUN --mount=type=cache,target=/build/.cargo-home \
    --mount=type=cache,target=/build/target \
    --mount=type=cache,target=/build/.sccache \
    sed -i '/"apps\/browser",/d' Cargo.toml \
    && cargo build --release \
        -p qos-relay -p fs \
    && mkdir -p /out \
    && cp target/release/qos-relay \
          target/release/qos-relay-admin \
          target/release/fs \
          /out/

# ---- Stage 2: runtime image ------------------------------------------------
FROM ${BASE_REF}

# Minimal runtime — no display stack, no PipeWire, no greetd. Just
# what a headless network appliance needs: time sync, firewall,
# fuse reserved for the future filesystem host plane, ca-certs for iroh relays.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        chrony \
        firewalld \
        fuse3 \
        ca-certificates \
        NetworkManager \
        NetworkManager-openvpn \
        ModemManager \
        fwupd \
    && dnf clean all

# Copy binaries + systemd unit + tmpfiles snippet.
COPY --from=builder /out/qos-relay /usr/bin/qos-relay
COPY --from=builder /out/qos-relay-admin /usr/bin/qos-relay-admin
COPY --from=builder /out/fs /usr/bin/fs
RUN chmod 0755 /usr/bin/qos-relay /usr/bin/qos-relay-admin /usr/bin/fs

COPY os/usr/lib/systemd/system/qos-relay.service /usr/lib/systemd/system/qos-relay.service
COPY os/usr/lib/systemd/system/qos-relay-firstboot.service /usr/lib/systemd/system/qos-relay-firstboot.service
COPY os/usr/libexec/qos-relay-firstboot /usr/libexec/qos-relay-firstboot
COPY os/usr/lib/tmpfiles.d/qos-host.conf /usr/lib/tmpfiles.d/qos-host.conf
# The device-trust group owns the identity directory, so it has to exist
# before tmpfiles-setup runs. No session user joins it on a host image —
# there is no session — but the group is what the directory is created
# with, and the identity layout is shared with the desktop image.
COPY os/usr/lib/sysusers.d/qos-identity.conf /usr/lib/sysusers.d/qos-identity.conf
RUN systemd-sysusers /usr/lib/sysusers.d/qos-identity.conf
RUN chmod 0755 /usr/libexec/qos-relay-firstboot

# The first-boot script consumes /etc/qos/enrollment-token.txt (a
# base32-Crockford EnrollmentToken minted on the operator's primary
# device by the imager app) and mints a device keypair + persists
# a device cert once the LAN mdns discovery hands back the signed
# cert. Baked into the ISO by `qos-installer` — the sample stub
# here is overwritten at install time.
RUN mkdir -p /etc/qos \
    && echo "# Replace with a base32-Crockford enrollment token minted by your primary device." \
        > /etc/qos/enrollment-token.txt

# Default relay config; `qos-relay init` inside the first-boot
# service writes a real one under `/etc/qos/relay.toml` once the
# enrollment completes.
RUN mkdir -p /etc/qos \
    && printf 'identity_root = "/var/lib/qos"\nstate_root = "/var/lib/qos-relay"\niroh_listen = "0.0.0.0:0"\ntrust_policy = { kind = "allow_matching_user" }\n' \
        > /etc/qos/relay.toml

# Enable services.
RUN systemctl enable qos-relay-firstboot.service \
    && systemctl enable qos-relay.service \
    && systemctl enable chronyd.service \
    && systemctl enable firewalld.service \
    && systemctl set-default multi-user.target

# The host does not run a graphical session; disable greetd + gdm
# in case anything transitively pulls them in.
RUN systemctl mask greetd.service || true
RUN systemctl mask gdm.service || true

# Automatic bootc updates — the host benefits even more than the
# desktop image because it's headless + always-on.
RUN systemctl enable bootc-fetch-apply-updates.timer

# Prune everything the headless relay does not need on the boot path.
# Even more aggressive than the desktop image: no display stack, no
# session manager, no `wait-online` blockers (iroh does its own NAT
# traversal + reconnect), no plymouth. `|| true` so a missing unit
# doesn't fail the image build.
RUN for u in \
        NetworkManager-wait-online.service \
        systemd-networkd-wait-online.service \
        plymouth-quit-wait.service \
        plymouth-quit.service \
        man-db-cache-update.timer \
        man-db-cache-update.service \
        systemd-update-utmp.service \
        pipewire.socket \
        pipewire-pulse.socket \
        wireplumber.service \
    ; do systemctl mask "$u" || true; done

# Signed-image trust roots — the same policy the desktop image
# uses. Refuses to `bootc upgrade` unless the image is signed.
COPY keys/cosign.pub /usr/share/qos/cosign.pub
COPY os/etc/containers/policy.json /etc/containers/policy.json
COPY os/etc/containers/registries.d/code.sandbox.example.yaml /etc/containers/registries.d/code.sandbox.example.yaml

# Same bootloader swap as the desktop image: install systemd-boot,
# drop the GRUB stack, tell bootc to plant systemd-boot on the ESP at
# install time (see os/usr/lib/bootc/install/40-qos.toml for why).
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    systemd-boot-unsigned \
    && dnf remove -y --allowerasing \
        grub2-common grub2-tools grub2-tools-minimal grub2-tools-extra \
        grub2-pc grub2-pc-modules grub2-efi-x64 grub2-efi-x64-modules \
        shim-x64 \
    && dnf clean all
COPY os/usr/lib/bootc/install/40-qos.toml /usr/lib/bootc/install/40-qos.toml

# firewalld default zone: the FedoraServer zone drops all inbound
# except explicitly permitted. Iroh punches out; the relay does not
# need any inbound-hole in the firewall to be reachable.
RUN firewall-offline-cmd --set-default-zone=FedoraServer

RUN bootc container lint
