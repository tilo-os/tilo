# syntax=docker/dockerfile:1.7
# ============================================================================
# Tilo server image — a headless, always-on machine that serves other people's
# workspaces: the server and the filesystem replica, the hosted-VM service (one
# jailed Firecracker VM per workspace environment) and the API server, with
# updates that stage and roll back on this machine's own health verdict.
# ============================================================================
# No compositor, no greetd, no session. Users reach the machine through their
# own workspaces once the ticket in /etc/tilo/ticket is
# consumed on first boot; an operator reaches it at the serial console, whose
# pairing token is the first boot's.
#
# Nothing here compiles: t builds every program (tools/ci/publish/
# server-binaries.sh, the checks host-binaries) and this build lays them out on
# the base os/Containerfile.host-base is (the mirrored Fedora bootc base and the
# frozen RPM snapshot the desktop image uses, with Firecracker), in
# tools/ci/publish/host-build.sh. Only the changed programs and the files that
# name them are in this layer, so a one-crate change moves one file in it.
#
# The guest OS inside each workspace VM is not here: the service fetches the
# rootfs Firecracker boots, pinned by digest in os/hosted-guest-snapshot.env and
# signed with the release key.
#
# The image is sealed as the desktop's is: host-build.sh appends the desktop's
# own sealing stages (os/image/boot.Containerfile: kernel, split, uki-input, uki,
# final) to this file, so the kernel, the initramfs and the command line with
# the generation and the composefs digest are one Unified Kernel Image under
# /boot. This file's `rootfs` stage is what they seal, and nothing may follow it.
# ============================================================================

# ---- Programs on the cached base -------------------------------------------
# The base is host-base's build: the package set, the runtime packages and
# Firecracker, which change only when the snapshot or the base does. This layer
# is built from it in seconds.
ARG HOST_BASE=localhost/tilo-host-base:latest
# The sealing tools, the desktop's `uki-tools` stage built with the base
# (host-base.sh), as an image: this build has no RPM snapshot to install them from.
ARG UKI_TOOLS=localhost/tilo-host-uki-tools:latest
# The bootc the desktop image ships, out of the OS tools image (os-tools-ARCH,
# os/image/helpers/bootc-builder.Containerfile): the base's own release rebuilt with
# os/external-assets/bootc-runtime/. A server updates itself from images the way the
# desktop does, on the same base, so it needs the same fixes: it stages an update and
# then may lose power (0009), and its disk can hold another operating system's ESP
# (0001) and another image's layers (0003).
ARG BOOTC_TOOLS=localhost/tilo-host-bootc-tools:latest
FROM ${UKI_TOOLS} AS uki-tools
FROM ${BOOTC_TOOLS} AS bootc-tools

# NetworkManager's resolver file, restored as the image's last layer (as the
# desktop image does): the base leaves a placeholder there, because a RUN with
# /etc/resolv.conf pointing into /run has the build put its own DNS file there.
FROM ${HOST_BASE} AS runtime-resolver-link
RUN mkdir -p /out && ln -s ../run/NetworkManager/resolv.conf /out/resolv.conf

FROM ${HOST_BASE} AS rootfs

ARG SOURCE_REVISION
LABEL org.opencontainers.image.title="Tilo server" \
      org.opencontainers.image.description="A headless Tilo machine that serves workspaces and their VMs" \
      org.opencontainers.image.source="https://code.tilo.so/tilo/tilo" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      sh.tilo.image.flavour="server"

# ---- bootc -------------------------------------------------------------------
# The tools image's build, replacing the base's stock binary of the same release:
# every bootc unit and helper of this image, and the sealing stages appended below
# (os/image/boot.Containerfile), then run it. Its licence record comes with it; the
# base shipped the same program without one.
COPY --from=bootc-tools /bootc/usr/bin/bootc /usr/bin/bootc
COPY --from=bootc-tools /bootc/usr/share/licenses/tilo-bootc/ /usr/share/licenses/tilo-bootc/

# ---- Programs ---------------------------------------------------------------
# Host image ships the server, the authenticated filesystem replica and the enroll
# program as one composite always-on home peer; the hosted-VM service with its
# jail helper; the API server, and beside it the program it starts a task's
# tilolang programs in; and the boot tools the update log needs. The server
# image's components (os/components.toml, `images = ["host"]`) come laid out by
# install-components.py, as a swap into a server lays them out.
COPY host-components/ /
COPY bin/fs /usr/bin/fs
COPY bin/tilo-api /usr/libexec/tilo/tilo-api
# The API server looks for it beside itself.
COPY bin/tilolang-process /usr/libexec/tilo/tilolang-process
COPY bin/tilo-linux-vm /usr/libexec/tilo/tilo-linux-vm
COPY bin/tilo-hosted-jail /usr/libexec/tilo/tilo-hosted-jail
COPY bin/tilo-esp-write /usr/libexec/tilo-esp-write
COPY bin/tilo-image-trust /usr/libexec/tilo/tilo-image-trust
# The device key every machine has: made before sysinit, given the daemon
# account and 0600 every boot.
COPY bin/tilo-device-key-init /usr/libexec/tilo/tilo-device-key-init
COPY bin/tilo-image-policy-check /usr/libexec/tilo-image-policy-check
COPY bin/tilo-board-successor /usr/libexec/tilo-board-successor
# Making Tilo the default start after an alongside install: the same tool the
# installer image ships, called by tilo-server-control.
COPY bin/tilo-default-start /usr/libexec/tilo-default-start
# The disk an installed server stores workspaces on is encrypted, and opening it
# in early boot is the desktop image's own program, not a server variant of it:
# tilo-auth opens the system volume (a recovery key, the TPM for a signed boot
# chain, or another of the owner's devices releasing its half), tilo-rollback
# holds the TPM's generation keyslots and floor, tilo-boot-signin is the sign-in
# screen tilo-root-discover steps aside from on a machine nobody signs in to;
# tilo-auth's own sibling commands enrol the sibling factor from the owner's
# session. tilo-crypto checks the signatures a release adds to the boot chain
# (os/dev/sign-target-prediction.sh runs the image's own copy).
COPY bin/tilo-auth bin/tilo-boot-signin bin/tilo-rollback bin/tilo-crypto /usr/libexec/tilo/
# The jail helper is root-owned and runnable only by the service's group (10001,
# os/usr/lib/sysusers.d/tilo-hosted.conf; numeric here because the accounts are
# made further down). Its capabilities are given by tilo-hosted.service at start
# (an image build's name the build's own user namespace, not the host's).
# The ESP writer also answers to /usr/libexec/tilo-uki-cmdline (the last link
# below): under that name it is the in-place UKI command-line and .osrel editor
# the boot-entry pass reads (os/components.toml).
RUN chown 0:10001 /usr/libexec/tilo/tilo-hosted-jail \
    && chmod 0750 /usr/libexec/tilo/tilo-hosted-jail \
    && chmod 0755 /usr/libexec/tilo/tilo-api \
        /usr/libexec/tilo/tilolang-process \
        /usr/libexec/tilo/tilo-linux-vm /usr/libexec/tilo/tilo-image-trust \
        /usr/libexec/tilo/tilo-device-key-init \
        /usr/libexec/tilo-esp-write /usr/libexec/tilo-image-policy-check \
        /usr/libexec/tilo-board-successor /usr/bin/fs \
        /usr/libexec/tilo/tilo-auth /usr/libexec/tilo/tilo-boot-signin \
        /usr/libexec/tilo/tilo-rollback /usr/libexec/tilo/tilo-crypto \
        /usr/libexec/tilo-default-start \
    && ln -s ../libexec/tilo/tilo-linux-vm /usr/bin/tilo-linux-vm \
    && ln -s ../libexec/tilo/tilo-image-trust /usr/bin/tilo-image-trust \
    && ln -s tilo-esp-write /usr/libexec/tilo-uki-cmdline

# ---- What hosting a VM needs ------------------------------------------------
# The service runs as tilo-hosted (10001): the jail refuses any other caller. The
# helper's configuration is root-owned in a root-owned directory, as it requires.
COPY os/containers/tilo-vm-host/hosted-jail.json /etc/tilo/hosted-jail.json
# fetch-guest accepts only the guest the release key signed (/etc/containers/
# policy.json's scope for registry.tilo.so/tilo/hosted-guest).
COPY os/etc/containers/policy.json /etc/containers/policy.json
# Where the signatures are: cosign keeps them as sigstore attachments in the same
# repository, which skopeo looks at only when told to.
COPY os/etc/containers/registries.d/registry.tilo.so.yaml /etc/containers/registries.d/registry.tilo.so.yaml
COPY keys/cosign.pub /usr/share/tilo/cosign.pub
COPY keys/release/ /usr/share/tilo/release/

# ---- Scripts ----------------------------------------------------------------
# The machine setup and the start the VM host's own image shares (so a host that
# runs in a pod and one that owns a machine run one start), the server health
# verdict, the boot-entry maintenance and the verified update.
COPY os/usr/libexec/tilo-hosted-prepare os/usr/libexec/tilo-hosted-serve \
     os/usr/libexec/tilo-server-health os/usr/libexec/tilo-server-update-window \
     os/usr/libexec/tilo-server-update-apply \
     os/usr/libexec/tilo-boot-health \
     os/usr/libexec/tilo-deployment os/usr/libexec/tilo-verified-update \
     os/usr/libexec/tilo-update-channel os/usr/libexec/tilo-update-policy-check \
     os/usr/libexec/tilo-update-policy-set \
     os/usr/libexec/tilo-image-trust-staged os/usr/libexec/tilo-esp-mount \
     os/usr/libexec/tilo-runtime-state-migrate \
     os/usr/libexec/tilo-server-unlock os/usr/libexec/tilo-server-update-policy \
     os/usr/libexec/tilo-server-control os/usr/libexec/tilo-server-device-config \
     os/usr/libexec/tilo-disk-encrypt os/usr/libexec/tilo-store-volume \
     os/usr/libexec/tilo-rollback-common os/usr/libexec/tilo-rollback-confirm \
     os/usr/libexec/tilo-rollback-harden os/usr/libexec/tilo-rollback-initrd-unlock \
     os/usr/libexec/tilo-root-discover \
     /usr/libexec/
# Finding and opening the root. The same dracut modules the desktop image builds
# into its initramfs: 91tilo-rollback carries tilo-auth, tilo-rollback's unlock
# helper, tilo-root-discover and the NetworkManager that reaches the owner's
# other devices. bootc install generates this image's initramfs from it, so an
# installed server's boot can open its own root.
COPY os/usr/lib/systemd/system-generators/tilo-rollback-unlock-generator \
     os/usr/lib/systemd/system-generators/tilo-root-generator \
     /usr/lib/systemd/system-generators/
# Nothing else mounts the ESP on an installed server: the generator mounts the
# one the boot loader started from at /boot (or /boot/efi beside a separate
# /boot), where boot-entry maintenance, the ESP writer and systemd-bless-boot
# look for it.
COPY os/usr/lib/systemd/system-generators/tilo-esp-generator \
     /usr/lib/systemd/system-generators/
COPY os/usr/lib/dracut/modules.d/91tilo-rollback /usr/lib/dracut/modules.d/91tilo-rollback
# The public half of the key that signs a generation's PCR prediction: what a
# TPM keyslot is sealed to, and what early boot verifies the prediction against.
COPY keys/tpm2-pcr-signing.public.pem /usr/share/tilo/tpm2-pcr-signing.public.pem
RUN install -d -m 0755 /usr/share/tilo/pcr-predictions

# ---- Initramfs ---------------------------------------------------------------
# The kernel has to open this machine's root before there is a userspace, and the
# only place that can happen is an initramfs built with the unlock module in it.
# dracut runs here, from the desktop image's own script, with the module list a
# headless machine has: the crypt stack and the unlock chain with the sibling
# factor's network, without the greeter and the splash. The `uki` stage seals it
# into the UKI beside the kernel.
COPY os/scripts/build-initramfs.sh os/scripts/verify-board-initramfs.py /usr/local/bin/
RUN chmod 0755 /usr/local/bin/build-initramfs.sh /usr/local/bin/verify-board-initramfs.py \
    && set -- /usr/lib/modules/*/vmlinuz \
    && [ "$#" -eq 1 ] && [ -f "$1" ] \
    && kver="$(basename "$(dirname "$1")")" \
    && TILO_INITRAMFS_MODULES="crypt systemd-cryptsetup tpm2-tss tilo-rollback" \
       bash /usr/local/bin/build-initramfs.sh "$kver"
RUN chmod 0755 /usr/libexec/tilo-hosted-prepare /usr/libexec/tilo-hosted-serve \
        /usr/libexec/tilo-server-health /usr/libexec/tilo-server-update-window \
        /usr/libexec/tilo-server-update-apply \
        /usr/libexec/tilo-boot-health /usr/libexec/tilo-deployment \
        /usr/libexec/tilo-verified-update /usr/libexec/tilo-update-channel \
        /usr/libexec/tilo-update-policy-check /usr/libexec/tilo-update-policy-set \
        /usr/libexec/tilo-image-trust-staged \
        /usr/libexec/tilo-esp-mount /usr/libexec/tilo-runtime-state-migrate \
        /usr/libexec/tilo-server-unlock \
        /usr/libexec/tilo-server-update-policy \
        /usr/libexec/tilo-server-device-config \
        /usr/libexec/tilo-disk-encrypt /usr/libexec/tilo-store-volume \
        /usr/libexec/tilo-rollback-common /usr/libexec/tilo-rollback-confirm \
        /usr/libexec/tilo-rollback-harden /usr/libexec/tilo-rollback-initrd-unlock \
        /usr/libexec/tilo-root-discover \
        /usr/lib/systemd/system-generators/tilo-rollback-unlock-generator \
        /usr/lib/systemd/system-generators/tilo-root-generator \
        /usr/lib/systemd/system-generators/tilo-esp-generator \
        /usr/lib/dracut/modules.d/91tilo-rollback/module-setup.sh

# ---- Units ------------------------------------------------------------------
# A server runs the device's one daemon (tilo-runtime.service), with this
# image's own drop-in for the configuration only a server reads, and the units
# a server's person drives it with. The device's key is the daemon account's,
# made and kept by the units every device runs.
COPY os/usr/lib/systemd/system/tilo-runtime.service \
    os/usr/lib/systemd/system/tilo-runtime-state-migrate.service \
    os/usr/lib/systemd/system/tilo-device-key-init.service \
    os/usr/lib/systemd/system/tilo-device-branch.service \
    os/usr/lib/systemd/system/tilo-server-unlock.service \
    os/usr/lib/systemd/system/tilo-hosted.service \
    os/usr/lib/systemd/system/tilo-api.service \
    os/usr/lib/systemd/system/tilo-boot-entries.service \
    os/usr/lib/systemd/system/tilo-boot-entries.timer \
    os/usr/lib/systemd/system/tilo-boot-health.service \
    os/usr/lib/systemd/system/tilo-boot-fallback.service \
    os/usr/lib/systemd/system/tilo-deployment-finalize.service \
    os/usr/lib/systemd/system/tilo-esp-write@.service \
    os/usr/lib/systemd/system/tilo-server-health.service \
    os/usr/lib/systemd/system/tilo-server-update-apply.service \
    os/usr/lib/systemd/system/tilo-server-update-apply.timer \
    os/usr/lib/systemd/system/tilo-server-update-policy.service \
    os/usr/lib/systemd/system/tilo-server-update-policy.path \
    os/usr/lib/systemd/system/tilo-server-control.service \
    os/usr/lib/systemd/system/tilo-server-control.path \
    os/usr/lib/systemd/system/tilo-server-device-config.service \
    os/usr/lib/systemd/system/tilo-server-device-config.path \
    os/usr/lib/systemd/system/tilo-rollback-confirm.service \
    os/usr/lib/systemd/system/tilo-rollback-confirm.timer \
    os/usr/lib/systemd/system/tilo-rollback-harden.service \
    os/usr/lib/systemd/system/tilo-rollback-harden.timer \
    /usr/lib/systemd/system/
# An update stages where the desktop's does — verified, counted before the
# reboot, finalized at the next boot — and this image's own step boots into it
# only inside the operator's window and after the running generation passed its
# health check. The desktop-only hooks (system extensions, live update) are
# absent because the units they start are.
COPY os/usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/05-tilo-composefs.conf \
    os/usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/10-tilo-boot-entries.conf \
    os/usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/15-tilo-server-window.conf \
    os/usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/20-tilo-update-policy.conf \
    os/usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/30-tilo-background-resources.conf \
    /usr/lib/systemd/system/bootc-fetch-apply-updates.service.d/
COPY os/usr/lib/systemd/system/bootc-fetch-apply-updates.timer.d/05-tilo-composefs.conf \
    /usr/lib/systemd/system/bootc-fetch-apply-updates.timer.d/05-tilo-composefs.conf
COPY os/usr/lib/systemd/system/bootc-finalize-staged.service.d/10-tilo-finalize.conf \
    /usr/lib/systemd/system/bootc-finalize-staged.service.d/10-tilo-finalize.conf
COPY os/usr/lib/systemd/system/systemd-bless-boot.service.d/10-tilo-writable-esp.conf \
    /usr/lib/systemd/system/systemd-bless-boot.service.d/10-tilo-writable-esp.conf
COPY os/usr/lib/systemd/system/tilo-boot-health.service.d/10-tilo-server.conf \
    /usr/lib/systemd/system/tilo-boot-health.service.d/10-tilo-server.conf
# What a server is, in the one daemon's configuration.
COPY os/usr/lib/systemd/system/tilo-runtime.service.d/50-server.conf \
    /usr/lib/systemd/system/tilo-runtime.service.d/50-server.conf

COPY os/usr/lib/sysusers.d/tilo-identity.conf \
    os/usr/lib/sysusers.d/tilo-runtime.conf \
    os/usr/lib/sysusers.d/tilo-hosted.conf \
    os/usr/lib/sysusers.d/tilo-api.conf \
    /usr/lib/sysusers.d/
COPY os/usr/lib/tmpfiles.d/tilo-runtime-state.conf \
    /usr/lib/tmpfiles.d/
# pasta, one per workspace VM, opens /dev/net/tun; the node exists only once the
# module is loaded, and the service's own machine setup refuses to start without
# it.
COPY os/etc/modules-load.d/tilo-hosted.conf /usr/lib/modules-load.d/tilo-hosted.conf
# The device-trust group owns the certificate directories, so it has to exist before tmpfiles-setup
# runs. The daemon account owns the device key, which this group is never given; there is no
# session user on a server image, so it is the only account that joins this narrow boundary,
# for the certificates it serves.
RUN systemd-sysusers /usr/lib/sysusers.d/tilo-identity.conf /usr/lib/sysusers.d/tilo-runtime.conf \
        /usr/lib/sysusers.d/tilo-hosted.conf /usr/lib/sysusers.d/tilo-api.conf

COPY docs/recovery.md docs/app-model/environments.md /usr/share/doc/tilo/

# Which image this is: a first boot and the installer tell a server from a
# desktop by it. `server` and not `dev`: everything that treats `dev` as a
# development image — split boot entries, the development signing key, dev-only
# paths — treats this one as a release image.
RUN install -d -m 0755 /usr/lib/tilo && echo server > /usr/lib/tilo/image-flavour

# Default server config: the workspaces this machine keeps, its own web
# listener, and the relay it shows its code at, so a data-centre server behind
# a network address translation is reached. Its state is the device daemon's
# own, the same root every device keeps. A deployment replaces it with its own.
RUN printf 'iroh_listen = "0.0.0.0:0"\ntrust_policy = { kind = "allow_matching_user" }\nrelay = "https://use1-1.relay.n0.iroh.link."\n' \
        > /etc/tilo/server.toml

# Enable services. The update timer keeps its Tilo drop-ins: it stages a verified
# image with its try counter and never reboots blindly, and
# tilo-server-update-apply is the only step that restarts the machine into a
# staged one.
RUN systemctl enable tilo-device-key-init.service \
    && systemctl enable tilo-device-branch.service \
    && systemctl enable tilo-runtime.service \
    && systemctl enable tilo-runtime-state-migrate.service \
    && systemctl enable tilo-server-unlock.service \
    && systemctl enable tilo-hosted.service \
    && systemctl enable tilo-api.service \
    && systemctl enable chronyd.service \
    && systemctl enable firewalld.service \
    && systemctl enable tilo-boot-entries.timer \
    && systemctl enable tilo-boot-health.service \
    && systemctl enable tilo-boot-fallback.service \
    && systemctl enable tilo-server-update-apply.timer \
    && systemctl enable tilo-server-update-policy.path \
    && systemctl enable tilo-server-control.path \
    && systemctl enable tilo-server-device-config.path \
    && systemctl enable bootc-fetch-apply-updates.timer \
    && systemctl enable tilo-rollback-harden.timer \
    && systemctl enable tilo-rollback-confirm.timer \
    && systemctl set-default multi-user.target

# The server does not run a graphical session; disable greetd + gdm
# in case anything transitively pulls them in.
RUN systemctl mask greetd.service gdm.service || true

# Prune everything the headless server does not need on the boot path.
# Even more aggressive than the desktop image: no display stack, no
# session manager, no `wait-online` blockers (iroh does its own NAT
# traversal + reconnect), no plymouth. `|| true` so a missing unit
# doesn't fail the image build.
RUN for u in \
        NetworkManager-wait-online.service \
        systemd-networkd-wait-online.service \
        plymouth-quit-wait.service \
        plymouth-quit.service \
        man-db-cache-update.timer \
        man-db-cache-update.service \
        systemd-update-utmp.service \
        pipewire.socket \
        pipewire-pulse.socket \
        wireplumber.service \
    ; do systemctl mask "$u" || true; done

# Nothing merges a system or configuration extension at boot. systemd-sysext and
# systemd-confext would merge every image or plain directory under /etc, /run and
# /var/lib/{extensions,confexts} with systemd's default image policy, which takes
# unsigned images, so a file written to /var would overlay /usr or /etc on the
# next boot. These units exist in the base; a missing one fails the build.
RUN systemctl mask systemd-sysext.service systemd-confext.service systemd-sysext.socket \
    && for u in systemd-sysext.service systemd-confext.service systemd-sysext.socket; do \
         test "$(readlink "/etc/systemd/system/$u")" = /dev/null; \
       done

# No one signs in at a server's consoles. Its consoles show the enrollment code,
# and a person reaches the machine through their own workspaces: every account,
# root's included, carries a locked password, so a getty and the emergency shell
# (sulogin) open for nobody. A test disk adds its own account at install
# (os/account.env), never in the image.
#
# The only setuid program left is sudo, for such an added account; every other
# setuid and setgid bit in /usr goes. The services run as their own accounts with
# NoNewPrivileges= (tilo-hosted takes its capabilities from its unit), so none of
# those programs did anything for them but widen what a compromised one could try.
RUN usermod -L root \
    && awk -F: '$2 !~ /^[!*]/ { print "unlocked account: " $1; bad = 1 } END { exit bad }' /etc/shadow \
    && find /usr -xdev -type f -perm /6000 ! -path /usr/bin/sudo -exec chmod ug-s {} + \
    && test "$(find /usr -xdev -type f -perm /6000)" = /usr/bin/sudo

# Signed-image trust roots — the same policy the desktop image uses. It
# requires a logged release signature for the official Tilo repositories and
# refuses unlisted origins; this operator-built image records
# `localhost/tilo-host` as its update origin, so update it from local
# storage (`bootc switch --transport containers-storage localhost/tilo-host`),
# which the policy admits as locally built.
COPY os/etc/containers/registries.d/code.tilo.so.yaml /etc/containers/registries.d/code.tilo.so.yaml
COPY os/etc/containers/registries.d/registry.tilo.so.yaml /etc/containers/registries.d/registry.tilo.so.yaml

# Same bootloader swap as the desktop image (os/Containerfile.host-base installs systemd-boot
# and drops the GRUB stack); the install-time configuration it reads is this image's.
COPY os/usr/lib/bootc/install/40-tilo.toml /usr/lib/bootc/install/40-tilo.toml
# The desktop's command line, which the `uki` stage seals into the UKI from
# kargs.d: the root found and opened by the unlock chain (00-root), kernel
# hardening (01: lockdown, zeroed allocations, no merged slabs, a randomised
# stack offset, no vsyscall page), the boot's consoles, the serial one included
# (03), the normal boot mode the repair entry is derived from (04), and no
# systemd credentials from firmware or the boot loader (05). The generation (02)
# is written further down.
COPY os/usr/lib/bootc/kargs.d/00-root.toml os/usr/lib/bootc/kargs.d/01-hardening.toml \
    os/usr/lib/bootc/kargs.d/03-boot.toml os/usr/lib/bootc/kargs.d/04-mode.toml \
    os/usr/lib/bootc/kargs.d/05-credentials.toml \
    /usr/lib/bootc/kargs.d/
# Nor do the consoles' gettys ask for credentials: there are none, and asking
# keeps them from starting.
COPY os/usr/lib/systemd/system/serial-getty@.service.d/10-tilo-no-credentials.conf \
    /usr/lib/systemd/system/serial-getty@.service.d/10-tilo-no-credentials.conf
COPY os/usr/lib/systemd/system/getty@.service.d/10-tilo-no-credentials.conf \
    /usr/lib/systemd/system/getty@.service.d/10-tilo-no-credentials.conf

# firewalld default zone: the FedoraServer zone drops all inbound
# except explicitly permitted. Iroh punches out; the server does not
# need any inbound-hole in the firewall to be reachable. The zone's own
# ssh and cockpit services go: neither program is on the machine, and an
# open port is one a later package could start listening on.
# The base's mDNS responder answers on every interface, and nothing on a server
# is found that way: it shows a code, or spends the token made for it.
RUN systemctl mask avahi-daemon.service avahi-daemon.socket

RUN firewall-offline-cmd --set-default-zone=FedoraServer \
    && firewall-offline-cmd --zone=FedoraServer --remove-service-from-zone=ssh \
    && firewall-offline-cmd --zone=FedoraServer --remove-service-from-zone=cockpit \
    && test "$(firewall-offline-cmd --zone=FedoraServer --list-services)" = dhcpv6-client

# The generation this image carries, a dense series of the server's own
# (registry.tilo.so/tilo/tilo-host's gen<N> tags, os/dev/next-generation.sh): on
# the sealed command line through kargs.d, which systemd-stub measures into PCR
# 11 and the TPM keyslot of each generation is bound to, and in
# /usr/lib/tilo/generation for the staged deployment whose keyslot is made
# before it boots. os/Containerfile's generation step says why it has no default.
ARG TILO_GENERATION
RUN case "${TILO_GENERATION}" in \
      ''|*[!0-9]*) echo "TILO_GENERATION must be a decimal integer; got '${TILO_GENERATION}'." >&2; exit 1 ;; \
    esac \
 && printf '%s\n' "${TILO_GENERATION}" > /usr/lib/tilo/generation \
 && printf '# Written by the image build from the TILO_GENERATION build argument.\nkargs = ["tilo.generation=%s"]\n' \
      "${TILO_GENERATION}" > /usr/lib/bootc/kargs.d/02-generation.toml

RUN bootc container lint
# The last layer of the rootfs: NetworkManager's resolver file (the
# runtime-resolver-link stage says why it comes after every RUN). The sealing
# stages follow, and add nothing to it.
COPY --from=runtime-resolver-link /out/ /etc/
