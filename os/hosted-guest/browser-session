#!/bin/sh
# A workspace VM's Browser session: one headless Tilo desktop, drawn on the
# CPU, that joins its workspace as a device of it (docs/hosted-browser.md).
#
# The guest agent runs this, as the tenant, at the workspace's first browser
# action (`crates/runtime/legacy-vm/src/hosted/browser.rs`, "The session in the
# guest"): it becomes the image's own unprivileged browser user, then runs the
# VM's headless session (headless-session) as that user, with no X11, and the
# session knows it holds a hosted Browser from `TILO_HOSTED_BROWSER`. What workspace it joins arrives on its standard input,
# as one line of material, and what it reports goes to its standard output.
#
# Every setting here has a default the image needs; an operator or the build's
# smoke test may name a shell-compatible KEY=VALUE file to override them, and
# `TILO_SESSION_ARGS` holds the session's own arguments.
#
# Usage: browser-session [CONFIG]
#   CONFIG  default: $TILO_BROWSER_SESSION_CONFIG, when it names one
#   TILO_BROWSER_STORE names the folder of the workspace's files the profile
#   is kept in between runs, when the workspace keeps it.
#
# The process it starts is the sandbox's own: nothing here runs as root, and
# SIGTERM to this script ends the session and the bus beside it, and the script
# once they have.
set -eu

# Never the tenant: the tenant has sudo in their VM, and a page that got out of
# Chromium's sandbox must not. The sudoers rule the image ships allows this one
# hop and keeps the input, the output and the marks.
user=tilo-browser
as_browser() { sudo -n -u "$user" -- "$0" "$@"; }
if [ "$(id -un)" != "$user" ]; then
    store=${TILO_BROWSER_STORE:-}
    [ -n "$store" ] || exec sudo -n -u "$user" -- "$0" "$@"
    # The profile (cookies, storage) is kept among the workspace's own files
    # between runs: restored before the session starts, written back once it
    # ended, and replaced whole, so a save cut short keeps the last one.
    profile=$store/profile.tar.gz
    if [ -s "$profile" ]; then
        as_browser --restore < "$profile" || echo 'browser-session: the saved profile did not restore' >&2
    fi
    # A background job's input is /dev/null unless named: the material is on 3.
    # sudo itself, not a function in a subshell, so SIGTERM reaches it, and
    # sudo hands it on.
    exec 3<&0
    sudo -n -u "$user" -- "$0" "$@" <&3 &
    session=$!
    trap 'kill -TERM "$session" 2>/dev/null || true' TERM INT
    status=0
    wait "$session" || status=$?
    # A signal ends the first wait; the session is still writing its profile.
    wait "$session" 2>/dev/null || true
    if as_browser --save > "$profile.new"; then
        mv -f "$profile.new" "$profile"
    else
        rm -f "$profile.new"
        echo 'browser-session: the profile was not saved' >&2
    fi
    exit "$status"
fi

# What a device is (its identity and secrets, handed fresh at every start), its
# runtime directory, and what Chromium fetches again (caches) are never saved.
case ${1:-} in
    --restore)
        cd "$(getent passwd "$(id -u)" | cut -d: -f6)" && exec tar -xzf - ;;
    --save)
        cd "$(getent passwd "$(id -u)" | cut -d: -f6)" && exec tar -czf - --exclude=./.config/tilo/identity \
            --exclude=./.local/share/tilo/secrets --exclude=./.local/share/tilo/runtime \
            --exclude=./.cache --exclude='*/Cache' --exclude='*/Code Cache' \
            --exclude='*/GPUCache' . ;;
esac

# No X11: Browser is not an X11 client, so nothing here serves an X display.
exec /usr/libexec/tilo/headless-session --no-x11 "${1:-${TILO_BROWSER_SESSION_CONFIG:-}}"
