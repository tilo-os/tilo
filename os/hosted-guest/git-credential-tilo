#!/bin/sh
# git's https credential helper for the programs a workspace's VM runs.
#
# It answers git's `get` from the environment, and nothing otherwise, so a
# program whose environment the workspace's vault gave a token clones and
# pushes over https without the token being stored in the VM:
#
#   TILO_GIT_TOKEN       the token: a vault item of the workspace (one vault
#                        per workspace, under its owners' permissions), or
#                        TILO_GIT_TOKEN_FILE naming a file that holds it
#   TILO_GIT_HOST        the host the token is for (code.tilo.so): the helper
#                        never answers another host, so a repository URL a
#                        program is given cannot ask for the workspace's token
#   TILO_GIT_USER        the username it is used with (default: git)
#
# A program with none of them is left to git's own prompt, as on a device.
set -eu

[ "${1:-}" = get ] || exit 0

token=${TILO_GIT_TOKEN:-}
if [ -z "$token" ] && [ -n "${TILO_GIT_TOKEN_FILE:-}" ]; then
  token=$(cat "$TILO_GIT_TOKEN_FILE" 2>/dev/null || true)
fi
[ -n "$token" ] || exit 0
token=$(printf '%s' "$token" | tr -d '\r\n')
[ -n "$token" ] || exit 0
host=$(printf '%s' "${TILO_GIT_HOST:-}" | tr 'A-Z' 'a-z')
[ -n "$host" ] || exit 0
user=${TILO_GIT_USER:-git}

# The request git writes is `key=value` lines, one per line, then a blank
# line: the host is the one the credential is for.
wanted=no
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && break
  case $line in
    host=*)
      asked=$(printf '%s' "${line#host=}" | tr 'A-Z' 'a-z')
      asked=${asked%%:*}
      [ "$asked" = "$host" ] && wanted=yes
      ;;
  esac
done
[ "$wanted" = yes ] || exit 0

printf 'username=%s\npassword=%s\n' "$user" "$token"
