#!/bin/sh
# The workspace's t: the checkout tool that runs a project's checks, builds
# and tests on the shared server instead of inside the VM
# (docs/hosted-browser.md). The image carries this launcher, not the program:
# the first call downloads t from the server it is named for and caches it
# under the tenant's own cache, and every call after that execs the cached
# copy with its arguments.
#
# t reads its server and its token from the environment, so neither is written
# to disk: T_SERVER names the server (default https://t.tilo.so) and T_TOKEN
# is the token that server knows, which the workspace's vault puts in a
# program's environment. Without a cached copy and without T_TOKEN, the
# launcher says which vault item to grant and exits.
#
# The download is the one t's own self-update makes: the server's build of t
# for this machine, T_SERVER/v1/client?target=<triple>&file=t, with the token in
# an Authorization header. The server states the build's SHA-256 in the
# x-t-sha256 header, and the launcher caches only a download that matches it,
# so a page in the program's place (a login, an error) is refused rather than
# cached. Once cached, t keeps itself on the server's build.
set -eu

server=${T_SERVER:-https://t.tilo.so}
cache=${XDG_CACHE_HOME:-${HOME:?}/.cache}/t/t

if [ -x "$cache" ]; then
    exec "$cache" "$@"
fi

if [ -z "${T_TOKEN:-}" ]; then
    echo 't: no token: grant this workspace the vault item holding the t token (it arrives as T_TOKEN), then run t again' >&2
    exit 1
fi

url="$server/v1/client?target=$(uname -m)-unknown-linux-gnu&file=t"
dir=$(dirname -- "$cache")
mkdir -p -m 700 "$dir"
tmp=$(mktemp "$dir/.t.XXXXXX")
head=$(mktemp "$dir/.t.XXXXXX")
trap 'rm -f "$tmp" "$head"' EXIT HUP INT TERM

if ! curl -fsSL --max-time 300 -H "Authorization: Bearer $T_TOKEN" -D "$head" -o "$tmp" "$url"; then
    echo "t: could not download $url" >&2
    exit 1
fi

# What arrived is the program only if it is the build the server says it is: a
# page in its place (a login, an error) has no matching SHA-256, and this says
# so once instead of caching something that cannot run.
want=$(tr -d '\r' <"$head" | sed -n 's/^[Xx]-[Tt]-[Ss][Hh][Aa]256: *//p' | tail -n 1)
got=$(sha256sum "$tmp" | cut -d ' ' -f 1)
if [ -z "$want" ] || [ "$want" != "$got" ]; then
    echo "t: $url answered with something other than t's build (no matching x-t-sha256): is T_SERVER a t server?" >&2
    exit 1
fi
chmod 0755 "$tmp"
if ! "$tmp" --version >/dev/null 2>&1; then
    echo "t: the program $url served does not run on this machine" >&2
    exit 1
fi

mv -f "$tmp" "$cache"
rm -f "$head"
trap - EXIT HUP INT TERM
exec "$cache" "$@"
