#!/bin/bash
# The hosted guest's init, PID 1 in every hosted workspace VM.
#
# It is not systemd: a VM here wakes when a workspace's first command arrives
# and must answer within a few hundred milliseconds, so boot is this script and
# then the guest agent (crates/runtime/legacy-agent), nothing else. The kernel
# command line baked into the image is
#   root=/dev/vda rw init=/usr/libexec/tilo/hosted-init
# and the host adds what is about this VM alone: its console and
# `ip=10.0.2.15::10.0.2.2:255.255.255.0::eth0:off:10.0.2.3`.
#
# Everything here is idempotent or guarded, so a VM restored from a snapshot
# (which resumes mid-run, not from this script) and one booted cold end in the
# same state.
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root

say() { printf 'hosted-init: %s\n' "$*"; }

# The kernel mounted / read-write (its command line says so); say it again, so
# that a host that passed `ro` still gets a guest whose home is writable.
mount -o remount,rw / 2>/dev/null || say 'left / as the kernel mounted it'

# /proc and /sys first: the rest of this reads them, and apt, rustup and node
# all read them later.
mountpoint -q /proc || mount -t proc -o nosuid,nodev,noexec proc /proc
mountpoint -q /sys || mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mkdir -p /dev/pts /dev/shm
mountpoint -q /dev || mount -t devtmpfs -o nosuid,strictatime,mode=0755 devtmpfs /dev
# A pty relay runs in the guest, as user tilo: the pts nodes must be its.
mountpoint -q /dev/pts \
  || mount -t devpts -o nosuid,noexec,gid=5,mode=620,ptmxmode=666 devpts /dev/pts
mountpoint -q /dev/shm || mount -t tmpfs -o nosuid,nodev,mode=1777 tmpfs /dev/shm
mountpoint -q /run || mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run
mountpoint -q /tmp || mount -t tmpfs -o nosuid,nodev,mode=1777 tmpfs /tmp

# The disk the host grew for this VM: the filesystem grows to fill it. Online,
# on the mounted root, and only when there is something to grow into.
if [ -b /dev/vda ]; then
  resize2fs /dev/vda >/dev/null 2>&1 && say 'grew / to the disk' \
    || say 'left / at its own size'
fi

# cgroup v2, with the controllers a tenant's containers ask for delegated.
mkdir -p /sys/fs/cgroup
mountpoint -q /sys/fs/cgroup || mount -t cgroup2 -o nosuid,nodev,noexec cgroup2 /sys/fs/cgroup
if [ -w /sys/fs/cgroup/cgroup.subtree_control ]; then
  for controller in cpu cpuset io memory pids; do
    printf '+%s ' "$controller"
  done > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || true
fi

printf 'tilo' > /proc/sys/kernel/hostname 2>/dev/null || true

# DNS: the host forwards to 10.0.2.3, and the kernel only records that in
# /proc/net/pnp (CONFIG_IP_PNP) when it was told a server on the command line.
# glibc reads /etc/resolv.conf, so write what the kernel was given, or the
# host's own forwarder when it was given none.
{
  if [ -r /proc/net/pnp ] && grep -q '^nameserver ' /proc/net/pnp 2>/dev/null; then
    sed -n 's/^nameserver /nameserver /p' /proc/net/pnp
  else
    printf 'nameserver 10.0.2.3\n'
  fi
} > /etc/resolv.conf.new && mv /etc/resolv.conf.new /etc/resolv.conf

ip link set lo up || say 'lo stayed down'

# The agent serves the host over vsock and runs a workspace's programs as a
# child of its own. tini is its subreaper, so whatever a program leaves behind
# is reaped here rather than accumulating against PID 1; this script stays PID 1
# so that the agent ending is noticed instead of hanging the VM silently.
/usr/bin/tini -s -- /usr/libexec/tilo/tilo-legacy-agent --user tilo
status=$?
say "the guest agent exited with status $status; stopping this VM"
sync
# PID 1 exiting panics the kernel, and the host's `panic=1` then resets the
# guest, which Firecracker answers by ending its own process: the VM stops
# without a shutdown helper this image would otherwise have to carry.
exit "$status"
