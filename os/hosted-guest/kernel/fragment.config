# What the hosted guest changes about Firecracker's microvm configuration, and
# what it requires of it. `tools/ci/publish/hosted-guest.sh kernel` merges this
# over kernel/base.config before `make olddefconfig`, and then asserts every
# line below against the resolved configuration with os/kernel/check-config.py:
# a config that drifts away from any of these fails the build instead of
# shipping a kernel whose VMs cannot boot.

# --- The command line the image boots with ----------------------------------
# A VM here has no initramfs: /dev/vda is the base disk the host reflinked,
# mounted read-write, and the guest's own init is PID 1. Firecracker's host
# side passes only what is about that VM (its `ip=` and console); these come
# from the kernel, so an image boots the same way whoever boots it. On x86
# the built-in line comes first and the host's follows it (nothing here sets
# CMDLINE_OVERRIDE, which would drop the host's).
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="root=/dev/vda rw init=/usr/libexec/tilo/hosted-init"

# The guest names itself this, and `uname -r` says which kernel a VM runs.
CONFIG_DEFAULT_HOSTNAME="tilo"
CONFIG_LOCALVERSION="-tilo"

# --- No modules --------------------------------------------------------------
# Everything a VM needs is built in: there is no module loader, no initramfs
# to carry modules and no second place a driver could come from.
# CONFIG_MODULES is not set

# --- virtio-mmio, with devices announced on the command line -----------------
# Firecracker's transports are virtio-mmio over a fixed map. The kernel finds
# them from the host's announcement, so no ACPI or PCI enumeration is needed
# for a device to appear.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- The guest agent's transports -------------------------------------------
# The agent listens on AF_VSOCK for the host; it mounts each granted directory
# as a FUSE filesystem served over that socket.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_FUSE_FS=y

# --- The root filesystem ------------------------------------------------------
# A raw ext4 the guest grows online to the disk it was given (resize2fs
# /dev/vda), on a devtmpfs /dev and a tmpfs /tmp, /run and /dev/shm.
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- The console ---------------------------------------------------------------
# Firecracker's serial console is a 16550: it is the VM's only console, and the
# only way a boot that goes wrong says so.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Networking ---------------------------------------------------------------
# The host configures the interface from the command line
# (ip=10.0.2.15::10.0.2.2:255.255.255.0::eth0:off:10.0.2.3), so the guest has
# an address before init runs and no DHCP client of its own.
CONFIG_IP_PNP=y
CONFIG_INET=y
CONFIG_UNIX=y

# --- Programs in the VM -------------------------------------------------------
# A pty relay runs in the guest, and a tenant may run containers in it: namespaces,
# cgroups, overlayfs, a bridge and NAT over veths are what rootless podman needs.
# Rootless containers reach the network through a userspace forwarder and need
# none of the netfilter below; with sudo, podman's netavark programs nftables.
CONFIG_UNIX98_PTYS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- The hypervisor -----------------------------------------------------------
# Firecracker is KVM: paravirtual time, no hardware discovery, no firmware.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_CLOCK=y
