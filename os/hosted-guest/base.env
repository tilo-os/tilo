# The Fedora base the hosted workspace VM guest's root filesystem builds FROM:
# the release every Tilo binary is built on (os/Containerfile.builder), so the
# session and Browser in the guest run as built. Pinned by digest: the tag
# moves, the digest does not, so a rebuild of the guest gets the same Fedora 44
# as the one before it.
#
# HOSTED_GUEST_BASE_SOURCE is the tag it was pinned from. Bumping it means editing both
# lines, and the guest image's digest changes with the new base.
HOSTED_GUEST_BASE_SOURCE=registry.fedoraproject.org/fedora:44
HOSTED_GUEST_BASE_REF=registry.fedoraproject.org/fedora:44@sha256:55159f5c92b7baf5f1c1ca1d727c95e77a4cb77c0829b2c11740a700ff4ea02b
