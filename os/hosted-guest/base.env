# The Debian base the hosted workspace VM guest's root filesystem builds FROM.
# Pinned by digest: the tag moves, the digest does not, so a rebuild of the
# guest gets the same Debian trixie as the one before it. The browser guest does
# not build from it: its root filesystem is the Fedora base the Tilo OS image is
# built from (os/base-snapshot.env), because what it runs is the OS's own
# userspace.
#
# HOSTED_GUEST_BASE_SOURCE is the tag it was pinned from. Bumping it means editing both
# lines, and the guest image's digest changes with the new base.
HOSTED_GUEST_BASE_SOURCE=docker.io/library/debian:13-slim
# OCI index over amd64/arm64/arm/v5/arm/v7/386/ppc64le/riscv64/s390x, as
# Docker Hub served it when this was pinned; the amd64 manifest is what an
# x86_64 guest build takes.
HOSTED_GUEST_BASE_REF=docker.io/library/debian@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
