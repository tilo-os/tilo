#!/bin/sh
# A workspace VM's Linux apps session: the VM's headless Tilo desktop
# (headless-session), run as the workspace's tenant with Xwayland, holding the
# windows of the Linux apps the workspace opens (docs/hosted-browser.md, "Linux
# apps").
#
# The VM's daemon (vm-daemon) starts this, as root, at the workspace's first
# Linux app, with `TILO_HOSTED_APPS` marking what it holds and the link to
# the daemon on file descriptor 3. The session asks the daemon for each app to
# start. Each app's windows are shared with the workspace's members, who see
# and drive them on their own shells.
#
# It is the tenant's: the apps are the tenant's own programs, run with the
# tenant's files, never as Browser's account and never with its profile.
# setpriv, not sudo: sudo closes every descriptor but the standard three, and
# the link is the session's one way to its daemon.
#
# Usage: apps-session [CONFIG]
#   CONFIG  default: $TILO_SESSION_CONFIG, when it names one
set -eu

user=tilo
if [ "$(id -u)" = 0 ]; then
    # The daemon's link, handed on by name: a session started without it fails
    # here.
    exec setpriv --reuid="$user" --regid="$user" --init-groups -- "$0" "$@" 3<&3
fi
if [ "$(id -un)" != "$user" ]; then
    echo "apps-session: the Linux apps are the tenant's, never $(id -un)'s" >&2
    exit 1
fi
exec /usr/libexec/tilo/headless-session --x11 "$@"
