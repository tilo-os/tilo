# syntax=docker/dockerfile:1.7
# The hosted VM guests: the Linux environments on a host that serves other
# people's workspaces (Firecracker, crates/runtime/legacy-vm/src/hosted).
#
# Two variants build from this one file, and both are a root *filesystem*, not a
# disk and not an installed system: no systemd, no bootloader, no kernel
# inside. tools/ci/publish/hosted-guest.sh exports the container's filesystem
# into a raw ext4 (`rootfs.ext4`), which every VM's disk starts as a reflinked
# copy of, and that the guest grows to its size at boot. PID 1 is
# os/hosted-guest/hosted-init, which mounts what a guest needs, grows the
# filesystem and hands over to the guest agent (crates/runtime/legacy-agent) —
# a VM must answer within a few hundred milliseconds of being restored.
#
#   `--target workspace` (the default, the last stage): the Linux VM a
#   workspace's own programs run in. Debian because the tenant gets a
#   distribution they know: `apt install` works, and so does everything else
#   they would do on their own machine. It carries the compilers and the
#   language runtimes.
#
#   `--target browser`: the browser environment (docs/hosted-browser.md), which
#   runs one Tilo session in place of a person's computer: the headless session
#   drawing on the CPU (the hosts have no GPU), Browser as the signed tapp a
#   device installs, and the Chromium engine runtime it requires. It has no
#   compiler and no language runtime; its stages say what it holds.
ARG BASE_REF
# The build context holding the guest agent, built by this repository's CI
# (hosted-guest.sh agent). The three names below are also what
# os/external-assets/github-assets.tsv pins, and the cache
# hosted-guest.sh passes as the github-assets context is verified against it
# before this build starts.
ARG NODE_ASSET=node-v26.13.0-linux-x64.tar.xz
ARG FNM_ASSET=fnm-1.39.0-linux.zip
ARG RUSTUP_INIT_ASSET=rustup-init-x86_64-unknown-linux-gnu

FROM scratch AS external-assets
COPY --from=github-assets / /

# ---- What every guest has ----------------------------------------------------
# The tenant's own account (uid 1000, a real shell), the subreaper the agent
# runs under (tini), e2fsprogs to grow the filesystem at boot, and the guest
# agent with the init that runs it. Neither the agent nor the init is a service:
# nothing else is started, and there is no manager to start it with.
FROM ${BASE_REF} AS guest-base
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      e2fsprogs \
      iproute2 \
      passwd \
      tini \
      util-linux \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives
RUN useradd --create-home --uid 1000 --user-group --shell /bin/bash tilo \
 && install -d -o tilo -g tilo /home/tilo/.local/bin /home/tilo/.local/share
COPY --from=hosted-agent /tilo-legacy-agent /usr/libexec/tilo/tilo-legacy-agent
COPY os/hosted-guest/hosted-init /usr/libexec/tilo/hosted-init
RUN set -eu; \
    chmod 0755 /usr/libexec/tilo/hosted-init /usr/libexec/tilo/tilo-legacy-agent; \
    bash -n /usr/libexec/tilo/hosted-init; \
    agent_says=$(/usr/libexec/tilo/tilo-legacy-agent --user no-such-user 2>&1 || true); \
    case $agent_says in \
      *"no ordinary user"*) echo 'agent: runs on this root filesystem' ;; \
      *) echo "agent: $agent_says"; exit 1 ;; \
    esac

# ---- The browser guest's payload --------------------------------------------
# Browser and its engine runtime, and the app store, arranged exactly as a
# device arranges them (os/scripts/pack-apps.sh, tilo-install). Python, binutils
# and the libraries the shared runtime loads on first use live in this stage
# only: the root filesystem the hypervisor boots holds none of them.
#
#   session          hosted-guest.sh browser-session: /usr as the session's
#                    components install it (os/components.toml)
#   compiled         os/image/compile.sh's tree: the thin-app runtime, Browser's
#                    binary and the packing tools
#   chromium-engine  os-chromium-<arch>: the pinned CEF build
#   font-seed        every font of the catalog, by digest
FROM guest-base AS browser-payload
ARG CHROMIUM_RUNTIME_VERSION
ARG RUNTIME_RELEASE=2026.07
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} RUNTIME_RELEASE=${RUNTIME_RELEASE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      binutils \
      libglib2.0-0t64 \
      libgstreamer-plugins-base1.0-0 \
      libgstreamer1.0-0 \
      python3 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives
# The repository the pack scripts read: the app manifests and their budgets,
# the fonts' catalog, and the tools.
COPY os/ /build/os/
COPY apps/browser/ /build/apps/browser/
COPY crates/packaging/tilo-app-package/max-app-bytes /build/crates/packaging/tilo-app-package/max-app-bytes
COPY crates/sdk/ui-core/assets/fonts/ /build/crates/sdk/ui-core/assets/fonts/
COPY tools/ /build/tools/
COPY --from=compiled / /out/
COPY --from=chromium-engine / /run/tilo-chromium/
COPY --from=font-seed / /run/tilo-fonts/
# The catalog's fonts for the runtime bundle's own copy (`lib/fonts`, which the
# launcher mounts into an app's sandbox).
RUN python3 /build/tools/font-catalog.py prepare /build/crates/sdk/ui-core/assets/fonts \
      /out/fonts --scope product --cache /run/tilo-fonts --offline
# The shared runtime bundle the thin apps link: this build's own, signed here
# and trusted by the guest's own publisher list (below). It carries the native
# closure of the runtime, Browser and the runtime's engines, resolved from this
# stage's root filesystem, so the guest needs none of those libraries itself.
RUN set -eu; \
    python3 /build/os/scripts/collect-runtime-dependencies.py --library-dir /out \
        /out/libruntime_dylib.so /out/tilo-runtime-account-capability \
        $(sed "s|^|/out/|" /out/runtime-engines) /out/thin-apps/browser > /tmp/dependencies; \
    libstd="$(find /out -maxdepth 1 -name 'libstd-*.so' -print -quit)"; \
    test -n "$libstd"; \
    /out/tilo-runtime-bundle key generate --out /tmp/runtime-identity.json; \
    args=(/out/tilo-runtime-bundle build --release "$RUNTIME_RELEASE" --arch "$(uname -m)" --from /); \
    args+=(--include /out/libruntime_dylib.so --include-bin /out/tilo-runtime-account-capability); \
    args+=(--include /out/fonts --include "$libstd"); \
    while IFS= read -r engine; do args+=(--include "/out/$engine"); done < /out/runtime-engines; \
    while IFS= read -r dependency; do args+=(--include "$dependency"); done < /tmp/dependencies; \
    args+=(--identity /tmp/runtime-identity.json --out-root /usr/lib/tilo-runtime --version-out /out/runtime-version); \
    "${args[@]}"; \
    /out/tilo-runtime-bundle key pubkey --identity /tmp/runtime-identity.json > /out/runtime-bundle-publisher.hex; \
    /out/tilo-runtime-bundle verify "/usr/lib/tilo-runtime/$(cat /out/runtime-version)" \
        --require-publisher "$(cat /out/runtime-bundle-publisher.hex)"; \
    bash /build/os/scripts/verify-runtime-bundle-closure.sh \
        "/usr/lib/tilo-runtime/$(cat /out/runtime-version)" \
        /out/tilo-runtime-account-capability /out/thin-apps/browser; \
    rm -f /tmp/runtime-identity.json
# The Chromium engine's own runtime bundle, signed here too: Browser's manifest
# lists it in `[package].optional-runtimes`, so the launcher mounts it into the
# app's sandbox and refuses to start Browser without it. The version is the
# browser's ui::webview::chromium::runtime::RUNTIME_VERSION; the build fails
# when the two disagree.
RUN set -eu; \
    pinned="$(sed -n 's/^pub const RUNTIME_VERSION: &str = "\([^"]*\)";$/\1/p' \
        /build/crates/sdk/ui-core/src/webview/chromium/runtime.rs)"; \
    test -n "$pinned"; \
    test "$pinned" = "$CHROMIUM_RUNTIME_VERSION"; \
    test -x /run/tilo-chromium/chromium-engine/chromium/tilo-chromium-host; \
    /out/tilo-runtime-bundle key generate --out /tmp/engine-identity.json; \
    /out/tilo-runtime-bundle build --version "$CHROMIUM_RUNTIME_VERSION" --arch "$(uname -m)" --from / \
        --include /run/tilo-chromium/chromium-engine/chromium \
        --identity /tmp/engine-identity.json \
        --out "/usr/lib/tilo-runtime/$CHROMIUM_RUNTIME_VERSION"; \
    /out/tilo-runtime-bundle key pubkey --identity /tmp/engine-identity.json \
        > /out/browser-runtime-publisher.hex; \
    /out/tilo-runtime-bundle verify "/usr/lib/tilo-runtime/$CHROMIUM_RUNTIME_VERSION" \
        --require-publisher "$(cat /out/browser-runtime-publisher.hex)"; \
    test -x "/usr/lib/tilo-runtime/$CHROMIUM_RUNTIME_VERSION/lib/chromium/tilo-chromium-host"; \
    rm -f /tmp/engine-identity.json
# Browser, packed and installed the way a device installs an app: `tilo-app-package
# pack` then `tilo-install install`, into the image-wide store, described by the
# same registry rows a person's own package gets. The store is written at the
# path it occupies on the booted guest (`tilo-install` records absolute payload
# paths), and its trees get the signed records a read-only store is verified
# against.
RUN export TILO_IMAGE_BUILD=1 \
    && BIN_DIR=/out/thin-apps \
       COHORT_APPS=browser \
       REQUIRE_MIN=1 \
       TAPP_BUDGET=report \
       PKG_BIN=/out/tilo-app-package INSTALL_BIN=/out/tilo-install \
       BUNDLE_BIN=/out/tilo-runtime-bundle SHIM_BIN=/out/tilo-cli-shim \
       PUBKEY_OUT=/out/app-publisher.hex \
       RUNTIME_ID="tilo-runtime/$(cat /out/runtime-version)" \
       /build/os/scripts/pack-apps.sh \
    && python3 /build/os/scripts/signed-records.py name-trees /usr/share/tilo-apps \
    && python3 /build/os/scripts/signed-records.py store /usr/share/tilo-apps /signatures/usr/share/tilo-apps \
    && TILO_APPS_DATA_DIR=/usr/share/tilo-apps /out/tilo-install verify
# The publishers this build's own bundles were signed with, which the launcher
# checks a runtime bundle against before it mounts one.
RUN mkdir -p /etc/tilo \
 && cat /out/runtime-bundle-publisher.hex /out/browser-runtime-publisher.hex \
      > /etc/tilo/runtime-bundle-trusted-publishers.txt \
 && test "$(grep -c . /etc/tilo/runtime-bundle-trusted-publishers.txt)" = 2

# ---- The browser guest -------------------------------------------------------
# What a device has of Tilo, on a root filesystem that holds nothing else: the
# session and Browser (above), and the libraries the session draws with and the
# engine runs against. No compiler, no shell tools, no node, no Rust, no Python.
FROM guest-base AS browser
ARG CHROMIUM_RUNTIME_VERSION
# Mesa's software Vulkan driver is how the session draws: the hosts have no GPU,
# so every frame is rasterized on the CPU (wgpu takes lavapipe's adapter). The
# rest is what the session's Wayland/X11 client stack and CEF's libcef.so record
# in DT_NEEDED, and what Chromium needs for offscreen rendering (NSS, cups,
# fonts, audio) — the check below fails the build, naming the library, when a
# list falls short.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      dbus \
      fontconfig \
      fonts-dejavu-core \
      libasound2t64 \
      libatk1.0-0t64 \
      libatspi2.0-0t64 \
      libatomic1 \
      libcairo2 \
      libcups2t64 \
      libdbus-1-3 \
      libdrm2 \
      libegl1 \
      libexpat1 \
      libfontconfig1 \
      libfreetype6 \
      libgbm1 \
      libgl1 \
      libgl1-mesa-dri \
      libglib2.0-0t64 \
      libglvnd0 \
      libglx0 \
      libharfbuzz-icu0 \
      libharfbuzz0b \
      libice6 \
      libinput10 \
      libnspr4 \
      libnss3 \
      libopengl0 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libpcre2-8-0 \
      libpixman-1-0 \
      libseat1 \
      libselinux1 \
      libsm6 \
      libstdc++6 \
      libudev1 \
      libunwind8 \
      libvulkan1 \
      libwayland-client0 \
      libwayland-egl1 \
      libwayland-server0 \
      libx11-6 \
      libx11-xcb1 \
      libxcb-cursor0 \
      libxcb-image0 \
      libxcb-keysyms1 \
      libxcb-randr0 \
      libxcb-render0 \
      libxcb-shape0 \
      libxcb-shm0 \
      libxcb-sync1 \
      libxcb-xfixes0 \
      libxcb-xkb1 \
      libxcb1 \
      libxcomposite1 \
      libxcursor1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxi6 \
      libxinerama1 \
      libxkbcommon-x11-0 \
      libxkbcommon0 \
      libxrandr2 \
      libxrender1 \
      libxres1 \
      libxtst6 \
      mesa-libgallium \
      mesa-vulkan-drivers \
      zlib1g \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives
# The session, its fonts and its interface declaration (as the check arranged
# them), then the store and the runtimes from the payload stage, then the script
# the guest agent starts a session with and the proof that it does.
COPY --from=session /usr/ /usr/
COPY --from=browser-payload /usr/lib/tilo-runtime/ /usr/lib/tilo-runtime/
COPY --from=browser-payload /usr/share/tilo-apps/ /usr/share/tilo-apps/
COPY --from=browser-payload /signatures/usr/share/tilo-apps/ /usr/share/tilo-apps/
COPY --from=browser-payload /etc/tilo/runtime-bundle-trusted-publishers.txt /etc/tilo/runtime-bundle-trusted-publishers.txt
COPY --chmod=0755 os/hosted-browser-guest/browser-session /usr/libexec/tilo/browser-session
COPY --chmod=0755 os/hosted-browser-guest/smoke.sh /usr/libexec/tilo/browser-guest-smoke
# Everything the guest starts must load on this root filesystem: the session and
# its surface apps, the launcher, the store's tools, the engine host and CEF
# itself. A missing library fails the build here, by name.
RUN set -eu; \
    binaries="$(find /usr/bin /usr/libexec/tilo -maxdepth 1 -type f -perm -u+x)"; \
    engine="/usr/lib/tilo-runtime/$CHROMIUM_RUNTIME_VERSION/lib/chromium"; \
    missing="$(LD_LIBRARY_PATH="$engine" ldd $binaries "$engine/tilo-chromium-host" "$engine/libcef.so" \
               | awk '/not found/ { print $1 }' | sort -u)"; \
    if [ -n "$missing" ]; then \
      printf 'the browser guest has unresolved runtime libraries:\n%s\n' "$missing" >&2; \
      exit 1; \
    fi; \
    fc-cache -s >/dev/null; \
    fc-list | grep -q . || { echo 'the guest resolves no font' >&2; exit 1; }
# Start the session and the engine on this root filesystem, which is what a boot
# would do: the build fails here rather than on a host's first environment.
RUN /usr/libexec/tilo/browser-guest-smoke
# What this image says it has, in the build log.
RUN set -eu; \
    du -shx / 2>/dev/null | sed 's/^/rootfs: /'; \
    for unneeded in python3 node cargo rustc gcc cc; do \
      if command -v "$unneeded" >/dev/null; then \
        echo "the browser guest carries $unneeded" >&2; exit 1; \
      fi; \
    done

# A directory the session owns, where a device's programs start.
WORKDIR /home/tilo

# ---- The workspace guest -----------------------------------------------------
# The Linux VM a workspace's own programs run in: node, Rust, a C toolchain,
# git, python, and the archivers everything unpacks. Nothing in it is a Tilo
# component beyond the agent and the init above.
FROM guest-base AS workspace
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl \
      git \
      build-essential \
      pkg-config \
      libssl-dev \
      python3 \
      python3-pip \
      python3-venv \
      unzip \
      xz-utils \
      zstd \
      jq \
      less \
      procps \
      openssh-client \
      sudo \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives
# sudo without a password because the VM is theirs and nobody else is in it.
RUN printf 'tilo ALL=(ALL:ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/tilo \
 && chmod 0440 /etc/sudoers.d/tilo

# node: fnm manages the versions, this build places the one that ships. The
# tarball is checksum-pinned in os/external-assets/github-assets.tsv and put
# where fnm keeps a version's installation (node-versions/v<version>/installation),
# so `fnm install` and `fnm use` work for the tenant and the shipped LTS is
# just the version it comes with.
ARG NODE_ASSET
ARG FNM_ASSET
COPY --from=external-assets /${FNM_ASSET} /var/tmp/fnm.zip
COPY --from=external-assets /${NODE_ASSET} /var/tmp/node.tar.xz
ENV FNM_DIR=/home/tilo/.local/share/fnm
RUN set -eu; \
    v=${NODE_ASSET#node-}; \
    v=${v%-linux-x64.tar.xz}; \
    install -d -o tilo -g tilo /var/tmp/fnm \
      "$FNM_DIR/node-versions/v$v/installation"; \
    unzip -q -o /var/tmp/fnm.zip -d /var/tmp/fnm; \
    install -o tilo -g tilo -m 0755 /var/tmp/fnm/fnm /home/tilo/.local/bin/fnm; \
    tar -xJf /var/tmp/node.tar.xz -C "$FNM_DIR/node-versions/v$v/installation" \
      --strip-components=1; \
    chown -R tilo:tilo "$FNM_DIR"; \
    rm -rf /var/tmp/fnm /var/tmp/fnm.zip /var/tmp/node.tar.xz

# node, npm and npx on PATH for every shell and for every program the agent
# starts, without a shell hook: the agent sets PATH to
# /usr/local/bin:/usr/bin:/bin (crates/runtime/legacy-agent/src/launch.rs).
ARG NODE_ASSET
RUN set -eu; \
    v=${NODE_ASSET#node-}; \
    node_bin="$FNM_DIR/node-versions/v${v%-linux-x64.tar.xz}/installation/bin"; \
    ln -sf /home/tilo/.local/bin/fnm /usr/local/bin/fnm; \
    for program in node npm npx corepack; do \
      if [ -e "$node_bin/$program" ]; then ln -sf "$node_bin/$program" "/usr/local/bin/$program"; fi; \
    done

# rust: rustup (checksum-pinned) with the stable toolchain, minimal profile —
# cargo, rustc, rustup and rustdoc, and no documentation or clippy the tenant
# did not ask for. `rustup component add` and `rustup toolchain install` work.
ARG RUSTUP_INIT_ASSET
COPY --from=external-assets /${RUSTUP_INIT_ASSET} /var/tmp/rustup-init
RUN set -eu; \
    install -d -o tilo -g tilo /home/tilo/.cargo /home/tilo/.rustup; \
    chmod 0755 /var/tmp/rustup-init; \
    su -s /bin/bash tilo -c \
      "env HOME=/home/tilo RUSTUP_HOME=/home/tilo/.rustup CARGO_HOME=/home/tilo/.cargo \
         /var/tmp/rustup-init -y --profile minimal --default-toolchain stable --no-modify-path"; \
    for tool in /home/tilo/.cargo/bin/*; do \
      ln -sf "$tool" "/usr/local/bin/${tool##*/}"; \
    done; \
    rm -f /var/tmp/rustup-init

# What this image says it has, in the build log: a guest whose node, rust or
# agent went missing fails here rather than in somebody's workspace. node and
# rust are asked as the tenant asks them — through the PATH the agent gives a
# program and with HOME set to the tenant's — so a toolchain that only works
# for root fails this build.
RUN set -eu; \
    du -shx / 2>/dev/null | sed 's/^/rootfs: /'; \
    node --version | sed 's/^/node: /'; \
    npm --version | sed 's/^/npm: /'; \
    fnm --version | sed 's/^/fnm: /'; \
    su -s /bin/bash tilo -c 'cargo --version; rustc --version' | sed 's/^/rust: /'; \
    python3 --version | sed 's/^/python: /'

# A directory the tenant owns, at the paths their programs start in.
WORKDIR /home/tilo
