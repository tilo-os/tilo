# Fast quality needs Rust metadata/formatting and repository policy tools, not
# the compositor's graphics, media, browser or legacy application test subjects.
# Reuse the reviewed compiler and audit binaries; never resolve a floating Rust.
# Built by .forgejo/workflows/build-ci-fast-image.yml. Keep the base on the
# builder's Fedora release: the copied audit tools link against its glibc.
ARG TOOLS_IMAGE=code.sandbox.example/qos/tilo-builder@sha256:568fca1f8b4a4b1700c871cca033d2d291a5eb02c4b3be9681410f456b5a7bc9
FROM ${TOOLS_IMAGE} AS tools

FROM registry.fedoraproject.org/fedora:44@sha256:55159f5c92b7baf5f1c1ca1d727c95e77a4cb77c0829b2c11740a700ff4ea02b
RUN dnf install -y --setopt=install_weak_deps=False \
      bash coreutils findutils grep sed tar gzip git python3 jq ripgrep nodejs \
      ca-certificates curl libgcc libstdc++ zlib-ng-compat \
      gnupg2 diffutils which \
    && dnf clean all

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

# Preserve the installed component manifest: rust-toolchain.toml requests
# rustfmt, clippy, rust-src and rust-analyzer even when this lane only formats.
COPY --from=tools /usr/local/rustup/toolchains/1.97.1-x86_64-unknown-linux-gnu/ /usr/local/rustup/toolchains/1.97.1-x86_64-unknown-linux-gnu/
COPY --from=tools /usr/local/cargo/bin/rustup /usr/local/cargo/bin/rustup
COPY --from=tools /usr/local/cargo/bin/cargo-deny /usr/local/cargo/bin/cargo-deny
COPY --from=tools /usr/local/cargo/bin/cargo-machete /usr/local/cargo/bin/cargo-machete
COPY --from=tools /usr/local/rustup/settings.toml /usr/local/rustup/settings.toml
# Assembly may run on ARM64 under emulation. Run the full lint workflow and
# compiler smoke on a native amd64 runner before promoting this image digest.
RUN for tool in cargo rustc rustfmt cargo-fmt; do ln -s rustup /usr/local/cargo/bin/$tool; done \
    && test -x /usr/local/cargo/bin/cargo-deny \
    && test -x /usr/local/cargo/bin/cargo-machete
