# The scratch registry a disk install pushes its image into, since the composefs backend cannot
# read container storage (os/dev/disk-image.sh), and the checks that serve an image to a VM start:
# docker.io's registry 2.8.3 by digest, from its copy in registry.tilo.so
# (tools/ci/publish/mirrored-images.tsv), so the steps that start one fetch nothing a tag moves.
SCRATCH_REGISTRY_IMAGE=registry.tilo.so/tilo/registry@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
