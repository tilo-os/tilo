# syntax=docker/dockerfile:1.7
# ============================================================================
# The env-runtime environment image: the minimal userland every environment's
# /usr and /etc start from (docs/app-model/environments.md, "Images").
#
# Built natively per architecture from Tilo's frozen RPM snapshot into an
# empty installroot, with the network disabled, and exported as a plain tree
# (target `tree`). .forgejo/workflows/build-env-runtime.yml seals each tree
# into a signed `env-runtime` tapp and publishes both tapps as the
# digest-addressed image registry.tilo.so/tilo/env-runtime:set-<fingerprint>
# (target `published`), which the OS image and the tilo-session-apps RPM
# ship in their system app store.
#
# Every tool image is bound to one exact runtime package id, so a new
# runtime means rebuilding every tool. This file's bytes are the fingerprint
# (os/dev/resolve-env-runtime.sh): change it — the package list or the
# version below — only to publish a new runtime.
#
# env-runtime-version: 44.1.0
#
# The packages, and nothing else: the markers below are also how the frozen
# snapshot learns to carry them (os/dev/derive-rpm-package-set.py). git is a
# tool, not part of the runtime. dnf5 and rpm are here because tool images
# are built by running dnf inside this runtime.
#
# tilo-rpm-snapshot-package: bash
# tilo-rpm-snapshot-package: coreutils
# tilo-rpm-snapshot-package: util-linux-core
# tilo-rpm-snapshot-package: findutils
# tilo-rpm-snapshot-package: grep
# tilo-rpm-snapshot-package: sed
# tilo-rpm-snapshot-package: gawk
# tilo-rpm-snapshot-package: tar
# tilo-rpm-snapshot-package: gzip
# tilo-rpm-snapshot-package: xz
# tilo-rpm-snapshot-package: which
# tilo-rpm-snapshot-package: less
# tilo-rpm-snapshot-package: ncurses-base
# tilo-rpm-snapshot-package: glibc-langpack-en
# tilo-rpm-snapshot-package: ca-certificates
# tilo-rpm-snapshot-package: curl
# tilo-rpm-snapshot-package: dnf5
# tilo-rpm-snapshot-package: rpm
# tilo-rpm-snapshot-package: fedora-release-common
# tilo-rpm-snapshot-package: fedora-repos
# ============================================================================
ARG BASE_REF
ARG RPMS_REF

FROM ${RPMS_REF} AS rpms

FROM ${BASE_REF} AS assemble
COPY os/Containerfile.env-runtime /tilo/Containerfile.env-runtime
# Explicit reposdir hides every network repository, and the RUN has no
# network: the runtime holds exactly the snapshot's packages, scriptlets run.
# The bootc base keeps its own rpm database where rpm-ostree wants it; the
# runtime's goes where the runtime's own rpm and dnf look, which the check
# inside the root proves. An image keeps only the execute bit of a file's
# mode, so every file is made readable for the unprivileged packer.
RUN --network=none --mount=type=bind,from=rpms,source=/repo,target=/repo,ro \
    set -eux \
 && sed -n 's/^# tilo-rpm-snapshot-package: //p' /tilo/Containerfile.env-runtime \
      > /tilo/packages.txt \
 && test "$(wc -l < /tilo/packages.txt)" -ge 10 \
 && printf '%%_dbpath %%{_usr}/lib/sysimage/rpm\n' > /etc/rpm/macros.zz-env-runtime-dbpath \
 && mkdir /envroot \
 && xargs -a /tilo/packages.txt dnf5 --installroot=/envroot --releasever=44 \
      --use-host-config --setopt=reposdir=/repo --setopt=install_weak_deps=False \
      --setopt=tsflags=nodocs install -y \
 && rpm --root /envroot -qa \
      --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' \
    | LC_ALL=C sort > /packages.txt \
 && test -s /packages.txt \
 && test -x /envroot/usr/bin/bash \
 && test -x /envroot/usr/bin/dnf5 \
 && chroot /envroot /usr/bin/rpm -q bash dnf5 \
 && chroot /envroot /usr/bin/bash -c 'cd / && ls >/dev/null' \
 && chmod -R u+rwX,go+rX /envroot/usr /envroot/etc

# The tree an `env-runtime` tapp is sealed from, and the exact packages in it.
FROM scratch AS tree
COPY --from=assemble /envroot/usr /usr
COPY --from=assemble /envroot/etc /etc
COPY --from=assemble /packages.txt /packages.txt

# The published image: the sealed tapps of both architectures, passed in as
# the `sealed` build context. Identical for every platform.
FROM scratch AS published
COPY --from=sealed / /env-runtime/
