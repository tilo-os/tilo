{
  "default": [
    { "type": "insecureAcceptAnything" }
  ],
  "transports": {
    "docker": {
      "code.sandbox.example/qos/tilo": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/usr/share/tilo/cosign.pub",
          "signedIdentity": { "type": "matchRepository" }
        }
      ],
      "code.sandbox.example/qos/tilo-vm": [
        { "type": "reject" }
      ],
      "code.sandbox.example/qos/tilo-ci": [
        { "type": "reject" }
      ],
      "code.sandbox.example/qos/tilo-dev": [
        { "type": "reject" }
      ]
    }
  }
}
