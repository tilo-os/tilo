{
  "default": [
    { "type": "insecureAcceptAnything" }
  ],
  "transports": {
    "docker": {
      "code.podesta.ai/tilo/tilo": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/usr/share/tilo/cosign.pub",
          "signedIdentity": { "type": "matchRepository" }
        }
      ]
    }
  }
}
