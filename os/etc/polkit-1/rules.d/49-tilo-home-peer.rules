// The executable itself accepts only bounded operations: apply a validated
// stdin projection, record a root-signed home-server admission it verifies,
// or receive an identity on a new personal device. Approval signing happens
// unprivileged, in the owner's session, never here.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/tilo-home-peer-control" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
    return polkit.Result.NOT_HANDLED;
});
