// The person at the machine may install, remove or refresh the opt-in codec
// pack from Settings: three exact unit instances, only `start`, only for a
// local, active session of an administrator (wheel). The helper validates its
// argument again and runs in a sandboxed unit that can write only the pack's
// own state, cache and /var/lib/extensions trees. It grants no general unit,
// package-manager or file access.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.local || !subject.active || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    if (verb === "start" &&
        /^tilo-codec-pack@(install|remove|refresh)\.service$/.test(unit)) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
