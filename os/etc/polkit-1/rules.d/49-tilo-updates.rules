// Let the person sitting at the machine roll it back and control its updates,
// and let its desktop finish a live system update at an idle moment
// (tilo-live-update-session.service restarts the desktop in place).
//
// Settings shows a rollback control and an "Automatic updates" switch. Both need
// root: one reorders the boot loader's entries, the other enables or disables a
// system timer. The desktop runs as an ordinary user, so without a rule here the
// controls can only ever report a permission error — which is how the toggle came
// to write a preference file that nothing read.
//
// The signed image staging service is also callable by the per-user ush broker.
// That broker may not have a logind seat even though it runs as the wheel user,
// so it gets one exact unit: staging a verified update. It cannot roll back,
// change the schedule, select a boot entry, or reboot the machine.
polkit.addRule(function (action, subject) {
    if ((action.id == "org.freedesktop.systemd1.manage-units" ||
         action.id == "org.freedesktop.systemd1.manage-unit-files") &&
        action.lookup("unit") == "tilo-deployment-update.service" &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});

// The remaining grant is deliberately narrow on three axes at once:
//
//   * BY UNIT. Not "manage units", but these unit names. Anything else on
//     the system bus falls through to the default policy unchanged.
//   * BY SUBJECT. subject.local && subject.active: a session physically at this
//     machine's seat and currently in the foreground. An ssh session, a screen
//     that has been switched away from, and a background service get nothing.
//   * BY GROUP. wheel, i.e. the accounts that already administer this machine.
//
// What that adds up to: someone who could already reboot the machine from the
// desktop can also choose which image it reboots into. It grants no ability to
// read data, install software, or reach another user's session. Repair mode is
// separately gated on the disk passphrase — see docs/security/repair-mode.md.
polkit.addRule(function (action, subject) {
    var units = {
        "tilo-deployment-rollback.service": true,
        "tilo-live-update-session.service": true,
        "bootc-fetch-apply-updates.timer": true,
        "tilo-update-policy@schedule-system.service": true,
        "tilo-update-policy@schedule-daily.service": true,
        "tilo-update-policy@schedule-weekly.service": true,
        "tilo-update-policy@metered-allow.service": true,
        "tilo-update-policy@metered-avoid.service": true
    };
    if ((action.id == "org.freedesktop.systemd1.manage-units" ||
         action.id == "org.freedesktop.systemd1.manage-unit-files") &&
        units[action.lookup("unit")] === true &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
