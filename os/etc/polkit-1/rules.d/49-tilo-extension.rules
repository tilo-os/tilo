// The person at the machine may install, remove or refresh a Tilo extension
// from Settings or first-login setup: only `start`, only of
// tilo-extension@<verb>:<id>.service with one of three verbs, only for a local,
// active session of an administrator (wheel). The helper accepts only ids the
// image has a catalogue entry for, verifies everything it downloads against a
// manifest signed by Tilo's extension-manifest key, and runs in a sandboxed unit that
// can write only its own state, cache and /var/lib/extensions. This grants no
// general unit, package-manager or file access.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.local || !subject.active || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    if (verb === "start" &&
        /^tilo-extension@(install|remove|refresh):[a-z0-9][a-z0-9-]{0,62}\.service$/.test(unit)) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
