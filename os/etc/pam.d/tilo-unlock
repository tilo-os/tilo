#%PAM-1.0
# Tilo session-unlock PAM stack.
#
# Used by `tilo-unlock-helper`, which the compositor spawns to verify the
# logged-in user's credential while the session is LOCKED. The helper only
# runs the auth + account phases (pam_authenticate + pam_acct_mgmt) — it never
# opens a session or starts a login — so this stack defines no session or
# password phase.
#
# An unlock accepts what tilo-auth accepts (os/etc/pam.d/tilo-auth): a
# fingerprint, since the person's key is held for the session that is locked,
# or the secret through tilo-authd.
auth       substack     tilo-auth

account    include      tilo-auth
