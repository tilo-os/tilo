#%PAM-1.0
# sudo (and sudo -i, whose sudo-i service includes this one). Who may confirm,
# and with what, is tilo-auth's (os/etc/pam.d/tilo-auth); the session phase is
# the sudo package's own.
auth       substack     tilo-auth
account    include      tilo-auth
password   substack     tilo-auth
session    optional     pam_keyinit.so revoke
session    required     pam_limits.so
session    include      system-auth
