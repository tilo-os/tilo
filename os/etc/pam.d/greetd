#%PAM-1.0
# Tilo greetd PAM stack — used by greetd (and therefore the graphical
# tilo-greeter) to authenticate the user before StartSession.
#
# Who may sign in, and with what, is tilo-auth's: the boot sign-in, a
# fingerprint while the person's key is held, then the secret through
# tilo-authd (os/etc/pam.d/tilo-auth). A substack, so the keyring hook below
# still runs after a factor that ends tilo-auth's stack early.
#
# Tilo's own Secret Service (tilo-secret-service) owns org.freedesktop.secrets
# and opens with the device identity after any login method.  The two
# gnome-keyring hooks below remain for one purpose only: at a password login
# they unlock the person's old GNOME login keyring, which tilo-secret-service
# reads once and imports.  Nothing of gnome-keyring serves the bus name.
auth       substack     tilo-auth
# After the password is verified: pam_gnome_keyring's auth hook only captures
# the authtok an earlier module obtained (it never prompts), so placed before
# the secret check it saw no password and left the login keyring locked, and
# the first libsecret client (Chromium) made gcr-prompter ask for it.  Fedora's
# gdm-password stack has the same order.
auth       optional     pam_gnome_keyring.so

account    include      tilo-auth

password   substack     tilo-auth

# The session leaves greetd's own domain (xdm_t) for the user's SELinux
# context and gets its login uid, as /etc/pam.d/login does. Without these
# the compositor and every app it starts run as the display manager, whose
# policy forbids what a user session needs (scopes, sandboxes, home access).
# pam_systemd, limits and keyinit in password-auth's session register the
# started session with logind.
session    required     pam_selinux.so close
session    required     pam_loginuid.so
session    required     pam_selinux.so open
session    required     pam_namespace.so
session    optional     pam_keyinit.so force revoke
session    include      password-auth
session    optional     pam_gnome_keyring.so auto_start
