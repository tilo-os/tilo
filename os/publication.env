# Public configuration of OS publication, read through tools/ci/publish/lib.sh `publication`.
# None is secret.
#
# The Lenovo 83ED board's firmware, imported for its board image
# (os/dev/hardware-firmware-artifact.py), and the SHA-256 of its manifest.json, pinned apart
# from the artifact.
TILO_LENOVO_FIRMWARE_REF=code.tilo.so/tilo/tilo-lenovo-83ed-firmware@sha256:9acfd2f48c28cb883c3ef53383da517ab737e9a89a838eeeeaf7ec637fbf72ea
TILO_LENOVO_FIRMWARE_MANIFEST_SHA256=ebe7e978ca8ba6f364420f701db6c3880000dff05bf908be872c9bfa73319b21

# The registry owner's Ed25519 public key, which a release image installs as the trust root of
# system app updates (/usr/share/tilo/trust/tilo-main-registry-owner.pub) and the app release
# signs its registry entries for.
TILO_OFFICIAL_REGISTRY_OWNER_PUBKEY=55d9a9c748bcfe34200832c18c5f0cf7932f17571612321eaa542474fa2abe06
# The DER SHA-256 of keys/efi-signing.crt, pinned apart from it: the EFI signature of a
# release's UKIs must name exactly this certificate.
TILO_EFI_SIGNING_CERT_SHA256=6ce12ddcd6da3a8b678868f3979a61834f7ee1402a49773485748d4442eb0496
