# syntax=docker/dockerfile:1.7
# ============================================================================
# Tilo server image, base: the mirrored Fedora bootc base every Tilo image
# starts from, with the frozen package set an always-on server runs and the
# pinned Firecracker release its VM service starts.
# ============================================================================
# Only what the package snapshot and the base decide lives here, so this layer
# is built once per snapshot and reused by every build above it:
# os/Containerfile.host layers the server's programs and their configuration on
# top in seconds, which is the whole point of the split (tools/ci/publish/
# host-base.sh, host-build.sh). A change to a program or a unit file does not
# touch this file; a change to the packages a server installs does.
#
# It is not a bootable image by itself: it runs no Tilo program and enables no
# Tilo unit. Nothing here compiles — t builds every program (the check
# host-binaries) and os/Containerfile.host lays them out.
#
# host-base.sh builds this file with the desktop's `uki-tools` stage after it
# (os/image/helpers/uki-tools.Containerfile): the throwaway tools that seal the
# server's UKI come out of the same base and snapshot, built once with this
# base and handed to os/Containerfile.host as an image.
# ============================================================================

# ---- Frozen RPM repo + mirrored base (cross-time reproducibility) ----------
ARG BASE_REF
ARG RPMS_REF
FROM ${RPMS_REF} AS rpms

# Firecracker and its jailer, from the release os/external-assets pins.
FROM scratch AS external-assets
COPY --from=github-assets / /

# ---- Runtime base ----------------------------------------------------------
FROM ${BASE_REF} AS host-base

# Buildah leaves the rpms mount out of the layer cache key; this ARG keys it on RPMS_REF.
ARG RPMS_REF
# What a server runs, from the frozen snapshot: time sync, firewall, fuse for the
# filesystem replica, certificates for iroh relays, the network manager, and the
# VM host's programs — passt is pasta (each VM's network), skopeo fetches the
# guest, xfsprogs makes a state disk, libcap gives the jail helper what it needs,
# util-linux's setpriv drops to the service's uid, tar unpacks the member
# identity, and gzip unpacks the Firecracker release below, which is a tarball.
# Its disk is encrypted, so it also carries the early-boot half of that: LUKS and
# the TPM tools the unlock helper drives, and iproute for the NetworkManager the
# initramfs brings up when another of the owner's devices releases its half.
# Then the base's desktop pieces leave: the SSH server, its clients and the VPN
# plugins (a server is reached at its console and through Tilo's own transport),
# the image-signing tools, git, fwupd and the modem manager. So do
# systemd-resolved, which listens for LLMNR on every interface, systemd-networkd,
# a second network manager, and systemd-coredump: NetworkManager alone owns the
# network and its resolver file, as on the desktop. mokutil stays, because the
# base's shim requires it and removing it breaks a protected package.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
        chrony \
        cryptsetup \
        firewalld \
        fuse3 \
        ca-certificates \
        efibootmgr \
        iproute \
        NetworkManager \
        NetworkManager-wifi \
        tpm2-tools \
        wpa_supplicant \
        curl grep gzip libcap passt sed shadow-utils skopeo tar util-linux xfsprogs \
    && dnf clean all \
    && ln -sfn ../run/NetworkManager/resolv.conf /etc/resolv.conf \
    && installed="$(rpm -qa --qf '%{NAME}\n')" \
    && printf '%s\n' "$installed" | awk '/^(systemd-resolved|systemd-networkd|systemd-coredump|openssl|sbsigntools|efitools|pesign|nss-tools|gnutls-utils|git|git-core|openvpn|NetworkManager-openvpn|openssh|openssh-clients|openssh-server|ModemManager|fwupd)$/' \
           | xargs -r dnf --disablerepo='*' remove -y \
    && installed="$(rpm -qa --qf '%{NAME}\n')" \
    && test "$(readlink /etc/resolv.conf)" = ../run/NetworkManager/resolv.conf \
    && ! printf '%s\n' "$installed" | grep -Eq '^(systemd-resolved|systemd-networkd|systemd-coredump|openssl|sbsigntools|efitools|pesign|nss-tools|gnutls-utils|git|git-core|openvpn|NetworkManager-openvpn|openssh|openssh-clients|openssh-server|ModemManager|fwupd)$' \
    && dnf clean all
# Nothing built on this base resolves a name, and with the resolver file
# pointing into /run every RUN would have a DNS file put there, which bootc's
# lint refuses: a plain placeholder until os/Containerfile.host's last layer
# restores the link.
RUN rm -f /etc/resolv.conf && printf '# build-only resolver placeholder\n' > /etc/resolv.conf

# Same bootloader swap as the desktop image: install systemd-boot,
# drop the GRUB stack, tell bootc to plant systemd-boot on the ESP at
# install time (see os/usr/lib/bootc/install/40-tilo.toml for why; the image
# above copies it).
# dnf5 refuses to remove grub2-efi-x64, grub2-pc, grub2-tools-minimal and
# shim-x64 (each marks itself protected in /etc/dnf/protected.d) and does not
# take --allowerasing on `remove`, so the protected ones go through rpm -e
# instead, as they do on the desktop image; bootupd only ever plants GRUB and
# goes with them.
RUN --mount=type=bind,from=rpms,source=/repo,target=/repo dnf install -y --setopt=reposdir=/repo \
    systemd-boot-unsigned \
    && rpm -qa | grep -E '^(shim-(x64|aa64)|grub2-|os-prober-)' | xargs -r rpm -e --nodeps \
    && rpm -e --nodeps bootupd \
    && rm -rf /usr/lib/bootupd /usr/lib/ostree-boot \
    && rm -f /etc/systemd/system/multi-user.target.wants/bootloader-update.service \
    && dnf clean all

# ---- Firecracker -----------------------------------------------------------
ARG FIRECRACKER_ASSET=firecracker-v1.17.0-x86_64.tgz
RUN --mount=type=bind,from=external-assets,source=/,target=/assets,ro \
    mkdir /tmp/fc \
    && tar -xzf "/assets/${FIRECRACKER_ASSET}" -C /tmp/fc \
    && install -m 0755 /tmp/fc/release-v1.17.0-x86_64/firecracker-v1.17.0-x86_64 /usr/local/bin/firecracker \
    && install -m 0755 /tmp/fc/release-v1.17.0-x86_64/jailer-v1.17.0-x86_64 /usr/local/bin/jailer \
    && rm -rf /tmp/fc \
    && firecracker --version | head -1 | grep -qx 'Firecracker v1.17.0'
