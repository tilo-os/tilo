# Only invoked with raw-rootfs bound to a verified immutable local image ID.
FROM raw-rootfs
ARG LOADER_NAME
ARG ARCHITECTURE
ARG ORIGINAL_SHA256
ARG SIGNED_SHA256
RUN --mount=type=bind,from=signed-loader,target=/run/tilo-loader \
    --mount=type=bind,from=loader-tools,target=/run/tilo-loader-tools \
    set -eu; \
    case "$ARCHITECTURE:$LOADER_NAME" in \
      x86_64:systemd-bootx64.efi|aarch64:systemd-bootaa64.efi) ;; \
      *) exit 1 ;; \
    esac; \
    original="/usr/lib/systemd/boot/efi/$LOADER_NAME"; \
    printf '%s  %s\n' "$ORIGINAL_SHA256" "$original" | sha256sum --check --status; \
    printf '%s  %s\n' "$SIGNED_SHA256" /run/tilo-loader/loader.efi | sha256sum --check --status; \
    python3 /run/tilo-loader-tools/verify-authenticode-envelope.py \
      "$original" /run/tilo-loader/loader.efi; \
    test ! -e "$original.signed" && test ! -L "$original.signed"; \
    install -m 0644 /run/tilo-loader/loader.efi "$original.signed"
