{
  "app": "passwords",
  "said": "Passwords",
  "family": "apps",
  "live": "tl",
  "tl": {
    "id": "so.tilo.passwords",
    "package": "passwords"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Passwords on an empty vault",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "actions"
        },
        {
          "wait_for": "New item"
        },
        {
          "targets": true
        }
      ]
    },
    {
      "id": "add",
      "said": "Save a login named Branch mail, with its address and password",
      "ops": {
        "tl": [
          {
            "click_any": [
              {
                "prefix": "New item"
              }
            ]
          },
          {
            "type": "Branch mail"
          },
          {
            "key": "Enter"
          },
          {
            "press_any": [
              "Branch mail"
            ]
          },
          {
            "wait_for": "Edit details"
          },
          {
            "press_any": [
              "Edit details"
            ]
          },
          {
            "click_any": [
              {
                "prefix": "Who it signs in as"
              }
            ]
          },
          {
            "type": "ada@branch.example"
          },
          {
            "click_any": [
              {
                "prefix": "Add a web address"
              }
            ]
          },
          {
            "type": "https://branch.example"
          },
          {
            "key": "Enter"
          },
          {
            "click_any": [
              {
                "prefix": "The password"
              }
            ]
          },
          {
            "type": "kept-on-the-laptop"
          },
          {
            "press_any": [
              "Save"
            ]
          },
          {
            "offered": [
              "ada@branch.example"
            ]
          }
        ]
      },
      "dark": true
    },
    {
      "id": "reveal",
      "said": "Reveal the password behind a question, then hide it again",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Reveal secret"
            ]
          },
          {
            "wait_for": "Reveal"
          },
          {
            "press_any": [
              "Reveal"
            ]
          },
          {
            "offered": [
              "kept-on-the-laptop"
            ]
          },
          {
            "press_any": [
              "Hide"
            ]
          },
          {
            "offered": [
              "••••••••••••"
            ]
          }
        ]
      }
    },
    {
      "id": "review",
      "said": "The password review checks the vault and finds nothing to fix",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Password review"
            ]
          },
          {
            "wait_for": "Passwords checked"
          },
          {
            "wait_for": "Nothing to fix"
          }
        ]
      },
      "dark": true
    },
    {
      "id": "tools",
      "said": "The import and export page offers a backup and the browser's CSV, and app access says nothing uses the vault",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Import and export"
            ]
          },
          {
            "wait_for": "Back up vault…"
          },
          {
            "press_any": [
              "Back up vault…"
            ]
          },
          {
            "wait_for": "Backup password"
          },
          {
            "press_any": [
              "Cancel"
            ]
          },
          {
            "press_any": [
              "App access"
            ]
          },
          {
            "wait_for": "No app can use your vault without asking"
          }
        ]
      }
    }
  ]
}
