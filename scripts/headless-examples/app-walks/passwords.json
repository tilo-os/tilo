{
  "app": "passwords",
  "said": "Passwords",
  "live": "tl",
  "tl": {
    "id": "so.tilo.passwords",
    "package": "passwords"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Passwords on an empty vault: it says nothing is saved yet",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "actions"
        },
        {
          "must": [
            "Your vault is empty",
            "Nothing saved yet"
          ]
        },
        {
          "targets": true
        }
      ]
    },
    {
      "id": "add",
      "said": "Add a login named Branch mail and say who it signs in as: it is listed, and its password, which the vault drew, is shown nowhere",
      "ops": {
        "tl": [
          {
            "click_any": [
              {
                "prefix": "New item"
              }
            ]
          },
          {
            "type": "Branch mail"
          },
          {
            "key": "Enter"
          },
          {
            "must": [
              "Branch mail"
            ]
          },
          {
            "press": "Branch mail"
          },
          {
            "wait_for": {
              "shown": {
                "prefix": "Who it signs in as"
              }
            }
          },
          {
            "click_any": [
              {
                "prefix": "Who it signs in as"
              }
            ]
          },
          {
            "type": "ada@branch.example"
          },
          {
            "key": "Enter"
          },
          {
            "must": [
              "Branch mail",
              "••••••••••••",
              "Copy password",
              "Reveal"
            ]
          },
          {
            "must_not": [
              "Your vault is empty"
            ]
          }
        ]
      },
      "dark": true
    },
    {
      "id": "copy",
      "said": "Copy the password: the vault puts it on the clipboard as a secret, and Passwords never holds it",
      "ops": {
        "tl": [
          {
            "press": "Copy password"
          },
          {
            "state": {
              "clipboard_secret": true,
              "clipboard": null,
              "within": 10
            }
          },
          {
            "must": [
              "••••••••••••"
            ]
          }
        ]
      }
    },
    {
      "id": "reveal",
      "said": "Reveal the item: its password and who it signs in as show in place of the dots",
      "ops": {
        "tl": [
          {
            "press": "Reveal"
          },
          {
            "must": [
              "Hide"
            ]
          },
          {
            "must_not": [
              "••••••••••••",
              "Hidden"
            ]
          },
          {
            "targets": true
          }
        ]
      },
      "dark": true
    },
    {
      "id": "hidden-again",
      "said": "Thirty seconds later the password is hidden again without a press",
      "ops": {
        "tl": [
          {
            "must": {
              "see": [
                "Reveal",
                "••••••••••••"
              ],
              "within": 40
            }
          },
          {
            "must_not": [
              "Hide"
            ]
          }
        ]
      }
    },
    {
      "id": "access",
      "said": "The item's access section lists what used it: Passwords copied it and showed it",
      "ops": {
        "tl": [
          {
            "press": "Who used it"
          },
          {
            "wait_for": {
              "shown": "Close"
            }
          },
          {
            "must": [
              "Passwords"
            ]
          },
          {
            "must_not": [
              "Nobody used it yet."
            ]
          },
          {
            "targets": true
          }
        ]
      }
    },
    {
      "id": "import",
      "said": "Import a browser's CSV of two logins: both are listed, and neither password is shown",
      "ops": {
        "tl": [
          {
            "file": {
              "name": "browser-logins.csv",
              "text": "name,url,username,password\nHarbour wiki,https://wiki.harbour.example/login,lin@harbour.example,made-up-wiki-1\nLantern shop,https://shop.lantern.example,sam@lantern.example,made-up-shop-2\n"
            }
          },
          {
            "press": "Import and export"
          },
          {
            "wait_for": {
              "shown": "Import from CSV…"
            }
          },
          {
            "press": "Import from CSV…"
          },
          {
            "choose": {
              "name": "browser-logins.csv"
            }
          },
          {
            "wait_for": {
              "shown": "Import 2 logins?"
            }
          },
          {
            "must_not": [
              "made-up-wiki-1",
              "made-up-shop-2"
            ]
          },
          {
            "press": "Import"
          },
          {
            "must_not": [
              "Import 2 logins?"
            ]
          },
          {
            "press": "All items"
          },
          {
            "must": {
              "see": [
                "Harbour wiki",
                "Lantern shop",
                "Branch mail"
              ],
              "within": 20
            }
          },
          {
            "must_not": [
              "made-up-wiki-1",
              "made-up-shop-2"
            ]
          },
          {
            "press": "Harbour wiki"
          },
          {
            "must": [
              "••••••••••••"
            ]
          },
          {
            "must_not": [
              "made-up-wiki-1"
            ]
          }
        ]
      },
      "dark": true
    }
  ]
}
