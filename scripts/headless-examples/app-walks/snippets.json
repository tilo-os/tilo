{
  "app": "snippets",
  "said": "Snippets",
  "family": "apps",
  "live": "tl",
  "tl": {
    "id": "so.tilo.snippets",
    "package": "snippets"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Snippets first, on a workspace that keeps none yet",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "actions"
        },
        {
          "targets": true
        }
      ],
      "dark": true,
      "budget_ms": 30000
    },
    {
      "id": "empty",
      "said": "Meet the one empty state, and the way to keep the first snippet",
      "ops": [
        {
          "wait_for": {
            "shown": {
              "prefix": "No snippets yet"
            }
          }
        },
        {
          "wait_for": {
            "shown": "New snippet"
          }
        }
      ]
    },
    {
      "id": "keep",
      "said": "Keep a snippet, filed under a folder, as an agent or the form does",
      "ops": {
        "tl": [
          {
            "use": {
              "kind": "tl.so.tilo.snippets.Library",
              "action": "new_snippet",
              "args": {
                "title": "Restart deployment",
                "folder": "Ops"
              }
            }
          },
          {
            "wait_for": {
              "shown": "Restart deployment"
            }
          }
        ]
      }
    },
    {
      "id": "places",
      "said": "The folder it was filed under stands in the sidebar with what it holds",
      "ops": [
        {
          "wait_for": {
            "shown": "Folders"
          }
        },
        {
          "wait_for": {
            "shown": "Ops"
          }
        }
      ]
    },
    {
      "id": "open_one",
      "said": "The place's first snippet opens beside the list, with copying it",
      "ops": {
        "tl": [
          {
            "wait_for": {
              "shown": "Copy"
            }
          },
          {
            "wait_for": {
              "shown": "Duplicate"
            }
          },
          {
            "must": {
              "see": [
                "Star it",
                "Restart deployment"
              ],
              "within": 10
            }
          }
        ]
      }
    },
    {
      "id": "tagged",
      "said": "Give it tags in the tag editor, and the tags stand in the sidebar",
      "ops": {
        "tl": [
          {
            "press": "Edit tags\u2026"
          },
          {
            "wait_for": "Tags"
          },
          {
            "type": "k8s, deploy"
          },
          {
            "key": "Enter"
          },
          {
            "must": {
              "see": [
                "k8s"
              ],
              "within": 10
            }
          }
        ]
      }
    },
    {
      "id": "place",
      "said": "A tag takes the list to the snippets that carry it, and its page is one of them",
      "ops": {
        "tl": [
          {
            "select_row": "k8s"
          },
          {
            "must": {
              "see": [
                "Restart deployment"
              ],
              "within": 10
            }
          },
          {
            "select_row": "All snippets"
          },
          {
            "must": {
              "see": [
                "Restart deployment"
              ],
              "within": 10
            }
          }
        ]
      }
    },
    {
      "id": "duplicate",
      "said": "Duplicate the open snippet: the copy is named as a copy and stands in the list",
      "ops": {
        "tl": [
          {
            "press": "Duplicate"
          },
          {
            "must": {
              "see": [
                "Restart deployment (copy)"
              ],
              "within": 10
            }
          }
        ]
      },
      "dark": true
    },
    {
      "id": "keep-by-key",
      "said": "Ctrl+N asks for a snippet's title, and Escape puts the question away",
      "ops": {
        "tl": [
          {
            "chord": [
              "Control",
              "n"
            ]
          },
          {
            "wait_for": {
              "shown": {
                "prefix": "Title"
              }
            }
          },
          {
            "must": {
              "see": [
                "New snippet\u2026"
              ],
              "within": 10
            }
          },
          {
            "key": "Escape"
          },
          {
            "must_not": [
              "New snippet\u2026",
              "Title"
            ]
          }
        ]
      }
    }
  ]
}
