{
  "app": "code-editor",
  "said": "Code Editor",
  "tl": {
    "id": "so.tilo.code-editor",
    "package": "code-editor"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Code Editor on an empty project",
      "ops": [
        { "theme": false },
        { "launch": true },
        { "wait_for": "actions" },
        { "wait_for": "New file" },
        { "targets": true }
      ]
    },
    {
      "id": "new-file",
      "said": "Make a file, put the keyboard in its code and write in it",
      "ops": [
        { "press": { "tl": "New file" } },
        { "wait_for": "Write the file" },
        { "click": "Write the file" },
        { "type": "fn main() {\n    let x = 1;\n}\n" },
        { "wait_for": "Unsaved" }
      ]
    },
    {
      "id": "check",
      "said": "Check the file and read its problems",
      "ops": [
        { "press": { "tl": "Check the file" } },
        { "wait_for": "Problems" }
      ]
    },
    {
      "id": "run-a-command",
      "said": "Run a command in the project and read what it answered",
      "ops": [
        { "press": { "tl": "Panel" } },
        { "press": { "tl": "Terminal" } },
        { "press": { "tl": "Run" } },
        { "wait_for": "Stop" }
      ]
    },
    {
      "id": "search-the-project",
      "said": "Search the project from the window's own search and read the places it found",
      "ops": [
        { "press": { "tl": "Panel" } },
        { "press": { "tl": "Search results" } },
        { "chord": ["Control", "f"] },
        { "wait_for": "Search" },
        { "click": "Search" },
        { "type": "main" }
      ]
    },
    {
      "id": "dark",
      "said": "The same project in the dark theme",
      "ops": [
        { "theme": true },
        { "wait_for": "Problems" }
      ]
    }
  ]
}
