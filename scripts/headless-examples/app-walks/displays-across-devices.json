{
  "app": "displays-across-devices",
  "said": "The laptop's and the phone's screens as one layout",
  "devices": [
    {
      "name": "laptop",
      "session_args": [
        "--output",
        "A=1920x1080",
        "--output",
        "B=1280x720"
      ]
    },
    "phone"
  ],
  "packages": [
    "settings"
  ],
  "live": "tl",
  "tl": {
    "id": "so.tilo.settings",
    "package": "settings"
  },
  "steps": [
    {
      "id": "settings-on-laptop",
      "said": "Open Settings on the laptop, on its screens",
      "ops": [
        {
          "launch": true
        },
        {
          "wait_for": "window"
        },
        {
          "press": "Displays"
        },
        {
          "wait_for": "Arrangement"
        },
        {
          "must": [
            "Arrangement",
            "Number the screens"
          ]
        }
      ],
      "budget_ms": 30000
    },
    {
      "id": "both-devices-listed",
      "said": "The laptop reads the phone's screen from the record of the person's devices",
      "ops": [
        {
          "use": {
            "resource": "session:devices",
            "action": "read",
            "expect": {
              "devices#len": 2
            },
            "keep": {
              "laptop": "devices.0.id",
              "laptop_output": "devices.0.displays.0.output"
            }
          }
        }
      ],
      "budget_ms": 30000
    },
    {
      "id": "place-laptop",
      "said": "Place the laptop's own screens at the origin, through their device's action",
      "ops": [
        {
          "use": {
            "resource": "settings/display-person",
            "action": "place-display",
            "args": {
              "device": "{laptop}",
              "output": "{laptop_output}",
              "x": 0,
              "y": 0
            }
          }
        }
      ],
      "budget_ms": 30000
    },
    {
      "id": "phone-places-itself",
      "said": "The phone opens its Settings and places its own screen right of the laptop's",
      "on": "phone",
      "ops": [
        {
          "open": "settings"
        },
        {
          "use": {
            "resource": "session:devices",
            "action": "read",
            "keep": {
              "phone": "devices.0.id",
              "phone_output": "devices.0.displays.0.output"
            }
          }
        },
        {
          "use": {
            "resource": "settings/display-person",
            "action": "place-display",
            "args": {
              "device": "{phone}",
              "output": "{phone_output}",
              "x": 4480,
              "y": 0
            }
          }
        }
      ],
      "budget_ms": 120000
    },
    {
      "id": "pointer-crosses",
      "said": "The pointer pushed past the laptop's edge goes on on the phone",
      "ops": [
        {
          "push_edge": {
            "within": 20
          }
        },
        {
          "on": "phone",
          "state": {
            "shared_input.pointer_shown": true
          }
        },
        {
          "state": {
            "shared_input.pointer_shown": false
          }
        }
      ],
      "budget_ms": 60000
    },
    {
      "id": "both-read-the-placement",
      "said": "Both devices read the one setting: two screens placed, each by its own device",
      "ops": [
        {
          "use": {
            "resource": "settings/display-person",
            "action": "read",
            "expect": {
              "placement#len": 2
            }
          }
        },
        {
          "on": "phone",
          "use": {
            "resource": "settings/display-person",
            "action": "read",
            "expect": {
              "placement#len": 2
            }
          }
        }
      ],
      "budget_ms": 60000
    }
  ]
}
