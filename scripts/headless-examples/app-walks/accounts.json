{
  "app": "accounts",
  "said": "Accounts",
  "family": "settings",
  "live": "tl",
  "packages": [
    "mail"
  ],
  "steps": [
    {
      "id": "stand-in",
      "said": "Stage the tree's stand-in mail server as the address's provider and sign in again",
      "ops": [
        {
          "local_mail_server": {
            "password": "walks-stand-in"
          }
        },
        {
          "restart": "session"
        },
        {
          "launch": true
        },
        {
          "wait_for": "window"
        }
      ],
      "budget_ms": 180000
    },
    {
      "id": "mail-open",
      "said": "Open Mail with no account, and let it use the internet",
      "ops": [
        {
          "theme": false
        },
        {
          "do_app": {
            "app": "so.tilo.mail",
            "operation": "open"
          }
        },
        {
          "press_when_any": {
            "selectors": [
              "Allow"
            ],
            "within": 30
          }
        },
        {
          "wait_window": {
            "app": "so.tilo.mail",
            "within": 120
          }
        }
      ],
      "budget_ms": 150000
    },
    {
      "id": "accounts-open",
      "said": "Open Settings' Accounts page and the form that connects one",
      "ops": [
        {
          "wait_for": "actions"
        },
        {
          "do_app": {
            "app": "so.tilo.settings",
            "operation": "open_pane",
            "args": {
              "pane": "external_accounts"
            }
          }
        },
        {
          "must": [
            "Connected accounts",
            "Connect an account",
            "Connect"
          ]
        }
      ],
      "dark": true,
      "budget_ms": 60000
    },
    {
      "id": "add-account",
      "said": "Connect the mail account with its address and password",
      "ops": [
        {
          "click": "The address, such as you@example.com"
        },
        {
          "type": "lab@story.tilo.test"
        },
        {
          "click": "Its password or app password"
        },
        {
          "type": "walks-stand-in"
        },
        {
          "press": "Connect"
        },
        {
          "must": {
            "see": [
              "lab@story.tilo.test"
            ],
            "within": 60
          }
        }
      ],
      "budget_ms": 90000
    },
    {
      "id": "in-mail",
      "said": "Mail lists the account's inbox",
      "ops": [
        {
          "press_when_any": {
            "selectors": [
              "Allow"
            ],
            "within": 10
          }
        },
        {
          "wait_window": {
            "app": "so.tilo.mail",
            "within": 60
          }
        },
        {
          "must": {
            "see": [
              "Welcome to the lab"
            ],
            "within": 60
          }
        }
      ],
      "budget_ms": 150000
    }
  ],
  "tl": {
    "id": "so.tilo.settings",
    "package": "settings"
  }
}
