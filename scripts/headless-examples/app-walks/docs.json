{
  "app": "docs",
  "said": "Docs",
  "family": "apps",
  "steps": [
    {
      "id": "open",
      "said": "Open Docs on a blank document",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "window"
        },
        {
          "wait_for": "actions"
        },
        {
          "must": [
            "Bold",
            "Italic",
            "Untitled Document"
          ]
        },
        {
          "click_any": [
            {
              "doing": "76ypz5mr"
            },
            "Untitled Document"
          ]
        },
        {
          "focused": "word-processor"
        },
        {
          "targets": true
        }
      ],
      "dark": true,
      "budget_ms": 30000
    },
    {
      "id": "heading",
      "said": "Type a title and make it a heading",
      "ops": [
        {
          "key": "Enter"
        },
        {
          "type": "Q3 Planning"
        },
        {
          "chord": [
            "Alt",
            "Control",
            "1"
          ]
        },
        {
          "read": {
            "app": "so.tilo.word-processor",
            "operation": "read_content",
            "contains": "# Q3 Planning",
            "within": 10
          }
        }
      ]
    },
    {
      "id": "paragraph",
      "said": "Start a paragraph under it and type it",
      "ops": [
        {
          "key": "Enter"
        },
        {
          "type": "Book the venue"
        },
        {
          "read": {
            "app": "so.tilo.word-processor",
            "operation": "read_content",
            "contains": "Book the venue",
            "within": 10
          }
        }
      ],
      "dark": true
    },
    {
      "id": "bold",
      "said": "Select the paragraph and make it bold",
      "ops": [
        {
          "chord": [
            "Shift",
            "Home"
          ]
        },
        {
          "press": "Bold"
        },
        {
          "read": {
            "app": "so.tilo.word-processor",
            "operation": "read_content",
            "contains": "**Book the venue**"
          }
        }
      ]
    },
    {
      "id": "restart-app",
      "said": "Quit Docs and open it again: the person's document is still there",
      "ops": [
        {
          "restart": "app"
        },
        {
          "wait_for": "actions"
        },
        {
          "read": {
            "app": "so.tilo.word-processor",
            "operation": "read_content"
          }
        },
        {
          "read": {
            "app": "so.tilo.word-processor",
            "operation": "read_content",
            "contains": "# Q3 Planning",
            "within": 10
          }
        }
      ]
    }
  ],
  "tl": {
    "id": "so.tilo.word-processor",
    "package": "word-processor"
  }
}
