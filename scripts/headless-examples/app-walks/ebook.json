{
  "app": "ebook",
  "said": "Books",
  "family": "apps",
  "live": "tl",
  "tl": {
    "id": "so.tilo.ebook",
    "package": "ebook"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Books on an empty shelf, letting it use the internet when it asks",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": {
            "answer": "Allow"
          }
        },
        {
          "wait_for": "actions"
        },
        {
          "targets": true
        }
      ]
    },
    {
      "id": "found-online",
      "said": "Look for a book online",
      "ops": [
        {
          "press_any": [
            "Found online"
          ]
        },
        {
          "wait_for": "Search"
        }
      ]
    },
    {
      "id": "shelf",
      "said": "Back to the shelf",
      "ops": [
        {
          "press_any": [
            "Shelf"
          ]
        }
      ]
    },
    {
      "id": "settings",
      "said": "Open the reading settings",
      "ops": [
        {
          "press_any": [
            "Settings"
          ]
        }
      ]
    },
    {
      "id": "face",
      "said": "Pick another reading face",
      "ops": [
        {
          "click_any": [
            {
              "prefix": "The reader's serif"
            },
            "Face"
          ]
        },
        {
          "press_any": [
            "Literata"
          ]
        }
      ]
    },
    {
      "id": "settings-shelf",
      "said": "Back to the shelf",
      "ops": [
        {
          "press_any": [
            "Shelf"
          ]
        }
      ]
    },
    {
      "id": "open-a-book",
      "said": "Open an EPUB file and meet its first page",
      "ops": [
        {
          "epub": {
            "name": "The Tide Glass.epub",
            "title": "The Tide Glass",
            "author": "Ada Ferrer",
            "chapters": [
              {
                "title": "The Tide",
                "body": "The tide came in over the glass, and the glass held its light."
              },
              {
                "title": "The Glass",
                "body": "The glass stood in the window and gathered the morning."
              }
            ]
          }
        },
        {
          "press_any": [
            "Add a book"
          ]
        },
        {
          "choose": {
            "name": "The Tide Glass.epub"
          }
        },
        {
          "wait_for": "Next"
        },
        {
          "wait_for": "actions"
        }
      ]
    },
    {
      "id": "read-on",
      "said": "Read on a page",
      "ops": [
        {
          "press_any": [
            "Next"
          ]
        }
      ]
    },
    {
      "id": "contents",
      "said": "Turn to the second chapter from the contents",
      "ops": [
        {
          "press_any": [
            "The Tide"
          ]
        }
      ]
    },
    {
      "id": "highlight",
      "said": "Mark a passage crossing several lines",
      "ops": [
        {
          "drag": {
            "reading": [
              1,
              3
            ]
          }
        },
        {
          "wait_for": "Highlight"
        },
        {
          "press_any": [
            "Highlight"
          ]
        }
      ]
    },
    {
      "id": "note",
      "said": "Write a note on a passage",
      "ops": [
        {
          "drag": {
            "reading": 1
          }
        },
        {
          "wait_for": "Note"
        },
        {
          "press_any": [
            "Note"
          ]
        },
        {
          "click_any": [
            {
              "prefix": "Write a note on the passage"
            }
          ]
        },
        {
          "type": "Keep this"
        },
        {
          "press_any": [
            "Save note"
          ]
        }
      ]
    },
    {
      "id": "comment",
      "said": "Comment on the highlight",
      "ops": [
        {
          "press_any": [
            "Comment"
          ]
        },
        {
          "click_any": [
            {
              "prefix": "Comment on the highlight"
            }
          ]
        },
        {
          "type": "A thought"
        },
        {
          "press_any": [
            "Send comment"
          ]
        }
      ]
    },
    {
      "id": "bookmark",
      "said": "Bookmark the page",
      "ops": [
        {
          "press_any": [
            "Bookmark this page"
          ]
        }
      ]
    },
    {
      "id": "text-larger",
      "said": "Make the text larger",
      "ops": [
        {
          "press_any": [
            "Larger text"
          ]
        }
      ]
    },
    {
      "id": "palette",
      "said": "Change the page palette from the bar",
      "ops": [
        {
          "press_any": [
            "Change the page palette"
          ]
        }
      ]
    },
    {
      "id": "two-pages",
      "said": "Read two pages beside each other",
      "ops": [
        {
          "press_any": [
            "Two pages"
          ]
        }
      ]
    },
    {
      "id": "scrolled",
      "said": "Read the chapter scrolled as one column",
      "ops": [
        {
          "press_any": [
            "Scrolled"
          ]
        },
        {
          "key": "ArrowDown"
        }
      ]
    },
    {
      "id": "pages",
      "said": "Read a page at a time again",
      "ops": [
        {
          "press_any": [
            "Pages"
          ]
        }
      ]
    },
    {
      "id": "keep-place",
      "said": "Close the book and open it again where they left it",
      "ops": [
        {
          "close": true
        },
        {
          "launch": true
        },
        {
          "wait_for": "actions"
        },
        {
          "press_any": [
            "The Tide Glass"
          ]
        }
      ]
    },
    {
      "id": "dark",
      "said": "The same page in the dark theme",
      "ops": [
        {
          "theme": true
        }
      ]
    }
  ]
}
