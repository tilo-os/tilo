{
  "app": "mail",
  "said": "Mail",
  "family": "apps",
  "live": "tl",
  "tl": {
    "id": "so.tilo.mail",
    "package": "mail"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Mail for the first time, letting it reach the network when it asks",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": {
            "answer": "Allow"
          }
        },
        {
          "wait_for": "window"
        },
        {
          "wait_for": "actions"
        },
        {
          "must": {
            "see": [
              "New message"
            ],
            "within": 15
          }
        },
        {
          "targets": true
        }
      ],
      "dark": true,
      "budget_ms": 60000
    },
    {
      "id": "agent-drafts",
      "said": "An agent drafts a message as a typed action, for the person to read and send",
      "ops": [
        {
          "act": {
            "do": [
              "tl.so.tilo.mail.Mail",
              "draft_message",
              {
                "to": "grace@hopper.example",
                "subject": "A message an agent drafted",
                "body": "The person reads this and sends it."
              }
            ]
          }
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "compose",
      "said": "Write a message with no account yet",
      "ops": [
        {
          "must": {
            "see": [
              "New message"
            ],
            "within": 15
          }
        },
        {
          "press_any": [
            "New message"
          ]
        },
        {
          "must": {
            "see": [
              {
                "prefix": "Subject"
              }
            ],
            "within": 15
          }
        },
        {
          "click_any": [
            {
              "prefix": "Subject"
            }
          ]
        },
        {
          "type": "First message"
        }
      ]
    },
    {
      "id": "drafts",
      "said": "The message waits in Drafts",
      "ops": [
        {
          "must": {
            "see": [
              "Drafts"
            ],
            "within": 15
          }
        },
        {
          "select_row": "Drafts"
        },
        {
          "must": {
            "see": [
              "First message"
            ],
            "within": 15
          }
        }
      ],
      "dark": true
    },
    {
      "id": "discard",
      "said": "Discard the message being written: its window closes and the draft leaves Drafts",
      "ops": [
        {
          "press_any": [
            "Discard"
          ]
        },
        {
          "must": {
            "see": [
              "A message an agent drafted"
            ],
            "within": 15
          }
        },
        {
          "must_not": [
            {
              "prefix": "Subject"
            }
          ]
        },
        {
          "must_not": [
            {
              "prefix": "First message"
            }
          ]
        }
      ],
      "dark": true
    }
  ]
}
