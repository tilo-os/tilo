{
  "app": "store",
  "said": "App Store",
  "live": "tl",
  "tl": {
    "id": "so.tilo.store",
    "package": "store"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open the App Store on a computer with nothing read yet, letting it use the internet when it asks",
      "ops": [
        {
          "theme": false
        },
        {"launch": {"answer": "Allow"}},
        {
          "wait_for": "actions"
        },
        {
          "targets": true
        }
      ]
    },
    {
      "id": "repositories",
      "said": "Open the Flatpak repositories",
      "ops": [
        {
          "press_any": [
            "Flatpak repositories"
          ]
        },
        {
          "wait_for": "Configured repositories"
        }
      ]
    },
    {
      "id": "back",
      "said": "Go back to the apps",
      "ops": [
        {
          "press_any": [
            "Back to apps"
          ]
        },
        {
          "wait_for": "All apps"
        }
      ]
    },
    {
      "id": "trust",
      "said": "Read how reports and signatures work",
      "ops": [
        {
          "press_any": [
            "Trust and moderation"
          ]
        },
        {
          "wait_for": "How reports work"
        }
      ]
    },
    {
      "id": "install-package",
      "said": "Review a signed package and install it in the workspace",
      "dark": true,
      "ops": [
        {
          "package": {
            "name": "calculator"
          }
        },
        {
          "press_any": [
            "Review package"
          ]
        },
        {
          "choose": {
            "name": "calculator.tapp"
          }
        },
        {
          "wait_for": "Install reviewed package"
        },
        {
          "press_any": [
            "Install reviewed package"
          ]
        },
        {
          "wait_for": "Package installed. Open it from its app details."
        }
      ]
    }
  ]
}
