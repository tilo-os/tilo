{
  "app": "totp",
  "said": "Authenticator",
  "live": "tl",
  "tl": {
    "id": "so.tilo.totp",
    "package": "totp"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Authenticator with no accounts: it asks for the first",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "actions"
        },
        {
          "wait_for": "No accounts yet"
        },
        {
          "targets": true
        }
      ]
    },
    {
      "id": "link",
      "said": "Paste a setup link, fill the form, save, and reveal the account's code",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Add account"
            ]
          },
          {
            "wait_for": "Setup link"
          },
          {
            "click_any": [
              {
                "prefix": "Setup link"
              }
            ]
          },
          {
            "type": "otpauth://totp/Acme:bob?secret=JBSWY3DPEHPK3PXP&issuer=Acme"
          },
          {
            "press_any": [
              "Fill from the link"
            ]
          },
          {
            "press_any": [
              "Save"
            ]
          },
          {
            "wait_for": "Acme"
          },
          {
            "must": {
              "see": [
                "Codes are hidden until you ask to see one; they stay readable for ten seconds.",
                {
                  "prefix": "Reveal code for"
                },
                "Edit",
                "More"
              ]
            }
          },
          {
            "press": {
              "prefix": "Reveal code for"
            }
          },
          {
            "must": {
              "see": [
                {
                  "prefix": "Copy code for"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "revealed-copies",
      "said": "A card already showing its code copies that code when it is pressed, and says so",
      "ops": {
        "tl": [
          {
            "must": {
              "see": [
                {
                  "prefix": "Reveal code for"
                }
              ],
              "within": 20
            }
          },
          {
            "press": {
              "prefix": "Reveal code for"
            }
          },
          {
            "press": "Acme"
          },
          {
            "must": {
              "see": [
                "Copied Acme code"
              ],
              "within": 10
            }
          }
        ]
      }
    },
    {
      "id": "unkeyed",
      "said": "An account whose key is not on this device says so and offers to take one",
      "ops": {
        "tl": [
          {
            "use": {
              "kind": "Vault",
              "action": "accounts",
              "keep": {
                "item": "0.item"
              }
            }
          },
          {
            "use": {
              "kind": "vault.item",
              "action": "forget",
              "args": {
                "item": "{item}"
              }
            }
          },
          {
            "must": {
              "see": [
                "Acme",
                "Not set up on this device",
                "Set up"
              ],
              "within": 20
            }
          },
          {
            "press": "Set up"
          },
          {
            "wait_for": "Set up on this device"
          },
          {
            "must": {
              "see": [
                "Key from the service"
              ],
              "within": 10
            }
          },
          {
            "press_any": [
              "Back"
            ]
          }
        ]
      }
    },
    {
      "id": "second",
      "said": "A second account, so the search has to land on the one it names",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Add account"
            ]
          },
          {
            "wait_for": "Setup link"
          },
          {
            "click_any": [
              {
                "prefix": "Setup link"
              }
            ]
          },
          {
            "type": "otpauth://totp/GitHub:ada@example.com?secret=JBSWY3DPEHPK3PXP&issuer=GitHub"
          },
          {
            "press_any": [
              "Fill from the link"
            ]
          },
          {
            "press_any": [
              "Save"
            ]
          },
          {
            "wait_for": "GitHub"
          }
        ]
      }
    },
    {
      "id": "invalid",
      "said": "Saving with no service name keeps the form and says why",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Add account"
            ]
          },
          {
            "press_any": [
              "Save"
            ]
          },
          {
            "wait_for": "The account needs a service name"
          },
          {
            "offered": [
              "Save",
              "Back"
            ]
          }
        ]
      }
    },
    {
      "id": "details",
      "said": "The form takes the details and the advanced options",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Back"
            ]
          },
          {
            "press_any": [
              "Add account"
            ]
          },
          {
            "offered": [
              "Advanced options",
              "Scan a QR image"
            ]
          },
          {
            "press_any": [
              "Advanced options"
            ]
          },
          {
            "offered": [
              "SHA1",
              "SHA256",
              "SHA512"
            ]
          }
        ]
      }
    },
    {
      "id": "dark",
      "said": "The same window in the dark theme",
      "ops": [
        {
          "theme": true
        }
      ],
      "dark": true
    },
    {
      "id": "search",
      "said": "The system's search finds the second account, and the hit opens that account's page",
      "ops": [
        {
          "search": {
            "tl": "GitHub"
          }
        },
        {
          "choose_result": "GitHub"
        },
        {
          "wait_for": "ada@example.com"
        },
        {
          "must_not": [
            "Add account",
            "Acme"
          ]
        }
      ]
    }
  ]
}
