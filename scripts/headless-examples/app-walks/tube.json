        {
          "wait_for": "window"
        },
        {
          "wait_for": "actions"
        },
        {
          "wait_for": "Search YouTube"
        },
        {
          "targets": true
        }
      ]
    },
    {
      "id": "find",
      "said": "Find a video: search YouTube from inside the app",
      "ops": [
        {
          "select_row": "Search YouTube"
        },
        {
          "wait_for": {
            "shown": {
              "menuitem": "Search YouTube"
            }
          }
        },
        {
          "click": {
            "menuitem": "Search YouTube"
          }
        },
        {
          "type": "lofi hip hop"
        },
        {
          "key": "Enter"
        },
        {
          "wait_for": {
            "shown": {
              "prefix": "lofi"
            }
          }
        }
      ]
