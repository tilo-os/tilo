{
  "app": "tasks",
  "said": "Tasks",
  "family": "apps",
  "live": "tl",
  "tl": {
    "id": "so.tilo.tasks",
    "package": "tasks"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Tasks on an empty list",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "window"
        },
        {
          "wait_for": "actions"
        },
        {
          "must": [
            "No tasks yet"
          ]
        },
        {
          "targets": true
        }
      ],
      "dark": true,
      "budget_ms": 30000
    },
    {
      "id": "add",
      "said": "Write down three things to do",
      "ops": [
        {
          "click_any": [
            "New task for today"
          ]
        },
        {
          "type": "Buy milk"
        },
        {
          "key": "Enter"
        },
        {
          "chord": [
            "Control",
            "a"
          ]
        },
        {
          "type": "Call the landlord"
        },
        {
          "key": "Enter"
        },
        {
          "chord": [
            "Control",
            "a"
          ]
        },
        {
          "type": "Ship the release"
        },
        {
          "key": "Enter"
        },
        {
          "must": [
            "Buy milk",
            "Call the landlord",
            "Ship the release"
          ]
        },
        {
          "holds": [
            "Buy milk",
            "Call the landlord",
            "Ship the release"
          ]
        }
      ]
    },
    {
      "id": "places",
      "said": "See the same work on the board, and the tasks that said something in their own view",
      "ops": [
        {
          "press_any": [
            "Board"
          ]
        },
        {
          "must_not": [
            "New task for today"
          ]
        },
        {
          "press_any": [
            "Threads"
          ]
        },
        {
          "must": [
            "Nothing said yet"
          ]
        },
        {
          "must_not": [
            "New task for today"
          ]
        },
        {
          "press_any": [
            "Home"
          ]
        },
        {
          "must": [
            "New task for today"
          ]
        },
        {
          "must_not": [
            "Nothing said yet"
          ]
        }
      ],
      "dark": true
    },
    {
      "id": "complete",
      "said": "Complete the milk, and find it where finished work goes",
      "ops": [
        {
          "press": "Mark Buy milk done"
        },
        {
          "holds": [
            "\"status\": \"done\""
          ]
        },
        {
          "select_row": "Inbox"
        },
        {
          "must_not": [
            "Buy milk"
          ]
        },
        {
          "select_row": "Today"
        },
        {
          "must_not": [
            "Buy milk"
          ]
        },
        {
          "select_row": "Done"
        },
        {
          "must": [
            "Buy milk"
          ]
        }
      ]
    },
    {
      "id": "due",
      "said": "Give the landlord call a day: tomorrow",
      "ops": [
        {
          "right_click": "Call the landlord"
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "Open as page"
              }
            ],
            "within": 15
          }
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "Plan"
              }
            ],
            "within": 10
          }
        },
        {
          "press": {
            "menuitem": "Plan"
          }
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "Tomorrow"
              }
            ],
            "within": 10
          }
        },
        {
          "press": {
            "menuitem": "Tomorrow"
          }
        }
      ]
    },
    {
      "id": "due-shows",
      "said": "It leaves what is left to do today and stands with what is coming up",
      "ops": [
        {
          "must_not": [
            "Call the landlord"
          ]
        },
        {
          "select_row": "Upcoming"
        },
        {
          "must": [
            "Call the landlord"
          ]
        }
      ]
    },
    {
      "id": "priority",
      "said": "Make the landlord call high priority",
      "ops": [
        {
          "right_click": "Call the landlord"
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "Priority"
              }
            ],
            "within": 15
          }
        },
        {
          "press": {
            "menuitem": "Priority"
          }
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "High"
              }
            ],
            "within": 10
          }
        },
        {
          "press": {
            "menuitem": "High"
          }
        }
      ],
      "dark": true
    },
    {
      "id": "priority-shows",
      "said": "The window marks it as high priority",
      "ops": [
        {
          "must": [
            "Call the landlord"
          ]
        }
      ]
    },
    {
      "id": "subtask",
      "said": "Break the landlord call into a subtask",
      "ops": [
        {
          "press": "Call the landlord"
        },
        {
          "must": {
            "see": [
              "Add a subtask"
            ],
            "within": 20
          }
        },
        {
          "click_any": [
            {
              "prefix": "Add a subtask"
            }
          ]
        },
        {
          "type": "Find the number"
        },
        {
          "key": "Enter"
        },
        {
          "must": [
            "Find the number"
          ]
        },
        {
          "holds": [
            "Find the number"
          ]
        }
      ]
    },
    {
      "id": "subtask-stands-under",
      "said": "The subtask waits in the inbox, under the task it was made in",
      "ops": [
        {
          "key": "Escape"
        },
        {
          "select_row": "Inbox"
        },
        {
          "must": [
            {
              "prefix": "Find the number, in Call the landlord"
            }
          ]
        }
      ]
    },
    {
      "id": "move",
      "said": "Move the subtask out from under the task it was in, to stand on its own",
      "ops": [
        {
          "right_click": {
            "prefix": "Find the number"
          }
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "Move"
              }
            ],
            "within": 15
          }
        },
        {
          "press": {
            "menuitem": "Move"
          }
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "Outdent"
              }
            ],
            "within": 10
          }
        },
        {
          "press": {
            "menuitem": "Outdent"
          }
        },
        {
          "must": [
            {
              "prefix": "Find the number"
            }
          ]
        },
        {
          "must_not": [
            "Call the landlord"
          ]
        },
        {
          "select_row": "Today"
        },
        {
          "holds": [
            "Find the number"
          ]
        }
      ]
    },
    {
      "id": "delete",
      "said": "Delete one task",
      "ops": [
        {
          "select_row": "Today"
        },
        {
          "right_click": {
            "prefix": "Ship the release"
          }
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "More"
              }
            ],
            "within": 15
          }
        },
        {
          "press": {
            "menuitem": "More"
          }
        },
        {
          "must": {
            "see": [
              {
                "menuitem": "Delete"
              }
            ],
            "within": 10
          }
        },
        {
          "press": {
            "menuitem": "Delete"
          }
        },
        {
          "must_not": [
            {
              "prefix": "Ship the release"
            }
          ]
        }
      ]
    },
    {
      "id": "search",
      "said": "Find a task through the system's search",
      "ops": [
        {
          "search": "Find the number"
        },
        {
          "result": "Find the number"
        }
      ],
      "dark": true
    },
    {
      "id": "dark",
      "said": "The tasks in the dark theme",
      "ops": [
        {
          "key": "Escape"
        },
        {
          "theme": true
        }
      ]
    }
  ]
}
