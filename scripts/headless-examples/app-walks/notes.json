{
  "app": "notes",
  "said": "Notes",
  "tl": {
    "id": "so.tilo.notes",
    "package": "notes"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Notes on an empty notebook",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "actions"
        },
        {
          "wait_for": "New note"
        },
        {
          "targets": true
        }
      ]
    },
    {
      "id": "new-note-at-launch",
      "said": "Close Notes, open it again and press New note the moment it is on screen",
      "ops": [
        {
          "early_press": {
            "controls": [
              {
                "tl": "New note"
              },
              {
                "tl": "tl:so.tilo.notes:root-v7cub7aw\u001fnew_note"
              }
            ],
            "deadline": 60
          }
        },
        {
          "wait_for": "actions"
        }
      ]
    },
    {
      "id": "write",
      "said": "Give the note a title, then a body with a heading, a bullet list and a checklist",
      "ops": {
        "tl": [
          {
            "press_any": [
              "New note"
            ]
          },
          {
            "click_any": [
              {
                "doing": "dpj7scfe"
              },
              {
                "prefix": "Title"
              }
            ]
          },
          {
            "type": "Trip to Lisbon"
          },
          {
            "key": "Enter"
          },
          {
            "type": "## Packing"
          },
          {
            "key": "Enter"
          },
          {
            "type": "- passport"
          },
          {
            "key": "Enter"
          },
          {
            "type": "[ ] charger"
          },
          {
            "key": "Enter"
          },
          {
            "type": "adapters"
          }
        ]
      }
    },
    {
      "id": "agent-edits-a-paragraph",
      "said": "An agent rewrites the note's heading through the action that edits one paragraph, and the outline shows it",
      "ops": {
        "tl": [
          {
            "act": [
              "tl.so.tilo.notes.Note",
              "edit-block",
              {
                "block": "body.0",
                "text": "## Packing list"
              }
            ]
          },
          {
            "wait_for": "Packing list"
          }
        ]
      }
    },
    {
      "id": "sub-note",
      "said": "Make a sub-note under it",
      "ops": {
        "tl": [
          {
            "press_any": [
              "File"
            ]
          },
          {
            "wait_for": {
              "shown": {
                "menuitem": "New sub-note"
              }
            }
          },
          {
            "press_any": [
              {
                "menuitem": "New sub-note"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sub-note-under-its-parent",
      "said": "The new note stands under the one it was made in, and its page is the one shown",
      "ops": [
        {
          "tree": {
            "under": [
              "Untitled",
              "Trip to Lisbon"
            ]
          }
        },
        {
          "wait_for": {
            "title": "Untitled"
          }
        }
      ]
    },
    {
      "id": "tag",
      "said": "Tag the note",
      "ops": {
        "tl": [
          {
            "select_row": "Trip to Lisbon"
          },
          {
            "wait_for": {
              "title": "Trip to Lisbon"
            }
          },
          {
            "row_menu": "Trip to Lisbon"
          },
          {
            "wait_for": "Tag…"
          },
          {
            "press_any": [
              "Tag…"
            ]
          },
          {
            "form": {
              "field": "Tag",
              "text": "travel"
            }
          },
          {
            "key": "Enter"
          },
          {
            "wait_for": "travel"
          },
          {
            "questions": true
          }
        ]
      }
    },
    {
      "id": "tag-list",
      "said": "The tag stands beside the tree, counting the note that carries it",
      "ops": [
        {
          "must": {
            "see": [
              "travel"
            ]
          }
        }
      ]
    },
    {
      "id": "find-in-note",
      "said": "Find a word in the open note, as the palette and an agent can",
      "ops": [
        {
          "read": {
            "app": "so.tilo.notes",
            "operation": "find_text",
            "args": {
              "text": "passport"
            },
            "is": {
              "#len": 1
            }
          }
        }
      ]
    },
    {
      "id": "outline",
      "said": "Open the heading outline, if the app has one",
      "ops": [
        {
          "offered": [
            {
              "tl": "Outline"
            },
            {
              "tl": "notes-outline"
            },
            "Packing"
          ]
        }
      ],
      "dark": true
    },
    {
      "id": "import",
      "said": "Import a Markdown file",
      "ops": {
        "tl": [
          {
            "file": {
              "name": "Lisbon.md",
              "text": "# Lisbon in May\n\nA week of trams and tiles.\n\n- tram 28\n- pastel de nata\n"
            }
          },
          {
            "press_any": [
              "File"
            ]
          },
          {
            "wait_for": {
              "shown": {
                "menuitem": "Import Markdown…"
              }
            }
          },
          {
            "press_any": [
              {
                "menuitem": "Import Markdown…"
              }
            ]
          },
          {
            "choose": {
              "name": "Lisbon.md"
            }
          },
          {
            "wait_for": {
              "prefix": "Lisbon in May"
            }
          },
          {
            "questions": true
          },
          {
            "wait_for": {
              "title": "Lisbon in May"
            }
          },
          {
            "tree": {
              "rows": [
                "Trip to Lisbon",
                "Lisbon in May"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "search",
      "said": "Find the note through the system's search",
      "ops": [
        {
          "search": {
            "tl": "Trip to Lisbon"
          }
        }
      ],
      "dark": true
    },
    {
      "id": "search-open",
      "said": "Open the note the search found",
      "ops": [
        {
          "key": "Enter"
        }
      ]
    },
    {
      "id": "dark",
      "said": "The same note in the dark theme",
      "ops": [
        {
          "theme": true
        },
        {
          "key": "Escape"
        }
      ]
    }
  ]
}
