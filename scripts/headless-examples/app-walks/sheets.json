{
  "app": "sheets",
  "said": "Sheets",
  "tl": {
    "id": "so.tilo.sheets",
    "package": "sheets"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Sheets on a new workbook",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "actions"
        },
        {
          "wait_for": "Sheet1"
        },
        {
          "must": [
            "Bold",
            "File",
            "Format",
            "Sheet1"
          ]
        },
        {
          "targets": true
        }
      ],
      "dark": true,
      "budget_ms": 30000
    },
    {
      "id": "values",
      "said": "Write two numbers into the first column and read them back",
      "ops": [
        {
          "act": [
            "tl.so.tilo.sheets.Workbook",
            "write_cells",
            {
              "sheet": "Sheet1",
              "refs": [
                "A1",
                "A2"
              ],
              "inputs": [
                "3",
                "4"
              ]
            }
          ]
        },
        {
          "read": {
            "app": "so.tilo.sheets",
            "operation": "read_cells",
            "args": {
              "sheet": "Sheet1",
              "range": "A1:B2"
            },
            "is": {
              "0": "3",
              "1": "4"
            },
            "within": 10
          }
        }
      ],
      "dark": true
    },
    {
      "id": "formula",
      "said": "Put a formula beside them, and its value is what the sheet shows",
      "ops": [
        {
          "act": [
            "tl.so.tilo.sheets.Workbook",
            "write_cells",
            {
              "sheet": "Sheet1",
              "refs": [
                "B1"
              ],
              "inputs": [
                "=SUM(A1:A2)"
              ]
            }
          ]
        },
        {
          "read": {
            "app": "so.tilo.sheets",
            "operation": "read_cells",
            "args": {
              "sheet": "Sheet1",
              "range": "A1:B2"
            },
            "is": {
              "1": "7"
            },
            "within": 10
          }
        }
      ]
    },
    {
      "id": "formula-kept",
      "said": "The sheet keeps the formula as typed, not only its result",
      "ops": [
        {
          "read": {
            "app": "so.tilo.sheets",
            "operation": "read_cells",
            "args": {
              "sheet": "Sheet1",
              "range": "B1",
              "formulas": true
            },
            "is": {
              "0": "=SUM(A1:A2)"
            }
          }
        }
      ]
    },
    {
      "id": "bold",
      "said": "The first row shows bold after the bar's Bold is pressed",
      "ops": [
        {
          "press_any": [
            "Bold"
          ]
        },
        {
          "must": [
            "Bold"
          ]
        }
      ]
    },
    {
      "id": "sheet",
      "said": "Add a sheet through the app's own action, and its tab stands beside the first",
      "ops": [
        {
          "act": [
            "tl.so.tilo.sheets.Workbook",
            "new_sheet",
            {
              "name": "Budget"
            }
          ]
        },
        {
          "wait_for": "Budget"
        }
      ]
    },
    {
      "id": "comment",
      "said": "Say something about a cell, and the panel shows it",
      "ops": [
        {
          "act": [
            "tl.so.tilo.sheets.Workbook",
            "comment",
            {
              "sheet": "Sheet1",
              "range": "A1",
              "text": "Rent goes up in March"
            }
          ]
        },
        {
          "press_any": [
            "Comments and charts"
          ]
        },
        {
          "wait_for": "Rent goes up in March"
        }
      ]
    },
    {
      "id": "dark",
      "said": "The same sheet in the dark theme",
      "ops": [
        {
          "theme": true
        },
        {
          "must": [
            "Sheet1",
            "Budget"
          ]
        }
      ],
      "dark": true
    }
  ]
}
