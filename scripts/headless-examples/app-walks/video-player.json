            340
          ]
        },
        {
          "wait_for": {
            "shown": "Pause"
          }
        }
      ]
    },
    {
      "id": "pause",
      "said": "Pause it",
      "ops": [
        {
          "point": [
            640,
            340
          ]
        },
        {
