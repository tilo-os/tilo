{
  "app": "chat",
  "said": "Chat",
  "family": "apps",
  "live": "tl",
  "tl": {
    "id": "so.tilo.chat",
    "package": "chat"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Chat: the conversation list is there",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "window"
        },
        {
          "wait_for": "actions"
        },
        {
          "must": [
            "Channels"
          ]
        },
        {
          "targets": true
        }
      ],
      "dark": true,
      "budget_ms": 30000
    },
    {
      "id": "channel",
      "said": "Start a channel for the launch",
      "ops": {
        "tl": [
          {
            "must": {
              "see": [
                "New channel"
              ],
              "within": 10
            }
          },
          {
            "press": "New channel"
          },
          {
            "must": {
              "see": [
                "new-channel"
              ],
              "within": 20
            }
          },
          {
            "holds": [
              "new-channel"
            ]
          }
        ]
      }
    },
    {
      "id": "channel-from-search",
      "said": "Start a channel through the desktop's search, as the window's button does",
      "ops": {
        "tl": [
          {
            "key": "Escape"
          },
          {
            "search": "New channel"
          },
          {
            "result": "New channel"
          },
          {
            "choose_result": "New channel"
          },
          {
            "must": {
              "see": [
                "new-channel"
              ],
              "within": 20
            }
          },
          {
            "holds": [
              "new-channel"
            ]
          }
        ]
      }
    },
    {
      "id": "send",
      "said": "Say hello in the channel",
      "ops": {
        "tl": [
          {
            "press": "new-channel"
          },
          {
            "click_any": [
              {
                "prefix": "Message #"
              }
            ]
          },
          {
            "type": "Hello team"
          },
          {
            "key": "Enter"
          },
          {
            "must": [
              "Hello team"
            ]
          },
          {
            "holds": [
              "Hello team"
            ]
          }
        ]
      }
    },
    {
      "id": "reply",
      "said": "Answer the message",
      "ops": {
        "tl": [
          {
            "hover": {
              "tl": {
                "prefix": "Hello"
              }
            }
          },
          {
            "press_any": [
              "Reply"
            ]
          },
          {
            "click_any": [
              {
                "prefix": "Message #"
              }
            ]
          },
          {
            "type": "Welcome to launch"
          },
          {
            "key": "Enter"
          },
          {
            "must": [
              "Welcome to launch"
            ]
          }
        ]
      }
    },
    {
      "id": "react",
      "said": "React to the message",
      "ops": [
        {
          "hover": {
            "tl": {
              "prefix": "Hello"
            }
          }
        },
        {
          "press_any": [
            "Add reaction"
          ]
        },
        {
          "press_any": [
            {
              "prefix": "\ud83c\udf89"
            },
            {
              "prefix": "Choose party"
            },
            {
              "prefix": "Choose"
            }
          ]
        }
      ],
      "dark": true
    },
    {
      "id": "edit",
      "said": "Fix what the message says",
      "ops": [
        {
          "hover": {
            "tl": {
              "prefix": "Hello"
            }
          }
        },
        {
          "press_any": [
            "Edit",
            "Edit message"
          ]
        },
        {
          "click_any": [
            {
              "prefix": "Edit message"
            }
          ]
        },
        {
          "chord": [
            "Control",
            "a"
          ]
        },
        {
          "type": "Hello team!"
        },
        {
          "press_any": [
            "Save",
            "Save message edit"
          ]
        },
        {
          "must": [
            {
              "tl": "Hello team!"
            }
          ]
        }
      ]
    },
    {
      "id": "pin",
      "said": "Pin the message so it is kept with the conversation",
      "ops": [
        {
          "hover": {
            "tl": {
              "prefix": "Hello"
            }
          }
        },
        {
          "press_any": [
            "Pin",
            "Pin message"
          ]
        },
        {
          "must": [
            "Pinned"
          ]
        }
      ]
    },
    {
      "id": "assistant",
      "said": "Make the workspace's assistant from its Assistant section",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Sub-agents"
            ]
          },
          {
            "must": [
              "You have no assistant in this workspace",
              "Create assistant"
            ]
          },
          {
            "press_any": [
              "Create assistant"
            ]
          },
          {
            "must": {
              "see": [
                "No sub-agents"
              ],
              "within": 20
            }
          }
        ]
      }
    },
    {
      "id": "assistant-job",
      "said": "Start a sub-agent with a job, handed to the assistant in the conversation it answers in",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Start a sub-agent"
            ]
          },
          {
            "click_any": [
              {
                "prefix": "What the sub-agent should do"
              }
            ]
          },
          {
            "type": "Read the build logs"
          },
          {
            "press_any": [
              "Start"
            ]
          },
          {
            "must": {
              "see": [
                "Start a sub-agent for this job: Read the build logs"
              ],
              "within": 20
            }
          }
        ]
      },
      "dark": true
    },
    {
      "id": "supervision",
      "said": "See how the assistant stands, the model it plans with and what it spent",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Supervision"
            ]
          },
          {
            "must": [
              "Supervision",
              "Assistant is on",
              "Model",
              "Chosen in Settings",
              "Spent"
            ]
          }
        ]
      }
    },
    {
      "id": "standing",
      "said": "The Sub-agents place, where each sub-agent's job, role and standing stand",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Sub-agents"
            ]
          },
          {
            "must": [
              "No sub-agents",
              "cannot read the main chat"
            ]
          }
        ]
      }
    },
    {
      "id": "search",
      "said": "Find the message through the system's search",
      "ops": [
        {
          "search": "Hello"
        },
        {
          "result": "Hello"
        }
      ],
      "dark": true
    },
    {
      "id": "dark",
      "said": "The conversation in the dark theme",
      "ops": [
        {
          "key": "Escape"
        },
        {
          "theme": true
        }
      ]
    }
  ]
}
