{
  "app": "backups",
  "said": "Backups",
  "family": "backups",
  "live": "tl",
  "tl": {
    "id": "so.tilo.backups",
    "package": "backups"
  },
  "steps": [
    {
      "id": "open",
      "said": "Open Backups on an empty workspace",
      "ops": [
        {
          "theme": false
        },
        {
          "launch": true
        },
        {
          "wait_for": "actions"
        },
        {
          "targets": true
        }
      ]
    },
    {
      "id": "setup",
      "said": "A first run asks for a folder to protect",
      "ops": {
        "tl": [
          {
            "wait_for": "Set up Backups"
          },
          {
            "wait_for": "Choose a folder to protect and where its snapshots go."
          }
        ]
      }
    },
    {
      "id": "picker",
      "said": "Choosing the folder opens the system folder chooser, and its answer protects the folder",
      "ops": {
        "tl": [
          {
            "press_any": [
              "Choose the folder to protect"
            ]
          },
          {
            "wait_for": "Choose folder"
          },
          {
            "press": "Choose folder"
          },
          {
            "wait_for": "Choose where snapshots go"
          }
        ]
      }
    },
    {
      "id": "leave",
      "said": "The setup keeps what was chosen and waits for the folder snapshots go to",
      "ops": {
        "tl": [
          {
            "must": {
              "see": [
                "Set up Backups",
                "Choose where snapshots go"
              ]
            }
          }
        ]
      }
    }
  ]
}
