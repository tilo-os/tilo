{
  "app": "settings",
  "said": "Settings",
  "family": "settings",
  "live": "tl",
  "apps": "",
  "packages": [
    "files"
  ],
  "tl": {
    "id": "so.tilo.settings",
    "package": "settings"
  },
  "steps": [
    {
      "id": "files-open",
      "said": "Open Files, so another app's window is open while the desktop restyles",
      "ops": [
        {
          "theme": false
        },
        {
          "open": "file-explorer"
        },
        {
          "window_of": "file-explorer"
        }
      ],
      "budget_ms": 60000
    },
    {
      "id": "settings-open",
      "said": "Open Settings on its Appearance page, with the panes down the side",
      "ops": [
        {
          "launch": true
        },
        {
          "wait_for": "window"
        },
        {
          "wait_for": "Appearance"
        },
        {
          "targets": true
        },
        {
          "must": [
            "Appearance",
            "Accessibility",
            "Network"
          ]
        }
      ],
      "dark": true,
      "budget_ms": 30000
    },
    {
      "id": "dark",
      "said": "Switch the desktop to dark; the open Files window redraws without reopening",
      "ops": [
        {
          "window_frames": "file-explorer"
        },
        {
          "press": "Dark"
        },
        {
          "window_frames": "file-explorer"
        },
        {
          "window_of": "file-explorer"
        }
      ],
      "budget_ms": 30000
    },
    {
      "id": "accessibility",
      "said": "Open Accessibility and see the screen reader's own switch",
      "ops": [
        {
          "press": "Accessibility"
        },
        {
          "wait_for": "Screen reader"
        },
        {
          "must": [
            "Screen reader",
            "Magnifier",
            "Sticky keys"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "notifications",
      "said": "Open Notifications and see do not disturb and the banner switches",
      "ops": [
        {
          "press": "Notifications"
        },
        {
          "wait_for": "Do not disturb"
        },
        {
          "must": [
            "Do not disturb",
            "Show banners"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "region",
      "said": "Open Region and formats and see the currency and date choices",
      "ops": [
        {
          "press": "Region and formats"
        },
        {
          "wait_for": "Currency"
        },
        {
          "must": [
            "Currency",
            "Date format",
            "First day of the week"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "shortcuts",
      "said": "Open Keyboard shortcuts and see the desktop's own chords",
      "ops": [
        {
          "press": "Keyboard shortcuts"
        },
        {
          "wait_for": "The desktop's shortcuts"
        },
        {
          "must": [
            "Search",
            "Lock the screen"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "date-time",
      "said": "Open Date and time and see the clock and its zone",
      "ops": [
        {
          "press": "Date and time"
        },
        {
          "wait_for": "Time zone"
        },
        {
          "must": [
            "Time zone",
            "Formats"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "default-apps",
      "said": "Open Default apps and see what opens each kind",
      "ops": [
        {
          "press": "Default apps"
        },
        {
          "wait_for": "Handlers"
        },
        {
          "must": [
            "Handlers",
            "Choose one"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "permissions",
      "said": "Open Permissions and see what this device's camera, microphone and screen are doing, and what the workspaces gave their apps",
      "ops": [
        {
          "press": "Permissions"
        },
        {
          "wait_for": "Workspace access"
        },
        {
          "must": [
            "This device",
            "Your answers",
            "Workspace access"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "about",
      "said": "Open About and see the system it runs and the hardware it found",
      "ops": [
        {
          "press": "About"
        },
        {
          "wait_for": "Tilo"
        },
        {
          "must": [
            "This system",
            "Apps",
            "Hardware",
            "Processor"
          ]
        }
      ],
      "dark": true,
      "budget_ms": 20000
    },
    {
      "id": "agent-models",
      "said": "Open Agent models and see the workspace's providers, and how to add one",
      "ops": [
        {
          "press": "Agent models"
        },
        {
          "wait_for": "Providers"
        },
        {
          "must": [
            "Providers",
            "Add a provider",
            "The model each kind of work runs on",
            "A whole task",
            "Follows the default"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "billing",
      "said": "Open Billing and see that this computer pays no host for it",
      "ops": [
        {
          "press": "Billing"
        },
        {
          "wait_for": "nothing to pay for"
        },
        {
          "must": [
            "nothing to pay for"
          ]
        }
      ],
      "budget_ms": 20000
    },
    {
      "id": "accounts",
      "said": "Open Accounts and see the workspace's connected accounts, and how to connect one",
      "ops": [
        {
          "press": "Accounts"
        },
        {
          "wait_for": "Connected accounts"
        },
        {
          "must": [
            "Connected accounts",
            "Connect an account",
            "Connect"
          ]
        }
      ],
      "budget_ms": 20000,
      "id": "themes-contrast",
      "said": "Start a theme of your own and see its contrast findings while it is edited",
      "ops": [
        {
          "press": "Themes"
        },
        {
          "wait_for": "Your themes"
        },
        {
          "click": "A name for it, such as harbour"
        },
        {
          "type": "harbour"
        },
        {
          "press": "New theme"
        },
        {
          "wait_for": "Tilo dark copy"
        },
        {
          "press": "Tilo dark copy"
        },
        {
          "must": [
            "Contrast",
            "Every ink and surface pairing keeps its contrast floor."
          ]
        }
      ],
      "budget_ms": 30000
    }
  ]
}
