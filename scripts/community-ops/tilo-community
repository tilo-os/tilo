#!/usr/bin/env python3
"""tilo-community — stand up and run the real Tilo Community.

The operator's procedure from nothing to a live community, on the same steps
`scripts/feedback-dev/feedback-dev` uses for the local one (it is loaded as a
library, so the two never drift): the team identity, the relay paired as the
team's room host, the Tilo Community public room, its standing invitation,
the relay's delegation, #feedback, and the `community.toml` every Tilo image
and desktop-session package ships.

Where the two differ is custody. The team's identity and keyring live in a
custody directory you choose (never the repository), unlocked with a password
you hold; the relay runs elsewhere (Kubernetes or a VM) and receives only its
own paired identity and a public, signed record of what it hosts.

Every step is idempotent: `up` again resumes where it stopped.

Subcommands: guide | decisions | doctor | up | bundle | status | verify |
rotate-invite | revoke-invite | renew-delegation | grant-editor | down.
`tilo-community guide` explains the procedure; every error names its fix.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import shlex
import shutil
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parents[2]
SHIPPED = REPO / "os" / "usr" / "share" / "tilo" / "community.toml"
CHECK = REPO / "dist" / "community-config.sh"
RELAY_CONFIG_IN_CONTAINER = "/etc/tilo/relay.toml"
ROOM_NAME = "Tilo Community"
HEADER = (
    "# Where this release finds the Tilo community and the Tilo team.\n"
    "#\n"
    "# Written by scripts/community-ops/tilo-community; read by the shell\n"
    "# (crates/session/shell/src/shell/community.rs). Public: a standing\n"
    "# invitation and a public key. Change it with `tilo-community\n"
    "# rotate-invite`, never by hand.\n\n"
)


def load_feedback_dev():
    path = REPO / "scripts" / "feedback-dev" / "feedback-dev"
    loader = importlib.machinery.SourceFileLoader("feedback_dev", str(path))
    spec = importlib.util.spec_from_loader("feedback_dev", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


fd = load_feedback_dev()
Fix = fd.Fix

DECISIONS = """\
Decisions and credentials only you can provide (nothing here picks them):

  1. The team identity: who owns the Tilo Community room. `up` creates a
     dedicated identity (recommended) whose user root is the room's owner and
     the "Tilo team" every reporter's private room is with. Alternatives
     (a founder's personal identity) put a person's root behind the room.
  2. Where that root lives: the custody directory (TILO_COMMUNITY_CUSTODY)
     holds the identity record and an encrypted keyring; the keyring password
     (TILO_COMMUNITY_KEYRING_PASSWORD) unlocks the root. Choose the machine
     (an offline or dedicated operator machine), its disk encryption, where
     the password is kept (e.g. the team vault) and how the directory is
     backed up. Losing both loses the room's ownership for good.
  3. Where the relay runs: the prod Kubernetes cluster (base in
     os/containers/tilo-relay/community, an overlay in the infra repo), the
     Oregon EKS cluster, or a VM with Podman (community/compose.yaml).
  4. The public endpoint: a static IP and UDP port (4433) that reach the
     relay, given as --public-addr IP:PORT. Every shipped image names it in
     its invitation, so it must stay stable (a reserved IP / Elastic IP);
     changing it means rotate-invite and a new release.
  5. Custody of the relay's identity: its paired device key goes into the
     deployment's secret store (a SOPS secret in the infra repo, or the VM's
     identity/ directory). Choose who can decrypt it.
  6. Who reads private feedback: every reporter's private room is with the
     team identity, so some device must run it — the custody machine's shell,
     or team members' desktops paired to the team identity as its devices.
     And who triages in public: `grant-editor PERSON` makes a teammate an
     Editor of the community room.
  7. Delegation lifetime: none (default; revoke the relay's device to end
     it) or --delegation-days N with renew-delegation before it lapses.
  8. Monitoring: where Prometheus scrapes the relay's metrics port (9464),
     and alerting on it.
  9. Shipping the config: commit os/usr/share/tilo/community.toml (it is
     public), or set the TILO_COMMUNITY_TOML repository variable; release
     builds refuse to publish without one.
"""

GUIDE = f"""\
tilo-community: the real Tilo Community, from nothing to live

  0. Decide (see `tilo-community decisions`), then set:
       export TILO_COMMUNITY_CUSTODY=/secure/path/tilo-community   # 0700, not in a repo
       export TILO_COMMUNITY_KEYRING_PASSWORD=...                  # from your vault
  1. Build on the remote builder:  {fd.BUILD}
  2. Check this machine:           tilo-community doctor
  3. Prepare everything that needs no deployed relay:
       tilo-community up --public-addr IP:4433
     identities, pairing, room, delegation, invitation, community.toml,
     and the deployment bundle in $TILO_COMMUNITY_CUSTODY/deploy.
  4. Deploy the relay with that bundle (you do this; see
     os/containers/tilo-relay/community/README.md): the identity secret, the
     records, the image, the static address. Commit
     os/usr/share/tilo/community.toml.
  5. Finish against the live relay (the team shell publishes the room, adds
     and marks #feedback, and a fresh device joins through the shipped
     invitation):
       tilo-community up --relay-live --ci-apps RUN
  6. Check any time:               tilo-community status [--relay-exec CMD]
       e.g. --relay-exec "kubectl -n tilo-community exec tilo-community-relay-0 --"
  7. Stop the local shells:        tilo-community down

Later:
  rotate-invite            mint a new standing invitation beside the old one;
                           ship it, then revoke the old one
  revoke-invite ID         stop redeeming ID at the relay and the team shell;
                           people it admitted stay members
  renew-delegation [--days N]  re-sign the relay's delegation
  grant-editor PERSON      make a teammate (person id) an Editor who triages
  bundle                   rewrite the deployment bundle from custody

After each of these, redeploy the records (`bundle` output) so the relay
serves the change; a new community.toml needs a new image release.
"""


# ------------------------------------------------------------- location ----

def custody() -> pathlib.Path:
    value = os.environ.get("TILO_COMMUNITY_CUSTODY", "").strip()
    if not value:
        raise Fix("TILO_COMMUNITY_CUSTODY is not set",
                  "choose where the team identity lives (`tilo-community decisions`, 2) and export it")
    path = pathlib.Path(value).expanduser().resolve()
    if path == REPO or REPO in path.parents:
        raise Fix(f"{path} is inside the repository", "keep the team identity outside any checkout")
    return path


def keyring_password() -> str:
    value = os.environ.get("TILO_COMMUNITY_KEYRING_PASSWORD", "")
    if not value or value == fd.KEYRING_PASSWORD:
        raise Fix("TILO_COMMUNITY_KEYRING_PASSWORD is not set to the team keyring's own password",
                  "export it from where you keep it (`tilo-community decisions`, 2)")
    return value


def locate() -> pathlib.Path:
    data = custody()
    password = keyring_password()
    data.mkdir(mode=0o700, parents=True, exist_ok=True)
    data.chmod(0o700)
    runtime = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "tilo-community"
    # Only the team's shell dials the relay directly; the verifying device
    # joins through the shipped invitation alone, like any user's.
    fd.use_location(data, runtime, password, collab_host_sessions=("team",))
    return data


def say(message: str) -> None:
    print(f"tilo-community: {message}", flush=True)


def deploy_dir() -> pathlib.Path:
    return fd.DATA / "deploy"


# ---------------------------------------------------------------- steps ----

def ensure_endpoint(addrs: list[str]) -> dict:
    state = fd.load_state()
    if addrs and state.get("public_addrs") not in (None, addrs) and state.get("invite"):
        raise Fix(
            f"the shipped invitation names {state['public_addrs']}, not {addrs}",
            "keep the address, or change it and then `tilo-community rotate-invite` and release",
        )
    addrs = addrs or state.get("public_addrs") or []
    if not addrs:
        raise Fix("no public address for the relay", "tilo-community up --public-addr IP:4433")
    args = ["endpoint"]
    for addr in addrs:
        args += ["--addr", addr]
    endpoint = json.loads(fd.relay_admin(*args))
    if state.get("relay_endpoint") != endpoint or state.get("public_addrs") != addrs:
        state.update(relay_endpoint=endpoint, public_addrs=addrs)
        fd.save_state(state)
    return endpoint


def ensure_delegation(room: str, days: int | None) -> None:
    state = fd.load_state()
    if state.get("hosted_room") == room and state.get("delegation_days") == days:
        return
    say("the team delegates Commenter admission for the room to the relay")
    args = ["community", "host", "--room", room, "--owner-identity-dir", str(fd.identity_dir("team"))]
    if days:
        args += ["--expires-in-days", str(days)]
    fd.relay_admin(*args, as_team=True)
    state.update(hosted_room=room, delegation_days=days)
    fd.save_state(state)


def write_configs(invite: str) -> None:
    fd.write_community_config(invite, header=HEADER)
    fd.write_community_config(invite, path=SHIPPED, header=HEADER)


def bundle() -> pathlib.Path:
    """The deployment's inputs: the relay's identity, the hosted-room record,
    the endpoint and the community config."""
    state = fd.load_state()
    room = state.get("hosted_room")
    if not room:
        raise Fix("nothing is hosted yet", "tilo-community up --public-addr IP:4433")
    out = deploy_dir()
    identity = out / "identity"
    records = out / "records"
    for directory in (out, identity, records):
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    root = fd.relay_dir() / "identity-root"
    for source, name, mode in (
        (root / "device-private" / "keypair.bin", "device-keypair.bin", 0o600),
        (root / "device" / "cert.bin", "device-cert.bin", 0o644),
        (root / "user-identity" / "pubkey.bin", "user-pubkey.bin", 0o644),
    ):
        target = identity / name
        shutil.copyfile(source, target)
        target.chmod(mode)
    for stale in records.glob("*.json"):
        stale.unlink()
    (records / f"{room}.json").write_text(fd.relay_admin("community", "export", "--room", room))
    (out / "endpoint.json").write_text(json.dumps(state["relay_endpoint"]) + "\n")
    shutil.copyfile(fd.DATA / "community.toml", out / "community.toml")
    return out


def print_deploy(out: pathlib.Path, first_deploy: bool = False) -> None:
    then = """
Then commit os/usr/share/tilo/community.toml, and once the relay answers:
  tilo-community up --relay-live --ci-apps RUN
""" if first_deploy else """
Redeploy the records (the relay installs them on start); commit
os/usr/share/tilo/community.toml if it changed.
"""
    print(f"""
Deployment bundle: {out}
  identity/   the relay's paired identity (secret; never the team root)
  records/    what it hosts (public, signed by the team)
  endpoint.json, community.toml

Kubernetes (infra repo overlay of os/containers/tilo-relay/community):
  kubectl create secret generic tilo-community-relay-identity -n tilo-community \\
      --from-file={out}/identity --dry-run=client -o yaml \\
      > clusters/<cluster>/apps/tilo-community-relay/relay-identity.sops.yaml
  sops -e -i clusters/<cluster>/apps/tilo-community-relay/relay-identity.sops.yaml
  cp {out}/records/*.json clusters/<cluster>/apps/tilo-community-relay/records/
Podman VM: copy identity/ and records/ next to community/compose.yaml.
{then}""")


def apps_for(args: argparse.Namespace):
    if getattr(args, "ci_apps", None):
        return fd.ci_apps(args.ci_apps)
    return fd.NO_APPS


def verify(room: str, apps) -> dict:
    """A device that has never met the team joins through the shipped
    invitation: what every alpha user's first boot does."""
    fd.provision("reporter")
    fd.install_apps("reporter", apps)
    fd.start_shell("reporter", headless=True)
    status = fd.join_reporter(room)
    if apps.packages:
        fd.reporter_sees_feedback(room)
    return status


def cmd_up(args: argparse.Namespace) -> None:
    locate()
    problems = fd.doctor(quiet=True)
    if problems:
        raise problems[0]
    apps = apps_for(args)
    fd.provision("team")
    fd.install_apps("team", apps)
    fd.enrol_relay()
    fd.write_relay_config()
    ensure_endpoint(args.public_addr or [])
    fd.start_shell("team", headless=True)
    room = fd.ensure_room()
    ensure_delegation(room, args.delegation_days)
    invite = fd.ensure_invite(room)
    write_configs(invite)
    out = bundle()
    say(f"room {room} is owned by the team {fd.person_id('team')}")
    say(f"standing invitation {fd.load_state()['invite_id']} names {fd.load_state()['public_addrs']}")
    if not args.relay_live:
        print_deploy(out, first_deploy=True)
        return
    if apps.packages:
        fd.ensure_feedback_channel(room)
    else:
        say("no apps given, so #feedback is not made yet (pass --ci-apps RUN)")
    status = verify(room, apps)
    say(f"live: a new device joined the {status['channel_class']} room as {status['role']}")
    say("the team shell has published the room; `tilo-community down` stops it")


def cmd_bundle(_: argparse.Namespace) -> None:
    locate()
    print_deploy(bundle())


def relay_side(exec_prefix: str, room: str) -> str:
    argv = [*shlex.split(exec_prefix), "tilo-relay-admin", "--config", RELAY_CONFIG_IN_CONTAINER,
            "community", "status", "--room", room]
    result = subprocess.run(argv, capture_output=True, text=True, timeout=60)
    if result.returncode != 0:
        raise Fix(f"the relay did not answer `community status`:\n{result.stdout}{result.stderr}",
                  "check --relay-exec reaches the running relay container")
    return result.stdout


def cmd_status(args: argparse.Namespace) -> None:
    locate()
    state = fd.load_state()
    ok = True
    print(f"custody:  {fd.DATA}")
    for key in ("room", "invite_id", "public_addrs", "delegation_days", "retired_invites"):
        if key in state:
            print(f"{key}: {state[key]}")
    try:
        print(f"team:     {fd.person_id('team')}")
    except Fix:
        print("team:     not provisioned")
        ok = False
    room = state.get("hosted_room")
    if room:
        staged = fd.relay_admin("community", "status", "--room", room)
        print("prepared record:\n  " + staged.strip().replace("\n", "\n  "))
        if args.relay_exec:
            served = relay_side(args.relay_exec, room)
            print("serving relay:\n  " + served.strip().replace("\n", "\n  "))
            wanted = {line for line in staged.splitlines() if line.startswith("invite ")}
            held = {line for line in served.splitlines() if line.startswith("invite ")}
            if wanted != held:
                ok = False
                print("MISMATCH: the relay serves other invitations than prepared; redeploy the records")
    shipped = SHIPPED.read_text() if SHIPPED.exists() else ""
    prepared = (fd.DATA / "community.toml").read_text() if (fd.DATA / "community.toml").exists() else ""
    if not prepared or shipped != prepared:
        ok = False
        print(f"MISMATCH: {SHIPPED.relative_to(REPO)} is not the prepared community.toml")
    check = subprocess.run(["bash", str(CHECK), "check", "--require", str(SHIPPED)],
                           capture_output=True, text=True)
    print(f"release gate: {'ok' if check.returncode == 0 else (check.stdout + check.stderr).strip()}")
    ok &= check.returncode == 0
    if not ok:
        raise Fix("the community is not fully in place", "see the lines above")
    say("status: ok")


def cmd_verify(args: argparse.Namespace) -> None:
    locate()
    room = fd.load_state().get("room")
    if not room:
        raise Fix("there is no community room yet", "tilo-community up --public-addr IP:4433")
    status = verify(room, apps_for(args))
    say(f"verify: a new device joined the {status['channel_class']} room as {status['role']}")


def cmd_rotate(_: argparse.Namespace) -> None:
    locate()
    state = fd.load_state()
    room = state.get("hosted_room")
    if not room or not state.get("invite"):
        raise Fix("there is no invitation to rotate", "tilo-community up --public-addr IP:4433")
    retired = state.setdefault("retired_invites", [])
    if state["invite_id"] not in retired:
        retired.append(state["invite_id"])
    old = state["invite_id"]
    for key in ("invite", "invite_id", "invite_room"):
        state.pop(key, None)
    fd.save_state(state)
    ensure_endpoint([])
    fd.start_shell("team", headless=True)
    invite = fd.ensure_invite(room)
    write_configs(invite)
    print_deploy(bundle())
    say(f"rotated: {fd.load_state()['invite_id']} is shipped next; {old} stays live")
    say(f"once no supported image carries it: tilo-community revoke-invite {old}")


def cmd_revoke(args: argparse.Namespace) -> None:
    locate()
    state = fd.load_state()
    room = state.get("hosted_room")
    invite_id = args.invite_id.strip().lower()
    if not room:
        raise Fix("nothing is hosted yet", "tilo-community up --public-addr IP:4433")
    if invite_id == state.get("invite_id") and not args.force:
        raise Fix(f"{invite_id} is the invitation community.toml ships: revoking it stops every new user joining",
                  "tilo-community rotate-invite first (or pass --force in an emergency)")
    fd.relay_admin("community", "revoke-invite", "--room", room, invite_id)
    fd.start_shell("team", headless=True)
    revoked = fd.answer("team", {"op": "standing_invite_revoke", "room": room, "invite_id": invite_id})
    print_deploy(bundle())
    say(f"revoked {invite_id} in the record{' and the team shell' if revoked.get('revoked') else ''}; "
        "redeploy the records so the relay stops redeeming it")


def cmd_renew(args: argparse.Namespace) -> None:
    locate()
    room = fd.load_state().get("hosted_room")
    if not room:
        raise Fix("nothing is hosted yet", "tilo-community up --public-addr IP:4433")
    state = fd.load_state()
    state.pop("hosted_room", None)
    fd.save_state(state)
    ensure_delegation(room, args.days)
    print_deploy(bundle())


def cmd_grant(args: argparse.Namespace) -> None:
    locate()
    room = fd.load_state().get("room")
    if not room:
        raise Fix("there is no community room yet", "tilo-community up --public-addr IP:4433")
    fd.start_shell("team", headless=True)
    status = fd.answer("team", {"op": "room_grant", "room": room, "person": args.person, "role": "editor"})
    say(f"{args.person} is an Editor of the community room: {json.dumps(status)}")


def cmd_doctor(_: argparse.Namespace) -> int:
    locate()
    problems = fd.doctor()
    if not CHECK.exists():
        print(f"  FAIL  {CHECK.relative_to(REPO)} is missing\n        fix: update this checkout")
        return 1
    return 1 if problems else 0


def cmd_down(_: argparse.Namespace) -> None:
    locate()
    for name in ("team", "reporter"):
        fd.stop(name)
    shutil.rmtree(fd.RUNTIME, ignore_errors=True)
    say("stopped the local shells; custody is kept")


def main() -> int:
    parser = argparse.ArgumentParser(prog="tilo-community", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("guide", help="the whole procedure")
    sub.add_parser("decisions", help="what only you can decide or provide")
    sub.add_parser("doctor", help="check binaries, keyring, custody and ports")
    up = sub.add_parser("up", help="prepare everything; with --relay-live, finish (idempotent)")
    up.add_argument("--public-addr", action="append", metavar="IP:PORT",
                    help="where UDP reaches the deployed relay; repeat for more")
    up.add_argument("--delegation-days", type=int, metavar="N",
                    help="end the relay's delegation after N days (default: never)")
    up.add_argument("--relay-live", action="store_true",
                    help="the relay is deployed: publish the room, make #feedback, verify a join")
    up.add_argument("--ci-apps", metavar="RUN",
                    help="the release-apps.yml run whose Chat makes and shows #feedback")
    sub.add_parser("bundle", help="rewrite the deployment bundle from custody")
    status = sub.add_parser("status", help="custody, prepared record, serving relay, shipped config")
    status.add_argument("--relay-exec", metavar="CMD",
                        help="prefix that runs a command in the relay container")
    verify_cmd = sub.add_parser("verify", help="a new device joins through the shipped invitation")
    verify_cmd.add_argument("--ci-apps", metavar="RUN", help="also check it sees #feedback")
    sub.add_parser("rotate-invite", help="mint a new standing invitation beside the current one")
    revoke = sub.add_parser("revoke-invite", help="stop redeeming a standing invitation")
    revoke.add_argument("invite_id")
    revoke.add_argument("--force", action="store_true", help="even the one community.toml ships")
    renew = sub.add_parser("renew-delegation", help="re-sign the relay's delegation")
    renew.add_argument("--days", type=int, metavar="N", help="its new lifetime (default: never ends)")
    grant = sub.add_parser("grant-editor", help="make a teammate an Editor of the community room")
    grant.add_argument("person", help="the teammate's person id (hex user key)")
    sub.add_parser("down", help="stop the local shells")
    args = parser.parse_args()
    try:
        if args.command == "guide":
            print(GUIDE)
        elif args.command == "decisions":
            print(DECISIONS)
        elif args.command == "doctor":
            return cmd_doctor(args)
        else:
            {
                "up": cmd_up, "bundle": cmd_bundle, "status": cmd_status, "verify": cmd_verify,
                "rotate-invite": cmd_rotate, "revoke-invite": cmd_revoke,
                "renew-delegation": cmd_renew, "grant-editor": cmd_grant, "down": cmd_down,
            }[args.command](args)
    except Fix as problem:
        print(f"tilo-community: {problem.problem}\n  fix: {problem.fix}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
