class Fix(Exception):
    """A failure with the one thing to do about it."""

    def __init__(self, problem: str, fix: str):
        super().__init__(problem)
        self.problem = problem
        self.fix = fix


def say(message: str) -> None:
    print(f"feedback-dev: {message}", flush=True)


# ---------------------------------------------------------------- state ----

def load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    DATA.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    tmp.replace(STATE)


def pid_file(name: str) -> pathlib.Path:
    return RUNTIME / f"{name}.pid"


def running(name: str) -> int | None:
    try:
        pid = int(pid_file(name).read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def stop(name: str) -> None:
    pid = running(name)
    if pid is not None:
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(50):
            if running(name) is None:
                break
            time.sleep(0.1)
        else:
            try:
                os.killpg(pid, signal.SIGKILL)
            except OSError:
                pass
    pid_file(name).unlink(missing_ok=True)


def spawn(name: str, argv: list[str], env: dict, log: pathlib.Path) -> int:
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    log.parent.mkdir(parents=True, exist_ok=True)
    with open(log, "ab") as out:
        proc = subprocess.Popen(
            argv, env=env, stdout=out, stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL, start_new_session=True,
        )
    pid_file(name).write_text(str(proc.pid))
    return proc.pid


def tail(log: pathlib.Path, lines: int = 15) -> str:
    try:
        return "\n".join(log.read_text(errors="replace").splitlines()[-lines:])
    except OSError:
        return "(no log)"


# ---------------------------------------------------------- host guard -----
#
# The dev shells are real desktops: their power menu, idle policy and apps run
# session actions (`loginctl lock-session`, `systemctl suspend|reboot|poweroff`,
# the display manager's switch-user call) that would act on *this* machine and
# its logged-in user. Each shell therefore runs on its own private session bus
# with the system bus unreachable, and with these commands resolving to a
# refusing stub ahead of the host's. `doctor` proves both before anything
# starts.

HOST_SESSION_COMMANDS = (
    "systemctl", "loginctl", "busctl", "gdbus", "dbus-send", "shutdown", "reboot",
    "poweroff", "halt", "gnome-session-quit",
)


def guard_bin() -> pathlib.Path:
    return DATA / "host-guard" / "bin"


def write_host_guard() -> None:
    directory = guard_bin()
    directory.mkdir(parents=True, exist_ok=True)
    script = (
        "#!/bin/sh\n"
        "# feedback-dev: a dev shell must never act on the host's session or power.\n"
        "printf 'feedback-dev: refused \"%s %s\" from a dev session\\n' \"${0##*/}\" \"$*\" >&2\n"
        "exit 1\n"
    )
    for name in HOST_SESSION_COMMANDS:
        path = directory / name
        if not path.exists() or path.read_text() != script:
            path.write_text(script)
        path.chmod(0o755)


def guarded_path() -> str:
    return f"{guard_bin()}:{os.environ.get('PATH', '/usr/bin:/bin')}"


def host_guard_problems(env: dict) -> list[str]:
    problems = []
    for name in HOST_SESSION_COMMANDS:
        found = shutil.which(name, path=env["PATH"])
        if found != str(guard_bin() / name):
            problems.append(f"`{name}` resolves to {found or 'nothing'} in a dev session, not the refusing stub")
    for variable in ("DBUS_SYSTEM_BUS_ADDRESS",):
        if env.get(variable) != "disabled:":
            problems.append(f"{variable} is not disabled in a dev session")
    if "TILO_SESSION_LOGOUT_REQUEST" in env:
        problems.append("a dev session carries the host session wrapper's logout channel")
    if env.get("XDG_RUNTIME_DIR", "").rstrip("/") == os.environ.get("XDG_RUNTIME_DIR", "").rstrip("/"):
        problems.append("a dev session shares the host's XDG_RUNTIME_DIR (and so its systemd user manager)")
    return problems


# ------------------------------------------------------ session keyring -----
#
# Encrypted rooms (the team's private room with a reporter) keep their channel
# state in a Secret Service. Each session gets its own: a gnome-keyring on the
# session's private bus, its keyring files in the session's data directory,
# unlocked with a password only this tool uses. Every step that touches a
# session's identity runs inside it, so its keys live in one custody.

KEYRING_PASSWORD = "feedback-dev"
IN_SESSION = (
    'printf %s "$FEEDBACK_DEV_KEYRING" | gnome-keyring-daemon --unlock --components=secrets '
    '>/dev/null 2>&1 || { echo "feedback-dev: the session keyring did not unlock" >&2; exit 70; }; '
    'exec "$@"'
)


def in_session(argv: list[str], env: dict) -> tuple[list[str], dict]:
    """`argv` on a fresh private session bus whose keyring is unlocked."""
    env = {key: value for key, value in env.items() if key != "DBUS_SESSION_BUS_ADDRESS"}
    env["FEEDBACK_DEV_KEYRING"] = KEYRING_PASSWORD
    return ["dbus-run-session", "--", "sh", "-c", IN_SESSION, "feedback-dev-session", *argv], env


def keyring_problem() -> str | None:
    """Store and read back one secret in a throwaway session keyring."""
    import tempfile
    with tempfile.TemporaryDirectory(dir=DATA) as scratch:
        root = pathlib.Path(scratch)
        env = {
            "PATH": guarded_path(),
            "HOME": str(root),
            "XDG_DATA_HOME": str(root / "data"),
            "XDG_RUNTIME_DIR": str(root / "run"),
            "DBUS_SYSTEM_BUS_ADDRESS": "disabled:",
        }
        (root / "run").mkdir(mode=0o700)
        argv, env = in_session(["sh", "-c",
                                "printf probe | secret-tool store --label=feedback-dev feedback-dev probe"
                                " && secret-tool lookup feedback-dev probe"], env)
        try:
            result = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as error:
            return f"a session keyring could not be started: {error}"
        if result.returncode != 0 or result.stdout.strip() != "probe":
            return f"a session keyring did not keep a secret: {(result.stderr or result.stdout).strip()}"
    return None


# ------------------------------------------------------------ binaries -----

def binary(name: str) -> str:
    path = TARGET / name
    if not path.is_file():
        raise Fix(f"{name} is not built at {path}", BUILD)
    return str(path)


# ------------------------------------------------------------- sessions ----

def session_dir(name: str) -> pathlib.Path:
    return DATA / name


def session_env(name: str, headless: bool) -> dict:
    root = session_dir(name)
    home = root / "home"
    runtime = RUNTIME / name
    for path in (home, root / "config", root / "data", root / "cache", root / "state"):
        path.mkdir(parents=True, exist_ok=True)
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_host_guard()
    env = {
        "PATH": guarded_path(),
        "HOME": str(home),
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "XDG_CONFIG_HOME": str(root / "config"),
        "XDG_DATA_HOME": str(root / "data"),
        "XDG_CACHE_HOME": str(root / "cache"),
        "XDG_STATE_HOME": str(root / "state"),
        "XDG_RUNTIME_DIR": str(runtime),
        "TILO_IDENTITY_ROOT": str(root / "identity-root"),
        "TILO_STATE_PATH": str(root / "config" / "state.json"),
        "TILO_TEST_CONTROL": str(runtime / "control.sock"),
        "TILO_COMMUNITY_CONFIG": str(DATA / "community.toml"),
        "RUST_LOG": os.environ.get("FEEDBACK_DEV_LOG", "info"),
        # The worktree's launcher, which knows this branch's app contract.
        "TILO_LAUNCHER_BIN": str(TARGET / "tilo-launcher"),
        # Dev identities never belong in the desktop's keyring, and a dev
        # shell never reaches logind or systemd: the system bus is
        # unreachable, and each session runs on a private session bus of its
        # own with its own keyring (`in_session`); until then, none at all.
        "DBUS_SYSTEM_BUS_ADDRESS": "disabled:",
        "DBUS_SESSION_BUS_ADDRESS": "disabled:",
        # A dev session nobody is touching must stay drivable: it never locks
        # itself (a locked shell hands every control action to its password
        # field), blanks, or asks to suspend.
        "TILO_IDLE_LOCK_SECS": "0",
        "TILO_IDLE_BLANK_SECS": "0",
        "TILO_IDLE_SUSPEND_SECS": "0",
    }
    if trusted_publishers(name).exists():
        env["TILO_LAUNCHER_TRUSTED_PUBLISHERS_FILE"] = str(trusted_publishers(name))
    endpoint = load_state().get("relay_endpoint")
    if endpoint and (COLLAB_HOST_SESSIONS is None or name in COLLAB_HOST_SESSIONS):
        env["TILO_COLLAB_HOSTS"] = json.dumps([endpoint])
    if headless:
        env["TILO_HEADLESS_SIZE"] = "1280x800"
    else:
        env["TILO_WINIT_TITLE"] = WINDOW_TITLES[name]
        for key in ("WAYLAND_DISPLAY", "DISPLAY", "XAUTHORITY"):
            if key in os.environ:
                env[key] = os.environ[key]
        # The nested window must reach the host compositor's socket, which
        # lives in the real runtime directory.
        host_runtime = os.environ.get("XDG_RUNTIME_DIR")
        if host_runtime and "WAYLAND_DISPLAY" in env and not env["WAYLAND_DISPLAY"].startswith("/"):
            env["WAYLAND_DISPLAY"] = str(pathlib.Path(host_runtime) / env["WAYLAND_DISPLAY"])
    return env


def identity_dir(name: str) -> pathlib.Path:
    return session_dir(name) / "config" / "tilo" / "identity"


def person_id(name: str) -> str:
    pubkey = session_dir(name) / "identity-root" / "user-identity" / "pubkey.bin"
    try:
        data = pubkey.read_bytes()
    except OSError as error:
        raise Fix(f"{name} has no identity ({error})", "feedback-dev up") from None
    return data.hex()


def provision(name: str) -> None:
    if (identity_dir(name) / "primary.json").exists() and (
        session_dir(name) / "identity-root" / "device" / "cert.bin"
    ).exists():
        return
    say(f"provisioning the {name} identity")
    argv, env = in_session([binary("shell"), "--provision-identity", "--disable-peer-sync"],
                           session_env(name, headless=True))
    result = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=120)
    if result.returncode != 0:
        raise Fix(
            f"`shell --provision-identity` failed for {name}:\n{result.stdout}{result.stderr}",
            f"inspect the output above; remove {session_dir(name)} to start this identity over",
        )


def control(name: str, payload: dict, timeout: float = 60.0) -> dict:
    path = RUNTIME / name / "control.sock"
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect(str(path))
    except OSError:
        raise Fix(f"the {name} shell is not answering at {path}", "feedback-dev up") from None
    try:
        sock.sendall((json.dumps(payload) + "\n").encode())
        buffer = b""
        while not buffer.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            buffer += chunk
    finally:
        sock.close()
    return json.loads(buffer.decode() or "{}")


def answer(name: str, payload: dict, timeout: float = 60.0) -> dict:
    response = control(name, payload, timeout)
    if "err" in response:
        err = response["err"]
        raise Fix(
            f"{name}: {payload['op']} refused: [{err.get('code')}] {err.get('message')}",
            f"see {session_dir(name) / 'log'}",
        )
    return response.get("answer", response)


def start_shell(name: str, headless: bool) -> None:
    if running(name) and (RUNTIME / name / "control.sock").exists():
        return
    stop(name)
    env = session_env(name, headless)
    sock = RUNTIME / name / "control.sock"
    sock.unlink(missing_ok=True)
    backend = "headless" if headless else "winit"
    say(f"starting the {name} shell ({backend})")
    log = session_dir(name) / "log"
    problems = host_guard_problems(env)
    if problems:
        raise Fix("refusing to start a shell that could act on this machine: " + "; ".join(problems),
                  "feedback-dev doctor")
    argv, env = in_session([binary("shell"), "--backend", backend], env)
    spawn(name, argv, env, log)
    for _ in range(240):
        if sock.exists():
            return
        if running(name) is None:
            raise Fix(f"the {name} shell exited while starting:\n{tail(log)}", f"see {log}")
        time.sleep(0.5)
    raise Fix(f"the {name} shell did not open its control socket in 120 s", f"see {log}")


# ----------------------------------------------------------------- apps ----

class Apps:
    """Packages to install into every session, and the runtime they run on."""

    def __init__(self, packages: list[pathlib.Path], runtime: pathlib.Path | None,
                 runtime_publishers: tuple[str, ...] = ()):
        self.packages = packages
        self.runtime = runtime
        # Runtime publishers these apps' sessions trust besides the image's
        # own list — a nonpublishing CI run signs with a key of its own.
        self.runtime_publishers = runtime_publishers


NO_APPS = Apps([], None)


def runtime_apps(packages: list[pathlib.Path], runtime: pathlib.Path) -> Apps:
    """Apps on the runtime bundle beside them, trusting that bundle's publisher.

    Both a nonpublishing CI run and a local package sign their runtime with a
    key of their own and name it in `runtime-bundle-publisher.hex`.
    """
    publisher = runtime / "runtime-bundle-publisher.hex"
    return Apps(packages, runtime, (publisher.read_text().strip(),) if publisher.exists() else ())


def ci_apps(run: str) -> Apps:
    """The tapps and runtime bundle a `release-apps.yml` run built.

    The run's `tilo-apps-x86_64` artifact carries thin tapps and the runtime
    bundle they were linked against — the shipped shape, built in CI, never on
    this machine.
    """
    if not run.isdigit():
        raise Fix(f"`{run}` is not a run number", "fgj run list --workflow release-apps.yml")
    dest = APPS / f"ci-{run}"
    archive = dest / "tilo-apps-x86_64.zip"
    if not archive.exists():
        say(f"downloading the apps release-apps run #{run} built")
        dest.mkdir(parents=True, exist_ok=True)
        partial = dest / "download.zip"
        result = subprocess.run(
            ["fgj", "run", "artifacts", run, "-d", "tilo-apps-x86_64", "-o", str(partial)],
            cwd=REPO, capture_output=True, text=True, timeout=1800,
        )
        if result.returncode != 0:
            raise Fix(
                f"run #{run} has no tilo-apps-x86_64 artifact: {result.stdout}{result.stderr}".strip(),
                'fgj workflow run release-apps.yml -r <branch> -f apps="chat notes file-explorer" '
                "-f architectures=x86_64 -f publish=false, then `fgj run watch <run>`",
            )
        partial.rename(archive)
    unpacked = dest / "unpacked"
    if not (unpacked / "tapp").is_dir():
        import zipfile
        shutil.rmtree(unpacked, ignore_errors=True)
        with zipfile.ZipFile(archive) as bundle:
            for entry in bundle.infolist():
                target = bundle.extract(entry, unpacked)
                mode = entry.external_attr >> 16
                if mode:
                    os.chmod(target, mode & 0o7777)
    packages = sorted((unpacked / "tapp").glob("*.tapp"))
    if not packages:
        raise Fix(f"run #{run}'s artifact holds no tapps", f"see {unpacked}")
    return runtime_apps(packages, unpacked / "runtime")


def app_sources(app: str) -> list[str]:
    """Every workspace path the thin package of `app` is built from: the app,
    the runtime it links against, their path dependencies, and the build
    scripts. Read from the manifests themselves: cargo would wait on any other
    cargo on this machine holding its locks."""
    import tomllib
    root = tomllib.loads((REPO / "Cargo.toml").read_text())
    workspace_paths = {
        name: REPO / spec["path"]
        for name, spec in root.get("workspace", {}).get("dependencies", {}).items()
        if isinstance(spec, dict) and "path" in spec
    }
    def manifest(directory: pathlib.Path) -> dict:
        return tomllib.loads((directory / "Cargo.toml").read_text())
    def path_dependencies(directory: pathlib.Path) -> list[pathlib.Path]:
        data = manifest(directory)
        tables = [data.get("dependencies", {}), data.get("build-dependencies", {})]
        tables += [target.get(key, {}) for target in data.get("target", {}).values()
                   for key in ("dependencies", "build-dependencies")]
        found = []
        for table in tables:
            for name, spec in table.items():
                if not isinstance(spec, dict):
                    continue
                if "path" in spec:
                    found.append((directory / spec["path"]).resolve())
                elif spec.get("workspace") and name in workspace_paths:
                    found.append(workspace_paths[name].resolve())
        return found
    runtime = next(
        (path.parent for path in REPO.glob("crates/**/Cargo.toml")
         if "target" not in path.parts and manifest(path.parent).get("package", {}).get("name") == "runtime-dylib"),
        None,
    )
    pending = [REPO / "apps" / app, *([runtime] if runtime else [])]
    seen: set[pathlib.Path] = set()
    while pending:
        directory = pending.pop().resolve()
        if directory in seen or not (directory / "Cargo.toml").exists():
            continue
        seen.add(directory)
        pending.extend(path_dependencies(directory))
    dirs = sorted(str(directory.relative_to(REPO)) for directory in seen)
    # Vendored crates patch the registry graph; any may be in it.
    return [*dirs, "vendor", "Cargo.lock", "Cargo.toml", "os/scripts/build-thin-apps.sh", "tools/ci"]


def app_fingerprint(app: str) -> str:
    """A digest of `app`'s sources as they are in the worktree, committed or
    not, and of the packaging tools."""
    import hashlib
    paths = app_sources(app)
    digest = hashlib.sha256()
    staged = subprocess.run(["git", "-C", str(REPO), "ls-files", "-s", "--", *paths],
                            capture_output=True, check=True).stdout
    digest.update(staged)
    changed = subprocess.run(
        ["git", "-C", str(REPO), "ls-files", "-z", "-m", "-o", "--exclude-standard", "--", *paths],
        capture_output=True, check=True,
    ).stdout.split(b"\0")
    for name in sorted(filter(None, changed)):
        path = REPO / name.decode()
        digest.update(name)
        digest.update(path.read_bytes() if path.is_file() else b"-")
    for tool in ("tilo-app", "tilo-app-package", "tilo-runtime-bundle"):
        stat = (TARGET / tool).stat()
        digest.update(f"{tool}:{stat.st_size}:{stat.st_mtime_ns}".encode())
    return digest.hexdigest()


def package_apps(rebuild: bool) -> Apps:
    """This worktree's apps, packaged thin. Packaged once and kept; with
    `rebuild`, packaged again only when their sources changed since."""
    packages = []
    for app in WORKTREE_APPS:
        out = APPS / f"{app}.tapp"
        packages.append(out)
        stamp = APPS / f"{app}.sources"
        if out.exists() and not rebuild:
            continue
        fingerprint = app_fingerprint(app)
        if out.exists() and stamp.exists() and stamp.read_text() == fingerprint:
            say(f"apps/{app} is unchanged since it was packaged; keeping {out.name}")
            continue
        say(f"packaging apps/{app} from this worktree (built by rcargo)")
        out.parent.mkdir(parents=True, exist_ok=True)
        stamp.unlink(missing_ok=True)
        # Only the runtime this packaging bakes is installed beside the app,
        # not every one an earlier packaging left behind.
        shutil.rmtree(APPS / "runtime", ignore_errors=True)
        log = APPS / f"{app}.log"
        with open(log, "wb") as output:
            # Thin, against a runtime bundle baked from this same build — the
            # shipped apps' shape; `tilo-app package --help` explains it.
            result = subprocess.run(
                [binary("tilo-app"), "package", str(REPO / "apps" / app),
                 "--output", str(out), "--force",
                 "--runtime-out", str(APPS / "runtime")],
                env={**os.environ, "CARGO": "rcargo", "TILO_PKG": binary("tilo-app-package"),
                     "BUNDLE_BIN": binary("tilo-runtime-bundle")},
                cwd=REPO, stdout=output, stderr=subprocess.STDOUT, timeout=3600,
            )
        if result.returncode != 0:
            raise Fix(f"packaging apps/{app} failed:\n{tail(log)}", f"see {log}")
        stamp.write_text(fingerprint)
    return runtime_apps(packages, APPS / "runtime")


def trusted_publishers(name: str) -> pathlib.Path:
    return session_dir(name) / "runtime-bundle-trusted-publishers.txt"


def trust_runtime_publishers(name: str, publishers: tuple[str, ...]) -> None:
    """The session's runtime trust list: the image's own, plus these apps'.

    The launcher reads it from TILO_LAUNCHER_TRUSTED_PUBLISHERS_FILE, the
    developer build's stand-in for /etc/tilo/runtime-bundle-trusted-publishers.txt.
    """
    path = trusted_publishers(name)
    if not publishers:
        path.unlink(missing_ok=True)
        return
    system = pathlib.Path("/etc/tilo/runtime-bundle-trusted-publishers.txt")
    lines = system.read_text().splitlines() if system.exists() else []
    lines = [line.strip() for line in lines if line.strip() and not line.startswith("#")]
    path.write_text("".join(f"{key}\n" for key in dict.fromkeys([*lines, *publishers])))


def install_apps(name: str, apps: Apps) -> None:
    trust_runtime_publishers(name, apps.runtime_publishers)
    packages = apps.packages
    marker = session_dir(name) / "apps-installed"
    stamp = "\n".join(f"{p}:{p.stat().st_mtime_ns}" for p in packages)
    if marker.exists() and marker.read_text() == stamp:
        return
    env = session_env(name, headless=True)
    bundles = apps.runtime / "tilo-runtime" if apps.runtime else None
    for bundle in sorted(bundles.iterdir()) if bundles and bundles.is_dir() else []:
        say(f"installing runtime bundle {bundle.name} into the {name} session")
        result = subprocess.run(
            [binary("tilo-install"), "runtime", "install", "--bundle", str(bundle), "--force"],
            env=env, capture_output=True, text=True, timeout=600,
        )
        if result.returncode != 0:
            raise Fix(f"installing runtime {bundle.name} for {name} failed:\n{result.stdout}{result.stderr}",
                      "see the message above")
    for package in packages:
        say(f"installing {package.name} into the {name} session's app store")
        result = subprocess.run(
            [binary("tilo-install"), "install", "--allow-self-signed", "--force", str(package)],
            env=env, capture_output=True, text=True, timeout=300,
        )
        if result.returncode != 0:
            raise Fix(f"installing {package.name} for {name} failed:\n{result.stdout}{result.stderr}",
                      "see the message above")
    marker.write_text(stamp)


