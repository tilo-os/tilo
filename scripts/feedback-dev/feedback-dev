#!/usr/bin/env python3
"""feedback-dev — a local Tilo community for testing feedback end to end.

Stands up, on production paths, what `docs/architecture/feedback.md` calls the
acceptance setup:

  * two identities, "team" and "reporter", each provisioned by
    `shell --provision-identity` into its own home;
  * a `tilo-relay` enrolled into the team's identity through the real
    `tilo-enroll pair` / `tilo-enroll approve` ceremony;
  * the Tilo Community public room, created by the team's shell, hosted by the
    relay under the team's signed delegation (`tilo-relay-admin community`),
    with its standing invitation minted by the team and registered at the
    relay;
  * a community config (`TILO_COMMUNITY_CONFIG`) both shells read, naming the
    standing invitation and the team principal;
  * the reporter joined through the standing invitation.

Two modes: `--headless` (automation; both shells run `--backend headless`) and
`--nested` (two `--backend winit` windows inside your session, with the apps
installed on this machine). Every step is idempotent: `up` again resumes.

Nothing here builds. Build with rcargo (the command `doctor` prints), then run.

Subcommands: guide | doctor | up | status | ctl | down.   `feedback-dev guide`
explains the whole flow; every error names its fix.
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import shutil
import signal
import socket
import subprocess
import sys
import time

REPO = pathlib.Path(__file__).resolve().parents[2]
TARGET = REPO / "target" / "debug"
DATA = REPO / "target" / "feedback-dev"
# Unix sockets are capped near 108 bytes, so everything with a socket lives
# under the short per-user runtime directory, not the worktree.
RUNTIME = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "tilo-feedback-dev"
STATE = DATA / "state.json"
SESSIONS = ("team", "reporter", "teammate")
# The teammate is a second person on the team: not the room's owner, admitted
# through the standing invitation like anyone, then made an Editor by the
# owner — the path a team member who triages takes.
OPTIONAL_SESSIONS = ("teammate",)
RELAY_PORT = int(os.environ.get("FEEDBACK_DEV_RELAY_PORT", "47831"))
MIN_AVAILABLE_MIB = int(os.environ.get("FEEDBACK_DEV_MIN_MIB", "3072"))

BINARIES = (
    "shell", "tilo-control", "tilo-launcher", "tilo-relay", "tilo-relay-admin",
    "tilo-enroll", "tilo-app", "tilo-app-package", "tilo-install", "tilo-runtime-bundle",
)
BUILD = (
    "rcargo build -p shell --bin shell --bin tilo-control -p launcher --bin tilo-launcher "
    "-p tilo-relay --bin tilo-relay --bin tilo-relay-admin --bin tilo-enroll "
    "-p tilo-app-cli --bin tilo-app -p tilo-app-package-cli --bin tilo-app-package "
    "-p install --bin tilo-install -p runtime-bundle --bin tilo-runtime-bundle"
)
# Apps this checkout's feedback work changes, packaged from the worktree and
# installed into each session's own store the way `tilo-vm swap app:<dir>`
# does. Every other app (Notes, Files, …) comes from the machine's store.
WORKTREE_APPS = ("chat",)

