def available_mib() -> int:
    for line in pathlib.Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) // 1024
    return 0


def doctor(quiet: bool = False) -> list[Fix]:
    problems: list[Fix] = []
    for name in BINARIES:
        if not (TARGET / name).is_file():
            problems.append(Fix(f"{name} is not built at {TARGET / name}", BUILD))
            break
    mib = available_mib()
    if mib < MIN_AVAILABLE_MIB:
        problems.append(Fix(
            f"only {mib} MiB of memory is available; two shells and a relay need "
            f"about {MIN_AVAILABLE_MIB} MiB",
            "stop other builds or sessions, or set FEEDBACK_DEV_MIN_MIB to accept the risk",
        ))
    if not shutil.which("gnome-keyring-daemon") or not shutil.which("secret-tool"):
        problems.append(Fix("gnome-keyring-daemon and secret-tool are needed for each session's keyring",
                            "install gnome-keyring and libsecret"))
    elif shutil.which("dbus-run-session"):
        DATA.mkdir(parents=True, exist_ok=True)
        problem = keyring_problem()
        if problem:
            problems.append(Fix(problem, "check `gnome-keyring-daemon --unlock` works on a private bus"))
    if not shutil.which("dbus-run-session"):
        problems.append(Fix("dbus-run-session is not installed; each dev shell needs a private session bus",
                            "install dbus (the dbus-daemon package)"))
    for problem in host_guard_problems(session_env("team", headless=True)):
        problems.append(Fix(problem, "report this: the host guard in feedback-dev is broken"))
    busy = subprocess.run(["ss", "-ulpn"], capture_output=True, text=True).stdout
    if ":45831 " in busy and not running("relay"):
        problems.append(Fix("the LAN pairing port 45831/udp is in use",
                            "close the other pairing (`ss -ulpn | grep 45831`)"))
    if not quiet:
        for problem in problems:
            print(f"  FAIL  {problem.problem}\n        fix: {problem.fix}")
        if not problems:
            print("  ok    binaries built, memory available, pairing port free,")
            print("        dev shells isolated from the host's session and power (private D-Bus,")
            print("        no system bus, session commands stubbed), each with its own unlocked")
            print("        keyring for encrypted rooms")
    return problems


def cmd_up(args: argparse.Namespace) -> None:
    problems = doctor(quiet=True)
    if problems:
        raise problems[0]
    headless = not args.nested
    if args.ci_apps and args.worktree_apps:
        raise Fix("--ci-apps and --worktree-apps both choose the apps", "pass one of them")
    if args.ci_apps:
        apps = ci_apps(args.ci_apps)
    elif args.worktree_apps:
        apps = package_apps(args.rebuild_apps)
    else:
        apps = NO_APPS
    for name in SESSIONS:
        if name in OPTIONAL_SESSIONS:
            continue
        provision(name)
        install_apps(name, apps)
    enrol_relay()
    write_relay_config()
    start_relay()
    start_shell("team", headless)
    room = ensure_room()
    ensure_hosting(room)
    invite = ensure_invite(room)
    write_community_config(invite)
    start_shell("reporter", headless)
    status = join_reporter(room)
    private = open_private_room()
    teammate = add_teammate(room, headless, apps) if args.teammate else None
    feedback = bool(apps.packages)
    if feedback:
        ensure_feedback_channel(room)
        reporter_sees_feedback(room)
    state = load_state()
    state["private_room"] = private["room"]
    state["mode"] = "headless" if headless else "nested"
    save_state(state)
    say(f"up: room {room} is public; the reporter holds {status['role']}")
    say(f"up: private room {private['room']}: the team holds {private['role']}")
    if teammate:
        say(f"up: the teammate holds {teammate['role']} in the public room")
    if feedback:
        say("up: #feedback is the community's feedback channel; the reporter's Chat can post there")
    else:
        say("up: no apps installed, so no #feedback (pass --ci-apps RUN or --worktree-apps)")
    say("next: feedback-dev ctl reporter -- community team-room   |   feedback-dev status")


def cmd_status(_: argparse.Namespace) -> None:
    state = load_state()
    print(f"data:    {DATA}")
    print(f"runtime: {RUNTIME}")
    for name in ("relay", *SESSIONS):
        pid = running(name)
        print(f"{name:9} {'running pid ' + str(pid) if pid else 'stopped'}")
    for key in ("mode", "room", "private_room", "invite_id", "relay_endpoint"):
        if key in state:
            print(f"{key}: {json.dumps(state[key]) if not isinstance(state[key], str) else state[key]}")
    for name in SESSIONS:
        if running(name):
            try:
                print(f"{name} community: {json.dumps(answer(name, {'op': 'community_status'}, 10))}")
            except Fix as problem:
                print(f"{name} community: {problem.problem}")


def cmd_ctl(args: argparse.Namespace) -> None:
    rest = [arg for arg in args.rest if arg != "--"]
    env = {**os.environ, "TILO_TEST_CONTROL": str(RUNTIME / args.session / "control.sock")}
    sys.exit(subprocess.call([binary("tilo-control"), *rest], env=env))


def cmd_down(args: argparse.Namespace) -> None:
    for name in (*SESSIONS, "relay"):
        stop(name)
    shutil.rmtree(RUNTIME, ignore_errors=True)
    if args.purge:
        shutil.rmtree(DATA, ignore_errors=True)
        say(f"stopped and removed {DATA}")
    else:
        say("stopped; identities and the room are kept (`down --purge` forgets them)")


def main() -> int:
    parser = argparse.ArgumentParser(prog="feedback-dev", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("guide", help="explain the whole flow")
    sub.add_parser("doctor", help="check binaries, memory and ports; print each fix")
    up = sub.add_parser("up", help="stand everything up (idempotent)")
    mode = up.add_mutually_exclusive_group()
    mode.add_argument("--headless", action="store_true", help="both shells headless (default)")
    mode.add_argument("--nested", action="store_true", help="both shells as windows in this session")
    up.add_argument("--teammate", action="store_true",
                    help="also a second team member, admitted and made Editor by the owner")
    up.add_argument("--ci-apps", metavar="RUN",
                    help="install the tapps and runtime a release-apps.yml run built into every session")
    up.add_argument("--worktree-apps", action="store_true",
                    help="package and install this worktree's chat into both sessions")
    up.add_argument("--rebuild-apps", action="store_true",
                    help="repackage this worktree's apps (chat) when their sources changed "
                         "since they were last packaged (packages outlive `down --purge`)")
    sub.add_parser("status", help="what runs, the room, each shell's community status")
    sub.add_parser("check", help="the reporter posts in #feedback, the team votes, replies and sets "
                                 "its status, the team replays a recording; everyone must see it all")
    ctl = sub.add_parser("ctl", help="run tilo-control against one shell")
    ctl.add_argument("session", choices=SESSIONS)
    ctl.add_argument("rest", nargs=argparse.REMAINDER)
    down = sub.add_parser("down", help="stop shells and relay, remove runtime dirs")
    down.add_argument("--purge", action="store_true", help="also remove identities and state")
    args = parser.parse_args()
    try:
        if args.command == "guide":
            print(GUIDE)
        elif args.command == "doctor":
            return 1 if doctor() else 0
        elif args.command == "up":
            cmd_up(args)
        elif args.command == "check":
            cmd_check(args)
        elif args.command == "status":
            cmd_status(args)
        elif args.command == "ctl":
            cmd_ctl(args)
        elif args.command == "down":
            cmd_down(args)
    except Fix as problem:
        print(f"feedback-dev: {problem.problem}\n  fix: {problem.fix}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
