"""


class Fix(Exception):
    """A failure with the one thing to do about it."""

    def __init__(self, problem: str, fix: str):
        super().__init__(problem)
        self.problem = problem
        self.fix = fix


def say(message: str) -> None:
    print(f"feedback-dev: {message}", flush=True)


# ---------------------------------------------------------------- state ----

def load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    DATA.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    tmp.replace(STATE)


def pid_file(name: str) -> pathlib.Path:
    return RUNTIME / f"{name}.pid"


def running(name: str) -> int | None:
    try:
        pid = int(pid_file(name).read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def stop(name: str) -> None:
    pid = running(name)
    if pid is not None:
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(50):
            if running(name) is None:
                break
            time.sleep(0.1)
        else:
            try:
                os.killpg(pid, signal.SIGKILL)
            except OSError:
                pass
    pid_file(name).unlink(missing_ok=True)


def spawn(name: str, argv: list[str], env: dict, log: pathlib.Path) -> int:
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    log.parent.mkdir(parents=True, exist_ok=True)
    with open(log, "ab") as out:
        proc = subprocess.Popen(
            argv, env=env, stdout=out, stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL, start_new_session=True,
        )
    pid_file(name).write_text(str(proc.pid))
    return proc.pid


def tail(log: pathlib.Path, lines: int = 15) -> str:
    try:
        return "\n".join(log.read_text(errors="replace").splitlines()[-lines:])
    except OSError:
        return "(no log)"


# ---------------------------------------------------------- host guard -----
#
# The dev shells are real desktops: their power menu, idle policy and apps run
# session actions (`loginctl lock-session`, `systemctl suspend|reboot|poweroff`,
# the display manager's switch-user call) that would act on *this* machine and
# its logged-in user. Each shell therefore runs on its own private session bus
# with the system bus unreachable, and with these commands resolving to a
# refusing stub ahead of the host's. `doctor` proves both before anything
# starts.

HOST_SESSION_COMMANDS = (
    "systemctl", "loginctl", "busctl", "gdbus", "dbus-send", "shutdown", "reboot",
    "poweroff", "halt", "gnome-session-quit",
)


def guard_bin() -> pathlib.Path:
    return DATA / "host-guard" / "bin"


def write_host_guard() -> None:
    directory = guard_bin()
    directory.mkdir(parents=True, exist_ok=True)
    script = (
        "#!/bin/sh\n"
        "# feedback-dev: a dev shell must never act on the host's session or power.\n"
        "printf 'feedback-dev: refused \"%s %s\" from a dev session\\n' \"${0##*/}\" \"$*\" >&2\n"
        "exit 1\n"
    )
    for name in HOST_SESSION_COMMANDS:
        path = directory / name
        if not path.exists() or path.read_text() != script:
            path.write_text(script)
        path.chmod(0o755)


def guarded_path() -> str:
    return f"{guard_bin()}:{os.environ.get('PATH', '/usr/bin:/bin')}"


def host_guard_problems(env: dict) -> list[str]:
    problems = []
    for name in HOST_SESSION_COMMANDS:
        found = shutil.which(name, path=env["PATH"])
        if found != str(guard_bin() / name):
            problems.append(f"`{name}` resolves to {found or 'nothing'} in a dev session, not the refusing stub")
    for variable in ("DBUS_SYSTEM_BUS_ADDRESS",):
        if env.get(variable) != "disabled:":
            problems.append(f"{variable} is not disabled in a dev session")
    if "TILO_SESSION_LOGOUT_REQUEST" in env:
        problems.append("a dev session carries the host session wrapper's logout channel")
    if env.get("XDG_RUNTIME_DIR", "").rstrip("/") == os.environ.get("XDG_RUNTIME_DIR", "").rstrip("/"):
        problems.append("a dev session shares the host's XDG_RUNTIME_DIR (and so its systemd user manager)")
    return problems


# ------------------------------------------------------------ binaries -----

def binary(name: str) -> str:
    path = TARGET / name
    if not path.is_file():
        raise Fix(f"{name} is not built at {path}", BUILD)
    return str(path)


# ------------------------------------------------------------- sessions ----

def session_dir(name: str) -> pathlib.Path:
    return DATA / name


def session_env(name: str, headless: bool) -> dict:
    root = session_dir(name)
    home = root / "home"
    runtime = RUNTIME / name
    for path in (home, root / "config", root / "data", root / "cache", root / "state"):
        path.mkdir(parents=True, exist_ok=True)
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_host_guard()
    env = {
        "PATH": guarded_path(),
        "HOME": str(home),
        "LANG": os.environ.get("LANG", "C.UTF-8"),
        "XDG_CONFIG_HOME": str(root / "config"),
        "XDG_DATA_HOME": str(root / "data"),
        "XDG_CACHE_HOME": str(root / "cache"),
        "XDG_STATE_HOME": str(root / "state"),
        "XDG_RUNTIME_DIR": str(runtime),
        "TILO_IDENTITY_ROOT": str(root / "identity-root"),
        "TILO_STATE_PATH": str(root / "config" / "state.json"),
        "TILO_TEST_CONTROL": str(runtime / "control.sock"),
        "TILO_COMMUNITY_CONFIG": str(DATA / "community.toml"),
        "RUST_LOG": os.environ.get("FEEDBACK_DEV_LOG", "info"),
        # The worktree's launcher, which knows this branch's app contract.
        "TILO_LAUNCHER_BIN": str(TARGET / "tilo-launcher"),
        # Two dev identities never belong in the desktop's keyring, and a
        # dev shell never reaches logind or systemd: the system bus is
        # unreachable, and each shell gets a private session bus of its own
        # (`dbus-run-session`, below). Without the host's Secret Service the
        # identity service keeps these identities in its file custody.
        "DBUS_SYSTEM_BUS_ADDRESS": "disabled:",
        "DBUS_SESSION_BUS_ADDRESS": "disabled:",
    }
    endpoint = load_state().get("relay_endpoint")
    if endpoint:
        env["TILO_COLLAB_HOSTS"] = json.dumps([endpoint])
    if headless:
        env["TILO_HEADLESS_SIZE"] = "1280x800"
    else:
        for key in ("WAYLAND_DISPLAY", "DISPLAY", "XAUTHORITY"):
            if key in os.environ:
                env[key] = os.environ[key]
        # The nested window must reach the host compositor's socket, which
        # lives in the real runtime directory.
        host_runtime = os.environ.get("XDG_RUNTIME_DIR")
        if host_runtime and "WAYLAND_DISPLAY" in env and not env["WAYLAND_DISPLAY"].startswith("/"):
            env["WAYLAND_DISPLAY"] = str(pathlib.Path(host_runtime) / env["WAYLAND_DISPLAY"])
    return env


def identity_dir(name: str) -> pathlib.Path:
    return session_dir(name) / "config" / "tilo" / "identity"


def person_id(name: str) -> str:
    pubkey = session_dir(name) / "identity-root" / "user-identity" / "pubkey.bin"
    try:
        data = pubkey.read_bytes()
    except OSError as error:
        raise Fix(f"{name} has no identity ({error})", "feedback-dev up") from None
    return data.hex()


def provision(name: str) -> None:
    if (identity_dir(name) / "primary.json").exists() and (
        session_dir(name) / "identity-root" / "device" / "cert.bin"
    ).exists():
        return
    say(f"provisioning the {name} identity")
    env = session_env(name, headless=True)
    result = subprocess.run(
        [binary("shell"), "--provision-identity", "--disable-peer-sync"],
        env=env, capture_output=True, text=True, timeout=120,
    )
    if result.returncode != 0:
        raise Fix(
            f"`shell --provision-identity` failed for {name}:\n{result.stdout}{result.stderr}",
            f"inspect the output above; remove {session_dir(name)} to start this identity over",
        )


def control(name: str, payload: dict, timeout: float = 60.0) -> dict:
    path = RUNTIME / name / "control.sock"
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect(str(path))
    except OSError:
        raise Fix(f"the {name} shell is not answering at {path}", "feedback-dev up") from None
    try:
        sock.sendall((json.dumps(payload) + "\n").encode())
        buffer = b""
        while not buffer.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            buffer += chunk
    finally:
        sock.close()
    return json.loads(buffer.decode() or "{}")


def answer(name: str, payload: dict, timeout: float = 60.0) -> dict:
    response = control(name, payload, timeout)
    if "err" in response:
        err = response["err"]
        raise Fix(
            f"{name}: {payload['op']} refused: [{err.get('code')}] {err.get('message')}",
            f"see {session_dir(name) / 'log'}",
        )
    return response.get("answer", response)


def start_shell(name: str, headless: bool) -> None:
    if running(name) and (RUNTIME / name / "control.sock").exists():
        return
    stop(name)
    env = session_env(name, headless)
    sock = RUNTIME / name / "control.sock"
    sock.unlink(missing_ok=True)
    backend = "headless" if headless else "winit"
    say(f"starting the {name} shell ({backend})")
    log = session_dir(name) / "log"
    problems = host_guard_problems(env)
    if problems:
        raise Fix("refusing to start a shell that could act on this machine: " + "; ".join(problems),
                  "feedback-dev doctor")
    env.pop("DBUS_SESSION_BUS_ADDRESS", None)
    spawn(name, ["dbus-run-session", "--", binary("shell"), "--backend", backend], env, log)
    for _ in range(240):
        if sock.exists():
            return
        if running(name) is None:
            raise Fix(f"the {name} shell exited while starting:\n{tail(log)}", f"see {log}")
        time.sleep(0.5)
    raise Fix(f"the {name} shell did not open its control socket in 120 s", f"see {log}")


# ----------------------------------------------------------------- apps ----

def package_apps(rebuild: bool) -> list[pathlib.Path]:
    packages = []
    for app in WORKTREE_APPS:
        out = DATA / "apps" / f"{app}.tapp"
        packages.append(out)
        if out.exists() and not rebuild:
            continue
        say(f"packaging apps/{app} from this worktree (built by rcargo)")
        out.parent.mkdir(parents=True, exist_ok=True)
        log = DATA / "apps" / f"{app}.log"
        with open(log, "wb") as output:
            # Thin, against a runtime bundle baked from this same build — the
            # shipped apps' shape; `tilo-app package --help` explains it.
            result = subprocess.run(
                [binary("tilo-app"), "package", str(REPO / "apps" / app),
                 "--output", str(out), "--force",
                 "--runtime-out", str(DATA / "apps" / "runtime")],
                env={**os.environ, "CARGO": "rcargo", "TILO_PKG": binary("tilo-app-package"),
                     "BUNDLE_BIN": binary("tilo-runtime-bundle")},
                cwd=REPO, stdout=output, stderr=subprocess.STDOUT, timeout=3600,
            )
        if result.returncode != 0:
            raise Fix(f"packaging apps/{app} failed:\n{tail(log)}", f"see {log}")
    return packages


def install_apps(name: str, packages: list[pathlib.Path]) -> None:
    marker = session_dir(name) / "apps-installed"
    stamp = "\n".join(f"{p}:{p.stat().st_mtime_ns}" for p in packages)
    if marker.exists() and marker.read_text() == stamp:
        return
    env = session_env(name, headless=True)
    bundles = DATA / "apps" / "runtime" / "tilo-runtime"
    for bundle in sorted(bundles.iterdir()) if bundles.is_dir() else []:
        say(f"installing runtime bundle {bundle.name} into the {name} session")
        result = subprocess.run(
            [binary("tilo-install"), "runtime", "install", "--bundle", str(bundle), "--force"],
            env=env, capture_output=True, text=True, timeout=600,
        )
        if result.returncode != 0:
            raise Fix(f"installing runtime {bundle.name} for {name} failed:\n{result.stdout}{result.stderr}",
                      "see the message above")
    for package in packages:
        say(f"installing {package.name} into the {name} session's app store")
        result = subprocess.run(
            [binary("tilo-install"), "install", "--allow-self-signed", "--force", str(package)],
            env=env, capture_output=True, text=True, timeout=300,
        )
        if result.returncode != 0:
            raise Fix(f"installing {package.name} for {name} failed:\n{result.stdout}{result.stderr}",
                      "see the message above")
    marker.write_text(stamp)


# ---------------------------------------------------------------- relay ----

def relay_dir() -> pathlib.Path:
    return DATA / "relay"


def relay_config() -> pathlib.Path:
    return relay_dir() / "relay.toml"


def relay_admin(*args: str) -> str:
    result = subprocess.run(
        [binary("tilo-relay-admin"), "--config", str(relay_config()), *args],
        capture_output=True, text=True, timeout=120,
    )
    if result.returncode != 0:
        raise Fix(
            f"tilo-relay-admin {' '.join(args[:2])} failed:\n{result.stdout}{result.stderr}",
            "see the message above",
        )
    return result.stdout


def enrol_relay() -> None:
    root = relay_dir() / "identity-root"
    if (root / "device" / "cert.bin").exists():
        return
    say("enrolling the relay as the team's room host (tilo-enroll pair-room-host + approve-room-host)")
    root.mkdir(parents=True, exist_ok=True)
    log = relay_dir() / "enroll.log"
    team_env = session_env("team", headless=True)
    with open(log, "ab") as out:
        pair = subprocess.Popen(
            [binary("tilo-enroll"), "pair-room-host", "--identity-root", str(root),
             "--label", "Tilo community host", "--timeout", "90"],
            stdout=out, stderr=subprocess.STDOUT, start_new_session=True,
        )
        time.sleep(1.0)
        approve = subprocess.run(
            [binary("tilo-enroll"), "approve-room-host",
             "--identity-root", str(session_dir("team") / "identity-root"),
             "--identity-dir", str(identity_dir("team")),
             "--timeout", "60"],
            env=team_env, stdout=out, stderr=subprocess.STDOUT, timeout=120,
        )
        try:
            pair.wait(timeout=90)
        except subprocess.TimeoutExpired:
            pair.kill()
    if approve.returncode != 0 or pair.returncode != 0 or not (root / "device" / "cert.bin").exists():
        raise Fix(
            f"relay enrollment did not complete (approve={approve.returncode}, "
            f"pair={pair.returncode}):\n{tail(log)}",
            f"see {log}; the pairing port {45831}/udp must be free (`ss -ulpn | grep 45831`)",
        )


def write_relay_config() -> None:
    path = relay_config()
    state = relay_dir() / "state"
    state.mkdir(parents=True, exist_ok=True)
    wanted = {
        "identity_root": str(relay_dir() / "identity-root"),
        "state_root": str(state),
        "iroh_listen": f"127.0.0.1:{RELAY_PORT}",
        # A community host is not this identity's Files home peer: it carries
        # no home-peer bundle and admits any certified device to connect,
        # each room gated by its own membership.
        "home_peer_bundle": str(relay_dir() / "no-home-peer.toml"),
        "full_replica_status": str(state / "full-replica-status.json"),
    }
    if not path.exists():
        subprocess.run([binary("tilo-relay"), "--config", str(path), "init"],
                       check=True, capture_output=True, timeout=30)
    text = path.read_text()
    lines = []
    seen = set()
    in_trust_table = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            in_trust_table = stripped == "[trust_policy]"
            if in_trust_table:
                continue
        elif in_trust_table:
            continue
        key = line.split("=", 1)[0].strip()
        if key in wanted and not stripped.startswith("["):
            lines.append(f'{key} = "{wanted[key]}"')
            seen.add(key)
        elif key == "trust_policy":
            continue
        else:
            lines.append(line)
    header = [f'{key} = "{value}"' for key, value in wanted.items() if key not in seen]
    header.append('trust_policy = { kind = "allow_any" }')
    # Top-level keys must precede any table.
    first_table = next((i for i, line in enumerate(lines) if line.startswith("[")), len(lines))
    lines[first_table:first_table] = header
    path.write_text("\n".join(lines) + "\n")


def start_relay(restart: bool = False) -> dict:
    if restart:
        stop("relay")
    endpoint_file = relay_dir() / "state" / "endpoint.json"
    if not running("relay"):
        endpoint_file.unlink(missing_ok=True)
        say("starting the relay")
        spawn("relay", [binary("tilo-relay"), "--config", str(relay_config()), "run"],
              {**os.environ, "TILO_RELAY_LOG": "tilo_relay=info,warn"}, relay_dir() / "log")
    for _ in range(120):
        if endpoint_file.exists():
            endpoint = json.loads(endpoint_file.read_text())
            state = load_state()
            if state.get("relay_endpoint") != endpoint:
                state["relay_endpoint"] = endpoint
                save_state(state)
            return endpoint
        if running("relay") is None:
            raise Fix(f"the relay exited while starting:\n{tail(relay_dir() / 'log')}",
                      f"see {relay_dir() / 'log'}")
        time.sleep(0.5)
    raise Fix("the relay did not publish its endpoint in 60 s", f"see {relay_dir() / 'log'}")


# ------------------------------------------------------------ community ----

def ensure_room() -> str:
    state = load_state()
    room = state.get("room")
    if room:
        status = control("team", {"op": "room_status", "room": room})
        if "err" not in status:
            return room
    say("creating the Tilo Community public room in the team shell")
    created = answer("team", {"op": "public_room_create", "name": "Tilo Community"})
    room = created["room"]
    if created.get("channel_class") != "public":
        raise Fix(f"the new room is {created.get('channel_class')}, not public", "report this as a bug")
    state["room"] = room
    save_state(state)
    return room


def ensure_hosting(room: str) -> None:
    state = load_state()
    if state.get("hosted_room") == room:
        return
    say("delegating Commenter admission for the room to the relay")
    relay_admin("community", "host", "--room", room,
                "--owner-identity-dir", str(identity_dir("team")))
    state["hosted_room"] = room
    save_state(state)
    start_relay(restart=True)


def ensure_invite(room: str) -> str:
    state = load_state()
    invite = state.get("invite")
    if invite and state.get("invite_room") == room and (
        f"invite {state.get('invite_id')}\tlive" in relay_admin("community", "status", "--room", room)
    ):
        return invite
    say("minting the standing invitation and registering it at the relay")
    minted = answer("team", {"op": "standing_invite", "room": room, "role": "commenter"})
    invite = minted["invite"]
    relay_admin("community", "add-invite", "--room", room, invite)
    state.update(invite=invite, invite_id=minted["invite_id"], invite_room=room)
    save_state(state)
    return invite


def write_community_config(invite: str) -> None:
    path = DATA / "community.toml"
    text = (
        "# Written by scripts/feedback-dev/feedback-dev; read by both shells.\n"
        "[community]\n"
        f'invite = "{invite}"\n\n'
        "[team]\n"
        f'user_public_key = "{person_id("team")}"\n'
        'label = "Tilo team"\n'
    )
    if not path.exists() or path.read_text() != text:
        path.write_text(text)


def join_community(name: str, room: str, role: str | None = None) -> dict:
    status = answer(name, {"op": "community_status"})
    if status.get("room") != room:
        say(f"the {name} redeems the standing invitation")
        answer(name, {"op": "community_join"})
    for _ in range(120):
        status = answer(name, {"op": "community_status"})
        if (
            status.get("governed")
            and status.get("channel_class") == "public"
            and status.get("role")
            and (role is None or status.get("role") == role)
        ):
            return status
        time.sleep(1.0)
    raise Fix(
        f"the {name} did not become {role or 'a member'} of the public room: {status}",
        f"see {session_dir(name) / 'log'} and {relay_dir() / 'log'}",
    )


def join_reporter(room: str) -> dict:
    return join_community("reporter", room)


def add_teammate(room: str, headless: bool, packages: list[pathlib.Path]) -> dict:
    provision("teammate")
    install_apps("teammate", packages)
    start_shell("teammate", headless)
    join_community("teammate", room)
    status = answer("teammate", {"op": "community_status"})
    if status.get("role") != "editor":
        say("the team owner makes the teammate an Editor of the community room")
        answer("team", {"op": "room_grant", "room": room, "person": person_id("teammate"),
                        "role": "editor"})
    return join_community("teammate", room, role="editor")


def open_private_room() -> dict:
    """The reporter's private feedback room with the team, from both ends."""
    reporter_side = answer("reporter", {"op": "community_team_room"})
    answer("team", {"op": "community_direct_room", "person": person_id("reporter"),
                    "label": "Reporter"})
    for _ in range(60):
        team_side = answer("team", {"op": "room_status", "room": reporter_side["room"]})
        if team_side.get("governed") and team_side.get("role"):
            return team_side
        time.sleep(1.0)
    raise Fix(
        f"the team did not join the reporter's private room: {team_side}",
        f"see {session_dir('team') / 'log'} and {relay_dir() / 'log'}",
    )


