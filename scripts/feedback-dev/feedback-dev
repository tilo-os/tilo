def relay_dir() -> pathlib.Path:
    return DATA / "relay"


def relay_config() -> pathlib.Path:
    return relay_dir() / "relay.toml"


def relay_admin(*args: str, as_team: bool = False) -> str:
    """Run `tilo-relay-admin`; `as_team` when it signs with the team's identity,
    which only the team's session keyring opens."""
    argv = [binary("tilo-relay-admin"), "--config", str(relay_config()), *args]
    env = dict(os.environ)
    if as_team:
        argv, env = in_session(argv, session_env("team", headless=True))
    result = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=120)
    if result.returncode != 0:
        raise Fix(
            f"tilo-relay-admin {' '.join(args[:2])} failed:\n{result.stdout}{result.stderr}",
            "see the message above",
        )
    return result.stdout


def enrol_relay() -> None:
    root = relay_dir() / "identity-root"
    if (root / "device" / "cert.bin").exists():
        return
    say("enrolling the relay as the team's room host (tilo-enroll pair-room-host + approve-room-host)")
    root.mkdir(parents=True, exist_ok=True)
    log = relay_dir() / "enroll.log"
    team_env = session_env("team", headless=True)
    with open(log, "ab") as out:
        pair = subprocess.Popen(
            [binary("tilo-enroll"), "pair-room-host", "--identity-root", str(root),
             "--label", "Tilo community host", "--timeout", "90"],
            stdout=out, stderr=subprocess.STDOUT, start_new_session=True,
        )
        time.sleep(1.0)
        approve_argv, approve_env = in_session(
            [binary("tilo-enroll"), "approve-room-host",
             "--identity-root", str(session_dir("team") / "identity-root"),
             "--identity-dir", str(identity_dir("team")),
             "--timeout", "60"],
            team_env,
        )
        approve = subprocess.run(approve_argv, env=approve_env, stdout=out,
                                 stderr=subprocess.STDOUT, timeout=120)
        try:
            pair.wait(timeout=90)
        except subprocess.TimeoutExpired:
            pair.kill()
    if approve.returncode != 0 or pair.returncode != 0 or not (root / "device" / "cert.bin").exists():
        raise Fix(
            f"relay enrollment did not complete (approve={approve.returncode}, "
            f"pair={pair.returncode}):\n{tail(log)}",
            f"see {log}; the pairing port {45831}/udp must be free (`ss -ulpn | grep 45831`)",
        )


def write_relay_config() -> None:
    path = relay_config()
    state = relay_dir() / "state"
    state.mkdir(parents=True, exist_ok=True)
    wanted = {
        "identity_root": str(relay_dir() / "identity-root"),
        "state_root": str(state),
        "iroh_listen": f"127.0.0.1:{RELAY_PORT}",
        # A community host is not this identity's Files home peer: it carries
        # no home-peer bundle and admits any certified device to connect,
        # each room gated by its own membership.
        "home_peer_bundle": str(relay_dir() / "no-home-peer.toml"),
        "full_replica_status": str(state / "full-replica-status.json"),
    }
    if not path.exists():
        subprocess.run([binary("tilo-relay"), "--config", str(path), "init"],
                       check=True, capture_output=True, timeout=30)
    text = path.read_text()
    lines = []
    seen = set()
    in_trust_table = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            in_trust_table = stripped == "[trust_policy]"
            if in_trust_table:
                continue
        elif in_trust_table:
            continue
        key = line.split("=", 1)[0].strip()
        if key in wanted and not stripped.startswith("["):
            lines.append(f'{key} = "{wanted[key]}"')
            seen.add(key)
        elif key == "trust_policy":
            continue
        else:
            lines.append(line)
    header = [f'{key} = "{value}"' for key, value in wanted.items() if key not in seen]
    header.append('trust_policy = { kind = "allow_any" }')
    # Top-level keys must precede any table.
    first_table = next((i for i, line in enumerate(lines) if line.startswith("[")), len(lines))
    lines[first_table:first_table] = header
    path.write_text("\n".join(lines) + "\n")


def start_relay(restart: bool = False) -> dict:
    if restart:
        stop("relay")
    endpoint_file = relay_dir() / "state" / "endpoint.json"
    if not running("relay"):
        endpoint_file.unlink(missing_ok=True)
        say("starting the relay")
        spawn("relay", [binary("tilo-relay"), "--config", str(relay_config()), "run"],
              {**os.environ, "TILO_RELAY_LOG": os.environ.get("FEEDBACK_DEV_RELAY_LOG", "tilo_relay=info,warn")}, relay_dir() / "log")
    for _ in range(120):
        if endpoint_file.exists():
            endpoint = json.loads(endpoint_file.read_text())
            state = load_state()
            if state.get("relay_endpoint") != endpoint:
                state["relay_endpoint"] = endpoint
                save_state(state)
            return endpoint
        if running("relay") is None:
            raise Fix(f"the relay exited while starting:\n{tail(relay_dir() / 'log')}",
                      f"see {relay_dir() / 'log'}")
        time.sleep(0.5)
    raise Fix("the relay did not publish its endpoint in 60 s", f"see {relay_dir() / 'log'}")


# ------------------------------------------------------------ community ----

def ensure_room() -> str:
    state = load_state()
    room = state.get("room")
    if room:
        status = control("team", {"op": "room_status", "room": room})
        if "err" not in status:
            return room
    say("creating the Tilo Community public room in the team shell")
    created = answer("team", {"op": "public_room_create", "name": "Tilo Community"})
    room = created["room"]
    if created.get("channel_class") != "public":
        raise Fix(f"the new room is {created.get('channel_class')}, not public", "report this as a bug")
    state["room"] = room
    save_state(state)
    return room


def ensure_hosting(room: str) -> None:
    state = load_state()
    if state.get("hosted_room") == room:
        return
    say("delegating Commenter admission for the room to the relay")
    relay_admin("community", "host", "--room", room,
                "--owner-identity-dir", str(identity_dir("team")), as_team=True)
    state["hosted_room"] = room
    save_state(state)
    start_relay(restart=True)


def ensure_invite(room: str) -> str:
    state = load_state()
    invite = state.get("invite")
    if invite and state.get("invite_room") == room and (
        f"invite {state.get('invite_id')}\tlive" in relay_admin("community", "status", "--room", room)
    ):
        return invite
    say("minting the standing invitation and registering it at the relay")
    minted = answer("team", {"op": "standing_invite", "room": room, "role": "commenter"})
    invite = minted["invite"]
    relay_admin("community", "add-invite", "--room", room, invite)
    state.update(invite=invite, invite_id=minted["invite_id"], invite_room=room)
    save_state(state)
    return invite


def write_community_config(invite: str, path: pathlib.Path | None = None,
                           header: str = "# Written by scripts/feedback-dev/feedback-dev; "
                                         "read by both shells.\n") -> None:
    path = path or DATA / "community.toml"
    text = (
        header +
        "[community]\n"
        f'invite = "{invite}"\n\n'
        "[team]\n"
        f'user_public_key = "{person_id("team")}"\n'
        'label = "Tilo team"\n'
    )
    if not path.exists() or path.read_text() != text:
        path.write_text(text)


def join_community(name: str, room: str, role: str | None = None) -> dict:
    status = answer(name, {"op": "community_status"})
    if status.get("room") != room:
        say(f"the {name} redeems the standing invitation")
        answer(name, {"op": "community_join"})
    for _ in range(120):
        status = answer(name, {"op": "community_status"})
        if (
            status.get("governed")
            and status.get("channel_class") == "public"
            and status.get("role")
            and (role is None or status.get("role") == role)
        ):
            return status
        time.sleep(1.0)
    raise Fix(
        f"the {name} did not become {role or 'a member'} of the public room: {status}",
        f"see {session_dir(name) / 'log'} and {relay_dir() / 'log'}",
    )


def join_reporter(room: str) -> dict:
    return join_community("reporter", room)


def add_teammate(room: str, headless: bool, apps: Apps) -> dict:
    provision("teammate")
    install_apps("teammate", apps)
    start_shell("teammate", headless)
    join_community("teammate", room)
    status = answer("teammate", {"op": "community_status"})
    if status.get("role") != "editor":
        say("the team owner makes the teammate an Editor of the community room")
        answer("team", {"op": "room_grant", "room": room, "person": person_id("teammate"),
                        "role": "editor"})
    return join_community("teammate", room, role="editor")


def open_private_room() -> dict:
    """The reporter's private feedback room with the team, from both ends."""
    reporter_side = answer("reporter", {"op": "community_team_room"})
    answer("team", {"op": "community_direct_room", "person": person_id("reporter"),
                    "label": "Reporter"})
    for _ in range(60):
        team_side = answer("team", {"op": "room_status", "room": reporter_side["room"]})
        if team_side.get("governed") and team_side.get("role"):
            return team_side
        time.sleep(1.0)
    raise Fix(
        f"the team did not join the reporter's private room: {team_side}",
        f"see {session_dir('team') / 'log'} and {relay_dir() / 'log'}",
    )


# ------------------------------------------------------------ #feedback ----
#
# The team's Chat in the community room carries #feedback, marked as the
# feedback channel. Everything here goes through what a person or agent uses:
# the workspace switcher in the top bar, the Applications action that opens
# Chat, and the actions Chat publishes (`add-feedback-channel`, then
# `mark-feedback` on `chat.channel:c_feedback`).

FEEDBACK_CHANNEL = "c_feedback"


def state_dump(name: str) -> dict:
    return control(name, {"op": "state_dump"}).get("state", {})


def active_room(name: str) -> str | None:
    tree = state_dump(name).get("workspace_tree", {})
    desktop = tree.get("desktop", tree)
    for workspace in desktop.get("workspaces", []):
        if workspace.get("id") == desktop.get("active"):
            return workspace.get("room")
    return None


def activate_room(name: str, room: str) -> None:
    """Step through the top bar's workspace switcher until `room` is active:
    its arrows move one workspace back (up) or on (down), without wrapping."""
    for _ in range(12):
        tree = state_dump(name).get("workspace_tree", {})
        desktop = tree.get("desktop", tree)
        rooms = [workspace.get("room") for workspace in desktop.get("workspaces", [])]
        active = next((workspace.get("room") for workspace in desktop.get("workspaces", [])
                       if workspace.get("id") == desktop.get("active")), None)
        if active == room:
            return
        if room not in rooms or active not in rooms:
            time.sleep(0.5)
            continue
        arrow = "down" if rooms.index(room) > rooms.index(active) else "up"
        answer(name, {"op": "click_named", "name": f"topbar_workspace_{arrow}"})
        time.sleep(0.3)
    raise Fix(f"the {name} shell never made room {room} its active workspace",
              f"feedback-dev ctl {name} -- state-dump --pretty")


def app_actions(name: str, query: str) -> list[dict]:
    rows = answer(name, {"op": "actions_enumerate", "query": query}).get("actions", [])
    return [row for row in rows if row.get("provider") == "app-actions"]


def chat_action(name: str, resource: str, action: str, query: str,
                room: str | None = None) -> dict | None:
    """`action` on `resource` as a Chat offers it — the Chat in `room`, when
    one is named."""
    for row in app_actions(name, query):
        if (row.get("resource") == resource and row["id"].endswith("\x1f" + action)
                and (room is None or row.get("room") == room)):
            return row
    return None


def ensure_chat(name: str, room: str, where: str = "the community room") -> None:
    """Chat running in `room` in this shell, opened as a person would."""
    activate_room(name, room)
    def running_here() -> bool:
        apps = answer(name, {"op": "inspect_apps"}).get("apps", [])
        return any(app.get("app_id") == "so.tilo.chat" and app.get("room") == room for app in apps)
    # A room restores the windows it had, Chat among them, soon after start.
    for _ in range(30):
        if running_here():
            return
        time.sleep(1.0)
    say(f"opening Chat in {where} in the {name} shell")
    # The shell indexes its applications in the background from startup.
    for _ in range(120):
        if running_here():
            return
        response = control(name, {"op": "actions_invoke", "provider": "applications",
                                  "id": "so.tilo.chat", "args": {}})
        if "err" not in response:
            break
        time.sleep(1.0)
    else:
        raise Fix(f"the {name} shell never offered Chat: {response['err']}",
                  "install the apps: feedback-dev up --ci-apps RUN (or --worktree-apps)")
    for _ in range(90):
        if running_here():
            return
        time.sleep(1.0)
    raise Fix(f"Chat did not start in the {name} shell", f"grep so.tilo.chat {session_dir(name) / 'log'}")


def invoke_chat(name: str, resource: str, action: str, query: str, room: str | None = None) -> None:
    for _ in range(180):
        row = chat_action(name, resource, action, query, room)
        if row:
            answer(name, {"op": "actions_invoke", "provider": row["provider"], "id": row["id"], "args": {}})
            return
        time.sleep(1.0)
    raise Fix(f"Chat in the {name} shell does not offer `{action}` on {resource}",
              f"feedback-dev ctl {name} -- actions list feedback")


def until_chat_offers(name: str, resource: str, action: str, query: str, what: str) -> None:
    for _ in range(180):
        if chat_action(name, resource, action, query):
            return
        time.sleep(1.0)
    raise Fix(f"{what} did not happen in the {name} shell", f"see {session_dir(name) / 'log'}")


def feedback_channel_state() -> tuple[str | None, list[str]]:
    """What the team's Chat says about #feedback, once it has said anything:
    `marked`, `unmarked` or `None` (no such channel), and the Chat
    workspaces it could be added to."""
    channel = f"chat.channel:{FEEDBACK_CHANNEL}"
    for _ in range(180):  # Chat publishes its actions once it has drawn
        rows = app_actions("team", "feedback")
        workspaces = [row["resource"] for row in rows if row["id"].endswith("\x1fadd-feedback-channel")]
        if not workspaces and not any(row.get("resource") == channel for row in rows):
            time.sleep(1.0)
            continue
        for row in rows:
            if row.get("resource") == channel and row["id"].endswith("\x1funmark-feedback"):
                return "marked", workspaces
        for row in rows:
            if row.get("resource") == channel and row["id"].endswith("\x1fmark-feedback"):
                return "unmarked", workspaces
        return None, workspaces
    raise Fix("the team's Chat never published its actions",
              "feedback-dev ctl team -- actions list feedback")


def ensure_feedback_channel(room: str) -> None:
    ensure_chat("team", room)
    channel = f"chat.channel:{FEEDBACK_CHANNEL}"
    state, workspaces = feedback_channel_state()
    if state is None:
        if not workspaces:
            raise Fix("the team's Chat offers no `add-feedback-channel`",
                      "feedback-dev ctl team -- actions list feedback")
        say("the team adds #feedback to the community room's Chat")
        invoke_chat("team", workspaces[0], "add-feedback-channel", "feedback")
        for _ in range(180):
            state, _ = feedback_channel_state()
            if state is not None:
                break
            time.sleep(1.0)
        else:
            raise Fix("#feedback never appeared in the team's Chat",
                      f"see {session_dir('team') / 'log'}")
    if state == "unmarked":
        say("the team marks #feedback as the feedback channel")
        invoke_chat("team", channel, "mark-feedback", "feedback")
        until_chat_offers("team", channel, "unmark-feedback", "feedback", "marking #feedback")


def reporter_sees_feedback(room: str) -> None:
    """The reporter's Chat reads #feedback and may post there, as a Commenter."""
    ensure_chat("reporter", room)
    until_chat_offers("reporter", f"chat.channel:{FEEDBACK_CHANNEL}", "post", "feedback",
                      "the reporter seeing #feedback")


def chat_tree(name: str) -> str:
    """The semantic tree of `name`'s Chat, as text."""
    apps = answer(name, {"op": "inspect_apps"}).get("apps", [])
    peers = [app["peer"] for app in apps if app.get("app_id") == "so.tilo.chat"]
    if not peers:
        return ""
    result = subprocess.run(
        [sys.executable, str(pathlib.Path(__file__).resolve()), "ctl", name, "--",
         "inspect", "tree", str(peers[0]), "--depth", "64"],
        capture_output=True, text=True, timeout=60,
    )
    return result.stdout


def open_feedback(name: str, room: str) -> None:
    ensure_chat(name, room)
    invoke_chat(name, f"chat.channel:{FEEDBACK_CHANNEL}", "open", "feedback")


SEP = "\x1f"


def directory_message(name: str, text: str, timeout: float = 90.0) -> tuple[str, str, str]:
    """The message carrying `text`, as `name`'s Chat directory names it to a
    search: its publisher, the directory revision and the message id."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        for row in app_actions(name, text):
            fields = row["id"].split(SEP)
            if len(fields) == 5 and fields[0] == "directory" and fields[3].startswith("chat.message:"):
                return fields[1], fields[2], fields[3].removeprefix("chat.message:")
        time.sleep(1.0)
    raise Fix(f"a search in the {name}'s Chat never found the message {text!r}",
              f"feedback-dev ctl {name} -- actions list {text.split()[0]!r}")


def act_on(name: str, text: str, resource: str, action: str, args: dict, what: str) -> None:
    """`name` runs `action` on `resource` — the message a search for `text`
    finds, or a part of it — as the palette offers it."""
    last = None
    for _ in range(90):
        peer, revision, _ = directory_message(name, text)
        response = control(name, {"op": "actions_invoke", "provider": "app-actions",
                                  "id": SEP.join(("directory", peer, revision, resource, action)),
                                  "args": args})
        if "err" not in response:
            say(f"check: the {name} {what}")
            return
        last = response["err"]
        # The owner resolves an action the search did not list on demand, and
        # an earlier change moves the directory's revision on.
        if last.get("code") != "unknown_action":
            break
        time.sleep(1.0)
    raise Fix(f"the {name} could not {what}: [{last.get('code')}] {last.get('message')}",
              f"see {session_dir(name) / 'log'}")


def until_everyone_sees(people: list[str], what: str, seen) -> None:
    waiting = set(people)
    for _ in range(120):
        for name in sorted(waiting):
            if seen(name):
                say(f"check: the {name} sees {what}")
                waiting.discard(name)
        if not waiting:
            return
        time.sleep(1.0)
    raise Fix(f"{what} never showed for: {', '.join(sorted(waiting))}",
              f"grep 'not kept\\|did not complete\\|refused' {DATA}/*/log")


def shell_action(name: str, action: str, args: dict | None = None) -> None:
    answer(name, {"op": "actions_invoke", "provider": "actions", "id": action, "args": args or {}})


def remark_state(name: str) -> dict:
    return state_dump(name).get("chrome", {}).get("remark", {})


def until_remark(name: str, what: str, done) -> dict:
    for _ in range(120):
        state = remark_state(name)
        if state.get("sending", {}).get("state") == "failed":
            raise Fix(f"the {name}'s remark failed while {what}: {state.get('sending')}",
                      f"see {session_dir(name) / 'log'}")
        if done(state):
            return state
        time.sleep(1.0)
    raise Fix(f"the {name}'s remark never finished {what}: {json.dumps(state)[:400]}",
              f"feedback-dev ctl {name} -- state-dump --pretty")


def home_room(name: str) -> str:
    """The first workspace of `name` that is neither the community room nor
    its private room with the team: the person's own."""
    state = load_state()
    tree = state_dump(name).get("workspace_tree", {})
    for workspace in tree.get("desktop", tree).get("workspaces", []):
        room = workspace.get("room")
        if room and room not in (state.get("room"), state.get("private_room")):
            return room
    raise Fix(f"the {name} has no workspace of its own", f"feedback-dev ctl {name} -- state-dump --pretty")


def send_recording(name: str, text: str) -> None:
    """What the hand test does with Super+M and "Use the last 2 minutes": in
    a workspace of one's own, say something about the app in front, with the
    recording of what just happened, reviewed, to the community's #feedback."""
    home = home_room(name)
    activate_room(name, home)
    shell_action(name, "feedback.recent-buffer.set", {"enabled": True})
    ensure_chat(name, home, "their own workspace")
    # The buffer keeps what happens in the rooms the Recorder holds: the
    # active one, once it has joined it.
    for _ in range(60):
        if home in state_dump(name).get("chrome", {}).get("feedback", {}).get("rooms", []):
            break
        time.sleep(1.0)
    else:
        raise Fix(f"the Recorder never joined the {name}'s own workspace",
                  f"feedback-dev ctl {name} -- feedback status")
    invoke_chat(name, "chat.channel:c_general", "open", "open", home)
    time.sleep(2.0)
    shell_action(name, "remark.open")
    until_remark(name, "opening on the app in front", lambda state: state.get("context"))
    shell_action(name, "remark.pick.done")
    shell_action(name, "remark.text.set", {"text": text})
    shell_action(name, "remark.record.recent")
    until_remark(name, "keeping the recording",
                 lambda state: state.get("flow", {}).get("state") == "attached")
    shell_action(name, "remark.review.open")
    until_remark(name, "walking through the recording",
                 lambda state: (state.get("review") or {}).get("steps"))
    shell_action(name, "remark.review.close")
    shell_action(name, "remark.destination.set", {"id": "community"})
    shell_action(name, "remark.send")
    until_remark(name, "sending", lambda state: (state.get("last") or {}).get("state") == "sent")
    say(f"check: the {name} sent a remark with its recording to #feedback")


def replay_state(name: str) -> dict:
    return state_dump(name).get("chrome", {}).get("replay") or {}


def cmd_check(_: argparse.Namespace) -> None:
    """The hand test, done by machine: the reporter posts in #feedback and
    everyone in the room sees it; the team votes, the teammate (an Editor)
    replies and sets its status, and everyone sees where it stands; the
    reporter sends a remark with a recording, and the team replays it."""
    state = load_state()
    room = state.get("room")
    if not room or not running("reporter") or not running("team"):
        raise Fix("the community is not up", "feedback-dev up --headless --ci-apps RUN")
    people = [name for name in ("reporter", "team", "teammate") if running(name)]
    triager = "teammate" if "teammate" in people else "team"
    for name in people:
        open_feedback(name, room)
    stamp = time.strftime("%H:%M:%S")
    report = f"feedback-dev check {stamp}: Send does nothing on a trailing comma"
    say("the reporter posts a report in #feedback")
    row = None
    for _ in range(60):
        row = chat_action("reporter", f"chat.channel:{FEEDBACK_CHANNEL}", "post", "feedback")
        if row:
            break
        time.sleep(1.0)
    if not row:
        raise Fix("the reporter's Chat offers no `post` in #feedback", "feedback-dev ctl reporter -- actions list feedback")
    answer("reporter", {"op": "actions_invoke", "provider": row["provider"], "id": row["id"],
                        "args": {"value": report}})
    until_everyone_sees(people, "the report", lambda name: report in chat_tree(name))

    _, _, message = directory_message("team", report)
    reply = f"feedback-dev check {stamp}: seen it, on it"
    act_on("team", report, f"chat.message:{message}", "vote", {}, "votes for the report")
    act_on(triager, report, f"chat.message:{message}", "reply", {"value": reply},
           "replies in the report's thread")
    act_on(triager, report, f"chat.message:{message}", "set-status", {"status": "planned"},
           "sets the report's status to planned")
    standing = f"{report} (1 vote, 1 reply, Planned)"
    until_everyone_sees(people, "the vote, the reply and the status",
                        lambda name: standing in chat_tree(name))
    until_everyone_sees(people, "what the reply says",
                        lambda name: any(row["id"].startswith("directory" + SEP)
                                         for row in app_actions(name, reply)))

    remark = f"feedback-dev check {stamp}: a recording of what just happened"
    send_recording("reporter", remark)
    until_everyone_sees([name for name in people if name != "reporter"], "the remark",
                        lambda name: remark in chat_tree(name))
    _, _, recorded = directory_message("team", remark)
    act_on("team", remark, f"chat.attachment:{recorded}", "replay", {}, "replays the recording")
    for _ in range(90):
        replay = replay_state("team")
        if replay.get("steps"):
            say(f"check: the team replays the recording ({len(replay['steps'])} steps)")
            break
        time.sleep(1.0)
    else:
        raise Fix(f"the team's replay never loaded the recording: {json.dumps(replay_state('team'))[:400]}",
                  f"see {session_dir('team') / 'log'}")
    shell_action("team", "replay.close")
    say("check: ok — the report reached everyone; its vote, reply and status did too; "
        "the team replayed the reporter's recording")


