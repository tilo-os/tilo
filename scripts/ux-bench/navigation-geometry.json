{
  "name": "Desktop navigation geometry",
  "goal": "Read the current workspace and distinguish the controls for navigation",
  "viewport": [
    1280,
    800
  ],
  "budget": {
    "clicks": 0,
    "keys": 0
  },
  "steps": [
    {
      "op": "checkpoint",
      "name": "navigation",
      "checks": [
        {
          "kind": "visible",
          "target": "semantic:topbar:workspace-settings"
        },
        {
          "kind": "target_size",
          "target": "semantic:topbar:workspace-settings",
          "min": [
            24,
            24
          ]
        },
        {
          "kind": "target_size",
          "target": "semantic:topbar:profile",
          "min": [
            24,
            24
          ]
        },
        {
          "kind": "aligned",
          "first": "semantic:topbar:profile",
          "second": "semantic:topbar:workspace-settings",
          "axis": "y",
          "tolerance": 1
        },
        {
          "kind": "no_overlap",
          "first": "semantic:topbar:workspace-settings",
          "second": "semantic:topbar:center:clock"
        },
        {
          "kind": "no_overlap",
          "first": "semantic:topbar:profile",
          "second": "semantic:topbar:quick-settings"
        }
      ]
    }
  ]
}
