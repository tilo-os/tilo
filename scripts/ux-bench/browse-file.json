{
  "name": "Find and open a document in Files",
  "goal": "Starting in Files, select Document-000.txt and open the intended document",
  "fixture": "files",
  "viewport": [
    1280,
    800
  ],
  "budget": {
    "clicks": 2,
    "keys": 2
  },
  "steps": [
    {
      "op": "checkpoint",
      "name": "files",
      "checks": [
        {
          "kind": "state",
          "pointer": "/tab_titles/0",
          "equals": "Files"
        },
        {
          "kind": "visible",
          "target": "semantic:Document-000.txt"
        }
      ]
    },
    {
      "op": "input",
      "action": {
        "click_at": [
          590,
          235
        ]
      }
    },
    {
      "op": "input",
      "action": {
        "key": "Enter"
      }
    },
    {
      "op": "wait_state",
      "pointer": "/tab_titles/1",
      "equals": "Document-000.txt",
      "timeout_ms": 2000
    },
    {
      "op": "checkpoint",
      "name": "document-open",
      "checks": [
        {
          "kind": "state",
          "pointer": "/tab_titles/1",
          "equals": "Document-000.txt"
        }
      ]
    }
  ]
}
