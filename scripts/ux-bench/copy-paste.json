        "value": "Fixture document 0\n",
        "text_selection": [0, 19]
      }}
    ]},
    {"op": "input", "action": {"key": "c"}},
    {"op": "input", "action": {"modifiers": []}},
    {"op": "input", "action": {"click_named": "semantic:Document-001.txt"}},
