    {"op": "wait_state", "pointer": "/tab_titles/1", "equals": "Document-001.txt", "timeout_ms": 2000},
    {"op": "input", "action": {"click_named": "semantic:Document-001.txt"}},
    {"op": "input", "action": {"modifiers": ["ctrl"]}},
