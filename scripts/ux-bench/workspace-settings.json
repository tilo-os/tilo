{
  "name": "Rename a workspace",
  "goal": "Reach workspace settings, change the name, and verify the desktop reflects it",
  "viewport": [
    1280,
    800
  ],
  "budget": {
    "clicks": 2,
    "keys": 8
  },
  "steps": [
    {
      "op": "input",
      "action": {
        "click_named": "semantic:topbar:workspace-settings"
      }
    },
    {
      "op": "checkpoint",
      "name": "settings",
      "checks": [
        {
          "kind": "visible",
          "target": "semantic:Workspace settings"
        }
      ]
    },
    {
      "op": "input",
      "action": {
        "click_at": [
          950,
          305
        ]
      }
    },
    {
      "op": "input",
      "action": {
        "modifiers": [
          "ctrl"
        ]
      }
    },
    {
      "op": "input",
      "action": {
        "key": "a"
      }
    },
    {
      "op": "input",
      "action": {
        "modifiers": []
      }
    },
    {
      "op": "input",
      "action": {
        "type": "Bench"
      }
    },
    {
      "op": "input",
      "action": {
        "key": "Enter"
      }
    },
    {
      "op": "input",
      "action": {
        "key": "Escape"
      }
    },
    {
      "op": "checkpoint",
      "name": "renamed",
      "checks": [
        {
          "kind": "state",
          "pointer": "/active_workspace",
          "equals": "Bench"
        },
        {
          "kind": "visible",
          "target": "semantic:topbar:workspace-settings"
        }
      ]
    }
  ]
}
