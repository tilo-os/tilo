{
  "name": "Quick settings root geometry",
  "goal": "Open quick settings and read its title, tiles and controls as one aligned panel",
  "viewport": [1280, 800],
  "budget": {"clicks": 1, "keys": 0},
  "steps": [
    {"op": "input", "action": {"click_named": "semantic:topbar:quick-settings"}},
    {"op": "checkpoint", "name": "quick-settings", "checks": [
      {"kind": "visible", "target": "semantic:Quick Settings"},
      {"kind": "target_size", "target": "semantic:Edit controls", "min": [32, 32]},
      {"kind": "target_size", "target": "semantic:Settings", "min": [32, 32]},
      {"kind": "target_size", "target": "semantic:Power", "min": [32, 32]},
      {"kind": "target_size", "target": "semantic:Night light", "min": [32, 32]},
      {"kind": "target_size", "target": "semantic:Change power profile", "min": [32, 32]},
      {"kind": "aligned", "first": "semantic:Settings", "second": "semantic:Power", "axis": "y", "tolerance": 1},
      {"kind": "gap", "first": "semantic:Settings", "second": "semantic:Privacy", "axis": "x", "min": 10, "max": 15},
      {"kind": "gap", "first": "semantic:Privacy", "second": "semantic:History", "axis": "x", "min": 10, "max": 15},
      {"kind": "no_overlap", "first": "semantic:Edit controls", "second": "semantic:Settings"},
      {"kind": "no_overlap", "first": "semantic:Edit controls", "second": "semantic:Power"},
      {"kind": "aligned", "first": "semantic:Brightness", "second": "semantic:Volume", "axis": "x", "tolerance": 1},
      {"kind": "target_size", "target": "semantic:Brightness", "min": [32, 32]},
      {"kind": "target_size", "target": "semantic:Volume", "min": [32, 32]},
      {"kind": "no_overlap", "first": "semantic:Brightness", "second": "semantic:Volume"},
      {"kind": "no_overlap", "first": "semantic:Volume", "second": "semantic:Night light"},
      {"kind": "gap", "first": "semantic:Night light", "second": "semantic:Change power profile", "axis": "y", "min": 14, "max": 20},
      {"kind": "no_overlap", "first": "semantic:Night light", "second": "semantic:Change power profile"}
    ]}
  ]
}
