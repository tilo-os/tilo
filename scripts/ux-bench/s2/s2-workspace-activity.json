{
  "name": "Workspace activity chip geometry",
  "goal": "Open workspace activity from the top bar and find its view tabs and scope as full-size, aligned chips",
  "viewport": [1280, 800],
  "budget": {"clicks": 1, "keys": 0},
  "steps": [
    {"op": "input", "action": {"click_named": "semantic:topbar:center:clock"}},
    {"op": "checkpoint", "name": "activity", "checks": [
      {"kind": "visible", "target": "semantic:Workspace activity"},
      {"kind": "target_size", "target": "semantic:Explore", "min": [32, 32]},
      {"kind": "target_size", "target": "semantic:Replay", "min": [32, 32]},
      {"kind": "target_size", "target": "semantic:This workspace", "min": [32, 32]},
      {"kind": "target_size", "target": "semantic:All workspaces", "min": [32, 32]},
      {"kind": "aligned", "first": "semantic:Explore", "second": "semantic:Replay", "axis": "y", "tolerance": 1},
      {"kind": "gap", "first": "semantic:Explore", "second": "semantic:Replay", "axis": "x", "min": 4, "max": 8},
      {"kind": "aligned", "first": "semantic:This workspace", "second": "semantic:All workspaces", "axis": "y", "tolerance": 1},
      {"kind": "gap", "first": "semantic:This workspace", "second": "semantic:All workspaces", "axis": "x", "min": 2, "max": 8},
      {"kind": "no_overlap", "first": "semantic:All workspaces", "second": "semantic:Replay"},
      {"kind": "no_overlap", "first": "semantic:Explore", "second": "semantic:Replay"}
    ]}
  ]
}
