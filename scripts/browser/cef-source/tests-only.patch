+class ReentrantCompositionListener final : public NativeEventListener {
+ public:
+  explicit ReentrantCompositionListener(InputMethodController& controller)
+      : controller_(&controller) {}
+
+  void Invoke(ExecutionContext*, Event*) override {
+    if (invoked_) {
+      return;
+    }
+    invoked_ = true;
+    controller_->SetCompositionFromExistingText(Vector<ImeTextSpan>(), 0, 5);
+  }
+
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(controller_);
+    NativeEventListener::Trace(visitor);
+  }
+
+ private:
+  Member<InputMethodController> controller_;
+  bool invoked_ = false;
+};
