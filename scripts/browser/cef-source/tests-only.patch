+// Regression matrix for event handlers changing the edit being completed.
+HTMLInputElement* InputMethodControllerTest::PrepareCompositionMutationTest(
+    const char* event_type,
+    const char* mutation,
+    bool start_composition) {
+  GetDocument().GetSettings()->SetScriptEnabled(true);
+  SetBodyContent(
+      "<input id='sample' value='alpha beta gamma'>"
+      "<input id='other' value='second'>");
+  auto* input = To<HTMLInputElement>(GetElementById("sample"));
+  input->Focus();
+  Controller().SetEditableSelectionOffsets(PlainTextRange(6, 10));
+  if (start_composition) {
+    Controller().SetComposition("preedit", Vector<ImeTextSpan>(), 7, 7);
+    EXPECT_EQ("alpha preedit gamma", input->Value());
+  }
+
+  Element* script = GetDocument().CreateRawElement(html_names::kScriptTag);
+  StringBuilder builder;
+  builder.Append("document.getElementById('sample').addEventListener('");
+  builder.Append(event_type);
+  builder.Append("', event => {");
+  builder.Append(mutation);
+  builder.Append("}, {once:true});");
+  script->SetInnerHTMLWithoutTrustedTypes(builder.ToString());
+  GetDocument().body()->AppendChild(script);
+  UpdateAllLifecyclePhasesForTest();
+  return input;
+}
