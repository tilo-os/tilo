+// An edit may cross script boundaries only while its original target, text,
+// selection and composition still agree. Keep raw positions, not a retained
+// SelectionInDomTree whose DOM version becomes invalid after script mutations.
+class InputMethodController::CompositionEditState {
+  STACK_ALLOCATED();
+
+ public:
+  explicit CompositionEditState(InputMethodController& controller)
+      : controller_(controller),
+        document_(&controller.GetDocument()),
+        target_(document_->FocusedElement()),
+        generation_(controller.composition_generation_) {
+    document_->UpdateStyleAndLayout(DocumentUpdateReason::kInput);
+    editable_ = RootEditableElementOfSelection(controller_.Selection());
+    const SelectionInDomTree& selection =
+        controller_.Selection().GetSelectionInDomTree();
+    anchor_ = selection.Anchor();
+    focus_ = selection.Focus();
+    affinity_ = selection.Affinity();
+    if (editable_)
+      text_ = EditableText();
+  }
+
+  Element* Target() const { return target_; }
+
+  bool RefuseEdit() const {
+    if (controller_.IsAvailable()) {
+      // A focus change can clear the old composition. Its empty retries still
+      // have no authority to delete the newly focused field's selection.
+      if (IsSameComposition() || !controller_.HasComposition()) {
+        controller_.composition_edit_retired_ = true;
+      }
+      // A newer composition or typing command belongs to the handler.
+      if (IsSameComposition()) {
+        TypingCommand::CloseTyping(&controller_.GetFrame());
+      }
+    }
+    return false;
+  }
+
+
+  bool IsSameComposition() const {
+    return controller_.IsAvailable() &&
+           &controller_.GetDocument() == document_ &&
+           controller_.composition_generation_ == generation_;
+  }
+
+  bool IsUnchanged() const {
+    if (!IsSameComposition() || !target_ || !editable_)
+      return false;
+    document_->UpdateStyleAndLayout(DocumentUpdateReason::kInput);
+    if (!IsSameComposition())
+      return false;
+    if (document_->FocusedElement() != target_ || !editable_->isConnected() ||
+        RootEditableElementOfSelection(controller_.Selection()) != editable_) {
+      return false;
+    }
+    const SelectionInDomTree& selection =
+        controller_.Selection().GetSelectionInDomTree();
+    return selection.Anchor() == anchor_ && selection.Focus() == focus_ &&
+           selection.Affinity() == affinity_ && EditableText() == text_;
+  }
+
+ private:
+  String EditableText() const {
+    return PlainText(
+        EphemeralRange::RangeOfContents(*editable_),
+        TextIteratorBehavior::Builder().SetEmitsOriginalText(true).Build());
+  }
+
+  InputMethodController& controller_;
+  Document* document_;
+  Element* target_;
+  Element* editable_ = nullptr;
+  uint64_t generation_;
+  Position anchor_;
+  Position focus_;
+  TextAffinity affinity_;
+  String text_;
+};
