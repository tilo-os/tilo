<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for tilo-runtime alone: Tilo.entitlements
     plus the two devices it captures for the apps it confines.

     - com.apple.security.device.camera and
       com.apple.security.device.audio-input: a confined app never touches a
       camera or microphone itself; it asks this runtime, which asks the
       person (tilo-capture's grants) and captures through AVFoundation.
       The hardened runtime refuses both devices without these keys. macOS
       still asks the person once (TCC), with Info.plist's usage strings.

     Every exception Tilo.entitlements leaves out stays out here too. -->
<plist version="1.0"><dict>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.device.camera</key><true/>
</dict></plist>
