#!/bin/sh
# qOS session entry point, as installed on a host that is not the qOS image.
#
# The display manager execs this; it supervises the compositor. There is nothing
# configurable here on purpose: the path below is the one the package owns,
# and no environment variable, config file or argument can redirect it. The
# developer counterpart that *can* be redirected is `qos-session-dev`, in the
# separate `-devel` subpackage, so a machine that never installed that
# subpackage has no way to start a session from a binary of someone's
# choosing.
set -eu

QOS_SHELL=/usr/bin/qos-shell
SYSTEMCTL=/usr/bin/systemctl
SYSTEMD_CAT=/usr/bin/systemd-cat
DBUS_UPDATE=/usr/bin/dbus-update-activation-environment
SESSION_TARGET=qos-graphical-session.target
target_started=0
environment_imported=0
shell_pid=

# `DesktopNames=nirios` in the .desktop entry selects nirios-portals.conf;
# display managers export it as XDG_CURRENT_DESKTOP, but not every one does,
# so make it certain.
XDG_CURRENT_DESKTOP=nirios
XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

if [ ! -x "$QOS_SHELL" ]; then
    echo "qos-session: $QOS_SHELL is missing or not executable" >&2
    exit 1
fi

if [ ! -x "$SYSTEMCTL" ]; then
    echo "qos-session: $SYSTEMCTL is missing or not executable" >&2
    exit 1
fi

if [ ! -x "$SYSTEMD_CAT" ]; then
    echo "qos-session: $SYSTEMD_CAT is missing or not executable" >&2
    exit 1
fi

if [ ! -x "$DBUS_UPDATE" ]; then
    echo "qos-session: $DBUS_UPDATE is missing or not executable" >&2
    exit 1
fi

stop_target() {
    if [ "$target_started" = 1 ]; then
        "$SYSTEMCTL" --user stop "$SESSION_TARGET" >/dev/null 2>&1 || true
        target_started=0
    fi
    if [ "$environment_imported" = 1 ]; then
        # D-Bus has no unset operation, so empty its qOS identity before
        # removing every imported selector from the user manager. Do this
        # even when starting the session target failed part-way through.
        "$DBUS_UPDATE" --systemd \
            XDG_CURRENT_DESKTOP= XDG_SESSION_TYPE= >/dev/null 2>&1 || true
        "$SYSTEMCTL" --user unset-environment \
            DISPLAY WAYLAND_DISPLAY XAUTHORITY DESKTOP_SESSION GDMSESSION \
            XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
            >/dev/null 2>&1 || true
        environment_imported=0
    fi
}

forward_signal() {
    signal=$1
    status=$2
    trap - HUP INT TERM
    if [ -n "$shell_pid" ] && kill -0 "$shell_pid" 2>/dev/null; then
        kill "-$signal" "$shell_pid" 2>/dev/null || true
        wait "$shell_pid" 2>/dev/null || true
    fi
    exit "$status"
}

trap stop_target EXIT
trap 'forward_signal HUP 129' HUP
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM

# A systemd user manager and the D-Bus activation environment survive desktop
# switches. Remove display values from the manager that just ended, then put
# qOS's desktop identity in both activation paths before owning the standard
# graphical-session targets for exactly as long as this compositor lives.
# xdg-desktop-portal refuses activation unless graphical-session.target is
# active and otherwise may retain the previous desktop's backend selection.
#
# The D-Bus update is also relevant to non-systemd services such as GCR's
# SystemPrompter. It deliberately does not publish DISPLAY/WAYLAND_DISPLAY:
# the compositor creates its socket after this wrapper starts, and the
# activation API cannot safely guess or remove the previous socket value.
"$SYSTEMCTL" --user unset-environment \
    DISPLAY WAYLAND_DISPLAY XAUTHORITY DESKTOP_SESSION GDMSESSION \
    XDG_SESSION_DESKTOP >/dev/null 2>&1 || true
"$DBUS_UPDATE" --systemd XDG_CURRENT_DESKTOP XDG_SESSION_TYPE >/dev/null
environment_imported=1
"$SYSTEMCTL" --user import-environment \
    XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
"$SYSTEMCTL" --user start "$SESSION_TARGET"
target_started=1

# --host-desktop-session is the package-owned, distro-neutral declaration that
# this is a session added to an existing Linux installation. It keeps device
# identity material in this login's XDG data tree and selects the reduced
# identity-only OOBE. Do not infer this from distro files or XDG desktop names:
# neither says how this binary was installed.
#
# --backend drm: this is a real login session on a seat of its own, driving
# KMS directly. The winit backend (the default) is for running nested inside
# another compositor and would have nothing to attach to here.
#
# --firstboot: on the qOS image a systemd unit creates the user's config
# directories once before the session. A host has no such unit, so the wrapper
# performs that idempotent preparation and then falls through to the
# compositor. Identity creation itself stays interactive in trusted compositor
# chrome; it is never minted silently by this wrapper.
# Keep the wrapper alive so normal logout stops the session target and a
# display-manager termination signal reaches the compositor before cleanup.
set +e
# GDM does not provide a portable per-session log file.  Route both streams
# directly to journald under one stable identifier so a grey screen or early
# crash remains diagnosable with `journalctl --user -t qos-session` after the
# user returns to another desktop.  systemd-cat execs the command and relays
# its exit status/signals; disabling level-prefix parsing prevents app output
# from forging journal priorities.
"$SYSTEMD_CAT" --identifier=qos-session --level-prefix=false \
    "$QOS_SHELL" --host-desktop-session --firstboot --backend drm "$@" &
shell_pid=$!
wait "$shell_pid"
status=$?
set -e
shell_pid=
exit "$status"
