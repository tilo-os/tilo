#!/bin/sh
# Tilo *developer* session entry point.
#
# Starts the compositor named in ~/.config/tilo/dev-session instead of the one
# the package installed, so "edit, build, log out, log into my own build" does
# not mean reinstalling an RPM and rebooting between every iteration.
#
# That is a real capability — it decides which program runs as someone's login
# session — so it is deliberately kept away from the production path:
#
#   * It lives in a separate subpackage (tilo-session-devel). A machine that
#     never installed that subpackage cannot reach any of this.
#   * It is a separate, differently-named entry in the session picker. The
#     production session never consults a config file at all.
#   * The target must carry the build marker that a compositor only gets from
#     `cargo build -p shell --features dev-session` in a debug profile. So the
#     entry starts *a Tilo compositor someone deliberately built*, not an
#     arbitrary executable — it is not a general run-this-at-login primitive.
#   * The config file, its directory chain, the target binary and *its*
#     directory chain must each be owned by this user or root and be writable
#     by no one else. Anything else refuses.
#   * $HOME, XDG_CONFIG_HOME and the rest of the environment are not consulted;
#     the home directory comes from the passwd database. There is no
#     environment variable that redirects this script.
#
# Every refusal is fatal and loud. Falling back to the installed compositor
# would be worse than failing: you would be testing the wrong binary and the
# session would look like it worked.
set -eu

MARKER='tilo-dev-session-build-marker-v1'
ME=$(id -u)

die() {
    echo "tilo-session-dev: $*" >&2
    echo "tilo-session-dev: refusing to start a session." >&2
    exit 1
}

[ "$ME" -ne 0 ] || die "refusing to run as root"

HOMEDIR=$(getent passwd "$ME" | cut -d: -f6)
[ -n "${HOMEDIR:-}" ] || die "no home directory in the passwd database for uid $ME"
CONF="$HOMEDIR/.config/tilo/dev-session"

# Owned by this user or by root, and writable by neither group nor other.
# `stat -L` so a symlink is judged by what it points at; the chain walk below
# covers the directories the link itself sits in.
path_is_trusted() {
    _info=$(stat -L -c '%u %a' -- "$1" 2>/dev/null) || return 1
    _uid=${_info% *}
    _mode=${_info#* }
    [ "$_uid" -eq "$ME" ] || [ "$_uid" -eq 0 ] || return 1
    # Prefix the stat digits with 0 so POSIX shells parse them as octal. Keep
    # the expansion unquoted inside arithmetic syntax: Dash rejects the Bash-
    # accepted `0"$_mode"` form used here previously.
    [ $(( 0$_mode & 0022 )) -eq 0 ] || return 1
    return 0
}

# Every directory from the given one up to / must be trusted, otherwise
# someone else can swap out what a trusted-looking path resolves to.
chain_is_trusted() {
    _d=$1
    while :; do
        path_is_trusted "$_d" || { echo "tilo-session-dev: untrusted: $_d" >&2; return 1; }
        [ "$_d" != "/" ] || return 0
        _d=$(dirname -- "$_d")
    done
}

[ -f "$CONF" ] || die "$CONF does not exist — write the absolute path of your compositor build into it"
CONF_REAL=$(realpath -e -- "$CONF") || die "cannot resolve $CONF"
path_is_trusted "$CONF_REAL" || die "$CONF_REAL must be owned by you and not writable by anyone else"
chain_is_trusted "$(dirname -- "$CONF_REAL")" || die "the directories above $CONF_REAL are writable by others"

# First non-empty, non-comment line.
TARGET=$(sed -e 's/#.*//' -e 's/[[:space:]]*$//' -- "$CONF_REAL" | grep -m1 -v '^[[:space:]]*$' || true)
[ -n "${TARGET:-}" ] || die "$CONF_REAL names no compositor binary"
case "$TARGET" in
    /*) ;;
    *) die "the path in $CONF_REAL must be absolute, got: $TARGET" ;;
esac

TARGET_REAL=$(realpath -e -- "$TARGET") || die "cannot resolve $TARGET"
[ -f "$TARGET_REAL" ] || die "$TARGET_REAL is not a regular file"
[ -x "$TARGET_REAL" ] || die "$TARGET_REAL is not executable"
path_is_trusted "$TARGET_REAL" || die "$TARGET_REAL must be owned by you and not writable by anyone else"
chain_is_trusted "$(dirname -- "$TARGET_REAL")" || die "the directories above $TARGET_REAL are writable by others"

LC_ALL=C grep -q -a -F -e "$MARKER" -- "$TARGET_REAL" || die \
    "$TARGET_REAL carries no dev-session build marker — build it with
    cargo build -p shell --features dev-session
  (a --release build never carries the marker, by design)"

XDG_CURRENT_DESKTOP=tilo
XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

echo "tilo-session-dev: starting $TARGET_REAL" >&2
# Leave a launch-time attestation for the VM iteration verifier. Fedora's
# hidepid/procptrace policy can prevent a later SSH session owned by this same
# user from resolving or statting /proc/$pid/exe. The wrapper has already
# completed every ownership, mode, and build-marker check above, so recording
# the exact canonical path and digest here is stronger than guessing from a
# process name or a journal line. A later atomic deploy changes the on-disk
# digest without changing this record, which correctly reports that the active
# session is still the previous build.
RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$ME}
ATTEST_DIR="$RUNTIME_DIR/tilo-dev-session"
install -d -m 700 -- "$ATTEST_DIR" || die "cannot prepare developer-session runtime state"
ATTEST_TMP="$ATTEST_DIR/active.$$"
TARGET_SHA256=$(sha256sum -- "$TARGET_REAL" | cut -d' ' -f1)
{
    printf 'pid=%s\n' "$$"
    printf 'path=%s\n' "$TARGET_REAL"
    printf 'sha256=%s\n' "$TARGET_SHA256"
} >"$ATTEST_TMP" || die "cannot record developer-session attestation"
chmod 600 -- "$ATTEST_TMP" || die "cannot protect developer-session attestation"
mv -f -- "$ATTEST_TMP" "$ATTEST_DIR/active" || die "cannot publish developer-session attestation"

# From this point on the developer session has the exact same lifecycle as the
# installed session: graphical targets and services, activation environment,
# logout request channel, signal forwarding, journaling, and cleanup. The
# package-owned runner accepts the canonical path only after this wrapper has
# completed every developer-build security check above.
SELF_REAL=$(realpath -e -- "$0") || die "cannot resolve developer-session wrapper"
SESSION_RUNNER=$(dirname -- "$SELF_REAL")/tilo-session-runner
[ -x "$SESSION_RUNNER" ] || die "the package-owned lifecycle runner is missing"
exec "$SESSION_RUNNER" "$TARGET_REAL" "$@"
