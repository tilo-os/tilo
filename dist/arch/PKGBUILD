# Maintainer: Tilo contributors <tilo@code.tilo.so>
pkgbase=tilo-session
pkgname=(tilo-session tilo-session-devel)
pkgver=0.1.13
pkgrel=1
pkgdesc='Tilo collaborative compositor as a Wayland session'
url='https://code.tilo.so/tilo/tilo'
license=('AGPL-3.0-only')
arch=('x86_64' 'aarch64')
# Arch enables split debug packages through makepkg.conf on some builders.
# The release contract intentionally publishes only the runtime and devel
# packages, so make that output deterministic across builder images.
# Cargo controls Rust LTO. makepkg's separate LTO option injects GCC -flto
# into CFLAGS/CXXFLAGS, which cc-rs also applies to C sources such as ring's.
# rust-lld cannot consume those GCC LTO archives at the final Rust link.
# Keep native dependencies as ELF objects; Cargo's release LTO stays enabled.
# `!strip` keeps the symbol table the release profile leaves in, so a crash
# log names each frame's function.
options=('!debug' '!lto' '!strip')
makedepends=(
  'rustup' 'clang' 'cmake' 'pkgconf' 'capnproto'
  'libxkbcommon' 'wayland' 'seatd' 'libinput' 'systemd-libs' 'libdrm' 'mesa'
  'pipewire' 'dbus' 'fontconfig' 'freetype2' 'harfbuzz' 'fuse3'
  'gstreamer' 'gst-plugins-base-libs'
)
source=("tilo-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "tilo-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo build --release --locked -p launcher -p tilo-unlock-helper
  cargo build --release --locked -p imager --bin imager
  export TILO_UNLOCK_HELPER_PATH=/usr/lib/tilo/tilo-unlock-helper
  cargo build --release --locked -p shell --bin shell --no-default-features
  ./dist/stage-payload.sh target/release "$srcdir/payload"
}

package_tilo-session() {
  depends=(
    'glibc' 'pam' 'vulkan-icd-loader' 'libglvnd' 'libxkbcommon' 'wayland'
    'seatd' 'libinput' 'systemd-libs' 'libdrm' 'mesa' 'pipewire' 'dbus'
    'fontconfig' 'freetype2' 'harfbuzz' 'gstreamer' 'gst-plugins-base-libs'
    'bubblewrap' 'systemd'
    'xwayland-satellite' 'xdg-desktop-portal' 'xdg-dbus-proxy'
    'python'  # tilo-flight-recorder
  )
  optdepends=('vulkan-driver: hardware-appropriate Vulkan ICD' 'greetd: display manager')
  cd "$srcdir/payload"
  install -Dm755 bin/tilo-shell bin/tilo-launcher bin/tilo-import-folders -t "$pkgdir/usr/bin"
  install -Dm755 libexec/tilo-unlock-helper libexec/tilo-session \
    libexec/tilo-session-runner libexec/tilo-flight-recorder \
    libexec/tilo-session-report \
    -t "$pkgdir/usr/lib/tilo"
  sed -i 's#/usr/libexec/tilo-session-runner#/usr/lib/tilo/tilo-session-runner#' \
    "$pkgdir/usr/lib/tilo/tilo-session"
  sed -i 's#/usr/libexec/tilo-flight-recorder#/usr/lib/tilo/tilo-flight-recorder#' \
    "$pkgdir/usr/lib/tilo/tilo-session-runner"
  install -Dm644 pam/tilo-unlock "$pkgdir/etc/pam.d/tilo-unlock"
  install -Dm644 wayland-sessions/tilo.desktop -t "$pkgdir/usr/share/wayland-sessions"
  sed -i 's#/usr/libexec/tilo-session#/usr/lib/tilo/tilo-session#' \
    "$pkgdir/usr/share/wayland-sessions/tilo.desktop"
  install -Dm644 portal/tilo.portal -t "$pkgdir/usr/share/xdg-desktop-portal/portals"
  install -Dm644 portal/tilo-portals.conf -t "$pkgdir/usr/share/xdg-desktop-portal"
  install -Dm644 pipewire/tilo-echo-cancel.conf -t "$pkgdir/usr/share/pipewire"
  install -Dm644 systemd-user/tilo-graphical-session.target -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 license/LICENSE "$pkgdir/usr/share/licenses/tilo-session/LICENSE"
  install -Dm644 applications/tilo-import-folders.desktop "$pkgdir/usr/share/applications/tilo-import-folders.desktop"
}

package_tilo-session-devel() {
  depends=("tilo-session=$pkgver-$pkgrel" 'coreutils' 'grep')
  cd "$srcdir/payload"
  install -Dm755 libexec/tilo-session-dev "$pkgdir/usr/lib/tilo/tilo-session-dev"
  sed -i 's#/usr/libexec/tilo-session-runner#/usr/lib/tilo/tilo-session-runner#' \
    "$pkgdir/usr/lib/tilo/tilo-session-dev"
  install -Dm644 wayland-sessions/tilo-app.desktop -t "$pkgdir/usr/share/wayland-sessions"
  sed -i 's#/usr/libexec/tilo-session-dev#/usr/lib/tilo/tilo-session-dev#g' \
    "$pkgdir/usr/share/wayland-sessions/tilo-app.desktop"
}
