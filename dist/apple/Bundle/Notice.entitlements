<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The notice extension of the app on the iPhone. build.sh writes the signing team for
     __TEAM__ and the app's identifier for __ID__, and adds what a development build carries
     (get-task-allow). The first keychain group is its own; the second is the one place it
     shares with the app, where the device's key for what a push says is kept. -->
<plist version="1.0"><dict>
  <key>application-identifier</key><string>__TEAM__.__ID__.notice</string>
  <key>com.apple.developer.team-identifier</key><string>__TEAM__</string>
  <key>keychain-access-groups</key><array>
    <string>__TEAM__.__ID__.notice</string>
    <string>__TEAM__.__ID__.told</string>
  </array>
</dict></plist>
