<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The iPhone app, as either of the two apps. build.sh writes the app's name, program and
     identifier for __NAME__, __PROGRAM__ and __ID__, then the version, the site, what is shown
     of it, the signing team and what the toolchain says of itself. Where the signature names
     sites whose passkeys the page may use, it lists them as TiloPasskeySites, for the app's
     own check. It puts the two icon files the bundle names beside this file, drawn from
     AppIcon.svg. -->
<plist version="1.0"><dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleDisplayName</key><string>__NAME__</string>
  <key>CFBundleExecutable</key><string>__PROGRAM__</string>
  <key>CFBundleIcons</key><dict>
    <key>CFBundlePrimaryIcon</key><dict>
      <key>CFBundleIconFiles</key><array><string>AppIcon60x60</string></array>
    </dict>
  </dict>
  <key>CFBundleIdentifier</key><string>__ID__</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>__NAME__</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.0.0</string>
  <key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>
  <key>CFBundleVersion</key><string>0.0.0</string>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>__ID__.widget</string>
    <key>CFBundleURLSchemes</key><array><string>tilo-phone</string></array>
  </dict></array>
  <!-- What the page hands the person to keep lands in the app's documents, which Files shows. -->
  <key>LSSupportsOpeningDocumentsInPlace</key><true/>
  <key>UIFileSharingEnabled</key><true/>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>NSSupportsLiveActivities</key><true/>
  <key>MinimumOSVersion</key><string>26.4</string>
  <key>NSAppTransportSecurity</key><dict>
    <!-- A Tilo stack on this computer is plain http on loopback addresses and on names under
         localhost. Everything else is https. -->
    <key>NSAllowsLocalNetworking</key><true/>
    <key>NSExceptionDomains</key><dict>
      <key>localhost</key><dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
        <key>NSIncludesSubdomains</key><true/>
      </dict>
    </dict>
  </dict>
  <key>NSCameraUsageDescription</key><string>__NAME__ uses the camera to scan a pairing code, and shows it to the people in a call you join.</string>
  <key>NSLocalNetworkUsageDescription</key><string>__NAME__ opens a Tilo site on your own network when you name one as its site.</string>
  <key>NSMicrophoneUsageDescription</key><string>__NAME__ listens when you dictate a message or join a call.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>__NAME__ turns what you dictate into words on this iPhone.</string>
  <key>TiloAlone</key><false/>
  <key>TiloApp</key><string></string>
  <key>TiloGroup</key><string>group.__ID__.shared</string>
  <key>TiloShared</key><string>__ID__.shared</string>
  <key>TiloSite</key><string>https://tilo.sh</string>
  <key>TiloTeam</key><string></string>
  <key>UIApplicationSceneManifest</key><dict>
    <key>UIApplicationSupportsMultipleScenes</key><false/>
  </dict>
  <key>UIDeviceFamily</key><array><integer>1</integer></array>
  <key>UILaunchScreen</key><dict/>
  <key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
  <key>UISupportedInterfaceOrientations</key><array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict></plist>
