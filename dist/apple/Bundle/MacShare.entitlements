<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac app's share extension: sandboxed as every app extension, with the one place it
     shares with the app. It reaches no network. -->
<plist version="1.0"><dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.application-groups</key><array>
    <string>__TEAM__.so.tilo.assistant.shell.shared</string>
  </array>
</dict></plist>
