<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tilo Assistant on the iPhone. build.sh writes the signing team for __TEAM__ and the app's
     identifier for __ID__, and adds what a development build carries (get-task-allow). Being
     told while the app is closed takes one more line here, aps-environment, and an App ID
     that may receive pushes: README.md says what that takes. -->
<plist version="1.0"><dict>
  <key>application-identifier</key><string>__TEAM__.__ID__</string>
  <key>com.apple.developer.team-identifier</key><string>__TEAM__</string>
  <key>keychain-access-groups</key><array>
    <string>__TEAM__.__ID__</string>
  </array>
</dict></plist>
