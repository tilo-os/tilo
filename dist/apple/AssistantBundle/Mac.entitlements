<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tilo Assistant on the Mac, in the App Sandbox from the start. -->
<plist version="1.0"><dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- The person's Tilo. The app listens on nothing. -->
  <key>com.apple.security.network.client</key><true/>
  <!-- Dictation. The first key is the sandbox's, the second the hardened runtime's. -->
  <key>com.apple.security.device.microphone</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Files and folders the person picks to attach or authorize for local coding agents. -->
  <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict></plist>
