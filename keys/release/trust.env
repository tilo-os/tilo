# Release signing trust: what an installed system requires of an update.
# Plain KEY=VALUE lines (no quotes, no expansion): shell sources this file,
# tools/signing/release_trust.py and the Rust verifiers parse it. keys/README.md
# explains every value and the ceremony that changes it.
#
# Operational certificates carry the OIDC-issuer extension
# TILO_RELEASE_ISSUER_PREFIX<epoch> and the e-mail identity
# <purpose>@TILO_RELEASE_IDENTITY_DOMAIN. Installed systems accept only the
# current epoch, so raising it revokes every certificate issued before.
TILO_RELEASE_EPOCH=1
TILO_RELEASE_ISSUER_PREFIX=https://signing.tilo.so/release/epoch-
TILO_RELEASE_IDENTITY_DOMAIN=signing.tilo.so
# Longest validity the ceremony issues an operational certificate for, and how
# long before expiry signing refuses one, so a renewal is never a race.
TILO_RELEASE_OPERATIONAL_MAX_DAYS=90
TILO_RELEASE_OPERATIONAL_MIN_REMAINING_DAYS=14
