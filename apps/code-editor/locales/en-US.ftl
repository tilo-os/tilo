## History: what each change did, by field and by verb
code-editor-entry-language = Set the language of { $item } to { $new }
code-editor-project-buffers = Edited a file
code-editor-new-file = Created { $name }
code-editor-new-folder = Created the folder { $name }
code-editor-rename = Renamed { $item } to { $name }
code-editor-move-entry = Moved { $item }
code-editor-delete = Deleted { $item }
code-editor-replace-text = Replaced the text of { $item }
code-editor-record-entry = Added { $name } from disk
code-editor-record-text = Read a file from disk
code-editor-record-target = Started the terminal
code-editor-record-relay-session = Connected the terminal to its session
code-editor-claim-pane = Opened the terminal
code-editor-run = Asked the terminal to run { $command }
code-editor-rerun = Asked the terminal to run a command again
code-editor-rerun-test = Asked the terminal to run { $test } again
code-editor-record-run = Ran { $command } in the terminal
