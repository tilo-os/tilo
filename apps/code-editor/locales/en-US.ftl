## History: what each change did, by field and by verb
code-editor-entry-language = Set the language of { $item } to { $new }
code-editor-project-buffers = Edited a file
code-editor-new-file = Created { $name }
code-editor-new-folder = Created the folder { $name }
code-editor-rename = Renamed { $item } to { $name }
code-editor-move-entry = Moved { $item }
code-editor-delete = Deleted { $item }
code-editor-replace-text = Replaced the text of { $item }
code-editor-record-entry = Added { $name } from disk
code-editor-record-text = Read a file from disk
code-editor-record-target = Started the terminal
code-editor-record-relay-session = Connected the terminal to its session
code-editor-claim-pane = Opened the terminal
code-editor-run = Asked the terminal to run { $command }
code-editor-rerun = Asked the terminal to run a command again
code-editor-rerun-test = Asked the terminal to run { $test } again
code-editor-record-run = Ran { $command } in the terminal

## Code help: the language server behind suggestions, problems and go to definition
code-editor-code-help-unavailable = { $language }: code help unavailable
code-editor-code-help-unavailable-any = Code help unavailable
code-editor-code-help-description = Shows why, and lets you try again
code-editor-code-help-title = Code help is unavailable
code-editor-code-help-not-installed = { $server } isn't installed on this computer. Suggestions, problems and go to definition come from it.
code-editor-code-help-install-rust = To install it, run “rustup component add rust-analyzer” in a terminal, then try again.
code-editor-code-help-install = Install { $server } with your system's package manager, then try again.
code-editor-code-help-stopped = { $server } stopped. Suggestions, problems and go to definition come from it.
code-editor-code-help-failed = { $server } couldn't start. Suggestions, problems and go to definition come from it.
code-editor-code-help-try-again = Try again
code-editor-code-help-copy-details = Copy details
code-editor-code-help-close = Close
