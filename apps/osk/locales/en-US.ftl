# On-screen keyboard.

osk-emoji-key = Emoji
osk-emoji-panel = Emoji
osk-emoji-search = Search emoji
osk-emoji-recent = Recently used
osk-emoji-no-results = No emoji found
# The key that leaves the emoji panel for the letter keys.
osk-emoji-letters = ABC
osk-emoji-letters-name = Back to letters
osk-emoji-delete = Delete
osk-emoji-end-search = Back to all emoji
osk-emoji-tones-hint = Long press for skin tones
# A suggestion chip that inserts an emoji; $name is the emoji's name.
osk-emoji-insert = Insert { $name }
# An emoji in a skin tone: "thumbs up, medium skin tone".
osk-emoji-toned = { $name }, { $tone }
osk-emoji-tone-light = light skin tone
osk-emoji-tone-medium-light = medium-light skin tone
osk-emoji-tone-medium = medium skin tone
osk-emoji-tone-medium-dark = medium-dark skin tone
osk-emoji-tone-dark = dark skin tone
