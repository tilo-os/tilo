## The resource and its verbs.

db-client-workspace = Database
db-client-workspace-add-connection = Add connection
db-client-workspace-remove-connection = Remove saved connection
db-client-workspace-save-query = Save query
db-client-workspace-remove-query = Remove saved query

## What the client does on a server.

db-client-effects-query = Run SQL
db-client-effects-connect = Connect
db-client-effects-run = Run saved query
db-client-effects-new-connection = New connection
db-client-effects-focus-database = Show database
db-client-effects-focus-schema = Show schema
db-client-effects-browse = Browse rows
db-client-effects-show-result = Show query result
db-client-effects-read-result = Read query result
db-client-effects-export-csv = Export CSV
db-client-effects-begin = Begin transaction
db-client-effects-commit = Commit transaction
db-client-effects-rollback = Roll back transaction
db-client-effects-rerun = Run historical query
