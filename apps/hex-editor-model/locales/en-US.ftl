## The resource and its verbs.

hex-editor-document = Hex document
hex-editor-document-load = Load file
hex-editor-document-insert-bytes = Insert bytes
hex-editor-document-overwrite-bytes = Replace bytes
hex-editor-document-delete-bytes = Delete bytes
hex-editor-document-insert-byte = Insert at cursor
hex-editor-document-overwrite-byte = Overwrite at cursor
hex-editor-document-delete-selection = Delete selection
hex-editor-document-delete-byte = Delete byte
