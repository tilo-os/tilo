{"manifest_version": 3, "name": "Clipper", "version": "1.0",
 "permissions": ["scripting"],
 "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
 "background": {"service_worker": "worker.js"},
 "web_accessible_resources": [{"resources": ["panel.html"], "matches": ["http://127.0.0.1/*"]}],
 "content_scripts": [
  {"matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["frames.js"], "all_frames": true},
  {"matches": ["http://127.0.0.1/framed"], "js": ["content.js"]}]}
