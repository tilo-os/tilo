{"manifest_version": 3, "name": "Awaiter", "version": "1.0",
 "permissions": ["scripting"],
 "host_permissions": ["http://127.0.0.1/*"],
 "background": {"service_worker": "worker.js"},
 "content_scripts": [{"matches": ["http://127.0.0.1/*"], "exclude_matches": ["http://127.0.0.1/unscripted*"],
                      "js": ["content.js"], "run_at": "document_idle"}]}
