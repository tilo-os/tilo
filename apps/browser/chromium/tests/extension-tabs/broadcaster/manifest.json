{"manifest_version": 3, "name": "Broadcaster", "version": "1.0",
 "permissions": ["scripting"],
 "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
 "background": {"service_worker": "worker.js"},
 "content_scripts": [{"matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["content.js"], "all_frames": true}]}
