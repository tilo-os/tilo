{"manifest_version": 3, "name": "Tally", "version": "1.0",
 "action": {"default_title": "Tally"},
 "permissions": ["declarativeNetRequest", "activeTab", "scripting"],
 "host_permissions": ["<all_urls>"],
 "background": {"service_worker": "worker.js"},
 "web_accessible_resources": [
   {"resources": ["noop.js"], "matches": ["<all_urls>"], "use_dynamic_url": true},
   {"resources": ["standin.js"], "matches": ["<all_urls>"]}],
 "declarative_net_request": {"rule_resources": [{"id": "ads", "enabled": true, "path": "rules.json"}]}}
