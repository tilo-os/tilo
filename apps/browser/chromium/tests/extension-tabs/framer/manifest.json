{"manifest_version": 3, "name": "Framer", "version": "1.0",
 "permissions": ["scripting"],
 "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
 "background": {"service_worker": "worker.js"},
 "content_scripts": [{"matches": ["http://127.0.0.1/*", "http://localhost/*"], "exclude_matches": ["*://*/unmatched"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}]}
