{"manifest_version": 3, "name": "Framer", "version": "1.0",
 "permissions": ["scripting"],
 "host_permissions": ["http://127.0.0.1/*"],
 "background": {"service_worker": "worker.js"},
 "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}]}
