        },
        {
          "path": "reports.*.decision",
          "owner": "report",
          "title": "The decision that settled it",
          "stored": "value",
          "type": {
            "option": "text"
          }
        },
        {
          "path": "decisions",
          "owner": "moderation",
          "title": "Decisions",
          "stored": "keyed",
          "type": {
            "collection": {
              "named": "Decision"
            }
          },
          "readonly": true
        },
        {
          "path": "decisions.*.id",
          "owner": "decision",
          "title": "Id",
          "stored": "value",
          "type": "text",
          "readonly": true
        },
        {
          "path": "decisions.*.person",
          "owner": "decision",
          "title": "Person",
          "stored": "value",
          "type": "actor"
        },
        {
          "path": "decisions.*.reports",
          "owner": "decision",
          "title": "The reports it settles",
          "stored": "value",
          "type": {
            "list": "text"
          }
        },
        {
          "path": "decisions.*.outcome",
          "owner": "decision",
          "title": "Outcome",
          "stored": "value",
          "type": {
            "named": "Outcome"
          }
        },
        {
          "path": "decisions.*.until_ms",
          "owner": "decision",
