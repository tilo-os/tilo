{
  "resources": [
    {
      "kind": "tilo.moderation",
      "label": "Moderation",
      "version": 2,
      "verbs": [
        {
          "id": "report-message",
          "label": "Report message",
          "description": "Tells the workspace's moderators that this message, and its author, should not be here.",
          "kind": "undoable",
          "params": [
            {
              "name": "message",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "author",
              "required": true,
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "person": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "person"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "agent": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "agent"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "bot": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "bot"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "name": "reason",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "report-person",
          "label": "Report person",
          "description": "Tells the workspace's moderators that this person is misbehaving.",
          "kind": "undoable",
          "params": [
            {
              "name": "person",
              "required": true,
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "person": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "person"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "agent": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "agent"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "bot": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "bot"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "name": "reason",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "type": "text"
            }
          ]
        },
        {
          "id": "decide-reports",
          "label": "Decide on a report",
          "description": "Decide on a person.  Resources what was done about a person and why, settling the reports named.",
          "kind": "undoable",
          "params": [
            {
              "name": "id",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "person",
              "required": true,
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "person": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "person"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "agent": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "agent"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "bot": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "bot"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "name": "reports",
              "required": true,
              "schema": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "list": "text"
              }
            },
            {
              "name": "ruling",
              "required": true,
              "schema": {
                "type": "object",
                "required": [
                  "outcome",
                  "reasoning"
                ],
                "properties": {
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "no-action",
                      "restrict",
                      "ban"
                    ],
                    "description": "What a decision does to the person."
                  },
                  "until_ms": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "reasoning": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "reverted": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "app",
                        "record",
                        "run",
                        "changes"
                      ],
                      "properties": {
                        "app": {
                          "type": "string"
                        },
                        "record": {
                          "type": "string"
                        },
                        "run": {
                          "type": "string",
                          "description": "The history run the moderation agent's undo ran in."
                        },
                        "changes": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295,
                          "description": "How many of the person's changes it took back."
                        }
                      },
                      "additionalProperties": false,
                      "description": "A resource whose changes by the person a decision took back, and the run that did it, so overturning can take the take-back back."
                    }
                  }
                },
                "additionalProperties": false,
                "description": "What was decided about a person, and why."
              },
              "type": {
                "named": "Ruling"
              }
            }
          ],
          "field": "moderation"
        },
        {
          "id": "overturn-decision",
          "label": "Overturn a decision",
          "description": "Marks a decision as overturned by a Moderator, who lifts its restriction or ban and brings back what it took back.",
          "kind": "undoable",
          "params": [
            {
              "name": "decision",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            },
            {
              "name": "note",
              "required": true,
              "schema": {
                "type": "string"
              },
              "type": "text"
            }
          ],
          "field": "moderation"
        },
        {
          "id": "migrate",
          "kind": "undoable",
          "params": []
        }
      ],
      "fields": [
        {
          "path": "reports",
          "owner": "moderation",
          "title": "Reports",
          "stored": "keyed",
          "type": {
            "collection": {
              "named": "Report"
            }
          },
          "readonly": true
        },
        {
          "path": "reports.*.id",
          "owner": "report",
          "title": "Id",
          "stored": "value",
          "type": "text",
          "readonly": true
        },
        {
          "path": "reports.*.reporter",
          "owner": "report",
          "title": "Who reported; the moderation agent for its own heuristics",
          "stored": "value",
          "type": "actor"
        },
        {
          "path": "reports.*.person",
          "owner": "report",
