# tilolang messages: generated from the package's source, commit it. Translate in
# locales/<language>.ftl beside it; edit the words in the source, not here.

d-so-tilo-lang-today = Today

d-2lehvjd6 = Today
    .doc = The day at a glance, over other apps' roots: it draws their resources with their views, so each part keeps its own app's authority.
    .noun = { $count ->
        [one] today
       *[other] todays
    }

d-4z4vz2pv = Morning cleanup
    .doc = Clears the finished tasks, when there are any, and files a note saying how many were done. Both changes are the Tasks and Notes apps' own, asked at their doors: what they did comes back as their records' next readings.

d-a5wukhyd = Today
    .w-show-all = Show all { $n }
