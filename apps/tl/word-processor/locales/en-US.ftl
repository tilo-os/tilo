# tilolang messages: generated from the package's source, commit it. Translate in
# locales/<language>.ftl beside it; edit the words in the source, not here.

d-so-tilo-word-processor = Writer

d-so-tilo-word-processor-keywords = word, docs, document, documents, writer, microsoft word, docx, odt, rtf, libreoffice writer, wordpad, textverarbeitung, dokument, schreiben, brief, lebenslauf, bericht

d-swntfsuf = Document
    .doc = A document: what a person writes, together with anyone else at it.
    .noun = { $count ->
        [one] document
       *[other] documents
    }
    .untitled = Untitled Document

d-76ypz5mr = Title

d-myqdqp23 = Body

d-6dmyhevh = Margin top
    .doc = The page's margins, in points at 100%: where its writing starts and stops.

d-5kuottk3 = Margin right

d-u7wfrpxp = Margin bottom

d-tim24jvi = Margin left

d-5lzglfac = Paper
    .doc = The paper the page is set for, as the panel offers it: A4, Letter or Legal.

d-wdffnjds = Started
    .doc = What the writing was started as: a blank page, a letter, a report, a résumé or meeting notes.

d-4hldj6md = Reactions
    .doc = Who reacted to the document, by emoji: the person and agent each pill in the window's bar stands for, and whose own reaction a press on it takes back.

d-mgawklxl = Notice
    .doc = Why the last thing asked of the document did not happen, such as a file no codec reads; empty while nothing went wrong.

d-mpu4ekps = Chosen
    .doc = The address of the picture the person last chose to write in, and how many times they have chosen one: the page hands both to the editor, which writes the picture in where they are writing.

d-po3yh2xl = Chosen count

d-swntfsuf-filter-margin_top = Margin top

d-swntfsuf-filter-margin_right = Margin right

d-swntfsuf-filter-margin_bottom = Margin bottom

d-swntfsuf-filter-margin_left = Margin left

d-swntfsuf-filter-chosen_count = Chosen count

d-bzk5q6y4 = New document
    .doc = Starts the document over: a blank page, or the Markdown one of the templates starts with.

d-bzk5q6y4-template = Template

d-3wjnu2o4 = Dismiss notice
    .doc = Takes away the reason the page shows over the writing: the person read it.

d-ugxxfqvv = Append paragraph
    .doc = Adds a paragraph of `text` at the end of the document, as Markdown says it.
    .w-the-paragraph-needs-text = The paragraph needs text

d-ugxxfqvv-text = Text

d-wpgddfh2 = Replace body
    .doc = Replaces the whole body from Markdown: headings, lists, pipe tables, emphasis and links.

d-wpgddfh2-markdown = Markdown

d-6ntiozxy = Read the document
    .doc = What the document says as Markdown, ready for an agent or a file.

d-wzulaefw = Replace text
    .doc = Finds `find` in the document and replaces the first of it, or every one, with `replace`.
    .w-name-the-text-to-find = Name the text to find
    .w-the-document-does-not-hold = The document does not hold { $find }

d-wzulaefw-find = Find

d-wzulaefw-replace = Replace

d-wzulaefw-all = All

d-zmtcru23 = Insert table
    .doc = Inserts an empty table of `rows` by `columns` where the writing ends, its head the first row.

d-zmtcru23-rows = Rows

d-zmtcru23-columns = Columns

d-lr3udps3 = Add row
    .doc = Adds a row like the last of the document's first table, under it.
    .w-the-document-holds-no-table = The document holds no table

d-vow4yaii = Add column
    .doc = Adds a cell to every row of the document's first table.
    .w-the-document-holds-no-table = The document holds no table

d-ch3lkk4w = Delete row
    .doc = Deletes a row of the document's first table, counted from its head at 1.

d-ch3lkk4w-row = Row

d-ak6dfurk = Delete column
    .doc = Deletes a column of the document's first table, counted from its left at 1.

d-ak6dfurk-column = Column

d-jwhhfb6k = Delete table
    .doc = Deletes the document's first table and everything it holds.

d-vtp2tggc = Set page margins
    .doc = Sets the page's margins, in points from the page's edges.

d-vtp2tggc-top = Top

d-vtp2tggc-right = Right

d-vtp2tggc-bottom = Bottom

d-vtp2tggc-left = Left

d-jm653hke = Set paper
    .doc = Sets the paper the page is written on: A4, Letter or Legal.

d-jm653hke-paper = Paper

d-5en3y2gh = Generate table of contents
    .doc = Writes a table of contents at the head of the document, each heading a line of it.
    .w-add-headings-first = Add headings first

d-jni6g54e = Set hyperlink
    .doc = Gives the document's words a link at the end of it, reading `text` or the address itself.
    .w-name-the-address-the-link-goes = Name the address the link goes to

d-jni6g54e-target = Target

d-jni6g54e-text = Text

d-exhyhsgg = Insert page break
    .doc = Insert a page break at the end of the writing.

d-fuzgbywh = Paste
    .doc = Puts `markdown` at the end of the writing, as a paste does.
    .w-nothing-to-paste = Nothing to paste

d-fuzgbywh-text = Text

d-fuzgbywh-markdown = Markdown

d-wnzg47ko = Replace selection
    .doc = Replaces the whole body with `text`, as Markdown.

d-wnzg47ko-text = Text

d-c3edrhdp = Insert image
    .doc = Writes a picture in where the person is writing: the person picks the file, and the page hands the address of its content to the editor, which puts it at the caret.

d-c3edrhdp-image = Image

d-hi6fm3p5 = Share image
    .doc = The first picture the document shows, as content another app can take.
    .w-the-document-shows-no-picture = The document shows no picture

d-lxvnkazw = Delete image
    .doc = Deletes the picture whose address is `image`.
    .w-name-the-picture-to-delete = Name the picture to delete

d-lxvnkazw-image = Image

d-5huipo2c = React
    .doc = Adds your reaction with an emoji to the document, or takes it back when you had reacted with it: a press on one of the pills in the bar, or the pick the add button opened.

d-5huipo2c-emoji = Emoji

d-tb4ewbef = Comment
    .doc = Says something about the document, in the thread under its page.
    .did = commented
    .w-write-a-comment-first = Write a comment first

d-tb4ewbef-text = Text

d-efbp2k4u = Open document
    .doc = Opens a file into the document: a Word, OpenDocument, RTF, EPUB or HTML file read by the device's codecs as the Markdown the editor shows, Markdown as it stands, and plain text as one paragraph a line.

d-efbp2k4u-file = File

d-glswnmoj = Export the document
    .doc = The document as a Markdown file, named by its title.

d-r5rzmgc2 = Export as plain text
    .doc = The document as a plain-text file: its words, a paragraph a line.

d-cvk3spaq = Export the document
    .doc = The document as a Word, OpenDocument, RTF, EPUB or PDF file, named by its title: what a person sends someone who does not write in Tilo.

d-cvk3spaq-format = Format

d-fwmunpvi = Export as HTML
    .doc = The document as one HTML page: its headings, lists and paragraphs, and its words.

d-yseg6olm = Read a file
    .doc = Reads a file and answers what it says, without touching the document: what an agent reads a document through before it decides what to do with it.

d-yseg6olm-file = File

